+/// Under `PaddedTargetsPolicy::Alias` a padded texture that renders, over an ordinary `Shared`
+/// buffer (each padded layout of [`LAYOUTS`]), is an image over the buffer's rows where the device
+/// lays one at their pitch: a pass that loads it and blends a rectangle copies no shadow, and
+/// leaves the buffer's texels as a private texture of the same texels holds after the same pass.
+/// The bytes between the rows are not checked: the policy leaves them to the driver's loads and
+/// stores (lavapipe writes them back). Printed (`PADDED-TARGETS`): each layout's form.
+#[test]
+fn a_padded_target_under_alias_renders_in_place_as_its_private_twin() {
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    {
+        let device = validated_device_with(TEST_DEVICE, &messages, cache.path(), |options| {
+            options.policy.padded_targets = PaddedTargetsPolicy::Alias;
+        })
+        .unwrap();
+        let queue = device.new_command_queue().unwrap();
+        let mut aliased_layouts = 0;
+        for layout in LAYOUTS.iter().filter(|layout| layout.padded()) {
+            let len = layout.bpr * layout.h;
+            let buffer = device.new_buffer(len, ResourceOptions::default()).unwrap();
+            let bytes = texels_of(layout, len as usize, 7);
+            let contents = buffer.contents().unwrap();
+            // SAFETY: a new `Shared` buffer of `len` bytes, which no command uses yet.
+            unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), contents.as_ptr(), bytes.len()) };
+            let mut d = TextureDescriptor::texture_2d(layout.pf, layout.w, layout.h, false);
+            d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+            d.resource_options = buffer.resource_options();
+            let texture = buffer.new_texture(&d, 0, layout.bpr).unwrap();
+            // SAFETY: the handle is only compared, while the texture lives.
+            let aliased = unsafe { texture.vk_image() }.is_some();
+            eprintln!(
+                "PADDED-TARGETS {}: {}",
+                layout.name,
+                if aliased { "an image over the rows" } else { "a shadow" }
+            );
+            if !aliased {
+                continue;
+            }
+            aliased_layouts += 1;
+            let private = private_with(&queue, layout, &rows(layout, &bytes));
+            let blend = blending(&device, layout.pf);
+            let rect = ([-0.5, -0.75, 0.75, 0.5], [0.25, 0.5, 0.75, 0.5]);
+            let copies = || device.work_counts().shadow_copies;
+            let before = copies();
+            blend_pass(&queue, &blend, (&texture, StoreAction::Store), false, rect);
+            assert_eq!(copies(), before, "{}: shadow copies", layout.name);
+            blend_pass(&queue, &blend, (&private, StoreAction::Store), false, rect);
+            let (count, first) = differing(
+                &rows(layout, &bytes_of(&buffer)),
+                &blit_out(&queue, layout, &private),
+                layout.texel,
+            );
+            assert!(
+                count == 0,
+                "{}: {count} texels differ from the private texture's, the first at texel \
+                 {first:?}",
+                layout.name
+            );
+        }
+        assert!(
+            aliased_layouts > 0 || on_metal(&device),
+            "no padded target was aliased under PaddedTargetsPolicy::Alias"
+        );
+    }
+    let messages = messages.take();
+    assert!(
+        messages.is_empty(),
+        "the validation layer reported: {messages:#?}"
+    );
+}
