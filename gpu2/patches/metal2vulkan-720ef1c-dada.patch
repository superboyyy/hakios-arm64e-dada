+/// Under `PaddedTargetsPolicy::Alias` with a store alignment (`DeviceOptions::render_store_alignment`,
+/// Turnip's 16 x 4 texels here), a padded texture that renders is an image over its rows only
+/// where the driver's stores, which may write on to the next multiples of the alignment where a
+/// render area ends at its right or bottom edge, stay inside its own rows: its height a multiple
+/// of 4 and its rows at least its width rounded up to 16 texels apart. Else it is a shadow. Each
+/// padded layout of [`LAYOUTS`], and one whose rows fit but whose height (510) is not a multiple
+/// of 4, against the choice a device without the alignment makes. Printed (`PADDED-TARGETS
+/// aligned`): each layout's form under both.
+#[test]
+fn a_store_alignment_keeps_the_padded_targets_its_stores_would_overrun_shadows() {
+    const ALIGNMENT: [u32; 2] = [16, 4];
+    let odd_height = Layout::bgra8("1307x510/5376", 1307, 510, 5376);
+    let layouts: Vec<Layout> = LAYOUTS
+        .into_iter()
+        .filter(Layout::padded)
+        .chain([odd_height])
+        .collect();
+    let fits = |layout: &Layout| {
+        let reached = layout.w.next_multiple_of(u64::from(ALIGNMENT[0])) * layout.texel;
+        layout.h % u64::from(ALIGNMENT[1]) == 0 && reached <= layout.bpr
+    };
+    let cache = ScratchCache::new().unwrap();
+    let messages = Messages::default();
+    {
+        let plain = validated_device_with(TEST_DEVICE, &messages, cache.path(), |options| {
+            options.policy.padded_targets = PaddedTargetsPolicy::Alias;
+        })
+        .unwrap();
+        let aligned = validated_device_with(TEST_DEVICE, &messages, cache.path(), |options| {
+            options.policy.padded_targets = PaddedTargetsPolicy::Alias;
+            options.render_store_alignment = Some(ALIGNMENT);
+        })
+        .unwrap();
+        let aliased = |device: &Device, layout: &Layout| {
+            let len = layout.bpr * layout.h;
+            let buffer = device.new_buffer(len, ResourceOptions::default()).unwrap();
+            let mut d = TextureDescriptor::texture_2d(layout.pf, layout.w, layout.h, false);
+            d.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+            d.resource_options = buffer.resource_options();
+            let texture = buffer.new_texture(&d, 0, layout.bpr).unwrap();
+            // SAFETY: the handle is only compared, while the texture lives.
+            unsafe { texture.vk_image() }.is_some()
+        };
+        let (mut kept, mut shadowed) = (0, 0);
+        for layout in &layouts {
+            let (without, with) = (aliased(&plain, layout), aliased(&aligned, layout));
+            eprintln!(
+                "PADDED-TARGETS aligned {}: {} without the alignment, {} with it",
+                layout.name,
+                if without { "an image over the rows" } else { "a shadow" },
+                if with { "an image over the rows" } else { "a shadow" },
+            );
+            assert_eq!(with, without && fits(layout), "{}", layout.name);
+            kept += usize::from(with);
+            shadowed += usize::from(without && !with);
+        }
+        assert!(
+            on_metal(&plain) || (kept > 0 && shadowed > 0),
+            "the alignment kept {kept} and made {shadowed} shadows of the padded targets aliased \
+             without it"
+        );
+    }
+    let messages = messages.take();
+    assert!(
+        messages.is_empty(),
+        "the validation layer reported: {messages:#?}"
+    );
+}
