diff --git a/CacheExport.h b/CacheExport.h
index 9fb72ff..85b716d 100644
--- a/CacheExport.h
+++ b/CacheExport.h
@@ -258,6 +258,14 @@ static void run(Gpu &marker, std::string root) {
     marker.mark(0x6900);
     Gpu link;
     link.call = marker.call; link.openFn = marker.openFn; link.closeFn = marker.closeFn; link.port = marker.port;
+    // dada: the export goes to RedwoodGPU's user client (its tunnel, gpu_export_mb), not to the service Metal found the plug-in on
+    // (IOAcceleratorES, which has no user client: every open failed and the export never ran, g2k29)
+    if (void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_NOW | RTLD_LOCAL)) {
+        auto matching = (CFMutableDictionaryRef (*)(const char *))dlsym(iokit, "IOServiceMatching");
+        auto service = (unsigned (*)(unsigned, CFDictionaryRef))dlsym(iokit, "IOServiceGetMatchingService");
+        if (matching && service)
+            if (unsigned redwood = service(0, matching("RedwoodGPU"))) link.port = redwood;
+    }
     if (!link.openFn || link.openFn(link.port, mach_task_self(), 0x4148, &link.conn) != 0 || !link.conn) {marker.mark(0x69f0); return;}
     if (!link.probe()) {marker.mark(0x69f1); return;}
     marker.mark(0x6901);
