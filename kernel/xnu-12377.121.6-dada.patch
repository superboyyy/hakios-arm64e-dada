+/* dada (bsd/dev/hakios_dada_gpu.c): its Adreno 830, when it is the one kept, answers for all of the below */
+extern bool hakios_dada_gpu_ready(void);
+extern bool dada_gpu_parameter(uint32_t which, uint64_t *value);
+extern uint64_t dada_gpu_address(uint64_t size);
+extern void dada_gpu_address_free(uint64_t address, uint64_t size);
+extern void dada_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost,
+    uint32_t *refused);
+extern bool dada_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+extern void dada_gpu_mapped(void);
+extern void dada_gpu_unmap(uint64_t address, uint64_t size);
