diff --git a/bsd/dev/hakios_mhi_boot.c b/bsd/dev/hakios_mhi_boot.c
new file mode 100644
index 0000000..667aac5
--- /dev/null
+++ b/bsd/dev/hakios_mhi_boot.c
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "hakios_mhi_boot.h"
+/* (UniXNU MhiBoot.c, unchanged; bsd/dev/hakios_dada_wifi.c drives it) */
+
+static uint32_t rd(MhiBoot *m, uint32_t reg) {return m->io.read(m->io.ctx, reg);}
+static void wr(MhiBoot *m, uint32_t reg, uint32_t value) {m->io.write(m->io.ctx, reg, value);}
+
+int mhi_boot_open(MhiBoot *m, const MhiIo *io)
+{
+    for (unsigned i = 0; i < sizeof *m; ++i) ((uint8_t *)m)[i] = 0;
+    m->io = *io;
+    m->reglen = io->space ? io->space : rd(m, MHI_REGLEN);
+    m->bhi = rd(m, MHI_BHIOFF);
+    m->bhie = rd(m, MHI_BHIEOFF);
+    const int good = m->reglen >= 0x100 && m->reglen <= 0x100000 && m->bhi >= 0x100 && m->bhi + MHI_BHI_ERRCODE + 4 <= m->reglen &&
+                     m->bhie >= 0x100 && m->bhie + MHI_BHIE_TXVECSTATUS + 4 <= m->reglen && !(m->bhi & 3) && !(m->bhie & 3);
+    if (!good) {m->phase = MhiFailed; m->error = MhiErrLayout; return -1;}
+    m->phase = MhiIdle;
+    return 0;
+}
+
+uint32_t mhi_boot_ee(MhiBoot *m) {return m->ee = rd(m, m->bhi + MHI_BHI_EXECENV);}
+uint32_t mhi_boot_state(MhiBoot *m) {return m->state = (rd(m, MHI_STATUS) >> MHI_STATE_SHIFT) & 0xffu;}
+
+static uint32_t fail(MhiBoot *m, uint32_t error)
+{
+    m->failed_phase = m->phase;
+    m->error = error;
+    m->phase = MhiFailed;
+    return m->phase;
+}
+
+static uint32_t start_sbl(MhiBoot *m)
+{
+    wr(m, m->bhi + MHI_BHI_INTVEC, m->msi_vector);  /* a reset clears it */
+    wr(m, m->bhi + MHI_BHI_IMGADDR_HIGH, (uint32_t)(m->sbl_addr >> 32));
+    wr(m, m->bhi + MHI_BHI_IMGADDR_LOW, (uint32_t)m->sbl_addr);
+    wr(m, m->bhi + MHI_BHI_IMGSIZE, m->sbl_size);
+    wr(m, m->bhi + MHI_BHI_IMGTXDB, m->seq);
+    m->phase = MhiSblLoading;
+    return m->phase;
+}
+
+uint32_t mhi_boot_begin(MhiBoot *m, uint32_t msi_vector, uint64_t sbl_addr, uint32_t sbl_size, uint64_t table_addr, uint32_t table_size,
+                        uint32_t seq)
+{
+    if (m->phase != MhiIdle) return fail(m, MhiErrState);
+    m->msi_vector = msi_vector;
+    m->sbl_addr = sbl_addr; m->sbl_size = sbl_size;
+    m->table_addr = table_addr; m->table_size = table_size;
+    m->seq = seq & MHI_SEQ_MASK;
+    if (!m->seq) m->seq = 1;
+    const uint32_t ee = mhi_boot_ee(m);
+    if (ee != MhiEePbl && ee != MhiEeEdl) return fail(m, MhiErrNotPbl);
+    const uint32_t status = rd(m, MHI_STATUS);
+    m->state = (status >> MHI_STATE_SHIFT) & 0xffu;
+    wr(m, m->bhi + MHI_BHI_INTVEC, msi_vector);
+    if ((status & MHI_STATUS_SYSERR) || m->state == MhiStateSysErr) {
+        wr(m, MHI_CTRL, MHI_CTRL_RESET);
+        m->phase = MhiResetting;
+        return m->phase;
+    }
+    return start_sbl(m);
+}
+
+static uint32_t start_image(MhiBoot *m)
+{
+    m->seq = (m->seq + 1) & MHI_SEQ_MASK;
+    if (!m->seq) m->seq = 1;
+    wr(m, m->bhie + MHI_BHIE_TXVECADDR_HIGH, (uint32_t)(m->table_addr >> 32));
+    wr(m, m->bhie + MHI_BHIE_TXVECADDR_LOW, (uint32_t)m->table_addr);
+    wr(m, m->bhie + MHI_BHIE_TXVECSIZE, m->table_size);
+    wr(m, m->bhie + MHI_BHIE_TXVECDB, m->seq);
+    m->phase = MhiImageLoading;
+    return m->phase;
+}
+
+uint32_t mhi_boot_step(MhiBoot *m)
+{
+    if (m->phase == MhiIdle || m->phase == MhiDone || m->phase == MhiFailed || m->phase == MhiNeedContexts) return m->phase;
+    const uint32_t status = rd(m, MHI_STATUS);
+    if (status == 0xffffffffu) return m->phase;   /* the device does not answer (its link is retraining while its boot loader starts): not a status */
+    m->state = (status >> MHI_STATE_SHIFT) & 0xffu;
+    if (m->phase == MhiResetting) {
+        if (rd(m, MHI_CTRL) & MHI_CTRL_RESET) return m->phase;
+        return start_sbl(m);
+    }
+    const uint32_t ee = mhi_boot_ee(m);
+    if (ee == MhiEeRddm) return fail(m, MhiErrRddm);
+    if ((status & MHI_STATUS_SYSERR) || m->state == MhiStateSysErr) return fail(m, MhiErrSysErr);
+    switch (m->phase) {
+    case MhiSblLoading: {
+        const uint32_t bhi = rd(m, m->bhi + MHI_BHI_STATUS);
+        m->last_status = bhi;
+        if (bhi == 0xffffffffu) return m->phase;
+        if (bhi >> 30 == MHI_XFER_ERROR) {m->errcode = rd(m, m->bhi + MHI_BHI_ERRCODE); return fail(m, MhiErrBhi);}
+        if (bhi >> 30 != MHI_XFER_SUCCESS) return m->phase;
+        m->phase = MhiWaitReady;
+        return mhi_boot_step(m);
+    }
+    case MhiWaitReady:
+        if ((rd(m, MHI_CTRL) & MHI_CTRL_RESET) || !(status & MHI_STATUS_READY)) return m->phase;
+        m->phase = MhiNeedContexts;
+        return m->phase;
+    case MhiWaitSbl:
+        if (ee == MhiEeAmss || ee == MhiEeWfw) {m->phase = MhiDone; return m->phase;}  /* the device had the full image already */
+        if (ee != MhiEeSbl) return m->phase;
+        return start_image(m);
+    case MhiImageLoading: {
+        const uint32_t tx = rd(m, m->bhie + MHI_BHIE_TXVECSTATUS);
+        m->last_status = tx;
+        if ((tx & MHI_SEQ_MASK) != m->seq) return m->phase;  /* not this transfer's status yet */
+        if (tx >> 30 == MHI_XFER_ERROR) return fail(m, MhiErrBhie);
+        if (tx >> 30 != MHI_XFER_SUCCESS) return m->phase;
+        m->phase = MhiWaitMission;
+        return mhi_boot_step(m);
+    }
+    case MhiWaitMission:
+        if (ee == MhiEeAmss || ee == MhiEeWfw) m->phase = MhiDone;
+        return m->phase;
+    default:
+        return m->phase;
+    }
+}
+
+uint32_t mhi_boot_contexts_done(MhiBoot *m)
+{
+    if (m->phase != MhiNeedContexts) return fail(m, MhiErrState);
+    wr(m, MHI_CTRL, (rd(m, MHI_CTRL) & ~(0xffu << MHI_STATE_SHIFT) & ~MHI_CTRL_RESET) | (uint32_t)MhiStateM0 << MHI_STATE_SHIFT);
+    m->phase = MhiWaitSbl;
+    return mhi_boot_step(m);
+}
+
+uint32_t mhi_boot_timeout(MhiBoot *m)
+{
+    if (m->phase == MhiIdle || m->phase == MhiDone || m->phase == MhiFailed) return m->phase;
+    if (m->phase == MhiSblLoading) m->errcode = rd(m, m->bhi + MHI_BHI_ERRCODE);
+    return fail(m, MhiErrTimeout);
+}
+
+uint32_t mhi_bhie_table(MhiBhieEntry *table, uint32_t count, const uint64_t *addresses, uint32_t image_size, uint32_t segment_size)
+{
+    if (!segment_size || !image_size) return 0;
+    const uint32_t needed = (image_size + segment_size - 1) / segment_size;
+    if (needed > count) return 0;
+    for (uint32_t i = 0; i < needed; ++i) {
+        const uint32_t left = image_size - i * segment_size;
+        table[i].address = addresses[i];
+        table[i].size = left < segment_size ? left : segment_size;
+    }
+    return needed;
+}
diff --git a/bsd/dev/hakios_mhi_boot.h b/bsd/dev/hakios_mhi_boot.h
new file mode 100644
index 0000000..7a7fc02
--- /dev/null
+++ b/bsd/dev/hakios_mhi_boot.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Booting a Qualcomm MHI device's firmware from its primary boot loader, as a state machine the owner drives from the device's
+ * interrupt or a timer: prepare (interrupt vector, a reset when the device sits in an error state), the secondary boot loader through
+ * the boot host interface (BHI, one image in one DMA buffer), the wait for the device's READY, a hand back to the owner to program the
+ * MHI contexts before M0 is requested, then the full image through the vector interface (BHIe, a table of DMA segments) once the device
+ * runs the secondary boot loader, and the wait for mission mode. No call waits: each reads or writes a few registers and returns the
+ * phase; the owner keeps the deadlines and calls mhi_boot_timeout when one passes. */
+#ifndef MHI_BOOT_H
+#define MHI_BOOT_H
+#include <stdint.h>
+/* (UniXNU MhiBoot.h, unchanged: the boot of a Qualcomm MHI device's firmware; used by hakios_dada_wifi.c) */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* MHI registers (offsets in the MHI register space) and the boot interfaces' (from BHIOFF and BHIEOFF). */
+#define MHI_REGLEN 0x00u
+#define MHI_BHIOFF 0x28u
+#define MHI_BHIEOFF 0x2cu
+#define MHI_CTRL 0x38u
+#define MHI_STATUS 0x48u
+#define MHI_CTRL_RESET (1u << 1)
+#define MHI_STATUS_READY (1u << 0)
+#define MHI_STATUS_SYSERR (1u << 2)
+#define MHI_STATE_SHIFT 8u                   /* state field 15:8 in both MHI_CTRL and MHI_STATUS */
+#define MHI_BHI_IMGADDR_LOW 0x08u
+#define MHI_BHI_IMGADDR_HIGH 0x0cu
+#define MHI_BHI_IMGSIZE 0x10u
+#define MHI_BHI_IMGTXDB 0x18u
+#define MHI_BHI_INTVEC 0x20u
+#define MHI_BHI_EXECENV 0x28u
+#define MHI_BHI_STATUS 0x2cu
+#define MHI_BHI_ERRCODE 0x30u
+#define MHI_BHIE_TXVECADDR_LOW 0x2cu
+#define MHI_BHIE_TXVECADDR_HIGH 0x30u
+#define MHI_BHIE_TXVECSIZE 0x34u
+#define MHI_BHIE_TXVECDB 0x3cu
+#define MHI_BHIE_TXVECSTATUS 0x44u
+#define MHI_SEQ_MASK 0x3fffffffu             /* doorbell and status sequence 29:0, status 31:30 */
+#define MHI_XFER_SUCCESS 2u
+#define MHI_XFER_ERROR 3u
+
+enum {MhiStateReset = 0, MhiStateReady = 1, MhiStateM0 = 2, MhiStateBhi = 7, MhiStateSysErr = 0xff};
+enum {MhiEePbl = 0, MhiEeSbl = 1, MhiEeAmss = 2, MhiEeRddm = 3, MhiEeWfw = 4, MhiEePthru = 5, MhiEeEdl = 6, MhiEeFp = 7};
+
+enum {
+    MhiIdle, MhiResetting, MhiSblLoading, MhiWaitReady, MhiNeedContexts, MhiWaitSbl, MhiImageLoading, MhiWaitMission, MhiDone, MhiFailed
+};
+enum {MhiErrNone, MhiErrLayout, MhiErrNotPbl, MhiErrBhi, MhiErrBhie, MhiErrSysErr, MhiErrTimeout, MhiErrState, MhiErrRddm};
+
+typedef struct {
+    uint32_t (*read)(void *ctx, uint32_t reg);
+    void (*write)(void *ctx, uint32_t reg, uint32_t value);
+    void *ctx;
+    uint32_t space;   /* bytes of register space the owner mapped (0: use the MHIREGLEN register, which only counts the MHI block itself) */
+} MhiIo;
+
+typedef struct {
+    MhiIo io;
+    uint32_t bhi, bhie, reglen;
+    uint32_t phase, error, failed_phase, ee, state;
+    uint32_t seq, errcode, last_status;
+    uint64_t sbl_addr, table_addr;
+    uint32_t sbl_size, table_size, msi_vector;
+} MhiBoot;
+
+/* One BHIe vector table entry: a DMA segment's address and size, as the device reads them (little endian). */
+typedef struct {uint64_t address, size;} MhiBhieEntry;
+
+/* Reads the register layout. Returns 0, or -1 when the boot interfaces are not inside the register space. */
+int mhi_boot_open(MhiBoot *m, const MhiIo *io);
+uint32_t mhi_boot_ee(MhiBoot *m);
+uint32_t mhi_boot_state(MhiBoot *m);
+/* Starts the boot: sbl_* the DMA buffer holding the secondary boot loader (the image's first part), table_* the BHIe vector table
+ * describing the whole image (size: bytes of the table). seq: a nonzero value the doorbells carry (the owner's random number). */
+uint32_t mhi_boot_begin(MhiBoot *m, uint32_t msi_vector, uint64_t sbl_addr, uint32_t sbl_size, uint64_t table_addr, uint32_t table_size,
+                        uint32_t seq);
+/* Re-reads what the current phase waits for and moves on; returns the phase. */
+uint32_t mhi_boot_step(MhiBoot *m);
+/* The owner programmed the MHI contexts (phase MhiNeedContexts): requests M0 and waits for the secondary boot loader. */
+uint32_t mhi_boot_contexts_done(MhiBoot *m);
+/* The owner's deadline for the current phase passed. */
+uint32_t mhi_boot_timeout(MhiBoot *m);
+/* Fills a BHIe table for an image of image_size bytes cut in segments of segment_size placed at addresses[]; returns the number of
+ * entries, or 0 when count is too small. */
+uint32_t mhi_bhie_table(MhiBhieEntry *table, uint32_t count, const uint64_t *addresses, uint32_t image_size, uint32_t segment_size);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
