+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+struct RowJob;
+
+class IOMobileFramebuffer : public IOService
+{
+	OSDeclareDefaultStructors(IOMobileFramebuffer);
+
+public:
+	IOLock *        fLock;
+	uint8_t *       fBase;                  /* the boot framebuffer: the panel */
+	uint32_t        fPanelWidth, fPanelHeight, fRowBytes;
+	uint32_t        fWidth, fHeight;        /* the display as user space sees it */
+	MiniIOSurface * fDefaultSurface;
+	uint32_t        fSwapID;
+	uint32_t        fSwapsShown;
+	uint32_t        fLayersShown;           /* which layers the last swap had a surface in */
+	bool            fGraphics;              /* the text console has been told to stop */
+	/*
+	 * A frame goes to the panel when the GPU is done with it: a thread of ours waits for that
+	 * and copies it there, and whoever made the frame is back at the next one meanwhile. One
+	 * frame waits at a time: the swap after it is held, in SwapEnd, until this one is being
+	 * copied to the panel. Whoever draws is so at most two frames ahead of the panel, and
+	 * needs a third surface to be that: CoreAnimation makes itself a new one for every frame.
+	 * By default two frames may wait (boot-arg fb_queue=1: one, as before): CoreAnimation draws on a
+	 * clock of its own, and a SwapEnd held past its next tick makes that tick late, the clock going
+	 * on from there (rc.jobs.fps: 28% of the frames over 16.7 ms with two, 33% with one).
+	 */
+	IOLock *        fSwapLock;              /* around the next five */
+	uint8_t         fSwap[SWAP_QUEUE][SWAP_SIZE];   /* the swaps on their way to the panel (fb_queue), from fSwapFirst on */
+	MiniIOSurface * fSwapSurfaces[SWAP_QUEUE][SWAP_LAYERS]; /* ... their surfaces, held from SwapEnd on: their maker may let go of them */
+	unsigned        fSwapFirst, fSwapsWaiting;
+	/*
+	 * ... and not whenever the GPU happens to be done, but on a beat of the refresh rate
+	 * (boot-arg fb_beat=0: at once): frames then follow each other at an even pace whatever
+	 * each took to draw, as long as there is one for every beat. The beat is this driver's own.
+	 * (CoreAnimation does not go by the refresh notifications of this driver -- it never asks
+	 * for them -- but by a clock of its own at the rate it reads here; and where the panel's
+	 * scan is nobody can read: the display block's register clock is off.) It starts with a
+	 * frame that comes later than a beat and a half after the one before -- the first after a
+	 * pause, or every one of a renderer that does not keep up, the software one: such a frame
+	 * is shown at once, a beat would only make it later still -- and gives way by an eighth of
+	 * what a frame is early or late, so that frames are ready some six milliseconds before
+	 * their beat: neither a slow one nor a quick one then lands on the wrong side of it.
+	 */
+	uint64_t        fBeat;                  /* the beat the last frame was shown on */
+	uint64_t        fReady;                 /* when the last frame was ready to be shown */
+	uint32_t        fStatOnBeat;            /* frames that waited for a refresh, and for how long together */
+	uint64_t        fStatBeatWait;
+	uint32_t        fStatSurfaces[8];       /* the first different surfaces the bottom layer was given */
+	uint32_t        fStatHeld, fStatLost;   /* swaps that waited for the one before; that gave up waiting */
+	uint64_t        fSwapTime;              /* when the last swap was handed over */
+	uint32_t        fStatSwapsLate;         /* swaps that came more than a refresh and a quarter after the one before (and no pause) */
+	uint64_t        fStatWaiting;           /* how long frames waited for the GPU here */
+	struct {
+		uint32_t sid, drawn;
+	}               fShown[SHOWN_SLOTS];    /* show(): the GPU submission each surface was last shown after */
+	unsigned        fShownNext;
+	uint32_t        fStatStale, fStatStaleShown; /* swaps of a surface not drawn again since shown; still not after SWAP_NEW_MS */
+	/* how the display is doing: frames and time spent drawing them here since fStatSince */
+	uint32_t        fStatFrames;
+	uint64_t        fStatSince, fStatDrawing;
+	/* ... and how evenly: the time from each frame to the next, counted by the millisecond (the last count: longer) */
+	uint64_t        fLastFrame;
+	uint32_t        fFrameTimes[FRAME_TIMES + 1], fFramePauses, fFrameLongest;
+	/* boot-arg fb_diff=1: which pixels of the panel each frame changed (it costs: the panel's memory is slow to read) */
+	bool            fDiff;
+	uint64_t        fDiffPixels;
+	uint32_t        fDiffLeft, fDiffTop, fDiffRight, fDiffBottom;
+	/* the screen recording, if one was asked for */
+	uint32_t *      fColumn;                /* drawLayer(): source column for every panel column */
+	uint16_t *      fColumnWeight;          /* ... with fb_filter: how much of the column after it, of 256 */
+	uint32_t *      fBlendRow;              /* ... and a row of the picture blended from two (fBlendRowSize pixels) */
+	uint32_t        fBlendRowSize;
+	uint8_t *       fRecBase;
+	uint64_t        fRecSize, fRecUsed;
+	uint64_t        fFirstFrame, fRecFirst; /* when the first frame was shown, and the first recorded */
+	bool            fRecDone;
+	bool            fRecWrapped;            /* (rec_ring) the memory has been full once: frames go over the oldest */
+
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	void publishModes(void);
+	MiniIOSurface * defaultSurface(void);
+	void present(const uint8_t * swap);
+	void show(const uint8_t * swap, MiniIOSurface ** surfaces);
+	void presenter(void);
+	static void presenterMain(void * self, wait_result_t result);
+	void reportFrameTimes(void);
+	void drawLayer(MiniIOSurface * s, const int32_t * src, const int32_t * dst);
+	void drawRows(const struct RowJob * job, int32_t y0, int32_t y1, uint32_t * blendRow);
+	static void helperMain(void * self, wait_result_t result);
+	/* the scaling shared out (fb_threads): fThreads drawers, the presenter and fThreads - 1 helpers */
+	unsigned        fThreads;
+	IOLock *        fHelperLock;
+	const struct RowJob * fHelperJob;
+	uint64_t        fHelperGeneration;
+	unsigned        fHelpersBusy, fHelpersStarted;
+	uint32_t *      fHelperBlend[7];
+	void record(MiniIOSurface * s);
+	/*
+	 * dada (dadascan=1): a frame that is one surface of the whole display is copied as it is, row for row, into a
+	 * buffer of the display controller's, which then shows it -- no scaling here, and the panel's memory untouched.
+	 */
+	bool            fScan;
+	uint32_t        fScanShown, fScanCopied;
+	uint64_t        fScanCopying;
+	bool scanout(MiniIOSurface * s, const int32_t * src, const int32_t * dst);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+
+static IOMobileFramebuffer * gFramebuffer;      /* (for MiniIOMobileFramebufferEnd) */
+
+static void
+setNumber(OSDictionary * dict, const char * key, uint64_t value)
+{
+	OSNumber * n = OSNumber::withNumber(value, 32);
+
+	if (n != NULL) {
+		dict->setObject(key, n);
+		n->release();
+	}
+}
+
+/*
+ * The modes of the display, the way CoreAnimation reads them (the properties TimingElements
+ * and ColorElements; without a mode it draws nothing). One timing, the panel's size at
+ * 60 Hz (boot-arg fb_hz=N: at N), with one colour mode, 8-bit RGB. The identifiers are what "the current mode"
+ * (block 0x40) answers with.
+ */
+#define kFBTimingID     1
+#define kFBColorID      1
+
+void
+IOMobileFramebuffer::publishModes(void)
+{
+	/*
+	 * iOS 26 takes the modes the way a real phone's display driver lays them out (an M1's AppleCLCD2,
+	 * read with ioreg, is the model here): besides the attributes, each element carries its binary
+	 * description (ElementData), and the timing says it is the preferred one. With only the attributes
+	 * iOS 16.5 was content; iOS 26 found no preferred mode ("preferred mode (0 x 0)", current mode
+	 * 16383 x 16383) and never drew. The porches are made up, the pixel clock follows from them.
+	 */
+	const uint32_t hz = refreshHz();
+	const uint32_t hSync = 32, hBack = 42, hFront = 8, vSync = 8, vBack = 42, vFront = 32;
+	const uint32_t hTotal = fWidth + hSync + hBack + hFront, vTotal = fHeight + vSync + vBack + vFront;
+	const uint64_t pixelClock = (uint64_t) hTotal * vTotal * hz;
+	const uint32_t lineRate = (uint32_t) (((pixelClock << 16) / hTotal) / 1000);     /* kHz, 16.16 */
+	const uint32_t frameRate = hz << 16;                                            /* Hz, 16.16 */
+	uint32_t timingData[20] = {
+		0, hTotal, fWidth, hSync, hBack, hFront, lineRate, 1, 0,
+		vTotal, fHeight, vSync, vBack, vFront, frameRate, 1, 0,
+		(uint32_t) pixelClock, 13, 0,
+	};
+	uint8_t colorData[32] = { 8 };
+	OSDictionary * timing = OSDictionary::withCapacity(24);
+	OSDictionary * horizontal = OSDictionary::withCapacity(9);
+	OSDictionary * vertical = OSDictionary::withCapacity(9);
+	OSDictionary * color = OSDictionary::withCapacity(12);
+	OSDictionary * refresh = OSDictionary::withCapacity(6);
+	OSDictionary * attributes = OSDictionary::withCapacity(1);
+	OSDictionary * product = OSDictionary::withCapacity(1);
+	OSArray * timings = OSArray::withCapacity(1);
+	OSArray * colors = OSArray::withCapacity(1);
+	OSArray * none = OSArray::withCapacity(1);
+	OSData * data;
+	uint64_t frameTicks;
+
+	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL || refresh == NULL ||
+	    attributes == NULL || product == NULL || timings == NULL || colors == NULL || none == NULL) {
+		return;
+	}
+	colorData[12] = 16;                                     /* colorimetry */
+	setNumber(color, "ID", kFBColorID);
+	setNumber(color, "ElementType", 1);
+	setNumber(color, "StandardType", 0);
+	setNumber(color, "PixelEncoding", 0);                   /* RGB 4:4:4 */
+	setNumber(color, "Depth", 8);
+	setNumber(color, "Colorimetry", 16);
+	setNumber(color, "EOTF", 0);
+	setNumber(color, "DynamicRange", 0);
+	setNumber(color, "SupportsDSC", 0);
+	setNumber(color, "Score", 240999);
+	color->setObject("IsVirtual", kOSBooleanFalse);
+	if ((data = OSData::withBytes(colorData, sizeof(colorData))) != NULL) {
+		color->setObject("ElementData", data);
+		data->release();
+	}
+	colors->setObject(color);
+
+	setNumber(horizontal, "Active", fWidth);
+	setNumber(horizontal, "Total", hTotal);
+	setNumber(horizontal, "SyncWidth", hSync);
+	setNumber(horizontal, "BackPorch", hBack);
+	setNumber(horizontal, "FrontPorch", hFront);
+	setNumber(horizontal, "SyncPolarity", 1);
+	setNumber(horizontal, "PixelRepetition", 0);
+	setNumber(horizontal, "SyncRate", lineRate);
+	setNumber(horizontal, "PreciseSyncRate", lineRate);
+	setNumber(vertical, "Active", fHeight);
+	setNumber(vertical, "Total", vTotal);
+	setNumber(vertical, "SyncWidth", vSync);
+	setNumber(vertical, "BackPorch", vBack);
+	setNumber(vertical, "FrontPorch", vFront);
+	setNumber(vertical, "SyncPolarity", 1);
+	setNumber(vertical, "PixelRepetition", 0);
+	setNumber(vertical, "SyncRate", frameRate);
+	setNumber(vertical, "PreciseSyncRate", frameRate);
+	setNumber(timing, "ID", kFBTimingID);
+	setNumber(timing, "ElementType", 0);
+	setNumber(timing, "StandardType", 0);
+	setNumber(timing, "TimingType", 3);
+	setNumber(timing, "ScanInformation", 0);
+	setNumber(timing, "Score", 16346);
+	setNumber(timing, "AspectRatio", 13);
+	setNumber(timing, "PreciseAspectRatio", (uint64_t) fWidth * 65536 / fHeight);
+	setNumber(timing, "ValidPixelEncodings", 1);
+	setNumber(timing, "MinimumVariableRefreshRate", 0);
+	setNumber(timing, "MaximumVariableRefreshRate", 0);
+	timing->setObject("IsPreferred", kOSBooleanTrue);
+	timing->setObject("IsVirtual", kOSBooleanFalse);
+	timing->setObject("IsOverscanned", kOSBooleanFalse);
+	timing->setObject("IsInterlaced", kOSBooleanFalse);
+	timing->setObject("IsSplit", kOSBooleanFalse);
+	timing->setObject("IsPromoted", kOSBooleanFalse);
+	timing->setObject("HorizontalAttributes", horizontal);
+	timing->setObject("VerticalAttributes", vertical);
+	timing->setObject("ColorModes", colors);
+	timing->setObject("DiscreteMediaRefreshRates", none);
+	timing->setObject("UnsafeColorElementIDs", none);
+	timing->setObject("DSCRequiredColorElementIDs", none);
+	if ((data = OSData::withBytes(timingData, sizeof(timingData))) != NULL) {
+		timing->setObject("ElementData", data);
+		data->release();
+	}
+	timings->setObject(timing);
+
+	setProperty("TimingElements", timings);
+	setProperty("ColorElements", colors);
+	setProperty("DPTimingModeId", kFBTimingID, 32);
+	setProperty("DisplayWidth", fWidth, 32);
+	setProperty("DisplayHeight", fHeight, 32);
+	setProperty("PixelClock", pixelClock, 64);
+	attributes->setObject("ProductAttributes", product);
+	setProperty("DisplayAttributes", attributes);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / hz, &frameTicks);
+	setNumber(refresh, "displayMinRefreshInterval", (1ULL << 32) / hz);
+	setNumber(refresh, "displayMaxRefreshInterval", (1ULL << 32) / hz);
+	setNumber(refresh, "displayMinRefreshIntervalMachTime", frameTicks);
+	setNumber(refresh, "displayMaxRefreshIntervalMachTime", frameTicks);
+	setNumber(refresh, "displayRefreshStep", 0);
+	setNumber(refresh, "displayRefreshStepMachTime", 0);
+	setProperty("IOMFBDisplayRefresh", refresh);
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(none);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+	OSSafeReleaseNULL(refresh);
+	OSSafeReleaseNULL(attributes);
+	OSSafeReleaseNULL(product);
+}
+
+bool
+IOMobileFramebuffer::start(IOService * provider)
+{
+	thread_t thread;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	if (vinfo.v_baseaddr == 0 || vinfo.v_width == 0 || vinfo.v_height == 0 || vinfo.v_depth != 32) {
+		IOLog("MiniIOMobileFramebuffer: no usable boot framebuffer (%ux%u, depth %u)\n", vinfo.v_width, vinfo.v_height,
+		    vinfo.v_depth);
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fSwapLock = IOLockAlloc();
+	if (kernel_thread_start(&IOMobileFramebuffer::presenterMain, this, &thread) != KERN_SUCCESS) {
+		IOLog("MiniIOMobileFramebuffer: no thread to put frames on the panel with\n");
+		return false;
+	}
+	thread_set_thread_name(thread, "frames to the panel");
+	thread_deallocate(thread);
+	fThreads = gThreads >= 1 && gThreads <= 8 ? gThreads : 1;
+	fHelperLock = IOLockAlloc();
+	for (unsigned i = 0; i + 1 < fThreads; i++) {
+		if (kernel_thread_start(&IOMobileFramebuffer::helperMain, this, &thread) != KERN_SUCCESS) {
+			fThreads = i + 1;
+			break;
+		}
+		thread_set_thread_name(thread, "frames to the panel: a helper");
+		thread_deallocate(thread);
+	}
+	fBase = (uint8_t *) vinfo.v_baseaddr;
+	fPanelWidth = vinfo.v_width;
+	fPanelHeight = vinfo.v_height;
+	fRowBytes = vinfo.v_rowbytes;
+	fWidth = gFBWidth ? gFBWidth : fPanelWidth;
+	fHeight = gFBHeight ? gFBHeight : fPanelHeight;
+	if (gFBScale != 0 && gFBScale != kFBDefaultScale) {
+		static const char * const places[][2] = { { "/chosen", "display-scale" }, { "/product", "artwork-scale-factor" } };
+		uint32_t scale = gFBScale;
+
+		fWidth = kFBPointsWide * scale;
+		fHeight = kFBPointsHigh * scale;
+		/* what the loader's device tree says about the scale is where MobileGestalt has it from */
+		for (unsigned i = 0; i < sizeof(places) / sizeof(places[0]); i++) {
+			IORegistryEntry * node = IORegistryEntry::fromPath(places[i][0], gIODTPlane);
+
+			if (node != NULL) {
+				node->setProperty(places[i][1], &scale, sizeof(scale));
+				node->release();
+			}
+		}
+	}
+	fColumn = IONewZero(uint32_t, fPanelWidth);
+	fColumnWeight = IONewZero(uint16_t, fPanelWidth);
+	fDiff = gDiff != 0;
+	fDiffLeft = fDiffTop = ~0u;
+	IOLog("MiniIOMobileFramebuffer: display %ux%u on a panel of %ux%u (%u bytes per row)\n", fWidth, fHeight,
+	    fPanelWidth, fPanelHeight, fRowBytes);
+	/* (the frame: rows of 4 bytes a pixel, padded to 64 bytes as IOSurface pads them, and a little to spare) */
+	fScan = hakios_dada_scanout_init(kvtophys((vm_offset_t) vinfo.v_baseaddr), fPanelWidth, fPanelHeight, fRowBytes,
+	    ((fWidth * 4 + 255) & ~255u) * fHeight) == 0;
+	if (fScan) {
+		IOLog("MiniIOMobileFramebuffer: the display controller shows the frames from buffers of its own\n");
+	}
+	gFramebuffer = this;
+
+	if (gRecSeconds != 0) {
+		/* one piece of physical memory: the loader will send it over USB as it lies */
+		IOBufferMemoryDescriptor * memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, (mach_vm_size_t) gRecMegabytes << 20, ~0ULL);
+
+		if (memory != NULL) {
+			struct rec_header * header = (struct rec_header *) memory->getBytesNoCopy();
+
+			fRecBase = (uint8_t *) header;
+			fRecSize = (uint64_t) gRecMegabytes << 20;
+			fRecUsed = sizeof(*header);
+			bzero(header, sizeof(*header));
+			memcpy(header->magic, "RWREC003", 8);
+			header->width = fWidth / REC_STEP;
+			header->height = fHeight / REC_STEP;
+			loader_recording[0] = memory->getPhysicalSegment(0, NULL);
+			loader_recording[1] = fRecUsed;
+			loader_recording[2] = (uint64_t) (uintptr_t) fRecBase;
+			IOLog("MiniIOMobileFramebuffer: recording %u s of the screen at %ux%u from second %u, into %u MB at %#llx%s\n",
+			    gRecSeconds, header->width, header->height, gRecStart, gRecMegabytes, loader_recording[0],
+			    gRecRing ? ", the last of it kept (rec_ring)" : "");
+		} else {
+			IOLog("MiniIOMobileFramebuffer: no memory for a recording of %u MB\n", gRecMegabytes);
+		}
+	}
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	/* for who draws with the GPU (userland/src/eagl.c): a frame need not be waited for before it is handed over */
+	setProperty("RedwoodWaitsForGPU", kOSBooleanTrue);
+	publishModes();
+	setName("disp0");
+	registerService();
+	return true;
+}
+
+/* Keep a small copy of the frame that is about to be shown (the surface is the whole screen). */
+void
+IOMobileFramebuffer::record(MiniIOSurface * s)
+{
+	struct rec_header * header = (struct rec_header *) fRecBase;
+	uint64_t now = mach_absolute_time(), since_first, since_start = 0, frame_size;
+	struct rec_frame * frame;
+	uint8_t * to;
+
+	if (fFirstFrame == 0) {
+		fFirstFrame = now;
+	}
+	if (fRecBase == NULL || fRecDone || s->info.width < fWidth || s->info.height < fHeight) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now - fFirstFrame, &since_first);
+	if (since_first < (uint64_t) gRecStart * NSEC_PER_SEC) {
+		return;
+	}
+	if (fRecFirst == 0) {
+		uint64_t began;
+
+		fRecFirst = now;
+		absolutetime_to_nanoseconds(now, &began);
+		header->began = began;
+		IOLog("MiniIOMobileFramebuffer: the recording begins at %llu.%03llu s of the kernel's time (mach_absolute_time)\n",
+		    began / NSEC_PER_SEC, began / NSEC_PER_MSEC % 1000);
+	}
+	absolutetime_to_nanoseconds(now - fRecFirst, &since_start);
+	frame_size = sizeof(*frame) + (uint64_t) header->width * header->height * 3;
+	if (since_start > (uint64_t) gRecSeconds * NSEC_PER_SEC || (fRecUsed + frame_size > fRecSize && !gRecRing)) {
+		fRecDone = true;
+		IOLog("MiniIOMobileFramebuffer: recording finished: %u frames, %llu MB\n", header->frames, fRecUsed >> 20);
+		return;
+	}
+	if (fRecUsed + frame_size > fRecSize) {
+		/* (rec_ring) round again: over the oldest, which is the next one */
+		fRecUsed = sizeof(*header);
+		fRecWrapped = true;
+	}
+	frame = (struct rec_frame *) (fRecBase + fRecUsed);
+	/*
+	 * (dada: the surface it came from and the low bits of its last GPU submission ride in the time's top bits -- a run is far
+	 * shorter than 2^40 ns -- for telling which buffer a frame that flickers was: tools/recording.py writes them to tags.txt)
+	 */
+	frame->nanoseconds = (since_start & ((1ull << 40) - 1)) | (uint64_t) (s->sid & 0xffff) << 40 | (uint64_t) (s->drawn & 0xff) << 56;
+	to = (uint8_t *) (frame + 1);
+	for (uint32_t y = 0; y < header->height; y++) {
+		const uint32_t * from = (const uint32_t *) (s->pixels() + (size_t) (y * REC_STEP + 1) * s->info.bytesPerRow);
+
+		for (uint32_t x = 0; x < header->width; x++) {
+			uint32_t pixel = from[x * REC_STEP + 1];        /* B G R A in memory */
+
+			*to++ = (uint8_t) (pixel >> 16);
+			*to++ = (uint8_t) (pixel >> 8);
+			*to++ = (uint8_t) pixel;
+		}
+	}
+	fRecUsed += frame_size;
+	if (!fRecWrapped) {
+		header->frames++;
+		loader_recording[1] = fRecUsed;
+	} else {
+		/* the memory full of frames: all of them are handed over, from the one after this */
+		header->oldest = (uint32_t) ((fRecUsed - sizeof(*header)) / frame_size);
+		if (header->oldest >= header->frames) {
+			header->oldest = 0;
+		}
+		loader_recording[1] = sizeof(*header) + (uint64_t) header->frames * frame_size;
+	}
+}
+
+MiniIOSurface *
+IOMobileFramebuffer::defaultSurface(void)
+{
+	IOLockLock(fLock);
+	if (fDefaultSurface == NULL) {
+		fDefaultSurface = MiniIOSurfaceCreateSimple(fWidth, fHeight, FOURCC('B', 'G', 'R', 'A'));
+	}
+	IOLockUnlock(fLock);
+	return fDefaultSurface;
+}
+
+/*
+ * Two pixels mixed: `w` of 256 of the second. Two of the four channels at a time, in one word.
+ */
+static inline uint32_t
+blend(uint32_t a, uint32_t b, uint32_t w)
+{
+	uint32_t rb = ((a & 0xff00ff) * (256 - w) + (b & 0xff00ff) * w) >> 8 & 0xff00ff;
+	uint32_t ga = ((a >> 8 & 0xff00ff) * (256 - w) + (b >> 8 & 0xff00ff) * w) & 0xff00ff00;
+
+	return rb | ga;
+}
+
+/*
+ * Where the middle of the `i`th of `out` pixels falls among `in` of them, in 256ths of a pixel,
+ * kept within the first and the last.
+ */
+static inline int64_t
+sample_at(int64_t i, int64_t in, int64_t out)
+{
+	int64_t at = ((2 * i + 1) * in - out) * 128 / out;
+
+	return at < 0 ? 0 : at > (in - 1) * 256 ? (in - 1) * 256 : at;
+}
+
+/*
+ * The rows of one layer, from `y0` to `y1` (panel rows), as drawLayer() has worked them out:
+ * scaling a whole frame takes one processor some 9 ms, so with boot-arg fb_threads=N it is shared
+ * out between N of them, each with rows of its own and a row of blending of its own.
+ */
+struct RowJob {
+	const uint8_t * pixels;
+	uint32_t        stride;
+	int32_t         sx, sy, sw, sh, px0, py0, px1, py1, cx0, cx1;
+	bool            filter, unscaled;
+};
+
+void
+IOMobileFramebuffer::drawRows(const RowJob * job, int32_t y0, int32_t y1, uint32_t * blendRow)
+{
+	const uint8_t * pixels = job->pixels;
+	uint32_t stride = job->stride;
+	int32_t sx = job->sx, sy = job->sy, sw = job->sw, sh = job->sh;
+	int32_t px0 = job->px0, py0 = job->py0, px1 = job->px1, py1 = job->py1, cx0 = job->cx0, cx1 = job->cx1;
+	bool filter = job->filter;
+
+	for (int32_t y = y0; y < y1; y++) {
+		const uint32_t * from;
+		uint32_t * to;
+
+		if (y < 0 || (uint32_t) y >= fPanelHeight) {
+			continue;
+		}
+		to = (uint32_t *) (fBase + (size_t) y * fRowBytes);
+		if (job->unscaled) {
+			/* not scaled at all */
+			memcpy(to + px0, pixels + (size_t) (sy + y - py0) * stride + (size_t) sx * 4, (size_t) sw * 4);
+			continue;
+		}
+		if (filter) {
+			int64_t at = sample_at(y - py0, sh, py1 - py0);
+			uint32_t row = (uint32_t) (at >> 8), weight = (uint32_t) (at & 255);
+			const uint32_t * upper = (const uint32_t *) (pixels + (size_t) (sy + row) * stride) + sx;
+
+			if (weight == 0 || row + 1 >= (uint32_t) sh) {
+				from = upper;
+			} else {
+				const uint32_t * lower = (const uint32_t *) (pixels + (size_t) (sy + row + 1) * stride) + sx;
+				uint32_t first = fColumn[cx0], last = fColumn[cx1 - 1] + 1 < (uint32_t) sw ? fColumn[cx1 - 1] + 1 : fColumn[cx1 - 1];
+
+				uint32_t * __restrict mixed = blendRow;
+
+				for (uint32_t c = first; c <= last; c++) {
+					uint32_t a = upper[c], b = lower[c];
+
+					mixed[c] = a == b ? a : blend(a, b, weight);           /* (most of a screen is the same as next to it) */
+				}
+				from = blendRow;
+			}
+		} else {
+			from = (const uint32_t *) (pixels + (size_t) (sy + (int64_t) (y - py0) * sh / (py1 - py0)) * stride);
+		}
+		if (fDiff) {
+			for (int32_t x = cx0; x < cx1; x++) {
+				uint32_t value = filter ? blend(from[fColumn[x]], from[fColumn[x] + (fColumnWeight[x] != 0)], fColumnWeight[x]) :
+				    from[fColumn[x]];
+
+				if (to[x] != value) {
+					fDiffPixels++;
+					fDiffLeft = (uint32_t) x < fDiffLeft ? (uint32_t) x : fDiffLeft;
+					fDiffRight = (uint32_t) x > fDiffRight ? (uint32_t) x : fDiffRight;
+					fDiffTop = (uint32_t) y < fDiffTop ? (uint32_t) y : fDiffTop;
+					fDiffBottom = (uint32_t) y > fDiffBottom ? (uint32_t) y : fDiffBottom;
+				}
+			}
+		}
+		if (filter) {
+			const uint32_t * __restrict column = fColumn + cx0;
+			const uint16_t * __restrict weights = fColumnWeight + cx0;
+			uint32_t * __restrict out = to + cx0;
+
+			for (uint32_t i = 0, n = (uint32_t) (cx1 - cx0); i < n; i++) {
+				uint32_t c = column[i], w = weights[i], a = from[c];
+
+				out[i] = w == 0 || a == from[c + 1] ? a : blend(a, from[c + 1], w);
+			}
+		} else {
+			for (int32_t x = cx0; x < cx1; x++) {
+				to[x] = from[fColumn[x]];
+			}
+		}
+	}
+}
+
+/* A helper of the scaling (fb_threads): waits for rows to do, does them, says so. */
+void
+IOMobileFramebuffer::helperMain(void * self, wait_result_t result __unused)
+{
+	IOMobileFramebuffer * fb = (IOMobileFramebuffer *) self;
+	unsigned index;
+	uint64_t done = 0;
+
+	IOLockLock(fb->fHelperLock);
+	index = fb->fHelpersStarted++;
+	IOLockUnlock(fb->fHelperLock);
+	for (;;) {
+		const RowJob * job;
+		int32_t rows, y0, y1;
+		uint32_t * blend;
+
+		IOLockLock(fb->fHelperLock);
+		while (fb->fHelperGeneration == done) {
+			IOLockSleep(fb->fHelperLock, &fb->fHelperGeneration, THREAD_UNINT);
+		}
+		done = fb->fHelperGeneration;
+		job = fb->fHelperJob;
+		IOLockUnlock(fb->fHelperLock);
+		/* share index + 1 of fThreads (the presenter takes share 0) */
+		rows = job->py1 - job->py0;
+		y0 = job->py0 + (int32_t) ((int64_t) rows * (index + 1) / fb->fThreads);
+		y1 = job->py0 + (int32_t) ((int64_t) rows * (index + 2) / fb->fThreads);
+		blend = fb->fHelperBlend[index];
+		fb->drawRows(job, y0, y1, blend);
+		IOLockLock(fb->fHelperLock);
+		fb->fHelpersBusy--;
+		if (fb->fHelpersBusy == 0) {
+			IOLockWakeup(fb->fHelperLock, &fb->fHelpersBusy, true);
+		}
+		IOLockUnlock(fb->fHelperLock);
+	}
+}
+
+/*
+ * Put a rectangle of a 32-bit surface on the screen. `dst` is in display coordinates; the
+ * panel may be of another size, and the layer itself may be scaled: both are done in one
+ * step, bilinear (or nearest neighbour: fb_filter=0).
+ */
+void
+IOMobileFramebuffer::drawLayer(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	int32_t sx = src[0], sy = src[1], sw = src[2], sh = src[3];
+	int32_t dx = dst[0], dy = dst[1], dw = dst[2], dh = dst[3];
+	int32_t px0, py0, px1, py1, cx0, cx1;
+	bool filter = gFilter != 0;
+	RowJob job;
+
+	if (sw <= 0 || sh <= 0) {
+		sx = sy = 0;
+		sw = (int32_t) s->info.width;
+		sh = (int32_t) s->info.height;
+	}
+	if (dw <= 0 || dh <= 0) {
+		dx = dy = 0;
+		dw = (int32_t) fWidth;
+		dh = (int32_t) fHeight;
+	}
+	if (sx < 0 || sy < 0 || (uint32_t) (sx + sw) > s->info.width || (uint32_t) (sy + sh) > s->info.height) {
+		return;
+	}
+	/* the rectangle on the panel */
+	px0 = (int32_t) ((int64_t) dx * fPanelWidth / fWidth);
+	py0 = (int32_t) ((int64_t) dy * fPanelHeight / fHeight);
+	px1 = (int32_t) ((int64_t) (dx + dw) * fPanelWidth / fWidth);
+	py1 = (int32_t) ((int64_t) (dy + dh) * fPanelHeight / fHeight);
+	if (px1 <= px0 || py1 <= py0) {
+		return;
+	}
+	/* (blending, a row of the picture mixed from two: room for it, for every one who draws rows) */
+	if (filter && fBlendRowSize < (uint32_t) sw) {
+		if (fBlendRow != NULL) {
+			IODelete(fBlendRow, uint32_t, fBlendRowSize);
+		}
+		for (unsigned i = 0; i + 1 < fThreads; i++) {
+			if (fHelperBlend[i] != NULL) {
+				IODelete(fHelperBlend[i], uint32_t, fBlendRowSize);
+			}
+		}
+		fBlendRowSize = (uint32_t) sw;
+		fBlendRow = IONew(uint32_t, fBlendRowSize);
+		for (unsigned i = 0; i + 1 < fThreads; i++) {
+			fHelperBlend[i] = IONew(uint32_t, fBlendRowSize);
+			if (fHelperBlend[i] == NULL && fBlendRow != NULL) {
+				IODelete(fBlendRow, uint32_t, fBlendRowSize);
+				fBlendRow = NULL;
+			}
+		}
+		if (fBlendRow == NULL) {
+			fBlendRowSize = 0;
+		}
+	}
+	filter = filter && fBlendRow != NULL;
+	/* which pixel of a source row each pixel of a panel row takes: worked out once, not 2.6 million times */
+	cx0 = px0 < 0 ? 0 : px0;
+	cx1 = (uint32_t) px1 > fPanelWidth ? (int32_t) fPanelWidth : px1;
+	for (int32_t x = cx0; x < cx1; x++) {
+		if (filter) {
+			int64_t at = sample_at(x - px0, sw, px1 - px0);
+
+			fColumn[x] = (uint32_t) (at >> 8);              /* (in the blended row: from sx on) */
+			fColumnWeight[x] = (uint16_t) (fColumn[x] + 1 < (uint32_t) sw ? at & 255 : 0);
+		} else {
+			fColumn[x] = (uint32_t) (sx + (int64_t) (x - px0) * sw / (px1 - px0));
+		}
+	}
+	job.pixels = s->pixels();
+	job.stride = s->info.bytesPerRow;
+	job.sx = sx;
+	job.sy = sy;
+	job.sw = sw;
+	job.sh = sh;
+	job.px0 = px0;
+	job.py0 = py0;
+	job.px1 = px1;
+	job.py1 = py1;
+	job.cx0 = cx0;
+	job.cx1 = cx1;
+	job.filter = filter;
+	job.unscaled = px1 - px0 == sw && py1 - py0 == sh && px0 >= 0 && (uint32_t) px1 <= fPanelWidth;
+	if (fThreads <= 1 || fDiff || fHelpersStarted + 1 < fThreads) {
+		drawRows(&job, py0, py1, fBlendRow);
+		return;
+	}
+	/* shared out: the helpers take their rows, this thread the first share, then waits for them */
+	IOLockLock(fHelperLock);
+	fHelperJob = &job;
+	fHelpersBusy = fThreads - 1;
+	fHelperGeneration++;
+	IOLockWakeup(fHelperLock, &fHelperGeneration, false);
+	IOLockUnlock(fHelperLock);
+	drawRows(&job, py0, py0 + (int32_t) ((int64_t) (py1 - py0) / fThreads), fBlendRow);
+	IOLockLock(fHelperLock);
+	while (fHelpersBusy != 0) {
+		IOLockSleep(fHelperLock, &fHelpersBusy, THREAD_UNINT);
+	}
+	IOLockUnlock(fHelperLock);
+}
+
+/*
+ * How evenly the frames of the last seconds came: how many followed the one before within the
+ * time of one refresh at 120, 60, 40 and 30 a second, and the times half and 95 in 100 of them
+ * stayed under. With the lock held.
+ */
+void
+IOMobileFramebuffer::reportFrameTimes(void)
+{
+	static const uint32_t limits[] = { 10, 18, 26, 35, FRAME_TIMES + 1 };
+	uint32_t within[sizeof(limits) / sizeof(limits[0])] = { 0 }, total = 0, sum = 0, half = 0, most = 0;
+
+	for (uint32_t ms = 0; ms <= FRAME_TIMES; ms++) {
+		for (uint32_t i = 0; i < sizeof(limits) / sizeof(limits[0]); i++) {
+			if (ms < limits[i]) {
+				within[i] += fFrameTimes[ms];
+				break;
+			}
+		}
+		total += fFrameTimes[ms];
+	}
+	for (uint32_t ms = 0; ms <= FRAME_TIMES && total != 0; ms++) {
+		sum += fFrameTimes[ms];
+		if (half == 0 && 2 * sum >= total) {
+			half = ms + 1;
+		}
+		if (most == 0 && 100 * sum >= 95 * total) {
+			most = ms + 1;
+		}
+	}
+	if (total != 0) {
+		IOLog("MiniIOMobileFramebuffer: from one frame to the next: %u times under 10 ms, %u under 18, %u under 26, %u under 35, "
+		    "%u longer (the longest %u ms); half under %u ms, 95 in 100 under %u ms; %u pauses\n", within[0], within[1],
+		    within[2], within[3], within[4], fFrameLongest, half, most, fFramePauses);
+	}
+	bzero(fFrameTimes, sizeof(fFrameTimes));
+	fFramePauses = fFrameLongest = 0;
+}
+
+/* SwapEnd: the swap is handed to the thread that puts frames on the panel, as soon as that has no other waiting. */
+void
+IOMobileFramebuffer::present(const uint8_t * swap)
+{
+	AbsoluteTime deadline;
+
+	uint64_t now = mach_absolute_time(), period, pause;
+
+	/* (a frame that is late on the panel was late here already, or it was not: for telling whose it is) */
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz() * 5 / 4, &period);
+	nanoseconds_to_absolutetime(FRAME_PAUSE * NSEC_PER_MSEC, &pause);
+	clock_interval_to_deadline(SWAP_HELD_MS, kMillisecondScale, &deadline);
+	if (gTouchLat) {
+		redwood_tl("tl: s %u at %llu\n", swapWord(swap, SWAP_ID), micros(now));
+	}
+	IOLockLock(fSwapLock);
+	fStatSwapsLate += fSwapTime != 0 && now - fSwapTime > period && now - fSwapTime < pause;
+	fSwapTime = now;
+	fStatHeld += fSwapsWaiting >= swapQueue();
+	while (fSwapsWaiting >= swapQueue()) {
+		if (IOLockSleepDeadline(fSwapLock, &fSwapsWaiting, deadline, THREAD_UNINT) == THREAD_TIMED_OUT &&
+		    fSwapsWaiting >= swapQueue()) {
+			fStatLost++;                    /* (the GPU has stopped answering: the frame before is waiting for it) */
+			IOLockUnlock(fSwapLock);
+			return;
+		}
+	}
+	unsigned slot = (fSwapFirst + fSwapsWaiting) % SWAP_QUEUE;
+
+	memcpy(fSwap[slot], swap, SWAP_SIZE);
+	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+		uint32_t sid = swapWord(swap, SWAP_SURFACE(layer));
+
+		fSwapSurfaces[slot][layer] = sid != 0 ? MiniIOSurfaceCopy(sid) : NULL;
+	}
+	fSwapsWaiting++;
+	IOLockWakeup(fSwapLock, fSwap, true);
+	IOLockUnlock(fSwapLock);
+}
+
+void
+IOMobileFramebuffer::presenterMain(void * self, wait_result_t result __unused)
+{
+	((IOMobileFramebuffer *) self)->presenter();
+}
+
+void
+IOMobileFramebuffer::presenter(void)
+{
+	static uint8_t swap[SWAP_SIZE];         /* (one thread) */
+	MiniIOSurface * surfaces[SWAP_LAYERS];
+
+	for (;;) {
+		IOLockLock(fSwapLock);
+		while (fSwapsWaiting == 0) {
+			IOLockSleep(fSwapLock, fSwap, THREAD_UNINT);
+		}
+		memcpy(swap, fSwap[fSwapFirst], SWAP_SIZE);
+		memcpy(surfaces, fSwapSurfaces[fSwapFirst], sizeof(surfaces));
+		IOLockUnlock(fSwapLock);
+		show(swap, surfaces);
+		for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+			if (surfaces[layer] != NULL) {
+				MiniIOSurfaceDrop(surfaces[layer]);
+			}
+		}
+		MiniIOSurfaceClearKept();               /* (the next frame is some milliseconds away) */
+	}
+}
+
+/*
+ * dada: the surface shown by the display controller from a buffer of its own, if it can be: 32 bits a pixel, one
+ * plane, of the display's whole size. False: it is drawn onto the panel as before.
+ */
+bool
+IOMobileFramebuffer::scanout(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
+{
+	uint32_t bytes = s->info.bytesPerRow * s->info.height;
+	uint64_t began = mach_absolute_time(), nanos;
+	uint8_t * buffer;
+
+	(void) src;
+	(void) dst;
+	if (s->info.bytesPerElement != 4 || s->info.planeCount != 0 || s->info.width != fWidth || s->info.height != fHeight ||
+	    (buffer = hakios_dada_scanout_buffer(bytes)) == NULL) {
+		return false;
+	}
+	/*
+	 * What the GPU drew is in memory and not in this processor's cache, which may still hold lines of the surface
+	 * from before -- the zeros it was made with, or the last frame copied out of it -- and a copy would read those:
+	 * black or stale blocks that come and go as the lines do. Out of the cache first (clean and invalidate).
+	 */
+	for (uintptr_t line = (uintptr_t) s->pixels() & ~(uintptr_t) 63; line < (uintptr_t) s->pixels() + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	memcpy(buffer, s->pixels(), bytes);
+	fScanCopying += mach_absolute_time() - began;
+	if (!hakios_dada_scanout_show(s->info.bytesPerRow, s->info.width, s->info.height)) {
+		return false;
+	}
+	if (++fScanShown % 600 == 1) {
+		absolutetime_to_nanoseconds(fScanCopying, &nanos);
+		IOLog("MiniIOMobileFramebuffer: %u frames shown from the display's buffers, %llu us a copy (surface %u, %u bytes a "
+		    "row)\n", fScanShown, nanos / fScanShown / NSEC_PER_USEC, s->sid, s->info.bytesPerRow);
+	}
+	return true;
+}
+
+/* A swap's surfaces onto the panel, once the GPU is done with them. */
+void
+IOMobileFramebuffer::show(const uint8_t * swap, MiniIOSurface ** surfaces)
+{
+	uint32_t set = swapWord(swap, SWAP_LAYERS_SET);
+	uint64_t began = mach_absolute_time(), nanos, ready, shown, drawn;
+	uint32_t layers = 0;
+	MiniIOSurface * recorded = NULL;
+	bool report;
+
+	/*
+	 * dada: a swap can come before the GPU work that draws its surface has reached the kernel (the render server swaps once its
+	 * command buffer is scheduled, and the runtime or Turnip may hand it over later): the surface's last submission is then the one
+	 * of its frame two or three swaps ago, long done, and that old picture went on the panel -- the flicker of everything that moves
+	 * (still frames are the same picture). A surface whose last submission has not changed since it was last shown is waited for, up
+	 * to SWAP_NEW_MS, to be named by a newer one; then for the GPU, as before.
+	 */
+	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+		MiniIOSurface * s = surfaces[layer];
+		unsigned slot;
+
+		if (s == NULL) {
+			continue;
+		}
+		for (slot = 0; slot < SHOWN_SLOTS && fShown[slot].sid != s->sid; slot++) {
+		}
+		if (slot < SHOWN_SLOTS && fShown[slot].drawn == s->drawn && s->drawn != 0) {
+			uint64_t waited = 0;
+
+			while (s->drawn == fShown[slot].drawn && waited < SWAP_NEW_MS) {
+				IOSleep(1);
+				waited++;
+			}
+			fStatStale++;
+			if (s->drawn == fShown[slot].drawn) {
+				fStatStaleShown++;
+			}
+		}
+		if (slot == SHOWN_SLOTS) {
+			slot = fShownNext++ % SHOWN_SLOTS;
+			fShown[slot].sid = s->sid;
+		}
+		fShown[slot].drawn = s->drawn;
+	}
+	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+		if (surfaces[layer] != NULL && !MiniIOSurfaceDrawn(surfaces[layer], SWAP_GPU_MS)) {
+			IOLog("MiniIOMobileFramebuffer: swap %u: the GPU is not done with surface %u after %u ms; shown as it is\n",
+			    swapWord(swap, SWAP_ID), swapWord(swap, SWAP_SURFACE(layer)), SWAP_GPU_MS);
+		}
+	}
+	fStatWaiting += mach_absolute_time() - began;
+	began = ready = mach_absolute_time();
+	if (gOnTheBeat && !fScan) {        /* (scanning out, the display's own refresh paces the frames) */
+		uint64_t period, aim, next;
+
+		nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz(), &period);
+		aim = period * 3 / 8;
+		next = fReady;
+		fReady = began;
+		if (fBeat == 0 || began - next > period * 3 / 2) {
+			fBeat = began;
+		} else {
+			for (next = fBeat + period; next < began; next += period) {
+			}
+			if (next - began > aim) {
+				next -= (next - began - aim) / 8;
+			} else {
+				next += (aim - (next - began)) / 8;
+			}
+			clock_delay_until(next);
+			fBeat = next;
+			fStatOnBeat++;
+			fStatBeatWait += mach_absolute_time() - began;
+			began = mach_absolute_time();
+		}
+	}
+	shown = began;
+	/* its turn has come: the swap after it may be handed over */
+	IOLockLock(fSwapLock);
+	fSwapFirst = (fSwapFirst + 1) % SWAP_QUEUE;
+	fSwapsWaiting--;
+	IOLockWakeup(fSwapLock, &fSwapsWaiting, true);
+	IOLockUnlock(fSwapLock);
+	IOLockLock(fLock);
+	if (fLastFrame != 0) {
+		absolutetime_to_nanoseconds(began - fLastFrame, &nanos);
+		nanos /= NSEC_PER_MSEC;
+		if (nanos >= FRAME_PAUSE) {
+			fFramePauses++;
+		} else {
+			fFrameTimes[nanos < FRAME_TIMES ? nanos : FRAME_TIMES]++;
+			fFrameLongest = nanos > fFrameLongest ? (uint32_t) nanos : fFrameLongest;
+		}
+	}
+	fLastFrame = began;
+	report = fSwapsShown < 8;
+	if (report) {
+		IOLog("MiniIOMobileFramebuffer: swap %u (#%u): surfaces %u %u %u %u, layers set 0x%x cleared 0x%x\n",
+		    swapWord(swap, SWAP_ID), fSwapsShown, swapWord(swap, SWAP_SURFACE(0)), swapWord(swap, SWAP_SURFACE(1)),
+		    swapWord(swap, SWAP_SURFACE(2)), swapWord(swap, SWAP_SURFACE(3)), set, swapWord(swap, SWAP_LAYERS_CLEARED));
+	}
+	bool scanned = false;
+	if (fScan && swapWord(swap, SWAP_SURFACE(1)) == 0 && swapWord(swap, SWAP_SURFACE(2)) == 0 &&
+	    swapWord(swap, SWAP_SURFACE(3)) == 0 && surfaces[0] != NULL) {
+		int32_t src[4], dst[4];
+
+		memcpy(src, swap + SWAP_SOURCE(0), sizeof(src));
+		memcpy(dst, swap + SWAP_DEST(0), sizeof(dst));
+		scanned = scanout(surfaces[0], src, dst);
+	}
+	if (fScan && !scanned) {
+		if (fScanCopied++ < 4) {
+			IOLog("MiniIOMobileFramebuffer: swap %u is copied by the CPU (surfaces %u %u %u %u)\n", swapWord(swap, SWAP_ID),
+			    swapWord(swap, SWAP_SURFACE(0)), swapWord(swap, SWAP_SURFACE(1)), swapWord(swap, SWAP_SURFACE(2)),
+			    swapWord(swap, SWAP_SURFACE(3)));
+		}
+		hakios_dada_scanout_panel();
+	}
+	for (unsigned layer = 0; layer < SWAP_LAYERS; layer++) {
+		uint32_t sid = swapWord(swap, SWAP_SURFACE(layer));
+		int32_t src[4], dst[4];
+		MiniIOSurface * s;
+
+		layers |= sid != 0 ? 1u << layer : 0;
+		if (scanned) {
+			if (layer == 0) {
+				recorded = surfaces[0];
+				fGraphics = true;
+			}
+			continue;
+		}
+		/* the frames' surfaces: is it a few, in turn? */
+		for (unsigned i = 0; layer == 0 && sid != 0 && i < 8; i++) {
+			if (fStatSurfaces[i] == 0 || fStatSurfaces[i] == sid) {
+				fStatSurfaces[i] = sid;
+				break;
+			}
+		}
+		if (sid == 0) {
+			/* the bottom layer taken away: nothing is shown, the screen is black */
+			if (layer == 0 && (set & 1) && fGraphics) {
+				/*
+				 * Plain aligned stores, not bzero: the panel's memory is device memory under the phone's
+				 * hypervisor, and bzero's DC ZVA and unaligned stores fault there ("Unaligned kernel data
+				 * abort" in IOMobileFramebuffer::show, the first time SpringBoard dropped the bottom layer).
+				 */
+				for (uint32_t y = 0; y < fPanelHeight; y++) {
+					volatile uint64_t *row = (volatile uint64_t *) (fBase + (size_t) y * fRowBytes);
+
+					for (uint32_t x = 0; x < fPanelWidth / 2; x++) {
+						row[x] = 0;
+					}
+				}
+			}
+			continue;
+		}
+		memcpy(src, swap + SWAP_SOURCE(layer), sizeof(src));
+		memcpy(dst, swap + SWAP_DEST(layer), sizeof(dst));
+		s = surfaces[layer];
+		if (report) {
+			IOLog("MiniIOMobileFramebuffer: swap %u layer %u: surface %u%s (%ux%u '%c%c%c%c') "
+			    "from %d,%d %dx%d to %d,%d %dx%d, layers set 0x%x\n", swapWord(swap, SWAP_ID), layer, sid,
+			    s ? "" : " MISSING", s ? s->info.width : 0, s ? s->info.height : 0,
+			    s ? (int) (s->info.pixelFormat >> 24 & 0xff) : '?', s ? (int) (s->info.pixelFormat >> 16 & 0xff) : '?',
+			    s ? (int) (s->info.pixelFormat >> 8 & 0xff) : '?', s ? (int) (s->info.pixelFormat & 0xff) : '?',
+			    src[0], src[1], src[2], src[3], dst[0], dst[1], dst[2], dst[3], set);
+		}
+		if (s == NULL) {
+			continue;
+		}
+		if (s->info.bytesPerElement == 4 && s->info.planeCount == 0) {
+			if (!fGraphics) {
+				/* the first picture: the kernel's text console must stop drawing over it */
+				fGraphics = true;
+				PE_initialize_console(NULL, kPEGraphicsMode);
+			}
+			drawLayer(s, src, dst);
+			if (layer == 0) {
+				recorded = s;   /* (recorded once the frame is in the panel's memory: see below) */
+			}
+		}
+	}
+	drawn = mach_absolute_time();
+	if (recorded != NULL) {
+		record(recorded);
+	}
+	fSwapsShown++;
+	if (gTouchLat) {
+		redwood_tl("tl: v %u ready %llu shown %llu done %llu\n", swapWord(swap, SWAP_ID), micros(ready), micros(shown),
+		    micros(drawn));
+	}
+	if (layers != fLayersShown) {
+		IOLog("MiniIOMobileFramebuffer: swap #%u: surfaces in layers 0x%x now (0x%x before): %u %u %u %u\n", fSwapsShown, layers,
+		    fLayersShown, swapWord(swap, SWAP_SURFACE(0)), swapWord(swap, SWAP_SURFACE(1)), swapWord(swap, SWAP_SURFACE(2)),
+		    swapWord(swap, SWAP_SURFACE(3)));
+		fLayersShown = layers;
+	}
+
+	/* every five seconds in which something was drawn: how many frames, and what each cost here */
+	fStatFrames++;
+	fStatDrawing += mach_absolute_time() - began;
+	if (fStatSince == 0) {
+		fStatSince = began;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - fStatSince, &nanos);
+	if (nanos >= 5 * NSEC_PER_SEC) {
+		uint64_t drawing, waiting, beat;
+		unsigned different;
+
+		absolutetime_to_nanoseconds(fStatDrawing, &drawing);
+		absolutetime_to_nanoseconds(fStatWaiting, &waiting);
+		absolutetime_to_nanoseconds(fStatBeatWait, &beat);
+		IOLog("MiniIOMobileFramebuffer: %u frames in %llu ms (%llu a second), %llu us each in the driver, after %llu us "
+		    "waiting for the GPU and, %u of them, %llu us for the next refresh; %u swaps waited for the frame before, "
+		    "%u gave up; %u swaps came a refresh late themselves\n", fStatFrames, nanos / NSEC_PER_MSEC,
+		    fStatFrames * NSEC_PER_SEC / nanos, drawing / fStatFrames / NSEC_PER_USEC,
+		    waiting / fStatFrames / NSEC_PER_USEC, fStatOnBeat, fStatOnBeat ? beat / fStatOnBeat / NSEC_PER_USEC : 0,
+		    fStatHeld, fStatLost, fStatSwapsLate);
+		IOLog("MiniIOMobileFramebuffer: %u swaps came before the GPU work of their surface, %u of them shown without it\n",
+		    fStatStale, fStatStaleShown);
+		if (surfaces[0] != NULL) {
+			IOLog("MiniIOMobileFramebuffer: the last swap's surface %u: its last GPU submission %u (0: none ever named it)\n",
+			    surfaces[0]->sid, surfaces[0]->drawn);
+		}
+		fStatSwapsLate = fStatStale = fStatStaleShown = 0;
+		/*
+		 * The last swap as it came, every five seconds rather than for the first eight: the
+		 * first ones are lost from a long run's log, and with CoreAnimation's GPU renderer the
+		 * panel stayed on the loader's picture through hundreds of swaps that each cost 0 us
+		 * here -- swaps with no surface in them, or with one not found. The words of the header
+		 * that are not zero, offset:value, for what the window server put where.
+		 */
+		{
+			char words[400];
+			unsigned at = 0;
+
+			for (unsigned off = 0; off < 0x110 && at < sizeof(words) - 24; off += 4) {
+				uint32_t w = swapWord(swap, off);
+
+				if (w != 0) {
+					at += (unsigned) snprintf(words + at, sizeof(words) - at, " %x:%x", off, w);
+				}
+			}
+			words[at] = '\0';
+			IOLog("MiniIOMobileFramebuffer: the last swap: surfaces %u %u %u %u (found %d %d %d %d); words%s\n",
+			    swapWord(swap, SWAP_SURFACE(0)), swapWord(swap, SWAP_SURFACE(1)), swapWord(swap, SWAP_SURFACE(2)),
+			    swapWord(swap, SWAP_SURFACE(3)), surfaces[0] != NULL, surfaces[1] != NULL, surfaces[2] != NULL,
+			    surfaces[3] != NULL, words);
+		}
+		for (different = 0; different < 8 && fStatSurfaces[different] != 0; different++) {
+		}
+		if (different == 8 && fStatFrames > 8) {
+			uint32_t made, freed, again;
+			uint64_t making, freeing;
+
+			/* (CoreAnimation has made itself a new surface for every frame: see "the frames' surfaces" above) */
+			MiniIOSurfaceCost(&made, &making, &freed, &freeing, &again);
+			IOLog("MiniIOMobileFramebuffer: the frames came in surfaces %u, %u, %u, %u, %u and on, none twice; in that time "
+			    "%u surfaces of all kinds were made, in %llu us each (%u of them of memory kept from one before), and %u "
+			    "freed, in %llu us each\n", fStatSurfaces[0], fStatSurfaces[1], fStatSurfaces[2], fStatSurfaces[3],
+			    fStatSurfaces[4], made, making, again, freed, freeing);
+		}
+		bzero(fStatSurfaces, sizeof(fStatSurfaces));
+		fStatHeld = fStatLost = fStatOnBeat = 0;
+		fStatWaiting = fStatBeatWait = 0;
+		reportFrameTimes();
+		if (fDiff) {
+			IOLog("MiniIOMobileFramebuffer: %llu pixels of the panel changed a frame, all within %u,%u to %u,%u\n",
+			    fDiffPixels / fStatFrames, fDiffLeft, fDiffTop, fDiffRight, fDiffBottom);
+			fDiffPixels = 0;
+			fDiffLeft = fDiffTop = ~0u;
+			fDiffRight = fDiffBottom = 0;
+		}
+		fStatFrames = 0;
+		fStatDrawing = 0;
+		fStatSince = 0;
+	}
+	IOLockUnlock(fLock);
+}
+
+/* The run is about to end (redwood_adreno_stop): the frame on screen back in the panel's memory, dada's display on it. */
+extern "C" void
+MiniIOMobileFramebufferEnd(void)
+{
+	IOMobileFramebuffer * fb = gFramebuffer;
+
+	if (fb != NULL && fb->fScan) {
+		IOLockLock(fb->fLock);
+		hakios_dada_scanout_end(fb->fBase, fb->fRowBytes);
+		fb->fScan = false;
+		IOLockUnlock(fb->fLock);
+	}
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+class IOMobileFramebufferUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
+
+	task_t                  fTask;
+	IOMobileFramebuffer *   fOwner;
+	IOLock *                fLock;
+	mach_port_t             fPorts[kFBNotifyTypes];
+	mach_vm_address_t       fCallbacks[kFBNotifyTypes];
+	io_user_reference_t     fRefcons[kFBNotifyTypes];
+	thread_call_t           fVSyncCall;
+	uint64_t                fVSyncCount;
+	uint64_t                fVSyncTime;             /* when the refresh being waited for is due */
+	bool                    fVSyncRunning;
+	bool                    fClosed;
+
+	static void vsyncFired(thread_call_param_t self, thread_call_param_t unused);
+	void vsync(void);
+	void armVSync(void);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	{
+		char procname[32] = "?";
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniIOMobileFramebuffer: opened by %s[%d], type %u\n", procname, proc_selfpid(), (unsigned) type);
+	}
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService * provider)
+{
+	fOwner = OSDynamicCast(IOMobileFramebuffer, provider);
+	if (fOwner == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	fVSyncCall = thread_call_allocate(&IOMobileFramebufferUserClient::vsyncFired, this);
+	return fLock != NULL && fVSyncCall != NULL;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fLock != NULL) {
+		IOLockLock(fLock);
+		fClosed = true;
+		IOLockUnlock(fLock);
+	}
+	if (fVSyncCall != NULL) {
+		thread_call_cancel_wait(fVSyncCall);
+	}
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOMobileFramebufferUserClient::free(void)
+{
+	if (fVSyncCall != NULL) {
+		thread_call_cancel_wait(fVSyncCall);
+		thread_call_free(fVSyncCall);
+		fVSyncCall = NULL;
+	}
+	for (unsigned i = 0; i < kFBNotifyTypes; i++) {
+		if (fPorts[i] != NULL) {
+			releaseNotificationPort(fPorts[i]);
+			fPorts[i] = NULL;
+		}
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
+{
+	mach_port_t old;
+
+	IOLog("MiniIOMobileFramebuffer: notification port for type %u\n", (unsigned) type);
+	if (type >= kFBNotifyTypes) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	old = fPorts[type];
+	fPorts[type] = port;
+	IOLockUnlock(fLock);
+	if (old != NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOMobileFramebufferUserClient::vsyncFired(thread_call_param_t self, thread_call_param_t unused)
+{
+	((IOMobileFramebufferUserClient *) self)->vsync();
+}
+
+/* With the lock held. */
+void
+IOMobileFramebufferUserClient::armVSync(void)
+{
+	uint64_t period, now = mach_absolute_time();
+
+	/* one refresh after the last, not after whenever we got round to this: the rate does not drift */
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / refreshHz(), &period);
+	fVSyncTime += period;
+	if (fVSyncTime <= now || fVSyncTime > now + 2 * period) {
+		fVSyncTime = now + period;
+	}
+	thread_call_enter_delayed(fVSyncCall, fVSyncTime);
+}
+
+/*
+ * One refresh: tell the client, which gets three 64-bit numbers as six 32-bit halves --
+ * the time of this refresh, the same again (the time it was presented), and a counter.
+ */
+void
+IOMobileFramebufferUserClient::vsync(void)
+{
+	OSAsyncReference64 ref;
+	io_user_reference_t args[6];
+	uint64_t now;
+	bool send = false;
+
+	IOLockLock(fLock);
+	now = fVSyncTime;
+	if (fClosed || fCallbacks[kFBNotifyVSync] == 0 || fPorts[kFBNotifyVSync] == NULL) {
+		fVSyncRunning = false;
+	} else {
+		fVSyncCount++;
+		setAsyncReference64(ref, fPorts[kFBNotifyVSync], fCallbacks[kFBNotifyVSync], fRefcons[kFBNotifyVSync], fTask);
+		args[0] = (uint32_t) now;
+		args[1] = now >> 32;
+		args[2] = (uint32_t) now;
+		args[3] = now >> 32;
+		args[4] = (uint32_t) fVSyncCount;
+		args[5] = fVSyncCount >> 32;
+		send = true;
+		armVSync();
+	}
+	IOLockUnlock(fLock);
+	if (send) {
+		sendAsyncResult64WithOptions(ref, kIOReturnSuccess, args, 6, kIOUserNotifyOptionCanDrop);
+	}
+}
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	const uint64_t * in = args->scalarInput;
+	uint64_t * out = args->scalarOutput;
+	MiniIOSurface * s;
+
+	if (selector < 128 && gFBCalls[selector] < gFBTrace) {
+		char procname[32] = "?";
+
+		gFBCalls[selector]++;
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniIOMobileFramebuffer: %s[%d] selector %u (scalars %u in [0x%llx 0x%llx 0x%llx 0x%llx], %u out; "
+		    "structure %u in, %u out)\n", procname, proc_selfpid(), selector, args->scalarInputCount,
+		    args->scalarInputCount > 0 ? in[0] : 0, args->scalarInputCount > 1 ? in[1] : 0,
+		    args->scalarInputCount > 2 ? in[2] : 0, args->scalarInputCount > 3 ? in[3] : 0, args->scalarOutputCount,
+		    args->structureInputSize, args->structureOutputSize);
+	}
+
+	switch (selector) {
+	case kFBMethodGetDisplaySize:                   /* out: width, height */
+		if (args->scalarOutputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = fOwner->fWidth;
+		out[1] = fOwner->fHeight;
+		args->scalarOutputCount = 2;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetID:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = 1;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetDotPitch:                      /* out: pixels per inch */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = kFBDotsPerInch * fOwner->fWidth / kFBDefaultWidth;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodGetLayerDefaultSurface:           /* in: size wanted (or 0, 0); out: a send right for the surface */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		s = fOwner->defaultSurface();
+		if (s == NULL) {
+			return kIOReturnNoMemory;
+		}
+		out[0] = MiniIOSurfaceMakeSendRight(fTask, s);
+		args->scalarOutputCount = 1;
+		return out[0] != 0 ? kIOReturnSuccess : kIOReturnNoMemory;
+
+	case kFBMethodSwapBegin:                        /* out: the number of the new swap */
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = OSIncrementAtomic(&fOwner->fSwapID) + 1;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	case kFBMethodSwapEnd:
+		if (args->structureInput == NULL || args->structureInputSize < SWAP_SIZE) {
+			IOLog("MiniIOMobileFramebuffer: swap request of %u bytes, expected %u\n", args->structureInputSize, SWAP_SIZE);
+			return kIOReturnBadArgument;
+		}
+		if (args->structureInputSize >= SWAP26_SIZE) {
+			/*
+			 * iOS 26's request (0x588 bytes) is iOS 16.5's with 0x48 bytes more ahead of the swap's own
+			 * fields: the ID, the layers' surfaces, source rectangles, flags, destination rectangles and the
+			 * masks of the layers set and cleared all sit 0x48 further on (kern_SwapBegin/SwapSetLayer in
+			 * IOMobileFramebuffer.framework). Seen from there it is the old one.
+			 */
+			uint8_t old[SWAP_SIZE];
+
+			memcpy(old, (const uint8_t *) args->structureInput + SWAP26_SHIFT, SWAP_SIZE);
+			fOwner->present(old);
+			return kIOReturnSuccess;
+		}
+		fOwner->present((const uint8_t *) args->structureInput);
+		return kIOReturnSuccess;
+
+	case kFBMethodSwapWait:                         /* a swap is on the screen as soon as it is made */
+		if (gTouchLat) {
+			redwood_tl("tl: w %llu %#llx %#llx at %llu\n", args->scalarInputCount > 0 ? in[0] : 0,
+			    args->scalarInputCount > 1 ? in[1] : 0, args->scalarInputCount > 2 ? in[2] : 0, micros(mach_absolute_time()));
+		}
+		return kIOReturnSuccess;
+	case kFBMethodSwapSignal:
+	case kFBMethodSwapCancel:
+	case kFBMethodSwapCancelAll:
+	case kFBMethodRequestPowerChange:
+	case kFBMethodChangeFrameInfo:
+		return kIOReturnSuccess;
+
+	case kFBMethodNotifications:                    /* in: callback (0 = off), its argument, type, 0 */
+		if (args->scalarInputCount < 3 || in[2] >= kFBNotifyTypes) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		fCallbacks[in[2]] = in[0];
+		fRefcons[in[2]] = in[1];
+		if (in[2] == kFBNotifyVSync && in[0] != 0 && !fVSyncRunning && !fClosed) {
+			fVSyncRunning = true;
+			armVSync();
+		}
+		IOLockUnlock(fLock);
+		return kIOReturnSuccess;
+
+	case kFBMethodSupportedFrameInfo:               /* in: type; out: how many, and their tags: none */
+		if (args->scalarOutputCount >= 1) {
+			out[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		return kIOReturnSuccess;
+
+	case kFBMethodGetBlock:                         /* in: which block; out: its bytes */
+		if (args->structureOutput == NULL) {
+			return kIOReturnBadArgument;
+		}
+		bzero(args->structureOutput, args->structureOutputSize);
+		if (args->scalarInputCount >= 1 && in[0] == 0x40 && args->structureOutputSize >= 12) {
+			/* the current mode: its colour and timing identifiers */
+			uint32_t ids[2] = { kFBColorID, kFBTimingID };
+
+			memcpy((uint8_t *) args->structureOutput + 4, ids, sizeof(ids));
+		}
+		return kIOReturnSuccess;
+
+	case kFBMethodGetCurrentAbsoluteTime:
+		if (args->scalarOutputCount < 1) {
+			return kIOReturnBadArgument;
+		}
+		out[0] = mach_absolute_time();
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+
+	default:
+		break;
+	}
+
+	if (selector < 128 && !(gFBLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		gFBLogged[selector / 64] |= 1ULL << (selector % 64);
+		IOLog("MiniIOMobileFramebuffer: selector %u not implemented (scalars %u in [0x%llx 0x%llx 0x%llx], %u out; "
+		    "structure %u in, %u out)\n", selector, args->scalarInputCount, args->scalarInputCount > 0 ? in[0] : 0,
+		    args->scalarInputCount > 1 ? in[1] : 0, args->scalarInputCount > 2 ? in[2] : 0, args->scalarOutputCount,
+		    args->structureInputSize, args->structureOutputSize);
+	}
+	/* a request that only sets something is accepted; one that wants an answer gets zeros */
+	if (args->scalarOutputCount != 0) {
+		bzero(out, args->scalarOutputCount * sizeof(out[0]));
+	}
+	if (args->structureOutput != NULL && args->structureOutputSize != 0) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/*
+ * IOMobileFramebuffer.framework counts the displays it should wait for by looking for
+ * children of /arm-io in the device tree whose device_type is "display-subsystem".
+ */
+static void
+publishDisplayNode(void)
+{
+	IORegistryEntry * armio = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	IORegistryEntry * node;
+	OSDictionary * props;
+	OSData * data;
+
+	if (armio == NULL) {
+		IOLog("MiniIOMobileFramebuffer: no /arm-io in the device tree\n");
+		return;
+	}
+	node = OSTypeAlloc(IORegistryEntry);
+	props = OSDictionary::withCapacity(4);
+	if (node != NULL && props != NULL) {
+		data = OSData::withBytes("display-subsystem", sizeof("display-subsystem"));
+		props->setObject("device_type", data);
+		OSSafeReleaseNULL(data);
+		data = OSData::withBytes("redwood,framebuffer", sizeof("redwood,framebuffer"));
+		props->setObject("compatible", data);
+		OSSafeReleaseNULL(data);
+		data = OSData::withBytes("disp0", sizeof("disp0"));
+		props->setObject("name", data);
+		OSSafeReleaseNULL(data);
+		if (node->init(props)) {
+			node->setName("disp0");
+			node->attachToParent(armio, gIODTPlane);
+		}
+	}
+	OSSafeReleaseNULL(props);
+	OSSafeReleaseNULL(node);
+	armio->release();
+}
+
+/*
+ * The graphics accelerator. There is none, but CoreAnimation waits half a minute for a
+ * service of this class to appear before it looks for a GPU at all (once per process). An
+ * accelerator without the properties that name its Metal and OpenGL ES drivers is passed
+ * over by both, which leaves CoreAnimation with its software renderer, as before.
+ *
+ * With boot-arg metal=1 a user process may put those two properties here, which is the whole
+ * of what keeps Metal from finding our driver; see setProperties below, and docs/metal.md 10.31
+ * (10.14 for the measurement that made it a boot-arg).
+ */
+
+/* Metal's step 2 reads exactly these two, in this order, off this service (docs/metal.md 1). */
+#define kAcceleratorPluginNameKey      "MetalPluginName"
+#define kAcceleratorPluginClassNameKey "MetalPluginClassName"
+
+static bool gAcceleratorTakesProperties;        /* boot-arg metal=1 */
+
+class IOAcceleratorES : public IOService
+{
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+/*
+ * Switch Metal's own device discovery on, from user space: IORegistryEntrySetCFProperties() with
+ * MetalPluginName and MetalPluginClassName. Metal reads the first (getMetalPluginClassForService,
+ * 0x181a39ba4), builds "/System/Library/Extensions/" + it + ".bundle", opens that with NSBundle
+ * and takes the class the second names; with the first missing it returns nil before it even
+ * reads the second, and that single `cbz` is where the chain breaks on this port today.
+ *
+ * This method is the only thing that was in the way. IORegistryEntry::setProperties is
+ * "return kIOReturnUnsupported" (IORegistryEntry.cpp) and IOService does not override it; the
+ * MAC check in front of the call has no policy to ask, because this kernel registers no iokit
+ * hook (bsd/kern/kern_minimac.c); and this service carries no property whitelist.
+ *
+ * Why it is gated on a boot-arg, which is a measured risk and not caution in general
+ * (docs/metal.md 10.14): the conditions Metal puts on a device object are asserts, not soft
+ * refusals (10.2-10.3). A process that asks Metal and is handed a half-made device does not
+ * degrade to another renderer -- it aborts ("Assertion failed: ([self
+ * conformsToProtocol:@protocol(MTLDeviceSPI)])", "failed assertion _limits.maxColorAttachments
+ * > 0"), and an aborting daemon is restarted by launchd, which is a loop. Published instead at
+ * registerService() time, the properties would exist before launchd, backboardd and SpringBoard
+ * are born, so each of the three would take the Metal road on its first call, with nobody left
+ * to read the log. Behind a boot-arg, a machine that has them is a machine booted on purpose to
+ * have them, and the first such boot is meant to be RC=rc.ios, where launchd is never born.
+ *
+ * An empty string removes a property rather than setting it. That is the way out of the loop
+ * above without a reboot: the properties live only in the registry, so processes started after
+ * they are gone go back to the software road.
+ *
+ * Everything else is refused, and refused whole, before anything is set: every process on the
+ * machine can reach this method and the only thing it exists for is this one switch.
+ */
+IOReturn
+IOAcceleratorES::setProperties(OSObject * properties)
+{
+	OSDictionary * dict = OSDynamicCast(OSDictionary, properties);
+	OSCollectionIterator * keys;
+	OSObject * next;
+	char who[32] = "?";
+
+	if (!gAcceleratorTakesProperties) {
+		static unsigned said;
+
+		if (said++ < 4) {
+			proc_selfname(who, sizeof(who));
+			IOLog("IOAcceleratorES: %s asks to set properties on it; boot-arg metal=1 was not given\n", who);
+		}
+		return kIOReturnUnsupported;
+	}
+	if (dict == NULL || dict->getCount() == 0) {
+		return kIOReturnBadArgument;
+	}
+	keys = OSCollectionIterator::withCollection(dict);
+	if (keys == NULL) {
+		return kIOReturnNoMemory;
+	}
+	proc_selfname(who, sizeof(who));
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol * key = OSDynamicCast(OSSymbol, next);
+
+		if (key == NULL || (!key->isEqualTo(kAcceleratorPluginNameKey) &&
+		    !key->isEqualTo(kAcceleratorPluginClassNameKey))) {
+			IOLog("IOAcceleratorES: refusing what %s sent: only " kAcceleratorPluginNameKey " and "
+			    kAcceleratorPluginClassNameKey " are taken here\n", who);
+			keys->release();
+			return kIOReturnUnsupported;
+		}
+		if (OSDynamicCast(OSString, dict->getObject(key)) == NULL) {
+			IOLog("IOAcceleratorES: refusing \"%s\" from %s: Metal reads it as a CFString\n",
+			    key->getCStringNoCopy(), who);
+			keys->release();
+			return kIOReturnBadArgument;
+		}
+	}
+	keys->reset();
+	while ((next = keys->getNextObject()) != NULL) {
+		const OSSymbol * key = OSDynamicCast(OSSymbol, next);
+		OSString * value = OSDynamicCast(OSString, dict->getObject(key));
+
+		if (value->getLength() == 0) {
+			removeProperty(key);
+			IOLog("IOAcceleratorES: %s removed by %s\n", key->getCStringNoCopy(), who);
+		} else if (setProperty(key, value)) {
+			IOLog("IOAcceleratorES: %s = %s, set by %s\n", key->getCStringNoCopy(),
+			    value->getCStringNoCopy(), who);
+		} else {
+			IOLog("IOAcceleratorES: %s could not be set\n", key->getCStringNoCopy());
+			keys->release();
+			return kIOReturnNoMemory;
+		}
+	}
+	keys->release();
+	return kIOReturnSuccess;
+}
+
+static void
+publishAccelerator(IOService * provider)
+{
+	IOAcceleratorES * accelerator = OSTypeAlloc(IOAcceleratorES);
+	uint32_t metal = 0;
+
+	gAcceleratorTakesProperties = PE_parse_boot_argn("metal", &metal, sizeof(metal)) && metal != 0;
+	if (accelerator != NULL && accelerator->init() && accelerator->attach(provider)) {
+		accelerator->setName("sgx");
+		accelerator->registerService();
+		/* the first line to look for in the log of such a boot: the gate is open, nothing is set yet */
+		if (gAcceleratorTakesProperties) {
+			IOLog("IOAcceleratorES: metal=%u: this service takes " kAcceleratorPluginNameKey
+			    " and " kAcceleratorPluginClassNameKey " from user space\n", metal);
+		}
+	}
+	OSSafeReleaseNULL(accelerator);
+}
+
+/*
+ * A picture from inside the kernel (the GPU driver's first ones): rows of 32-bit pixels, put at
+ * the top left corner of the panel as they are and cut to its size.
+ */
+extern "C" void
+MiniIOMobileFramebufferShow(const uint8_t * pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
+{
+	uint32_t columns = width < vinfo.v_width ? width : (uint32_t) vinfo.v_width;
+	uint32_t rows = height < vinfo.v_height ? height : (uint32_t) vinfo.v_height;
+
+	if (vinfo.v_baseaddr == 0 || vinfo.v_depth != 32) {
+		return;
+	}
+	for (uint32_t y = 0; y < rows; y++) {
+		memcpy((void *) (vinfo.v_baseaddr + (size_t) y * vinfo.v_rowbytes), pixels + (size_t) y * rowBytes,
+		    (size_t) columns * 4);
+	}
+}
+
+void
+MiniIOMobileFramebufferStart(IOService * provider)
+{
+	IOMobileFramebuffer * fb = OSTypeAlloc(IOMobileFramebuffer);
+
+	if (fb == NULL || !fb->init() || !fb->attach(provider)) {
+		OSSafeReleaseNULL(fb);
+		return;
+	}
+	if (fb->start(provider)) {
+		publishDisplayNode();
+		publishAccelerator(provider);
+	} else {
+		fb->detach(provider);
+	}
+	fb->release();
+}
diff --git a/iokit/Kernel/MiniIONetworkStack.cpp b/iokit/Kernel/MiniIONetworkStack.cpp
new file mode 100644
index 0000000..a2b963c
--- /dev/null
+++ b/iokit/Kernel/MiniIONetworkStack.cpp
@@ -0,0 +1,114 @@
+/*
+ * MiniIONetworkStack: a stand-in for IONetworkStack of Apple's IONetworkingFamily, as seen by
+ * configd's interface namer.
+ *
+ * The real one gives the BSD names (en0, en1, ...) to the IONetworkInterface objects of the
+ * drivers, when the interface namer asks. Here interfaces are made with the BSD interface KPI
+ * (bsd/dev/redwood_net.c) and are born with their names, so there is never anything to name.
+ * But the namer wants this object all the same: until it has opened it, it does not say in
+ * configd's store that the registry has gone quiet (the key Plugin:InterfaceNamer, "*QUIET*"),
+ * and gives up only after five minutes ("*TIMEOUT*"). SystemConfiguration's
+ * SCNetworkInterfaceCopyAll() waits for one of the two, and with it whoever asks for the list of
+ * interfaces: wifid as soon as it has a device, and behind wifid SpringBoard.
+ *
+ * So: the service, a user client that can be opened, and a refusal of the naming request.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniDrivers.h"
+
+class IONetworkStack : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkStack);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStack, IOService);
+
+bool
+IONetworkStack::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IONetworkStackUserClient");
+	setName("IONetworkStack");
+	registerService();
+	return true;
+}
+
+class IONetworkStackUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(IONetworkStackUserClient);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject * properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IONetworkStackUserClient, IOUserClient);
+
+bool
+IONetworkStackUserClient::start(IOService * provider)
+{
+	char who[32] = "?";
+
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	/* whether the registry is quiet at this moment is what the namer goes on to ask */
+	proc_selfname(who, sizeof(who));
+	IOLog("MiniIONetworkStack: opened by %s; the registry's busy state is %u\n", who,
+	    (unsigned) IOService::getServiceRoot()->getBusyState());
+	return true;
+}
+
+IOReturn
+IONetworkStackUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+/* "Name this interface" (a dictionary: IONetworkStackUserCommand, IOPathMatch, IOInterfaceUnit). */
+IOReturn
+IONetworkStackUserClient::setProperties(OSObject * properties)
+{
+	static unsigned said;
+
+	if (said++ < 4) {
+		IOLog("MiniIONetworkStack: asked to name an interface: there are none of that kind\n");
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+void
+MiniIONetworkStackStart(void)
+{
+	/* where the real one is: IOService:/IOResources/IONetworkStack */
+	IOService * resources = IOService::getResourceService();
+	IONetworkStack * stack = OSTypeAlloc(IONetworkStack);
+
+	if (resources == NULL || stack == NULL || !stack->init() || !stack->attach(resources)) {
+		OSSafeReleaseNULL(stack);
+		IOLog("MiniIONetworkStack: cannot create the service\n");
+		return;
+	}
+	if (!stack->start(resources)) {
+		stack->detach(resources);
+	}
+	stack->release();
+}
diff --git a/iokit/Kernel/MiniIOSurface.cpp b/iokit/Kernel/MiniIOSurface.cpp
new file mode 100644
index 0000000..097dc15
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.cpp
@@ -0,0 +1,2402 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext (see MiniIOSurface.h).
+ *
+ * A surface is a piece of wired kernel memory: one page of state that clients read directly,
+ * followed by the pixels. Every client that knows a surface has the whole of it mapped once.
+ * Surfaces travel between processes as Mach send rights (IOSurfaceSendRight) or by number.
+ *
+ * What is not here: child surfaces, wrapping of client memory, purgeability, compression,
+ * notifications. Calls that are not implemented are logged once and refused.
+ */
+
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSSerialize.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <libkern/c++/OSSymbol.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/thread_call.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+
+#include "MiniIOSurface.h"
+
+extern "C" void redwood_tl(const char * format, ...) __printflike(1, 2);
+/* hakios: once user space owns the console the kernel's IOLog reaches no log we can read: say it in the loader's */
+#define IOLog(...) redwood_tl(__VA_ARGS__)
+
+static_assert(sizeof(struct minisurf_plane) == 0x80, "plane layout");
+static_assert(sizeof(struct minisurf_result) == 0x68, "result layout");
+static_assert(offsetof(struct minisurf_shared, attachments) == 0x30, "shared layout");
+static_assert(sizeof(struct minisurf_result) + 20 * sizeof(struct minisurf_plane) == MINISURF_RESULT_MAX, "result size");
+
+/* IOConnectCallMethod selectors of IOSurfaceRootUserClient (iOS 16.5) */
+enum {
+	kSurfaceMethodCreate            = 0,
+	kSurfaceMethodLookup            = 4,
+	kSurfaceMethodSetYCbCrMatrix    = 5,
+	kSurfaceMethodWrapClientImage   = 6,
+	kSurfaceMethodWrapClientMemory  = 7,
+	kSurfaceMethodSetValue          = 9,
+	kSurfaceMethodCopyValue         = 10,
+	kSurfaceMethodRemoveValue       = 11,
+	kSurfaceMethodBindAccel         = 12,
+	kSurfaceMethodInit              = 13,
+	kSurfaceMethodLog               = 19,
+	kSurfaceMethodSetPurgeable      = 20,
+	kSurfaceMethodSetOwnership      = 21,
+	kSurfaceMethodSetTiled          = 22,
+	kSurfaceMethodSetTimestamp      = 24,
+	kSurfaceMethodSetBulkAttachments = 27,
+	kSurfaceMethodCommPageAddress   = 32,
+	kSurfaceMethodSetIndexedTimestamp = 33,
+	kSurfaceMethodLookupFromPort    = 34,
+	kSurfaceMethodCreatePort        = 35,
+	kSurfaceMethodEventCreate       = 36,   /* IOSurfaceSharedEvent: in options; out its port, its value's address here */
+	kSurfaceMethodEventMap          = 38,   /* in an event's port; out -, its value's address here, its id, 0 */
+	kSurfaceMethodEventNotify       = 39,   /* in the event's port, the listener, the event object, the block, the value */
+	kSurfaceMethodEventAddListener  = 40,   /* async: the listener's notification port and its reference (callback, listener) */
+	kSurfaceMethodEventRemoveListener = 41, /* in the listener */
+	kSurfaceMethodDetachModeCode    = 43,
+	kSurfaceMethodSetOwnershipIdentity = 44,
+};
+
+/* IOConnectTrap indices */
+enum {
+	kSurfaceTrapIncrementUseCount   = 0,
+	kSurfaceTrapDecrementUseCount   = 1,
+	kSurfaceTrapLock                = 2,
+	kSurfaceTrapUnlock              = 3,
+	kSurfaceTrapDetach              = 4,    /* the client is about to release: forget it has the surface */
+	kSurfaceTrapRelease             = 5,
+	kSurfaceTrapEventWait           = 6,    /* the event's port, the value, a timeout in ms */
+	kSurfaceTrapEventSignal         = 7,    /* the event's port, the value */
+	kSurfaceTrapCount
+};
+
+#define kSurfaceLockReadOnly    1u
+
+#define MINISURF_TABLE_SIZE     16384
+#define MINISURF_MAX_DIMENSION  16384
+#define MINISURF_MAX_ALLOC      (512u << 20)
+#define MINISURF_ROW_ALIGN      64
+
+#define FOURCC(a, b, c, d) ((uint32_t)(a) << 24 | (uint32_t)(b) << 16 | (uint32_t)(c) << 8 | (uint32_t)(d))
+
+static IOLock *         gSurfaceLock;
+static MiniIOSurface *  gSurfaceTable[MINISURF_TABLE_SIZE];     /* index = surface number; [0] unused */
+static uint32_t         gSurfaceNext = 1;
+static uint32_t         gSurfaceCount;
+static uint64_t         gSurfaceBytes;
+static uint32_t         gSurfaceUnheld;         /* surfaces around client memory that could not be made (said a few times) */
+/* what making surfaces and taking them away has cost since it was last asked (MiniIOSurfaceCost()) */
+static uint64_t         gSurfaceMaking, gSurfaceFreeing;
+static uint32_t         gSurfacesMade, gSurfacesFreed;
+static uint64_t         gSurfaceLogged[2];                      /* selectors already complained about */
+/* Boot-arg surftrace=N: log the first N surfaces created (default 24). */
+static TUNABLE(uint32_t, gSurfaceTrace, "surftrace", 24);
+static uint32_t         gSurfaceTraced;                         /* (a tunable is read-only after boot) */
+/*
+ * Boot-arg surftrace_of=NAME: only the surfaces made by programs whose name begins with NAME count for
+ * surftrace (then up to N of theirs), and what becomes of them is said as well: the ports made for them
+ * and who looks them up from a port (another program, which shows it: the window server for a layer).
+ */
+static char             gSurfaceTraceOf[32];
+
+extern "C" void loader_log_line(const char *line);
+
+/* A line about a traced surface: to the loader's log too, where it outlives the kernel's own, short log. */
+static void
+traceLine(const char * format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	if (gSurfaceTraceOf[0] != 0) {
+		loader_log_line(line);
+	}
+	IOLog("%s", line);
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+OSDefineMetaClassAndStructors(MiniIOSurface, OSObject);
+
+/*
+ * The memory of the big surfaces is kept when they go, a few pieces of it, and given to the
+ * next surface of the same size. CoreAnimation makes a surface of the whole display for every
+ * frame and frees one: 14 MB got, cleared, entered into the kernel's map and taken out of it
+ * again, sixty times a second -- 2.8 ms to make and 2 ms to free each, a quarter of the time
+ * there is for a frame, on the thread that draws it. A piece that is kept is cleared again
+ * before it is given out: a new surface is all zeroes, whoever makes it. The clearing is done
+ * by the display's driver between two frames (MiniIOSurfaceClearKept(): while it copies a
+ * frame to the panel the memory is busy enough, and the copy took half as long again when
+ * this ran beside it), or a moment later by a thread of this file's if no frames are going
+ * out, or by whoever asks for the memory if that comes first.
+ */
+#define SURFACE_KEEP_FROM       (4u << 20)      /* bytes: smaller ones are not worth it */
+#define SURFACE_KEPT            4
+#define SURFACE_CLEAR_MS        40              /* kept memory is cleared this long after, if the display's driver has not done it */
+
+static struct {
+	IOBufferMemoryDescriptor *      memory;
+	bool                            clear;          /* cleared since it was last a surface's */
+	bool                            busy;           /* being cleared right now */
+	uint64_t                        since;          /* when it was kept */
+} gSurfaceKept[SURFACE_KEPT];
+static uint32_t         gSurfacesNotKept[2];    /* memory not kept: somebody else had it too; it put out a piece kept longer */
+static IOLock *         gSurfaceKeptLock;
+static thread_call_t    gSurfaceClearing;
+static uint32_t         gSurfacesGivenAgain;    /* for MiniIOSurfaceCost() */
+/* boot-arg surf_clear=0: kept memory is given out as it is (to see what the clearing costs; a surface is then not all zeroes) */
+static TUNABLE(uint32_t, gSurfaceClear, "surf_clear", 1);
+
+/*
+ * dada: zeroes the processor wrote are in its cache, dirty, until they are written back: the GPU then draws into the memory
+ * underneath, and the display's driver cleans and invalidates the surface before it copies it out (MiniIOMobileFramebuffer.cpp
+ * scanout) -- which wrote those zeroes back OVER the GPU's frame: black blocks and bands that came and went (g2k36r recording:
+ * the top half of a frame black, black strips; CoreAnimation draws only what changed and loads the rest, so a damaged region
+ * stayed until it was drawn again). Memory a surface gets is written back to memory as soon as it has been zeroed.
+ */
+static void
+surfaceMemoryWriteBack(const void * from, vm_size_t bytes)
+{
+	for (uintptr_t line = (uintptr_t) from & ~(uintptr_t) 63; line < (uintptr_t) from + bytes; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+MiniIOSurfaceClearKept(void)
+{
+	if (gSurfaceKeptLock == NULL || !gSurfaceClear) {
+		return;
+	}
+	IOLockLock(gSurfaceKeptLock);
+	for (unsigned i = 0; i < SURFACE_KEPT; i++) {
+		IOBufferMemoryDescriptor * memory = gSurfaceKept[i].memory;
+
+		if (memory == NULL || gSurfaceKept[i].clear || gSurfaceKept[i].busy) {
+			continue;
+		}
+		gSurfaceKept[i].busy = true;
+		IOLockUnlock(gSurfaceKeptLock);
+		bzero(memory->getBytesNoCopy(), memory->getCapacity());
+		surfaceMemoryWriteBack(memory->getBytesNoCopy(), memory->getCapacity());
+		IOLockLock(gSurfaceKeptLock);
+		gSurfaceKept[i].busy = false;
+		gSurfaceKept[i].clear = true;
+	}
+	IOLockUnlock(gSurfaceKeptLock);
+}
+
+static void
+surfaceMemoryClear(thread_call_param_t unused0 __unused, thread_call_param_t unused1 __unused)
+{
+	MiniIOSurfaceClearKept();
+}
+
+/* Memory for a surface: the state page and `bytes` after it, all zeroes. */
+static IOBufferMemoryDescriptor *
+surfaceMemory(vm_size_t bytes)
+{
+	IOBufferMemoryDescriptor * memory = NULL;
+	bool clear = false;
+
+	if (bytes >= SURFACE_KEEP_FROM && gSurfaceKeptLock != NULL) {
+		IOLockLock(gSurfaceKeptLock);
+		for (int pass = 0; pass < 2 && memory == NULL; pass++) {
+			/* one that is clear already, if there is one */
+			for (unsigned i = 0; i < SURFACE_KEPT && memory == NULL; i++) {
+				if (gSurfaceKept[i].memory != NULL && !gSurfaceKept[i].busy && (pass == 1 || gSurfaceKept[i].clear) &&
+				    gSurfaceKept[i].memory->getCapacity() == bytes) {
+					memory = gSurfaceKept[i].memory;
+					clear = gSurfaceKept[i].clear;
+					gSurfaceKept[i].memory = NULL;
+				}
+			}
+		}
+		gSurfacesGivenAgain += memory != NULL;
+		IOLockUnlock(gSurfaceKeptLock);
+		if (memory != NULL && !clear) {
+			bzero(memory->getBytesNoCopy(), gSurfaceClear ? bytes : PAGE_SIZE);
+			surfaceMemoryWriteBack(memory->getBytesNoCopy(), gSurfaceClear ? bytes : PAGE_SIZE);
+		}
+	}
+	if (memory == NULL) {
+		memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared, bytes,
+		    PAGE_SIZE);
+		/* (new memory is zeroed by the processor too, page by page) */
+		if (memory != NULL) {
+			surfaceMemoryWriteBack(memory->getBytesNoCopy(), memory->getCapacity());
+		}
+	}
+	return memory;
+}
+
+/*
+ * A surface is gone: its memory is kept for the next, if it is big and nobody else has it. When
+ * all the places are taken, it takes the place of the piece kept longest: pieces of a size nobody
+ * asks for again (a big picture made once) once stayed there for good, and then no frame's memory
+ * was kept any more -- each made afresh and freed (2 to 4 ms, and 1 to 2) instead of 0.3 and 0.05.
+ */
+static void
+surfaceMemoryBack(IOBufferMemoryDescriptor * memory)
+{
+	IOBufferMemoryDescriptor * evicted = NULL;
+
+	if (memory->getCapacity() >= SURFACE_KEEP_FROM && memory->getRetainCount() != 1) {
+		OSIncrementAtomic(&gSurfacesNotKept[0]);
+	}
+	if (memory->getCapacity() >= SURFACE_KEEP_FROM && memory->getRetainCount() == 1 && gSurfaceKeptLock != NULL) {
+		int oldest = -1;
+
+		IOLockLock(gSurfaceKeptLock);
+		for (unsigned i = 0; i < SURFACE_KEPT && memory != NULL; i++) {
+			if (gSurfaceKept[i].memory == NULL) {
+				gSurfaceKept[i].memory = memory;
+				gSurfaceKept[i].clear = gSurfaceKept[i].busy = false;
+				gSurfaceKept[i].since = mach_absolute_time();
+				memory = NULL;
+			} else if (!gSurfaceKept[i].busy && (oldest < 0 || gSurfaceKept[i].since < gSurfaceKept[oldest].since)) {
+				oldest = (int) i;
+			}
+		}
+		if (memory != NULL && oldest >= 0) {
+			evicted = gSurfaceKept[oldest].memory;
+			gSurfaceKept[oldest].memory = memory;
+			gSurfaceKept[oldest].clear = gSurfaceKept[oldest].busy = false;
+			gSurfaceKept[oldest].since = mach_absolute_time();
+			memory = NULL;
+			gSurfacesNotKept[1]++;
+		}
+		IOLockUnlock(gSurfaceKeptLock);
+		if (evicted != NULL) {
+			evicted->release();
+		}
+		if (memory == NULL) {
+			if (gSurfaceClear) {
+				AbsoluteTime deadline;
+
+				clock_interval_to_deadline(SURFACE_CLEAR_MS, kMillisecondScale, &deadline);
+				thread_call_enter_delayed(gSurfaceClearing, deadline);
+			}
+			return;
+		}
+	}
+	memory->release();
+}
+
+void
+MiniIOSurface::free(void)
+{
+	uint64_t began = mach_absolute_time();
+
+	if (traced && kpixels != NULL) {
+		uint32_t nonzero = 0, middle = 0;
+
+		for (uint32_t at = 0; at + 4 <= info.allocSize; at += 64) {
+			nonzero += kpixels[at] != 0 || kpixels[at + 1] != 0 || kpixels[at + 2] != 0 || kpixels[at + 3] != 0;
+		}
+		memcpy(&middle, kpixels + (info.allocSize / 2 & ~3u), 4);
+		traceLine("MiniIOSurface: surface %u (%ux%u) goes: of every 64 bytes %u of %u begin with a pixel that is not 0, one in "
+		    "the middle %#010x\n", sid, info.width, info.height, nonzero, info.allocSize / 64, middle);
+	}
+
+	OSSafeReleaseNULL(values);
+	OSSafeReleaseNULL(snapshot);
+	OSSafeReleaseNULL(clientMap);
+	if (client != NULL) {
+		client->complete();
+		client->release();
+		client = NULL;
+	}
+	if (memory != NULL) {
+		surfaceMemoryBack(memory);
+		memory = NULL;
+	}
+	OSObject::free();
+	OSAddAtomic64((SInt64) (mach_absolute_time() - began), (SInt64 *) &gSurfaceFreeing);
+	OSIncrementAtomic(&gSurfacesFreed);
+}
+
+/* How many surfaces were made and freed since this was last asked, and the microseconds each took on average. */
+void
+MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again)
+{
+	uint64_t nanos;
+
+	*again = OSBitAndAtomic(0, &gSurfacesGivenAgain);
+
+	*made = OSBitAndAtomic(0, &gSurfacesMade);
+	*freed = OSBitAndAtomic(0, &gSurfacesFreed);
+	absolutetime_to_nanoseconds(gSurfaceMaking, &nanos);
+	*making = *made ? nanos / NSEC_PER_USEC / *made : 0;
+	absolutetime_to_nanoseconds(gSurfaceFreeing, &nanos);
+	*freeing = *freed ? nanos / NSEC_PER_USEC / *freed : 0;
+	gSurfaceMaking = gSurfaceFreeing = 0;
+}
+
+/* The values changed: a new seed, and how much room a client needs to fetch them. */
+void
+MiniIOSurface::updateValuesState(void)
+{
+	struct minisurf_shared * sh = shared();
+	uint32_t size = 0;
+
+	if (values != NULL && values->getCount() != 0) {
+		OSSerialize * s = OSSerialize::binaryWithCapacity(4096);
+		if (s != NULL) {
+			if (values->serialize(s)) {
+				size = s->getLength() + 8;
+			}
+			s->release();
+		}
+	}
+	sh->valuesSeed = (sh->valuesSeed + 2) | 1;
+	sh->valuesSize = size;
+}
+
+static uint32_t
+dictNumber(OSDictionary * dict, const char * key, uint32_t missing)
+{
+	OSObject * obj = dict ? dict->getObject(key) : NULL;
+	OSNumber * num = OSDynamicCast(OSNumber, obj);
+
+	if (num != NULL) {
+		return num->unsigned32BitValue();
+	}
+	if (obj == kOSBooleanTrue) {
+		return 1;
+	}
+	if (obj == kOSBooleanFalse) {
+		return 0;
+	}
+	return missing;
+}
+
+static uint32_t
+alignUp(uint64_t value, uint32_t to)
+{
+	return (uint32_t) ((value + to - 1) / to * to);
+}
+
+/* Bytes per element when the client did not say. */
+static uint32_t
+defaultBytesPerElement(uint32_t format)
+{
+	switch (format) {
+	case FOURCC('L', '0', '0', '8'):
+	case FOURCC('A', '0', '0', '8'):
+	case 0x00000008:
+		return 1;
+	case FOURCC('L', '5', '6', '5'):
+	case FOURCC('B', '5', '6', '5'):
+	case FOURCC('L', '5', '5', '5'):
+	case FOURCC('2', 'v', 'u', 'y'):
+	case FOURCC('y', 'u', 'v', 's'):
+	case FOURCC('y', 'u', 'v', 'f'):
+	case FOURCC('L', '0', '1', '6'):
+	case FOURCC('L', '0', '0', 'h'):
+		return 2;
+	case FOURCC('R', 'G', 'h', 'A'):
+		return 8;
+	case FOURCC('R', 'G', 'f', 'A'):
+		return 16;
+	default:
+		return 4;
+	}
+}
+
+/*
+ * Two-plane YCbCr formats: luma, then interleaved chroma.
+ * Returns false for anything else. *wide: 10-bit samples in 16 bits.
+ */
+static bool
+biplanarLayout(uint32_t format, uint32_t * hsub, uint32_t * vsub, bool * wide)
+{
+	switch (format) {
+	case FOURCC('4', '2', '0', 'v'): case FOURCC('4', '2', '0', 'f'):
+		*hsub = 2; *vsub = 2; *wide = false; return true;
+	case FOURCC('4', '2', '2', 'v'): case FOURCC('4', '2', '2', 'f'):
+		*hsub = 2; *vsub = 1; *wide = false; return true;
+	case FOURCC('4', '4', '4', 'v'): case FOURCC('4', '4', '4', 'f'):
+		*hsub = 1; *vsub = 1; *wide = false; return true;
+	case FOURCC('x', '4', '2', '0'): case FOURCC('x', 'f', '2', '0'):
+		*hsub = 2; *vsub = 2; *wide = true; return true;
+	case FOURCC('x', '4', '2', '2'): case FOURCC('x', 'f', '2', '2'):
+		*hsub = 2; *vsub = 1; *wide = true; return true;
+	case FOURCC('x', '4', '4', '4'): case FOURCC('x', 'f', '4', '4'):
+		*hsub = 1; *vsub = 1; *wide = true; return true;
+	default:
+		return false;
+	}
+}
+
+static void
+describeComponents(struct minisurf_plane * plane, uint32_t format)
+{
+	/* in memory order; names: 1 alpha, 2 red, 3 green, 4 blue */
+	static const uint8_t bgra[4] = { 4, 3, 2, 1 };
+	static const uint8_t rgba[4] = { 2, 3, 4, 1 };
+	const uint8_t * names;
+
+	if (format == FOURCC('B', 'G', 'R', 'A')) {
+		names = bgra;
+	} else if (format == FOURCC('R', 'G', 'B', 'A')) {
+		names = rgba;
+	} else {
+		return;
+	}
+	plane->componentCount = 4;
+	for (unsigned i = 0; i < 4; i++) {
+		plane->componentBitDepth[i] = 8;
+		plane->componentBitOffset[i] = (uint8_t) (8 * i);
+		plane->componentName[i] = names[i];
+		plane->componentType[i] = 1;            /* unsigned integer */
+		plane->componentRange[i] = 1;           /* full range */
+	}
+}
+
+/*
+ * Make a surface from the properties a client gave to IOSurfaceCreate().
+ * Returned with one holder, and entered in the table.
+ */
+static MiniIOSurface *
+surfaceCreate(OSDictionary * props, IOReturn * error)
+{
+	MiniIOSurface * s;
+	struct minisurf_result * info;
+	uint32_t width, height, format, bpe, ew, eh, bpr, alloc, offset, planeCount = 0;
+	uint32_t hsub, vsub;
+	bool wide, onePlane = false, lossless = false;
+	OSArray * planeInfo;
+	OSNumber * wrapped;
+	uint64_t needed;
+
+	*error = kIOReturnBadArgument;
+	width = dictNumber(props, "IOSurfaceWidth", 0);
+	height = dictNumber(props, "IOSurfaceHeight", 0);
+	format = dictNumber(props, "IOSurfacePixelFormat", 0);
+	/*
+	 * Ten bits a colour, packed into 32-bit pixels: what a device with a wide-gamut display
+	 * (the iPhone X is one) asks for when it wants a picture of the screen, a snapshot for a
+	 * transition for instance. CoreAnimation's software renderer does not draw into those
+	 * ("SW renderer invalid destination format w30r": the transition comes out black), and
+	 * there is no wide gamut on this panel anyway. The surface is made as ordinary BGRA of
+	 * the same geometry, and says so: whoever uses it reads the format back from the surface.
+	 */
+	if (format == 'w30r' || format == 'l10r' || format == 'w30R') {
+		format = 'BGRA';
+	}
+	/*
+	 * The same with alpha in a plane of its own: what CoreAnimation makes the screen's own
+	 * surfaces of once it draws with a GPU's renderer (OpenGL ES, userland/src/eagl.c) instead
+	 * of its software one. One plane of BGRA here too; the framebuffer shows nothing else.
+	 */
+	if (format == 'b3a8') {
+		format = 'BGRA';
+		onePlane = true;
+	}
+	/*
+	 * iOS 26: what CoreAnimation makes the screen's surfaces of once it draws with Metal --
+	 * kCVPixelFormatType_Lossless_32BGRA, BGRA that Apple's GPU keeps compressed, described in
+	 * planes (the pixels and the compression's metadata). There is no compression here: one
+	 * plane of plain BGRA, which is what the display driver copies to the panel (it skipped
+	 * these, a plane count of more than none, and the panel kept the loader's picture).
+	 */
+	if (format == '&BGA') {
+		format = 'BGRA';
+		onePlane = true;
+		lossless = true;
+	}
+	ew = dictNumber(props, "IOSurfaceElementWidth", 1);
+	eh = dictNumber(props, "IOSurfaceElementHeight", 1);
+	bpe = dictNumber(props, "IOSurfaceBytesPerElement", 0);
+	offset = dictNumber(props, "IOSurfaceOffset", 0);
+	if (lossless) {
+		/* (the element geometry asked for is the compressed one's: plain pixels here) */
+		ew = eh = 1;
+		bpe = 4;
+	}
+	if (width > MINISURF_MAX_DIMENSION || height > MINISURF_MAX_DIMENSION || ew == 0 || eh == 0 || ew > 255 || eh > 255) {
+		return NULL;
+	}
+	if (props->getObject("IOSurfaceAddressRanges") != NULL) {
+		IOLog("MiniIOSurface: wrapping client memory in pieces is not supported\n");
+		*error = kIOReturnUnsupported;
+		return NULL;
+	}
+	/*
+	 * A surface around memory the client has already: CoreAnimation's OpenGL ES renderer makes
+	 * them around pictures it has in memory (an application's icon, a layer's contents as the
+	 * application has drawn them), to hand them to the GPU as they are. The surface's pixels
+	 * are that memory itself, not a copy: the picture goes on being drawn into after the
+	 * surface is made, and whoever looks at the surface is to see what is there now.
+	 */
+	wrapped = OSDynamicCast(OSNumber, props->getObject("IOSurfaceAddress"));
+
+	s = OSTypeAlloc(MiniIOSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		*error = kIOReturnNoMemory;
+		return NULL;
+	}
+	info = &s->info;
+
+	planeInfo = onePlane ? NULL : OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	needed = 0;
+	if (planeInfo != NULL && planeInfo->getCount() != 0) {
+		planeCount = planeInfo->getCount();
+		if (planeCount > MINISURF_MAX_PLANES) {
+			IOLog("MiniIOSurface: %u planes asked for, %u supported\n", planeCount, MINISURF_MAX_PLANES);
+			s->release();
+			return NULL;
+		}
+		for (uint32_t i = 0; i < planeCount; i++) {
+			OSDictionary * pd = OSDynamicCast(OSDictionary, planeInfo->getObject(i));
+			struct minisurf_plane * p = &s->planes[i];
+			uint32_t pew = dictNumber(pd, "IOSurfacePlaneElementWidth", 1);
+			uint32_t peh = dictNumber(pd, "IOSurfacePlaneElementHeight", 1);
+
+			if (pew == 0 || peh == 0 || pew > 255 || peh > 255) {
+				s->release();
+				return NULL;
+			}
+			p->width = dictNumber(pd, "IOSurfacePlaneWidth", width);
+			p->height = dictNumber(pd, "IOSurfacePlaneHeight", height);
+			p->bytesPerElement = (uint16_t) dictNumber(pd, "IOSurfacePlaneBytesPerElement", bpe ? bpe : 1);
+			p->elementWidth = (uint8_t) pew;
+			p->elementHeight = (uint8_t) peh;
+			p->bytesPerRow = dictNumber(pd, "IOSurfacePlaneBytesPerRow", 0);
+			if (p->bytesPerRow == 0) {
+				p->bytesPerRow = alignUp((uint64_t) ((p->width + pew - 1) / pew) * p->bytesPerElement, MINISURF_ROW_ALIGN);
+			}
+			p->size = dictNumber(pd, "IOSurfacePlaneSize", 0);
+			if (p->size == 0) {
+				p->size = p->bytesPerRow * ((p->height + peh - 1) / peh);
+			}
+			p->offset = dictNumber(pd, "IOSurfacePlaneOffset", dictNumber(pd, "IOSurfacePlaneBase", (uint32_t) needed));
+			p->extendedPixels[0] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnLeft", 0);
+			p->extendedPixels[1] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnRight", 0);
+			p->extendedPixels[2] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnTop", 0);
+			p->extendedPixels[3] = dictNumber(pd, "IOSurfacePlaneExtendedPixelsOnBottom", 0);
+			if ((uint64_t) p->offset + p->size > needed) {
+				needed = (uint64_t) p->offset + p->size;
+			}
+		}
+	} else if (biplanarLayout(format, &hsub, &vsub, &wide) && width != 0 && height != 0) {
+		struct minisurf_plane * y = &s->planes[0], * c = &s->planes[1];
+
+		planeCount = 2;
+		y->width = width;
+		y->height = height;
+		y->bytesPerElement = wide ? 2 : 1;
+		y->elementWidth = y->elementHeight = 1;
+		y->bytesPerRow = alignUp((uint64_t) width * y->bytesPerElement, MINISURF_ROW_ALIGN);
+		y->size = y->bytesPerRow * height;
+		y->offset = 0;
+		c->width = (width + hsub - 1) / hsub;
+		c->height = (height + vsub - 1) / vsub;
+		c->bytesPerElement = wide ? 4 : 2;
+		c->elementWidth = c->elementHeight = 1;
+		c->bytesPerRow = alignUp((uint64_t) c->width * c->bytesPerElement, MINISURF_ROW_ALIGN);
+		c->size = c->bytesPerRow * c->height;
+		c->offset = y->size;
+		needed = (uint64_t) c->offset + c->size;
+	}
+
+	if (bpe == 0) {
+		bpe = planeCount ? s->planes[0].bytesPerElement : defaultBytesPerElement(format);
+	}
+	bpr = dictNumber(props, "IOSurfaceBytesPerRow", 0);
+	if (lossless && bpr < (uint64_t) width * 4) {
+		bpr = 0;
+	}
+	if (bpr == 0) {
+		bpr = planeCount ? s->planes[0].bytesPerRow
+		    : alignUp((uint64_t) ((width + ew - 1) / ew) * bpe, MINISURF_ROW_ALIGN);
+	}
+	if (planeCount == 0) {
+		needed = (uint64_t) bpr * ((height + eh - 1) / eh);
+		/* the one implicit plane, for the per-plane getters */
+		s->planes[0].width = width;
+		s->planes[0].height = height;
+		s->planes[0].bytesPerRow = bpr;
+		s->planes[0].bytesPerElement = (uint16_t) bpe;
+		s->planes[0].elementWidth = (uint8_t) ew;
+		s->planes[0].elementHeight = (uint8_t) eh;
+		s->planes[0].size = (uint32_t) needed;
+		describeComponents(&s->planes[0], format);
+	}
+	needed += offset;
+	alloc = dictNumber(props, "IOSurfaceAllocSize", 0);
+	if (alloc < needed) {
+		if (alloc != 0) {
+			IOLog("MiniIOSurface: alloc size %u too small for %ux%u '%.4s', using %llu\n", alloc, width, height,
+			    (const char *) &format, needed);
+		}
+		if (needed > MINISURF_MAX_ALLOC) {
+			s->release();
+			return NULL;
+		}
+		alloc = (uint32_t) needed;
+	}
+	if (alloc == 0 || alloc > MINISURF_MAX_ALLOC) {
+		s->release();
+		return NULL;
+	}
+	if (wrapped == NULL) {
+		alloc = alignUp(alloc, (uint32_t) PAGE_SIZE);
+	} else {
+		/* (the memory is as big as its owner says, and not a byte of ours is added to it) */
+		alloc = dictNumber(props, "IOSurfaceAllocSize", (uint32_t) needed);
+	}
+
+	s->memory = surfaceMemory((vm_size_t) PAGE_SIZE + (wrapped ? 0 : alloc));
+	if (s->memory == NULL) {
+		IOLog("MiniIOSurface: no memory for %u bytes (%u surfaces, %llu MB in use)\n", alloc, gSurfaceCount,
+		    gSurfaceBytes >> 20);
+		s->release();
+		*error = kIOReturnNoMemory;
+		return NULL;
+	}
+	s->kbase = (uint8_t *) s->memory->getBytesNoCopy();
+	s->values = OSDictionary::withCapacity(4);
+	s->kpixels = s->kbase + PAGE_SIZE;
+	if (wrapped != NULL) {
+		s->clientTask = current_task();
+		s->clientAddress = wrapped->unsigned64BitValue();
+		IOReturn held = kIOReturnNoMemory;
+
+		/* (held for writing if it can be written, which a picture that is only shown need not be) */
+		for (unsigned attempt = 0; attempt < 2 && held != kIOReturnSuccess; attempt++) {
+			OSSafeReleaseNULL(s->client);
+			s->client = IOMemoryDescriptor::withAddressRange(s->clientAddress, alloc,
+			    attempt == 0 ? kIODirectionInOut : kIODirectionOut, s->clientTask);
+			held = s->client != NULL ? s->client->prepare() : kIOReturnNoMemory;
+		}
+		if (held == kIOReturnSuccess) {
+			s->clientMap = s->client->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapReadOnly);
+		} else {
+			OSSafeReleaseNULL(s->client);
+		}
+		if (s->clientMap == NULL) {
+			if (gSurfaceUnheld++ < 8) {
+				IOLog("MiniIOSurface: the memory to make a surface around (%u bytes at %#llx) cannot be %s (%#x)\n", alloc,
+				    s->clientAddress, held == kIOReturnSuccess ? "seen from here" : "held", held);
+			}
+			s->release();
+			*error = kIOReturnVMError;
+			return NULL;
+		}
+		s->kpixels = (uint8_t *) s->clientMap->getVirtualAddress();
+		/* the pixels as they are now (see `snapshot`): rows to spare after them, as freedreno lays an image out
+		 * with its height aligned to four rows, and the page after (RedwoodGPU.cpp clientSurfaceBuffer) */
+		s->snapshot = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMapWriteCombineCache,
+		    (vm_size_t) round_page_64((uint64_t) alloc + 4 * (uint64_t) bpr) + PAGE_SIZE, PAGE_SIZE);
+		if (s->snapshot != NULL) {
+			memcpy(s->snapshot->getBytesNoCopy(), s->kpixels, alloc);
+			s->snapshotSeed = s->shared()->seed;
+		}
+	}
+
+	info->allocSize = alloc;
+	info->width = width;
+	info->height = height;
+	info->bytesPerRow = bpr;
+	info->offset = offset;
+	info->pixelFormat = format;
+	info->planeCount = planeCount;
+	info->bytesPerElement = (uint16_t) bpe;
+	info->elementWidth = (uint8_t) ew;
+	info->elementHeight = (uint8_t) eh;
+	info->cacheMode = dictNumber(props, "IOSurfaceCacheMode", 0);
+	info->subsampling = (uint8_t) dictNumber(props, "IOSurfaceSubsampling", 0);
+	info->prohibitUseCount = (uint8_t) dictNumber(props, "IOSurfaceProhibitUseCount", 0);
+	info->sliceCount = dictNumber(props, "IOSurfaceSliceCount", 0);
+	info->protectionOptions = dictNumber(props, "IOSurfaceProtectionOptions", 0);
+
+	IOLockLock(gSurfaceLock);
+	uint32_t sid = 0;
+	for (uint32_t tries = 0; tries < MINISURF_TABLE_SIZE - 1; tries++) {
+		uint32_t candidate = gSurfaceNext;
+
+		gSurfaceNext = (gSurfaceNext + 1 < MINISURF_TABLE_SIZE) ? gSurfaceNext + 1 : 1;
+		if (gSurfaceTable[candidate] == NULL) {
+			sid = candidate;
+			break;
+		}
+	}
+	if (sid == 0) {
+		IOLockUnlock(gSurfaceLock);
+		IOLog("MiniIOSurface: the surface table is full\n");
+		s->release();
+		*error = kIOReturnNoResources;
+		return NULL;
+	}
+	s->sid = sid;
+	s->holders = 1;
+	info->sid = sid;
+	info->traceID = sid;
+	gSurfaceTable[sid] = s;                 /* the table owns the object until the last holder goes */
+	gSurfaceCount++;
+	gSurfaceBytes += alloc;
+
+	struct minisurf_shared * sh = s->shared();
+	sh->registryID = 0x100000000ULL + sid;
+	sh->seed = 1;
+	sh->valuesSeed = 1;
+	sh->pixelSizeCasting = (uint8_t) dictNumber(props, "IOSurfacePixelSizeCastingAllowed", 1);
+	sh->displayable = 1;
+	sh->sysMemOnly = (uint8_t) dictNumber(props, "IOSurfaceSysMemOnly", 0);
+	IOLockUnlock(gSurfaceLock);
+
+	*error = kIOReturnSuccess;
+	return s;
+}
+
+/* With the lock held. */
+static void
+surfaceHold(MiniIOSurface * s)
+{
+	s->holders++;
+}
+
+/* With the lock held. The caller must not touch the surface afterwards. */
+static void
+surfaceUnhold(MiniIOSurface * s)
+{
+	if (--s->holders != 0) {
+		return;
+	}
+	gSurfaceTable[s->sid] = NULL;
+	gSurfaceCount--;
+	gSurfaceBytes -= s->info.allocSize;
+	s->release();
+}
+
+MiniIOSurface *
+MiniIOSurfaceCopy(uint32_t sid)
+{
+	MiniIOSurface * s = NULL;
+
+	if (gSurfaceLock == NULL || sid == 0 || sid >= MINISURF_TABLE_SIZE) {
+		return NULL;
+	}
+	IOLockLock(gSurfaceLock);
+	s = gSurfaceTable[sid];
+	if (s != NULL) {
+		surfaceHold(s);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return s;
+}
+
+/* How many surfaces there are and how much (wired) memory they hold: for the kernel's memory report. */
+extern "C" void
+MiniIOSurfaceUsage(uint32_t * count, uint64_t * bytes)
+{
+	*count = gSurfaceCount;
+	*bytes = gSurfaceBytes;
+}
+
+void
+MiniIOSurfaceDrop(MiniIOSurface * s)
+{
+	if (s == NULL) {
+		return;
+	}
+	IOLockLock(gSurfaceLock);
+	surfaceUnhold(s);
+	IOLockUnlock(gSurfaceLock);
+}
+
+MiniIOSurface *
+MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	OSDictionary * props = OSDictionary::withCapacity(4);
+	MiniIOSurface * s = NULL;
+	IOReturn error;
+
+	if (props == NULL || gSurfaceLock == NULL) {
+		OSSafeReleaseNULL(props);
+		return NULL;
+	}
+	OSNumber * n;
+	n = OSNumber::withNumber(width, 32); props->setObject("IOSurfaceWidth", n); n->release();
+	n = OSNumber::withNumber(height, 32); props->setObject("IOSurfaceHeight", n); n->release();
+	n = OSNumber::withNumber(pixelFormat, 32); props->setObject("IOSurfacePixelFormat", n); n->release();
+	s = surfaceCreate(props, &error);
+	props->release();
+	return s;
+}
