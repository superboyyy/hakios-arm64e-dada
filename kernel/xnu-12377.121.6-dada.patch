+}
+
+void hakios_dada_wifi_settle(void);
+
+void
+hakios_dada_wifi_settle(void)
+{
+	static uint32_t settle = 0xffffffffu;
+
+	if (settle == 0xffffffffu) {
+		settle = 0;
+		(void)PE_parse_boot_argn("dadawifi_settle", &settle, sizeof(settle));
+		if (settle != 0) {
+			say("ath12k: a %u ms settle after each vdev create (dadawifi_settle)\n", settle);
+		}
+	}
+	if (settle != 0) {
+		ms(settle);
+	}
+}
+
+/* a cold power cycle just happened: the driver's next MHI reset of the chip is skipped (tools/mk-ath12k.sh 22) */
+static volatile int wifi_just_cycled;
+int hakios_dada_wifi_just_cycled(void);
+
+int
+hakios_dada_wifi_just_cycled(void)
+{
+	int was = wifi_just_cycled;
+	uint32_t want = 0;
+
+	/* opt-in (boot-arg dadawifi_skipreset=1): with it, run w95a1 stalled the whole phone right after the hang */
+	(void)PE_parse_boot_argn("dadawifi_skipreset", &want, sizeof(want));
+	if (!want) {
+		was = 0;
+	}
+	wifi_just_cycled = 0;
+	if (was) {
+		say("ath12k: MHI reset skipped: the chip was just power-cycled\n");
+	}
+	return was;
+}
+
+void hakios_dada_wifi_cycle(void);
+
+void
+hakios_dada_wifi_cycle(void)
+{
+	uint32_t ctl = 0;
+
+	wifi_just_cycled = 1;
+
+	/*
+	 * A live chip (the calibration firmware just told OFF) may still have its own transactions under way -- MSI writes, DMA:
+	 * cut by WLAN_EN they killed the whole SoC about half the time (w163a, w168a, w170a, w173a), where a hung chip's never
+	 * did. Bus mastering off first, then a moment, then the cut.
+	 */
+	{
+		uint32_t command = 0;
+
+		if (ep_conf != 0 && cfg_read(0x04, 2, &command) == 0) {
+			(void)cfg_write(0x04, 2, command & ~4u);
+			ms(10);
+			say("ath12k: the chip's bus mastering off before the cut (command %#x -> %#x)\n", command, command & ~4u);
+		}
+	}
+	say("ath12k: the chip is power-cycled (WLAN_EN) and its link trained again\n");
+	link_up();
+	if (ep_mhi == 0 || ep_conf == 0) {
+		say("ath12k: the link did not come back after the power cycle\n");
+		return;
+	}
+	if (cfg_read(0x80000008, 2, &ctl) == 0) {
+		(void)cfg_write(0x80000008, 2, ctl & ~0x7000u);
+	}
+	say("ath12k: the chip is back: MHI status %#x, device control %#x\n", rd(ep_mhi + 0x48), ctl & ~0x7000u);
+	say("ath12k: the cycle returns\n");
+}
+
+/* a mark from the driver's own code (tools/ath12k-cbc.py), said through this file's log rather than the shim's */
+void hakios_dada_wifi_note(const char *what);
+
+void
+hakios_dada_wifi_note(const char *what)
+{
+	say("note: %s\n", what);
+}
+
+static void
+driver(void)
+{
+	static const struct lx_platform plat = {
+		now_ms, plat_sleep, plat_poll, plat_log, plat_halt, plat_alloc, plat_free,
+		plat_dma_alloc, plat_dma_free, plat_dma_map, plat_dma_sync, plat_fw_get,
+	};
+	static struct nw_board board;           /* the driver keeps a pointer to it: it outlives this call */
+	uint64_t low = 0, mb = 0, sink;
+	uint32_t cap, guard, stage_was = 0, scans_was = 0;
+	int r;
+
+	if (nw_wifi_start == NULL) {
+		say("ath12k: the driver's object is not in this kernel (tools/mk-ath12k.sh)\n");
+		return;
+	}
+	if (ep_mhi == 0 || ep_conf == 0) {
+		say("ath12k: the link is not up\n");
+		return;
+	}
+	if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || !PE_parse_boot_argn("lowdma_mb", &mb, sizeof(mb)) || mb < 48 ||
+	    low == 0 || low + (mb << 20) > 0x100000000ULL) {
+		say("ath12k: no 48 MB below 4 GB from the loader (lowdma=, lowdma_mb=): a loader from before 28 October\n");
+		return;
+	}
+	/* from 4 MB on, rounded up to the kernel's 16 KB page: lowdma= is only 4 KB aligned (0x...c3000), and io_map
+	 * maps whole pages, so an unaligned start would share its first page with the sound's memory below and take
+	 * that page outside the Normal non-cacheable range set below */
+	hp.base_pa = (low + (4u << 20) + 0x3fffULL) & ~0x3fffULL;
+	hp.size = ((low + (mb << 20)) - hp.base_pa) & ~0x3fffULL;
+	/* Normal non-cacheable, not Device: the driver bzero()s and memcpy()s this memory, and the loader's
+	 * lowdma= is outside the kernel's RAM window, where VM_WIMG_WCOMB would otherwise be Device-GRE
+	 * (osfmk/arm/pmap/pmap.c wimg_to_pte): bzero's DC ZVA there was "Unaligned kernel data abort" */
+	hakios_normal_nc_lo = hp.base_pa;
+	hakios_normal_nc_hi = hp.base_pa + hp.size;
+	hp.base_va = ml_io_map_wcomb((vm_offset_t)hp.base_pa, (vm_size_t)hp.size);
+	hp.big = kalloc_data((vm_size_t)(hp.size >> 12), Z_WAITOK | Z_ZERO);
+	if (hp.base_va == 0) {
+		return;
+	}
+	/* the root port's own stream as well (iommu-map's first entry): what the controller tags DMA with when its
+	 * BDF-to-SID table is bypassed, so a missed mapping is a stream passed through and not a fault */
+	if (!smmu_pass(0x1400)) {
+		say("ath12k: stream 0x1400 could not be passed through\n");
+	}
+	if (!smmu_pass(WIFI_STREAM)) {
+		say("ath12k: the endpoint's SMMU stream could not be passed through\n");
+		return;
+	}
+	/* the configuration-space capability list: the MSI capability (0x05) and the PCI Express capability (0x10) */
+	cap = rd(ep_conf + 0x34) & 0xff;
+	for (guard = 0; cap >= 0x40 && cap + 4 <= 0x1000 && guard < 48; guard++) {
+		uint32_t w = rd(ep_conf + cap);
+
+		if ((w & 0xff) == 0x05) {
+			board.msi_cap = (uint16_t)cap;
+		} else if ((w & 0xff) == 0x10) {
+			cfg_pcie = (uint16_t)cap;
+		}
+		cap = (w >> 8) & 0xff;
+	}
+	sink = 0;
+	if (hp_alloc(4096, &sink) == NULL) {
+		return;
+	}
+	msi_sink_pa = sink;
+	/* the chip's revision from its SoC hardware version (cnss cnss_get_soc_info_pre_mhi: BAR + 0x224, major in bits
+	 * 8..11), so the ..20 firmware is taken for a revision-2 chip without being told which (dadawifi_fw overrides) */
+	{
+		uint32_t soc = rd(ep_mhi + 0x224), major = (soc >> 8) & 0xf;
+
+		fw_rev = major >= 2 ? 2 : 1;
+		say("ath12k: SoC hardware version %#x: revision %u, firmware %s\n", soc, major, fw_rev == 2 ? "..20" : "default");
+	}
+	board.bar = (void *)ep_mhi;
+	board.bar_len = (size_t)ep_bar_size;
+	board.device_id = 0x110e;
+	board.irq_base = 1;
+	board.cfg_read = cfg_read;
+	board.cfg_write = cfg_write;
+	board.msi_target = msi_target;
+	board.map_phys = map_phys;
+	say("ath12k: starting the driver: BAR %u KiB, MSI capability %#x, PCIe capability %#x, DMA %llu MB at %#llx, sink %#llx\n",
+	    (uint32_t)(ep_bar_size >> 10), board.msi_cap, cfg_pcie, hp.size >> 20, hp.base_pa, sink);
+	{
+		extern void hakios_dada_wlan_events(void);
+
+		hakios_dada_wlan_events();     /* scan, join, link and frames to en0 and iOS (hakios_dada_wlan.c) */
+	}
+	r = nw_wifi_start(&plat, &board);
+	say("ath12k: the driver's start returns %d (stage %u, last error %d)\n", r, nw_wifi_stats.stage, nw_wifi_stats.last_err);
+	if (r != 0) {
+		return;
+	}
+	/* the driver runs on this thread: it is pumped, and where it stands is said as it moves and every few seconds */
+	for (uint32_t i = 0, quiet = 0; ; i++) {
+		extern void hakios_dada_wlan_poll(void);
+		int moved = nw_wifi_step();
+
+		hakios_dada_wlan_poll();       /* the station attached once the driver's interface is up */
+
+		if (rddm_at != 0 && !rddm_scanned && now_ms() - rddm_at > 3000) {
+			rddm_scanned = true;
+			rddm_scan();
+		}
+
+		if (!moved) {
+			/* boot-arg dadawifi_pollus=N: the idle pause in microseconds (default 2 ms): how late the chip's
+			 * interrupts are looked at -- a test of whether its death at the first radio work is a latency one */
+			static uint32_t poll_us = 0xffffffffu;
+
+			if (poll_us == 0xffffffffu) {
+				poll_us = 2000;
+				(void)PE_parse_boot_argn("dadawifi_pollus", &poll_us, sizeof(poll_us));
+				say("ath12k: the driver's idle pause: %u us (dadawifi_pollus)\n", poll_us);
+			}
+			if (poll_us >= 1000) {
+				ms(poll_us / 1000);
+			} else {
+				us(poll_us);
+			}
+			quiet += poll_us >= 2000 ? 1 : (i % (2000 / (poll_us ? poll_us : 1)) == 0);
+		} else {
+			quiet = 0;
+		}
+		if (nw_wifi_stats.stage != stage_was || nw_wifi_stats.scans != scans_was || (quiet % 1500) == 1499) {
+			say("ath12k: stage %u, scans %u, networks seen %u, error %d; where %llu/%#llx depth %llu\n",
+			    nw_wifi_stats.stage, nw_wifi_stats.scans, nw_wifi_stats.bss_seen, nw_wifi_stats.last_err,
+			    nw_wifi_where[0], nw_wifi_where[1], nw_wifi_where[2]);
+			stage_was = nw_wifi_stats.stage;
+			scans_was = nw_wifi_stats.scans;
+		}
+		if (nw_wifi_stats.scans > 0 && (i % 20000) == 19999) {
+			say("ath12k: still up (DMA %u KiB of %llu MB used, %u live, %u out-of-memory)\n",
+			    (uint32_t)(hp.peak >> 10), hp.size >> 20, hp.live, hp.fails);
+		}
+	}
+}
+
+void hakios_dada_wifi_init(void);
+
+static void
+wifi_thread(void *arg, wait_result_t w __unused)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)arg;
+
+	/* (after the audio DSP: RPMh's command database and sequencer are set up by then) */
+	ms(20000);
+	{
+		/* the modem first, when it is brought up (dadampss=1): with the Wi-Fi's start beside it, it never came up (w131, w133a) */
+		extern volatile int hakios_mpss_state;
+		uint32_t mpss = 0;
+
+		if (PE_parse_boot_argn("dadampss", &mpss, sizeof(mpss)) && mpss != 0) {
+			for (unsigned waited = 0; hakios_mpss_state == 0 && waited < 150; waited++) {
+				ms(1000);
+			}
+			say("the modem is %s: the Wi-Fi goes on\n", hakios_mpss_state > 0 ? "up" : "NOT up");
+		}
+	}
+	look("as the boot left it");
+	/*
+	 * The chip from cold (boot-arg dadawifi_coldms=MS; default 0: not): Android reboots into the loader with Wi-Fi and
+	 * Bluetooth up, and a warm reset leaves the TLMM and PMIC pins as they were. (2 s of both enables low did not
+	 * change the firmware's death at its first radio work: run wifi40, 28 October.)
+	 */
+	{
+		uint32_t cold = 0;
+		int apid = spmi_apid(0x58a);
+
+		(void)PE_parse_boot_argn("dadawifi_coldms", &cold, sizeof(cold));
+		if (cold != 0 && stage >= 2) {
+			pin(PIN_WLAN_EN, 1u | 7u << 6 | 1u << 9, 0);
+			if (apid >= 0) {
+				(void)spmi_write8(apid, 0x40, 1);               /* BT_EN: digital output */
+				(void)spmi_write8(apid, 0x44, 0x00);            /* source: constant low */
+				(void)spmi_write8(apid, 0x46, 0x80);
+			}
+			say("the chip held off (WLAN_EN and BT_EN low) for %u ms\n", cold);
+			ms(cold);
+		}
+	}
+	{
+		uint32_t bt = 0;
+
+		if (PE_parse_boot_argn("dadabt", &bt, sizeof(bt)) && bt != 0) {
+			rails();
+			sleep_clock();
+			bt_probe();
+			if (bt >= 2) {
+				bt_hci(bt);
+			}
+		}
+	}
+	if (stage >= 2) {
+		link_up();
+	}
+	if (stage == 3) {
+		firmware();
+	} else if (stage >= 4) {
+		driver();
+	}
+}
+
+void
+hakios_dada_wifi_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("dadawifi", &stage, sizeof(stage)) || stage == 0) {
+		return;
+	}
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	tlmm = ml_io_map(TLMM_PHYS, 0x200000);
+	{
+		uint32_t bt = 0;
+
+		/* /dev/uart.bluetooth exists from the start, before the chip is up: iOS's bluetoothd looks for it at once
+		 * and gives up for the boot if it is not there yet (opens wait for the chip) */
+		if (PE_parse_boot_argn("dadabt", &bt, sizeof(bt)) && bt >= 4) {
+			hakios_dada_bt_make_node();
+		}
+	}
+	if (stage >= 4) {
+		extern void hakios_dada_wlan_early(void);
+
+		hakios_dada_wlan_early();      /* en0 now: iOS's Wi-Fi side looks for it once, at its start (hakios_dada_wlan.c) */
+	}
+	if (kernel_thread_start(wifi_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_dada_wlan.c b/bsd/dev/hakios_dada_wlan.c
new file mode 100644
index 0000000..b65c2de
--- /dev/null
+++ b/bsd/dev/hakios_dada_wlan.c
@@ -0,0 +1,421 @@
+/*
+ * dada's Wi-Fi for iOS: en0 and the station boundary on top of the ath12k driver (dadawifi=4, hakios_dada_wifi.c).
+ *
+ * The parts iOS talks to are redwood's: en0 is made by bsd/dev/redwood_net.c, wifid finds it through the registry
+ * entries of iokit/Kernel/RedwoodWLAN.cpp, its Apple80211 requests are answered in bsd/dev/redwood_apple80211.c
+ * from the station boundary (sys/redwood_sta.h), whose thread is bsd/dev/redwood_sta.c. What is here is the link
+ * behind en0 and the station's operations, done with the driver object's station interface (Ath12kWifi's
+ * include/nw_abi.h: nw_wifi_scan, nw_wifi_connect, nw_wifi_tx, ...), whose calls only queue a request; the work, and
+ * the events that tell its end, happen on the driver's thread (driver() in hakios_dada_wifi.c, nw_wifi_step()).
+ *
+ *   early      hakios_dada_wlan_early(), at kernel start: en0 is made now, link down, because iOS's Wi-Fi side
+ *              looks for the interface and its registry entry once, when it starts, long before the chip's firmware
+ *              is up (two minutes into the boot, after Bluetooth and the cold-boot calibration).
+ *   address    the interface's and the radio's: boot-arg wifi_mac, else the phone's own (wlan_mac.bin in the small
+ *              image's fw/, Android's /mnt/vendor/persist/wlan/wlan_mac.bin), else a made-up local one. The driver
+ *              is given the same (plat_fw_get answers wlan_mac.bin with it; mk-ath12k.sh 13 makes the driver use it).
+ *   events     hakios_dada_wlan_events(), before the driver starts: scan done, join done, link lost, frames in.
+ *              They come on the driver's thread and must not sleep: they set a flag (the station polls it), pass a frame.
+ *   station    hakios_dada_wlan_poll(), from the driver's loop: once its interface is up (stage 4) the station
+ *              operations are attached, which tells iOS that the radio is on.
+ */
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/systm.h>
+
+#define say(...) redwood_tl("dwlan: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern const uint8_t *redwood_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+extern bool redwood_wifi_radio_address(uint8_t *address);
+
+/* the driver object's station interface (Ath12kWifi include/nw_abi.h; by hand, plain C) -- weak, as in hakios_dada_wifi.c */
+struct nw_bss_info {
+	uint8_t bssid[6]; uint8_t ssid_len; uint8_t ssid[32];
+	uint32_t freq_mhz; int8_t signal_dbm; uint16_t caps, beacon_int; uint32_t age_ms;
+	uint16_t ie_len; uint8_t ie[384];
+};
+enum { NW_STA_OFF, NW_STA_IDLE, NW_STA_SCANNING, NW_STA_AUTH, NW_STA_ASSOC, NW_STA_KEYS, NW_STA_UP };
+enum { NW_RES_OK = 0, NW_RES_NOT_FOUND = 1, NW_RES_TIMEOUT = 2, NW_RES_REJECTED = 3, NW_RES_BAD_KEY = 4, NW_RES_UNSUPPORTED = 5,
+       NW_RES_FAILED = 6 };
+struct nw_wifi_status {
+	uint32_t state; int32_t result; uint8_t bssid[6]; uint8_t ssid_len; uint8_t ssid[32]; uint32_t freq_mhz; int8_t signal_dbm;
+	uint8_t mac[6]; uint32_t channels;
+};
+struct nw_wifi_events {
+	void (*scan_done)(void);
+	void (*connect_done)(int result);
+	void (*link_lost)(int reason);
+	void (*rx)(const uint8_t *eth, size_t len);
+};
+struct nw_wifi_stats { uint32_t stage, scans, frames, beacons, bss_seen; int last_err; };
+extern struct nw_wifi_stats nw_wifi_stats __attribute__((weak));
+extern void nw_wifi_set_events(const struct nw_wifi_events *ev) __attribute__((weak));
+extern int nw_wifi_scan(const uint8_t *ssid, size_t len) __attribute__((weak));
+extern int nw_wifi_bss_count(void) __attribute__((weak));
+extern int nw_wifi_bss_get(int i, struct nw_bss_info *out) __attribute__((weak));
+extern int nw_wifi_connect(const uint8_t *ssid, size_t len, const uint8_t *bssid, const char *pass, size_t plen) __attribute__((weak));
+extern void nw_wifi_disconnect(void) __attribute__((weak));
+extern int nw_wifi_tx(const uint8_t *eth, size_t len) __attribute__((weak));
+extern void nw_wifi_status_get(struct nw_wifi_status *st) __attribute__((weak));
+
+static uint8_t wlan_address[6];
+static bool wlan_have_address, wlan_early_done, wlan_station_up;
+
+static void
+ms(uint32_t n)
+{
+	delay_for_interval(n, NSEC_PER_MSEC);
+}
+
+/* ---- the address ---- */
+
+static int
+hexval(uint8_t c)
+{
+	return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+/* Android's wlan_mac.bin: lines "Intf0MacAddress=001122334455"; the first interface's */
+static bool
+address_from_file(uint8_t *a)
+{
+	uint64_t size = 0;
+	const uint8_t *d = redwood_image_file("fw", "wlan_mac.bin", &size, NULL);
+	uint64_t at = 0;
+	unsigned k = 0;
+
+	if (d == NULL || size == 0) {
+		return false;
+	}
+	while (at < size && d[at] != '=') {
+		at++;
+	}
+	for (at++; at < size && k < 12; at++) {
+		int v = hexval(d[at]);
+
+		if (v < 0) {
+			break;
+		}
+		a[k / 2] = (uint8_t)((k & 1) ? (a[k / 2] << 4 | v) : v);
+		k++;
+	}
+	return k == 12 && !(a[0] & 1) && (a[0] | a[1] | a[2] | a[3] | a[4] | a[5]) != 0;
+}
+
+/* en0's and the radio's address, the same: decided once */
+bool
+hakios_dada_wlan_address(uint8_t *address)
+{
+	if (!wlan_have_address) {
+		if (redwood_wifi_radio_address(wlan_address)) {
+			say("the radio's address: given (wifi_mac)\n");
+		} else if (address_from_file(wlan_address)) {
+			say("the radio's address: the phone's own (wlan_mac.bin)\n");
+		} else {
+			static const uint8_t made[6] = { 0x02, 0xda, 0xda, 0x00, 0x00, 0x01 };
+
+			memcpy(wlan_address, made, 6);
+			say("the radio's address: none known, a local one is made (wifi_mac= gives one)\n");
+		}
+		wlan_have_address = true;
+	}
+	memcpy(address, wlan_address, 6);
+	return true;
+}
+
+/* ---- the link behind en0 ---- */
+
+static uint8_t tx_frame[REDWOOD_NET_FRAME_MAX];
+static uint64_t tx_frames, tx_dropped, rx_frames;
+
+static bool
+link_transmit(mbuf_t packet, size_t length)
+{
+	if (length > sizeof(tx_frame) || nw_wifi_tx == NULL || mbuf_copydata(packet, 0, length, tx_frame) != 0) {
+		tx_dropped++;
+		return false;
+	}
+	if (nw_wifi_tx(tx_frame, length) != 0) {
+		tx_dropped++;
+		return false;
+	}
+	tx_frames++;
+	return true;
+}
+
+static struct redwood_net_link wlan_link = {
+	.name = "the phone's radio (ath12k, peach)",
+	.wireless = true,
+	.up = false,
+	.transmit = link_transmit,
+};
+
+/* at kernel start (hakios_dada_wifi_init with dadawifi=4): en0 is there before iOS's Wi-Fi side looks */
+void
+hakios_dada_wlan_early(void)
+{
+	if (wlan_early_done || nw_wifi_tx == NULL) {
+		return;
+	}
+	wlan_early_done = true;
+	(void)hakios_dada_wlan_address(wlan_link.address);
+	say("en0 %s\n", redwood_net_attach(&wlan_link) ? "made, the radio behind it (link down until a network is joined)" :
+	    "NOT MADE: there is another link behind en0");
+}
+
+/* ---- the driver's events (on its thread: no sleeping) ---- */
+
+static volatile int ev_scan_done, ev_join_done, ev_join_result;
+
+static void
+ev_scan(void)
+{
+	ev_scan_done = 1;
+}
+
+static void
+ev_join(int result)
+{
+	ev_join_result = result;
+	ev_join_done = 1;
+	if (result == NW_RES_OK) {
+		redwood_net_link_state(true);
+	}
+}
+
+static void
+ev_lost(int reason)
+{
+	say("the network is lost (%d)\n", reason);
+	redwood_net_link_state(false);
+	redwood_sta_lost(ECONNRESET);
+}
+
+static void
+ev_rx(const uint8_t *eth, size_t len)
+{
+	rx_frames++;
+	redwood_net_input(eth, len);
+}
+
+static const struct nw_wifi_events wlan_events = { ev_scan, ev_join, ev_lost, ev_rx };
+
+void
+hakios_dada_wlan_events(void)
+{
+	if (nw_wifi_set_events != NULL) {
+		nw_wifi_set_events(&wlan_events);
+	}
+}
+
+/* ---- the station's operations (on redwood_sta.c's thread: they may wait) ---- */
+
+/* wait for a flag an event sets, at most ms milliseconds: true when it was set */
+static bool
+wait_flag(volatile int *flag, uint32_t most)
+{
+	for (uint32_t waited = 0; !*flag && waited < most; waited += 20) {
+		ms(20);
+	}
+	return *flag != 0;
+}
+
+static int
+sta_power(bool on)
+{
+	if (!on && nw_wifi_disconnect != NULL) {
+		nw_wifi_disconnect();
+		redwood_net_link_state(false);
+	}
+	return 0;
+}
+
+static int
+sta_scan(const struct redwood_sta_scan *what)
+{
+	ev_scan_done = 0;
+	(void)nw_wifi_scan(what != NULL && what->ssid_length ? what->ssid : NULL, what != NULL ? what->ssid_length : 0);
+	/* a scan that runs already (the driver's own first one) ends as this one would */
+	if (!wait_flag(&ev_scan_done, 15000)) {
+		say("a scan did not end in 15 s: what was heard so far is answered\n");
+	}
+	return 0;
+}
+
+static struct redwood_sta_bss heard_one;
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct nw_bss_info b;
+	int n = nw_wifi_bss_count != NULL ? nw_wifi_bss_count() : 0;
+
+	for (int i = 0; i < n; i++) {
+		if (nw_wifi_bss_get(i, &b) != 0) {
+			continue;
+		}
+		bzero(&heard_one, sizeof(heard_one));
+		memcpy(heard_one.bssid, b.bssid, 6);
+		heard_one.ssid_length = b.ssid_len > 32 ? 32 : b.ssid_len;
+		memcpy(heard_one.ssid, b.ssid, heard_one.ssid_length);
+		heard_one.frequency = (uint16_t)b.freq_mhz;
+		heard_one.rssi = b.signal_dbm;
+		heard_one.beacon_interval = b.beacon_int;
+		heard_one.capability = b.caps;
+		heard_one.age_ms = b.age_ms;
+		heard_one.elements_length = b.ie_len > sizeof(b.ie) ? sizeof(b.ie) : b.ie_len;
+		memcpy(heard_one.elements, b.ie, heard_one.elements_length);
+		each(&heard_one, context);
+	}
+}
+
+static int
+sta_join(const struct redwood_sta_join *what)
+{
+	static const uint8_t none[6];
+	char pass[65];
+	size_t plen = 0;
+	const uint8_t *bssid = memcmp(what->bssid, none, 6) != 0 ? what->bssid : NULL;
+
+	if (what->security == REDWOOD_STA_WPA2_PSK) {
+		if (what->passphrase_length != 0) {
+			plen = what->passphrase_length > 63 ? 63 : what->passphrase_length;
+			memcpy(pass, what->passphrase, plen);
+		} else {
+			/* the key itself: 64 hexadecimal digits are taken as the PMK (nw_sta.c) */
+			for (int i = 0; i < 32; i++) {
+				snprintf(pass + 2 * i, 3, "%02x", what->pmk[i]);
+			}
+			plen = 64;
+		}
+		pass[plen] = 0;
+	}
+	ev_join_done = 0;
+	if (nw_wifi_connect(what->ssid, what->ssid_length, bssid, plen ? pass : NULL, plen) != 0) {
+		return EIO;
+	}
+	bzero(pass, sizeof(pass));
+	if (!wait_flag(&ev_join_done, 30000)) {
+		return ETIMEDOUT;
+	}
+	switch (ev_join_result) {
+	case NW_RES_OK:
+		return 0;
+	case NW_RES_NOT_FOUND:
+		return ENOENT;
+	case NW_RES_TIMEOUT:
+		return ETIMEDOUT;
+	case NW_RES_BAD_KEY:
+		return EAUTH;
+	case NW_RES_REJECTED:
+		return ECONNREFUSED;
+	case NW_RES_UNSUPPORTED:
+		return ENOTSUP;
+	default:
+		return EIO;
+	}
+}
+
+static int
+sta_leave(void)
+{
+	if (nw_wifi_disconnect != NULL) {
+		nw_wifi_disconnect();
+	}
+	redwood_net_link_state(false);
+	return 0;
+}
+
+static void
+sta_state(struct redwood_sta_state *st)
+{
+	struct nw_wifi_status s;
+
+	bzero(st, sizeof(*st));
+	if (nw_wifi_status_get == NULL) {
+		return;
+	}
+	nw_wifi_status_get(&s);
+	switch (s.state) {
+	case NW_STA_OFF:
+		st->phase = REDWOOD_STA_OFF;
+		break;
+	case NW_STA_IDLE:
+		st->phase = REDWOOD_STA_IDLE;
+		break;
+	case NW_STA_SCANNING:
+		st->phase = REDWOOD_STA_SCANNING;
+		break;
+	case NW_STA_UP:
+		st->phase = REDWOOD_STA_JOINED;
+		break;
+	default:
+		st->phase = REDWOOD_STA_JOINING;
+		break;
+	}
+	memcpy(st->bss.bssid, s.bssid, 6);
+	st->bss.ssid_length = s.ssid_len > 32 ? 32 : s.ssid_len;
+	memcpy(st->bss.ssid, s.ssid, st->bss.ssid_length);
+	st->bss.frequency = (uint16_t)s.freq_mhz;
+	st->bss.rssi = s.signal_dbm;
+}
+
+/* what the radio may tune to: 2.4 GHz 1-13, 5 GHz (52-64 and 100-144 passive, radar); 6 GHz is left out as the station
+ * code leaves it out of its scans */
+static unsigned
+sta_channels(struct redwood_sta_channel *c, unsigned most)
+{
+	static const uint16_t five[] = { 5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320, 5500, 5520, 5540, 5560, 5580, 5600,
+		                         5620, 5640, 5660, 5680, 5700, 5720, 5745, 5765, 5785, 5805, 5825 };
+	unsigned n = 0;
+
+	for (unsigned ch = 1; ch <= 13 && n < most; ch++) {
+		c[n].frequency = (uint16_t)(2407 + 5 * ch);
+		c[n++].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(five) / sizeof(five[0]) && n < most; i++) {
+		bool radar = five[i] >= 5260 && five[i] <= 5720;
+
+		c[n].frequency = five[i];
+		c[n++].flags = radar ? REDWOOD_STA_CHANNEL_PASSIVE | REDWOOD_STA_CHANNEL_RADAR : 0;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops wlan_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+/* from the driver's loop: the station is attached once the driver's interface is up */
+void
+hakios_dada_wlan_poll(void)
+{
+	static uint64_t said_at;
+	uint64_t now = mach_absolute_time(), ns;
+
+	if (!wlan_station_up && &nw_wifi_stats != NULL && nw_wifi_stats.stage >= 4) {
+		wlan_station_up = true;
+		(void)hakios_dada_wlan_address(wlan_ops.address);
+		redwood_sta_attach(&wlan_ops);
+		say("the station is attached: iOS is told the radio is on\n");
+	}
+	absolutetime_to_nanoseconds(now - said_at, &ns);
+	if (wlan_station_up && ns > 30ull * NSEC_PER_SEC) {
+		said_at = now;
+		say("frames: %llu sent, %llu dropped, %llu received\n", tx_frames, tx_dropped, rx_frames);
+	}
+}
