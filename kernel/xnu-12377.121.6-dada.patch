+bool
+IOSurfaceRootUserClient::start(IOService * provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fTraps[kSurfaceTrapIncrementUseCount].func = (IOTrap) & IOSurfaceRootUserClient::trapIncrementUseCount;
+	fTraps[kSurfaceTrapDecrementUseCount].func = (IOTrap) & IOSurfaceRootUserClient::trapDecrementUseCount;
+	fTraps[kSurfaceTrapLock].func = (IOTrap) & IOSurfaceRootUserClient::trapLock;
+	fTraps[kSurfaceTrapUnlock].func = (IOTrap) & IOSurfaceRootUserClient::trapUnlock;
+	fTraps[kSurfaceTrapDetach].func = (IOTrap) & IOSurfaceRootUserClient::trapDetach;
+	fTraps[kSurfaceTrapRelease].func = (IOTrap) & IOSurfaceRootUserClient::trapRelease;
+	fTraps[kSurfaceTrapEventWait].func = (IOTrap) & IOSurfaceRootUserClient::trapEventWait;
+	fTraps[kSurfaceTrapEventSignal].func = (IOTrap) & IOSurfaceRootUserClient::trapEventSignal;
+	for (unsigned i = 0; i < kSurfaceTrapCount; i++) {
+		fTraps[i].object = this;
+	}
+	return true;
+}
+
+IOReturn
+IOSurfaceRootUserClient::clientClose(void)
+{
+	forgetEventWaits();
+	IOLockLock(gSurfaceLock);
+	while (fRefCount != 0) {
+		dropRef(&fRefs[fRefCount - 1]);
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOSurfaceRootUserClient::free(void)
+{
+	if (fRefs != NULL) {
+		if (gSurfaceLock != NULL) {
+			IOLockLock(gSurfaceLock);
+			while (fRefCount != 0) {
+				dropRef(&fRefs[fRefCount - 1]);
+			}
+			IOLockUnlock(gSurfaceLock);
+		}
+		IODelete(fRefs, struct minisurf_client_ref, fRefCapacity);
+		fRefs = NULL;
+	}
+	forgetEventWaits();
+	OSSafeReleaseNULL(fEventMaps);
+	IOUserClient::free();
+}
+
+/* All three with the lock held. */
+struct minisurf_client_ref *
+IOSurfaceRootUserClient::findRef(uint32_t sid, bool detached)
+{
+	for (uint32_t i = 0; i < fRefCount; i++) {
+		if (fRefs[i].surface->sid == sid && fRefs[i].detached == detached) {
+			return &fRefs[i];
+		}
+	}
+	return NULL;
+}
+
+struct minisurf_client_ref *
+IOSurfaceRootUserClient::addRef(MiniIOSurface * surface)
+{
+	struct minisurf_client_ref * ref;
+	IOMemoryMap * map;
+
+	if (fRefCount == fRefCapacity) {
+		uint32_t capacity = fRefCapacity ? fRefCapacity * 2 : 16;
+		struct minisurf_client_ref * refs = IONew(struct minisurf_client_ref, capacity);
+
+		if (refs == NULL) {
+			return NULL;
+		}
+		if (fRefs != NULL) {
+			memcpy(refs, fRefs, fRefCount * sizeof(*refs));
+			IODelete(fRefs, struct minisurf_client_ref, fRefCapacity);
+		}
+		fRefs = refs;
+		fRefCapacity = capacity;
+	}
+	map = surface->memory->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		IOLog("MiniIOSurface: cannot map surface %u (%u bytes) into the client\n", surface->sid, surface->info.allocSize);
+		return NULL;
+	}
+	ref = &fRefs[fRefCount++];
+	bzero(ref, sizeof(*ref));
+	ref->surface = surface;
+	ref->map = map;
+	if (surface->client != NULL && surface->clientTask != fTask) {
+		ref->pixelMap = surface->client->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	}
+	surfaceHold(surface);
+	return ref;
+}
+
+void
+IOSurfaceRootUserClient::dropRef(struct minisurf_client_ref * ref)
+{
+	MiniIOSurface * s = ref->surface;
+
+	for (unsigned c = 0; c < 2; c++) {
+		s->useCount[c] -= ref->use[c];
+	}
+	s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+	OSSafeReleaseNULL(ref->map);
+	OSSafeReleaseNULL(ref->pixelMap);
+	*ref = fRefs[--fRefCount];
+	surfaceUnhold(s);
+}
+
+static uint32_t
+resultSize(const MiniIOSurface * s)
+{
+	uint32_t planes = s->info.planeCount ? s->info.planeCount : 1;
+
+	return (uint32_t) (sizeof(struct minisurf_result) + planes * sizeof(struct minisurf_plane));
+}
+
+/*
+ * The description iOS 26's IOSurface.framework takes (it reserves 0xc68 bytes for it, and copies it to
+ * offset 0x70 of its client object, where its getters read it): the iOS 16.5 one with the sizes widened
+ * to 64 bits. In the header, allocSize, width, height, bytesPerRow and offset become 64-bit and what
+ * follows them moves down; each plane's first six words (width, height, -, offset, bytesPerRow, size)
+ * become 64-bit and the rest of the plane moves down by 0x18, so a plane is 0x98 bytes.
+ */
+#define MINISURF_RESULT26_HEADER 0x88
+#define MINISURF_PLANE26_SIZE    0x98
+#define MINISURF_RESULT26_MAX    (MINISURF_RESULT26_HEADER + 20 * MINISURF_PLANE26_SIZE)
+static_assert(MINISURF_RESULT26_MAX == 0xc68, "iOS 26 result size");
+
+static void
+put64(uint8_t * p, size_t at, uint64_t v)
+{
+	memcpy(p + at, &v, sizeof(v));
+}
+
+static void
+put32(uint8_t * p, size_t at, uint32_t v)
+{
+	memcpy(p + at, &v, sizeof(v));
+}
+
+IOReturn
+IOSurfaceRootUserClient::returnSurface26(struct minisurf_client_ref * ref, bool known, IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s = ref->surface;
+	const struct minisurf_result * i = &s->info;
+	uint32_t planes = i->planeCount ? i->planeCount : 1;
+	uint32_t size = MINISURF_RESULT26_HEADER + planes * MINISURF_PLANE26_SIZE;
+	uint8_t * r = (uint8_t *) args->structureOutput;
+	mach_vm_address_t address = ref->map->getAddress();
+
+	if (r == NULL || args->structureOutputSize < size) {
+		return kIOReturnBadArgument;
+	}
+	bzero(r, size);
+	put64(r, 0x00, known ? ~0ULL : s->client == NULL ? address + PAGE_SIZE :
+	    ref->pixelMap != NULL ? ref->pixelMap->getAddress() : s->clientAddress);
+	put64(r, 0x08, address);
+	put64(r, 0x10, address + MINISURF_AUX_OFFSET);
+	put32(r, 0x18, i->sid);
+	put64(r, 0x20, i->allocSize);
+	put64(r, 0x28, i->width);
+	put64(r, 0x30, i->height);
+	put64(r, 0x38, i->bytesPerRow);
+	put64(r, 0x40, i->offset);
+	put32(r, 0x48, i->pixelFormat);
+	put32(r, 0x58, i->planeCount);
+	/* bytesPerElement .. lockSeed, then subsampling .. protectionOptions: as in iOS 16.5, 0x20 further on */
+	memcpy(r + 0x60, (const uint8_t *) i + 0x40, 0x88 - 0x60);
+	for (uint32_t k = 0; k < planes; k++) {
+		const struct minisurf_plane * p = &s->planes[k];
+		uint8_t * o = r + MINISURF_RESULT26_HEADER + k * MINISURF_PLANE26_SIZE;
+
+		put64(o, 0x00, p->width);
+		put64(o, 0x08, p->height);
+		put64(o, 0x18, p->offset);
+		put64(o, 0x20, p->bytesPerRow);
+		put64(o, 0x28, p->size);
+		memcpy(o + 0x30, (const uint8_t *) p + 0x18, sizeof(*p) - 0x18);
+	}
+	args->structureOutputSize = size;
+	return kIOReturnSuccess;
+}
+
+/* Describe the surface to the client. known: it has the surface already, do not build a second view. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(struct minisurf_client_ref * ref, bool known, IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s = ref->surface;
+	uint32_t size = resultSize(s);
+	struct minisurf_result * r = (struct minisurf_result *) args->structureOutput;
+	mach_vm_address_t address = ref->map->getAddress();
+
+	if (r == NULL || args->structureOutputSize < size) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureOutputSize >= MINISURF_RESULT26_MAX) {
+		return returnSurface26(ref, known, args);
+	}
+	*r = s->info;
+	memcpy(r + 1, s->planes, size - sizeof(*r));
+	r->shared = address;
+	r->aux = address + MINISURF_AUX_OFFSET;
+	r->base = known ? ~0ULL : s->client == NULL ? address + PAGE_SIZE :
+	    ref->pixelMap != NULL ? ref->pixelMap->getAddress() : s->clientAddress;
+	args->structureOutputSize = size;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodInit(IOExternalMethodArguments * args)
+{
+	struct {
+		uint32_t allocAlignMask;
+		uint32_t rowAlignMask;
+		uint32_t maxBytesPerRow;
+		uint32_t maxWidth;
+		uint32_t maxHeight;
+		uint16_t reserved;
+		uint16_t version;
+	} reply;
+
+	/*
+	 * iOS 26 (IOSurface.framework, _iosConnectInitalize) asks for 0x28 bytes: the same limits with the
+	 * maxima widened to 64 bits, a byte at 0x20 it reads in IOSurfaceClientInitDetachModeCode and
+	 * IOSurfaceClientSetIndexedTimestamp (left 0), and the version, which must be 1, at 0x22.
+	 */
+	struct {
+		uint32_t allocAlignMask;
+		uint32_t rowAlignMask;
+		uint64_t maxBytesPerRow;
+		uint64_t maxWidth;
+		uint64_t maxHeight;
+		uint8_t  features;
+		uint8_t  reserved;
+		uint16_t version;
+		uint32_t reserved2;
+	} reply26;
+
+	static_assert(sizeof(reply) == 0x18, "init reply");
+	static_assert(sizeof(reply26) == 0x28, "init reply (iOS 26)");
+	if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(reply26)) {
+		bzero(&reply26, sizeof(reply26));
+		reply26.allocAlignMask = (uint32_t) PAGE_MASK;
+		reply26.rowAlignMask = MINISURF_ROW_ALIGN - 1;
+		reply26.maxBytesPerRow = MINISURF_MAX_DIMENSION * 16;
+		reply26.maxWidth = MINISURF_MAX_DIMENSION;
+		reply26.maxHeight = MINISURF_MAX_DIMENSION;
+		reply26.version = 1;
+		memcpy(args->structureOutput, &reply26, sizeof(reply26));
+		args->structureOutputSize = sizeof(reply26);
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || args->structureOutputSize < sizeof(reply)) {
+		return kIOReturnBadArgument;
+	}
+	reply.allocAlignMask = (uint32_t) PAGE_MASK;
+	reply.rowAlignMask = MINISURF_ROW_ALIGN - 1;
+	reply.maxBytesPerRow = MINISURF_MAX_DIMENSION * 16;
+	reply.maxWidth = MINISURF_MAX_DIMENSION;
+	reply.maxHeight = MINISURF_MAX_DIMENSION;
+	reply.reserved = 0;
+	reply.version = 1;
+	memcpy(args->structureOutput, &reply, sizeof(reply));
+	args->structureOutputSize = sizeof(reply);
+	return kIOReturnSuccess;
+}
+
+/* The serialized object in a request, or NULL. */
+static OSObject *
+unserialize(const uint8_t * data, size_t size)
+{
+	if (data == NULL || size < 4) {
+		return NULL;
+	}
+	return OSUnserializeXML((const char *) data, size, NULL);
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodCreate(IOExternalMethodArguments * args)
+{
+	IOReturn ret;
+	IOMemoryMap * inMap = NULL;
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t inSize = args->structureInputSize;
+	OSObject * obj;
+	OSDictionary * props;
+	MiniIOSurface * s;
+	struct minisurf_client_ref * ref;
+	uint64_t began = mach_absolute_time();
+
+	if (args->scalarInputCount >= 1 && args->scalarInput[0] != 0) {
+		IOLog("MiniIOSurface: child surfaces are not supported (parent %llu)\n", args->scalarInput[0]);
+		return kIOReturnUnsupported;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		inMap = args->structureInputDescriptor->map(kIOMapReadOnly);
+		if (inMap == NULL) {
+			return kIOReturnNoMemory;
+		}
+		in = (const uint8_t *) inMap->getVirtualAddress();
+		inSize = inMap->getLength();
+	}
+	obj = unserialize(in, inSize);
+	OSSafeReleaseNULL(inMap);
+	props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	uint64_t made_at = mach_absolute_time();
+	s = surfaceCreate(props, &ret);
+	made_at = mach_absolute_time() - made_at;
+	if (s == NULL) {
+		IOLog("MiniIOSurface: create failed 0x%x: %ux%u format 0x%x alloc %u\n", ret,
+		    dictNumber(props, "IOSurfaceWidth", 0), dictNumber(props, "IOSurfaceHeight", 0),
+		    dictNumber(props, "IOSurfacePixelFormat", 0), dictNumber(props, "IOSurfaceAllocSize", 0));
+		props->release();
+		return ret;
+	}
+	{
+		char procname[32] = "?";
+		static unsigned keysSaid;
+
+		proc_selfname(procname, sizeof(procname));
+		/* what a traced program asks for, key by key (the first few surfaces) */
+		if (gSurfaceTraceOf[0] != 0 && strncmp(procname, gSurfaceTraceOf, strlen(gSurfaceTraceOf)) == 0 && keysSaid++ < 6) {
+			OSCollectionIterator * keys = OSCollectionIterator::withCollection(props);
+			char line[256];
+			size_t used = 0;
+			OSSymbol * key;
+
+			line[0] = 0;
+			while (keys != NULL && (key = OSDynamicCast(OSSymbol, keys->getNextObject())) != NULL && used < sizeof(line)) {
+				OSNumber * n = OSDynamicCast(OSNumber, props->getObject(key));
+
+				used += (size_t) snprintf(line + used, sizeof(line) - used, " %s=%lld", key->getCStringNoCopy(),
+				    n ? (long long) n->unsigned64BitValue() : -1LL);
+			}
+			OSSafeReleaseNULL(keys);
+			traceLine("MiniIOSurface: %s asks for a surface with%s\n", procname, line);
+		}
+	}
+	props->release();
+	{
+		char procname[32] = "?";
+
+		proc_selfname(procname, sizeof(procname));
+		if (gSurfaceTraceOf[0] != 0 && strncmp(procname, gSurfaceTraceOf, strlen(gSurfaceTraceOf)) != 0) {
+			procname[0] = 0;        /* (not one of those asked about: not counted) */
+		}
+		if (procname[0] != 0 && gSurfaceTraced < gSurfaceTrace) {
+			s->traced = gSurfaceTraceOf[0] != 0;
+		}
+	}
+	if (s->traced || (gSurfaceTraceOf[0] == 0 && gSurfaceTraced < gSurfaceTrace)) {
+		char procname[32] = "?";
+
+		gSurfaceTraced++;
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] created surface %u: %ux%u '%c%c%c%c', %u bytes per row, %u planes, %u bytes\n",
+		    procname, proc_selfpid(), s->sid, s->info.width, s->info.height, (int) (s->info.pixelFormat >> 24 & 0xff),
+		    (int) (s->info.pixelFormat >> 16 & 0xff), (int) (s->info.pixelFormat >> 8 & 0xff),
+		    (int) (s->info.pixelFormat & 0xff), s->info.bytesPerRow, s->info.planeCount, s->info.allocSize);
+	}
+
+	uint64_t mapped_at = mach_absolute_time();
+	IOLockLock(gSurfaceLock);
+	ref = addRef(s);
+	ret = ref ? returnSurface(ref, false, args) : kIOReturnNoMemory;
+	if (ref != NULL && ret != kIOReturnSuccess) {
+		dropRef(ref);
+	}
+	surfaceUnhold(s);                       /* the creator's hold; the client's own is in the ref */
+	IOLockUnlock(gSurfaceLock);
+	mapped_at = mach_absolute_time() - mapped_at;
+	OSAddAtomic64((SInt64) (mach_absolute_time() - began), (SInt64 *) &gSurfaceMaking);
+	OSIncrementAtomic(&gSurfacesMade);
+	if (s->info.allocSize >= SURFACE_KEEP_FROM) {
+		/* the big ones (the window server's of the whole display): where the time to make one goes, every 5 s */
+		static uint64_t since, all, making, mapping;
+		static uint32_t count;
+		uint64_t now = mach_absolute_time(), ns;
+
+		count++;
+		all += now - began;
+		making += made_at;
+		mapping += mapped_at;
+		absolutetime_to_nanoseconds(now - since, &ns);
+		if (since == 0) {
+			since = now;
+		} else if (ns >= 5 * NSEC_PER_SEC) {
+			uint64_t a, m, p;
+
+			absolutetime_to_nanoseconds(all, &a);
+			absolutetime_to_nanoseconds(making, &m);
+			absolutetime_to_nanoseconds(mapping, &p);
+			IOLog("MiniIOSurface: %u big surfaces made, %llu us each: %llu getting the memory and the surface, %llu mapping it "
+			    "for its maker; memory not kept as somebody else had it %u times, a piece kept longer put out for it %u times\n",
+			    count, a / 1000 / count, m / 1000 / count, p / 1000 / count, OSBitAndAtomic(0, &gSurfacesNotKept[0]),
+			    OSBitAndAtomic(0, &gSurfacesNotKept[1]));
+			since = now;
+			count = 0;
+			all = making = mapping = 0;
+		}
+	}
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodLookup(IOExternalMethodArguments * args)
+{
+	IOReturn ret = kIOReturnNotFound;
+	uint32_t sid;
+	struct minisurf_client_ref * ref;
+
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	sid = (uint32_t) args->scalarInput[0];
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref == NULL && sid != 0 && sid < MINISURF_TABLE_SIZE && gSurfaceTable[sid] != NULL) {
+		ref = addRef(gSurfaceTable[sid]);
+		if (ref == NULL) {
+			ret = kIOReturnNoMemory;
+		}
+	}
+	if (ref != NULL) {
+		ret = returnSurface(ref, false, args);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodLookupFromPort(IOExternalMethodArguments * args)
+{
+	IOReturn ret;
+	OSObject * obj = NULL;
+	IOSurfaceSendRight * right;
+	struct minisurf_client_ref * ref;
+	bool known;
+
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	ret = copyObjectForPortNameInTask(fTask, (mach_port_name_t) args->scalarInput[0], &obj);
+	right = OSDynamicCast(IOSurfaceSendRight, obj);
+	if (ret != kIOReturnSuccess || right == NULL || right->surface == NULL) {
+		static unsigned said;
+
+		if (said++ < 48) {
+			char procname[32] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			traceLine("MiniIOSurface: %s[%d] looked up a surface from port %#llx: %s\n", procname, proc_selfpid(),
+			    args->scalarInput[0], ret != kIOReturnSuccess ? "no object behind the port" : obj ? "not a surface's port" :
+			    "no surface");
+		}
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	{
+		static unsigned found;
+
+		if (found++ < 48) {
+			char procname[32] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			traceLine("MiniIOSurface: %s[%d] found surface %u (%ux%u) from port %#llx (%u found)\n", procname, proc_selfpid(),
+			    right->surface->sid, right->surface->info.width, right->surface->info.height, args->scalarInput[0], found);
+		}
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(right->surface->sid, false);
+	known = ref != NULL;
+	if (ref == NULL) {
+		ref = addRef(right->surface);
+	}
+	ret = ref ? returnSurface(ref, known, args) : kIOReturnNoMemory;
+	IOLockUnlock(gSurfaceLock);
+	if (right->surface->traced) {
+		char procname[32] = "?";
+		uint32_t format = right->surface->info.pixelFormat, nonzero = 0, first = 0, middle = 0;
+		const uint8_t * pixels = right->surface->kpixels;
+		uint32_t size = right->surface->info.allocSize;
+
+		/* what is in it by now: how many of its bytes are not zero, its first pixel and one in the middle */
+		for (uint32_t at = 0; pixels != NULL && at < size; at += 64) {
+			nonzero += pixels[at] != 0 || pixels[at + 1] != 0 || pixels[at + 2] != 0 || pixels[at + 3] != 0;
+		}
+		if (pixels != NULL && size >= 8) {
+			memcpy(&first, pixels, 4);
+			memcpy(&middle, pixels + (size / 2 & ~3u), 4);
+		}
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] looked up surface %u (%ux%u '%c%c%c%c') from a port: %#x; of every 64 bytes %u of %u "
+		    "begin with a pixel that is not 0, the first %#010x, one in the middle %#010x\n", procname, proc_selfpid(),
+		    right->surface->sid, right->surface->info.width, right->surface->info.height, (int) (format >> 24 & 0xff),
+		    (int) (format >> 16 & 0xff), (int) (format >> 8 & 0xff), (int) (format & 0xff), ret, nonzero, size / 64, first, middle);
+	}
+	obj->release();
+	return ret;
+}
+
+mach_port_name_t
+IOSurfaceRootUserClient::makeSendRight(task_t task, MiniIOSurface * s)
+{
+	IOSurfaceSendRight * right;
+	mach_port_name_t name = 0;
+
+	right = OSTypeAlloc(IOSurfaceSendRight);
+	if (right == NULL || !right->init()) {
+		OSSafeReleaseNULL(right);
+		return 0;
+	}
+	IOLockLock(gSurfaceLock);
+	surfaceHold(s);                         /* for as long as the send right exists */
+	IOLockUnlock(gSurfaceLock);
+	right->surface = s;
+	copyPortNameForObjectInTask(task, right, &name);
+	right->release();
+	return name;
+}
+
+mach_port_name_t
+MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface)
+{
+	return IOSurfaceRootUserClient::makeSendRight(task, surface);
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodCreatePort(IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s;
+	mach_port_name_t name;
+
+	if (args->scalarInputCount < 1 || args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	s = MiniIOSurfaceCopy((uint32_t) args->scalarInput[0]);
+	if (s == NULL) {
+		static unsigned missed;
+
+		/* dada: g2k13's backboardd looked up port 0 for the wallpaper's surfaces: a maker's port that was never made */
+		if (missed++ < 32) {
+			char procname[32] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			traceLine("MiniIOSurface: %s[%d] asked a port for surface %llu, which is not there\n", procname, proc_selfpid(),
+			    args->scalarInput[0]);
+		}
+		return kIOReturnNotFound;
+	}
+	name = makeSendRight(fTask, s);
+	{
+		static unsigned made;
+
+		if (made++ < 48 || name == 0) {
+			char procname[32] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			traceLine("MiniIOSurface: %s[%d] port for surface %u (%ux%u): %#x (%u ports made)\n", procname, proc_selfpid(), s->sid,
+			    s->info.width, s->info.height, name, made);
+		}
+	}
+	if (s->traced) {
+		char procname[32] = "?";
+
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] made a port for surface %u: %#x\n", procname, proc_selfpid(), s->sid, name);
+	}
+	MiniIOSurfaceDrop(s);
+	args->scalarOutput[0] = name;
+	args->scalarOutputCount = 1;
+	return name != 0 ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+/* Requests about values start with the surface number in 8 bytes; the reply to a change is the new seed. */
+static IOReturn
+returnSeed(IOExternalMethodArguments * args, uint32_t seed)
+{
+	if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(seed)) {
+		memcpy(args->structureOutput, &seed, sizeof(seed));
+		args->structureOutputSize = sizeof(seed);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodSetValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, seed = 0;
+	OSObject * obj;
+	OSArray * array;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (inSize < 12) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	obj = unserialize(in + 8, inSize - 8);
+	array = OSDynamicCast(OSArray, obj);
+	if (array == NULL) {
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref == NULL) {
+		ret = kIOReturnNotFound;
+	} else if (ref->surface->values != NULL) {
+		MiniIOSurface * s = ref->surface;
+		OSString * key = OSDynamicCast(OSString, array->getObject(1));
+		OSDictionary * all = OSDynamicCast(OSDictionary, array->getObject(0));
+
+		if (array->getCount() == 2 && key != NULL) {
+			s->values->setObject(key, array->getObject(0));         /* [value, key] */
+			ret = kIOReturnSuccess;
+		} else if (array->getCount() == 1 && all != NULL) {
+			s->values->merge(all);                                   /* [all the values] */
+			ret = kIOReturnSuccess;
+		}
+		if (ret == kIOReturnSuccess) {
+			s->updateValuesState();
+			seed = s->shared()->valuesSeed;
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+	obj->release();
+	return ret == kIOReturnSuccess ? returnSeed(args, seed) : ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodRemoveValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, seed = 0;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (inSize < 9 || in[inSize - 1] != 0) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL && ref->surface->values != NULL) {
+		MiniIOSurface * s = ref->surface;
+		const char * key = (const char *) in + 8;
+
+		if (key[0] == 0) {
+			s->values->flushCollection();
+		} else {
+			s->values->removeObject(key);
+		}
+		s->updateValuesState();
+		seed = s->shared()->valuesSeed;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret == kIOReturnSuccess ? returnSeed(args, seed) : ret;
+}
+
+/* The reply: 4 bytes unused, the seed, then the serialized value (a dictionary when all were asked for). */
+IOReturn
+IOSurfaceRootUserClient::methodCopyValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, header[2] = { 0, 0 };
+	struct minisurf_client_ref * ref;
+	OSSerialize * s = NULL;
+	IOReturn ret = kIOReturnNotFound;
+	uint32_t length = 0, total;
+
+	if (inSize < 9 || in[inSize - 1] != 0) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL && ref->surface->values != NULL) {
+		const char * key = (const char *) in + 8;
+		OSObject * value = key[0] ? ref->surface->values->getObject(key) : ref->surface->values;
+
+		header[1] = ref->surface->shared()->valuesSeed;
+		ret = kIOReturnSuccess;
+		if (value != NULL && (key[0] != 0 || ref->surface->values->getCount() != 0)) {
+			s = OSSerialize::binaryWithCapacity(4096);
+			if (s == NULL || !value->serialize(s)) {
+				ret = kIOReturnNoMemory;
+			} else {
+				length = s->getLength();
+			}
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+
+	total = (uint32_t) sizeof(header) + length;
+	if (ret == kIOReturnSuccess) {
+		if (args->structureOutputDescriptor != NULL) {
+			IOMemoryDescriptor * out = args->structureOutputDescriptor;
+
+			if (out->getLength() < total) {
+				ret = kIOReturnNoSpace;
+			} else if ((ret = out->prepare()) == kIOReturnSuccess) {
+				out->writeBytes(0, header, sizeof(header));
+				if (length != 0) {
+					out->writeBytes(sizeof(header), s->text(), length);
+				}
+				out->complete();
+				args->structureOutputDescriptorSize = total;
+			}
+		} else if (args->structureOutput == NULL || args->structureOutputSize < total) {
+			ret = kIOReturnNoSpace;
+		} else {
+			memcpy(args->structureOutput, header, sizeof(header));
+			if (length != 0) {
+				memcpy((uint8_t *) args->structureOutput + sizeof(header), s->text(), length);
+			}
+			args->structureOutputSize = total;
+		}
+	}
+	OSSafeReleaseNULL(s);
+	return ret;
+}
+
+/*
+ * Colour space, transfer function and the like: a fixed structure kept in the shared page.
+ * The request: the structure, its size, a mask of the fields that changed, the surface number.
+ */
+IOReturn
+IOSurfaceRootUserClient::methodSetBulkAttachments(const uint8_t * in, size_t inSize)
+{
+	static const struct {
+		uint8_t from, to;
+	} fields[15] = {
+		{ 0x00, 0x20 }, { 0x20, 0x30 }, { 0x30, 0x38 }, { 0x38, 0x39 }, { 0x39, 0x3a }, { 0x3a, 0x3b }, { 0x3b, 0x3c },
+		{ 0x3c, 0x3d }, { 0x3d, 0x3e }, { 0x3e, 0x3f }, { 0x3f, 0x40 }, { 0x40, 0x58 }, { 0x58, 0x5c }, { 0x5c, 0x64 },
+		{ 0x64, 0x65 },
+	};
+	uint64_t size, mask;
+	uint32_t sid;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (inSize < 0x88) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&size, in + 0x70, sizeof(size));
+	memcpy(&mask, in + 0x78, sizeof(mask));
+	memcpy(&sid, in + 0x80, sizeof(sid));
+	if (size > 0x70) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		uint8_t * attachments = ref->surface->shared()->attachments;
+
+		for (unsigned i = 0; i < 15; i++) {
+			if ((mask & (1ULL << i)) && fields[i].to <= size) {
+				memcpy(attachments + fields[i].from, in + fields[i].from, fields[i].to - fields[i].from);
+			}
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t inSize = args->structureInputSize;
+	IOMemoryMap * inMap = NULL;
+	struct minisurf_client_ref * ref;
+	IOReturn ret;
+	static uint32_t hk_calls;
+
+	if (hk_calls < 40) {
+		char procname[32] = "?";
+		hk_calls++;
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniIOSurface: %s[%d] selector %u (scalars %u in, %u out; structure %u in, %u out)\n", procname,
+		    proc_selfpid(), selector, args->scalarInputCount, args->scalarOutputCount, args->structureInputSize,
+		    args->structureOutputSize);
+	}
+
+	switch (selector) {
+	case kSurfaceMethodInit:
+		return methodInit(args);
+	case kSurfaceMethodCreate:
+		return methodCreate(args);
+	case kSurfaceMethodLookup:
+		return methodLookup(args);
+	case kSurfaceMethodLookupFromPort:
+		return methodLookupFromPort(args);
+	case kSurfaceMethodCreatePort:
+		return methodCreatePort(args);
+	case kSurfaceMethodEventCreate:
+		return methodEventCreate(args);
+	case kSurfaceMethodEventMap:
+		return methodEventMap(args);
+	case kSurfaceMethodEventNotify:
+		return methodEventNotify(args);
+	case kSurfaceMethodEventAddListener:
+		return methodEventAddListener(args);
+	case kSurfaceMethodEventRemoveListener:
+		return methodEventRemoveListener(args);
+
+	case kSurfaceMethodSetValue:
+	case kSurfaceMethodCopyValue:
+	case kSurfaceMethodRemoveValue:
+	case kSurfaceMethodSetBulkAttachments:
+		if (args->structureInputDescriptor != NULL) {
+			inMap = args->structureInputDescriptor->map(kIOMapReadOnly);
+			if (inMap == NULL) {
+				return kIOReturnNoMemory;
+			}
+			in = (const uint8_t *) inMap->getVirtualAddress();
+			inSize = inMap->getLength();
+		}
+		if (in == NULL) {
+			ret = kIOReturnBadArgument;
+		} else if (selector == kSurfaceMethodSetValue) {
+			ret = methodSetValue(args, in, inSize);
+		} else if (selector == kSurfaceMethodCopyValue) {
+			ret = methodCopyValue(args, in, inSize);
+		} else if (selector == kSurfaceMethodRemoveValue) {
+			ret = methodRemoveValue(args, in, inSize);
+		} else {
+			ret = methodSetBulkAttachments(in, inSize);
+		}
+		OSSafeReleaseNULL(inMap);
+		return ret;
+
+	case kSurfaceMethodSetPurgeable:                /* in: surface, new state; out: old state */
+		if (args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		ret = kIOReturnNotFound;
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			if (args->scalarOutputCount >= 1) {
+				args->scalarOutput[0] = ref->surface->purgeable;
+				args->scalarOutputCount = 1;
+			}
+			if (args->scalarInput[1] != 3) {        /* 3 = keep current */
+				ref->surface->purgeable = (uint32_t) args->scalarInput[1];
+			}
+			ret = kIOReturnSuccess;
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ret;
+
+	case kSurfaceMethodBindAccel:                   /* in: surface, accelerator, sub-id */
+		if (args->scalarInputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			ref->surface->shared()->accelID = (uint16_t) args->scalarInput[1];
+			ref->surface->shared()->accelSubID = (uint16_t) args->scalarInput[2];
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodSetYCbCrMatrix:              /* in: surface, matrix */
+		if (args->scalarInputCount < 2) {
+			break;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			ref->surface->shared()->ycbcrMatrix = (uint32_t) args->scalarInput[1];
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodSetOwnership:
+	case kSurfaceMethodSetOwnershipIdentity:
+	case kSurfaceMethodSetTimestamp:
+	case kSurfaceMethodSetIndexedTimestamp:
+	case kSurfaceMethodDetachModeCode:
+	case kSurfaceMethodLog:
+		/* accounting and diagnostics: nothing depends on them here */
+		if (args->scalarOutputCount != 0) {
+			bzero(args->scalarOutput, args->scalarOutputCount * sizeof(args->scalarOutput[0]));
+		}
+		return kIOReturnSuccess;
+
+	default:
+		break;
+	}
+
+	if (selector < 128 && !(gSurfaceLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		gSurfaceLogged[selector / 64] |= 1ULL << (selector % 64);
+		IOLog("MiniIOSurface: selector %u not implemented (scalars %u in, %u out; structure %u in, %u out)\n", selector,
+		    args->scalarInputCount, args->scalarOutputCount, args->structureInputSize, args->structureOutputSize);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+/* IOSurfaceSharedEvent (MiniSharedEvent above) */
+
+MiniSharedEvent *
+IOSurfaceRootUserClient::copyEvent(mach_port_name_t name)
+{
+	OSObject * obj = NULL;
+	MiniSharedEvent * event;
+
+	if (copyObjectForPortNameInTask(fTask, name, &obj) != kIOReturnSuccess) {
+		return NULL;
+	}
+	event = OSDynamicCast(IOSurfaceSendRight, obj);
+	if (event == NULL || event->ev == NULL) {
+		OSSafeReleaseNULL(obj);
+		return NULL;
+	}
+	return event;
+}
+
+/* The event's page, read-only, in this client's task (kept until the client goes): its value's address there. */
+IOReturn
+IOSurfaceRootUserClient::mapEvent(MiniSharedEvent * event, uint64_t * address)
+{
+	IOMemoryMap * map;
+
+	map = event->ev->page->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
+	if (map == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(gEventLock);
+	if (fEventMaps == NULL) {
+		fEventMaps = OSArray::withCapacity(4);
+	}
+	if (fEventMaps != NULL) {
+		fEventMaps->setObject(map);
+	}
+	IOLockUnlock(gEventLock);
+	*address = map->getAddress();
+	map->release();
+	return fEventMaps != NULL ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodEventCreate(IOExternalMethodArguments * args)
+{
+	MiniSharedEvent * event;
+	mach_port_name_t name = 0;
+	uint64_t address = 0;
+	IOReturn ret;
+
+	if (args->scalarOutputCount < 2) {
+		return kIOReturnBadArgument;
+	}
+	event = OSTypeAlloc(IOSurfaceSendRight);
+	if (event == NULL || !event->init()) {
+		OSSafeReleaseNULL(event);
+		return kIOReturnNoMemory;
+	}
+	event->ev = (struct mini_event_data *) IOMallocZeroData(sizeof(struct mini_event_data));
+	if (event->ev != NULL) {
+		event->ev->page = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut | kIOMemoryKernelUserShared, PAGE_SIZE, PAGE_SIZE);
+	}
+	if (event->ev == NULL || event->ev->page == NULL) {
+		event->release();
+		return kIOReturnNoMemory;
+	}
+	event->ev->value = (volatile uint64_t *) event->ev->page->getBytesNoCopy();
+	bzero((void *) event->ev->value, PAGE_SIZE);
+	event->ev->id = OSIncrementAtomic64((SInt64 *) &gEventIds) + 1;
+	ret = mapEvent(event, &address);
+	if (ret == kIOReturnSuccess) {
+		copyPortNameForObjectInTask(fTask, event, &name);
+	}
+	event->release();
+	if (ret != kIOReturnSuccess || name == 0) {
+		return ret != kIOReturnSuccess ? ret : kIOReturnNoMemory;
+	}
+	args->scalarOutput[0] = name;
+	args->scalarOutput[1] = address;
+	args->scalarOutputCount = 2;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodEventMap(IOExternalMethodArguments * args)
+{
+	MiniSharedEvent * event;
+	uint64_t address = 0;
+	IOReturn ret;
+
+	if (args->scalarInputCount < 1 || args->scalarOutputCount < 4) {
+		return kIOReturnBadArgument;
+	}
+	event = copyEvent((mach_port_name_t) args->scalarInput[0]);
+	if (event == NULL) {
+		return kIOReturnBadArgument;
+	}
+	ret = mapEvent(event, &address);
+	if (ret == kIOReturnSuccess) {
+		args->scalarOutput[0] = 0;
+		args->scalarOutput[1] = address;
+		args->scalarOutput[2] = event->ev->id;
+		args->scalarOutput[3] = 0;
+		args->scalarOutputCount = 4;
+	}
+	event->release();
+	return ret;
+}
+
+/* Tell, outside the lock, the listeners whose values `event` has reached (every event's where `event` is NULL and `client` given: none) */
+void
+IOSurfaceRootUserClient::eventTell(MiniSharedEvent * event, uint64_t value)
+{
+	struct {
+		OSAsyncReference64 ref;
+		io_user_reference_t args[3];
+		MiniSharedEvent * event;
+	} told[16];
+	unsigned count;
+
+	do {
+		count = 0;
+		IOLockLock(gEventLock);
+		for (unsigned i = 0; i < MINI_EVENT_WAITS && count < 16; i++) {
+			struct mini_event_wait * w = &gEventWaits[i];
+
+			if (w->event == event && w->target <= value) {
+				memcpy(told[count].ref, w->ref, sizeof(w->ref));
+				memcpy(told[count].args, w->args, sizeof(w->args));
+				told[count].event = w->event;
+				count++;
+				bzero(w, sizeof(*w));
+			}
+		}
+		IOLockUnlock(gEventLock);
+		for (unsigned i = 0; i < count; i++) {
+			IOUserClient::sendAsyncResult64(told[i].ref, kIOReturnSuccess, told[i].args, 3);
+			told[i].event->release();
+		}
+	} while (count == 16);
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodEventNotify(IOExternalMethodArguments * args)
+{
+	MiniSharedEvent * event;
+	uint64_t listener, target;
+	IOReturn ret = kIOReturnNoResources;
+	unsigned l;
+
+	if (args->scalarInputCount < 5) {
+		return kIOReturnBadArgument;
+	}
+	event = copyEvent((mach_port_name_t) args->scalarInput[0]);
+	if (event == NULL) {
+		return kIOReturnBadArgument;
+	}
+	listener = args->scalarInput[1];
+	target = args->scalarInput[4];
+	IOLockLock(gEventLock);
+	for (l = 0; l < 16 && fListeners[l].key != listener; l++) {
+	}
+	if (l == 16 || listener == 0) {
+		ret = kIOReturnNotFound;
+	} else {
+		for (unsigned i = 0; i < MINI_EVENT_WAITS; i++) {
+			struct mini_event_wait * w = &gEventWaits[i];
+
+			if (w->event == NULL) {
+				w->event = event;
+				event->retain();
+				w->client = this;
+				w->target = target;
+				memcpy(w->ref, fListeners[l].ref, sizeof(w->ref));
+				w->args[0] = args->scalarInput[3];      /* the block */
+				w->args[1] = args->scalarInput[2];      /* the event object */
+				w->args[2] = target;
+				ret = kIOReturnSuccess;
+				break;
+			}
+		}
+	}
+	IOLockUnlock(gEventLock);
+	if (ret == kIOReturnSuccess) {
+		eventTell(event, *event->ev->value);        /* reached already */
+	} else {
+		static unsigned said;
+
+		if (said++ < 8) {
+			IOLog("MiniIOSurface: an event's notification refused: %#x\n", ret);
+		}
+	}
+	event->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodEventAddListener(IOExternalMethodArguments * args)
+{
+	uint64_t key;
+	IOReturn ret = kIOReturnNoResources;
+
+	if (args->asyncWakePort == MACH_PORT_NULL || args->asyncReference == NULL) {
+		return kIOReturnBadArgument;
+	}
+	key = args->asyncReference[kIOAsyncCalloutRefconIndex];
+	IOLockLock(gEventLock);
+	for (unsigned l = 0; l < 16; l++) {
+		if (fListeners[l].key == 0 || fListeners[l].key == key) {
+			fListeners[l].key = key;
+			bzero(fListeners[l].ref, sizeof(fListeners[l].ref));
+			memcpy(fListeners[l].ref, args->asyncReference,
+			    MIN(sizeof(fListeners[l].ref), args->asyncReferenceCount * sizeof(io_user_reference_t)));
+			ret = kIOReturnSuccess;
+			break;
+		}
+	}
+	IOLockUnlock(gEventLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodEventRemoveListener(IOExternalMethodArguments * args)
+{
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gEventLock);
+	for (unsigned l = 0; l < 16; l++) {
+		if (fListeners[l].key == args->scalarInput[0]) {
+			bzero(&fListeners[l], sizeof(fListeners[l]));
+		}
+	}
+	IOLockUnlock(gEventLock);
+	return kIOReturnSuccess;
+}
+
+/* The client goes: its notifications still waiting are dropped. */
+void
+IOSurfaceRootUserClient::forgetEventWaits(void)
+{
+	MiniSharedEvent * drop[16];
+	unsigned count;
+
+	if (gEventLock == NULL) {
+		return;
+	}
+	do {
+		count = 0;
+		IOLockLock(gEventLock);
+		for (unsigned i = 0; i < MINI_EVENT_WAITS && count < 16; i++) {
+			if (gEventWaits[i].event != NULL && gEventWaits[i].client == this) {
+				drop[count++] = gEventWaits[i].event;
+				bzero(&gEventWaits[i], sizeof(gEventWaits[i]));
+			}
+		}
+		bzero(fListeners, sizeof(fListeners));
+		IOLockUnlock(gEventLock);
+		for (unsigned i = 0; i < count; i++) {
+			drop[i]->release();
+		}
+	} while (count == 16);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapEventSignal(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	MiniSharedEvent * event = copyEvent((mach_port_name_t) (uintptr_t) p1);
+	uint64_t value = (uint64_t) p2;
+
+	if (event == NULL) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gEventLock);
+	*event->ev->value = value;
+	IOLockWakeup(gEventLock, (event_t) event, false);
+	IOLockUnlock(gEventLock);
+	eventTell(event, value);
+	event->release();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapEventWait(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	MiniSharedEvent * event = copyEvent((mach_port_name_t) (uintptr_t) p1);
+	uint64_t target = (uint64_t) p2, ms = (uint64_t) p3, deadline;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (event == NULL) {
+		return kIOReturnBadArgument;
+	}
+	clock_interval_to_deadline((uint32_t) MIN(ms, 0xffffffffull), kMillisecondScale, &deadline);
+	IOLockLock(gEventLock);
+	while (*event->ev->value < target) {
+		int r = IOLockSleepDeadline(gEventLock, (event_t) event, deadline, THREAD_ABORTSAFE);
+
+		if (r != THREAD_AWAKENED && *event->ev->value < target) {
+			ret = r == THREAD_TIMED_OUT ? kIOReturnTimeout : kIOReturnAborted;
+			break;
+		}
+	}
+	IOLockUnlock(gEventLock);
+	event->release();
+	return ret;
+}
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService ** targetP, UInt32 index)
+{
+	if (index >= kSurfaceTrapCount) {
+		return NULL;
+	}
+	*targetP = this;
+	return &fTraps[index];
+}
+
+IOReturn
+IOSurfaceRootUserClient::useCountCommon(uint32_t sid, uint32_t category, int delta)
+{
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (category > 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		MiniIOSurface * s = ref->surface;
+
+		if (delta > 0 || ref->use[category] != 0) {
+			ref->use[category] += delta;
+			s->useCount[category] += delta;
+			s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, -1);
+}
+
+/*
+ * Lock and unlock do not exclude anybody: the memory is shared and always mapped.
+ * What matters is the seed, which tells readers that the pixels may have changed.
+ */
+IOReturn
+IOSurfaceRootUserClient::lockCommon(uint32_t sid, uint32_t options, user_addr_t seedOut)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t seed = 0;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		struct minisurf_shared * sh = ref->surface->shared();
+
+		if (!(options & kSurfaceLockReadOnly)) {
+			sh->seed++;
+		}
+		seed = sh->seed;
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (ref == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (seedOut != 0) {
+		copyout(&seed, seedOut, sizeof(seed));
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+/*
+ * A client drops a surface in two steps: "detach" while it still holds its own lock, and
+ * "release" after it. A lookup of the same surface in between must make a fresh view.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef((uint32_t) (uintptr_t) p1, false);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t sid = (uint32_t) (uintptr_t) p1;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, true);
+	if (ref == NULL) {
+		ref = findRef(sid, false);
+	}
+	if (ref != NULL) {
+		dropRef(ref);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ref ? kIOReturnSuccess : kIOReturnNotFound;
+}
diff --git a/iokit/Kernel/MiniIOSurface.h b/iokit/Kernel/MiniIOSurface.h
new file mode 100644
index 0000000..ad41137
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.h
@@ -0,0 +1,183 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext, enough of it for the iOS
+ * window server and its clients to share pixel buffers on a machine without Apple hardware.
+ *
+ * The protocol (user client selectors, traps and the layout of the structures the kernel
+ * hands to IOSurface.framework) was worked out from the user-space side of iOS 16.5.
+ */
+#ifndef _IOKIT_MINIIOSURFACE_H
+#define _IOKIT_MINIIOSURFACE_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#include "MiniDrivers.h"
+
+#define MINISURF_MAX_PLANES     4
+#define MINISURF_RESULT_MAX     0xa68           /* what IOSurface.framework reserves for a result */
+
+/* One plane, as IOSurface.framework reads it (0x80 bytes). */
+struct minisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* What "create" and the lookups return: this header, then the planes (at least one). */
+struct minisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct minisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct minisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+/* State that every client reads straight from memory shared with the kernel. */
+struct minisurf_shared {
+	uint64_t registryID;                    /* 0x00 */
+	uint16_t accelID;                       /* 0x08 */
+	uint16_t accelSubID;                    /* 0x0a */
+	uint32_t seed;                          /* 0x0c changes when somebody has written the pixels */
+	uint32_t reserved10;
+	uint8_t  tiled;                         /* 0x14 */
+	uint8_t  reserved15[3];
+	uint64_t useCount;                      /* 0x18 two 32-bit counters, one per category */
+	uint32_t valuesSeed;                    /* 0x20 */
+	uint32_t ycbcrMatrix;                   /* 0x24 */
+	uint32_t valuesSize;                    /* 0x28 room needed to fetch the values; 0 = none */
+	uint8_t  pixelSizeCasting;              /* 0x2c */
+	uint8_t  displayable;                   /* 0x2d */
+	uint8_t  sysMemOnly;                    /* 0x2e */
+	uint8_t  reserved2f;
+	uint8_t  attachments[0x70];             /* 0x30 the "bulk attachments" */
+};
+
+struct minisurf_aux {
+	uint64_t timestamps[4];
+	uint64_t detachModeCode;
+};
+
+#define MINISURF_AUX_OFFSET     0x400           /* of the aux structure inside the shared page */
+
+class MiniIOSurface : public OSObject
+{
+	OSDeclareDefaultStructors(MiniIOSurface);
+
+public:
+	uint32_t                        sid;
+	uint32_t                        holders;        /* clients, send rights, kernel users */
+	IOBufferMemoryDescriptor *      memory;         /* one page of shared state, then the pixels */
+	uint8_t *                       kbase;          /* the same, in the kernel */
+	/*
+	 * ... unless the surface was made around memory its maker has already (IOSurfaceAddress):
+	 * then the pixels are that memory, held in place and seen from the kernel as well, and
+	 * `memory` is the page of shared state alone.
+	 */
+	IOMemoryDescriptor *            client;
+	IOMemoryMap *                   clientMap;
+	task_t                          clientTask;     /* whose memory it is (not held: only compared) */
+	mach_vm_address_t               clientAddress;  /* ... and where it is there */
+	uint8_t *                       kpixels;        /* where the pixel memory starts in the kernel, either way */
+	/*
+	 * ... and for a surface made around its maker's memory, a copy of the pixels as they were when it was made (or
+	 * last written under a lock: snapshotSeed), which is what the GPU draws from (RedwoodGPU.cpp). Its maker may draw
+	 * the next picture into the same memory as soon as the surface is handed over -- iconservicesagent does, and the
+	 * icons on the home screen showed the labels of other icons -- and what was handed over is what was there then.
+	 */
+	IOBufferMemoryDescriptor *      snapshot;
+	uint32_t                        snapshotSeed;
+	uint32_t                        drawn;          /* the GPU's last submission that names the pixels (0: none; RedwoodGPU.cpp) */
+	uint32_t                        drawnOn[2];     /* ... the last on each ring, with two (boot-arg dadagpu_preempt): `drawn` done is not both done */
+	struct minisurf_result          info;           /* addresses not filled in */
+	struct minisurf_plane           planes[MINISURF_MAX_PLANES];
+	OSDictionary *                  values;
+	uint32_t                        useCount[2];
+	uint32_t                        purgeable;
+	bool                            traced;         /* made by a program of boot-arg surftrace_of: its ports are said too */
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+
+	struct minisurf_shared *
+	shared(void) const
+	{
+		return (struct minisurf_shared *) kbase;
+	}
+	struct minisurf_aux *
+	aux(void) const
+	{
+		return (struct minisurf_aux *) (kbase + MINISURF_AUX_OFFSET);
+	}
+	/* The first byte of the pixels (the "base address" clients see). */
+	uint8_t *
+	pixels(void) const
+	{
+		return kpixels + info.offset;
+	}
+	void updateValuesState(void);
+};
+
+/*
+ * For other parts of the kernel (the framebuffer).
+ * A surface found or made here is held until MiniIOSurfaceDrop().
+ */
+MiniIOSurface * MiniIOSurfaceCopy(uint32_t sid);
+/*
+ * What making and freeing surfaces has cost since this was last asked: how many, microseconds
+ * each; how many got memory that was kept from one before.
+ */
+void            MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again);
+/* Clear the memory that is kept of surfaces that are gone, for the next ones: when the caller has a moment. */
+void            MiniIOSurfaceClearKept(void);
+/* Wait, for so many milliseconds at most, until the GPU is done with a surface's pixels (RedwoodGPU.cpp). */
+bool            MiniIOSurfaceDrawn(MiniIOSurface * surface, uint64_t milliseconds);
+MiniIOSurface * MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat);
+void            MiniIOSurfaceDrop(MiniIOSurface * surface);
+/* A Mach send right for the surface in the task (what IOSurfaceCreateMachPort gives); 0 on failure. */
+mach_port_name_t MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface);
+
+
+#endif /* _IOKIT_MINIIOSURFACE_H */
diff --git a/iokit/Kernel/RedwoodBT.cpp b/iokit/Kernel/RedwoodBT.cpp
new file mode 100644
index 0000000..65f4c2f
--- /dev/null
+++ b/iokit/Kernel/RedwoodBT.cpp
@@ -0,0 +1,111 @@
+/*
+ * RedwoodBT: the IOKit service by which iOS's bluetoothd finds the Bluetooth UART.
+ *
+ * bluetoothd does not find the serial port by scanning /dev: on our boots /dev/uart.bluetooth exists and it never
+ * opens it ("No bluetooth on this device", exit). It looks through IOKit instead -- FindLocalMacAddress tries
+ * IOServiceNameMatching("bluetooth") and ("marconi-bt") -- so the port has to be an IORegistry entry, as a real
+ * UART-Bluetooth provider would publish. This makes a bare service named "bluetooth" under the platform, carrying the
+ * tty's BSD name and a device address, the way bluetoothd's lookup expects to find one; the bytes still flow through
+ * the /dev node (bsd/dev/hakios_dada_wifi.c, bt_serve). It has no user client, like RedwoodWLAN.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSNumber.h>
+
+extern "C" void RedwoodBTStart(const char * bsdname, const uint8_t * address);
+extern "C" void RedwoodBTSetAddress(const uint8_t * address);
+
+class RedwoodBT : public IOService
+{
+	OSDeclareDefaultStructors(RedwoodBT);
+};
+
+OSDefineMetaClassAndStructors(RedwoodBT, IOService);
+
+static RedwoodBT * gRedwoodBT;           /* the one published service, kept for its address */
+
+/*
+ * The address goes in as bluetoothd reads it back: FindLocalMacAddress takes the service named "bluetooth",
+ * IORegistryEntrySearchCFProperty(.., "IODeviceTree", "local-mac-address", .., recursively), the first six bytes in
+ * display order. With none, the address is all 00s, and bluetoothd quits ("Not a valid MAC address (all 00s)", then
+ * "No bluetooth on this device") before it ever looks for /dev/uart.bluetooth.
+ */
+static void
+bt_set_address(RedwoodBT * bt, const uint8_t * address)
+{
+	OSData * mac = OSData::withBytes(address, 6);
+
+	if (mac == NULL) {
+		return;
+	}
+	bt->setProperty("local-mac-address", mac);
+	bt->setProperty("bluetooth-mac", mac);
+	mac->release();
+}
+
+static IOService *
+bt_publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+/* Once, when /dev/uart.bluetooth exists. bsdname is "uart.bluetooth"; address is the chip's six bytes (or NULL). */
+void
+RedwoodBTStart(const char * bsdname, const uint8_t * address)
+{
+	IOService * platform = IOService::getPlatform();
+	RedwoodBT * bt = OSTypeAlloc(RedwoodBT);
+	OSString * s;
+
+	if (platform == NULL || bt == NULL || !bt->init()) {
+		OSSafeReleaseNULL(bt);
+		IOLog("RedwoodBT: cannot create the service\n");
+		return;
+	}
+	if ((s = OSString::withCString(bsdname)) != NULL) {
+		bt->setProperty("BSD Name", s);         /* bluetoothd reads this to find the tty */
+		s->release();
+	}
+	if ((s = OSString::withCString("uart")) != NULL) {
+		bt->setProperty("transport", s);
+		s->release();
+	}
+	if (address != NULL) {
+		bt_set_address(bt, address);
+	}
+	bt->setProperty("IOBuiltin", true);
+	/* the two names bluetoothd's lookup tries (IOServiceNameMatching): publish under "bluetooth" */
+	if (bt_publish(bt, platform, "bluetooth") == NULL) {
+		IOLog("RedwoodBT: the service did not start\n");
+	} else {
+		IOLog("RedwoodBT: published IOKit service 'bluetooth' (BSD Name %s) for bluetoothd\n", bsdname);
+		gRedwoodBT = bt;                /* keeps the reference */
+	}
+}
+
+/* Later, once the chip has said its address (HCI Read BD_ADDR; six bytes in display order): launchd starts bluetoothd
+ * again every ~10 s, and the next one finds it. Nothing happens without a published service. */
+void
+RedwoodBTSetAddress(const uint8_t * address)
+{
+	if (gRedwoodBT == NULL || address == NULL) {
+		return;
+	}
+	bt_set_address(gRedwoodBT, address);
+	IOLog("RedwoodBT: local-mac-address %02x:%02x:%02x:%02x:%02x:%02x\n", address[0], address[1], address[2],
+	    address[3], address[4], address[5]);
+}
diff --git a/iokit/Kernel/RedwoodBattery.cpp b/iokit/Kernel/RedwoodBattery.cpp
new file mode 100644
index 0000000..87223c2
--- /dev/null
+++ b/iokit/Kernel/RedwoodBattery.cpp
@@ -0,0 +1,230 @@
+/*
+ * RedwoodBattery: the phone's battery as iOS looks for it, an IOPMPowerSource.
+ *
+ * powerd finds every service of the class IOPMPowerSource (it calls the first "InternalBattery-0"),
+ * listens for its kIOPMMessageBatteryStatusHasChanged and then reads its properties: whether a
+ * battery is installed, CurrentCapacity and MaxCapacity (without both it gives up on the battery),
+ * whether a charger is connected and charging, voltage, current, cycles, the charger's details.
+ * From them it makes the power sources list (IOPSCopyPowerSourcesInfo) and posts its notifications,
+ * and everything else follows from that: the status bar's battery, the lock screen's "Charging",
+ * the Batteries widget, Settings > Battery.
+ *
+ * What the values are comes from the audio DSP's battery manager (bsd/dev/redwood_adsp.c,
+ * with adsp=1, unless battmgr=0), by way of bsd/dev/redwood_battery.c, which calls
+ * RedwoodBatteryReport() with every reading; the first one makes the service. Nothing here asks
+ * the charger anything or tells it anything.
+ *
+ * As on Apple's newer batteries, CurrentCapacity is the percentage that the fuel gauge shows (and
+ * MaxCapacity 100); the charges in mAh are AppleRawCurrentCapacity, AppleRawMaxCapacity (what the
+ * gauge has learnt a full charge to be), NominalChargeCapacity and DesignCapacity.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+/* The same as struct redwood_battery_state in bsd/sys/redwood_input.h, which is not seen from here. */
+struct redwood_battery_state {
+	uint32_t size;
+	int32_t percent_hundredths;
+	int32_t voltage_uv;
+	int32_t current_ua;             /* more than 0 while the battery takes charge */
+	int32_t temperature_hundredths;
+	int32_t present, external, status;
+	int32_t charge_uah, full_uah, design_uah, cycles;
+	int32_t usb_type;
+	int32_t usb_voltage_uv, usb_current_ua;
+};
+
+extern "C" void RedwoodBatteryReport(const void * state, unsigned size);
+
+class RedwoodBattery : public IOPMPowerSource
+{
+	OSDeclareDefaultStructors(RedwoodBattery);
+
+public:
+	void report(const struct redwood_battery_state * b);
+
+private:
+	void number(const char * key, long long value);
+	void flag(const char * key, bool value);
+	void object(const char * key, OSObject * value);
+};
+
+OSDefineMetaClassAndStructors(RedwoodBattery, IOPMPowerSource);
+
+static RedwoodBattery * battery;
+
+void
+RedwoodBattery::number(const char * key, long long value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+	OSNumber * n = OSNumber::withNumber((unsigned long long) value, 32);
+
+	if (symbol != NULL && n != NULL) {
+		setPSProperty(symbol, n);
+	}
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::flag(const char * key, bool value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::object(const char * key, OSObject * value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL && value != NULL) {
+		setPSProperty(symbol, value);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+/*
+ * What iOS calls the charger by (IOPSKeysPrivate.h's kIOPSFamilyCode*, iokit_family_err(sub_iokit_usb, n)),
+ * from Linux's POWER_SUPPLY_USB_TYPE_*, as the DSP gives it.
+ */
+static unsigned
+family_code(int usb_type)
+{
+	switch (usb_type) {
+	case 1: return 0xe0004000;      /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: return 0xe0004004;      /* DCP, a charger: kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005;      /* CDP, a computer's charging port: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009;      /* USB-C: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400a;      /* USB Power Delivery: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007;     /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+void
+RedwoodBattery::report(const struct redwood_battery_state * b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+	bool charging = b->external && b->status == 1;          /* POWER_SUPPLY_STATUS_CHARGING */
+
+	percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	setBatteryInstalled(b->present != 0);
+	setExternalConnected(b->external != 0);
+	setExternalChargeCapable(b->external != 0);
+	setIsCharging(charging);
+	flag("FullyCharged", b->external && (b->status == 4 || percent == 100));    /* POWER_SUPPLY_STATUS_FULL */
+	flag("AppleRawExternalConnected", b->external != 0);
+	setCurrentCapacity((unsigned) percent);
+	setMaxCapacity(100);
+	setVoltage((unsigned) (b->voltage_uv / 1000));
+	setAmperage(b->current_ua / 1000);
+	number("InstantAmperage", b->current_ua / 1000);
+	number("Temperature", b->temperature_hundredths);
+	if (b->charge_uah > 0) {
+		number("AppleRawCurrentCapacity", b->charge_uah / 1000);
+	}
+	if (b->full_uah > 0) {
+		number("AppleRawMaxCapacity", b->full_uah / 1000);
+		number("NominalChargeCapacity", b->full_uah / 1000);
+	}
+	if (b->design_uah > 0) {
+		number("DesignCapacity", b->design_uah / 1000);
+	}
+	if (b->cycles > 0) {
+		setCycleCount((unsigned) b->cycles);
+	}
+
+	if (b->external) {
+		OSDictionary * adapter = OSDictionary::withCapacity(6);
+		long long mv = b->usb_voltage_uv / 1000, ma = b->usb_current_ua / 1000;
+		OSNumber * n;
+
+		if (adapter != NULL) {
+			if ((n = OSNumber::withNumber((unsigned long long) ((mv * ma + 500000) / 1000000), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsWattsKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) ma, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsAmperageKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) mv, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsVoltage, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) family_code(b->usb_type), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+				n->release();
+			}
+			adapter->setObject("IsWireless", kOSBooleanFalse);
+			object(kIOPMPSAdapterDetailsKey, adapter);
+			adapter->release();
+		}
+	} else {
+		OSDictionary * none = OSDictionary::withCapacity(1);
+		OSNumber * n = OSNumber::withNumber(0ULL, 32);    /* kIOPSFamilyCodeDisconnected */
+
+		if (none != NULL && n != NULL) {
+			none->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+			object(kIOPMPSAdapterDetailsKey, none);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(none);
+	}
+	updateStatus();
+}
+
+/* With every reading of the battery (bsd/dev/redwood_battery.c); the first one makes the service. One caller at a time. */
+void
+RedwoodBatteryReport(const void * state, unsigned size)
+{
+	const struct redwood_battery_state * b = (const struct redwood_battery_state *) state;
+	IOService * platform;
+
+	if (size != sizeof(struct redwood_battery_state) || b->size != sizeof(struct redwood_battery_state)) {
+		static bool said;
+
+		if (!said) {
+			said = true;
+			IOLog("RedwoodBattery: the battery's state is %u bytes, not %lu: bsd/sys/redwood_input.h and this file disagree\n",
+			    size, sizeof(struct redwood_battery_state));
+		}
+		return;
+	}
+	if (battery == NULL) {
+		RedwoodBattery * made = OSTypeAlloc(RedwoodBattery);
+
+		if ((platform = IOService::getPlatform()) == NULL || made == NULL || !made->init()) {
+			OSSafeReleaseNULL(made);
+			return;
+		}
+		made->report(b);        /* (the properties are there before anybody finds the service) */
+		if (!made->attach(platform)) {
+			made->release();
+			return;
+		}
+		made->setName("RedwoodBattery");
+		if (!made->start(platform)) {
+			made->detach(platform);
+			made->release();
+			return;
+		}
+		made->registerService();
+		battery = made;
+		IOLog("RedwoodBattery: the battery's power source is up: %d%%, %s\n", (b->percent_hundredths + 50) / 100,
+		    b->external ? (b->status == 1 ? "charging" : "on a charger, not charging") : "not on a charger");
+		return;
+	}
+	battery->report(b);
+}
diff --git a/iokit/Kernel/RedwoodGPU.cpp b/iokit/Kernel/RedwoodGPU.cpp
new file mode 100644
index 0000000..83db315
--- /dev/null
+++ b/iokit/Kernel/RedwoodGPU.cpp
@@ -0,0 +1,1825 @@
+/*
+ * RedwoodGPU: the phone's Adreno for programs to draw with.
+ *
+ * bsd/dev/redwood_adreno.c wakes the GPU and, with boot-arg adreno_keep=1, keeps it on and
+ * starts this service. A program that opens it speaks the interface of Linux's msm DRM driver,
+ * the one Mesa's freedreno knows: every request of that interface is a call of the user client
+ * with the request's number as the selector and the request's structure passed in and back
+ * (userland: tools/mesa/redwood-drm, which stands in for libdrm inside Mesa). What Linux does
+ * with mmap() on the device is the client memory of the type that is the buffer's handle.
+ *
+ * What there is of the interface is what freedreno uses to draw: parameters, buffers (made,
+ * told their address in the GPU's address space, mapped, given back), submission of command
+ * buffers, and waiting for one to be done. A buffer is wired kernel memory entered into the 3D
+ * core's SMMU context; it is zero when made, and write-combined: what the program writes goes to
+ * memory, where the GPU reads it, and not into this processor's cache (as Linux maps them for
+ * freedreno; boot-arg gpu_cached=1 makes them ordinary memory, pushed out of the cache whenever
+ * the GPU is given something to do: see submit()).
+ *
+ * One request is not Linux's: a buffer that is the memory of an IOSurface (surfaceBuffer()), for
+ * drawing into what the display shows and for reading pictures where other programs have drawn
+ * them. Linux hands such memory around as file descriptors; here it has a name already. That
+ * memory is ordinary, cached memory, which everybody else reads and writes as such.
+ *
+ * Not here yet: interrupts (waiting is asking again five times a millisecond), more than one
+ * program's worth of care (every client's buffers are in the one address space; a client that
+ * goes takes its own away), fences and buffers as file descriptors. A GPU that has stopped
+ * answering is reported (redwood_gpu_report()) and, with boot-arg gpu_recover=1, reset and
+ * started again, so that the submission that hung is all that is lost: what that does and
+ * which source says so is at redwood_gpu_recover() in bsd/dev/redwood_adreno.c. Without the
+ * boot-arg it stays stopped and nothing is waited for again.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <mach/vm_param.h>
+#include <sys/systm.h>
+
