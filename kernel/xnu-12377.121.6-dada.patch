diff --git a/osfmk/ipc/ipc_kmsg.c b/osfmk/ipc/ipc_kmsg.c
index 190e5d2..4e0b65f 100644
--- a/osfmk/ipc/ipc_kmsg.c
+++ b/osfmk/ipc/ipc_kmsg.c
@@ -449,12 +449,75 @@ ipc_kmsg_get_thread_group(ipc_kmsg_t kmsg)
 
 #pragma mark ipc_kmsg signing
 
+/* hakios: what each kmsg looked like when it was signed, to compare against on a mismatch */
+struct hk_sign_rec {
+	ipc_kmsg_t      kmsg;
+	void           *trailer;
+	uint32_t        sig;
+	uint8_t         base[sizeof(mach_msg_base_t)];
+	uint8_t         tr[MAX_TRAILER_SIZE];
+};
+#define HK_SIGN_RING 64
+static struct hk_sign_rec hk_sign_ring[HK_SIGN_RING];
+static uint32_t hk_sign_next;
+extern void loader_log_line(const char *line);
+static uint32_t __ipc_kmsg_sign(ipc_kmsg_t kmsg, mach_msg_max_trailer_t *trailer, mach_msg_size_t *dsc_count);
+
+static void
+hk_sign_record(ipc_kmsg_t kmsg, mach_msg_max_trailer_t *trailer, uint32_t sig)
+{
+	struct hk_sign_rec *r = &hk_sign_ring[os_atomic_inc_orig(&hk_sign_next, relaxed) % HK_SIGN_RING];
+
+	r->kmsg = kmsg;
+	r->trailer = trailer;
+	r->sig = sig;
+	memcpy(r->base, ikm_header(kmsg), sizeof(r->base));
+	memcpy(r->tr, trailer, sizeof(r->tr));
+}
+
+static void
+hk_sign_explain(ipc_kmsg_t kmsg, uint32_t sig)
+{
+	char line[200];
+	mach_msg_max_trailer_t *trailer = ipc_kmsg_get_trailer(kmsg);
+	const uint8_t *now_base = (const uint8_t *)ikm_header(kmsg), *now_tr = (const uint8_t *)trailer;
+	uint32_t again1 = __ipc_kmsg_sign(kmsg, trailer, NULL);
+	uint32_t again2 = __ipc_kmsg_sign(kmsg, trailer, NULL);
+
+	snprintf(line, sizeof(line), "hakios kmsg: kmsg=%p sig now=0x%08x again=0x%08x/0x%08x stored=0x%08x trailer=%p\n",
+	    kmsg, sig, again1, again2, kmsg->ikm_signature, trailer);
+	loader_log_line(line);
+	for (int i = HK_SIGN_RING - 1; i >= 0; i--) {
+		struct hk_sign_rec *r = &hk_sign_ring[(hk_sign_next + (uint32_t)i) % HK_SIGN_RING];
+		if (r->kmsg != kmsg) {
+			continue;
+		}
+		snprintf(line, sizeof(line), "hakios kmsg: signed with sig=0x%08x trailer=%p\n", r->sig, r->trailer);
+		loader_log_line(line);
+		for (size_t j = 0; j < sizeof(r->base); j++) {
+			if (r->base[j] != now_base[j]) {
+				snprintf(line, sizeof(line), "hakios kmsg: base[%zu] 0x%02x -> 0x%02x\n", j, r->base[j], now_base[j]);
+				loader_log_line(line);
+			}
+		}
+		for (size_t j = 0; j < sizeof(r->tr); j++) {
+			if (r->tr[j] != now_tr[j]) {
+				snprintf(line, sizeof(line), "hakios kmsg: trailer[%zu] 0x%02x -> 0x%02x\n", j, r->tr[j], now_tr[j]);
+				loader_log_line(line);
+			}
+		}
+		return;
+	}
+	loader_log_line("hakios kmsg: no signing record for this kmsg\n");
+}
+
 __abortlike
 static void
 __ikm_signature_check_panic(ipc_kmsg_t kmsg, uint32_t sig)
 {
 	mach_msg_header_t *hdr = ikm_header(kmsg);
 
+	hk_sign_explain(kmsg, sig);
 	panic("IPC kmsg header signature mismatch: "
 	    "kmsg=%p, hdr=%p, id=%d, sig=0x%08x (expected 0x%08x)",
 	    kmsg, hdr, hdr->msgh_id, sig, kmsg->ikm_signature);
@@ -516,6 +579,7 @@ static void
 ipc_kmsg_sign(ipc_kmsg_t kmsg, mach_msg_max_trailer_t *trailer)
 {
 	kmsg->ikm_signature = __ipc_kmsg_sign(kmsg, trailer, NULL);
+	hk_sign_record(kmsg, trailer, kmsg->ikm_signature);
 }
 
