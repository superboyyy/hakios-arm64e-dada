+extern void dada_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+extern uint32_t dada_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+extern void dada_gpu_report(const char *why);
