diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 0906700..3bf7979 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -36,6 +36,92 @@
 #include <security/mac_framework.h>
 #endif
 
+/*
+ * Bring-up aid: boot-arg systrace=1 logs every BSD system call that fails,
+ * systrace=2 logs all of them (to the kernel message buffer). For calls that
+ * take a path, the path is shown. systrace_name=NAME keeps it to the processes
+ * of that name: with a whole system running, everybody's failed calls are
+ * megabytes a minute.
+ */
+static TUNABLE(uint32_t, systrace_level, "systrace", 0);
+static TUNABLE_STR(systrace_name, MAXCOMLEN + 1, "systrace_name", "");
+extern const char *syscallnames[];
+
+static void
+systrace_report(struct proc *proc, unsigned short syscode, struct uthread *uthread, int error)
+{
+	/* system calls whose first (or, for the second list, second) argument is a path */
+	static const unsigned short path_arg0[] = {
+		SYS_open, SYS_link, SYS_unlink, SYS_chdir, SYS_mknod, SYS_chmod, SYS_chown, SYS_access, SYS_readlink,
+		SYS_execve, SYS_chroot, SYS_rename, SYS_mkdir, SYS_rmdir, SYS_pathconf, SYS_getattrlist, SYS_setattrlist,
+		SYS_getxattr, SYS_listxattr, SYS_fsctl, SYS_stat64, SYS_lstat64, SYS_statfs64, SYS_open_nocancel,
+		SYS_open_dprotected_np, SYS_symlink, SYS_unmount, SYS_stat64_extended, SYS_lstat64_extended,
+	};
+	static const unsigned short path_arg1[] = {
+		SYS_mount, SYS_posix_spawn, SYS_openat, SYS_openat_nocancel, SYS_fstatat64, SYS_faccessat, SYS_readlinkat,
+		SYS_getattrlistat, SYS_mkdirat, SYS_unlinkat,
+	};
+	char path[160] = "";
+	/*
+	 * Two calls are worth more than their arguments' addresses, because what they ASK is the whole
+	 * of what they do. __mac_syscall carries the policy's name and the request number: this
+	 * kernel's AMFI stand-in answers only 0x5a and 0x60 and returns ENOPOLICY to anything else
+	 * (bsd/kern/kern_minimac.c), so a daemon refused there is refused in a way nothing in user
+	 * space can see -- and a library of ours cannot watch it either, since the call is made inside
+	 * libsystem and dyld interposing only stands between images. The name matters as much as the
+	 * number: the same call goes to Sandbox as well. And sysctl carries its MIB, which is the only
+	 * thing that says what was asked about.
+	 */
+	char detail[112] = "";
+	size_t done;
+
+	if (systrace_level < 2 && (error == 0 || error == EJUSTRETURN || error == ERESTART)) {
+		return;
+	}
+	if (systrace_name[0] != 0 && strncmp(proc->p_comm, systrace_name, MAXCOMLEN) != 0) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(path_arg0) / sizeof(path_arg0[0]); i++) {
+		if (path_arg0[i] == syscode) {
+			(void)copyinstr((user_addr_t)uthread->uu_arg[0], path, sizeof(path), &done);
+		}
+	}
+	for (unsigned i = 0; i < sizeof(path_arg1) / sizeof(path_arg1[0]); i++) {
+		if (path_arg1[i] == syscode) {
+			(void)copyinstr((user_addr_t)uthread->uu_arg[1], path, sizeof(path), &done);
+		}
+	}
+	path[sizeof(path) - 1] = 0;
+	if (syscode == SYS___mac_syscall) {
+		char policy[32] = "";
+
+		(void)copyinstr((user_addr_t)uthread->uu_arg[0], policy, sizeof(policy), &done);
+		policy[sizeof(policy) - 1] = 0;
+		snprintf(detail, sizeof(detail), " policy \"%s\" request %lld", policy,
+		    (long long)uthread->uu_arg[1]);
+	} else if (syscode == SYS_sysctl) {
+		int mib[6];
+		unsigned count = (unsigned)uthread->uu_arg[1];
+
+		if (count > 6) {
+			count = 6;
+		}
+		if (count > 0 && copyin((user_addr_t)uthread->uu_arg[0], mib, count * sizeof(mib[0])) == 0) {
+			size_t used = (size_t)snprintf(detail, sizeof(detail), " mib");
+
+			for (unsigned i = 0; i < count && used + 12 < sizeof(detail); i++) {
+				used += (size_t)snprintf(detail + used, sizeof(detail) - used, " %d", mib[i]);
+			}
+		}
+	}
+	detail[sizeof(detail) - 1] = 0;
+	printf("systrace: %s[%d] %s(0x%llx, 0x%llx, 0x%llx, 0x%llx)%s%s%s%s = %d\n",
+	    proc->p_comm, proc_getpid(proc), syscallnames[syscode],
+	    (unsigned long long)uthread->uu_arg[0], (unsigned long long)uthread->uu_arg[1],
+	    (unsigned long long)uthread->uu_arg[2], (unsigned long long)uthread->uu_arg[3],
+	    path[0] ? " \"" : "", path, path[0] ? "\"" : "", detail, error);
+}
+
 #if CONFIG_DTRACE
 extern int32_t dtrace_systrace_syscall(struct proc *, void *, int *);
 extern void dtrace_systrace_syscall_return(unsigned short, int, int *);
@@ -181,6 +267,10 @@ unix_syscall(
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
+	if (__improbable(systrace_level != 0)) {
+		systrace_report(proc, syscode, uthread, error);
+	}
+
 #if CONFIG_MACF
 skip_syscall:
 #endif /* CONFIG_MACF */
diff --git a/bsd/dev/hakios_cputop.c b/bsd/dev/hakios_cputop.c
new file mode 100644
index 0000000..d584f43
--- /dev/null
+++ b/bsd/dev/hakios_cputop.c
@@ -0,0 +1,133 @@
+/*
+ * Boot-arg cputop=S: every S seconds, the processes that took the most CPU time since the last time, by name and pid,
+ * and how many processes came and went meanwhile. (dada, g2k34: all eight cores at 98-100 % for the first minute and
+ * more after boot -- the governor's own line says how busy each CPU is, not for whom.)
+ *
+ * A process's time is its task's (recount_task_times: every thread's, the ones that are gone too), taken from each live
+ * process in turn (proc_iterate holds a reference to it meanwhile). A process that came and went between two looks is
+ * not seen, only counted: what each process had at the last look is kept by pid.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc_internal.h>
+#include <kern/recount.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#define CPUTOP_PROCS            640
+#define CPUTOP_SHOWN            12
+
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern task_t proc_task(proc_t);
+
+struct cputop_entry {
+	int             pid;
+	uint64_t        total;          /* user and system, absolute time */
+	uint64_t        took;           /* since the last look */
+	char            name[24];
+};
+
+static struct cputop_entry cputop_was[CPUTOP_PROCS], cputop_now[CPUTOP_PROCS];
+static uint32_t cputop_was_count, cputop_now_count, cputop_new;
+static uint32_t cputop_seconds;
+
+static int
+cputop_one(proc_t p, void *arg __unused)
+{
+	struct cputop_entry *e;
+	struct recount_times_mach times;
+	task_t task = proc_task(p);
+	int pid = proc_pid(p);
+	uint32_t i;
+
+	if (task == TASK_NULL || cputop_now_count >= CPUTOP_PROCS) {
+		return PROC_RETURNED;
+	}
+	times = recount_task_times(task);
+	e = &cputop_now[cputop_now_count++];
+	e->pid = pid;
+	e->total = times.rtm_user + times.rtm_system;
+	e->took = e->total;
+	for (i = 0; i < cputop_was_count; i++) {
+		if (cputop_was[i].pid == pid) {
+			e->took = e->total >= cputop_was[i].total ? e->total - cputop_was[i].total : 0;
+			break;
+		}
+	}
+	if (i == cputop_was_count && cputop_was_count != 0) {
+		cputop_new++;
+	}
+	strlcpy(e->name, proc_best_name(p), sizeof(e->name));
+	return PROC_RETURNED;
+}
+
+static void
+cputop_thread(void *arg __unused, wait_result_t w __unused)
+{
+	for (;;) {
+		uint64_t all = 0, ns;
+		uint32_t gone = 0;
+		char line[640];
+		int at = 0;
+
+		delay_for_interval(cputop_seconds * 1000, NSEC_PER_MSEC);
+		cputop_now_count = 0;
+		cputop_new = 0;
+		proc_iterate(PROC_ALLPROCLIST, cputop_one, NULL, NULL, NULL);
+		for (uint32_t i = 0; i < cputop_was_count; i++) {
+			uint32_t j;
+
+			for (j = 0; j < cputop_now_count && cputop_now[j].pid != cputop_was[i].pid; j++) {
+			}
+			gone += j == cputop_now_count;
+		}
+		for (uint32_t i = 0; i < cputop_now_count; i++) {
+			all += cputop_now[i].took;
+		}
+		/* the CPUTOP_SHOWN that took most, by selection: a few hundred processes */
+		for (uint32_t shown = 0; shown < CPUTOP_SHOWN && shown < cputop_now_count; shown++) {
+			uint32_t best = shown;
+
+			for (uint32_t i = shown + 1; i < cputop_now_count; i++) {
+				if (cputop_now[i].took > cputop_now[best].took) {
+					best = i;
+				}
+			}
+			if (best != shown) {
+				struct cputop_entry t = cputop_now[shown];
+
+				cputop_now[shown] = cputop_now[best];
+				cputop_now[best] = t;
+			}
+			if (cputop_now[shown].took == 0) {
+				break;
+			}
+			absolutetime_to_nanoseconds(cputop_now[shown].took, &ns);
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s[%d] %llu", cputop_now[shown].name,
+			    cputop_now[shown].pid, ns / NSEC_PER_MSEC);
+			if (at >= (int)sizeof(line) - 1) {
+				break;
+			}
+		}
+		absolutetime_to_nanoseconds(all, &ns);
+		redwood_tl("cputop: %u s: %llu ms of CPU in %u processes (%u new, %u gone); most, ms:%s\n", cputop_seconds,
+		    ns / NSEC_PER_MSEC, cputop_now_count, cputop_new, gone, line);
+		bcopy(cputop_now, cputop_was, sizeof(cputop_now[0]) * cputop_now_count);
+		cputop_was_count = cputop_now_count;
+	}
+}
+
+void hakios_cputop_start(void);
+void
+hakios_cputop_start(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("cputop", &cputop_seconds, sizeof(cputop_seconds)) || cputop_seconds == 0) {
+		return;
+	}
+	if (kernel_thread_start(cputop_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_dada_amp.c b/bsd/dev/hakios_dada_amp.c
new file mode 100644
index 0000000..766c998
--- /dev/null
+++ b/bsd/dev/hakios_dada_amp.c
@@ -0,0 +1,248 @@
+/*
+ * The Xiaomi 15's (dada) two speaker amplifiers: Cirrus Logic CS35L43, on the I2C bus "hub 0"
+ * (Android's device tree: qupv3_hub_i2c0 i2c@980000, SDA gpio64 and SCL gpio65; cs35l43@40 "B", the
+ * bottom speaker, reset gpio107, and cs35l43@42 "T", the top one, reset gpio108; their audio comes over
+ * the secondary TDM of the audio DSP's LPASS). The bus is driven by hand (hakios_dada_gauge.c).
+ *
+ * Step 1 of the speakers, with boot-arg dadaamp=1: the two out of reset (high, as Android's pin state
+ * "default" leaves them), and each asked what it is -- its device and revision IDs, registers 0 and 4,
+ * which are 32 bits wide at 32-bit addresses, most significant byte first (Linux: cs35l41 regmap).
+ * Nothing else is written.
+ */
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+#define say(...) redwood_tl("damp: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern bool hakios_dada_i2c_xfer(unsigned sda, unsigned scl, uint8_t address, const uint8_t *w, unsigned wlen, uint8_t *r,
+    unsigned rlen);
+extern void hakios_dada_gpio_out(unsigned pin, bool high);
+
+#define PIN_SDA                 64
+#define PIN_SCL                 65
+
+static const struct {
+	const char *name;
+	uint8_t address;
+	unsigned reset;
+} amps[] = { { "bottom", 0x40, 107 }, { "top", 0x42, 108 } };
+
+/* one of the amplifier's 32-bit registers */
+static bool
+amp_read(uint8_t address, uint32_t reg, uint32_t *value)
+{
+	uint8_t w[4] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg }, r[4];
+
+	if (!hakios_dada_i2c_xfer(PIN_SDA, PIN_SCL, address, w, 4, r, 4)) {
+		return false;
+	}
+	*value = (uint32_t)r[0] << 24 | (uint32_t)r[1] << 16 | (uint32_t)r[2] << 8 | r[3];
+	return true;
+}
+
+void hakios_dada_amp_init(void);
+
+void
+hakios_dada_amp_init(void)
+{
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("dadaamp", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	/* the resets pulsed as a driver's probe does: low, then high */
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		hakios_dada_gpio_out(amps[i].reset, false);
+	}
+	delay_for_interval(2, NSEC_PER_MSEC);
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		hakios_dada_gpio_out(amps[i].reset, true);
+	}
+	delay_for_interval(50, NSEC_PER_MSEC);
+	{
+		extern unsigned hakios_dada_gpio_state(unsigned pin);
+
+		say("the resets: gpio107 %#x, gpio108 %#x; the interrupts: gpio84 %#x, gpio66 %#x (configuration << 4 | level)\n",
+		    hakios_dada_gpio_state(107), hakios_dada_gpio_state(108), hakios_dada_gpio_state(84),
+		    hakios_dada_gpio_state(66));
+	}
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		/* (a woken CS35L4x may NAK the transaction that wakes it) */
+		for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+			(void)hakios_dada_i2c_xfer(PIN_SDA, PIN_SCL, amps[i].address, NULL, 0, NULL, 0);
+		}
+		delay_for_interval(2, NSEC_PER_MSEC);
+	}
+	{
+		/* who answers on the bus at all, and how its lines rest */
+		extern unsigned hakios_dada_i2c_levels(unsigned sda, unsigned scl);
+		char line[200];
+		int at = 0;
+
+		for (unsigned a = 0x08; a < 0x78 && at < (int)sizeof(line) - 6; a++) {
+			if (hakios_dada_i2c_xfer(PIN_SDA, PIN_SCL, (uint8_t)a, NULL, 0, NULL, 0)) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %#x", a);
+			}
+		}
+		line[at] = 0;
+		say("the bus (gpio64/65) rests at SDA/SCL %#x; addresses that answer:%s\n", hakios_dada_i2c_levels(PIN_SDA, PIN_SCL),
+		    at ? line : " none");
+	}
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		uint32_t id = 0, rev = 0;
+		bool ok = amp_read(amps[i].address, 0x0, &id) && amp_read(amps[i].address, 0x4, &rev);
+
+		if (ok) {
+			say("the %s speaker's amplifier (%#x): device %#x, revision %#x\n", amps[i].name, amps[i].address, id, rev);
+		} else {
+			say("the %s speaker's amplifier (%#x) does not answer\n", amps[i].name, amps[i].address);
+		}
+	}
+}
+
+/*
+ * Step 2, for the sound (hakios_dada_audio.c): the amplifiers set up to play 16-bit stereo I2S at 48 kHz from
+ * the secondary MI2S as clock slaves, straight from the serial port to the amplifier -- their own DSP bypassed, so
+ * no firmware of theirs is needed -- the bottom one the left slot, the top one the right. The sequence is UniXNU's
+ * for the same amplifier on SM8650 (ShengCs35l43.c: Cirrus's register errata, the board values Android's device
+ * tree gives: 4 A boost peak, SDOUT high impedance, brownout protection).
+ */
+#define CS35_GLOBAL_ENABLES     0x2014
+#define CS35_BLOCK_ENABLES      0x2018
+#define CS35_BLOCK_ENABLES2     0x201c
+#define CS35_GPIO_PAD_CONTROL   0x242c
+#define CS35_REFCLK_INPUT       0x2c04
+#define CS35_GLOBAL_SAMPLE_RATE 0x2c0c
+#define CS35_FS_MON_0           0x2d10
+#define CS35_BST_IPK_CTL        0x3808
+#define CS35_BST_RSVD_1         0x3850
+#define CS35_ASP_ENABLES1       0x4800
+#define CS35_ASP_CONTROL2       0x4808
+#define CS35_ASP_CONTROL3       0x480c
+#define CS35_ASP_FRAME_CONTROL5 0x4820
+#define CS35_ASP_DATA_CONTROL5  0x4840
+#define CS35_DACPCM1_INPUT      0x4c00
+#define CS35_AMP_CTRL           0x6000
+#define CS35_VPBR_CONFIG        0x6404
+#define CS35_AMP_GAIN           0x6c04
+#define CS35_TST_DAC_MSM_CONFIG 0x7404
+#define CS35_ALIVE_DCIN_WD      0x7424
+#define CS35_IRQ1_EINT_1        0x10010
+#define CS35_IRQ1_EINT_2        0x10014
+#define CS35_IRQ1_MASK_1        0x10110
+#define CS35_IRQ1_MASK_2        0x10114
+#define CS35_IRQ1_MASK_3        0x10118
+#define CS35_TEST_KEY           0x40
+#define CS35_GAIN_DB            18u
+
+static bool
+amp_write(uint8_t address, uint32_t reg, uint32_t value)
+{
+	uint8_t w[8] = { (uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg,
+		         (uint8_t)(value >> 24), (uint8_t)(value >> 16), (uint8_t)(value >> 8), (uint8_t)value };
+
+	return hakios_dada_i2c_xfer(PIN_SDA, PIN_SCL, address, w, 8, NULL, 0);
+}
+
+static bool
+amp_update(uint8_t address, uint32_t reg, uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+
+	if (!amp_read(address, reg, &old)) {
+		return false;
+	}
+	return ((old & ~mask) | (value & mask)) == old || amp_write(address, reg, (old & ~mask) | (value & mask));
+}
+
+static uint32_t amps_ready;     /* bit per amplifier set up */
+
+/* both set up (true if either is); powered down */
+bool hakios_dada_amp_setup(void);
+
+bool
+hakios_dada_amp_setup(void)
+{
+	/* the top amplifier's speaker, not the earpiece (Android's pin state "rcv_gpio_low") */
+	hakios_dada_gpio_out(67, false);
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		uint8_t a = amps[i].address;
+		bool ok = amp_write(a, CS35_TST_DAC_MSM_CONFIG, 0x11330000u) && amp_write(a, CS35_BST_RSVD_1, 0x50000802u) &&
+		    amp_write(a, CS35_IRQ1_MASK_1, 0xffffffffu) && amp_write(a, CS35_IRQ1_MASK_2, 0xffffffffu) &&
+		    amp_write(a, CS35_IRQ1_MASK_3, 0xffffffffu) &&
+		    amp_update(a, CS35_ALIVE_DCIN_WD, 0x7f, 1u << 1 | 1u) &&
+		    amp_update(a, CS35_BST_IPK_CTL, 0x7f, (4000u - 1600u) / 50u + 0x10u) &&
+		    amp_update(a, CS35_ASP_CONTROL3, 0x3, 0x3) &&
+		    amp_update(a, CS35_GPIO_PAD_CONTROL, 0x07000000u, 4u << 24) &&
+		    amp_update(a, CS35_VPBR_CONFIG, 0x00ffff1fu, 5u << 12 | 3u << 8 | 8u) &&
+		    amp_update(a, CS35_BLOCK_ENABLES2, 0x1000, 0x1000) &&
+		    /* the serial port: I2S, clocks from the SoC, 16-bit slots and words, 48 kHz */
+		    amp_update(a, CS35_ASP_CONTROL2, 0xff000000u | 0x700u | 0x40u | 0x10u | 0x4u | 0x1u, 16u << 24 | 2u << 8) &&
+		    amp_update(a, CS35_ASP_DATA_CONTROL5, 0x3f, 16) &&
+		    amp_update(a, CS35_GLOBAL_SAMPLE_RATE, 0x1f, 0x03) &&
+		    /* the PLL locked to the 1.536 MHz bit clock */
+		    amp_update(a, CS35_REFCLK_INPUT, 0x800, 0x800) && amp_update(a, CS35_REFCLK_INPUT, 0x7e0, 0x1bu << 5) &&
+		    amp_update(a, CS35_REFCLK_INPUT, 0x10, 0) && amp_update(a, CS35_REFCLK_INPUT, 0x7, 0) &&
+		    amp_update(a, CS35_REFCLK_INPUT, 0x800, 0) && amp_update(a, CS35_REFCLK_INPUT, 0x10, 0x10) &&
+		    amp_write(a, CS35_FS_MON_0, 71u | 115u << 12) &&
+		    /* the amplifier plays ASP RX1, its slot; gain; 4 ms soft ramp */
+		    amp_update(a, CS35_DACPCM1_INPUT, 0x3f, 0x08) && amp_update(a, CS35_ASP_FRAME_CONTROL5, 0x3f, i) &&
+		    amp_update(a, CS35_AMP_GAIN, 0x3e0, CS35_GAIN_DB << 5) && amp_update(a, CS35_AMP_CTRL, 0x7, 4);
+
+		if (ok) {
+			amps_ready |= 1u << i;
+		}
+		say("the %s speaker's amplifier %s\n", amps[i].name, ok ? "set up" : "could not be set up");
+	}
+	return amps_ready != 0;
+}
+
+void hakios_dada_amp_power(bool on);
+
+void
+hakios_dada_amp_power(bool on)
+{
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		uint8_t a = amps[i].address;
+
+		if (!(amps_ready & (1u << i))) {
+			continue;
+		}
+		if (on) {
+			(void)(amp_update(a, CS35_ASP_ENABLES1, 1u << 16, 1u << 16) && amp_write(a, CS35_TEST_KEY, 0x55) &&
+			    amp_write(a, CS35_TEST_KEY, 0xaa) && amp_write(a, 0x2084, 0x000f1aa0u) && amp_write(a, CS35_TEST_KEY, 0xcc) &&
+			    amp_write(a, CS35_TEST_KEY, 0x33) && amp_write(a, CS35_GLOBAL_ENABLES, 1) &&
+			    amp_update(a, CS35_BLOCK_ENABLES, 1, 1));
+		} else {
+			(void)(amp_update(a, CS35_BLOCK_ENABLES, 1, 0) && amp_write(a, CS35_TEST_KEY, 0x55) &&
+			    amp_write(a, CS35_TEST_KEY, 0xaa) && amp_write(a, 0x2084, 0x000f1aa3u) && amp_write(a, CS35_TEST_KEY, 0xcc) &&
+			    amp_write(a, CS35_TEST_KEY, 0x33));
+			delay_for_interval(2, NSEC_PER_MSEC);
+			(void)(amp_write(a, CS35_GLOBAL_ENABLES, 0) && amp_update(a, CS35_ASP_ENABLES1, 1u << 16, 0));
+		}
+	}
+}
+
+/* the interrupt status of each (EINT1, EINT2), acknowledged; bit 0 of EINT2: PLL locked */
+void hakios_dada_amp_status(const char *when);
+
+void
+hakios_dada_amp_status(const char *when)
+{
+	for (unsigned i = 0; i < sizeof(amps) / sizeof(amps[0]); i++) {
+		uint8_t a = amps[i].address;
+		uint32_t e1 = 0, e2 = 0;
+
+		if (!(amps_ready & (1u << i))) {
+			continue;
+		}
+		(void)(amp_read(a, CS35_IRQ1_EINT_1, &e1) && amp_read(a, CS35_IRQ1_EINT_2, &e2));
+		(void)amp_write(a, CS35_IRQ1_EINT_1, 0xffffffffu);
+		(void)amp_write(a, CS35_IRQ1_EINT_2, 0xffffffffu);
+		say("%s: the %s speaker's amplifier: EINT1 %#x%s, EINT2 %#x (PLL %s)\n", when, amps[i].name, e1,
+		    (e1 & 0x1c400000u) ? " (errors)" : "", e2, (e2 & 1) ? "locked" : (e2 & 8) ? "UNLOCKED" : "-");
+	}
+}
diff --git a/bsd/dev/hakios_dada_audio.c b/bsd/dev/hakios_dada_audio.c
new file mode 100644
index 0000000..dc9d065
--- /dev/null
+++ b/bsd/dev/hakios_dada_audio.c
@@ -0,0 +1,1760 @@
+/*
+ * The Xiaomi 15's (dada) sound: what iOS plays (/dev/redwood-audio, redwood_audio.c) through the audio DSP to the
+ * two speaker amplifiers (hakios_dada_amp.c).
+ *
+ * The path, as UniXNU found it for the same SoC family (UniXNU-sheng, SM8650: ShengAudioReach.c, AudioProbe.cpp,
+ * SmmuBypass.h) and Android's device tree for dada confirms (sec_tdm_pinctrl: gpio121 clock, gpio123 frame,
+ * gpio122 data in, gpio124 data out, "i2s1" functions of the TLMM):
+ *
+ *   our memory  64 KiB below 4 GB (the DSP takes 32-bit addresses; the loader keeps 4 MB there for us: boot-arg
+ *               lowdma=), which the DSP reads as stream 0x1001 of the application processor's SMMU. The
+ *               hypervisor does not let us translate for it, so the stream passes through: the last context
+ *               bank left untranslating (SCTLR 0, CBAR "stage 1 translate, stage 2 bypass") and the stream
+ *               matched to it. Addresses go to the DSP as address | 1 << 32 (the stream's low four bits).
+ *   the DSP     two AudioReach graphs through its graph manager (APM, over GPR, redwood_adsp.c): a device
+ *               subgraph, I2S_SINK on the secondary MI2S, data line 1, the LPASS the clock master (16-bit
+ *               stereo, 48 kHz: a 1.536 MHz bit clock); and a stream subgraph, WR_SHARED_MEM_EP -> PCM_DEC ->
+ *               PCM_CNV -> the sink. Periods of 20 ms are handed to the endpoint one by one
+ *               (DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2); each comes back done.
+ *   the amps    clock slaves on that I2S, the bottom one the left slot, the top one the right; powered while
+ *               there is sound, down after a few seconds of silence.
+ *
+ * Boot-args: dadaaudio=1, a look at the SMMU only (reading); dadaaudio=2, the whole path, a short quiet test tone
+ * (1 kHz, -40 dBFS, half a second) to see the DSP take periods and the amplifiers' PLLs lock, then what iOS plays.
+ * Needs adsp=1 dadaadsp=1 (the DSP up) and the loader's lowdma=.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/conf.h>
+#include <sys/redwood_audio.h>
+#include <sys/uio.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+
+extern bool hakios_rpmh_regulator(const char *name, uint32_t mv, bool enable, uint32_t mode);
+#define say(...) redwood_tl("daudio: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+
+extern bool hakios_adsp_gpr(uint32_t port, uint32_t opcode, const void *payload, uint32_t length, bool with_header, uint32_t ms,
+    uint32_t *answer_opcode, uint32_t *words, uint32_t nwords);
+extern bool hakios_adsp_gpr_raw(const void *packet, uint32_t length, uint32_t ms, uint32_t *answer_opcode, uint32_t *words,
+    uint32_t nwords);
+extern void (*hakios_adsp_gpr_event)(uint32_t opcode, uint32_t token, const uint32_t *words, uint32_t length);
+extern bool hakios_dada_amp_setup(void);
+extern void hakios_dada_amp_power(bool on);
+extern void hakios_dada_amp_status(const char *when);
+
+#define APPS_SMMU_PHYS          0x15000000UL
+#define APPS_SMMU_SIZE          0x100000UL
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_IDR2               0x028
+#define SMMU_CBAR(n)            (0x1000 + 4 * (n))
+#define SMMU_CBA2R(n)           (0x1800 + 4 * (n))
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define AUDIO_STREAM            0x1001u
+#define AUDIO_MASK              0x80u
+
+#define TLMM_PHYS               0x0f100000UL
+
+/* GPR and AudioReach (Linux audioreach.h, q6apm.c) */
+#define GPR_DOMAIN_ADSP         2
+#define GPR_DOMAIN_APPS         3
+#define OUR_PORT                0x2001
+#define APM_IID                 1
+#define APM_CMD_GET_SPF_STATE   0x01001021
+#define APM_CMD_RSP_GET_SPF_STATE 0x02001007
+#define GPR_BASIC_RSP_RESULT    0x02001005
+#define OP_GRAPH_OPEN           0x01001000
+#define OP_GRAPH_PREPARE        0x01001001
+#define OP_GRAPH_START          0x01001002
+#define OP_SET_CFG              0x01001006
+#define OP_MEM_MAP              0x0100100c
+#define OP_MEM_MAP_DONE         0x02001001
+#define OP_WRITE                0x0400100a      /* DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2 */
+#define OP_WRITE_DONE           0x05001004
+#define MOD_WR_SHMEM            0x07001000
+#define MOD_PCM_CNV             0x07001003
+#define MOD_PCM_DEC             0x07001005
+#define MOD_I2S_SINK            0x0700100a
+#define SG_PLAY                 0x4001
+#define SG_SPEAKER              0x4005
+#define IID_PLAY_SHMEM          0x6001
+#define IID_PLAY_DEC            0x6002
+#define IID_PLAY_CNV            0x6003
+#define IID_SPEAKER_I2S         0x6051
+
+#define RATE                    48000
+#define CHANNELS                2
+#define PERIOD_FRAMES           960             /* 20 ms */
+#define PERIOD_BYTES            (PERIOD_FRAMES * CHANNELS * 2)
+#define SLOTS                   8
+#define BUFFER_BYTES            0x10000
+#define CMD_OFFSET              0xc000          /* out-of-band command payloads (after the periods) */
+#define IN_FLIGHT               4               /* 80 ms ahead of the DSP */
+#define RING_FRAMES             (RATE / 2)      /* what iOS has written and the DSP not yet taken: half a second */
+#define QUIET_PERIODS           (5 * RATE / PERIOD_FRAMES)      /* the amplifiers off after 5 s of silence */
+
+static vm_offset_t smmu;
+static uint64_t buffer_pa, dsp_address;
+static volatile uint8_t *buffer;
+static uint32_t map_handle;
+static uint32_t token = 100;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__builtin_arm_dsb(0xf);
+}
+
+/* ---- the SMMU: a look (dadaaudio=1), and the stream passed through ----------------------------------------------- */
+
+static void
+smmu_look(void)
+{
+	uint32_t idr0, idr1, scr0, smrs, banks, page, pages, used = 0;
+	char taken[600];
+	int at = 0;
+
+	scr0 = rd(smmu + SMMU_SCR0);
+	idr0 = rd(smmu + SMMU_IDR0);
+	idr1 = rd(smmu + SMMU_IDR1);
+	smrs = idr0 & 0xff;
+	banks = idr1 & 0xff;
+	page = (idr1 >> 31) ? 0x10000 : 0x1000;
+	pages = 1u << (((idr1 >> 28) & 7) + 1);
+	say("the application processor's SMMU: sCR0 %#x, IDR0 %#x (%u stream matches), IDR1 %#x (%u context banks from %#x), "
+	    "IDR2 %#x\n", scr0, idr0, smrs, idr1, banks, pages * page, rd(smmu + SMMU_IDR2));
+	for (uint32_t n = 0; n < smrs && n < 256; n++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr = rd(smmu + SMMU_S2CR(n));
+
+		if (!(smr & SMMU_SMR_VALID)) {
+			continue;
+		}
+		used++;
+		if (at < (int)sizeof(taken) - 24) {
+			at += snprintf(taken + at, sizeof(taken) - (size_t)at, " %u:%x>%x", n, smr & 0x7fffffff, s2cr);
+		}
+	}
+	taken[at] = 0;
+	say("%u stream matches taken:%s\n", used, taken);
+}
+
+/* stream -> the last context bank, left untranslating (Linux arm-smmu-qcom's bypass quirk; UniXNU SmmuBypass.h) */
+static const char *
+smmu_bypass(uint16_t stream)
+{
+	uint32_t idr0 = rd(smmu + SMMU_IDR0), idr1 = rd(smmu + SMMU_IDR1);
+	uint32_t count = MIN(idr0 & 0xff, 128u), banks = idr1 & 0xff, pages = 1u << (((idr1 >> 28) & 7) + 1);
+	uint32_t bank = banks - 1, slot = ~0u, cb;
+	bool have = false;
+
+	if ((idr1 >> 31) || banks < 2 || pages > 128) {
+		return "an SMMU of another shape";
+	}
+	cb = (pages + bank) * 0x1000;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(i)), s2cr, mask;
+
+		if (!(smr & SMMU_SMR_VALID)) {
+			if (slot == ~0u) {
+				slot = i;
+			}
+			continue;
+		}
+		s2cr = rd(smmu + SMMU_S2CR(i));
+		mask = (smr >> 16) & 0x7fff;
+		if (((smr ^ stream) & 0xffff & ~mask) == 0) {
+			if (((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == bank) {
+				have = true;
+				slot = i;
+				break;
+			}
+			say("stream %#x is matched already (%u: %#x -> %#x)\n", stream, i, smr, s2cr);
+			return "the stream is taken";
+		}
+	}
+	if (rd(smmu + cb) & 1) {
+		return "the last context bank translates";
+	}
+	if (rd(smmu + cb) != 0 || rd(smmu + SMMU_CBAR(bank)) != 0x10000 || rd(smmu + SMMU_CBA2R(bank)) != 1) {
+		wr(smmu + cb, 0);
+		wr(smmu + SMMU_CBA2R(bank), 1);
+		wr(smmu + SMMU_CBAR(bank), 0x10000);
+	}
+	if (rd(smmu + cb) != 0 || rd(smmu + SMMU_CBA2R(bank)) != 1 || rd(smmu + SMMU_CBAR(bank)) != 0x10000) {
+		return "the context bank did not take its settings";
+	}
+	if (slot == ~0u) {
+		return "no free stream match";
+	}
+	if (!have) {
+		wr(smmu + SMMU_S2CR(slot), bank);
+		if (rd(smmu + SMMU_S2CR(slot)) != bank) {
+			return "the stream's S2CR did not take";
+		}
+		wr(smmu + SMMU_SMR(slot), SMMU_SMR_VALID | stream);
+	}
+	if (rd(smmu + SMMU_SMR(slot)) != (SMMU_SMR_VALID | stream) || rd(smmu + SMMU_S2CR(slot)) != bank) {
+		return "the stream's match did not take";
+	}
+	say("stream %#x passes through: stream match %u, context bank %u%s\n", stream, slot, bank, have ? " (as it was)" : "");
+	return NULL;
+}
+
+/* ---- GPR packets (UniXNU ShengAudioReach.c) --------------------------------------------------------------------- */
+
+struct pkt {
+	uint8_t b[1024];
+	uint32_t n;
+};
+
+static void
+put32(struct pkt *p, uint32_t v)
+{
+	if (p->n + 4 <= sizeof(p->b)) {
+		memcpy(p->b + p->n, &v, 4);
+		p->n += 4;
+	}
+}
+
+static void
+put16(struct pkt *p, uint32_t v)
+{
+	if (p->n + 2 <= sizeof(p->b)) {
+		p->b[p->n] = (uint8_t)v;
+		p->b[p->n + 1] = (uint8_t)(v >> 8);
+		p->n += 2;
+	}
+}
+
+static void
+put8(struct pkt *p, uint32_t v)
+{
+	if (p->n < sizeof(p->b)) {
+		p->b[p->n++] = (uint8_t)v;
+	}
+}
+
+static void
+set32(struct pkt *p, uint32_t at, uint32_t v)
+{
+	memcpy(p->b + at, &v, 4);
+}
+
+static void
+pad_to(struct pkt *p, uint32_t end)
+{
+	while (p->n < end && p->n < sizeof(p->b)) {
+		p->b[p->n++] = 0;
+	}
+}
+
+static void
+begin(struct pkt *p, uint32_t src, uint32_t dst, uint32_t opcode)
+{
+	p->n = 0;
+	put32(p, 0);
+	put32(p, GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8);
+	put32(p, src);
+	put32(p, dst);
+	put32(p, ++token);
+	put32(p, opcode);
+}
+
+static uint32_t
+finish(struct pkt *p)
+{
+	set32(p, 0, (6u << 4) | p->n << 8);
+	return p->n;
+}
+
+static uint32_t
+cmd_begin(struct pkt *p)
+{
+	uint32_t at = p->n;
+
+	put32(p, 0);
+	put32(p, 0);
+	put32(p, 0);
+	put32(p, 0);
+	return at;
+}
+
+static void
+cmd_end(struct pkt *p, uint32_t at)
+{
+	set32(p, at + 12, p->n - at - 16);
+}
+
+static uint32_t
+param_begin(struct pkt *p, uint32_t iid, uint32_t id)
+{
+	uint32_t at = p->n;
+
+	put32(p, iid);
+	put32(p, id);
+	put32(p, 0);
+	put32(p, 0);
+	return at;
+}
+
+static void
+param_end(struct pkt *p, uint32_t at)
+{
+	pad_to(p, at + ((p->n - at + 7) & ~7u));
+	set32(p, at + 8, p->n - at - 16);
+}
+
+struct module {
+	uint32_t module, iid, inputs, outputs;
+};
+struct link {
+	uint32_t from, to;
+};
+
+static void graph_open_ex(struct pkt *p, uint32_t sg, uint32_t direction, uint32_t scenario, uint32_t position,
+    const struct module *m, unsigned modules, const struct link *l, unsigned links);
+
+static void
+graph_open(struct pkt *p, uint32_t sg, uint32_t direction, const struct module *m, unsigned modules, const struct link *l,
+    unsigned links)
+{
+	graph_open_ex(p, sg, direction, 1, 1, m, modules, l, links);
+}
+
+static void
+graph_open_ex(struct pkt *p, uint32_t sg, uint32_t direction, uint32_t scenario, uint32_t position, const struct module *m,
+    unsigned modules, const struct link *l, unsigned links)
+{
+	uint32_t cmd, at;
+
+	begin(p, OUR_PORT, APM_IID, OP_GRAPH_OPEN);
+	cmd = cmd_begin(p);
+	at = param_begin(p, APM_IID, 0x08001001);       /* subgraph: low latency, direction, playback */
+	put32(p, 1);
+	put32(p, sg); put32(p, 3);
+	put32(p, 0x0800100e); put32(p, 4); put32(p, 2);
+	put32(p, 0x0800100f); put32(p, 4); put32(p, direction);
+	put32(p, 0x08001010); put32(p, 4); put32(p, scenario);
+	param_end(p, at);
+	at = param_begin(p, APM_IID, 0x08001000);       /* its container: generic, in the stream position, 8 KiB, the ADSP */
+	put32(p, 1);
+	put32(p, sg); put32(p, 4);
+	put32(p, 0x08001011); put32(p, 8); put32(p, 1); put32(p, 0x0b001001);
+	put32(p, 0x08001012); put32(p, 4); put32(p, position);
+	put32(p, 0x08001013); put32(p, 4); put32(p, 8192);
+	put32(p, 0x08001014); put32(p, 4); put32(p, 2);
+	param_end(p, at);
+	at = param_begin(p, APM_IID, 0x08001002);       /* its modules */
+	put32(p, 1);
+	put32(p, sg); put32(p, sg); put32(p, modules);
+	for (unsigned i = 0; i < modules; i++) {
+		put32(p, m[i].module);
+		put32(p, m[i].iid);
+	}
+	param_end(p, at);
+	at = param_begin(p, APM_IID, 0x08001003);       /* their ports */
+	put32(p, modules);
+	for (unsigned i = 0; i < modules; i++) {
+		put32(p, m[i].iid); put32(p, 1); put32(p, 0x08001015); put32(p, 8); put32(p, m[i].inputs); put32(p, m[i].outputs);
+	}
+	param_end(p, at);
+	at = param_begin(p, APM_IID, 0x08001004);       /* their connections: output port 1 to input port 2 */
+	put32(p, links);
+	for (unsigned i = 0; i < links; i++) {
+		put32(p, l[i].from); put32(p, 1); put32(p, l[i].to); put32(p, 2);
+	}
+	param_end(p, at);
+	cmd_end(p, cmd);
+	finish(p);
+}
+
+static void
+pcm_output(struct pkt *p, uint32_t iid, uint32_t interleaving)
+{
+	uint32_t at = param_begin(p, iid, 0x08001008);
+
+	put32(p, 1); put32(p, 0x09001000); put32(p, (16u + CHANNELS + 3u) & ~3u);
+	put16(p, 16); put16(p, 1); put16(p, 16); put16(p, 15); put16(p, 1); put16(p, interleaving); put16(p, 0);
+	put16(p, CHANNELS);
+	put8(p, 1); put8(p, 2);         /* front left, front right */
+	param_end(p, at);
+}
+
+/* A packet sent and its answer waited for: true for a basic result of status 0 (or a map's handle). */
+static bool
+command(struct pkt *p, const char *what)
+{
+	uint32_t opcode = 0, words[4] = { 0 }, sent;
+
+	memcpy(&sent, p->b + 20, 4);
+	/*
+	 * The DSP's receive buffers on this link are 128 bytes: an APM command that does not fit has its payload in
+	 * our mapped memory instead ("out of band": the command header's address, map handle and size), as SPF allows.
+	 */
+	if (p->n > 128) {
+		uint32_t size = p->n - 40, header[4];
+		uint64_t at = dsp_address + CMD_OFFSET;
+
+		if (map_handle == 0 || size > BUFFER_BYTES - CMD_OFFSET) {
+			say("%s: %u bytes, too big for the link and no memory of ours mapped\n", what, p->n);
+			return false;
+		}
+		for (uint32_t i = 0; i < size; i++) {
+			buffer[CMD_OFFSET + i] = p->b[40 + i];
+		}
+		__builtin_arm_dsb(0xf);
+		header[0] = (uint32_t)at;
+		header[1] = (uint32_t)(at >> 32);
+		header[2] = map_handle;
+		header[3] = size;
+		memcpy(p->b + 24, header, sizeof(header));
+		p->n = 40;
+		finish(p);
+	}
+	{
+		uint64_t t0 = mach_absolute_time(), ns;
+		bool answered = hakios_adsp_gpr_raw(p->b, p->n, 2000, &opcode, words, 4);
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (ns > 100 * NSEC_PER_MSEC) {
+			say("%s: the DSP took %llu ms\n", what, ns / NSEC_PER_MSEC);
+		}
+		if (!answered) {
+			say("%s: no answer\n", what);
+			return false;
+		}
+	}
+	if (opcode == OP_MEM_MAP_DONE) {
+		map_handle = words[0];
+		say("%s: handle %#x\n", what, map_handle);
+		return true;
+	}
+	if (opcode != GPR_BASIC_RSP_RESULT || words[0] != sent || words[1] != 0) {
+		say("%s: answer %#x: %#x %#x\n", what, opcode, words[0], words[1]);
+		return false;
+	}
+	return true;
+}
+
+static bool
+graph_command(uint32_t opcode, uint32_t sg, const char *what)
+{
+	struct pkt p;
+	uint32_t cmd, at;
+
+	begin(&p, OUR_PORT, APM_IID, opcode);
+	cmd = cmd_begin(&p);
+	at = param_begin(&p, APM_IID, 0x08001005);
+	put32(&p, 1);
+	put32(&p, sg);
+	param_end(&p, at);
+	cmd_end(&p, cmd);
+	finish(&p);
+	return command(&p, what);
+}
+
+static bool
+graphs_up(void)
+{
+	static const struct module speaker[] = { { MOD_I2S_SINK, IID_SPEAKER_I2S, 1, 0 } };
+	static const struct module play[] = { { MOD_WR_SHMEM, IID_PLAY_SHMEM, 0, 1 }, { MOD_PCM_DEC, IID_PLAY_DEC, 1, 1 },
+		                              { MOD_PCM_CNV, IID_PLAY_CNV, 1, 1 } };
+	static const struct link links[] = { { IID_PLAY_SHMEM, IID_PLAY_DEC }, { IID_PLAY_DEC, IID_PLAY_CNV },
+		                             { IID_PLAY_CNV, IID_SPEAKER_I2S } };
+	struct pkt p;
+	uint32_t cmd, at, body;
+
+	/* the map: the region right after the GPR header, the command header's room at the end (as the DSP's own client) */
+	begin(&p, OUR_PORT, APM_IID, OP_MEM_MAP);
+	put16(&p, 3); put16(&p, 1); put32(&p, 0);
+	put32(&p, (uint32_t)dsp_address); put32(&p, (uint32_t)(dsp_address >> 32)); put32(&p, BUFFER_BYTES);
+	pad_to(&p, p.n + 16);
+	finish(&p);
+	if (!command(&p, "our memory mapped for the DSP")) {
+		return false;
+	}
+	graph_open(&p, SG_SPEAKER, 1, speaker, 1, NULL, 0);
+	if (!command(&p, "the speaker device graph")) {
+		return false;
+	}
+	begin(&p, OUR_PORT, APM_IID, OP_SET_CFG);
+	cmd = cmd_begin(&p);
+	at = param_begin(&p, IID_SPEAKER_I2S, 0x08001019);      /* LPAIF, secondary, data line 1, our frame clock */
+	put32(&p, 0); put32(&p, 1); put16(&p, 2); put16(&p, 1);
+	param_end(&p, at);
+	at = param_begin(&p, IID_SPEAKER_I2S, 0x08001017);      /* 48 kHz, 16 bits, 2 channels, fixed point */
+	put32(&p, RATE); put16(&p, 16); put16(&p, CHANNELS); put32(&p, 1);
+	param_end(&p, at);
+	at = param_begin(&p, IID_SPEAKER_I2S, 0x08001018);      /* frame size factor 1 */
+	put32(&p, 1);
+	param_end(&p, at);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!command(&p, "the I2S sink's configuration")) {
+		return false;
+	}
+	graph_open(&p, SG_PLAY, 2, play, 3, links, 3);
+	if (!command(&p, "the playback stream graph")) {
+		return false;
+	}
+	begin(&p, OUR_PORT, APM_IID, OP_SET_CFG);
+	cmd = cmd_begin(&p);
+	pcm_output(&p, IID_PLAY_DEC, 1);
+	pcm_output(&p, IID_PLAY_CNV, 3);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!command(&p, "the decoder's and converter's formats")) {
+		return false;
+	}
+	begin(&p, OUR_PORT, IID_PLAY_SHMEM, OP_SET_CFG);
+	cmd = cmd_begin(&p);
+	at = param_begin(&p, IID_PLAY_SHMEM, 0x0800100c);
+	body = (12u + 16u + CHANNELS + 7u) & ~7u;
+	put32(&p, 1); put32(&p, 0x09001000); put32(&p, body + 16u - 12u);
+	put32(&p, RATE); put16(&p, 16); put16(&p, 1); put16(&p, 16); put16(&p, 15); put16(&p, 1); put16(&p, CHANNELS);
+	put8(&p, 1); put8(&p, 2);
+	param_end(&p, at);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!command(&p, "the endpoint's media format")) {
+		return false;
+	}
+	return true;
+
+}
+
+/* ---- the periods ----------------------------------------------------------------------------------------------- */
+
+static volatile uint32_t done_count, done_bad, last_bad_status;
+static uint32_t sent_count;
+static int done_event;
+
+static volatile uint32_t mic_done, mic_bytes_last, mic_status_last;
+static int mic_event;
+
+static void
+gpr_event(uint32_t opcode, uint32_t tok, const uint32_t *words, uint32_t length)
+{
+	if (opcode == 0x05001005) {     /* RD_SH_MEM_EP_DATA_BUFFER_DONE_V2: status, address, handle, size, offset */
+		mic_status_last = length >= 4 ? words[0] : 0xffffffffu;
+		mic_bytes_last = length >= 20 ? words[4] : 0;
+		mic_done++;
+		wakeup(&mic_event);
+		return;
+	}
+	if (opcode == OP_WRITE_DONE) {
+		if (length >= 16 && words[3] != 0) {
+			done_bad++;
+			last_bad_status = words[3];
+		}
+		done_count++;
+		wakeup(&done_event);
+	}
+	(void)tok;
+}
+
+static bool
+send_period(uint32_t slot)
+{
+	struct pkt p;
+	uint64_t address = dsp_address + (uint64_t)slot * PERIOD_BYTES;
+
+	__builtin_arm_dsb(0xf);
+	begin(&p, OUR_PORT, IID_PLAY_SHMEM, OP_WRITE);
+	put32(&p, (uint32_t)address); put32(&p, (uint32_t)(address >> 32)); put32(&p, map_handle); put32(&p, PERIOD_BYTES);
+	put32(&p, 0); put32(&p, 0); put32(&p, 0);
+	put32(&p, 0); put32(&p, 0); put32(&p, 0); put32(&p, 0);
+	finish(&p);
+	if (!hakios_adsp_gpr_raw(p.b, p.n, 0, NULL, NULL, 0)) {
+		return false;
+	}
+	sent_count++;
+	return true;
+}
+
+/* what iOS has written, until the DSP takes it */
+static int16_t *ring;
+static uint32_t ring_head, ring_tail;   /* frames, written at head, taken at tail (free running) */
+static LCK_GRP_DECLARE(daudio_group, "dada audio");
+static LCK_SPIN_DECLARE(ring_lock, &daudio_group);
+
+static uint32_t
+sink(const int16_t *frames, uint32_t count)
+{
+	uint32_t taken = 0;
+
+	lck_spin_lock(&ring_lock);
+	while (taken < count && ring_head - ring_tail < RING_FRAMES) {
+		uint32_t at = ring_head % RING_FRAMES;
+
+		ring[2 * at] = frames[2 * taken];
+		ring[2 * at + 1] = frames[2 * taken + 1];
+		ring_head++;
+		taken++;
+	}
+	lck_spin_unlock(&ring_lock);
+	return taken;
+}
+
+/* a period from the ring (silence where it runs short): true if it is not silence */
+static bool
+fill_period(uint32_t slot)
+{
+	volatile int16_t *out = (volatile int16_t *)(buffer + slot * PERIOD_BYTES);
+	bool loud = false;
+
+	lck_spin_lock(&ring_lock);
+	for (uint32_t i = 0; i < PERIOD_FRAMES; i++) {
+		int16_t l = 0, r = 0;
+
+		if (ring_tail != ring_head) {
+			uint32_t at = ring_tail % RING_FRAMES;
+
+			l = ring[2 * at];
+			r = ring[2 * at + 1];
+			ring_tail++;
+		}
+		out[2 * i] = l;
+		out[2 * i + 1] = r;
+		loud |= (l > 8 || l < -8 || r > 8 || r < -8);
+	}
+	lck_spin_unlock(&ring_lock);
+	return loud;
+}
+
+/* a quiet tone: 1 kHz at -40 dBFS (a sixth-order table of one period, 48 samples) */
+static void
+tone_period(uint32_t slot)
+{
+	static const int16_t sine48[48] = {
+		0, 43, 85, 125, 164, 200, 232, 260, 284, 303, 317, 325, 328, 325, 317, 303, 284, 260, 232, 200, 164, 125, 85, 43,
+		0, -43, -85, -125, -164, -200, -232, -260, -284, -303, -317, -325, -328, -325, -317, -303, -284, -260, -232, -200,
+		-164, -125, -85, -43
+	};
+	volatile int16_t *out = (volatile int16_t *)(buffer + slot * PERIOD_BYTES);
+
+	for (uint32_t i = 0; i < PERIOD_FRAMES; i++) {
+		out[2 * i] = sine48[i % 48];
+		out[2 * i + 1] = sine48[i % 48];
+	}
+}
+
+static void
+wait_done(uint32_t ms)
+{
+	(void)tsleep(&done_event, PZERO, "daudio", MAX(1, (int)(ms * hz / 1000)));
+}
+
+static void
+feeder(void)
+{
+	uint32_t next = 0, quiet = QUIET_PERIODS, reported = 0;
+	bool amps_on = false;
+	uint64_t last_report = mach_absolute_time(), now, interval;
+
+	nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &interval);
+	for (;;) {
+		while (sent_count - done_count < IN_FLIGHT) {
+			bool loud = fill_period(next % SLOTS);
+
+			quiet = loud ? 0 : quiet + 1;
+			if (loud && !amps_on) {
+				hakios_dada_amp_power(true);
+				amps_on = true;
+				say("sound: the amplifiers on\n");
+			}
+			if (!send_period(next % SLOTS)) {
+				say("a period could not be sent: the feeder stops\n");
+				return;
+			}
+			next++;
+		}
+		if (amps_on && quiet >= QUIET_PERIODS) {
+			hakios_dada_amp_power(false);
+			amps_on = false;
+			say("silence: the amplifiers off\n");
+		}
+		wait_done(100);
+		now = mach_absolute_time();
+		if (now - last_report > interval && done_count != reported) {
+			say("%u periods played (%u refused, last status %#x)\n", done_count, done_bad, last_bad_status);
+			reported = done_count;
+			last_report = now;
+		}
+	}
+}
+
+/* ---- the whole path -------------------------------------------------------------------------------------------- */
+
+static void
+pins(void)
+{
+	static const unsigned i2s[] = { 121, 122, 123, 124 };
+
+	for (unsigned i = 0; i < sizeof(i2s) / sizeof(i2s[0]); i++) {
+		vm_offset_t cfg = ml_io_map(TLMM_PHYS + 0x1000UL * i2s[i], 0x1000);
+		uint32_t old = rd(cfg);
+
+		/* function 1 (i2s1_*), 8 mA, no pull; the eGPIO pads given to the application processor */
+		wr(cfg, (old & (1u << 11)) | ((old & (1u << 11)) ? 1u << 12 : 0) | 1u << 2 | 3u << 6);
+		say("gpio%u: %#x -> %#x\n", i2s[i], old, rd(cfg));
+	}
+}
+
+static bool
+dsp_ready(void)
+{
+	for (unsigned tries = 0; tries < 180; tries++) {
+		uint32_t opcode = 0, words[2] = { 0 };
+
+		if (hakios_adsp_gpr(APM_IID, APM_CMD_GET_SPF_STATE, NULL, 0, true, 500, &opcode, words, 2) &&
+		    opcode == APM_CMD_RSP_GET_SPF_STATE && words[0] == 1) {
+			say("the DSP's audio framework is ready (after %u tries)\n", tries);
+			return true;
+		}
+		delay_for_interval(1000, NSEC_PER_MSEC);
+	}
+	say("the DSP's audio framework never said it was ready\n");
+	return false;
+}
+
+/* ---- the microphones (boot-arg dadamic=1, after the speaker's test tone) ----------------------------------------------
+ *
+ * dada's microphones are digital (DT dmic01/23/45/67 on the LPASS LPI pins) and go into the VA macro, as on the Xiaomi Pad
+ * 8 Pro (SM8750, mainline: VA DEC0 <- DMIC0, codec DMA VA TX0). Here: the DSP's PRM votes the LPASS macros and the digital
+ * codec and runs the VA core clock; the DMIC0/1 pins (LPI gpio6 clock, gpio7 data, function 1, 8 mA) and the VA macro
+ * (Linux lpass-va-macro.c: MCLK and FS counter, DMIC0 clock /8 of 19.2 MHz = 2.4 MHz, decimator 0 from DMIC0 at 48 kHz,
+ * HPF, +40 dB) are set; two graphs (device: CODEC_DMA_SOURCE on VA TX0; stream: PCM convert, PCM encode, shared memory
+ * read endpoint) run, and two seconds of 20 ms mono periods are read into our memory after the speaker's periods. Said:
+ * how many came back, their level.
+ */
+#define PRM_IID                 2
+#define LPI_TLMM_PHYS           0x07760000UL
+#define VA_MACRO_PHYS           0x07660000UL
+#define SG_MIC                  0x4007
+#define SG_CAPTURE              0x4003
+#define IID_MIC_DMA             0x6070
+#define IID_CAP_CNV             0x6022
+#define IID_CAP_ENC             0x6023
+#define IID_CAP_SHMEM           0x6024
+#define MIC_OFFSET              0x8000
+#define MIC_PERIOD              (PERIOD_FRAMES * 2)     /* mono, 16-bit */
+#define MIC_SLOTS               4
+
+static bool
+prm_request(uint32_t param, const uint32_t *v, unsigned n, const char *what)
+{
+	struct pkt p;
+	uint32_t cmd, at, opcode = 0, words[4] = { 0 };
+
+	begin(&p, PRM_IID, PRM_IID, 0x0100100f);
+	cmd = cmd_begin(&p);
+	at = param_begin(&p, PRM_IID, param);
+	for (unsigned i = 0; i < n; i++) {
+		put32(&p, v[i]);
+	}
+	set32(&p, at + 8, p.n - at - 16);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!hakios_adsp_gpr_raw(p.b, p.n, 2000, &opcode, words, 4)) {
+		say("mic: %s: no answer\n", what);
+		return false;
+	}
+	say("mic: %s: answer %#x %#x %#x\n", what, opcode, words[0], words[1]);
+	return (opcode == 0x02001002 && words[1] == 0) || (opcode == GPR_BASIC_RSP_RESULT && words[1] == 0);
+}
+
+static bool
+mic_read(uint32_t slot)
+{
+	struct pkt p;
+	uint64_t address = dsp_address + MIC_OFFSET + (uint64_t)slot * MIC_PERIOD;
+
+	begin(&p, OUR_PORT, IID_CAP_SHMEM, 0x0400100b);
+	put32(&p, (uint32_t)address); put32(&p, (uint32_t)(address >> 32)); put32(&p, map_handle); put32(&p, MIC_PERIOD);
+	put32(&p, 0); put32(&p, 0); put32(&p, 0); put32(&p, 0);
+	finish(&p);
+	return hakios_adsp_gpr_raw(p.b, p.n, 0, NULL, NULL, 0);
+}
+
+static void
+pcm_output_mono(struct pkt *p, uint32_t iid)
+{
+	uint32_t at = param_begin(p, iid, 0x08001008);
+
+	put32(p, 1); put32(p, 0x09001000); put32(p, (16u + 1u + 3u) & ~3u);
+	put16(p, 16); put16(p, 1); put16(p, 16); put16(p, 15); put16(p, 1); put16(p, 1); put16(p, 0);
+	put16(p, 1);
+	put8(p, 1);
+	param_end(p, at);
+}
+
+/* the capture graphs on a codec DMA interface (lpaif type, index), then each of `count' inputs (select(k)) listened to */
+static vm_offset_t mic_va;
+
+static void
+mic_select_dmic(unsigned k)
+{
+	wr(mic_va + 0x0100, (rd(mic_va + 0x0100) & ~0xf0u) | (k + 1) << 4);    /* decimator 0 from DMIC k */
+}
+
+static bool
+mic_graphs_start(uint32_t type, uint32_t index)
+{
+	static const struct module dev[] = { { 0x07001024, IID_MIC_DMA, 0, 1 } };
+	static const struct module cap[] = { { MOD_PCM_CNV, IID_CAP_CNV, 1, 1 }, { 0x07001004, IID_CAP_ENC, 1, 1 },
+		                             { 0x07001001, IID_CAP_SHMEM, 1, 0 } };
+	static const struct link links[] = { { IID_MIC_DMA, IID_CAP_CNV }, { IID_CAP_CNV, IID_CAP_ENC }, { IID_CAP_ENC, IID_CAP_SHMEM } };
+	struct pkt p;
+	uint32_t cmd, at;
+
+	graph_open_ex(&p, SG_MIC, 1, 2, 4, dev, 1, NULL, 0);
+	if (!command(&p, "mic: the microphone device graph")) {
+		return false;
+	}
+	graph_open_ex(&p, SG_CAPTURE, 1, 2, 4, cap, 3, links, 3);
+	if (!command(&p, "mic: the capture stream graph")) {
+		return false;
+	}
+	begin(&p, OUR_PORT, APM_IID, OP_SET_CFG);
+	cmd = cmd_begin(&p);
+	at = param_begin(&p, IID_MIC_DMA, 0x08001017);           /* hardware endpoint media format */
+	put32(&p, RATE); put16(&p, 16); put16(&p, 1); put32(&p, 1);
+	param_end(&p, at);
+	at = param_begin(&p, IID_MIC_DMA, 0x08001018);           /* frame size factor */
+	put32(&p, 1);
+	param_end(&p, at);
+	at = param_begin(&p, IID_MIC_DMA, 0x08001063);           /* codec DMA: the interface, channel 0 */
+	put32(&p, type); put32(&p, index); put32(&p, 1);
+	param_end(&p, at);
+	at = param_begin(&p, IID_MIC_DMA, 0x08001176);           /* power mode */
+	put32(&p, 0);
+	param_end(&p, at);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!command(&p, "mic: the device graph's configuration")) {
+		return false;
+	}
+	begin(&p, OUR_PORT, APM_IID, OP_SET_CFG);
+	cmd = cmd_begin(&p);
+	pcm_output_mono(&p, IID_CAP_CNV);
+	pcm_output_mono(&p, IID_CAP_ENC);
+	cmd_end(&p, cmd);
+	finish(&p);
+	if (!command(&p, "mic: the capture graph's configuration") ||
+	    !graph_command(OP_GRAPH_PREPARE, SG_MIC, "mic: the device graph prepared") ||
+	    !graph_command(OP_GRAPH_PREPARE, SG_CAPTURE, "mic: the capture graph prepared") ||
+	    !graph_command(OP_GRAPH_START, SG_MIC, "mic: the device graph started") ||
+	    !graph_command(OP_GRAPH_START, SG_CAPTURE, "mic: the capture graph started")) {
+		return false;
+	}
+	return true;
+}
+
+static void
+mic_graphs_stop(void)
+{
+	(void)graph_command(0x01001003, SG_CAPTURE, "mic: the capture graph stopped");
+	(void)graph_command(0x01001003, SG_MIC, "mic: the device graph stopped");
+	/* and closed (APM_CMD_GRAPH_CLOSE), so that the next recording can open them again */
+	(void)graph_command(0x01001004, SG_CAPTURE, "mic: the capture graph closed");
+	(void)graph_command(0x01001004, SG_MIC, "mic: the device graph closed");
+}
+
+static void
+mic_capture(uint32_t type, uint32_t index, void (*select)(unsigned), unsigned count, const char *name)
+{
+	uint32_t ms = 500;
+
+	(void)PE_parse_boot_argn("dadamic_ms", &ms, sizeof(ms));
+	if (!mic_graphs_start(type, index)) {
+		return;
+	}
+	for (unsigned k = 0; k < count; k++) {
+		uint32_t asked = 0, want = RATE * ms / 1000 / PERIOD_FRAMES, peak = 0, nonzero = 0;
+		int32_t lo = 32767, hi = -32768;
+		uint64_t sum = 0, samples = 0, start, ns = 0;
+
+		select(k);
+		delay_for_interval(20, NSEC_PER_MSEC);
+		mic_done = 0;
+		start = mach_absolute_time();
+		while (asked < MIC_SLOTS) {
+			(void)mic_read(asked % MIC_SLOTS);
+			asked++;
+		}
+		while (mic_done < want && ns < (uint64_t)ms * 4 * NSEC_PER_MSEC) {
+			uint32_t seen = mic_done;
+
+			(void)tsleep(&mic_event, PZERO, "dmic", MAX(1, (int)(100 * hz / 1000)));
+			while (seen < mic_done) {
+				const volatile int16_t *x = (const volatile int16_t *)(buffer + MIC_OFFSET + (seen % MIC_SLOTS) * MIC_PERIOD);
+
+				for (uint32_t i = 0; i < PERIOD_FRAMES; i++) {
+					int32_t a = x[i] < 0 ? -x[i] : x[i];
+
+					peak = MAX(peak, (uint32_t)a);
+					lo = MIN(lo, (int32_t)x[i]);
+					hi = MAX(hi, (int32_t)x[i]);
+					sum += (uint64_t)a;
+					nonzero += a != 0;
+				}
+				samples += PERIOD_FRAMES;
+				seen++;
+				if (asked < want) {
+					(void)mic_read(asked % MIC_SLOTS);
+					asked++;
+				}
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		}
+		say("mic: %s%u: %u periods back, peak %u, mean %llu, range %d..%d, non-zero %u of %llu%s\n", name, k + 1, mic_done, peak,
+		    samples ? sum / samples : 0, lo, hi, nonzero, samples, peak > 50 ? " -- it hears" : "");
+		for (unsigned i = 0; i < 6 && mic_done < asked; i++) {
+			(void)tsleep(&mic_event, PZERO, "dmic", MAX(1, (int)(50 * hz / 1000)));
+		}
+	}
+	mic_graphs_stop();
+}
+
+/*
+ * dadamic=2: the phone's real microphones. They are analog, on the WCD9395 codec (DT wcd939x-codec; routing AMIC1..5 with
+ * MIC BIAS1..4), whose ADCs go out over SoundWire to the master in the VA region (0x07630000, the DT's va_swr_master with
+ * wcd939x-tx-slave, mainline sm8750's swr2 "TX") and into the TX macro's decimators, then TX_CODEC_DMA_TX_3. As mainline
+ * Linux has it for sm8750-mtp (lpass-tx-macro.c, soundwire/qcom.c v2.0, wcd939x.c, wcd939x-sdw.c): the codec's TX port 1
+ * (ADC1..4 on channels 1..4) on the master's port 2, lane 2. Here ADC1 alone, its input (AMIC1..5, TX_NEW_CH12_MUX) swept,
+ * all four mic biases on; decimator 0 from SWR_MIC0.
+ * Boot-args: dadamic_lane (2), dadamic_si (1), dadamic_mport (2), dadamic_gain (ADC1 gain 0..20, 10), dadamic_mode (3 normal),
+ * dadamic_rate (WCD TX clock rate field, 0 = 9.6 MHz), dadamic_div2 (0), dadamic_vol (decimator gain in dB, signed, 20).
+ */
+#define TX_MACRO_PHYS           0x06ae0000UL
+#define SWRM_PHYS               0x07630000UL
+#define SWRM_COMP_HW_VERSION    0x0000
+#define SWRM_COMP_CFG           0x0004
+#define SWRM_COMP_STATUS        0x0014
+#define SWRM_LINK_MANAGER_EE    0x0018
+#define SWRM_COMP_PARAMS        0x0100
+#define SWRM_CMD_FIFO_CFG       0x0314
+#define SWRM_ENUMERATOR_CFG     0x0500
+#define SWRM_DEV_ID_1(m)        (0x0530 + 0x8 * (m))
+#define SWRM_DEV_ID_2(m)        (0x0534 + 0x8 * (m))
+#define SWRM_FRAME_CTRL(b)      (0x101c + 0x40 * (b))
+#define SWRM_MCP_CFG            0x1048
+#define SWRM_MCP_STATUS         0x104c
+#define SWRM_SLV_STATUS         0x1090
+#define SWRM_DP_CTRL(n, b)      (0x1024 + 0x100 * (n) + 0x40 * (b))
+#define SWRM_DP_CTRL2(n, b)     (0x1028 + 0x100 * (n) + 0x40 * (b))
+#define SWRM_DP_BLOCK_CTRL1(n)  (0x102c + 0x100 * (n))
+#define SWRM_DP_HCTRL(n, b)     (0x1034 + 0x100 * (n) + 0x40 * (b))
+#define SWRM_INT_STATUS         0x5000
+#define SWRM_INT_CPU_EN         0x5004
+#define SWRM_INT_CLEAR          0x5008
+#define SWRM_WR_CMD             0x5020
+#define SWRM_RD_CMD             0x5024
+#define SWRM_RD_FIFO            0x5040
+#define SWRM_FIFO_STATUS        0x5050
+#define SWRM_CLK_CTRL           0x5060
+#define SWRM_LINK_STATUS        0x5064
+/* the codec's SoundWire registers (SCP, its data port 1) */
+#define SWRS_SCP_CONTROL        0x0044
+#define SWRS_SCP_FRAME_CTRL(b)  (0x0060 + 0x10 * (b))
+#define SWRS_SCP_DIV2(b)        (0x00e0 + 0x10 * (b))
+#define SWRS_DP1_BLOCK_CTRL1    0x0103
+#define SWRS_DP1_CH_EN(b)       (0x0120 + 0x10 * (b))
+#define SWRS_DP1_SAMPLE1(b)     (0x0122 + 0x10 * (b))
+#define SWRS_DP1_SAMPLE2(b)     (0x0123 + 0x10 * (b))
+#define SWRS_DP1_OFFSET1(b)     (0x0124 + 0x10 * (b))
+#define SWRS_DP1_OFFSET2(b)     (0x0125 + 0x10 * (b))
+#define SWRS_DP1_LANE(b)        (0x0128 + 0x10 * (b))
+/* the codec's own (wcd939x.h) */
+#define WCD_ANA_BIAS            0x3001
+#define WCD_ANA_TX_CH1          0x300e
+#define WCD_ANA_TX_CH2          0x300f
+#define WCD_ANA_MICB(n)         ((n) == 1 ? 0x3022 : (n) == 2 ? 0x3023 : (n) == 3 ? 0x3025 : 0x3026)
+#define WCD_MICB_TEST_CTL_1(n)  (0x306b + 3 * ((n) - 1))
+#define WCD_MICB_TEST_CTL_2(n)  (0x306c + 3 * ((n) - 1))
+#define WCD_TX_3_4_TEST_BLK_EN2 0x308f
+#define WCD_TX_NEW_CH12_MUX     0x3127
+#define WCD_FE_ICTRL_STG2MAIN_ULP 0x31df
+#define WCD_FE_ICTRL_STG2CASC_ULP 0x31e1
+#define WCD_CHIP_ID0            0x3401
+#define WCD_SWR_TX_CLK_RATE     0x3405
+#define WCD_CDC_ANA_CLK_CTL     0x3408
+#define WCD_CDC_DIG_CLK_CTL     0x3409
+#define WCD_CDC_TX_ANA_MODE_0_1 0x3410
+#define WCD_CDC_ANA_TX_CLK_CTL  0x3417
+#define WCD_CDC_REQ_CTL         0x3457
+#define WCD_CDC_DMIC_CTL        0x345b
+#define WCD_INTR_LEVEL_0        0x3474
+#define WCD_EFUSE_REG_0         0x34b0
+
+static vm_offset_t swrm, txm;
+static uint8_t swr_wid, swr_rid, wcd_dev;
+static bool swr_broken;
+
+static void
+us_wait(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+swr_write(uint8_t dev, uint16_t reg, uint8_t value)
+{
+	uint8_t id;
+
+	if (dev == 0xf) {
+		id = 0xf;
+	} else {
+		swr_wid = swr_wid < 14 ? swr_wid + 1 : 0;
+		id = swr_wid;
+	}
+	for (int i = 0; i < 40 && ((rd(swrm + SWRM_FIFO_STATUS) >> 8) & 0x1f) >= 8; i++) {
+		us_wait(250);
+	}
+	wr(swrm + SWRM_WR_CMD, reg | (uint32_t)id << 16 | (uint32_t)dev << 20 | (uint32_t)value << 24);
+	us_wait(dev == 0xf ? 10000 : 160);
+}
+
+static bool
+swr_read(uint8_t dev, uint16_t reg, uint8_t *value)
+{
+	uint32_t answer = 0;
+
+	swr_rid = swr_rid < 14 ? swr_rid + 1 : 0;
+	wr(swrm + SWRM_RD_CMD, reg | (uint32_t)swr_rid << 16 | (uint32_t)dev << 20 | 1u << 24);
+	for (int tries = 0; tries < 40; tries++) {
+		us_wait(250);
+		if (((rd(swrm + SWRM_FIFO_STATUS) >> 16) & 0x1f) == 0) {
+			continue;
+		}
+		answer = rd(swrm + SWRM_RD_FIFO);
+		if (((answer >> 8) & 0xf) == swr_rid) {
+			*value = (uint8_t)answer;
+			return true;
+		}
+	}
+	say("mic: SoundWire: device %u register %#x: no answer (fifo status %#x, last %#x, interrupts %#x)\n", dev, reg,
+	    rd(swrm + SWRM_FIFO_STATUS), answer, rd(swrm + SWRM_INT_STATUS));
+	return false;
+}
+
+/* a codec register's bits set, read back */
+static bool
+wcd_bits(uint16_t reg, uint8_t mask, uint8_t value)
+{
+	uint8_t now = 0, back = 0;
+
+	if (swr_broken || !swr_read(wcd_dev, reg, &now)) {
+		swr_broken = true;
+		return false;
+	}
+	swr_write(wcd_dev, reg, (uint8_t)((now & ~mask) | (value & mask)));
+	if (!swr_read(wcd_dev, reg, &back) || (back & mask) != (value & mask)) {
+		say("mic: the codec's %#x <- %#x (mask %#x) but it reads %#x: stopping\n", reg, value, mask, back);
+		swr_broken = true;
+		return false;
+	}
+	return true;
+}
+
+static uint32_t mic_mport = 2, mic_si = 1, mic_lane = 2, mic_div2;
+
+/* the codec's DP1 and the master's port in bank b (channel 1 on, or off) */
+static void
+swr_ports(uint8_t b, bool on)
+{
+	if (mic_div2) {
+		swr_write(0xf, SWRS_SCP_DIV2(b), 1);
+	}
+	swr_write(wcd_dev, SWRS_DP1_SAMPLE1(b), (uint8_t)mic_si);
+	swr_write(wcd_dev, SWRS_DP1_SAMPLE2(b), (uint8_t)(mic_si >> 8));
+	swr_write(wcd_dev, SWRS_DP1_OFFSET1(b), 0);
+	swr_write(wcd_dev, SWRS_DP1_OFFSET2(b), 0);
+	swr_write(wcd_dev, SWRS_DP1_LANE(b), (uint8_t)mic_lane);
+	swr_write(wcd_dev, SWRS_DP1_CH_EN(b), on ? 1 : 0);
+	wr(swrm + SWRM_DP_CTRL(mic_mport, b), (on ? 1u : 0u) << 24 | (mic_si & 0xff));
+	wr(swrm + SWRM_DP_CTRL2(mic_mport, b), mic_lane);
+	wr(swrm + SWRM_DP_HCTRL(mic_mport, b), 0xf0);
+}
+
+static void
+mic_select_amic(unsigned k)
+{
+	/* ADC1's input: AMIC k+1 (TX_NEW_CH12_MUX bits 2:0) */
+	(void)wcd_bits(WCD_TX_NEW_CH12_MUX, 0x07, (uint8_t)(k + 1));
+	delay_for_interval(150, NSEC_PER_MSEC);
+}
+
+static bool
+mic_swr_up(void)
+{
+	vm_offset_t lpi, tlmm, va;
+	uint32_t v[5], gain = 10, mode = 3, rate = 0, vol = 20, hw, cfg, chen = 0;
+	uint8_t id[4] = { 0 }, b, scp = 0;
+	bool ok, linked = false;
+
+	(void)PE_parse_boot_argn("dadamic_lane", &mic_lane, sizeof(mic_lane));
+	(void)PE_parse_boot_argn("dadamic_si", &mic_si, sizeof(mic_si));
+	(void)PE_parse_boot_argn("dadamic_mport", &mic_mport, sizeof(mic_mport));
+	(void)PE_parse_boot_argn("dadamic_div2", &mic_div2, sizeof(mic_div2));
+	(void)PE_parse_boot_argn("dadamic_gain", &gain, sizeof(gain));
+	(void)PE_parse_boot_argn("dadamic_mode", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("dadamic_rate", &rate, sizeof(rate));
+	(void)PE_parse_boot_argn("dadamic_vol", &vol, sizeof(vol));
+	(void)PE_parse_boot_argn("dadamic_chen", &chen, sizeof(chen));
+
+	/* the DSP's votes and clocks: macros, digital codec, the TX core clock (0x30c, the TX macro's and its SoundWire's) and VA's */
+	v[0] = 1;
+	ok = prm_request(0x08001032, v, 1, "the macros vote");
+	v[0] = 2;
+	ok = prm_request(0x08001032, v, 1, "the digital codec vote") && ok;
+	v[0] = 1; v[1] = 0x30c; v[2] = 19200000; v[3] = 1; v[4] = 0;
+	ok = prm_request(0x0800102c, v, 5, "the TX core clock at 19.2 MHz") && ok;
+	v[0] = 1; v[1] = 0x307; v[2] = 19200000; v[3] = 1; v[4] = 0;
+	ok = prm_request(0x0800102c, v, 5, "the VA core clock at 19.2 MHz") && ok;
+	if (!ok) {
+		say("mic: the LPASS clocks are not all given: stopping\n");
+		return false;
+	}
+	/* the codec's supplies (DT/mainline: L15B 1.8 V buck/rxtx/io, L2I 1.2 V px, BOB1 mic bias) */
+	say("mic: supplies: L15B %s, L2I %s, BOB1 %s\n", hakios_rpmh_regulator("ldob15", 1800, true, 7) ? "on" : "NOT VOTED",
+	    hakios_rpmh_regulator("ldoi2", 1200, true, 7) ? "on" : "NOT VOTED",
+	    hakios_rpmh_regulator("bobb1", 0, true, 0) ? "on" : "NOT VOTED");
+	delay_for_interval(5, NSEC_PER_MSEC);
+	/* its reset, gpio101: gpio, 16 mA, output; low 20 us, then high */
+	tlmm = ml_io_map(TLMM_PHYS + 0x1000 * 101, 0x1000);
+	wr(tlmm + 4, 0);
+	wr(tlmm, 7u << 6 | 1u << 9);
+	us_wait(30);
+	wr(tlmm + 4, 2);
+	us_wait(30);
+	say("mic: the codec's reset (gpio101) released: cfg %#x io %#x\n", rd(tlmm), rd(tlmm + 4));
+	/* the master's pins: LPI gpio0 clock (function 1, 2 mA, no pull, slew 1), gpio1/2/14 data (same, keeper) */
+	lpi = ml_io_map(LPI_TLMM_PHYS, 0x10000);
+	{
+		static const unsigned pins[4] = { 0, 1, 2, 14 };
+
+		for (unsigned k = 0; k < 4; k++) {
+			wr(lpi + 0x1000 * pins[k], (k ? 2u : 0u) | 1u << 2 | 1u << 11);
+			wr(lpi + 0x1000 * pins[k] + 4, 0);
+		}
+		say("mic: SoundWire pins: gpio0 %#x gpio1 %#x gpio2 %#x gpio14 %#x\n", rd(lpi), rd(lpi + 0x1000), rd(lpi + 0x2000),
+		    rd(lpi + 0xe000));
+	}
+	/* the VA macro's frame-sync generator (the DT's qcom,fs-gen-sequence), the TX macro's clocks, its SoundWire clock */
+	va = ml_io_map(VA_MACRO_PHYS, 0x1000);
+	wr(va + 0x0000, rd(va + 0x0000) | 1);
+	wr(va + 0x0004, rd(va + 0x0004) | 3);
+	wr(va + 0x0004, (rd(va + 0x0004) & ~3u) | 1);
+	wr(va + 0x0080, rd(va + 0x0080) | 2);
+	wr(va + 0x0008, rd(va + 0x0008) | 2);                   /* (the VA macro's own SoundWire clock too) */
+	wr(va + 0x0008, rd(va + 0x0008) | 1);
+	wr(va + 0x0008, rd(va + 0x0008) & ~2u);
+	say("mic: VA core ID %02x %02x %02x; SWR_MIC_CTL %#x %#x %#x\n", rd(va + 0xc0), rd(va + 0xc4), rd(va + 0xc8), rd(va + 0xd0),
+	    rd(va + 0xd4), rd(va + 0xd8));
+	for (unsigned k = 0; k < 3; k++) {                     /* va_macro_probe() with a SoundWire master: the mics' clocks, divider 1 */
+		wr(va + 0xd0 + 4 * k, (rd(va + 0xd0 + 4 * k) & ~0xeeu) | 0xcc);
+	}
+	txm = ml_io_map(TX_MACRO_PHYS, 0x1000);
+	wr(txm + 0x0090, rd(txm + 0x0090) | 1);                 /* FREQ_MCLK: 9.6 MHz */
+	wr(txm + 0x0000, rd(txm + 0x0000) | 1);                 /* MCLK */
+	wr(txm + 0x0004, rd(txm + 0x0004) | 1);                 /* FS counter */
+	wr(txm + 0x0008, rd(txm + 0x0008) | 2);                 /* SoundWire: reset, clock, reset over */
+	wr(txm + 0x0008, rd(txm + 0x0008) | 1);
+	wr(txm + 0x0008, rd(txm + 0x0008) & ~2u);
+	say("mic: TX macro: mclk %#x fs %#x swr %#x freq %#x; VA: mclk %#x fs %#x top %#x swr %#x\n", rd(txm), rd(txm + 4),
+	    rd(txm + 8), rd(txm + 0x90), rd(va), rd(va + 4), rd(va + 0x80), rd(va + 8));
+	/* the master, as qcom_swrm_init() starts a v2.0 one: frame 50 x 2 (rows index 1, columns index 0) */
+	swrm = ml_io_map(SWRM_PHYS, 0x6000);
+	hw = rd(swrm + SWRM_COMP_HW_VERSION);
+	wr(swrm + SWRM_FRAME_CTRL(0), (rd(swrm + SWRM_FRAME_CTRL(0)) & ~0xffu) | 1u << 3 | 0u);
+	wr(swrm + SWRM_ENUMERATOR_CFG, 1);
+	cfg = (rd(swrm + SWRM_MCP_CFG) & ~0x3e0000u) | 0x1fu << 17;
+	wr(swrm + SWRM_MCP_CFG, cfg);
+	wr(swrm + SWRM_LINK_MANAGER_EE, 1);
+	wr(swrm + SWRM_CLK_CTRL, 1);
+	wr(swrm + SWRM_CMD_FIFO_CFG, 7u | 1u << 31);
+	wr(swrm + SWRM_COMP_CFG, 1);
+	wr(swrm + SWRM_COMP_CFG, 2);
+	wr(swrm + SWRM_INT_CLEAR, 0xffffffff);
+	wr(swrm + SWRM_INT_CPU_EN, 0);                          /* (polled here) */
+	wr(swrm + SWRM_COMP_CFG, 3);
+	for (int i = 0; i < 100 && !linked; i++) {
+		linked = rd(swrm + SWRM_LINK_STATUS) & 1;
+		if (!linked) {
+			us_wait(1000);
+		}
+	}
+	say("mic: the SoundWire master (version %#x, params %#x): link %s (link status %#x, comp status %#x)\n", hw,
+	    rd(swrm + SWRM_COMP_PARAMS), linked ? "UP" : "NOT UP", rd(swrm + SWRM_LINK_STATUS), rd(swrm + SWRM_COMP_STATUS));
+	if (!linked) {
+		return false;
+	}
+	/* the codec's TX device enumerated: ID ...01170223 (the DT's wcd939x-tx-slave 0x0e 0x01170223) */
+	for (int waited = 0; waited < 300 && wcd_dev == 0; waited++) {
+		for (uint8_t d = 1; d <= 11 && wcd_dev == 0; d++) {
+			uint32_t lo = rd(swrm + SWRM_DEV_ID_1(d)), st = (rd(swrm + SWRM_SLV_STATUS) >> (2 * d)) & 3;
+
+			if (lo == 0x01170223 && (st == 1 || st == 2)) {
+				wcd_dev = d;
+				say("mic: the codec's TX device is device %u (ID %#x%08x, status %u) after %d ms\n", d,
+				    rd(swrm + SWRM_DEV_ID_2(d)), lo, st, waited);
+			}
+		}
+		if (wcd_dev == 0) {
+			delay_for_interval(1, NSEC_PER_MSEC);
+		}
+	}
+	if (wcd_dev == 0) {
+		say("mic: the codec did not show up on the bus: slave status %#x, interrupts %#x\n", rd(swrm + SWRM_SLV_STATUS),
+		    rd(swrm + SWRM_INT_STATUS));
+		for (uint8_t d = 0; d <= 11; d++) {
+			if (rd(swrm + SWRM_DEV_ID_1(d)) != 0) {
+				say("mic:   device %u: ID %#x%08x\n", d, rd(swrm + SWRM_DEV_ID_2(d)), rd(swrm + SWRM_DEV_ID_1(d)));
+			}
+		}
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		(void)swr_read(wcd_dev, WCD_CHIP_ID0 + i, &id[i]);
+	}
+	(void)swr_read(wcd_dev, WCD_EFUSE_REG_0, &scp);
+	say("mic: the codec's chip ID %02x %02x %02x %02x, variant %u (WCD9395 is 5)\n", id[0], id[1], id[2], id[3], (scp >> 1) & 0xf);
+	/* wcd939x_bind(): the mic biases' 2750 mV (DT qcom,cdc-micbiasN-mv); wcd939x_io_init(); interrupts as edges */
+	for (unsigned n = 1; n <= 4; n++) {
+		(void)wcd_bits(WCD_ANA_MICB(n), 0x3f, (2750 - 1000) / 50);
+	}
+	(void)wcd_bits(WCD_ANA_BIAS, 0x80, 0x80);
+	(void)wcd_bits(WCD_ANA_BIAS, 0x40, 0x40);
+	delay_for_interval(10, NSEC_PER_MSEC);
+	(void)wcd_bits(WCD_ANA_BIAS, 0x40, 0x00);
+	(void)wcd_bits(WCD_CDC_DMIC_CTL, 0x02, 0x02);
+	(void)wcd_bits(WCD_FE_ICTRL_STG2CASC_ULP, 0xff, 0x14);
+	(void)wcd_bits(WCD_FE_ICTRL_STG2MAIN_ULP, 0x1f, 0x08);
+	for (unsigned n = 1; n <= 4; n++) {
+		(void)wcd_bits(WCD_MICB_TEST_CTL_1(n), 0xe0, 0xe0);
+	}
+	(void)wcd_bits(WCD_TX_3_4_TEST_BLK_EN2, 0x01, 0x00);
+	for (unsigned i = 0; i < 3; i++) {
+		swr_write(wcd_dev, WCD_INTR_LEVEL_0 + i, 0);
+	}
+	/* the mic biases on (wcd939x_micbias_control(MICB_ENABLE)), all four */
+	(void)wcd_bits(WCD_CDC_DIG_CLK_CTL, 0xf0, 0xf0);
+	(void)wcd_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10);
+	(void)wcd_bits(WCD_CDC_ANA_TX_CLK_CTL, 0x01, 0x01);
+	for (unsigned n = 1; n <= 4; n++) {
+		(void)wcd_bits(WCD_MICB_TEST_CTL_2(n), 0x07, 0x01);
+	}
+	for (unsigned n = 1; n <= 4; n++) {
+		(void)wcd_bits(WCD_ANA_MICB(n), 0xc0, 0x40);
+	}
+	delay_for_interval(1, NSEC_PER_MSEC);
+	/* ADC1 (wcd939x_codec_enable_adc(), its gain, wcd939x_tx_swr_ctrl()'s TX clock rate in both banks) */
+	(void)wcd_bits(WCD_ANA_TX_CH1, 0x1f, (uint8_t)gain);
+	(void)wcd_bits(WCD_CDC_ANA_CLK_CTL, 0x08, 0x08);
+	(void)wcd_bits(WCD_CDC_ANA_CLK_CTL, 0x10, 0x10);
+	(void)wcd_bits(WCD_SWR_TX_CLK_RATE, 0xff, (uint8_t)(rate | rate << 4));
+	/* ADC1's request (wcd939x_adc_enable_req()) */
+	(void)wcd_bits(WCD_CDC_REQ_CTL, 0x02, 0x02);
+	(void)wcd_bits(WCD_CDC_REQ_CTL, 0x01, 0x00);
+	(void)wcd_bits(WCD_ANA_TX_CH2, 0x40, 0x40);
+	(void)wcd_bits(WCD_CDC_TX_ANA_MODE_0_1, 0x0f, (uint8_t)mode);
+	(void)wcd_bits(WCD_CDC_DIG_CLK_CTL, 0x10, 0x10);
+	(void)wcd_bits(WCD_ANA_TX_CH2, 0x40, 0x00);
+	if (chen) {                                             /* (a test: the TX channels' enable bits by hand) */
+		(void)wcd_bits(WCD_ANA_TX_CH2, 0x80, 0x80);
+		(void)wcd_bits(0x3011, 0x80, 0x80);
+	}
+	if (swr_broken) {
+		return false;
+	}
+	/* the stream: ports in the bank not in use, frame 50 x 16 there, the banks switched, then the other bank too */
+	b = (rd(swrm + SWRM_MCP_STATUS) & 1) ? 0 : 1;
+	swr_write(wcd_dev, SWRS_DP1_BLOCK_CTRL1, 0);            /* word length 1 */
+	wr(swrm + SWRM_DP_BLOCK_CTRL1(mic_mport), 0);
+	swr_ports(b, true);
+	wr(swrm + SWRM_FRAME_CTRL(b), (rd(swrm + SWRM_FRAME_CTRL(b)) & ~0xffu) | 1u << 3 | 7u);
+	swr_write(0xf, SWRS_SCP_FRAME_CTRL(b), 1u << 3 | 7u);
+	say("mic: banks switched: the master is in bank %u (asked for %u)\n", rd(swrm + SWRM_MCP_STATUS) & 1, b);
+	swr_ports(b ? 0 : 1, true);
+	wr(swrm + SWRM_FRAME_CTRL(b ? 0 : 1), (rd(swrm + SWRM_FRAME_CTRL(b ? 0 : 1)) & ~0xffu) | 1u << 3 | 7u);
+	(void)swr_read(wcd_dev, SWRS_SCP_CONTROL, &scp);
+	{
+		uint8_t ch = 0, si = 0, lane = 0;
+
+		(void)swr_read(wcd_dev, SWRS_DP1_CH_EN(b), &ch);
+		(void)swr_read(wcd_dev, SWRS_DP1_SAMPLE1(b), &si);
+		(void)swr_read(wcd_dev, SWRS_DP1_LANE(b), &lane);
+		say("mic: the codec's DP1 (bank %u): channels %#x, interval %u, lane %u; SCP status %#x; master port %u ctrl %#x lane %#x; "
+		    "interrupts %#x\n", b, ch, si, lane, scp, mic_mport, rd(swrm + SWRM_DP_CTRL(mic_mport, b)),
+		    rd(swrm + SWRM_DP_CTRL2(mic_mport, b)), rd(swrm + SWRM_INT_STATUS));
+	}
+	/* the TX macro's decimator 0 from SWR_MIC0 (an analog mic), 48 kHz; on, muted; high-pass 150 Hz; unmuted */
+	wr(txm + 0x0404, rd(txm + 0x0404) & ~0x87u);            /* not DMIC, mode 0 */
+	wr(txm + 0x0100, (rd(txm + 0x0100) & ~0x0fu) | 1);      /* SMIC MUX0: SWR_MIC0 */
+	wr(txm + 0x0104, (rd(txm + 0x0104) & ~0x03u) | 1);      /* DEC0 MUX: SWR_MIC */
+	wr(txm + 0x0400, (rd(txm + 0x0400) & ~0x0fu) | 4);
+	wr(txm + 0x0400, rd(txm + 0x0400) | 0x10);
+	wr(txm + 0x0400, rd(txm + 0x0400) | 0x20);
+	wr(txm + 0x0404, (rd(txm + 0x0404) & ~0x60u) | 2u << 5);
+	wr(txm + 0x0418, (rd(txm + 0x0418) & ~3u) | 2);
+	wr(txm + 0x0418, (rd(txm + 0x0418) & ~3u) | 1);
+	delay_for_interval(6, NSEC_PER_MSEC);
+	wr(txm + 0x040c, vol);
+	delay_for_interval(100, NSEC_PER_MSEC);
+	wr(txm + 0x0400, rd(txm + 0x0400) & ~0x10u);
+	say("mic: TX decimator 0: mux %#x/%#x ctl %#x cfg0 %#x sec2 %#x vol %#x\n", rd(txm + 0x100), rd(txm + 0x104), rd(txm + 0x400),
+	    rd(txm + 0x404), rd(txm + 0x418), rd(txm + 0x40c));
+	{
+		static const uint16_t regs[] = { 0x3001, 0x300e, 0x300f, 0x3010, 0x3011, 0x3012, 0x3013, 0x3022, 0x3023, 0x3025, 0x3026,
+			                         0x3127, 0x3128, 0x3405, 0x3406, 0x3408, 0x3409, 0x3410, 0x3417, 0x3457, 0x345a, 0x34d0 };
+		char line[300];
+		int n = 0;
+
+		for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+			uint8_t x = 0xee;
+
+			(void)swr_read(wcd_dev, regs[i], &x);
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %04x=%02x", regs[i], x);
+		}
+		say("mic: codec:%s\n", line);
+	}
+	return true;
+}
+
+static void
+mic_swr(void)
+{
+	if (mic_swr_up()) {
+		mic_capture(1, 4, mic_select_amic, 5, "AMIC");
+		say("mic: afterwards: SoundWire interrupts %#x, slave status %#x\n", rd(swrm + SWRM_INT_STATUS), rd(swrm + SWRM_SLV_STATUS));
+	}
+}
+
+/*
+ * dadamic=3: the microphone for iOS. /dev/redwood-mic gives RedwoodAudio.driver's input device "Codec"
+ * (userland/src/audio_plugin.c) what the microphone hears: 16-bit samples, one channel, 48 kHz, as redwood_mic.c gave it on
+ * redwood. The path (mic_swr_up(): the codec, SoundWire, the TX macro) comes up the first time iOS opens the device and stays
+ * up; the DSP's graphs run only while the device is open, so the microphone is listened to only while iOS records. A read
+ * never waits: it gives what has come, keeping the reader about 40 ms behind the DSP; the plug-in makes up the rest with silence.
+ * Boot-arg dadamic_amic=N: which of the codec's analog inputs (1..5) is iOS's microphone (1).
+ */
+#define MRING_FRAMES            16384           /* 341 ms; a power of two */
+#define MRING_KEEP              1920            /* 40 ms behind the DSP */
+#define MRING_MOST              4800            /* more than 100 ms waiting: the oldest is skipped */
+
+static int16_t *mring;
+static volatile uint64_t mring_written;
+static uint64_t mring_read, mring_skipped, mring_dry;
+static bool mring_primed;
+static volatile uint32_t mic_ios_wants;
+
+static int
+mic_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint64_t written = __atomic_load_n(&mring_written, __ATOMIC_ACQUIRE), avail, want;
+	int error = 0;
+
+	if (mring == NULL || uio_resid(uio) < 2) {
+		return 0;
+	}
+	want = (uint64_t)uio_resid(uio) / 2;
+	avail = written - mring_read;
+	if (avail > MRING_MOST) {
+		mring_skipped += avail - MRING_KEEP;
+		mring_read = written - MRING_KEEP;
+		avail = MRING_KEEP;
+	}
+	if (!mring_primed) {
+		if (avail < MRING_KEEP) {
+			return 0;
+		}
+		mring_primed = true;
+	}
+	if (avail < want) {
+		mring_dry++;
+		mring_primed = false;
+	}
+	while (want > 0 && avail > 0 && error == 0) {
+		uint64_t at = mring_read % MRING_FRAMES, n = want < avail ? want : avail;
+
+		n = n < MRING_FRAMES - at ? n : MRING_FRAMES - at;
+		error = uiomove((caddr_t)&mring[at], (int)(n * 2), uio);
+		mring_read += n;
+		want -= n;
+		avail -= n;
+	}
+	return error;
+}
+
+static int
+mic_dev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	mic_ios_wants = 1;
+	wakeup(&mic_ios_wants);
+	return 0;
+}
+
+static int
+mic_dev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	mic_ios_wants = 0;
+	return 0;
+}
+
+static const struct cdevsw mic_cdevsw = {
+	.d_open = mic_dev_open, .d_close = mic_dev_close, .d_read = mic_dev_read, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+mic_ios_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	uint32_t amic = 1, recordings = 0;
+	bool up = false;
+
+	(void)PE_parse_boot_argn("dadamic_amic", &amic, sizeof(amic));
+	for (;;) {
+		uint32_t asked = 0, seen = 0, peak = 0;
+		uint64_t began, ns, frames = 0;
+
+		while (!mic_ios_wants) {
+			(void)tsleep(&mic_ios_wants, PZERO, "micwait", MAX(1, (int)(200 * hz / 1000)));
+		}
+		recordings++;
+		if (!up) {
+			up = mic_swr_up();
+			if (!up) {
+				say("mic: the microphone's path did not come up: iOS hears silence\n");
+				return;
+			}
+			if (amic != 1) {
+				mic_select_amic(amic - 1);
+			}
+			say("mic: the path is up (AMIC%u is iOS's microphone)\n", amic);
+		}
+		began = mach_absolute_time();
+		if (!mic_graphs_start(1, 4)) {
+			say("mic: iOS records (%u), but the DSP's graphs did not start\n", recordings);
+			delay_for_interval(1000, NSEC_PER_MSEC);
+			continue;
+		}
+		mring_primed = false;
+		mring_skipped = mring_dry = 0;
+		mring_read = __atomic_load_n(&mring_written, __ATOMIC_ACQUIRE);
+		mic_done = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		say("mic: iOS records (%u): the graphs started in %llu ms\n", recordings, ns / NSEC_PER_MSEC);
+		began = mach_absolute_time();
+		while (asked < MIC_SLOTS) {
+			(void)mic_read(asked % MIC_SLOTS);
+			asked++;
+		}
+		while (mic_ios_wants) {
+			(void)tsleep(&mic_event, PZERO, "micios", MAX(1, (int)(100 * hz / 1000)));
+			while (seen < mic_done) {
+				const volatile int16_t *x = (const volatile int16_t *)(buffer + MIC_OFFSET + (seen % MIC_SLOTS) * MIC_PERIOD);
+				uint64_t at = mring_written;
+
+				for (uint32_t i = 0; i < PERIOD_FRAMES; i++) {
+					int32_t a = x[i] < 0 ? -x[i] : x[i];
+
+					peak = MAX(peak, (uint32_t)a);
+					mring[(at + i) % MRING_FRAMES] = x[i];
+				}
+				__atomic_store_n(&mring_written, at + PERIOD_FRAMES, __ATOMIC_RELEASE);
+				frames += PERIOD_FRAMES;
+				(void)mic_read(seen % MIC_SLOTS);
+				seen++;
+			}
+		}
+		for (unsigned i = 0; i < 6 && mic_done < seen + MIC_SLOTS; i++) {
+			(void)tsleep(&mic_event, PZERO, "micios", MAX(1, (int)(50 * hz / 1000)));
+		}
+		mic_graphs_stop();
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		say("mic: iOS stopped recording (%u) after %llu ms: %llu ms heard, peak %u; %llu frames skipped, %llu reads short\n", recordings,
+		    ns / NSEC_PER_MSEC, frames * 1000 / RATE, peak, mring_skipped, mring_dry);
+	}
+}
+
+/* dadamic_selftest=N: as if iOS recorded twice for N seconds (the device opened and closed), what came read as the plug-in would */
+static void
+mic_selftest_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	uint32_t secs = 3;
+
+	(void)PE_parse_boot_argn("dadamic_selftest", &secs, sizeof(secs));
+	for (unsigned round = 1; round <= 2; round++) {
+		uint64_t got = 0, start, ns = 0;
+		int16_t chunk[480];
+		uint32_t peak = 0;
+
+		delay_for_interval(2000, NSEC_PER_MSEC);
+		start = mach_absolute_time();
+		(void)mic_dev_open(0, 0, 0, NULL);
+		while (ns < (uint64_t)secs * NSEC_PER_SEC) {
+			uio_t uio;
+
+			delay_for_interval(10, NSEC_PER_MSEC);
+			uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+			if (uio == NULL) {
+				break;
+			}
+			uio_addiov(uio, (user_addr_t)(uintptr_t)chunk, sizeof(chunk));
+			(void)mic_dev_read(0, uio, 0);
+			for (user_ssize_t i = 0; i < ((user_ssize_t)sizeof(chunk) - uio_resid(uio)) / 2; i++) {
+				peak = MAX(peak, (uint32_t)(chunk[i] < 0 ? -chunk[i] : chunk[i]));
+			}
+			got += (uint64_t)((user_ssize_t)sizeof(chunk) - uio_resid(uio)) / 2;
+			uio_free(uio);
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		}
+		(void)mic_dev_close(0, 0, 0, NULL);
+		say("mic: self-test round %u: %llu frames read in %u s (%llu%%), peak %u\n", round, got, secs,
+		    got * 100 / ((uint64_t)secs * RATE), peak);
+	}
+}
+
+static void
+mic_for_ios(void)
+{
+	int major = cdevsw_add(-1, &mic_cdevsw);
+	thread_t thread;
+
+	mring = kalloc_data(MRING_FRAMES * sizeof(int16_t), Z_WAITOK | Z_ZERO);
+	if (mring == NULL || major < 0 ||
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-mic") == NULL) {
+		say("mic: /dev/redwood-mic cannot be made\n");
+		return;
+	}
+	if (kernel_thread_start(mic_ios_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		say("mic: /dev/redwood-mic is iOS's microphone: it listens only while iOS records\n");
+	}
+	if (PE_parse_boot_argn("dadamic_selftest", &major, sizeof(major)) &&
+	    kernel_thread_start(mic_selftest_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static void
+mic_test(void)
+{
+	vm_offset_t lpi, va;
+	uint32_t v[5], mclk = 0, div_index;
+	bool ok;
+
+	/* the DSP's votes: LPASS macros (1), digital codec (2), then the VA core clock (0x307) */
+	v[0] = 1;
+	ok = prm_request(0x08001032, v, 1, "the macros vote");
+	v[0] = 2;
+	ok = prm_request(0x08001032, v, 1, "the digital codec vote") && ok;
+	if (!ok) {
+		say("mic: no PRM votes: the LPASS registers stay unclocked, stopping\n");
+		return;
+	}
+	for (unsigned i = 0; i < 2 && mclk == 0; i++) {
+		v[0] = 1; v[1] = 0x307; v[2] = i == 0 ? 19200000 : 9600000; v[3] = 1; v[4] = 0;
+		if (prm_request(0x0800102c, v, 5, i == 0 ? "the VA core clock at 19.2 MHz" : "the VA core clock at 9.6 MHz")) {
+			mclk = v[2];
+		}
+	}
+	if (mclk == 0) {
+		say("mic: no VA core clock\n");
+		return;
+	}
+	/* the pins: gpio6 DMIC0/1 clock (function 1, 8 mA, output), gpio7 its data (function 1, 8 mA) */
+	lpi = ml_io_map(LPI_TLMM_PHYS, 0x17000);
+	{
+		/* all four pairs (clock, data): DMIC0/1 gpio6/7, DMIC2/3 gpio8/9, DMIC4/5 gpio12/13, DMIC6/7 gpio17/18 */
+		static const uint32_t pairs[4][2] = { { 6, 7 }, { 8, 9 }, { 12, 13 }, { 17, 18 } };
+
+		for (unsigned k = 0; k < 4; k++) {
+			wr(lpi + 0x1000 * pairs[k][0], 1u << 2 | 3u << 6 | 1u << 9);
+			wr(lpi + 0x1000 * pairs[k][0] + 4, 2);
+			wr(lpi + 0x1000 * pairs[k][1], 1u << 2 | 3u << 6);
+		}
+		say("mic: pins: gpio6 %#x gpio7 %#x gpio8 %#x gpio12 %#x gpio17 %#x\n", rd(lpi + 0x6000), rd(lpi + 0x7000),
+		    rd(lpi + 0x8000), rd(lpi + 0xc000), rd(lpi + 0x11000));
+	}
+	/* the VA macro */
+	va = ml_io_map(VA_MACRO_PHYS, 0x1000);
+	mic_va = va;
+	wr(va + 0x0000, rd(va + 0x0000) | 1);                   /* MCLK */
+	wr(va + 0x0004, rd(va + 0x0004) | 3);                   /* FS counter on, cleared */
+	wr(va + 0x0004, (rd(va + 0x0004) & ~2u) | 1);
+	wr(va + 0x0080, rd(va + 0x0080) | 2);                   /* FS broadcast */
+	wr(va + 0x0094, rd(va + 0x0094) & ~0x80u);              /* DMICs out of reset (DMIC_CFG bit 7, set at reset) */
+	div_index = mclk == 19200000 ? 4 : 2;                   /* divide by 8 or 4: 2.4 MHz */
+	for (unsigned k = 0; k < 4; k++) {                     /* the DMIC clocks of all four pairs (0x84 .. 0x90) */
+		wr(va + 0x0084 + 4 * k, (rd(va + 0x0084 + 4 * k) & ~0xfu) | div_index << 1 | 1);
+	}
+	wr(va + 0x0100, (rd(va + 0x0100) & ~0xf0u) | 1u << 4);  /* decimator 0 from DMIC0 */
+	wr(va + 0x0104, rd(va + 0x0104) & ~1u);                 /* ... a VA DMIC, not SoundWire */
+	wr(va + 0x0404, rd(va + 0x0404) | 0x80);                /* TX0: DMIC */
+	wr(va + 0x0400, (rd(va + 0x0400) & ~0xfu) | 4);         /* 48 kHz */
+	wr(va + 0x0400, rd(va + 0x0400) | 1u << 5);             /* TX0 clock */
+	wr(va + 0x0418, rd(va + 0x0418) & ~1u);                 /* HPF zero gate */
+	delay_for_interval(1, NSEC_PER_MSEC);
+	wr(va + 0x0404, (rd(va + 0x0404) & ~0x60u) | 2u << 5);  /* HPF 150 Hz */
+	wr(va + 0x0418, rd(va + 0x0418) | 2);
+	delay_for_interval(1, NSEC_PER_MSEC);
+	wr(va + 0x0418, rd(va + 0x0418) & ~2u);
+	delay_for_interval(1, NSEC_PER_MSEC);
+	wr(va + 0x0418, rd(va + 0x0418) | 1);                   /* no gate */
+	delay_for_interval(6, NSEC_PER_MSEC);
+	wr(va + 0x040c, 40);                                    /* +40 dB */
+	say("mic: VA macro: dmic_cfg %#x mclk %#x fs %#x top %#x dmic0 %#x mux %#x/%#x tx0 ctl %#x cfg0 %#x sec2 %#x vol %#x\n",
+	    rd(va + 0x94), rd(va + 0), rd(va + 4), rd(va + 0x80), rd(va + 0x84), rd(va + 0x100), rd(va + 0x104), rd(va + 0x400), rd(va + 0x404),
+	    rd(va + 0x418), rd(va + 0x40c));
+	mic_capture(3, 1, mic_select_dmic, 8, "DMIC");
+}
+
+static void
+audio_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	const char *e;
+
+	hakios_adsp_gpr_event = gpr_event;
+	if (!dsp_ready()) {
+		return;
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		static const uint16_t streams[] = { 0x1001, 0x1081, 0x1061 };
+
+		if ((e = smmu_bypass(streams[i])) != NULL) {
+			say("stream %#x: %s\n", streams[i], e);
+			if (i == 0) {
+				return;
+			}
+		}
+	}
+	pins();
+	if (!hakios_dada_amp_setup()) {
+		say("no amplifier: no sound\n");
+		return;
+	}
+	if (!graphs_up()) {
+		return;
+	}
+	/* prepared and started device first, then the stream */
+	if (!graph_command(OP_GRAPH_PREPARE, SG_SPEAKER, "the device graph prepared") ||
+	    !graph_command(OP_GRAPH_PREPARE, SG_PLAY, "the stream graph prepared") ||
+	    !graph_command(OP_GRAPH_START, SG_SPEAKER, "the device graph started") ||
+	    !graph_command(OP_GRAPH_START, SG_PLAY, "the stream graph started")) {
+		return;
+	}
+	say("the graphs run\n");
+	hakios_dada_amp_status("before");
+	hakios_dada_amp_power(true);
+	{
+		uint32_t next = 0, periods = RATE / 2 / PERIOD_FRAMES;
+		uint64_t start = mach_absolute_time(), end, ns;
+
+		while (next < periods) {
+			while (next < periods && sent_count - done_count < IN_FLIGHT) {
+				tone_period(next % SLOTS);
+				if (!send_period(next % SLOTS)) {
+					say("the test tone: a period could not be sent\n");
+					return;
+				}
+				next++;
+			}
+			wait_done(200);
+			if (done_count == 0 && mach_absolute_time() - start > 0) {
+				absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+				if (ns > 2 * NSEC_PER_SEC) {
+					break;
+				}
+			}
+		}
+		for (unsigned i = 0; i < 20 && done_count < sent_count; i++) {
+			wait_done(100);
+		}
+		end = mach_absolute_time();
+		absolutetime_to_nanoseconds(end - start, &ns);
+		say("the test tone: %u periods sent, %u done (%u refused, status %#x) in %llu ms (%llu ms of sound)\n", sent_count,
+		    done_count, done_bad, last_bad_status, ns / NSEC_PER_MSEC, (uint64_t)done_count * PERIOD_FRAMES * 1000 / RATE);
+	}
+	hakios_dada_amp_status("with the tone");
+	hakios_dada_amp_power(false);
+	if (done_count == 0) {
+		say("the DSP took no period: what iOS plays does not go to it\n");
+		return;
+	}
+	{
+		uint32_t mic = 0;
+
+		if (PE_parse_boot_argn("dadamic", &mic, sizeof(mic)) && mic) {
+			if (mic == 3) {
+				mic_for_ios();
+			} else if (mic == 2) {
+				mic_swr();
+			} else {
+				mic_test();
+			}
+		}
+	}
+	ring = (int16_t *)kalloc_data(RING_FRAMES * CHANNELS * 2, Z_WAITOK | Z_ZERO);
+	if (ring == NULL) {
+		return;
+	}
+	redwood_audio_set_sink("the speakers (the audio DSP, dada)", sink);
+	feeder();
+}
+
+void hakios_dada_audio_init(void);
+
+void
+hakios_dada_audio_init(void)
+{
+	uint32_t on = 0;
+	uint64_t low = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("dadaaudio", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	smmu = ml_io_map(APPS_SMMU_PHYS, APPS_SMMU_SIZE);
+	smmu_look();
+	if (on < 2) {
+		return;
+	}
+	if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || low == 0 || (low & 0xfff) || low + BUFFER_BYTES > 0x100000000ULL) {
+		say("no memory below 4 GB from the loader (lowdma=): no sound\n");
+		return;
+	}
+	buffer_pa = low;
+	dsp_address = low | 1ull << 32;
+	buffer = (volatile uint8_t *)ml_io_map_wcomb(low, BUFFER_BYTES);
+	for (uint32_t i = 0; i < BUFFER_BYTES; i += 4) {
+		*(volatile uint32_t *)(buffer + i) = 0;
+	}
+	say("our memory for the DSP: %#llx (the DSP's %#llx)\n", buffer_pa, dsp_address);
+	if (kernel_thread_start(audio_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_dada_btsk.c b/bsd/dev/hakios_dada_btsk.c
new file mode 100644
index 0000000..f7ea75d
--- /dev/null
+++ b/bsd/dev/hakios_dada_btsk.c
@@ -0,0 +1,271 @@
+/*
+ * dada: the Skywalk side of iOS 26's Bluetooth UART, com.apple.uart.sk.bluetooth.
+ *
+ * bluetoothd's serial driver ("POSIX", transport H4) connects the kernel control of that name (hakios_dada_wifi.c
+ * bt_kctl_*), sets the line through socket options, reads a 16-byte nexus UUID from option 0x40105412 and opens a
+ * Skywalk channel on it (os_channel_create): the H4 stream then goes through that channel's rings. This is that nexus:
+ * a kernel pipe (like bsd/skywalk/nexus/kpipe/nx_kpipe_loopback.c) whose TX ring empties into the chip's UART and whose
+ * RX ring fills from what the chip said (the UART pump's ring, hakios_bt_take).
+ */
+#include <skywalk/os_skywalk_private.h>
+#include <skywalk/nexus/kpipe/nx_kernel_pipe.h>
+
+extern void hakios_bt_put(const uint8_t *p, uint32_t n);     /* to the chip (hakios_dada_wifi.c) */
+extern uint32_t hakios_bt_take(uint8_t *p, uint32_t most);   /* from the chip, what is waiting */
+
+void hakios_btsk_start(void);
+bool hakios_btsk_uuid(uint8_t uuid[16]);
+void hakios_btsk_kick(void);
+
+static uuid_t btsk_dom_uuid, btsk_prov_uuid, btsk_nx_uuid;
+static nexus_controller_t btsk_ncd;
+static kern_pbufpool_t btsk_rx_pp;
+static kern_channel_ring_t btsk_txring, btsk_rxring;
+static uint64_t btsk_bufsz;
+static volatile int btsk_up;
+static uint32_t btsk_said;
+
+#define SAY(...) do { if (btsk_said++ < 40) printf("btsk: " __VA_ARGS__); } while (0)
+
+static errno_t
+btsk_dom_init(kern_nexus_domain_provider_t domprov __unused)
+{
+	return 0;
+}
+
+static void
+btsk_dom_fini(kern_nexus_domain_provider_t domprov __unused)
+{
+}
+
+static errno_t
+btsk_pre_connect(kern_nexus_provider_t nxprov __unused, proc_t p __unused, kern_nexus_t nexus,
+    nexus_port_t port, kern_channel_t channel __unused, void **ch_ctx)
+{
+	kern_pbufpool_t tx_pp = NULL;
+	errno_t error = kern_nexus_get_pbufpool(nexus, &tx_pp, &btsk_rx_pp);
+
+	*ch_ctx = NULL;
+	SAY("bluetoothd opens a channel (port %u): pools %d\n", port, error);
+	return error;
+}
+
+static errno_t
+btsk_connected(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_t channel __unused)
+{
+	btsk_up = 1;
+	SAY("the channel is connected: the H4 stream runs through it\n");
+	return 0;
+}
+
+static void
+btsk_pre_disconnect(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_t channel __unused)
+{
+	btsk_up = 0;
+}
+
+static void
+btsk_disconnected(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_t channel __unused)
+{
+	btsk_up = 0;
+	btsk_rx_pp = NULL;
+	SAY("the channel is closed\n");
+}
+
+static errno_t
+btsk_ring_init(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_t channel __unused,
+    kern_channel_ring_t ring, boolean_t is_tx_ring, void **ring_ctx)
+{
+	if (is_tx_ring) {
+		btsk_txring = ring;
+	} else {
+		btsk_rxring = ring;
+	}
+	*ring_ctx = NULL;
+	return 0;
+}
+
+static void
+btsk_ring_fini(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_ring_t ring)
+{
+	if (ring == btsk_txring) {
+		btsk_txring = NULL;
+	} else if (ring == btsk_rxring) {
+		btsk_rxring = NULL;
+	}
+}
+
+static errno_t
+btsk_slot_init(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_ring_t ring __unused,
+    channel_slot_t slot __unused, uint32_t slot_id __unused, struct kern_slot_prop **slot_prop_addr, void **pslot_ctx)
+{
+	*slot_prop_addr = NULL;
+	*pslot_ctx = NULL;
+	return 0;
+}
+
+static void
+btsk_slot_fini(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_ring_t ring __unused,
+    channel_slot_t slot __unused, uint32_t slot_id __unused)
+{
+}
+
+/* bluetoothd sent: each TX slot's bytes to the chip, the slots handed back */
+static errno_t
+btsk_sync_tx(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_ring_t ring,
+    uint32_t flags __unused)
+{
+	kern_channel_slot_t ts, last = NULL;
+	uint32_t slots = 0;
+
+	for (ts = kern_channel_get_next_slot(ring, NULL, NULL); ts != NULL; ts = kern_channel_get_next_slot(ring, ts, NULL)) {
+		kern_packet_t ph = kern_channel_slot_get_packet(ring, ts);
+		kern_buflet_t buf = ph != 0 ? kern_packet_get_next_buflet(ph, NULL) : NULL;
+
+		if (buf != NULL) {
+			uint8_t *base = kern_buflet_get_data_address(buf);
+			uint32_t len = kern_buflet_get_data_length(buf), off = kern_buflet_get_data_offset(buf);
+
+			if (base != NULL && len != 0) {
+				hakios_bt_put(base + off, len);
+			}
+		}
+		last = ts;
+		slots++;
+	}
+	if (last != NULL) {
+		kern_channel_advance_slot(ring, last);
+	}
+	return 0;
+}
+
+/* bluetoothd reads: what the chip said, in fresh packets on the RX slots */
+static errno_t
+btsk_sync_rx(kern_nexus_provider_t nxprov __unused, kern_nexus_t nexus __unused, kern_channel_ring_t ring,
+    uint32_t flags __unused)
+{
+	kern_channel_slot_t rs, last = NULL;
+
+	(void)kern_channel_reclaim(ring);
+	if (btsk_rx_pp == NULL) {
+		return 0;
+	}
+	for (rs = kern_channel_get_next_slot(ring, NULL, NULL); rs != NULL; rs = kern_channel_get_next_slot(ring, rs, NULL)) {
+		kern_packet_t ph = 0;
+		kern_buflet_t buf;
+		uint8_t *base;
+		uint32_t n, room;
+
+		if (kern_pbufpool_alloc_nosleep(btsk_rx_pp, 1, &ph) != 0 || ph == 0) {
+			break;
+		}
+		buf = kern_packet_get_next_buflet(ph, NULL);
+		base = buf != NULL ? kern_buflet_get_data_address(buf) : NULL;
+		room = (uint32_t)MIN(btsk_bufsz, 1024ull);
+		n = base != NULL ? hakios_bt_take(base, room) : 0;
+		if (n == 0) {
+			kern_pbufpool_free(btsk_rx_pp, ph);
+			break;
+		}
+		(void)kern_buflet_set_data_offset(buf, 0);
+		(void)kern_buflet_set_data_length(buf, (uint16_t)n);
+		(void)kern_packet_finalize(ph);
+		if (kern_channel_slot_attach_packet(ring, rs, ph) != 0) {
+			kern_pbufpool_free(btsk_rx_pp, ph);
+			break;
+		}
+		last = rs;
+	}
+	if (last != NULL) {
+		kern_channel_advance_slot(ring, last);
+	}
+	return 0;
+}
+
+/* the chip said something: wake bluetoothd's RX side (it syncs, btsk_sync_rx fills) */
+void
+hakios_btsk_kick(void)
+{
+	kern_channel_ring_t ring = btsk_rxring;
+
+	if (btsk_up && ring != NULL) {
+		kern_channel_notify(ring, 0);
+	}
+}
+
+bool
+hakios_btsk_uuid(uint8_t uuid[16])
+{
+	if (uuid_is_null(btsk_nx_uuid)) {
+		return false;
+	}
+	memcpy(uuid, btsk_nx_uuid, 16);
+	return true;
+}
+
+void
+hakios_btsk_start(void)
+{
+	nexus_attr_t nxa = NULL;
+	errno_t error;
+	uuid_string_t text;
+
+	struct kern_nexus_domain_provider_init dom_init = {
+		.nxdpi_version = KERN_NEXUS_DOMAIN_PROVIDER_CURRENT_VERSION,
+		.nxdpi_flags = 0,
+		.nxdpi_init = btsk_dom_init,
+		.nxdpi_fini = btsk_dom_fini,
+	};
+	struct kern_nexus_provider_init prov_init = {
+		.nxpi_version = KERN_NEXUS_DOMAIN_PROVIDER_CURRENT_VERSION,
+		.nxpi_flags = NXPIF_VIRTUAL_DEVICE,
+		.nxpi_pre_connect = btsk_pre_connect,
+		.nxpi_connected = btsk_connected,
+		.nxpi_pre_disconnect = btsk_pre_disconnect,
+		.nxpi_disconnected = btsk_disconnected,
+		.nxpi_ring_init = btsk_ring_init,
+		.nxpi_ring_fini = btsk_ring_fini,
+		.nxpi_slot_init = btsk_slot_init,
+		.nxpi_slot_fini = btsk_slot_fini,
+		.nxpi_sync_tx = btsk_sync_tx,
+		.nxpi_sync_rx = btsk_sync_rx,
+		.nxpi_tx_doorbell = NULL,
+	};
+	struct kern_nexus_init nx_init = {
+		.nxi_version = KERN_NEXUS_CURRENT_VERSION,
+		.nxi_flags = 0,
+		.nxi_tx_pbufpool = NULL,
+		.nxi_rx_pbufpool = NULL,
+	};
+
+	if (!uuid_is_null(btsk_nx_uuid)) {
+		return;
+	}
+	error = kern_nexus_register_domain_provider(NEXUS_TYPE_KERNEL_PIPE, (const uint8_t *)"com.apple.uart.sk.bluetooth",
+	    &dom_init, sizeof(dom_init), &btsk_dom_uuid);
+	if (error == 0) {
+		error = kern_nexus_controller_create(&btsk_ncd);
+	}
+	if (error == 0) {
+		error = kern_nexus_attr_create(&nxa);
+	}
+	if (error == 0) {
+		error = kern_nexus_attr_set(nxa, NEXUS_ATTR_ANONYMOUS, 1);
+	}
+	if (error == 0) {
+		error = kern_nexus_controller_register_provider(btsk_ncd, btsk_dom_uuid,
+		    (const uint8_t *)"com.apple.nexus.uart.sk.bluetooth", &prov_init, sizeof(prov_init), nxa, &btsk_prov_uuid);
+	}
+	if (error == 0) {
+		(void)kern_nexus_controller_read_provider_attr(btsk_ncd, btsk_prov_uuid, nxa);
+		(void)kern_nexus_attr_get(nxa, NEXUS_ATTR_SLOT_BUF_SIZE, &btsk_bufsz);
+		error = kern_nexus_controller_alloc_provider_instance(btsk_ncd, btsk_prov_uuid, NULL, NULL, &btsk_nx_uuid,
+		    &nx_init);
+	}
+	if (nxa != NULL) {
+		kern_nexus_attr_destroy(nxa);
+	}
+	uuid_unparse_upper(btsk_nx_uuid, text);
+	printf("btsk: the Bluetooth UART's nexus: %s (error %d), buffers of %llu bytes\n", error == 0 ? text : "NONE", error,
+	    btsk_bufsz);
+}
diff --git a/bsd/dev/hakios_dada_camera.c b/bsd/dev/hakios_dada_camera.c
new file mode 100644
index 0000000..397f4cf
--- /dev/null
+++ b/bsd/dev/hakios_dada_camera.c
@@ -0,0 +1,431 @@
+/*
+ * The Xiaomi 15's (dada) cameras, first steps. Boot-arg dadacam=1: the wide camera's sensor (OmniVision OVX9100,
+ * Android's camera 0, DT qcom,cam-sensor0) powered up as its module file says, its chip ID read, powered down again.
+ * Numbers from ~/hakios-gpu2/patches/camera-dada/bringup-spec.md (DT, mainline sm8750, the vendor module files):
+ *
+ *   I2C         CCI 0 master 1 pins, gpio115 data, gpio116 clock -- driven here by hand as plain GPIOs (as
+ *               redwood_camera.c does), so that neither the camera's power domain nor the CCI's clocks are needed
+ *   address     0x10; chip ID: 16-bit register 0x300a = 0x5650
+ *   MCLK        MCLK1 of the camera's MCLK clock controller (cambistmclkcc, 0x01760000): RCG +0x401c, branch +0x4034,
+ *               19.2 MHz straight from the crystal; pin gpio90, function 1
+ *   reset       gpio6, high = running
+ *   supplies    BOB2 (bobb2), VANA 2.9 V a fixed regulator gpio127 switches, VIO 1.8 V (ldob10), VDIG 1.2 V (ldoi1)
+ *   power-up    reset low; BOB2, 2 ms; VANA; VIO, 1 ms; VDIG, 1 ms; MCLK, 1 ms; reset high, 5 ms
+ *   power-down  MCLK off, 1 ms; reset low, 1 ms; VDIG, VIO, VANA off
+ *
+ * Boot-arg dadacam_keep=1 leaves the sensor powered (for the next steps).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern bool hakios_rpmh_regulator(const char *name, uint32_t mv, bool enable, uint32_t mode);
+extern bool hakios_rpmh_level(const char *name, uint32_t level);
+
+#define say(...) redwood_tl("dcam: " __VA_ARGS__)
+
+#define TLMM_PHYS               0x0f100000UL
+#define MCLKCC_PHYS             0x01760000UL
+#define GCC_PHYS                0x00100000UL
+#define MCLK1_CMD               0x401c
+#define MCLK1_CFG               0x4020
+#define MCLK1_CBCR              0x4034
+
+#define PIN_SDA                 115
+#define PIN_SCL                 116
+#define PIN_MCLK                90
+#define PIN_RESET               6
+#define PIN_VANA                127
+#define SENSOR_ADDR             0x10
+#define CHIP_ID_REG             0x300a
+#define CHIP_ID                 0x5650
+
+#define CFG_PULL_UP             3u
+#define CFG_FUNC(f)             ((uint32_t)(f) << 2)
+#define CFG_DRIVE(ma)           ((uint32_t)((ma) / 2 - 1) << 6)
+#define CFG_OUTPUT              (1u << 9)
+
+static vm_offset_t pin_page[180];
+static uint32_t egpio_take = 1, skip, hwctl_off;     /* boot-args dadacam_egpio (1), dadacam_skip (1: no BOB2) */
+static vm_offset_t mclkcc;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+us(uint32_t n)
+{
+	delay_for_interval(n, NSEC_PER_USEC);
+}
+
+static vm_offset_t
+pin(unsigned n)
+{
+	if (pin_page[n] == 0) {
+		pin_page[n] = ml_io_map(TLMM_PHYS + 0x1000 * n, 0x1000);
+	}
+	return pin_page[n];
+}
+
+/* a pin's configuration; an eGPIO pad (bit 11) also needs bit 12 for the APPS to own it */
+static void
+pin_cfg(unsigned n, uint32_t cfg)
+{
+	uint32_t now = rd(pin(n));
+
+	if (now & (1u << 11)) {
+		cfg |= 1u << 11 | (egpio_take ? 1u << 12 : (now & (1u << 12)));
+	}
+	wr(pin(n), cfg);
+}
+
+static void
+pin_out(unsigned n, bool high)
+{
+	wr(pin(n) + 4, high ? 2 : 0);
+	pin_cfg(n, CFG_DRIVE(2) | CFG_OUTPUT);
+}
+
+/* ---- I2C by hand: an output low or let go (pulled up) ---- */
+
+static void
+half_bit(void)
+{
+	us(5);
+}
+
+static void
+line(unsigned n, bool high)
+{
+	wr(pin(n) + 4, 0);
+	pin_cfg(n, CFG_PULL_UP | CFG_DRIVE(2) | (high ? 0 : CFG_OUTPUT));
+}
+
+static bool
+level(unsigned n)
+{
+	return rd(pin(n) + 4) & 1;
+}
+
+static void
+i2c_start(void)
+{
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, false);
+	half_bit();
+}
+
+static void
+i2c_stop(void)
+{
+	line(PIN_SDA, false);
+	half_bit();
+	line(PIN_SCL, true);
+	half_bit();
+	line(PIN_SDA, true);
+	half_bit();
+}
+
+static bool
+i2c_bit(bool out)
+{
+	bool in;
+
+	line(PIN_SDA, out);
+	half_bit();
+	line(PIN_SCL, true);
+	for (unsigned stretched = 0; !level(PIN_SCL) && stretched < 100; stretched++) {
+		half_bit();
+	}
+	half_bit();
+	in = level(PIN_SDA);
+	line(PIN_SCL, false);
+	return in;
+}
+
+static bool
+i2c_write(uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit((byte >> bit) & 1);
+	}
+	return !i2c_bit(true);
+}
+
+static uint8_t
+i2c_read(bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(true));
+	}
+	i2c_bit(!more);
+	return byte;
+}
+
+/* a 16-bit register at a 16-bit address: false if nobody acknowledged (which byte is said) */
+static bool
+sensor_read16(uint8_t addr, uint16_t reg, uint16_t *value)
+{
+	const char *failed = NULL;
+	uint8_t hi, lo;
+
+	i2c_start();
+	if (!i2c_write((uint8_t)(addr << 1))) {
+		failed = "its address";
+	} else if (!i2c_write((uint8_t)(reg >> 8)) || !i2c_write((uint8_t)reg)) {
+		failed = "the register's address";
+	}
+	if (failed == NULL) {
+		i2c_start();
+		if (!i2c_write((uint8_t)(addr << 1 | 1))) {
+			failed = "its address (read)";
+		}
+	}
+	if (failed != NULL) {
+		i2c_stop();
+		say("0x%02x: no acknowledgement of %s\n", addr, failed);
+		return false;
+	}
+	hi = i2c_read(true);
+	lo = i2c_read(false);
+	i2c_stop();
+	*value = (uint16_t)(hi << 8 | lo);
+	return true;
+}
+
+/* ---- the sensor's power ---- */
+
+/* GCC's always-on branches for the camera (gcc-sm8750.c keeps them on): the MCLK controller's AHB, camera AHB and XO */
+static void
+gcc_camera_branches(void)
+{
+	static const uint32_t branches[] = { 0xa0004, 0x26004, 0x26034 };
+	vm_offset_t gcc = ml_io_map(GCC_PHYS, 0x200000);
+
+	for (unsigned i = 0; i < 3; i++) {
+		uint32_t before = rd(gcc + branches[i]);
+
+		wr(gcc + branches[i], (before | 1) & ~(hwctl_off ? 2u : 0u));     /* dadacam_hwctl=0: hardware gating off too */
+		for (int t = 0; t < 100 && (rd(gcc + branches[i]) & (1u << 31)); t++) {
+			us(10);
+		}
+		say("GCC branch %#x: %#x -> %#x\n", branches[i], before, rd(gcc + branches[i]));
+	}
+}
+
+static bool
+mclk(bool on)
+{
+	if (mclkcc == 0) {
+		mclkcc = ml_io_map(MCLKCC_PHYS, 0x10000);
+	}
+	if (!on) {
+		wr(mclkcc + MCLK1_CBCR, rd(mclkcc + MCLK1_CBCR) & ~1u);
+		wr(mclkcc + MCLK1_CMD, rd(mclkcc + MCLK1_CMD) & ~2u);
+		pin_out(PIN_MCLK, false);
+		return true;
+	}
+	wr(mclkcc + 0x40f8, rd(mclkcc + 0x40f8) | 1);   /* the controller's always-on sleep clock (critical in mainline) */
+	/*
+	 * Two registers of the controller's that neither mainline nor our earlier dumps (0x4000..0x40ff) covered: Android has
+	 * 0x4100 = 0xf and 0x410c = 0x3 while its camera runs (regmap dump, 31 Oct) -- by the look of them the MCLK outputs'
+	 * enables. Here: as Android's.
+	 */
+	say("MCLK controller before: 0x4100 %#x 0x410c %#x\n", rd(mclkcc + 0x4100), rd(mclkcc + 0x410c));
+	wr(mclkcc + 0x4100, 0xf);
+	wr(mclkcc + 0x410c, 0x3);
+	wr(mclkcc + MCLK1_CMD, rd(mclkcc + MCLK1_CMD) | 2);     /* the root forced on */
+	wr(mclkcc + MCLK1_CFG, 0x100001);               /* the crystal, divided by 1 (bit 20 kept, as Android has it: 0x00100001) */
+	wr(mclkcc + MCLK1_CMD, rd(mclkcc + MCLK1_CMD) | 1);
+	for (int i = 0; i < 100 && (rd(mclkcc + MCLK1_CMD) & 1); i++) {
+		us(10);
+	}
+	wr(mclkcc + MCLK1_CBCR, rd(mclkcc + MCLK1_CBCR) | 1);
+	for (int i = 0; i < 100 && (rd(mclkcc + MCLK1_CBCR) & (1u << 31)); i++) {
+		us(10);
+	}
+	pin_cfg(PIN_MCLK, CFG_FUNC(1) | CFG_DRIVE(2));
+	{
+		unsigned ones = 0;
+
+		for (unsigned i = 0; i < 1000; i++) {
+			ones += rd(pin(PIN_MCLK) + 4) & 1;
+		}
+		say("MCLK1 at gpio90: %u of 1000 samples high (%s)\n", ones, ones > 0 && ones < 1000 ? "it toggles" : "STILL");
+	}
+	{
+		char line[400];
+		int n = 0;
+
+		for (uint32_t off = 0x4000; off < 0x4100 && n < (int)sizeof(line) - 20; off += 4) {
+			uint32_t v = rd(mclkcc + off);
+
+			if (v != 0) {
+				n += snprintf(line + n, sizeof(line) - (size_t)n, " %x=%x", off, v);
+			}
+		}
+		say("MCLK controller 0x4000..:%s\n", line);
+		n = 0;
+		for (uint32_t off = 0x0; off < 0x60 && n < (int)sizeof(line) - 20; off += 4) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %x", rd(mclkcc + off));
+		}
+		say("MCLK controller PLL0 0x0..:%s; 0x5000.. %x %x %x %x\n", line, rd(mclkcc + 0x5000), rd(mclkcc + 0x5004),
+		    rd(mclkcc + 0x5008), rd(mclkcc + 0x500c));
+	}
+	{
+		/* (a test: MCLK0's branch too, from its own RCG at the crystal) */
+		wr(mclkcc + 0x4000, rd(mclkcc + 0x4000) | 2);
+		wr(mclkcc + 0x4004, 0x100001);
+		wr(mclkcc + 0x4000, rd(mclkcc + 0x4000) | 1);
+		us(100);
+		wr(mclkcc + 0x4018, rd(mclkcc + 0x4018) | 1);
+		us(100);
+		say("MCLK0 (a test): cmd %#x cfg %#x branch %#x\n", rd(mclkcc + 0x4000), rd(mclkcc + 0x4004), rd(mclkcc + 0x4018));
+	}
+	say("MCLK1: cmd %#x cfg %#x branch %#x (%s); pin %#x\n", rd(mclkcc + MCLK1_CMD), rd(mclkcc + MCLK1_CFG),
+	    rd(mclkcc + MCLK1_CBCR), (rd(mclkcc + MCLK1_CBCR) & (1u << 31)) ? "STILL OFF" : "running", rd(pin(PIN_MCLK)));
+	return !(rd(mclkcc + MCLK1_CBCR) & (1u << 31));
+}
+
+static void
+power_down(void)
+{
+	(void)mclk(false);
+	us(1000);
+	pin_out(PIN_RESET, false);
+	us(1000);
+	(void)hakios_rpmh_regulator("ldoi1", 0, false, 0);
+	(void)hakios_rpmh_regulator("ldob10", 0, false, 0);
+	pin_out(PIN_VANA, false);
+	say("the wide sensor powered down\n");
+}
+
+static void
+camera_thread(void *arg __unused, wait_result_t w __unused)
+{
+	uint32_t keep = 0;
+	uint16_t id = 0;
+	bool ok;
+
+	(void)PE_parse_boot_argn("dadacam_keep", &keep, sizeof(keep));
+	(void)PE_parse_boot_argn("dadacam_egpio", &egpio_take, sizeof(egpio_take));
+	(void)PE_parse_boot_argn("dadacam_skip", &skip, sizeof(skip));
+	(void)PE_parse_boot_argn("dadacam_hwctl_off", &hwctl_off, sizeof(hwctl_off));
+	{
+		uint32_t wait_s = 40;           /* after the other drivers' start (an RPMh vote at ~23 s, with the GPU's start, ended the system) */
+
+		(void)PE_parse_boot_argn("dadacam_delay", &wait_s, sizeof(wait_s));
+		delay_for_interval(wait_s * 1000, NSEC_PER_MSEC);
+	}
+	say("the wide sensor (OVX9100): pins as found: sda %#x/%#x scl %#x/%#x mclk %#x reset %#x/%#x vana %#x/%#x\n",
+	    rd(pin(PIN_SDA)), rd(pin(PIN_SDA) + 4), rd(pin(PIN_SCL)), rd(pin(PIN_SCL) + 4), rd(pin(PIN_MCLK)), rd(pin(PIN_RESET)),
+	    rd(pin(PIN_RESET) + 4), rd(pin(PIN_VANA)), rd(pin(PIN_VANA) + 4));
+	pin_out(PIN_RESET, false);
+	say("step: reset low (%#x/%#x)\n", rd(pin(PIN_RESET)), rd(pin(PIN_RESET) + 4));
+	us(50000);
+	say("step: 50 ms later, still here\n");
+	ok = (skip & 1) ? true : hakios_rpmh_regulator("bobb2", 0, true, 0);
+	us(2000);
+	say("step: BOB2 %s\n", ok ? "on" : "NOT VOTED");
+	pin_out(PIN_VANA, true);
+	say("step: VANA (gpio127 %#x/%#x)\n", rd(pin(PIN_VANA)), rd(pin(PIN_VANA) + 4));
+	ok = hakios_rpmh_regulator("ldob10", 1800, true, 7) && ok;
+	us(1000);
+	ok = hakios_rpmh_regulator("ldoi1", 1200, true, 7) && ok;
+	us(1000);
+	say("supplies: %s\n", ok ? "BOB2, VANA, VIO, VDIG on" : "NOT ALL VOTED");
+	{
+		uint32_t mmcx = 128;
+
+		(void)PE_parse_boot_argn("dadacam_mmcx", &mmcx, sizeof(mmcx));
+		say("MMCX at %u: %s\n", mmcx, hakios_rpmh_level("mmcx.lvl", mmcx) ? "voted" : "NOT VOTED");
+		if (PE_parse_boot_argn("dadacam_mx", &mmcx, sizeof(mmcx)) && mmcx != 0) {
+			say("MX at %u: %s\n", mmcx, hakios_rpmh_level("mx.lvl", mmcx) ? "voted" : "NOT VOTED");
+		}
+	}
+	{
+		/*
+		 * The MCLK controller's crystal: Android's clock tree has it as xo_board -> xo_pad -> bi_tcxo, and bi_tcxo is an RPMh
+		 * clock (clk-rpmh ARC "xo.lvl", level 3 = on) that its users vote for. Without the vote no MCLK branch ever ran.
+		 */
+		extern bool hakios_rpmh_write(const char *name, uint32_t value);
+
+		say("XO for the camera (xo.lvl 3): %s\n", hakios_rpmh_write("xo.lvl", 3) ? "voted" : "NOT VOTED");
+	}
+	gcc_camera_branches();
+	{
+		/*
+		 * The camera's top power domain (camcc titan_top_gdsc, GDSCR 0x1134c; spec: clear bit 0, wait for CFG_GDSCR 0x11350
+		 * bit 16 POWER_ON): with Android's camera running the whole camcc is up; our MCLK branches never ran without it.
+		 * Boot-arg dadacam_titan=0: not.
+		 */
+		uint32_t titan = 1;
+
+		(void)PE_parse_boot_argn("dadacam_titan", &titan, sizeof(titan));
+		if (titan) {
+			vm_offset_t camcc = ml_io_map(0x0ade0000UL, 0x20000);
+			uint32_t before = rd(camcc + 0x1134c);
+
+			wr(camcc + 0x1134c, before & ~1u);
+			for (int i = 0; i < 200 && !(rd(camcc + 0x11350) & (1u << 16)); i++) {
+				us(10);
+			}
+			say("titan_top_gdsc: %#x -> %#x, cfg %#x (%s)\n", before, rd(camcc + 0x1134c), rd(camcc + 0x11350),
+			    (rd(camcc + 0x11350) & (1u << 16)) ? "ON" : "NOT ON");
+		}
+	}
+	ok = mclk(true) && ok;
+	us(1000);
+	pin_out(PIN_RESET, true);
+	us(5000);
+	line(PIN_SDA, true);
+	line(PIN_SCL, true);
+	half_bit();
+	say("the bus at rest: sda %u scl %u\n", level(PIN_SDA), level(PIN_SCL));
+	if (sensor_read16(SENSOR_ADDR, CHIP_ID_REG, &id)) {
+		say("the wide sensor's chip ID: %#06x (%s)\n", id, id == CHIP_ID ? "an OVX9100, AS EXPECTED" : "not what was expected");
+	}
+	/* the bus's pins back to CCI's function */
+	pin_cfg(PIN_SDA, CFG_FUNC(1) | CFG_DRIVE(2));
+	pin_cfg(PIN_SCL, CFG_FUNC(1) | CFG_DRIVE(2));
+	if (!keep) {
+		power_down();
+	}
+}
+
+void hakios_dada_camera_init(void);
+
+void
+hakios_dada_camera_init(void)
+{
+	uint32_t level = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("dadacam", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	if (kernel_thread_start(camera_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_dada_cpu.c b/bsd/dev/hakios_dada_cpu.c
new file mode 100644
index 0000000..b6922dc
--- /dev/null
+++ b/bsd/dev/hakios_dada_cpu.c
@@ -0,0 +1,935 @@
+/*
+ * The Xiaomi 15's (dada, SM8750) CPU clocks. The CPUCP firmware sets them; Android asks it over SCMI (Arm's System
+ * Control and Management Interface, performance protocol 0x13) on the "cpucp" mailbox: dada's device tree
+ * qcom,scmi (mboxes cpucp channel 0 to send), the request area cpu_scp_lpri at 0x17b4e000 (arm,scmi-shmem), the
+ * doorbell in cpucp's "tx" registers at 0x17830000 (Linux qcom-cpucp-mbox.c: 0x100 + channel * 8). Nobody asks
+ * when this kernel runs, so the cores stay at whatever the boot loader left them at.
+ *
+ * Done as Data A Live does it for SM8850 (ShueiTsuki/data-a-live wsl/pandora_cpu.c, the same firmware family):
+ *   dadacpu=1  a look: the protocol, its domains, their levels and limits, the level now, and each domain's clock
+ *              as measured on its first running CPU (a chain of dependent adds)
+ *   dadacpu=2  ... and every domain set to its sustained level (the highest that is not a boost level), measured
+ *              again: the system's speed until there is a governor
+ *   dadacpu=3  ... and the governor (governor_thread below): each domain follows its busiest CPU, the 3D core
+ *              follows its own work, and both are held down when the SoC is hot
+ *   dadamemlat=1  (with any of these, or alone) CPUCP's own memory governor configured from dada's tree and started
+ *              before the governor: DDR, LLCC and DDR's QoS level follow the CPUs (memlat_start below); off by default
+ */
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+#define say(...) redwood_tl("dcpu: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern processor_t thread_bind(processor_t processor);
+extern processor_t cpu_to_processor(int cpu);
+extern unsigned int ml_get_cpu_count(void);
+extern wait_result_t thread_block(thread_continue_t continuation);
+
+#define CPUCP_TX_PHYS           0x17830000UL
+#define SCMI_SHMEM_PHYS         0x17b4e000UL
+#define SCMI_PERF               0x13u
+#define SCMI_QCOM               0x80u           /* Qualcomm's generic vendor protocol: dt qcom,scmi protocol@80 */
+
+static vm_offset_t mbox, shmem;
+static uint32_t token;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/*
+ * one SCMI command to protocol proto, polled (shared memory: status +4, flags +0x10, length +0x14, header +0x18,
+ * payload +0x1c). Every protocol shares the one channel (dt: protocol@80 has no shmem or mboxes of its own), and
+ * only cpu_thread -- which becomes the governor -- ever calls this, so commands never overlap.
+ */
+static int
+scmi(uint32_t proto, uint32_t msg, const uint32_t *in, uint32_t nin, uint32_t *out, uint32_t maxout, uint32_t *nout)
+{
+	uint64_t deadline;
+	uint32_t t, len, words;
+
+	*nout = 0;
+	clock_interval_to_deadline(30, NSEC_PER_MSEC, &deadline);
+	while (!(rd(shmem + 4) & 1)) {
+		if (mach_absolute_time() > deadline) {
+			return -1;
+		}
+	}
+	t = (++token) & 0x3ff;
+	wr(shmem + 4, 0);
+	wr(shmem + 0x10, 0);
+	wr(shmem + 0x14, 4 + nin * 4);
+	wr(shmem + 0x18, (msg & 0xff) | (proto & 0xff) << 10 | t << 18);
+	for (uint32_t i = 0; i < nin; i++) {
+		wr(shmem + 0x1c + i * 4, in[i]);
+	}
+	__builtin_arm_dsb(0xf);
+	wr(mbox + 0x100 + 4, t | 1);
+	wr(mbox + 0x100, t | 1);
+	clock_interval_to_deadline(50, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		uint32_t st = rd(shmem + 4);
+
+		if ((st & 3) && ((rd(shmem + 0x18) >> 18) & 0x3ff) == t) {
+			if (st & 2) {
+				return -3;
+			}
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			return -2;
+		}
+	}
+	len = rd(shmem + 0x14);
+	words = len >= 4 ? (len - 4) / 4 : 0;
+	words = MIN(words, (0x200u - 0x1c) / 4);
+	for (uint32_t i = 0; i < words && i < maxout; i++) {
+		out[i] = rd(shmem + 0x1c + i * 4);
+	}
+	*nout = MIN(words, maxout);
+	return 0;
+}
+
+/*
+ * MEMLAT (boot-arg dadamemlat=1). Nothing scales the memory while this kernel runs: DDR, the last-level cache (LLCC) and
+ * DDR's QoS level stay where the boot left them, or at the one static vote further down (dadaddr). Linux (Sibi Sankar's
+ * "QCOM SCMI Generic Vendor Extensions": PATCH V4 for x1e80100, RFC v7 for Glymur/Hamoa, June 2026) hands that job to
+ * CPUCP instead: through Qualcomm's generic vendor protocol (0x80) it describes, once, the memory groups, which CPUs each
+ * monitor watches and a CPU-clock -> memory-clock table per monitor, then starts the "MEMLAT" algorithm; from then on
+ * CPUCP samples the CPUs' counters every few ms and votes DDR / LLCC / DDR_QOS itself. No thread or polling here.
+ *
+ * Every vendor command is ext_id (0), the algorithm string "MEMLAT" (0x4d454d4c4154: low word, high word), a param_id
+ * and that parameter's payload; the answer is an SCMI status (and for GET_PARAM the value after it). The sequence and
+ * the payloads are the reference client's (qcom_scmi_memlat_client.c in V4, scmi-qcom-memlat-devfreq.c in v7):
+ *   SET_PARAM 18 COMMON_EV_MAP   { 5 events, hw 0xff, instructions, cycles, const cycles, fe stall, be stall }
+ *   for each group:
+ *     SET_PARAM 16 SET_MEM_GROUP { CPUs 0xff, hw, 0, 0, name[20] all 0 }
+ *     SET_PARAM 19 GRP_EV_MAP    { 3 events, hw, miss, writeback, access, 0, 0 }
+ *     for each monitor:
+ *       SET_PARAM 17 SET_MONITOR { CPUs, hw, type (1: compute), index, name[20] }
+ *       SET_PARAM 23 IPM_CEIL    { hw, index, ceiling }
+ *       SET_PARAM 32 MON_FREQ_MAP { hw, index, rows, 10 x (u16 CPU MHz | u16 memory MHz or QoS level << 16) }
+ *       SET_PARAM 33/34 SET_MIN_FREQ / SET_MAX_FREQ { hw, index, kHz or level }
+ *   SET_PARAM 31 SAMPLE_MS { 4 }, SET_PARAM 39 EFFECTIVE_FREQ_METHOD { 1: cycles over the window }
+ *   START_ACTIVITY 36 START_TIMER (no payload)
+ * (V4 put kHz in the map's u16 memory column, which cannot hold 547000; v7 sends MHz, and its 10-row map: Hamoa's
+ * firmware took both V4's 7 rows and v7's 10, so it reads the row count, not the length.)
+ *
+ * The groups, monitors, CPU lists and tables are dada's own device tree (qcom,memlat: ddr, llcc, ddrqos; the floors and
+ * ceilings are the first and last entries of qcom,dcvs's ddr/llcc/ddrqos freq tables). The counter numbers are CPUCP's:
+ * dt qcom,pmu qcom,pmu-events-tbl's fourth column -- ARM event 0x08 instructions -> 2, 0x11 cycles -> 0, 0x17 L2 refill
+ * -> 4, Qualcomm's 0x1000 -> 8 -- which is Linux's numbering too (EV_CPU_CYCLES 0, EV_INST_RETIRED 2).
+ *
+ * What dada's tree does NOT give (Android runs memlat on its own CPUs here: every monitor is "qcom,sampling-enabled"),
+ * so taken from Linux's x1e80100/Hamoa values: the IPM ceiling, instructions per miss at or under which a CPU counts as
+ * waiting on memory -- 20000000, so in practice every CPU counts and the memory follows the CPUs' clocks through the
+ * tables (boot-arg dadamlipm=); the sampling period, 4 ms (dadamlms=); DDR_QOS's hw_type, 2 in the protocol's
+ * documentation but 3 in dada's qcom,dcvs (dcvs-hw-type: DDR 0, LLCC 1, L3 2, DDRQOS 3) -- 2 first, 3 if 2 is refused.
+ */
+#define MEMLAT_ALGO             0x4d454d4c4154ull       /* "MEMLAT" */
+#define QCOM_SET_PARAM          0x10u
+#define QCOM_GET_PARAM          0x11u
+#define QCOM_START_ACTIVITY     0x12u
+#define ML_SET_MEM_GROUP        16u
+#define ML_SET_MONITOR          17u
+#define ML_SET_COMMON_EV_MAP    18u
+#define ML_SET_GRP_EV_MAP       19u
+#define ML_IPM_CEIL             23u
+#define ML_SAMPLE_MS            31u
+#define ML_MON_FREQ_MAP         32u
+#define ML_SET_MIN_FREQ         33u
+#define ML_SET_MAX_FREQ         34u
+#define ML_GET_CUR_FREQ         35u
+#define ML_START_TIMER          36u
+#define ML_EFFECTIVE_FREQ       39u
+#define ML_MAP_ROWS             10u             /* v7's MAX_MAP_ENTRIES: the map message always carries this many */
+#define ML_NONE                 0xffu           /* no counter */
+#define ML_GROUPS               3u
+
+static const struct ml_group {
+	const char *name;
+	uint32_t hw_type, miss_ev, min, max, mons;
+	struct ml_mon {
+		const char *name;
+		uint32_t cpus;          /* bit n: cpu n (qcom,cpulist phandles 0x10..0x17 are cpu@0..7: cluster0 0-5, cluster1 6-7) */
+		uint32_t compute;       /* qcom,compute-mon */
+		uint32_t rows;
+		uint32_t khz[7][2];     /* qcom,cpufreq-memfreq-tbl: CPU kHz, memory kHz (DDR_QOS: level) */
+	} mon[4];
+} ml_group[ML_GROUPS] = {
+	{ "DDR", 0, 8, 547000, 4761000, 4, {
+		  { "gold", 0x3f, 0, 6, { { 748800, 547000 }, { 960000, 1353000 }, { 1363200, 1555000 }, { 1785600, 2092000 },
+			{ 2572800, 3187000 }, { 3072000, 3686000 } } },
+		  { "prime", 0xc0, 0, 7, { { 614400, 547000 }, { 1017600, 1353000 }, { 1689600, 2092000 }, { 2246400, 3187000 },
+			{ 2841600, 3686000 }, { 3513600, 4224000 }, { 4185600, 4761000 } } },
+		  { "gold-compute", 0xff, 1, 2, { { 2227200, 547000 }, { 4185600, 2092000 } } },
+		  { "prime-latfloor", 0xc0, 0, 2, { { 2841600, 547000 }, { 4185600, 4224000 } } } } },
+	{ "LLCC", 1, 4, 350000, 1211000, 3, {
+		  { "gold", 0x3f, 0, 4, { { 960000, 350000 }, { 1785600, 533000 }, { 2572800, 806000 }, { 3072000, 933000 } } },
+		  { "prime", 0xc0, 0, 6, { { 1017600, 350000 }, { 1689600, 533000 }, { 2246400, 806000 }, { 2841600, 933000 },
+			{ 3513600, 1066000 }, { 4185600, 1211000 } } },
+		  { "gold-compute", 0xff, 1, 2, { { 2227200, 350000 }, { 4185600, 533000 } } } } },
+	{ "DDR_QOS", 2, 8, 0, 1, 3, {
+		  { "gold", 0xff, 0, 2, { { 2227200, 0 }, { 4185600, 1 } } },
+		  { "prime", 0xc0, 0, 2, { { 1689600, 0 }, { 4185600, 1 } } },
+		  { "prime-latfloor", 0xc0, 0, 2, { { 2246400, 0 }, { 4185600, 1 } } } } },
+};
+
+static uint32_t memlat_on;                      /* boot-arg dadamemlat */
+static bool memlat_running, memlat_readback;
+static uint32_t ml_hw[ML_GROUPS];               /* the hw_type CPUCP took for each group */
+static bool ml_ok[ML_GROUPS];
+
+/* scmi()'s own failures (-1 channel never free, -2 no answer, -3 channel error) and an empty answer, as statuses */
+#define ML_NO_ANSWER(r)         (-100 + (r))
+#define ML_EMPTY                (-104)
+
+static const char *
+scmi_status(int32_t s)
+{
+	static const char *const names[] = { "SUCCESS", "NOT_SUPPORTED", "INVALID_PARAMETERS", "DENIED", "NOT_FOUND",
+		                             "OUT_OF_RANGE", "BUSY", "COMMS_ERROR", "GENERIC_ERROR", "HARDWARE_ERROR", "PROTOCOL_ERROR" };
+
+	if (s <= 0 && s >= -10) {
+		return names[-s];
+	}
+	switch (s) {
+	case ML_NO_ANSWER(-1):
+		return "no answer (the channel never came free)";
+	case ML_NO_ANSWER(-2):
+		return "no answer (timed out)";
+	case ML_NO_ANSWER(-3):
+		return "channel error";
+	case ML_EMPTY:
+		return "empty answer";
+	default:
+		return "unknown status";
+	}
+}
+
+/* one vendor command for "MEMLAT": its status, and the first word after it in *value */
+static int32_t
+memlat_cmd(uint32_t msg, uint32_t param, const uint32_t *buf, uint32_t n, uint32_t *value)
+{
+	uint32_t in[4 + 16], out[4], got = 0;
+	int r;
+
+	n = MIN(n, 16u);
+	in[0] = 0;                                      /* ext_id */
+	in[1] = (uint32_t)MEMLAT_ALGO;
+	in[2] = (uint32_t)(MEMLAT_ALGO >> 32);
+	in[3] = param;
+	for (uint32_t i = 0; i < n; i++) {
+		in[4 + i] = buf[i];
+	}
+	r = scmi(SCMI_QCOM, msg, in, 4 + n, out, 4, &got);
+	if (r) {
+		return ML_NO_ANSWER(r);
+	}
+	if (got < 1) {
+		return ML_EMPTY;
+	}
+	if (value) {
+		*value = got > 1 ? out[1] : 0;
+	}
+	return (int32_t)out[0];
+}
+
+/* SET_PARAM, logged with its payload */
+static int32_t
+memlat_set(const char *what, uint32_t param, const uint32_t *buf, uint32_t n)
+{
+	int32_t s = memlat_cmd(QCOM_SET_PARAM, param, buf, n, NULL);
+	char words[160];
+	int at = 0;
+
+	words[0] = 0;
+	for (uint32_t i = 0; i < n && at < (int)sizeof(words) - 12; i++) {
+		at += snprintf(words + at, sizeof(words) - (size_t)at, " %x", buf[i]);
+	}
+	say("memlat: SET_PARAM %u %s {%s }: %s\n", param, what, words, scmi_status(s));
+	return s;
+}
+
+/* each configured monitor's vote as CPUCP has it now (GET_PARAM 35 GET_CUR_FREQ { hw, index, 0 }), in one line */
+static void
+memlat_votes(const char *when)
+{
+	char line[240];
+	int at = 0;
+
+	line[0] = 0;
+	for (uint32_t g = 0; g < ML_GROUPS; g++) {
+		if (!ml_ok[g] || at >= (int)sizeof(line) - 24) {
+			continue;
+		}
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " %s", ml_group[g].name);
+		for (uint32_t m = 0; m < ml_group[g].mons && at < (int)sizeof(line) - 16; m++) {
+			uint32_t buf[3] = { ml_hw[g], m, 0 }, v = 0;
+			int32_t s = memlat_cmd(QCOM_GET_PARAM, ML_GET_CUR_FREQ, buf, 3, &v);
+
+			if (s == 0) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %u", ml_group[g].max > 1 ? v / 1000 : v);
+			} else {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " (%d)", s);
+				if (s <= ML_NO_ANSWER(0)) {
+					memlat_readback = false;        /* (a silent channel would hold the governor up 80 ms a call) */
+				}
+			}
+		}
+	}
+	say("memlat: votes %s, per monitor (MHz; DDR_QOS level):%s\n", when, line);
+}
+
+/* configure CPUCP's memlat from dada's tree and start it; once, from cpu_thread, before the governor */
+static void
+memlat_start(void)
+{
+	uint32_t out[4], n = 0, in[1], buf[16], ipm = 20000000, sample_ms = 4, groups = 0, version, method = 1;
+	const char *msgs[4] = { "?", "?", "?", "?" };
+	char what[48];
+	int32_t s;
+	int r;
+
+	PE_parse_boot_argn("dadamlipm", &ipm, sizeof(ipm));
+	PE_parse_boot_argn("dadamlms", &sample_ms, sizeof(sample_ms));
+
+	/* the protocol: there at all, and which of its commands this firmware has */
+	r = scmi(SCMI_QCOM, 0, NULL, 0, out, 4, &n);
+	if (r || n < 2 || out[0] != 0) {
+		say("memlat: vendor protocol 0x80: no version (%d, %u words, status %s); memlat not started\n", r, n,
+		    n ? scmi_status((int32_t)out[0]) : "-");
+		return;
+	}
+	version = out[1];
+	r = scmi(SCMI_QCOM, 1, NULL, 0, out, 4, &n);
+	say("memlat: vendor protocol 0x80 version %#x (Linux knows 0x10000), attributes %#x (%d, status %s: %u algorithm "
+	    "strings, %u agents)\n", version, n > 1 ? out[1] : 0, r, n ? scmi_status((int32_t)out[0]) : "-",
+	    n > 1 ? out[1] & 0xff : 0, n > 1 ? (out[1] >> 8) & 0xff : 0);
+	for (uint32_t m = 0; m < 4; m++) {
+		in[0] = QCOM_SET_PARAM + m;
+		r = scmi(SCMI_QCOM, 2, in, 1, out, 4, &n);
+		msgs[m] = r ? scmi_status(ML_NO_ANSWER(r)) : n ? scmi_status((int32_t)out[0]) : "empty answer";
+	}
+	say("memlat: PROTOCOL_MESSAGE_ATTRIBUTES: SET_PARAM %s, GET_PARAM %s, START_ACTIVITY %s, STOP_ACTIVITY %s\n",
+	    msgs[0], msgs[1], msgs[2], msgs[3]);
+
+	/* the counters every sample reads on every CPU: instructions 2, cycles 0, the rest none (V4's choice) */
+	buf[0] = 5;
+	buf[1] = ML_NONE;
+	buf[2] = 2;
+	buf[3] = 0;
+	buf[4] = buf[5] = buf[6] = ML_NONE;
+	if (memlat_set("COMMON_EV_MAP", ML_SET_COMMON_EV_MAP, buf, 7) != 0) {
+		say("memlat: CPUCP took no common events; memlat not started\n");
+		return;
+	}
+
+	for (uint32_t g = 0; g < ML_GROUPS; g++) {
+		const struct ml_group *grp = &ml_group[g];
+
+		ml_hw[g] = grp->hw_type;
+		for (;;) {
+			memset(buf, 0, sizeof(buf));
+			buf[0] = 0xff;                  /* every CPU may feed the group (v7: cpu_possible_mask) */
+			buf[1] = ml_hw[g];
+			snprintf(what, sizeof(what), "SET_MEM_GROUP %s hw %u", grp->name, ml_hw[g]);
+			s = memlat_set(what, ML_SET_MEM_GROUP, buf, 9);
+			if (s != 0 && g == 2 && ml_hw[g] == 2) {
+				ml_hw[g] = 3;           /* (dada's dcvs-hw-type for DDRQOS) */
+				continue;
+			}
+			break;
+		}
+		if (s != 0) {
+			continue;
+		}
+		buf[0] = 3;
+		buf[1] = ml_hw[g];
+		buf[2] = grp->miss_ev;
+		buf[3] = buf[4] = ML_NONE;              /* no writeback or access counters */
+		buf[5] = buf[6] = 0;
+		snprintf(what, sizeof(what), "GRP_EV_MAP %s", grp->name);
+		if (memlat_set(what, ML_SET_GRP_EV_MAP, buf, 7) != 0) {
+			continue;                       /* (a group without its miss counter cannot vote) */
+		}
+		ml_ok[g] = true;
+		groups++;
+		for (uint32_t m = 0; m < grp->mons; m++) {
+			const struct ml_mon *mon = &grp->mon[m];
+			char name[20] = { 0 };
+
+			buf[0] = mon->cpus;
+			buf[1] = ml_hw[g];
+			buf[2] = mon->compute;
+			buf[3] = m;
+			strlcpy(name, mon->name, sizeof(name));
+			memcpy(&buf[4], name, sizeof(name));
+			snprintf(what, sizeof(what), "SET_MONITOR %s %s", grp->name, mon->name);
+			if (memlat_set(what, ML_SET_MONITOR, buf, 9) != 0) {
+				continue;
+			}
+			buf[0] = ml_hw[g];
+			buf[1] = m;
+			buf[2] = mon->compute ? 0 : ipm;
+			snprintf(what, sizeof(what), "IPM_CEIL %s %s", grp->name, mon->name);
+			(void)memlat_set(what, ML_IPM_CEIL, buf, 3);
+			memset(buf, 0, sizeof(buf));
+			buf[0] = ml_hw[g];
+			buf[1] = m;
+			buf[2] = mon->rows;
+			for (uint32_t i = 0; i < mon->rows && i < ML_MAP_ROWS; i++) {
+				uint32_t mem = grp->max > 1 ? mon->khz[i][1] / 1000 : mon->khz[i][1];
+
+				buf[3 + i] = (mon->khz[i][0] / 1000) | mem << 16;
+			}
+			snprintf(what, sizeof(what), "MON_FREQ_MAP %s %s", grp->name, mon->name);
+			(void)memlat_set(what, ML_MON_FREQ_MAP, buf, 3 + ML_MAP_ROWS);
+			buf[0] = ml_hw[g];
+			buf[1] = m;
+			buf[2] = grp->min;
+			snprintf(what, sizeof(what), "SET_MIN_FREQ %s %s", grp->name, mon->name);
+			(void)memlat_set(what, ML_SET_MIN_FREQ, buf, 3);
+			buf[2] = grp->max;
+			snprintf(what, sizeof(what), "SET_MAX_FREQ %s %s", grp->name, mon->name);
+			(void)memlat_set(what, ML_SET_MAX_FREQ, buf, 3);
+		}
+	}
+	if (groups == 0) {
+		say("memlat: CPUCP took no memory group; memlat not started\n");
+		return;
+	}
+	(void)memlat_set("SAMPLE_MS", ML_SAMPLE_MS, &sample_ms, 1);
+	(void)memlat_set("EFFECTIVE_FREQ_METHOD", ML_EFFECTIVE_FREQ, &method, 1);
+	s = memlat_cmd(QCOM_START_ACTIVITY, ML_START_TIMER, NULL, 0, NULL);
+	say("memlat: START_ACTIVITY %u START_TIMER: %s; %u of %u groups configured\n", ML_START_TIMER, scmi_status(s),
+	    groups, ML_GROUPS);
+	memlat_running = s == 0;
+	if (memlat_running) {
+		memlat_readback = true;
+		delay_for_interval(1000, NSEC_PER_MSEC);
+		memlat_votes("1 s after the start");
+	}
+}
+
+static uint32_t
+clock_here_mhz(void)
+{
+	uint64_t span, start, now, x = 1, rounds = 0, ns;
+
+	nanoseconds_to_absolutetime(10 * NSEC_PER_MSEC, &span);
+	start = mach_absolute_time();
+	do {
+		for (int i = 0; i < 1000; i++) {
+			__asm__ volatile ("add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                                          "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n" : "+r"(x));
+		}
+		rounds += 1000;
+		now = mach_absolute_time();
+	} while (now - start < span);
+	absolutetime_to_nanoseconds(now - start, &ns);
+	return ns ? (uint32_t)(rounds * 16 * 1000 / ns) : 0;
+}
+
+static uint32_t
+clock_on(int cpu)
+{
+	processor_t p = cpu_to_processor(cpu);
+	uint32_t mhz;
+
+	if (p == PROCESSOR_NULL) {
+		return 0;
+	}
+	thread_bind(p);
+	thread_block(THREAD_CONTINUE_NULL);
+	mhz = clock_here_mhz();
+	thread_bind(PROCESSOR_NULL);
+	thread_block(THREAD_CONTINUE_NULL);
+	return mhz;
+}
+
+static struct {
+	uint32_t levels, sustained_khz, top_sustained, now;
+	uint32_t khz[64];
+} dom[4];
+static uint32_t domains;
+
+static void
+clocks(const char *when)
+{
+	char line[200];
+	int at = 0;
+
+	for (unsigned c = 0; c < (unsigned)ml_get_cpu_count() && c < 5; c++) {   /* (the prime cores, 5 and 6, may not be running: a bind to one would wait for ever) */
+		at += snprintf(line + at, sizeof(line) - (size_t)at, " cpu%u %u", c, clock_on((int)c));
+	}
+	line[at] = 0;
+	say("%s: MHz (dependent adds, about the clock):%s\n", when, line);
+}
+
+static void governor_thread(void *arg, wait_result_t w);
+
+static void
+cpu_thread(void *arg, wait_result_t w __unused)
+{
+	uint32_t stage = (uint32_t)(uintptr_t)arg, out[64], n = 0, in[3], version;
+	int r;
+
+	delay_for_interval(15000, NSEC_PER_MSEC);
+	mbox = ml_io_map(CPUCP_TX_PHYS, 0x1000);
+	shmem = ml_io_map(SCMI_SHMEM_PHYS, 0x1000);
+	if (stage == 0) {
+		memlat_start();                                 /* (dadamemlat=1 alone: memlat and nothing else) */
+		return;
+	}
+	clocks("as the boot left them");
+	r = scmi(SCMI_PERF, 0, NULL, 0, out, 64, &n);
+	if (r || n < 2) {
+		say("SCMI performance protocol: no answer (%d, %u words; channel status %#x)\n", r, n, rd(shmem + 4));
+		return;
+	}
+	version = out[1];
+	r = scmi(SCMI_PERF, 1, NULL, 0, out, 64, &n);
+	domains = (!r && n >= 2) ? MIN(out[1] & 0xffff, 4u) : 0;
+	say("SCMI performance protocol %#x: %u domains\n", version, domains);
+	for (uint32_t d = 0; d < domains; d++) {
+		uint32_t index = 0, entry = (version >> 16) >= 4 ? 5 : 3;
+		char name[17] = { 0 };
+
+		in[0] = d;
+		r = scmi(SCMI_PERF, 3, in, 1, out, 64, &n);
+		if (!r && n >= 9) {
+			memcpy(name, &out[5], 16);
+		}
+		dom[d].sustained_khz = n > 3 ? out[3] : 0;
+		for (int guard = 0; guard < 64; guard++) {
+			in[0] = d;
+			in[1] = index;
+			r = scmi(SCMI_PERF, 4, in, 2, out, 64, &n);
+			if (r || n < 2 || out[0] != 0) {
+				break;
+			}
+			uint32_t got = out[1] & 0xfff, left = out[1] >> 16;
+
+			for (uint32_t i = 0; i < got && 2 + (i + 1) * entry <= n && index + i < 64; i++) {
+				const uint32_t *e = &out[2 + i * entry];
+
+				dom[d].khz[index + i] = entry == 5 ? e[3] : e[0];
+			}
+			index += got;
+			if (!left || !got) {
+				break;
+			}
+		}
+		dom[d].levels = MIN(index, 64u);
+		dom[d].top_sustained = 0;
+		for (uint32_t l = 0; l < dom[d].levels; l++) {
+			if (dom[d].khz[l] <= dom[d].sustained_khz || dom[d].sustained_khz == 0) {
+				dom[d].top_sustained = l;
+			}
+		}
+		in[0] = d;
+		r = scmi(SCMI_PERF, 8, in, 1, out, 64, &n);
+		dom[d].now = (!r && n > 1) ? out[1] : ~0u;
+		say("domain %u '%s': %u levels, %u .. %u kHz, sustained %u kHz (level %u), level now %d\n", d, name,
+		    dom[d].levels, dom[d].khz[0], dom[d].levels ? dom[d].khz[dom[d].levels - 1] : 0, dom[d].sustained_khz,
+		    dom[d].top_sustained, (int)dom[d].now);
+	}
+	if (memlat_on) {
+		memlat_start();
+	}
+	if (stage < 2) {
+		return;
+	}
+	for (uint32_t d = 0; d < domains; d++) {
+		in[0] = d;
+		in[1] = dom[d].top_sustained;
+		r = scmi(SCMI_PERF, 7, in, 2, out, 8, &n);
+		in[0] = d;
+		(void)scmi(SCMI_PERF, 8, in, 1, out + 4, 4, &n);
+		say("domain %u asked for level %u (%u kHz): %d/%d, level now %d\n", d, dom[d].top_sustained,
+		    dom[d].khz[dom[d].top_sustained], r, (int)out[0], (int)out[5]);
+	}
+	delay_for_interval(50, NSEC_PER_MSEC);
+	clocks("at the sustained levels");
+	/*
+	 * The memory's bandwidth: nobody votes for it while this kernel runs (the GPU's own bus table has a single
+	 * "off" level), so DDR stays at its floor and every full-screen pass of the compositor is held up by it --
+	 * 2 ms a submission whatever the GPU's clock. A BCM vote (Linux BCM_TCS_CMD: commit, valid, AB in [27:14],
+	 * IB in [13:0], in the BCM's own units) for the memory controller (MC0) and the shared hub (SH0); boot-arg
+	 * dadaddr=N, IB (default 0x1000; 0: none). With memlat running CPUCP votes the memory itself, so there is no
+	 * static vote unless dadaddr= is given (then it is a floor: a BCM takes the highest of its voters). If memlat was
+	 * asked for but did not start, the static vote stays, so the memory is never left at its floor.
+	 */
+	{
+		extern bool hakios_rpmh_write(const char *name, uint32_t value);
+		uint32_t ib = 0x1000;
+
+		if (!PE_parse_boot_argn("dadaddr", &ib, sizeof(ib)) && memlat_running) {
+			say("memory bandwidth: memlat votes it, no static vote (dadaddr= for one)\n");
+			ib = 0;
+		}
+		if (ib != 0) {
+			uint32_t v = 1u << 30 | 1u << 29 | (ib & 0x3fff) << 14 | (ib & 0x3fff);
+
+			say("memory bandwidth: MC0 %s, SH0 %s (vote %#x)\n", hakios_rpmh_write("MC0", v) ? "voted" : "NOT voted",
+			    hakios_rpmh_write("SH0", v) ? "voted" : "NOT voted", v);
+		}
+	}
+	if (stage >= 3) {
+		governor_thread(NULL, THREAD_AWAKENED);         /* (this thread becomes the governor) */
+	}
+}
+
+/*
+ * THE GOVERNOR (dadacpu=3). With every core at its top sustained level and the 3D core at 734 MHz for good (dadacpu=2),
+ * the phone ran hot in the hand. As Data A Live does it for SM8850 (pandora_cpu.c, patches 0201-0213), which is
+ * Linux's schedutil:
+ *
+ *   CPU   every 20 ms, each domain's busiest CPU (idle time from the scheduler's own stamps: hakios_cpu_idle.c), and
+ *         the lowest level that gives 1.25 x what it used at the clock it ran at; nearly always busy (over 85 %), at
+ *         least twice that clock. Up at once, down when four windows in a row want less. Never above the sustained
+ *         level (the boost levels are left alone) nor the thermal cap.
+ *   GPU   every 20 ms the share of the window the 3D core spent on submissions (hakios_dada_gpu.c); over 75 % a speed
+ *         up, under 35 % for ten windows a speed down; between 342 MHz and 832 MHz, and the thermal cap.
+ *   heat  every 100 ms the hottest of the SoC's 47 sensors (qcom,tsens-v2: four controllers, DT tsens0-3; sensor S's
+ *         reading at TM + 0xa0 + 4 S, bits 0-11 signed tenths of a degree, bit 21 valid). Over 85 C every cap one level
+ *         down, under 75 C one back up; over 95 C every cap straight to half. Android's own trips are near 95-105 C;
+ *         these are lower, for a phone that is held.
+ *
+ * Every 2 s: each domain's level and clock, its busiest CPU, the GPU's speed and busyness, the hottest sensor, the caps.
+ */
+extern uint64_t hakios_cpu_idle_mach(int cpu);
+extern int hakios_cpu_cluster(int cpu);
+extern uint64_t hakios_dada_gpu_busy_us(void);
+extern uint32_t hakios_dada_gpu_speeds(uint32_t *mhz, uint32_t max);
+extern bool hakios_dada_gpu_set_speed(uint32_t index);
+
+#define WINDOW_MS               20
+#define MAX_CPUS                8
+#define GPU_LOW                 3               /* 342 MHz: the floor, so a frame that comes is not drawn slowly */
+#define GPU_HIGH                10              /* 832 MHz (dadatherm=0; split: the table's fastest, gpu_high) */
+#define HOT                     850             /* tenths of a degree */
+#define COOL                    750
+#define TOO_HOT                 950
+/*
+ * ... unless boot-args dadahot=, dadacool=, dadatoohot= (tenths of a degree) say otherwise: the hottest of 47 sensors is a
+ * core's junction, at 80-90 C whenever the phone works, so with 85/75 the GPU sat at 342-443 MHz through most of a run
+ * (g2k34). hot_where says which sensor it was (controller * 100 + sensor), in the 2 s line.
+ */
+static int32_t hot = HOT, cool = COOL, too_hot = TOO_HOT;
+static uint32_t hot_where;
+/*
+ * dadatherm=1 (the default): each domain by its own sensors and at the limits Qualcomm's device tree gives this SoC (dt
+ * thermal-zones, thermal-hal-config): the 3D core by gpuss-0..7 (tsens2 sensors 1-8), passive from 95 C; the CPU domains by
+ * their cores' and cluster's sensors (tsens0 1-14: the six, tsens1 1-6: the two), passive from 120 C there -- here from 105,
+ * the hardware's own limits (LMh) act on the CPUs too. Over 110 C anywhere every cap halves, as before. The thresholds of
+ * the 3D core are hot/cool/too_hot (95/90/105 C unless the boot-args say otherwise), the CPUs' ten degrees higher.
+ * dadatherm=0: the hottest of all the sensors for everything, at 85/75/95 C (before 29 October).
+ */
+static uint32_t therm_split = 1;
+/*
+ * dadaboost=MS (default 1500): for that long after a finger touches the screen, the 3D core is kept at gpu_boost (default 9,
+ * 734 MHz) or above and every CPU domain at its top sustained level -- within the heat caps. The governor otherwise climbs one
+ * speed per 20 ms window once the GPU is busy, and the first frames of a swipe met it at 342-443 MHz: the stutter as a finger
+ * starts to move (Android's touch boost does the same). 0: off.
+ */
+extern uint64_t redwood_touch_last;
+static uint32_t touch_boost_ms = 1500, gpu_boost = 9;
+static int32_t any_too_hot = 950;   /* any sensor over this halves every cap (dadaanyhot, tenths; was 110 C) */
+#define ANY_TOO_HOT             any_too_hot
+
+/* the hottest valid sensor of controller c, sensors from..to, in tenths of a degree, or INT32_MIN */
+static int32_t hottest_of(unsigned c, uint32_t from, uint32_t to);
+
+static const uint64_t tsens_tm[] = { 0x0c228000, 0x0c229000, 0x0c22a000, 0x0c22b000 };
+static const uint32_t tsens_count[] = { 15, 7, 16, 9 };
+static vm_offset_t tsens_va[4];
+
+static int32_t
+hottest_of(unsigned c, uint32_t from, uint32_t to)
+{
+	int32_t best = INT32_MIN;
+
+	if (tsens_va[c] == 0) {
+		tsens_va[c] = ml_io_map(tsens_tm[c], 0x1000);
+	}
+	for (uint32_t s = from; tsens_va[c] != 0 && s <= to && s < tsens_count[c]; s++) {
+		uint32_t v = rd(tsens_va[c] + 0xa0 + 4 * s);
+		int32_t t = (int32_t)(v << 20) >> 20;
+
+		if ((v & (1u << 21)) && t > best && t < 1500) {
+			best = t;
+		}
+	}
+	return best;
+}
+
+/* the hottest valid sensor, in tenths of a degree, or INT32_MIN */
+static int32_t
+hottest(void)
+{
+	int32_t best = INT32_MIN;
+
+	for (unsigned c = 0; c < 4; c++) {
+		if (tsens_va[c] == 0) {
+			tsens_va[c] = ml_io_map(tsens_tm[c], 0x1000);
+		}
+		for (uint32_t s = 0; tsens_va[c] != 0 && s < tsens_count[c]; s++) {
+			uint32_t v = rd(tsens_va[c] + 0xa0 + 4 * s);
+			int32_t t = (int32_t)(v << 20) >> 20;
+
+			if ((v & (1u << 21)) && t > best && t < 1500) {
+				best = t;
+				hot_where = c * 100 + s;
+			}
+		}
+	}
+	return best;
+}
+
+static bool
+set_level(uint32_t d, uint32_t level)
+{
+	uint32_t in[2] = { d, level }, out[4], n = 0;
+
+	return scmi(SCMI_PERF, 7, in, 2, out, 4, &n) == 0 && n >= 1 && out[0] == 0;
+}
+
+static void
+governor_thread(void *arg __unused, wait_result_t w __unused)
+{
+	uint64_t idle_was[MAX_CPUS] = { 0 }, at_was, gpu_was, window;
+	uint32_t level[4], cap[4], down[4] = { 0 }, cpus = MIN(ml_get_cpu_count(), (unsigned)MAX_CPUS);
+	uint32_t gpu_mhz[16] = { 0 }, gpu_speeds = hakios_dada_gpu_speeds(gpu_mhz, 16), gpu = 9, gpu_cap = GPU_HIGH;
+	uint32_t gpu_down = 0, ticks = 0, busy_shown[4] = { 0 }, gpu_busy_shown = 0, cpu_busy_sum[MAX_CPUS] = { 0 };
+	int cluster[MAX_CPUS];
+	int32_t temp = INT32_MIN, gpu_temp = INT32_MIN;
+	uint32_t gpu_high = GPU_HIGH;
+
+	nanoseconds_to_absolutetime((uint64_t)WINDOW_MS * NSEC_PER_MSEC, &window);
+	PE_parse_boot_argn("dadatherm", &therm_split, sizeof(therm_split));
+	PE_parse_boot_argn("dadaboost", &touch_boost_ms, sizeof(touch_boost_ms));
+	PE_parse_boot_argn("dadaboost_gpu", &gpu_boost, sizeof(gpu_boost));
+	if (therm_split) {
+		gpu_high = gpu_speeds > 1 ? gpu_speeds - 1 : GPU_HIGH;
+		gpu_cap = gpu_high;
+		hot = 750;              /* the GPU's; the CPU domains' are 10 C higher (the phone ran too hot at 95/105, 30 Oct) */
+		cool = 700;
+		too_hot = 850;
+	}
+	PE_parse_boot_argn("dadaanyhot", &any_too_hot, sizeof(any_too_hot));
+	PE_parse_boot_argn("dadahot", &hot, sizeof(hot));
+	PE_parse_boot_argn("dadacool", &cool, sizeof(cool));
+	PE_parse_boot_argn("dadatoohot", &too_hot, sizeof(too_hot));
+	for (uint32_t c = 0; c < cpus; c++) {
+		cluster[c] = hakios_cpu_cluster((int)c);
+		idle_was[c] = hakios_cpu_idle_mach((int)c);
+	}
+	/* frequency ceilings, for heat: every CPU domain at most dadacpu_khz (0: none), the GPU at most dadagpu_mhz */
+	{
+		uint32_t max_khz = 2400000, max_mhz = 660;
+
+		PE_parse_boot_argn("dadacpu_khz", &max_khz, sizeof(max_khz));
+		PE_parse_boot_argn("dadagpu_mhz", &max_mhz, sizeof(max_mhz));
+		for (uint32_t d = 0; max_khz != 0 && d < domains; d++) {
+			while (dom[d].top_sustained > 0 && dom[d].khz[dom[d].top_sustained] > max_khz) {
+				dom[d].top_sustained--;
+			}
+		}
+		while (max_mhz != 0 && gpu_high > GPU_LOW && gpu_mhz[gpu_high] > max_mhz) {
+			gpu_high--;
+		}
+		gpu_cap = MIN(gpu_cap, gpu_high);
+		gpu = MIN(gpu, gpu_cap);
+		(void)hakios_dada_gpu_set_speed(gpu);  /* (a dadagpu_speed= start may be above the ceiling) */
+		say("the governor: ceilings: CPU %u kHz, GPU %u MHz (dadacpu_khz, dadagpu_mhz)\n", max_khz, gpu_mhz[gpu_high]);
+	}
+	for (uint32_t d = 0; d < domains; d++) {
+		level[d] = dom[d].top_sustained;
+		cap[d] = dom[d].top_sustained;
+	}
+	at_was = mach_absolute_time();
+	gpu_was = hakios_dada_gpu_busy_us();
+	say("the governor: heat caps over %d, back under %d, halved over %d (tenths of a degree)\n", hot, cool, too_hot);
+	say("the governor: %u CPUs (clusters %d %d %d %d %d %d %d %d), %u domains, GPU %u speeds\n", cpus, cluster[0],
+	    cluster[1], cluster[2], cluster[3], cluster[4], cluster[5], cluster[6], cluster[7], domains, gpu_speeds);
+	for (;;) {
+		uint64_t now, elapsed, gpu_now;
+		uint32_t busy[4] = { 0 }, gpu_busy;
+
+		delay_for_interval(WINDOW_MS, NSEC_PER_MSEC);
+		now = mach_absolute_time();
+		elapsed = now - at_was;
+		if (elapsed < window / 2) {
+			continue;
+		}
+		/* each domain's busiest CPU, in thousandths */
+		for (uint32_t c = 0; c < cpus; c++) {
+			uint64_t idle = hakios_cpu_idle_mach((int)c), spent = idle - idle_was[c];
+			uint32_t b = spent >= elapsed ? 0 : (uint32_t)((elapsed - spent) * 1000 / elapsed);
+
+			idle_was[c] = idle;
+			cpu_busy_sum[c] += b;
+			if (cluster[c] >= 0 && (uint32_t)cluster[c] < domains && b > busy[cluster[c]]) {
+				busy[cluster[c]] = b;
+			}
+		}
+		gpu_now = hakios_dada_gpu_busy_us();
+		{
+			uint64_t ns;
+
+			absolutetime_to_nanoseconds(elapsed, &ns);
+			gpu_busy = ns ? (uint32_t)MIN((gpu_now - gpu_was) * 1000000 / ns, 1000ull) : 0;
+		}
+		gpu_was = gpu_now;
+		at_was = now;
+
+		/* heat, every fifth window */
+		if (ticks % 5 == 0) {
+			temp = hottest();
+			for (uint32_t d = 0; d < domains; d++) {
+				/* (split: the six by tsens0 1-14, the two by tsens1 1-6; more domains go by everything) */
+				int32_t t = !therm_split ? temp : d == 0 ? hottest_of(0, 1, 14) : d == 1 ? hottest_of(1, 1, 6) : temp;
+				int32_t h = therm_split ? hot + 100 : hot, k = therm_split ? cool + 100 : cool;
+				int32_t th = therm_split ? too_hot + 100 : too_hot;
+
+				if (t > th || (therm_split && temp > ANY_TOO_HOT)) {
+					cap[d] = MIN(cap[d], dom[d].top_sustained / 2);
+				} else if (t > h && cap[d] > 0) {
+					cap[d]--;
+				} else if (t < k && cap[d] < dom[d].top_sustained) {
+					cap[d]++;
+				}
+			}
+			gpu_temp = therm_split ? hottest_of(2, 1, 8) : temp;
+			if (gpu_temp > too_hot || (therm_split && temp > ANY_TOO_HOT)) {
+				gpu_cap = GPU_LOW;
+			} else if (gpu_temp > hot && gpu_cap > GPU_LOW) {
+				gpu_cap--;
+			} else if (gpu_temp < cool && gpu_cap < gpu_high) {
+				gpu_cap++;
+			}
+		}
+
+		/* touch boost (dadaboost) */
+		bool boosted = false;
+		if (touch_boost_ms != 0 && redwood_touch_last != 0) {
+			uint64_t since;
+
+			absolutetime_to_nanoseconds(now - redwood_touch_last, &since);
+			boosted = since < (uint64_t)touch_boost_ms * NSEC_PER_MSEC;
+		}
+
+		/* the CPU domains */
+		for (uint32_t d = 0; d < domains; d++) {
+			uint64_t want_khz = (uint64_t)dom[d].khz[level[d]] * busy[d] * 125 / 100000;
+			uint32_t want = 0;
+
+			if (busy[d] > 850) {
+				want_khz = MAX(want_khz, 2ull * dom[d].khz[level[d]]);
+			}
+			while (want < dom[d].top_sustained && dom[d].khz[want] < want_khz) {
+				want++;
+			}
+			if (boosted) {
+				want = dom[d].top_sustained;
+			}
+			want = MIN(want, cap[d]);
+			if (want > level[d] || level[d] > cap[d]) {
+				down[d] = 0;
+			} else if (want < level[d] && ++down[d] >= 4) {
+				down[d] = 0;
+			} else {
+				want = level[d];
+			}
+			if (want != level[d] && set_level(d, want)) {
+				level[d] = want;
+			}
+			busy_shown[d] = MAX(busy_shown[d], busy[d]);
+		}
+
+		/* the 3D core */
+		{
+			uint32_t want = gpu;
+
+			if (gpu_busy > 750 && gpu < gpu_cap) {
+				want = gpu + 1;
+				gpu_down = 0;
+			} else if (gpu_busy < 350 && gpu > GPU_LOW) {
+				if (++gpu_down >= 10) {
+					want = gpu - 1;
+					gpu_down = 0;
+				}
+			} else {
+				gpu_down = 0;
+			}
+			if (boosted && want < gpu_boost && gpu_boost < gpu_speeds) {
+				want = gpu_boost;
+				gpu_down = 0;
+			}
+			want = MIN(want, gpu_cap);
+			if (want != gpu && hakios_dada_gpu_set_speed(want)) {
+				gpu = want;
+			}
+			gpu_busy_shown = MAX(gpu_busy_shown, gpu_busy);
+		}
+
+		if (++ticks % (2000 / WINDOW_MS) == 0) {
+			say("governor: cpu %u kHz (level %u/%u, busiest %u%%) prime %u kHz (level %u/%u, busiest %u%%); GPU %u MHz "
+			    "(cap %u MHz, busiest %u%%); hottest %d.%d C (sensor %u), the GPU's %d C\n", dom[0].khz[level[0]], level[0], cap[0],
+			    busy_shown[0] / 10, domains > 1 ? dom[1].khz[level[1]] : 0, domains > 1 ? level[1] : 0,
+			    domains > 1 ? cap[1] : 0, busy_shown[1] / 10, gpu_mhz[gpu], gpu_mhz[gpu_cap], gpu_busy_shown / 10,
+			    temp / 10, (temp < 0 ? -temp : temp) % 10, hot_where, gpu_temp / 10);
+			{
+				char each[96];
+				int at = 0;
+
+				for (uint32_t c = 0; c < cpus; c++) {
+					at += snprintf(each + at, sizeof(each) - (size_t)at, " %u", cpu_busy_sum[c] / (2000 / WINDOW_MS) / 10);
+					cpu_busy_sum[c] = 0;
+				}
+				say("governor: each CPU busy %% over 2 s:%s\n", each);
+			}
+			if (memlat_running && memlat_readback) {
+				memlat_votes("now");
+			}
+			busy_shown[0] = busy_shown[1] = busy_shown[2] = busy_shown[3] = 0;
+			gpu_busy_shown = 0;
+		}
+	}
+}
+
+void hakios_dada_cpu_init(void);
+
+void
+hakios_dada_cpu_init(void)
+{
+	uint32_t stage = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("dadacpu", &stage, sizeof(stage));
+	(void)PE_parse_boot_argn("dadamemlat", &memlat_on, sizeof(memlat_on));
+	if (stage == 0 && memlat_on == 0) {
+		return;
+	}
+	if (kernel_thread_start(cpu_thread, (void *)(uintptr_t)stage, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/hakios_dada_dpu.c b/bsd/dev/hakios_dada_dpu.c
new file mode 100644
index 0000000..33a0c65
--- /dev/null
+++ b/bsd/dev/hakios_dada_dpu.c
@@ -0,0 +1,490 @@
+/*
+ * The Xiaomi 15's (dada) display controller showing iOS's frames from buffers of its own, flipped, instead of the
+ * CPU scaling every frame into the boot loader's panel memory (MiniIOMobileFramebuffer.cpp drawLayer: 1206x2622
+ * filtered onto 1200x2670 in device memory, 9-10 ms a frame on three processors).
+ *
+ * Data A Live's way for the Xiaomi 17 Pro (pandora_dpu.c, patches 0215/0217) is the display reading iOS's surfaces
+ * where they are, through page tables of its own in the display stream's SMMU bank. Here the same bank (2, apps SMMU,
+ * stream 0x800) faults at the first fetch whatever the tables (runs scan6-scan11: kernel memory or the loader's
+ * memory below 4 GB, 32- or 48-bit input, walks cached or not): the hypervisor lets the display reach the
+ * continuous-splash region alone (DT splash_region 0xfc800000, 43 MiB; smmu_sde_iommu_region_partition), so the bank
+ * stays the loader's, untranslating, and the display reads physical addresses in that region only.
+ *
+ * So: the boot framebuffer is the region's first 12.8 MB, and two buffers of a whole iOS frame follow it. A frame is
+ * copied unscaled into the buffer not on screen -- one plain copy of its rows, no filtering -- and the source pipes are
+ * pointed at it; the display does the rest: 3 columns cut off each side, 24 rows of border above and below. The
+ * flush is latched at the panel's next refresh, so nothing tears.
+ *
+ * SM8750's MDSS (DT mdss_mdp@ae00000) has a DPU 12.0. Offsets are mainline Linux's (drivers/gpu/drm/msm/disp/dpu1:
+ * catalog/dpu_12_0_sm8750.h, dpu_hw_sspp.c, dpu_hw_ctl.c), which count from the "mdp" block at MDSS + 0x1000, and
+ * agree with the phone's DT (qcom,sde-sspp-off 0x5000.., qcom,sde-ctl-off 0x16000..). What the loader left (run
+ * scan5): CTL0 drives INTF1 (DSI0, command mode refreshing itself), VIG0 and VIG1 each fetch 600 of the panel's 1200
+ * columns of the framebuffer at 0xfc800000 (rows of 4800 bytes), source split over LM0 and LM1.
+ *
+ * Boot-args: dadascan=1 (dada-ios.sh): a look at the display controller (logged, "ddpu:") and the flipped buffers;
+ * dadascan=2, the look alone; dadascan=3, the clocks alone.
+ */
+#include <kern/clock.h>
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+
+#define say(...) redwood_tl("ddpu: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern void IOSleep(unsigned int milliseconds);
+
+#define MDSS_PHYS               0x0ae00000UL
+#define MDSS_SIZE               0x94000UL
+#define MDP                     0x1000u
+#define CTL(n)                  (MDP + 0x15000u + 0x1000u * (n))
+#define CTL_LAYER(n)            (4u * (n))
+#define CTL_TOP                 0x014
+#define CTL_FLUSH               0x018
+#define CTL_START               0x01c
+#define CTL_INTF_ACTIVE         0x0f4
+#define CTL_FETCH_PIPE_ACTIVE   0x0fc
+#define CTL_FLUSH_CTL           (1u << 17)
+#define LM(n)                   (MDP + 0x44000u + 0x1000u * (n))
+#define INTF(n)                 (MDP + 0x34000u + 0x1000u * (n))
+#define SSPP_SRC_SIZE           0x00
+#define SSPP_SRC_XY             0x08
+#define SSPP_OUT_SIZE           0x0c
+#define SSPP_OUT_XY             0x10
+#define SSPP_SRC0_ADDR          0x14
+#define SSPP_YSTRIDE0           0x24
+#define SSPP_SRC_FORMAT         0x30
+#define SSPP_UNPACK             0x34
+#define SSPP_OP_MODE            0x38
+#define SSPP_FETCH_CONFIG       0x48
+
+#define SPLASH_PHYS             0xfc800000UL    /* DT splash_region: what the display may read */
+#define SPLASH_SIZE             0x2b00000UL
+#define BUFFERS                 2
+#define PIPES                   10u
+
+static const struct {
+	const char *name;
+	uint32_t base;
+	uint32_t flush;
+} sspp[PIPES] = {
+	{ "vig0", 0x4000, 1u << 0 }, { "vig1", 0x6000, 1u << 1 }, { "vig2", 0x8000, 1u << 2 }, { "vig3", 0xa000, 1u << 18 },
+	{ "dma0", 0x24000, 1u << 11 }, { "dma1", 0x26000, 1u << 12 }, { "dma2", 0x28000, 1u << 24 },
+	{ "dma3", 0x2a000, 1u << 25 }, { "dma4", 0x2c000, 1u << 13 }, { "dma5", 0x2e000, 1u << 14 },
+};
+static const uint32_t saved_regs[] = { SSPP_SRC_SIZE, SSPP_SRC_XY, SSPP_OUT_SIZE, SSPP_OUT_XY, SSPP_SRC0_ADDR, SSPP_YSTRIDE0 };
+#define SAVED (sizeof(saved_regs) / sizeof(saved_regs[0]))
+
+static struct {
+	bool ready, on_panel, need_start;
+	vm_offset_t mdss;
+	uint32_t ctl, pipes, flush;
+	uint32_t saved[PIPES][SAVED];
+	uint32_t panel_w, panel_h;
+	uint32_t buffer_pa[BUFFERS], buffer_bytes;
+	uint8_t *buffer[BUFFERS];
+	int shown;                      /* the buffer on screen, -1: the boot framebuffer */
+	uint32_t stride, w, h;          /* ... and the picture in it */
+	uint64_t shows, waits_long;
+	bool pending;                   /* a flip kicked and not yet seen taken (dadascan_async) */
+} sc;
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__builtin_arm_dsb(0xf);
+}
+
+static inline uint32_t
+dpu(uint32_t off)
+{
+	return rd(sc.mdss + off);
+}
+
+/* ---- the display block's clocks ------------------------------------------------------------------------------------- */
+
+/*
+ * The boot loader leaves the display scanning out but its register clocks may be off: a read of the display
+ * controller then never completes and the board resets (runs scan1, scan2: gone 14 s into the boot, no log). So
+ * first the clocks its registers need, as Linux's drivers/clk/qcom/dispcc-sm8750.c and gcc-sm8750.c name them:
+ * GCC_DISP_AHB_CLK (the clock controller's own registers), then in DISPCC the MDSS power domain must be on and the
+ * AHB, MDP and vsync branches are turned on if they are not. False: leave the display controller alone.
+ */
+#define GCC_DISP_AHB_CBCR       0x127004UL
+#define DISPCC_PHYS             0x0af00000UL
+#define DISPCC_SIZE             0x10000UL
+#define MDSS_GDSCR              0x9000
+#define CBCR_OFF                (1u << 31)
+
+static bool
+branch_on(vm_offset_t cbcr, const char *name)
+{
+	uint32_t was = rd(cbcr);
+
+	if (!(was & 1)) {
+		wr(cbcr, was | 1);
+	}
+	for (int i = 0; i < 200 && (rd(cbcr) & CBCR_OFF); i++) {
+		delay(5);
+	}
+	say("%s %08x -> %08x\n", name, was, rd(cbcr));
+	/* (under hardware control, bit 1, a branch reads off while nothing asks for it: it is on when something does) */
+	return !(rd(cbcr) & CBCR_OFF) || (rd(cbcr) & 2);
+}
+
+static bool
+clocks(void)
+{
+	static const struct {
+		uint32_t off;
+		const char *name;
+		bool needed;
+	} branches[] = {
+		{ 0x80b0, "disp_cc_mdss_ahb_clk", true }, { 0xc004, "disp_cc_mdss_non_gdsc_ahb_clk", false },
+		{ 0xa028, "disp_cc_mdss_ahb1_clk", false }, { 0x8010, "disp_cc_mdss_mdp_clk", true },
+		{ 0x8030, "disp_cc_mdss_vsync_clk", false },
+	};
+	vm_offset_t gcc = ml_io_map(GCC_DISP_AHB_CBCR & ~0xfffUL, 0x1000), dispcc;
+	uint32_t gdsc;
+
+	if (gcc == 0 || !branch_on(gcc + (GCC_DISP_AHB_CBCR & 0xfff), "gcc_disp_ahb_clk")) {
+		return false;
+	}
+	dispcc = ml_io_map(DISPCC_PHYS, DISPCC_SIZE);
+	if (dispcc == 0) {
+		return false;
+	}
+	gdsc = rd(dispcc + MDSS_GDSCR);
+	say("mdss_gdsc %08x (%s)\n", gdsc, (gdsc >> 31) ? "on" : "off");
+	if (!(gdsc >> 31)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); i++) {
+		if (!branch_on(dispcc + branches[i].off, branches[i].name) && branches[i].needed) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---- a look at what the boot loader left running ------------------------------------------------------------------ */
+
+static void
+look(uint64_t fb)
+{
+	say("MDSS %08x, DPU %08x; the boot framebuffer at %#llx\n", dpu(0), dpu(MDP), fb);
+	for (unsigned n = 0; n < 6; n++) {
+		uint32_t c = CTL(n), intf = dpu(c + CTL_INTF_ACTIVE), fetch = dpu(c + CTL_FETCH_PIPE_ACTIVE);
+
+		if (intf == 0 && fetch == 0 && dpu(c + CTL_LAYER(0)) == 0) {
+			continue;
+		}
+		say("ctl%u: layers %08x %08x %08x %08x top %08x flush %08x start %08x intf %08x fetch %08x\n", n,
+		    dpu(c + CTL_LAYER(0)), dpu(c + CTL_LAYER(1)), dpu(c + CTL_LAYER(2)), dpu(c + CTL_LAYER(3)), dpu(c + CTL_TOP),
+		    dpu(c + CTL_FLUSH), dpu(c + CTL_START), intf, fetch);
+	}
+	for (unsigned p = 0; p < PIPES; p++) {
+		uint32_t b = MDP + sspp[p].base;
+
+		if (dpu(b + SSPP_SRC0_ADDR) == 0 && dpu(b + SSPP_SRC_SIZE) == 0) {
+			continue;
+		}
+		say("%s: src %08x at %08x, out %08x at %08x, addr %08x stride %08x format %08x unpack %08x op %08x fetch %08x\n",
+		    sspp[p].name, dpu(b + SSPP_SRC_SIZE), dpu(b + SSPP_SRC_XY), dpu(b + SSPP_OUT_SIZE), dpu(b + SSPP_OUT_XY),
+		    dpu(b + SSPP_SRC0_ADDR), dpu(b + SSPP_YSTRIDE0), dpu(b + SSPP_SRC_FORMAT), dpu(b + SSPP_UNPACK),
+		    dpu(b + SSPP_OP_MODE), dpu(b + SSPP_FETCH_CONFIG));
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		uint32_t m = LM(n);
+
+		if (dpu(m + 0x0) == 0 && dpu(m + 0x4) == 0) {
+			continue;
+		}
+		say("lm%u: op %08x out %08x border %08x %08x\n", n, dpu(m + 0x0), dpu(m + 0x4), dpu(m + 0x8), dpu(m + 0xc));
+	}
+	for (unsigned n = 1; n <= 2; n++) {
+		uint32_t i = INTF(n);
+
+		uint32_t frame = dpu(i + 0xac), line = dpu(i + 0xb0);
+
+		IOSleep(20);
+		say("intf%u: timing engine %08x config %08x frame %u line %u; again in 20 ms: frame %u\n", n, dpu(i + 0x0),
+		    dpu(i + 0x4), frame, line, dpu(i + 0xac));
+	}
+}
+
+/* ---- frames -------------------------------------------------------------------------------------------------------- */
+
+/*
+ * Until CTL has taken the last flush (its bits clear at the frame that latches them), LIMIT_US at most. Slept for, a
+ * millisecond at a time after a first short look: spinning here cost up to a refresh (8 ms) of a core every frame.
+ */
+static bool
+flush_taken(uint32_t limit_us)
+{
+	for (uint32_t i = 0; i < 4; i++) {
+		if ((dpu(CTL(sc.ctl) + CTL_FLUSH) & sc.flush) == 0) {
+			return true;
+		}
+		delay(50);
+	}
+	for (uint32_t waited = 200; waited < limit_us; waited += 1000) {
+		IOSleep(1);
+		if ((dpu(CTL(sc.ctl) + CTL_FLUSH) & sc.flush) == 0) {
+			return true;
+		}
+	}
+	return (dpu(CTL(sc.ctl) + CTL_FLUSH) & sc.flush) == 0;
+}
+
+static void
+kick(void)
+{
+	__builtin_arm_dsb(0xf);
+	wr(sc.mdss + CTL(sc.ctl) + CTL_FLUSH, sc.flush);
+	if (sc.need_start) {
+		wr(sc.mdss + CTL(sc.ctl) + CTL_START, 1);
+	}
+}
+
+static void
+pipes_to_panel(void)
+{
+	for (unsigned p = 0; p < PIPES; p++) {
+		if (sc.pipes & (1u << p)) {
+			for (unsigned r = 0; r < SAVED; r++) {
+				wr(sc.mdss + MDP + sspp[p].base + saved_regs[r], sc.saved[p][r]);
+			}
+		}
+	}
+	kick();
+	sc.on_panel = true;
+}
+
+int hakios_dada_scanout_init(uint64_t fb, uint32_t panel_w, uint32_t panel_h, uint32_t row_bytes, uint32_t frame_bytes);
+int
+hakios_dada_scanout_init(uint64_t fb, uint32_t panel_w, uint32_t panel_h, uint32_t row_bytes, uint32_t frame_bytes)
+{
+	uint32_t mode = 0, at;
+
+	if (!PE_parse_boot_argn("dadascan", &mode, sizeof(mode)) || mode == 0) {
+		return -1;
+	}
+	if (!clocks()) {
+		say("the display controller's clocks are not on: it is left alone, the CPU copies frames\n");
+		return -1;
+	}
+	if (mode == 3) {                /* the clocks alone */
+		return -1;
+	}
+	sc.mdss = ml_io_map(MDSS_PHYS, MDSS_SIZE);
+	if (sc.mdss == 0) {
+		say("the display controller not mapped\n");
+		return -1;
+	}
+	look(fb);
+	if (mode == 2) {
+		return -1;
+	}
+	/* the pipes that read the boot framebuffer, and the CTL that drives the panel's interface */
+	for (unsigned p = 0; p < PIPES; p++) {
+		uint32_t b = MDP + sspp[p].base, a = dpu(b + SSPP_SRC0_ADDR);
+
+		if (a != 0 && dpu(b + SSPP_SRC_SIZE) != 0 && a >= fb && a < fb + (uint64_t)row_bytes * panel_h) {
+			sc.pipes |= 1u << p;
+			sc.flush |= sspp[p].flush;
+			for (unsigned r = 0; r < SAVED; r++) {
+				sc.saved[p][r] = dpu(b + saved_regs[r]);
+			}
+		}
+	}
+	if (sc.pipes == 0) {
+		say("no pipe reads the boot framebuffer at %#llx: the CPU copies frames\n", fb);
+		return -1;
+	}
+	sc.ctl = ~0u;
+	for (unsigned n = 0; n < 6 && sc.ctl == ~0u; n++) {
+		if (dpu(CTL(n) + CTL_INTF_ACTIVE) & 0x6) {      /* INTF1 or INTF2: DSI */
+			sc.ctl = n;
+		}
+	}
+	if (sc.ctl == ~0u) {
+		say("no CTL drives a DSI interface\n");
+		return -1;
+	}
+	sc.flush |= CTL_FLUSH_CTL;
+	sc.panel_w = panel_w;
+	sc.panel_h = panel_h;
+
+	/* the two buffers: in the splash region after the framebuffer, 1 MiB aligned, memory the kernel does not manage */
+	sc.buffer_bytes = (frame_bytes + 0xfffff) & ~0xfffffu;
+	at = (uint32_t)((fb + (uint64_t)row_bytes * panel_h + 0xfffff) & ~0xfffffull);
+	if (fb < SPLASH_PHYS || at + BUFFERS * sc.buffer_bytes > SPLASH_PHYS + SPLASH_SIZE) {
+		say("no room in the splash region for %u buffers of %u bytes after the framebuffer at %#llx\n", BUFFERS,
+		    sc.buffer_bytes, fb);
+		return -1;
+	}
+	for (unsigned i = 0; i < BUFFERS; i++) {
+		sc.buffer_pa[i] = at + i * sc.buffer_bytes;
+		for (uint32_t off = 0; off < sc.buffer_bytes; off += 0x100000) {
+			if (pmap_valid_address(sc.buffer_pa[i] + off)) {
+				say("%#x is the kernel's memory: no buffers there\n", sc.buffer_pa[i] + off);
+				return -1;
+			}
+		}
+		sc.buffer[i] = (uint8_t *)ml_io_map_wcomb(sc.buffer_pa[i], sc.buffer_bytes);
+		if (sc.buffer[i] == NULL) {
+			say("buffer %u not mapped\n", i);
+			return -1;
+		}
+	}
+	/* does a flush alone get taken (video mode, or command mode refreshing itself), or does each frame need a start? */
+	kick();
+	if (!flush_taken(50000)) {
+		sc.need_start = true;
+		kick();
+		if (!flush_taken(50000)) {
+			say("CTL does not take a flush (flush %08x): the CPU copies frames\n", dpu(CTL(sc.ctl) + CTL_FLUSH));
+			return -1;
+		}
+	}
+	say("ctl%u drives pipes %#x (flush %#x%s); buffers of %u bytes at %#x and %#x\n", sc.ctl, sc.pipes, sc.flush,
+	    sc.need_start ? ", a start each" : "", sc.buffer_bytes, sc.buffer_pa[0], sc.buffer_pa[1]);
+	sc.shown = -1;
+	sc.on_panel = true;
+	sc.ready = true;
+	return 0;
+}
+
+/* The buffer to copy the next frame into (the one not on screen), BYTES at most; NULL: none. */
+uint8_t *hakios_dada_scanout_buffer(uint32_t bytes);
+uint8_t *
+hakios_dada_scanout_buffer(uint32_t bytes)
+{
+	if (!sc.ready || bytes > sc.buffer_bytes) {
+		return NULL;
+	}
+	/* the buffer given is the one the flip before last left: the last flip must be taken before it is written again */
+	if (sc.pending) {
+		if (!flush_taken(40000)) {
+			sc.waits_long++;
+		}
+		sc.pending = false;
+	}
+	return sc.buffer[sc.shown == 0 ? 1 : 0];
+}
+
+/*
+ * Show the W x H picture (rows of STRIDE bytes) just copied into the buffer hakios_dada_scanout_buffer gave: each
+ * pipe keeps its place on the panel and reads the same columns of the picture, which is centred on the panel unscaled.
+ * Returns once the frame is taken (the buffer before is no longer read); false if it was not within 40 ms.
+ */
+static TUNABLE(uint32_t, scan_async, "dadascan_async", 1);
+bool hakios_dada_scanout_show(uint32_t stride, uint32_t w, uint32_t h);
+bool
+hakios_dada_scanout_show(uint32_t stride, uint32_t w, uint32_t h)
+{
+	int32_t cx = ((int32_t)w - (int32_t)sc.panel_w) / 2;
+	uint32_t sy = h > sc.panel_h ? (h - sc.panel_h) / 2 : 0, rows = MIN(h, sc.panel_h);
+	uint32_t dy = h < sc.panel_h ? (sc.panel_h - h) / 2 : 0;
+	int next = sc.shown == 0 ? 1 : 0;
+
+	if (!sc.ready || cx < 0 || !flush_taken(20000)) {
+		return false;
+	}
+	__builtin_arm_dsb(0xf);         /* (the copy's writes out of the write buffers before the display reads them) */
+	for (unsigned p = 0; p < PIPES; p++) {
+		vm_offset_t b = sc.mdss + MDP + sspp[p].base;
+		uint32_t sx, sw, ox, oy;
+
+		if (!(sc.pipes & (1u << p))) {
+			continue;
+		}
+		sx = (sc.saved[p][1] & 0xffff) + (uint32_t)cx;
+		sw = sc.saved[p][0] & 0xffff;
+		ox = sc.saved[p][3] & 0xffff;
+		oy = (sc.saved[p][3] >> 16) + dy;
+		wr(b + SSPP_SRC0_ADDR, sc.buffer_pa[next]);
+		wr(b + SSPP_YSTRIDE0, stride & 0xffff);
+		wr(b + SSPP_SRC_SIZE, rows << 16 | sw);
+		wr(b + SSPP_SRC_XY, sy << 16 | sx);
+		wr(b + SSPP_OUT_SIZE, rows << 16 | sw);
+		wr(b + SSPP_OUT_XY, oy << 16 | ox);
+	}
+	kick();
+	sc.on_panel = false;
+	sc.shown = next;
+	sc.stride = stride;
+	sc.w = w;
+	sc.h = h;
+	sc.shows++;
+	/*
+	 * dadascan_async=1 (the default): back at once, and the flip is seen taken only before the buffer it leaves is written
+	 * again (hakios_dada_scanout_buffer). Waiting here for the next refresh to take it cost some 4 ms of every frame, on the
+	 * window server's swap (dada g2k40s: 7.5-9 ms a frame in the display's driver, 10-30 frames a second).
+	 */
+	if (scan_async) {
+		sc.pending = true;
+	} else if (!flush_taken(40000)) {
+		sc.waits_long++;
+	}
+	if (sc.shows % 1024 == 1) {
+		say("%llu frames flipped (%llu not taken within 40 ms)\n", sc.shows, sc.waits_long);
+	}
+	return true;
+}
+
+/* The boot framebuffer again, as the loader set the pipes up (for the CPU's own drawing). */
+void hakios_dada_scanout_panel(void);
+void
+hakios_dada_scanout_panel(void)
+{
+	if (sc.ready && !sc.on_panel && flush_taken(20000)) {
+		pipes_to_panel();
+		sc.shown = -1;
+		(void)flush_taken(40000);
+	}
+}
+
+/*
+ * The run is about to end (redwood_adreno_stop): the picture on screen copied into the boot framebuffer as the pipes
+ * show it, and the pipes on the framebuffer again -- for the loader's screenshot, and the next kernel finds the display
+ * as the loader left it. FB: the framebuffer as the kernel maps it (device memory: aligned 32-bit stores only).
+ */
+void hakios_dada_scanout_end(uint8_t *fb, uint32_t row_bytes);
+void
+hakios_dada_scanout_end(uint8_t *fb, uint32_t row_bytes)
+{
+	if (!sc.ready || sc.on_panel || sc.shown < 0) {
+		return;
+	}
+	{
+		int32_t cx = ((int32_t)sc.w - (int32_t)sc.panel_w) / 2;
+		uint32_t rows = MIN(sc.h, sc.panel_h), dy = sc.h < sc.panel_h ? (sc.panel_h - sc.h) / 2 : 0;
+		uint32_t sy = sc.h > sc.panel_h ? (sc.h - sc.panel_h) / 2 : 0;
+
+		for (uint32_t y = 0; y < sc.panel_h; y++) {
+			volatile uint32_t *to = (volatile uint32_t *)(fb + (size_t)y * row_bytes);
+			const uint32_t *from = (const uint32_t *)(sc.buffer[sc.shown] + (size_t)(y - dy + sy) * sc.stride) + cx;
+
+			for (uint32_t x = 0; x < sc.panel_w; x++) {
+				to[x] = (y >= dy && y < dy + rows) ? from[x] : 0;
+			}
+		}
+	}
+	hakios_dada_scanout_panel();
+	say("the run ends: the picture is in the framebuffer again, the pipes on it (%llu frames flipped)\n", sc.shows);
+}
diff --git a/bsd/dev/hakios_dada_gauge.c b/bsd/dev/hakios_dada_gauge.c
new file mode 100644
index 0000000..bb215ba
--- /dev/null
+++ b/bsd/dev/hakios_dada_gauge.c
@@ -0,0 +1,390 @@
+/*
+ * The Xiaomi 15's (dada) fuel gauge: a TI bq27z561 at address 0x55 on the I2C bus of QUP SE5
+ * (Android's device tree: qupv3_se5_i2c i2c@a94000, bq27z561_standlone@55; SDA gpio52, SCL gpio53).
+ *
+ * The audio DSP's charge manager knows the battery's voltage, current and temperature and whether it
+ * charges (redwood_adsp.c, Xiaomi's MCA), but not how full it is: that is the gauge's, and Android reads
+ * it from the application processor over I2C (bq27z561.ko). Here the two pins are driven by hand, as the
+ * touch screen's SPI is (hakios_dada_touch.c): open drain made of the output enable -- a line is pulled
+ * low by enabling the pin's output at 0 and let go by disabling it, when the bus's pull-up raises it --
+ * at about 100 kHz. Only reads, of the gauge's standard commands (TRM SLUUC80): nothing is written to it,
+ * so it is left as Android left it.
+ *
+ * Boot-arg dadagauge=1. hakios_dada_gauge_read() is how the battery's report asks (redwood_adsp.c);
+ * the first answers are said in the log.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define say(...) redwood_tl("dgauge: " __VA_ARGS__)
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x102000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define PULL_UP                 3
+#define PIN_SDA                 52
+#define PIN_SCL                 53
+#define GAUGE_ADDRESS           0x55
+#define HALF_US                 10
+/* the TLMM's own pull-up for I2C (the device tree's "qcom,i2c_pull"; Linux msm_pingroup.i2c_pull_bit 13):
+ * stronger than the ordinary one, and on a bus with no resistors of its own the only thing that raises
+ * the lines fast enough -- the amplifiers' bus, gpio64/65, answered nothing without it */
+#define I2C_PULL                (1u << 13)
+
+/* the gauge's standard commands (two bytes each, little-endian) */
+#define CMD_TEMPERATURE         0x06    /* 0.1 K */
+#define CMD_VOLTAGE             0x08    /* mV */
+#define CMD_CURRENT             0x0c    /* mA, signed: less than 0 while the battery gives */
+#define CMD_REMAINING           0x10    /* mAh */
+#define CMD_FULL                0x12    /* mAh, the full charge as learnt */
+#define CMD_CYCLES              0x2a
+#define CMD_SOC                 0x2c    /* %, relative state of charge */
+#define CMD_HEALTH              0x2e    /* %, state of health */
+#define CMD_DESIGN              0x3c    /* mAh */
+
+static vm_offset_t tlmm;
+static bool ready;
+
+/* an I2C bus of two pins, driven by hand (the gauge's, and the speakers' amplifiers', hakios_dada_amp.c) */
+struct dada_i2c {
+	unsigned sda, scl;
+};
+static const struct dada_i2c gauge_bus = { PIN_SDA, PIN_SCL };
+static const struct dada_i2c *bus = &gauge_bus;
+static LCK_GRP_DECLARE(gauge_group, "dada gauge");
+static LCK_MTX_DECLARE(gauge_lock, &gauge_group);
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__builtin_arm_dsb(0xf);
+}
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static void
+half(void)
+{
+	delay_for_interval(HALF_US, NSEC_PER_USEC);
+}
+
+/* a line let go (input, pulled up by the bus) or pulled low (output at 0) */
+static void
+line(unsigned pin, bool high)
+{
+	/* (the output's level made 0 every time, before its enable: a pin whose output a driver before us
+	 * left at 1 would drive the line high when we mean to pull it low -- the amplifiers' bus, gpio64/65,
+	 * answered nothing at all until this) */
+	if (!high) {
+		wr(GPIO_IO(pin), 0);
+	}
+	wr(GPIO_CFG(pin), PULL_UP | 0 << 2 | (2 / 2 - 1) << 6 | (high ? 0 : 1u << 9) | I2C_PULL);
+}
+
+static bool
+level(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+/* SCL let go, and held while the gauge stretches the clock (a millisecond at most) */
+static bool
+scl_high(void)
+{
+	line(bus->scl, true);
+	for (unsigned i = 0; i < 200 && !level(bus->scl); i++) {
+		half();
+	}
+	return level(bus->scl);
+}
+
+static void
+start(void)
+{
+	line(bus->sda, true);
+	scl_high();
+	half();
+	line(bus->sda, false);
+	half();
+	line(bus->scl, false);
+	half();
+}
+
+static void
+stop(void)
+{
+	line(bus->sda, false);
+	half();
+	scl_high();
+	half();
+	line(bus->sda, true);
+	half();
+}
+
+/* a byte out; true if the gauge acknowledged it */
+static bool
+put_byte(uint8_t b)
+{
+	bool ack;
+
+	for (int i = 7; i >= 0; i--) {
+		line(bus->sda, (b >> i) & 1);
+		half();
+		scl_high();
+		half();
+		line(bus->scl, false);
+	}
+	line(bus->sda, true);
+	half();
+	scl_high();
+	ack = !level(bus->sda);
+	half();
+	line(bus->scl, false);
+	return ack;
+}
+
+static uint8_t
+get_byte(bool ack)
+{
+	uint8_t b = 0;
+
+	line(bus->sda, true);
+	for (int i = 7; i >= 0; i--) {
+		half();
+		scl_high();
+		b |= (uint8_t)(level(bus->sda) << i);
+		half();
+		line(bus->scl, false);
+	}
+	line(bus->sda, !ack);
+	half();
+	scl_high();
+	half();
+	line(bus->scl, false);
+	line(bus->sda, true);
+	return b;
+}
+
+/* one of the gauge's two-byte commands read */
+static bool
+read_word(uint8_t command, uint16_t *value)
+{
+	bool ok;
+	uint8_t lo, hi;
+
+	start();
+	ok = put_byte(GAUGE_ADDRESS << 1) && put_byte(command);
+	if (ok) {
+		line(bus->sda, true);           /* the repeated start */
+		half();
+		scl_high();
+		half();
+		line(bus->sda, false);
+		half();
+		line(bus->scl, false);
+		half();
+		ok = put_byte(GAUGE_ADDRESS << 1 | 1);
+	}
+	if (ok) {
+		lo = get_byte(true);
+		hi = get_byte(false);
+		*value = (uint16_t)(lo | hi << 8);
+	}
+	stop();
+	return ok;
+}
+
+/* what the battery's report wants of the gauge; false if it does not answer */
+bool hakios_dada_gauge_read(uint32_t *soc, uint32_t *remaining_mah, uint32_t *full_mah, uint32_t *design_mah,
+    uint32_t *cycles, int32_t *current_ma);
+
+bool
+hakios_dada_gauge_read(uint32_t *soc, uint32_t *remaining_mah, uint32_t *full_mah, uint32_t *design_mah,
+    uint32_t *cycles, int32_t *current_ma)
+{
+	uint16_t s = 0, r = 0, f = 0, d = 0, c = 0, i = 0;
+	bool ok;
+
+	if (!ready) {
+		return false;
+	}
+	lck_mtx_lock(&gauge_lock);
+	ok = read_word(CMD_SOC, &s) && read_word(CMD_REMAINING, &r) && read_word(CMD_FULL, &f) &&
+	    read_word(CMD_DESIGN, &d) && read_word(CMD_CYCLES, &c) && read_word(CMD_CURRENT, &i);
+	lck_mtx_unlock(&gauge_lock);
+	if (ok && s <= 100) {
+		*soc = s;
+		*remaining_mah = r;
+		*full_mah = f;
+		*design_mah = d;
+		*cycles = c;
+		*current_ma = (int16_t)i;
+		return true;
+	}
+	return false;
+}
+
+void hakios_dada_gauge_init(void);
+
+void
+hakios_dada_gauge_init(void)
+{
+	uint32_t on = 0;
+	uint16_t v[9] = { 0 };
+	static const uint8_t commands[9] = { CMD_SOC, CMD_VOLTAGE, CMD_CURRENT, CMD_TEMPERATURE, CMD_REMAINING, CMD_FULL,
+		                             CMD_DESIGN, CMD_CYCLES, CMD_HEALTH };
+	bool ok = true;
+
+	if (!PE_parse_boot_argn("dadagauge", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	line(bus->scl, true);
+	line(bus->sda, true);
+	half();
+	/* a bus left in the middle of a byte: nine clocks to let a gauge that holds SDA low finish it */
+	for (unsigned n = 0; n < 9 && !level(bus->sda); n++) {
+		line(bus->scl, false);
+		half();
+		scl_high();
+		half();
+	}
+	stop();
+	for (unsigned n = 0; n < 9 && ok; n++) {
+		ok = read_word(commands[n], &v[n]);
+	}
+	if (!ok) {
+		say("the bq27z561 (0x55 on gpio52/53) does not answer: the battery's percentage stays an estimate\n");
+		return;
+	}
+	ready = true;
+	say("the bq27z561 answers: %u%%, %u mV, %d mA, %d.%u C, %u of %u mAh (designed %u), %u cycles, health %u%%\n",
+	    v[0], v[1], (int16_t)v[2], ((int)v[3] - 2731) / 10, (unsigned)(((int)v[3] - 2731) % 10 + 10) % 10, v[4], v[5],
+	    v[6], v[7], v[8]);
+}
+
+/*
+ * Any transfer on any bus of two pins (the amplifiers' and whoever comes next): `wlen` bytes written,
+ * then, after a repeated start, `rlen` read. One transfer at a time on every bus, the gauge's included.
+ */
+bool hakios_dada_i2c_xfer(unsigned sda, unsigned scl, uint8_t address, const uint8_t *w, unsigned wlen, uint8_t *r,
+    unsigned rlen);
+
+bool
+hakios_dada_i2c_xfer(unsigned sda, unsigned scl, uint8_t address, const uint8_t *w, unsigned wlen, uint8_t *r,
+    unsigned rlen)
+{
+	struct dada_i2c other = { sda, scl };
+	bool ok = true;
+
+	lck_mtx_lock(&gauge_lock);
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	bus = &other;
+	start();
+	if (wlen != 0 || rlen == 0) {
+		ok = put_byte((uint8_t)(address << 1));
+		for (unsigned i = 0; ok && i < wlen; i++) {
+			ok = put_byte(w[i]);
+		}
+		if (ok && rlen != 0) {
+			line(bus->sda, true);  /* the repeated start */
+			half();
+			scl_high();
+			half();
+			line(bus->sda, false);
+			half();
+			line(bus->scl, false);
+			half();
+		}
+	}
+	if (ok && rlen != 0) {
+		ok = put_byte((uint8_t)(address << 1 | 1));
+		for (unsigned i = 0; ok && i < rlen; i++) {
+			r[i] = get_byte(i + 1 < rlen);
+		}
+	}
+	stop();
+	bus = &gauge_bus;
+	lck_mtx_unlock(&gauge_lock);
+	return ok;
+}
+
+/* a pin of the TLMM made an output at a level (a reset line) */
+void hakios_dada_gpio_out(unsigned pin, bool high);
+
+void
+hakios_dada_gpio_out(unsigned pin, bool high)
+{
+	lck_mtx_lock(&gauge_lock);
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	wr(GPIO_IO(pin), high ? 2 : 0);
+	/*
+	 * Bit 12: the pin is the application processor's, not the eGPIO's. Some of SM8750's pins (bit 11 says
+	 * which) can be handed to another subsystem -- the audio DSP's island owns gpio107 and gpio108 out of
+	 * the boot -- and until this bit is set nothing the TLMM is told reaches the pad (Linux: msm_pingroup
+	 * egpio_enable, set for every function but the eGPIO one). The amplifiers stayed in reset without it.
+	 */
+	wr(GPIO_CFG(pin), 0 | 0 << 2 | (2 / 2 - 1) << 6 | 1u << 9 | ((rd(GPIO_CFG(pin)) & (1u << 11)) ? 1u << 12 : 0));
+	lck_mtx_unlock(&gauge_lock);
+}
+
+/* the two lines' levels, let go: bit 1 SDA, bit 0 SCL (both high on a bus with its pull-ups) */
+unsigned hakios_dada_i2c_levels(unsigned sda, unsigned scl);
+
+unsigned
+hakios_dada_i2c_levels(unsigned sda, unsigned scl)
+{
+	unsigned v;
+
+	lck_mtx_lock(&gauge_lock);
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	line(sda, true);
+	line(scl, true);
+	half();
+	v = (level(sda) ? 2u : 0u) | (level(scl) ? 1u : 0u);
+	/* and pulled low, each in turn: bit 3 SDA still high, bit 2 SCL still high (a pin we do not drive);
+	 * bits 8.. the two pins' configuration words */
+	line(sda, false);
+	half();
+	v |= level(sda) ? 8u : 0u;
+	line(sda, true);
+	line(scl, false);
+	half();
+	v |= level(scl) ? 4u : 0u;
+	line(scl, true);
+	v |= (rd(GPIO_CFG(sda)) & 0x3ff) << 8 | (rd(GPIO_IO(sda)) & 3) << 20;
+	lck_mtx_unlock(&gauge_lock);
+	return v;
+}
+
+/* a pin's configuration word and its level, for the log: configuration << 4 | io */
+unsigned hakios_dada_gpio_state(unsigned pin);
+
+unsigned
+hakios_dada_gpio_state(unsigned pin)
+{
+	if (tlmm == 0) {
+		tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	}
+	return (rd(GPIO_CFG(pin)) & 0xffff) << 4 | (rd(GPIO_IO(pin)) & 3);
+}
diff --git a/bsd/dev/hakios_dada_gpu.c b/bsd/dev/hakios_dada_gpu.c
new file mode 100644
index 0000000..04a8df4
--- /dev/null
+++ b/bsd/dev/hakios_dada_gpu.c
@@ -0,0 +1,3413 @@
+/*
+ * The GPU of the Xiaomi 15 (dada, SM8750): an Adreno 830 (chip id 0x44050001, "gen8"), brought up the
+ * way Linux's msm driver brings up its a8xx GPUs (drivers/gpu/drm/msm/adreno/a8xx_gpu.c, a6xx_gmu.c,
+ * a6xx_hfi.c), which is the only public description of this generation. Only with boot-arg dadagpu=N,
+ * which runs phases 1..N and stops at the first that fails; each says what it is about to touch
+ * ("dgpu: " lines in the loader's log), so that a phase that hangs the bus is the last line there:
+ *   1  power: GCC's votes and clocks, the CX power switch, the GPU's PLL (the GMU's clock comes from
+ *      it), the clocks of the GMU, its bus and the SMMU; the GMU's crystal counter seen counting
+ *   2  the GMU's memory: page tables of ours and a context of the GPU's SMMU for the GMU's stream (5);
+ *      the GMU's firmware (fw/gen80000_gmu.bin) into its own memories and into ours
+ *   3  the GMU started (a6xx_gmu_fw_start for a8xx), its message queues started ("HFI")
+ *   4  the GMU's tables (speeds and supply levels, bus votes), "start", and the request for the 3D
+ *      core's power ("OOB GPU"); the 3D core's first registers read
+ * Everything is undone again before the system goes on.
+ *
+ * Register offsets are the database's (Linux's registers/adreno/*.xml), turned into
+ * hakios_gen8_regs.h by tools/gen8-regs.py: 32-bit words from the GPU's base, 0x3d00000, the GMU's
+ * included (Linux: GMU_BYTE_OFFSET subtracts the GMU's distance from the GPU). Addresses and levels
+ * are dada's own device tree (logs/dada.dts), clocks Linux's gcc-sm8750.c and gpucc-sm8750.c.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>
+
+#include "hakios_gen8_regs.h"
+
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern uint64_t kvtophys(vm_offset_t va);
+extern const uint8_t *redwood_image_file(const char *dir, const char *name, uint64_t *size, int *disk_out);
+
+#define say(...) redwood_tl("dgpu: " __VA_ARGS__)
+
+static uint32_t phase;                  /* the one being performed */
+
+/* ---- registers ------------------------------------------------------------------------------------ */
+
+/*
+ * One plain load or store a register: some of what is touched (the SMMU's global registers) may be
+ * the hypervisor's imitation, which copes only with the simplest instruction forms.
+ */
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void __attribute__((noinline))
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* A moment for the loader, which follows our log from another core, to note what was just said. */
+static void
+hold(void)
+{
+	sleep_ms(30);
+}
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x80000UL
+#define GCC_APCS_CLK_VOTE       0x52000         /* bit 15 GPLL0 to the GPU, bit 16 its divided tap */
+#define GCC_GPU_CFG_AHB_CBCR    0x71004
+#define GCC_GPU_GEMNOC_GFX_CBCR 0x71010
+#define GCC_DDRSS_GPU_AXI_CBCR  0x71150
+
+#define GPUCC_PHYS              0x03d90000UL
+#define GPUCC_SIZE              0xa000UL
+#define PLL0                    0x0000          /* taycan_elu layout (clk-alpha-pll.c) */
+#define PLL_MODE                0x00
+#define PLL_OPMODE              0x04
+#define PLL_L                   0x10
+#define PLL_ALPHA               0x14
+#define PLL_USER_CTL            0x18
+#define PLL_USER_CTL_U          0x1c
+#define PLL_CONFIG_CTL          0x20
+#define PLL_CONFIG_CTL_U        0x24
+#define PLL_CONFIG_CTL_U1       0x28
+#define PLL_TEST_CTL            0x2c
+#define PLL_TEST_CTL_U          0x30
+#define PLL_OUTCTRL             (1u << 0)
+#define PLL_RESET_N             (1u << 2)
+#define PLL_LOCK_DET            (1u << 31)
+#define CX_GDSCR                0x9080
+#define GMU_RCGR                0x9318          /* gpu_cc_gmu_clk_src: +0 command, +4 source and divider */
+#define HUB_RCGR                0x93ec          /* gpu_cc_hub_clk_src */
+#define RCG_UPDATE              (1u << 0)
+#define RCG_CFG_MASK            0x71fu          /* [4:0] 2*divider-1, [10:8] source */
+#define CBCR_ENABLE             (1u << 0)
+#define CBCR_OFF                (1u << 31)
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define GDSC_RETAIN_FF_ENABLE   (1u << 11)
+#define GDSC_POWER_ON           (1u << 31)
+
+#define GPU_PHYS                0x03d00000UL
+#define GPU_SIZE                0xa0000UL       /* the 3D core, the GMU, its RPMh channel, the GX clock controller, cx_misc */
+#define RSCC_OFFSET             0x50000UL       /* a6xx_gmu.c: on a8xx the RSCC is the GPU's base + 0x50000 */
+#define CX_MISC_OFFSET          0x9e000UL
+#define GX_GDSCR_OFFSET         0x68024UL       /* gxclkctl (0x3d64000) + 0x4024 */
+
+#define SMMU_PHYS               0x03da0000UL
+#define SMMU_SIZE               0x40000UL
+
+#define CMD_DB_PHYS             0x81c60000UL    /* dt: aop_cmd_db_region */
+#define CMD_DB_SIZE             0x20000UL
+
+static vm_offset_t gcc, gpucc, gpu, smmu;
+
+static uint32_t
+G(uint32_t reg)                         /* a register of the GPU block, by its word number */
+{
+	return rd(gpu + 4UL * reg);
+}
+
+static void
+Gw(uint32_t reg, uint32_t value)
+{
+	wr(gpu + 4UL * reg, value);
+}
+
+static uint32_t
+R(uint32_t reg)                         /* the GMU's RPMh channel */
+{
+	return rd(gpu + RSCC_OFFSET + 4UL * reg);
+}
+
+static uint32_t
+X(uint32_t reg)                         /* cx_misc */
+{
+	return rd(gpu + CX_MISC_OFFSET + 4UL * reg);
+}
+
+static bool
+wait_bits(vm_offset_t address, uint32_t mask, uint32_t value, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(address) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	return (rd(address) & mask) == value;
+}
+
+static bool
+clock_on(vm_offset_t cbcr, const char *name, bool must)
+{
+	wr(cbcr, rd(cbcr) | CBCR_ENABLE);
+	if (wait_bits(cbcr, CBCR_OFF, 0, 2)) {
+		return true;
+	}
+	say("%u: %s stays off (%08x)%s\n", phase, name, rd(cbcr), must ? "" : ", not relied on");
+	return !must;
+}
+
+static bool
+rcg_set(uint32_t rcgr, uint32_t cfg, const char *name)
+{
+	uint32_t was = rd(gpucc + rcgr + 4);
+
+	wr(gpucc + rcgr + 4, (was & ~RCG_CFG_MASK) | cfg);
+	wr(gpucc + rcgr, rd(gpucc + rcgr) | RCG_UPDATE);
+	if (!wait_bits(gpucc + rcgr, RCG_UPDATE, 0, 5)) {
+		say("%u: %s does not take its source (cmd %08x cfg %08x)\n", phase, name, rd(gpucc + rcgr), rd(gpucc + rcgr + 4));
+		return false;
+	}
+	return true;
+}
+
+static bool
+cx_on(void)
+{
+	return (rd(gpucc + CX_GDSCR) & GDSC_POWER_ON) != 0;
+}
+
+/* ---- phase 1: power and clocks ---------------------------------------------------------------------- */
+
+static bool cx_off_done, gmu_runs, gmu_space_on, core_powered;
+
+/*
+ * The GPU's PLL as Linux configures and enables a Taycan ELU PLL (clk_lucid_evo_pll_configure,
+ * alpha_pll_lucid_evo_enable) with gpucc-sm8750.c's values: 0x34 + 0x1555/65536 times 19.2 MHz,
+ * about 998 MHz; its "even" output, half that, is what the GMU's clock takes for 500 MHz.
+ */
+static bool
+pll0_on(void)
+{
+	vm_offset_t p = gpucc + PLL0;
+
+	if ((rd(p + PLL_OPMODE) & 1) && (rd(p + PLL_MODE) & PLL_OUTCTRL)) {
+		say("%u: PLL0 runs already (mode %08x)\n", phase, rd(p + PLL_MODE));
+		return true;
+	}
+	wr(p + PLL_L, 0x34 | 0x44u << 16);
+	wr(p + PLL_ALPHA, 0x1555);
+	wr(p + PLL_CONFIG_CTL, 0x19660387);
+	wr(p + PLL_CONFIG_CTL_U, 0x098060a0);
+	wr(p + PLL_CONFIG_CTL_U1, 0xb416cb20);
+	wr(p + PLL_USER_CTL, 0x00000400);
+	wr(p + PLL_USER_CTL_U, 0x00000002);
+	wr(p + PLL_TEST_CTL, 0);
+	wr(p + PLL_TEST_CTL_U, 0);
+	wr(p + PLL_MODE, rd(p + PLL_MODE) & ~PLL_OUTCTRL);
+	wr(p + PLL_OPMODE, 0);                  /* standby */
+	wr(p + PLL_MODE, rd(p + PLL_MODE) | PLL_RESET_N);
+	wr(p + PLL_OPMODE, 1);                  /* run */
+	if (!wait_bits(p + PLL_MODE, PLL_LOCK_DET, PLL_LOCK_DET, 10)) {
+		say("%u: PLL0 does not lock (mode %08x)\n", phase, rd(p + PLL_MODE));
+		return false;
+	}
+	wr(p + PLL_USER_CTL, rd(p + PLL_USER_CTL) | 7);         /* main, even, odd outputs */
+	wr(p + PLL_MODE, rd(p + PLL_MODE) | PLL_OUTCTRL);
+	say("%u: PLL0 locked: mode %08x L %08x user %08x\n", phase, rd(p + PLL_MODE), rd(p + PLL_L), rd(p + PLL_USER_CTL));
+	return true;
+}
+
+static bool
+phase_power(void)
+{
+	uint32_t before, after;
+	uint64_t t0, nanos;
+
+	/*
+	 * boot-arg dadagpu_skip=MASK, for finding what of this phase upsets the Wi-Fi chip's PCIe link (runs drv*, 28
+	 * October): 1 GCC's votes and clocks, 2 the CX power switch, 4 PLL0, 8 the GMU and hub clock sources, 16 gpucc's
+	 * clocks. A skipped step reports done; later phases are not for a skipped one.
+	 */
+	uint32_t skip = 0;
+
+	(void)PE_parse_boot_argn("dadagpu_skip", &skip, sizeof(skip));
+	if (skip != 0) {
+		say("1: skipping %#x of this phase\n", skip);
+	}
+	say("1: GCC: GPLL0 votes, the GPU's bus clocks\n");
+	hold();
+	/* (gpu_cfg_ahb reads "off", 0x88000003, under hardware control, and gpucc answers all the same: not checked) */
+	if (!(skip & 1)) {
+		wr(gcc + GCC_APCS_CLK_VOTE, rd(gcc + GCC_APCS_CLK_VOTE) | 1u << 15 | 1u << 16);
+		clock_on(gcc + GCC_GPU_GEMNOC_GFX_CBCR, "gcc gpu_gemnoc_gfx", false);
+		clock_on(gcc + GCC_DDRSS_GPU_AXI_CBCR, "gcc ddrss_gpu_axi", false);
+	}
+
+	say("1: CX power switch (%08x)\n", rd(gpucc + CX_GDSCR));
+	hold();
+	if (skip & 2) {
+		return true;
+	}
+	if (!cx_on()) {
+		wr(gpucc + CX_GDSCR, (rd(gpucc + CX_GDSCR) | GDSC_RETAIN_FF_ENABLE) & ~GDSC_SW_COLLAPSE);
+		wait_bits(gpucc + CX_GDSCR, GDSC_POWER_ON, GDSC_POWER_ON, 10);
+	}
+	if (!cx_on()) {
+		say("1: CX does not come on (%08x)\n", rd(gpucc + CX_GDSCR));
+		return false;
+	}
+	cx_off_done = false;
+	if (rd(gpu + GX_GDSCR_OFFSET) & GDSC_POWER_ON) {
+		say("1: THE 3D CORE HAS POWER ALREADY (gx %08x): an earlier kernel left it; not starting over it\n",
+		    rd(gpu + GX_GDSCR_OFFSET));
+		return false;
+	}
+
+	say("1: PLL0 (for the GMU's 500 MHz)\n");
+	hold();
+	if (skip & 4) {
+		return true;
+	}
+	if (!pll0_on()) {
+		return false;
+	}
+	say("1: GMU clock from PLL0's even tap, hub clock 200 MHz from GPLL0\n");
+	hold();
+	if (skip & 8) {
+		return true;
+	}
+	if (!rcg_set(GMU_RCGR, 2u << 8 | 1, "gmu_clk_src") || !rcg_set(HUB_RCGR, 5u << 8 | 5, "hub_clk_src")) {
+		return false;
+	}
+	say("1: gpucc clocks on\n");
+	hold();
+	if (skip & 16) {
+		return true;
+	}
+	if (!clock_on(gpucc + 0x90bc, "ahb", false) || !clock_on(gpucc + 0x90e4, "cxo", true) ||
+	    !clock_on(gpucc + 0x93e8, "hub_aon", true) || !clock_on(gpucc + 0x90e8, "hub_cx_int", true) ||
+	    !clock_on(gpucc + 0x90d4, "cx_gmu", true) || !clock_on(gpucc + 0x90f4, "memnoc_gfx", false) ||
+	    !clock_on(gpucc + 0x7000, "smmu vote", false)) {
+		return false;
+	}
+	t0 = mach_absolute_time();
+	before = G(G8_GMU_ALWAYS_ON_COUNTER_L);
+	sleep_ms(10);
+	after = G(G8_GMU_ALWAYS_ON_COUNTER_L);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &nanos);
+	say("1: GMU crystal counter: %u Hz; sysreset %08x, fw version word %08x\n",
+	    nanos ? (uint32_t)((uint64_t)(after - before) * NSEC_PER_SEC / nanos) : 0, G(G8_GMU_CM3_SYSRESET),
+	    G(G8_GMU_CORE_FW_VERSION));
+	return true;
+}
+
+/* ---- memory the GPU block reaches through its SMMU ---------------------------------------------------- */
+
+/*
+ * As in redwood_adreno.c (where this was found out on the Adreno 642L): three levels of 4K pages,
+ * 39 bits of address, one SMMU context per address space, a stream table entry sending a stream
+ * through it. dada's device tree: streams 0 (the 3D core), 1 (its LPAC), 2 (secure), 5 (the GMU),
+ * all with mask 0.
+ */
+#define PTE_TABLE               3ull
+#define PTE_PAGE                3ull
+#define PTE_UNPRIVILEGED        (1ull << 6)
+#define PTE_READ_ONLY           (1ull << 7)
+#define PTE_SHARED              (2ull << 8)
+#define PTE_ACCESSED            (1ull << 10)
+#define PTE_NOT_GLOBAL          (1ull << 11)
+#define PTE_ADDRESS             0x0000fffffffff000ull
+#define PTE_GMU                 (PTE_SHARED | PTE_ACCESSED | PTE_NOT_GLOBAL)
+#define PTE_CORE                (PTE_GMU | PTE_UNPRIVILEGED)
+
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_CBAR(n)            (4 * (n))               /* in the second page */
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))       /* in the second page */
+#define SMMU_S2CR_FAULT         (2u << 16)
+#define SMMU_SMR_VALID          (1u << 31)
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+
+static const uint32_t smmu_page = 0x1000, smmu_pages = 32;      /* idr1 0x40000015: 4K pages, 32 before the contexts */
+
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+/*
+ * The tables of a GPU address space (4 KB granule, 39 bits, three levels). 8192 tables: the last level's map 2 MB each, so the
+ * space reaches 16 GB (DADA_ADDRESSES_SIZE; it was 2048 tables and 3.5 GB, one space for every client, which the system's
+ * Metal clients filled: posters and widgets were refused buffers of 4 MB). A table is found from the address an entry holds
+ * by a hash (it was a walk of every table, twice for each 4 KB page mapped), and only the tables written since the last commit
+ * are pushed out of the cache to the SMMU (it was every table, up to 8 MB, after each buffer mapped or unmapped).
+ */
+#define SPACE_TABLES            8192
+#define SPACE_HASH              16384           /* a power of two, twice SPACE_TABLES */
+
+struct gpu_space {
+	const char *name;
+	uint32_t context, control, table_count;
+	uint64_t *root;
+	struct {
+		uint64_t phys;
+		uint64_t *table;
+	} tables[SPACE_TABLES];
+	uint16_t hash[SPACE_HASH];              /* by physical page: the table's index + 1, 0 none */
+	uint16_t dirty[SPACE_TABLES];           /* the indexes written since the last commit */
+	uint32_t dirty_count;
+	uint8_t is_dirty[SPACE_TABLES];
+};
+
+static void
+space_dirty(struct gpu_space *space, uint32_t index)
+{
+	if (!space->is_dirty[index]) {
+		space->is_dirty[index] = 1;
+		space->dirty[space->dirty_count++] = (uint16_t)index;
+	}
+}
+
+/* the index of the table at `phys`, or -1 */
+static int
+space_find(struct gpu_space *space, uint64_t phys)
+{
+	for (uint32_t i = (uint32_t)(phys >> 12) & (SPACE_HASH - 1), n = 0; n < SPACE_HASH; i = (i + 1) & (SPACE_HASH - 1), n++) {
+		uint32_t at = space->hash[i];
+
+		if (at == 0) {
+			return -1;
+		}
+		if (space->tables[at - 1].phys == phys) {
+			return (int)(at - 1);
+		}
+	}
+	return -1;
+}
+
+/* a new zeroed table, -1 if none is left */
+static int
+space_new_table(struct gpu_space *space)
+{
+	static vm_offset_t spare;
+	static unsigned spare_left;
+	uint64_t *table;
+	uint32_t index;
+
+	if (space->table_count == SPACE_TABLES) {
+		return -1;
+	}
+	if (spare_left == 0) {
+		if (kmem_alloc(kernel_map, &spare, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			return -1;
+		}
+		spare_left = PAGE_SIZE / 4096;
+	}
+	table = (uint64_t *)(spare + PAGE_SIZE - 4096 * spare_left--);
+	index = space->table_count++;
+	space->tables[index].phys = kvtophys((vm_offset_t)table);
+	space->tables[index].table = table;
+	for (uint32_t i = (uint32_t)(space->tables[index].phys >> 12) & (SPACE_HASH - 1);; i = (i + 1) & (SPACE_HASH - 1)) {
+		if (space->hash[i] == 0) {
+			space->hash[i] = (uint16_t)(index + 1);
+			break;
+		}
+	}
+	space_dirty(space, index);
+	return (int)index;
+}
+
+/* the table `entry` of table `parent` points to, made if there is none; -1 if none can be */
+static int
+space_next(struct gpu_space *space, uint32_t parent, uint64_t *entry)
+{
+	int index;
+
+	if (*entry & 1) {
+		return space_find(space, *entry & PTE_ADDRESS);
+	}
+	index = space_new_table(space);
+	if (index >= 0) {
+		*entry = space->tables[index].phys | PTE_TABLE;
+		space_dirty(space, parent);
+	}
+	return index;
+}
+
+/* the last-level table for `address` (made if `make`), its index in *at; NULL if there is none */
+static uint64_t *
+space_leaf(struct gpu_space *space, uint64_t address, bool make, uint32_t *at)
+{
+	int level2, level3;
+
+	if (address >> 39) {
+		return NULL;
+	}
+	if (space->root == NULL) {
+		if (!make || space_new_table(space) != 0) {     /* the root is table 0 (space_on reads tables[0]) */
+			return NULL;
+		}
+		space->root = space->tables[0].table;
+	}
+	if (!make && !(space->root[address >> 30 & 0x1ff] & 1)) {
+		return NULL;
+	}
+	level2 = space_next(space, 0, &space->root[address >> 30 & 0x1ff]);
+	if (level2 < 0 || (!make && !(space->tables[level2].table[address >> 21 & 0x1ff] & 1))) {
+		return NULL;
+	}
+	level3 = space_next(space, (uint32_t)level2, &space->tables[level2].table[address >> 21 & 0x1ff]);
+	if (level3 < 0) {
+		return NULL;
+	}
+	*at = (uint32_t)level3;
+	return space->tables[level3].table;
+}
+
+static bool
+space_map(struct gpu_space *space, uint64_t address, uint64_t phys, uint64_t attributes)
+{
+	uint32_t at;
+	uint64_t *level3 = space_leaf(space, address, true, &at);
+
+	if (level3 == NULL) {
+		return false;
+	}
+	level3[address >> 12 & 0x1ff] = phys | attributes | PTE_PAGE;
+	space_dirty(space, at);
+	return true;
+}
+
+static void
+space_commit(struct gpu_space *space)
+{
+	for (uint32_t i = 0; i < space->dirty_count; i++) {
+		to_memory((vm_offset_t)space->tables[space->dirty[i]].table, 4096);
+		space->is_dirty[space->dirty[i]] = 0;
+	}
+	space->dirty_count = 0;
+}
+
+struct gpu_block {
+	uint64_t address;               /* the GPU's */
+	uint32_t size;
+	vm_offset_t memory;             /* ours */
+};
+
+static bool
+block_new(struct gpu_space *space, struct gpu_block *block, uint64_t address, uint32_t size, uint64_t attributes)
+{
+	block->address = address;
+	block->size = (size + 4095) & ~4095u;
+	if (kmem_alloc(kernel_map, &block->memory, round_page(block->size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("%u: no memory for %#x bytes\n", phase, block->size);
+		return false;
+	}
+	for (uint32_t offset = 0; offset < block->size; offset += 4096) {
+		if (!space_map(space, address + offset, kvtophys(block->memory + offset), attributes)) {
+			say("%u: no page table for %#llx\n", phase, address + offset);
+			return false;
+		}
+	}
+	to_memory(block->memory, block->size);
+	return true;
+}
+
+/* A view without this processor's cache, for memory both sides write a word at a time: blocks in one piece. */
+static vm_offset_t
+block_uncached(const struct gpu_block *block)
+{
+	uint64_t phys = kvtophys(block->memory);
+
+	for (uint32_t offset = 0; offset < block->size; offset += 4096) {
+		if (kvtophys(block->memory + offset) != phys + offset) {
+			return 0;
+		}
+	}
+	return ml_io_map_wcomb(phys, block->size);
+}
+
+static uint32_t
+smmu_context(const struct gpu_space *space)
+{
+	return (smmu_pages + space->context) * smmu_page;
+}
+
+static bool
+space_faulted(const struct gpu_space *space)
+{
+	uint32_t context = smmu_context(space), status = rd(smmu + context + SMMU_CB_FSR);
+
+	if ((status & SMMU_FSR_ALL) == 0) {
+		return false;
+	}
+	say("%u: THE SMMU REFUSED %s: fsr %08x far %08x%08x fsynr0 %08x\n", phase, space->name, status,
+	    rd(smmu + context + SMMU_CB_FAR + 4), rd(smmu + context + SMMU_CB_FAR), rd(smmu + context + SMMU_CB_FSYNR0));
+	return true;
+}
+
+static bool
+space_on(struct gpu_space *space, uint32_t match, uint32_t stream)
+{
+	uint32_t context = smmu_context(space);
+	uint64_t root = space->tables[0].phys | (uint64_t)space->context << 48;
+	uint32_t smr = SMMU_SMR_VALID | stream;
+
+	space_commit(space);
+	wr(smmu + context + SMMU_CB_SCTLR, 0);
+	wr(smmu + smmu_page + SMMU_CBA2R(space->context), 1);           /* 64-bit */
+	wr(smmu + smmu_page + SMMU_CBAR(space->context), SMMU_CBAR_STAGE_1);
+	wr(smmu + context + SMMU_CB_TCR2, SMMU_TCR2);
+	wr(smmu + context + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	wr(smmu + context + SMMU_CB_TTBR0, (uint32_t)root);
+	wr(smmu + context + SMMU_CB_TTBR0 + 4, (uint32_t)(root >> 32));
+	wr(smmu + context + SMMU_CB_TTBR1, 0);
+	wr(smmu + context + SMMU_CB_TTBR1 + 4, 0);
+	wr(smmu + context + SMMU_CB_MAIR0, SMMU_MAIR0);
+	wr(smmu + context + SMMU_CB_MAIR1, 0);
+	wr(smmu + context + SMMU_CB_FSR, SMMU_FSR_ALL);
+	wr(smmu + context + SMMU_CB_TLBIASID, space->context);
+	wr(smmu + context + SMMU_CB_TLBSYNC, 1);
+	if (!wait_bits(smmu + context + SMMU_CB_TLBSTATUS, 1, 0, 100)) {
+		say("%u: the SMMU does not finish a TLB sync\n", phase);
+		return false;
+	}
+	wr(smmu + context + SMMU_CB_SCTLR, SMMU_SCTLR_ON | space->control);
+	wr(smmu + SMMU_S2CR(match), space->context);
+	wr(smmu + SMMU_SMR(match), smr);
+	if (rd(smmu + SMMU_SMR(match)) != smr || (rd(smmu + SMMU_S2CR(match)) & 0x300ff) != space->context ||
+	    !(rd(smmu + context + SMMU_CB_SCTLR) & 1) || rd(smmu + context + SMMU_CB_TTBR0) != (uint32_t)root) {
+		say("%u: the SMMU did not take it: smr %08x s2cr %08x cbar %08x sctlr %08x ttbr0 %08x\n", phase,
+		    rd(smmu + SMMU_SMR(match)), rd(smmu + SMMU_S2CR(match)), rd(smmu + smmu_page + SMMU_CBAR(space->context)),
+		    rd(smmu + context + SMMU_CB_SCTLR), rd(smmu + context + SMMU_CB_TTBR0));
+		return false;
+	}
+	say("%u: stream %u goes through context %u (%s), %u tables\n", phase, stream, space->context, space->name,
+	    space->table_count);
+	return true;
+}
+
+static void
+space_off(struct gpu_space *space, uint32_t match)
+{
+	wr(smmu + SMMU_SMR(match), 0);
+	wr(smmu + SMMU_S2CR(match), SMMU_S2CR_FAULT);
+	wr(smmu + smmu_context(space) + SMMU_CB_SCTLR, 0);
+}
+
+/* ---- phase 2: the GMU's memory and firmware ----------------------------------------------------------- */
+
+/*
+ * Linux's a6xx_gmu_memory_probe for a8xx: "dummy" 16K at 0x60000000 (the firmware asks for its two
+ * pages there), "debug" 28K at 0x60400000, the instruction cache 16M - 16K at 0x4000 (the firmware's
+ * code blocks and the memory it asks for at 0x100000, 0x200000, 0x300000 lie in it), and a log and
+ * the message table wherever: here after the dummy.
+ */
+#define GMU_STREAM              5
+#define GMU_MATCH               1
+#define GMU_ITCM_ADDRESS        0x00000000u
+#define GMU_DTCM_ADDRESS        0x10004000u
+#define GMU_TCM_SIZE            0x4000u
+#define GMU_ICACHE_ADDRESS      0x00004000u
+#define GMU_ICACHE_SIZE         (0x1000000u - 0x4000u)
+#define GMU_DUMMY_ADDRESS       0x60000000u
+#define GMU_DUMMY_SIZE          0x4000u
+#define GMU_LOG_ADDRESS         0x60004000u
+#define GMU_LOG_SIZE            0x4000u
+#define GMU_HFI_ADDRESS         0x60008000u
+#define GMU_HFI_SIZE            0x4000u
+#define GMU_DEBUG_ADDRESS       0x60400000u
+#define GMU_DEBUG_SIZE          0x7000u
+
+static struct gpu_space gmu_space = { .name = "the GMU", .context = 1 };
+static struct gpu_block gmu_icache, gmu_dummy, gmu_log, gmu_hfi, gmu_debug;
+static const uint8_t *gmu_firmware;
+static uint64_t gmu_firmware_size;
+
+struct fw_block {
+	uint32_t address, size, type, value;
+};
+
+static const uint8_t *
+image_file(const char *name, uint64_t *size)
+{
+	const uint8_t *data = redwood_image_file("fw", name, size, NULL);
+
+	if (data == NULL) {
+		say("%u: no fw/%s in the small image (fw-gpu-dada/ and userland/build.sh)\n", phase, name);
+	}
+	return data;
+}
+
+static bool
+in_block(const struct gpu_block *b, uint32_t address, uint32_t size)
+{
+	return address >= b->address && address + size <= b->address + b->size;
+}
+
+static bool
+phase_gmu_firmware(void)
+{
+	struct gpu_block *blocks[] = { &gmu_icache, &gmu_dummy, &gmu_debug };
+	uint32_t wrong = 0, words = 0, in_memory = 0;
+
+	if (!cx_on()) {
+		return false;
+	}
+	gmu_firmware = image_file("gen80000_gmu.bin", &gmu_firmware_size);
+	if (gmu_firmware == NULL) {
+		return false;
+	}
+	say("2: memory for the GMU, its page tables\n");
+	if (!block_new(&gmu_space, &gmu_icache, GMU_ICACHE_ADDRESS, GMU_ICACHE_SIZE, PTE_GMU) ||
+	    !block_new(&gmu_space, &gmu_dummy, GMU_DUMMY_ADDRESS, GMU_DUMMY_SIZE, PTE_GMU) ||
+	    !block_new(&gmu_space, &gmu_log, GMU_LOG_ADDRESS, GMU_LOG_SIZE, PTE_GMU) ||
+	    !block_new(&gmu_space, &gmu_hfi, GMU_HFI_ADDRESS, GMU_HFI_SIZE, PTE_GMU) ||
+	    !block_new(&gmu_space, &gmu_debug, GMU_DEBUG_ADDRESS, GMU_DEBUG_SIZE, PTE_GMU)) {
+		return false;
+	}
+
+	say("2: the GMU's processor held in reset; its firmware, %llu bytes, into its memories\n", gmu_firmware_size);
+	hold();
+	Gw(G8_GMU_CM3_SYSRESET, 1);
+	for (int pass = 0; pass < 2; pass++) {
+		for (uint64_t at = 0; at + sizeof(struct fw_block) <= gmu_firmware_size;) {
+			struct fw_block block;
+			const uint8_t *data = gmu_firmware + at + sizeof(block);
+
+			memcpy(&block, gmu_firmware + at, sizeof(block));
+			at += sizeof(block) + block.size;
+			if (at > gmu_firmware_size) {
+				say("2: the file ends inside a block\n");
+				return false;
+			}
+			if (block.size == 0) {
+				continue;
+			}
+			if (block.address - GMU_ITCM_ADDRESS < GMU_TCM_SIZE || block.address - GMU_DTCM_ADDRESS < GMU_TCM_SIZE) {
+				uint32_t reg = block.address < GMU_DTCM_ADDRESS ?
+				    G8_GMU_CM3_ITCM_START + (block.address - GMU_ITCM_ADDRESS) / 4 :
+				    G8_GMU_CM3_DTCM_START + (block.address - GMU_DTCM_ADDRESS) / 4;
+
+				for (uint32_t offset = 0; offset + 4 <= block.size; offset += 4) {
+					uint32_t word;
+
+					memcpy(&word, data + offset, 4);
+					if (pass == 0) {
+						Gw(reg + offset / 4, word);
+						words++;
+					} else if (G(reg + offset / 4) != word) {
+						wrong++;
+					}
+				}
+				continue;
+			}
+			if (pass == 1) {
+				continue;
+			}
+			for (unsigned i = 0; i <= sizeof(blocks) / sizeof(blocks[0]); i++) {
+				if (i == sizeof(blocks) / sizeof(blocks[0])) {
+					say("2: a block for %#x (%#x bytes) has no memory\n", block.address, block.size);
+					return false;
+				}
+				if (in_block(blocks[i], block.address, block.size)) {
+					memcpy((void *)(blocks[i]->memory + (block.address - blocks[i]->address)), data, block.size);
+					in_memory += block.size;
+					break;
+				}
+			}
+		}
+	}
+	to_memory(gmu_icache.memory, gmu_icache.size);
+	to_memory(gmu_dummy.memory, gmu_dummy.size);
+	to_memory(gmu_debug.memory, gmu_debug.size);
+	say("2: %u words through the GMU's registers (%u read back wrong), %u bytes in memory; version word %08x\n", words,
+	    wrong, in_memory, G(G8_GMU_CORE_FW_VERSION));
+	if (wrong) {
+		return false;
+	}
+
+	say("2: SMMU context %u for the GMU's stream %u (the first SMMU writes)\n", gmu_space.context, GMU_STREAM);
+	hold();
+	gmu_space_on = true;
+	return space_on(&gmu_space, GMU_MATCH, GMU_STREAM) && !space_faulted(&gmu_space);
+}
+
+/* ---- phase 3: the GMU started, its message queues ----------------------------------------------------- */
+
+struct hfi_queue_header {
+	uint32_t status, iova, type, size, msg_size, dropped, rx_watermark, tx_watermark, rx_request, tx_request, read_index,
+	    write_index;
+};
+struct hfi_table_header {
+	uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues;
+};
+#define HFI_QUEUES              3
+#define HFI_QUEUE_WORDS         1024
+
+static volatile uint8_t *hfi;           /* the uncached view of the HFI block */
+
+static volatile struct hfi_queue_header *
+hfi_header(unsigned n)
+{
+	return (volatile struct hfi_queue_header *)(hfi + sizeof(struct hfi_table_header)) + n;
+}
+
+static volatile uint32_t *
+hfi_data(unsigned n)
+{
+	return (volatile uint32_t *)(hfi + 4096 * (n + 1));
+}
+
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_INTERRUPTED         1
+
+static int32_t
+scm(uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+static void
+gmu_log_tail(void)
+{
+	const volatile uint32_t *log = (const volatile uint32_t *)gmu_log.memory;
+	uint32_t next = G(G8_GMU_GENERAL_9) & 0xffff;
+
+	to_memory(gmu_log.memory, gmu_log.size);
+	say("%u: GMU: init %08x hfi %08x g2h %08x ao %08x pwr %08x rpmh %08x log at %u\n", phase,
+	    G(G8_GMU_CM3_FW_INIT_RESULT), G(G8_GMU_HFI_CTRL_STATUS), G(G8_GMU_GMU2HOST_INTR_INFO),
+	    G(G8_GMU_AO_HOST_INTERRUPT_STATUS), G(G8_GMU_PWR_CLK_STATUS), G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE), next);
+	for (uint32_t i = next > 16 ? next - 16 : 0; i < next && i + 2 <= GMU_LOG_SIZE / 16; i += 2) {
+		say("%u:   log %x %x %x %x | %x %x %x %x\n", phase, log[4 * i], log[4 * i + 1], log[4 * i + 2], log[4 * i + 3],
+		    log[4 * i + 4], log[4 * i + 5], log[4 * i + 6], log[4 * i + 7]);
+	}
+	space_faulted(&gmu_space);
+}
+
+static bool
+phase_gmu_start(void)
+{
+	uint32_t version, mask, started, result = 0;
+	uint64_t answer = ~0ull;
+	int32_t r;
+	volatile struct hfi_table_header *table;
+
+	if (!gmu_space_on) {
+		return false;
+	}
+	hfi = (volatile uint8_t *)block_uncached(&gmu_hfi);
+	if (hfi == NULL) {
+		say("3: the HFI block is not in one piece\n");
+		return false;
+	}
+	table = (volatile struct hfi_table_header *)hfi;
+	table->version = 0;
+	table->size = sizeof(struct hfi_table_header) + HFI_QUEUES * sizeof(struct hfi_queue_header);
+	table->qhdr0_offset = sizeof(struct hfi_table_header) / 4;
+	table->qhdr_size = sizeof(struct hfi_queue_header) / 4;
+	table->num_queues = table->active_queues = HFI_QUEUES;
+	for (unsigned i = 0; i < HFI_QUEUES; i++) {
+		volatile struct hfi_queue_header *h = hfi_header(i);
+
+		h->iova = GMU_HFI_ADDRESS + 4096 * (i + 1);
+		h->type = 10u << 8 | i;
+		h->status = 1;
+		h->size = HFI_QUEUE_WORDS;
+		h->msg_size = h->dropped = 0;
+		h->rx_watermark = h->tx_watermark = h->rx_request = 1;
+		h->tx_request = 0;
+		h->read_index = h->write_index = 0;
+	}
+	__asm__ volatile ("dsb sy");
+
+	/* a6xx_gmu_secure_init: TrustZone sets the GPU's software fuses (a750 and a8xx) */
+	say("3: TrustZone: gpu_init_regs (always-on, tsense)\n");
+	hold();
+	r = scm(SCM_64 | SCM_SIP | SCM_CALL(0x28, 1), 1, 1u << 0 | 1u << 3, 0, 0, &answer);
+	say("3: TrustZone returns %d (%#llx); sw fuse value %08x\n", r, answer, X(G8_CX_MISC_CX_MISC_SW_FUSE_VALUE));
+
+	say("3: the GMU's registers before its start (a6xx_gmu_fw_start, a8xx)\n");
+	hold();
+	Gw(G8_GMU_AO_HOST_INTERRUPT_CLR, 0xffffffff);
+	Gw(G8_GMU_AO_HOST_INTERRUPT_MASK, 0xffffffff);
+	Gw(G8_GMU_GMU2HOST_INTR_CLR, 0xffffffff);
+	Gw(G8_GMU_GMU2HOST_INTR_MASK, 0xffffffff);
+	Gw(G8_GPU_GMU_CX_GMU_CX_FALNEXT_INTF, 1);
+	Gw(G8_GPU_GMU_CX_GMU_CX_FAL_INTF, 1);
+	if (R(G8_GPU_RSCC_RSC_STATUS0_DRV0) & (1u << 16)) {     /* its RPMh channel asleep: wake it (a6xx_rpmh_start) */
+		Gw(G8_GMU_RSCC_CONTROL_REQ, 2);
+		wait_bits(gpu + 4UL * G8_GMU_RSCC_CONTROL_ACK, 2, 2, 10);
+		wait_bits(gpu + RSCC_OFFSET + 4UL * G8_RSCC_SEQ_BUSY_DRV0, ~0u, 0, 10);
+		Gw(G8_GMU_RSCC_CONTROL_REQ, 0);
+	}
+	say("3: rscc status0 %08x seq busy %08x\n", R(G8_GPU_RSCC_RSC_STATUS0_DRV0), R(G8_RSCC_SEQ_BUSY_DRV0));
+	Gw(G8_GMU_CM3_FW_INIT_RESULT, 0);
+	Gw(G8_GMU_CM3_BOOT_CONFIG, 2);
+	Gw(G8_GMU_HFI_QTBL_ADDR, GMU_HFI_ADDRESS);
+	Gw(G8_GMU_HFI_QTBL_INFO, 1);
+	Gw(G8_GMU_AHB_FENCE_RANGE_0, 1u << 31 | 0x32u << 18 | 0x8c0);
+	Gw(G8_GMU_CM3_CFG, 0x4052);
+	Gw(G8_GMU_GENERAL_10, 0x8000100);       /* a830's gmu_chipid */
+	Gw(G8_GMU_GENERAL_8, (GMU_LOG_ADDRESS & 0xfffff000u) | (GMU_LOG_SIZE / 4096 - 1));
+	for (unsigned i = 0; i < 4; i++) {
+		Gw(G8_GBIF_QSB_SIDE0 + i, 0x00071e20);
+	}
+	Gw(G8_GBIF_CX_CONFIG, 0x20023000);
+	Gw(G8_GMU_MRC_GBIF_QOS_CTRL, 0x33);
+	Gw(G8_GMU_SYS_BUS_CONFIG, 1);
+	Gw(G8_GMU_ICACHE_CONFIG, 1);
+	Gw(G8_GMU_DCACHE_CONFIG, 1);
+
+	version = G(G8_GMU_CORE_FW_VERSION);
+	if (version <= 0x20010004) {
+		mask = 0xffffffff;
+		started = 0xbabeface;
+	} else {
+		mask = 0x1ff;
+		started = 0x100;
+	}
+	say("3: the GMU's processor out of reset (firmware %08x)\n", version);
+	hold();
+	Gw(G8_GMU_CM3_SYSRESET, 1);
+	Gw(G8_GMU_GENERAL_9, 0);
+	gmu_runs = true;
+	Gw(G8_GMU_CM3_SYSRESET, 0);
+	for (int i = 0; i < 1000 && (result & mask) != started; i++) {
+		sleep_us(100);
+		result = G(G8_GMU_CM3_FW_INIT_RESULT);
+	}
+	if ((result & mask) != started) {
+		say("3: the GMU's firmware does not come up (init result %08x)\n", result);
+		gmu_log_tail();
+		return false;
+	}
+	say("3: THE GMU'S FIRMWARE RUNS (init result %08x)\n", result);
+
+	Gw(G8_GMU_HFI_CTRL_INIT, 1);
+	if (!wait_bits(gpu + 4UL * G8_GMU_HFI_CTRL_STATUS, 1, 1, 1000)) {
+		say("3: the GMU does not start its message queues\n");
+		gmu_log_tail();
+		return false;
+	}
+	say("3: THE GMU'S MESSAGE QUEUES ARE UP (hfi status %08x)\n", G(G8_GMU_HFI_CTRL_STATUS));
+	return !space_faulted(&gmu_space);
+}
+
+/* ---- phase 4: the GMU's tables, and the 3D core's power ----------------------------------------------- */
+
+#define HFI_MSG_BW_TABLE        3
+#define HFI_MSG_START           10
+#define HFI_MSG_CORE_FW_START   14
+#define HFI_MSG_TABLE           15
+#define HFI_MSG_GX_BW_PERF_VOTE 30
+#define HFI_MSG_PREPARE_SLUMBER 33
+#define HFI_F2H_ERROR           100
+#define HFI_TABLE_GPU_PERF      1
+
+static uint32_t hfi_seqnum;
+
+/* everything waiting in a queue of the GMU's; true if the answer to `seqnum` was among it */
+static bool
+hfi_receive(unsigned which, uint32_t seqnum, uint32_t *error)
+{
+	volatile struct hfi_queue_header *h = hfi_header(which);
+	volatile uint32_t *data = hfi_data(which);
+	bool answered = false;
+
+	while (h->read_index != h->write_index) {
+		uint32_t message[8] = { 0 }, at = h->read_index % HFI_QUEUE_WORDS, words = data[at] >> 8 & 0xff;
+
+		for (uint32_t i = 0; i < words; i++) {
+			if (i < 8) {
+				message[i] = data[at];
+			}
+			at = (at + 1) % HFI_QUEUE_WORDS;
+		}
+		h->read_index = (at + 3) / 4 * 4 % HFI_QUEUE_WORDS;
+		if ((message[0] >> 16 & 0xf) == 1 && (message[1] >> 20) == seqnum) {
+			*error = message[2];
+			answered = true;
+		} else if ((message[0] & 0xff) == HFI_F2H_ERROR) {
+			say("%u: THE GMU REPORTS AN ERROR: %08x %08x %08x %08x\n", phase, message[1], message[2], message[3],
+			    message[4]);
+		} else {
+			say("%u: the GMU says (queue %u, %u words): %08x %08x %08x %08x\n", phase, which, words, message[0],
+			    message[1], message[2], message[3]);
+		}
+		if (words == 0) {
+			break;
+		}
+	}
+	return answered;
+}
+
+static bool hfi_quiet;                  /* the governor's speed votes, many a second: not each said */
+
+static bool
+hfi_send(const char *what, uint32_t id, uint32_t *message, uint32_t words)
+{
+	volatile struct hfi_queue_header *h = hfi_header(0);
+	volatile uint32_t *data = hfi_data(0);
+	uint32_t at = h->write_index % HFI_QUEUE_WORDS, seqnum = ++hfi_seqnum % 0xfff, error = 0;
+	bool answered = false;
+
+	message[0] = seqnum << 20 | words << 8 | id;
+	if (!hfi_quiet) {
+		say("%u: to the GMU: %s (message %u, %u words)\n", phase, what, id, words);
+	}
+	for (uint32_t i = 0; i < (words + 3) / 4 * 4; i++) {
+		data[at] = i < words ? message[i] : 0xfafafafa;
+		at = (at + 1) % HFI_QUEUE_WORDS;
+	}
+	__asm__ volatile ("dsb sy");
+	h->write_index = at;
+	__asm__ volatile ("dsb sy");
+	Gw(G8_GMU_HOST2GMU_INTR_SET, 1);
+	for (int i = 0; i < 10000 && !answered; i++) {
+		sleep_us(100);
+		if (G(G8_GMU_GMU2HOST_INTR_INFO) & 1) {
+			Gw(G8_GMU_GMU2HOST_INTR_CLR, 1);
+			answered = hfi_receive(1, seqnum, &error);
+		}
+	}
+	hfi_receive(2, ~0u, &error);
+	if (!answered || error != 0) {
+		say("%u: the GMU %s (%#x) to %s\n", phase, answered ? "says no" : "does not answer", error, what);
+		gmu_log_tail();
+		return false;
+	}
+	return true;
+}
+
+/* dt: aop_cmd_db_region: the boot loader's list of what RPMh can switch (drivers/soc/qcom/cmd-db.c) */
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static const struct cmd_db_header *cmd_db;
+
+/*
+ * cmd_db_read_addr and cmd_db_read_aux_data in one: the resource's address (0 if cmd-db lacks it), and where its
+ * auxiliary data lies and how long it is (rsc_offset: the slave's data_offset plus the entry's offset). For a rail
+ * (gfx.lvl and the like) that data is its list of levels; for a bus clock manager (SH0, MC0, ACV) it is
+ * struct bcm_db {le32 unit, le16 width, u8 vcd, u8 reserved}, which a6xx_gmu_rpmh_bw_votes_init turns into votes.
+ */
+static uint32_t
+rpmh_entry(const char *name, const uint8_t **aux, unsigned *aux_length)
+{
+	char id[8] = { 0 };
+
+	*aux = NULL;
+	*aux_length = 0;
+	if (cmd_db == NULL) {
+		cmd_db = (const struct cmd_db_header *)ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);
+	}
+	if (cmd_db->magic[0] != 0xdb || cmd_db->magic[1] != 0x30 || cmd_db->magic[2] != 0x03 || cmd_db->magic[3] != 0x0c) {
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &cmd_db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(cmd_db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) != 0) {
+				continue;
+			}
+			*aux = cmd_db->data + slave->data_offset + entry[i].offset;
+			*aux_length = entry[i].length;
+			return entry[i].address;
+		}
+	}
+	return 0;
+}
+
+static uint32_t
+rpmh_resource(const char *name, uint16_t *levels, unsigned *level_count)
+{
+	const uint8_t *data;
+	unsigned length;
+	uint32_t address = rpmh_entry(name, &data, &length);
+
+	if (level_count != NULL) {
+		*level_count = 0;
+	}
+	for (unsigned l = 0; address != 0 && levels != NULL && l < length / 2u && l < 16; l++) {
+		levels[l] = (uint16_t)(data[2 * l] | data[2 * l + 1] << 8);
+		if (l > 0 && levels[l] == 0) {
+			break;
+		}
+		*level_count = l + 1;
+	}
+	return address;
+}
+
+/* a6xx_gmu_rpmh_arc_index: the first level at least `level` (or the highest) */
+static unsigned
+arc_index(const uint16_t *list, unsigned count, uint32_t level)
+{
+	for (unsigned i = 0; i < count; i++) {
+		if (list[i] >= level) {
+			return i;
+		}
+	}
+	return count ? count - 1 : 0;
+}
+
+/* a6xx_gmu_rpmh_arc_votes_init: the rail's level, its index, and the index of the secondary rail's level */
+static uint32_t
+arc_vote(uint32_t level, const uint16_t *pri, unsigned pri_count, const uint16_t *sec, unsigned sec_count)
+{
+	unsigned p = arc_index(pri, pri_count, level), s = arc_index(sec, sec_count, pri[p]);
+
+	return (uint32_t)pri[p] << 16 | s << 8 | p;
+}
+
+/*
+ * dada's speeds of its 3D core: all of dt qcom,gpu-pwrlevels-0 (speed bin 0xbe, the lowest bin: every bin has
+ * these, the faster ones add 967 MHz and up), 160 to 900 MHz with their RPMh levels and their qcom,bus-freq (an
+ * index in qcom,bus-table-ddr, below: the memory bandwidth KGSL asks for along with that speed); and the GMU's (dt
+ * qcom,gmu-freq-table: 500 MHz at 64, 650 MHz at 128), plus "off". (Until 27 October only the four lowest were
+ * in the table and the GPU ran at 160 MHz: every submission took 2 ms of GPU and the home screen crawled.)
+ *
+ * Room for 16: a6xx_hfi_msg_perf_table's gx_votes[16], and KGSL's own limit of 16 pwrlevels (a8xx_hfi_send_perf_table
+ * builds its message to fit, but the GMU firmware is KGSL's). A faster bin's levels are appended by gpu_speeds_choose,
+ * so the list stays in ascending order and every index the governor (hakios_dada_cpu.c) knows keeps its speed.
+ */
+struct gpu_speed {
+	uint32_t hz, level, bus;
+};
+#define GPU_SPEEDS_MAX          16
+static struct gpu_speed gpu_speeds[GPU_SPEEDS_MAX] = { { 0, 0, 0 }, { 160000000, 0x32, 2 }, { 222000000, 0x34, 2 },
+	                                               { 342000000, 0x38, 3 }, { 389000000, 0x3c, 4 }, { 443000000, 0x40, 4 },
+	                                               { 525000000, 0x50, 4 }, { 607000000, 0x80, 6 }, { 660000000, 0x90, 6 },
+	                                               { 734000000, 0xc0, 8 }, { 832000000, 0xe0, 10 }, { 900000000, 0x100, 11 } };
+#define GPU_SPEEDS_BASE         12              /* bin 0xbe's eleven and "off" */
+static uint32_t gpu_speed_count = GPU_SPEEDS_BASE;
+#define GPU_SPEEDS              gpu_speed_count
+/* the speed the 3D core runs at: boot-arg dadagpu_speed=N, an index in gpu_speeds (default 9: 734 MHz) */
+static TUNABLE(uint32_t, gpu_speed_index, "dadagpu_speed", 9);
+static const struct {
+	uint32_t hz, level;
+} gmu_speeds[] = { { 0, 0 }, { 500000000, 0x40 }, { 650000000, 0x80 } };
+#define GMU_SPEEDS              (sizeof(gmu_speeds) / sizeof(gmu_speeds[0]))
+
+/*
+ * The speed bin: dt nvmem-cells "speed_bin" -> qfprom@221c8000's gpu_speed_bin@138 (reg <0x138 2>, bits <0 9>), which
+ * adreno_read_speedbin reads and the catalog's ADRENO_SPEEDBINS for chip 0x44050001 knows as 190 (0xbe), 221 (0xdd),
+ * 232 (0xe8), 242 and 252; this device tree has pwrlevels for the first three only. The faster bins' extra levels
+ * (qcom,gpu-pwrlevels-1, bin 0xdd: to 1050 MHz; -2, bin 0xe8: to 1100 MHz) all vote the top DDR level, and in both
+ * bins 900 MHz votes bus level 10 where bin 0xbe has 11. (Bin 0xe8 also lacks 160 MHz; it stays here, so the
+ * governor's indexes keep their speeds.) Boot-arg dadagpu_bin=1 appends them when the fuse says so; the default 0 only
+ * says what the fuse would allow. dadagpu_fuse=0 does not even read it.
+ */
+#define QFPROM_PHYS             0x221c8000UL    /* dt qfprom@221c8000, read-only: the fuses' corrected copy */
+#define QFPROM_SIZE             0x1000UL
+#define GPU_SPEED_BIN_FUSE      0x138UL
+static const struct {
+	uint32_t fuse, max_mhz, extra, bus_900;
+	struct gpu_speed speed[3];
+} gpu_bins[] = {
+	{ 0xbe, 900, 0, 11, { { 0, 0, 0 } } },
+	{ 0xdd, 1050, 2, 10, { { 967000000, 0x140, 11 }, { 1050000000, 0x1a0, 11 } } },
+	{ 0xe8, 1100, 3, 10, { { 967000000, 0x140, 11 }, { 1050000000, 0x1a0, 11 }, { 1100000000, 0x1c0, 11 } } },
+};
+static TUNABLE(uint32_t, gpu_bin_on, "dadagpu_bin", 0);
+/*
+ * (default 0 since 29 October: reading qfprom stopped the whole SoC some 28 s into boot -- the hypervisor's, as for the
+ * display and the Wi-Fi's stream -- g2k36b/g2k46. The bin is given instead: dadagpu_bin=0xe8, what Android's kgsl
+ * reports for this phone -- gpu_available_frequencies to 1100 MHz.)
+ */
+static TUNABLE(uint32_t, gpu_fuse_on, "dadagpu_fuse", 0);
+
+/*
+ * Reads the fuse and, with dadagpu_bin=1, grows gpu_speeds by the bin's faster levels. Called from
+ * hakios_dada_gpu_init and from hakios_dada_gpu_speeds (the governor may ask first: hakios_dada_cpu_init starts it
+ * just before the GPU's init): it writes the same values each time, so two at once do no harm.
+ */
+static void
+gpu_speeds_choose(void)
+{
+	static vm_offset_t qfprom;
+	static bool told;
+	uint16_t gfx[16];
+	unsigned gfx_n = 0, b = 0, count = GPU_SPEEDS_BASE;
+	uint32_t fuse;
+
+	if (gpu_bin_on > 1) {
+		fuse = gpu_bin_on & 0x1ff;      /* dadagpu_bin=BIN: that bin, the fuse not read */
+	} else if (!gpu_fuse_on) {
+		if (!told) {
+			say("speed bin: the fuse not read (dadagpu_fuse=0): bin 0xbe's levels, to 900 MHz\n");
+		}
+		told = true;
+		return;
+	}
+	if (gpu_bin_on <= 1) {
+		if (qfprom == 0) {
+			qfprom = ml_io_map(QFPROM_PHYS, QFPROM_SIZE);
+		}
+		/* qfprom_reg_read: byte by byte; nvmem's bits <0 9>: the low nine bits of the little-endian pair */
+		fuse = (*(volatile uint8_t *)(qfprom + GPU_SPEED_BIN_FUSE) |
+		    (uint32_t)*(volatile uint8_t *)(qfprom + GPU_SPEED_BIN_FUSE + 1) << 8) & 0x1ff;
+	}
+	while (b < sizeof(gpu_bins) / sizeof(gpu_bins[0]) && gpu_bins[b].fuse != fuse) {
+		b++;
+	}
+	if (b == sizeof(gpu_bins) / sizeof(gpu_bins[0])) {
+		if (!told) {
+			say("speed bin: the fuse says %#x (%u), not a bin of the device tree's: bin 0xbe's levels, to 900 MHz\n",
+			    fuse, fuse);
+		}
+		told = true;
+		return;
+	}
+	if (gpu_bin_on && gpu_bins[b].extra != 0) {
+		/* a6xx_gmu_rpmh_arc_votes_init gives up on a level gfx.lvl lacks; here such a level is left out */
+		(void)rpmh_resource("gfx.lvl", gfx, &gfx_n);
+		for (unsigned i = 0; i < gpu_bins[b].extra && count < GPU_SPEEDS_MAX; i++) {
+			if (gfx_n == 0 || gpu_bins[b].speed[i].level > gfx[gfx_n - 1]) {
+				if (!told) {
+					say("speed bin: RPMh's gfx rail lacks level %#x: %u MHz left out\n", gpu_bins[b].speed[i].level,
+					    gpu_bins[b].speed[i].hz / 1000000);
+				}
+				break;
+			}
+			gpu_speeds[count++] = gpu_bins[b].speed[i];
+		}
+		if (count > GPU_SPEEDS_BASE) {
+			gpu_speeds[GPU_SPEEDS_BASE - 1].bus = gpu_bins[b].bus_900;
+		}
+		gpu_speed_count = count;
+	}
+	if (!told) {
+		say("speed bin: the fuse says %#x: bin %#x allows %u MHz; %s, to %u MHz (%u speeds)\n", fuse, gpu_bins[b].fuse,
+		    gpu_bins[b].max_mhz, count > GPU_SPEEDS_BASE ? "its levels used (dadagpu_bin=1)" :
+		    gpu_bins[b].extra != 0 ? "bin 0xbe's levels used (dadagpu_bin=0)" : "its levels used",
+		    gpu_speeds[count - 1].hz / 1000000, count);
+	}
+	told = true;
+}
+
+/*
+ * The GMU's bus table (struct a6xx_hfi_msg_bw_table, the same for gen8 in KGSL's hfi_bwtable_cmd): header,
+ * bw_level_num, cnoc_cmds_num, ddr_cmds_num, cnoc_wait_bitmask, ddr_wait_bitmask, cnoc_cmds_addrs[6],
+ * cnoc_cmds_data[2][6], ddr_cmds_addrs[8], ddr_cmds_data[16][8]: 160 words.
+ */
+#define BW_LEVELS_MAX           16
+#define BW_CNOC_ADDRS           6
+#define BW_CNOC_DATA            12              /* [level][cmd] at 12 + 6 level + cmd */
+#define BW_DDR_ADDRS            24
+#define BW_DDR_DATA             32              /* [level][cmd] at 32 + 8 level + cmd */
+#define BW_WORDS                (BW_DDR_DATA + 8 * BW_LEVELS_MAX)
+/* include/soc/qcom/tcs.h: commit (30), valid (29), vote x (27:14), vote y (13:0) */
+#define BCM_TCS_CMD(commit, valid, x, y) \
+	((uint32_t)(commit) << 30 | (uint32_t)(valid) << 29 | ((uint32_t)(x) & 0x3fff) << 14 | ((uint32_t)(y) & 0x3fff))
+
+/* dt qcom,bus-table-ddr: the memory bandwidths a pwrlevel's qcom,bus-freq points at, in KB/s; 0 is "off" */
+static const uint32_t ddr_kbps[] = { 0, 781250, 2136718, 5285156, 6074218, 6671875, 8171875, 10687500, 12449218,
+	                             14398437, 16500000, 18597656 };
+_Static_assert(sizeof(ddr_kbps) / sizeof(ddr_kbps[0]) <= BW_LEVELS_MAX, "the GMU's bus table has 16 levels");
+
+/*
+ * a8xx_catalog.c, chip 0x44050001: the bus clock managers the GMU votes on for the 3D core's memory traffic. SH0 (the
+ * shared hub) and MC0 (the memory controller) by bandwidth over their bus width; ACV a fixed vote, with its perfmode
+ * bit from 10687500 KB/s (bus level 7) up.
+ */
+static const struct {
+	const char *name;
+	uint32_t buswidth;
+	bool fixed;
+	uint32_t perfmode, perfmode_kbps;
+} gpu_bcms[] = { { "SH0", 16, false, 0, 0 }, { "MC0", 4, false, 0, 0 }, { "ACV", 0, true, 1u << 2, 10687500 } };
+#define GPU_BCMS                (sizeof(gpu_bcms) / sizeof(gpu_bcms[0]))
+
+/* boot-arg dadagpu_bw=0: the single "off" level of before, so the GMU never votes memory bandwidth (A/B) */
+static TUNABLE(uint32_t, gpu_bw_on, "dadagpu_bw", 1);
+static uint32_t bus_levels = 1;                 /* the levels the GMU's bus table has; 1: every bw index is 0 */
+
+/* the bw index a GX_BW_PERF_VOTE carries with gpu_speeds[speed]: its pwrlevel's qcom,bus-freq, if the table has it */
+static uint32_t
+gpu_bus_index(uint32_t speed)
+{
+	return speed < GPU_SPEEDS && gpu_speeds[speed].bus < bus_levels ? gpu_speeds[speed].bus : 0;
+}
+
+/*
+ * a6xx_hfi_send_bw_table's message: a6xx_gmu_rpmh_bw_votes_init's votes for each of qcom,bus-table-ddr's levels, laid
+ * out by a6xx_generate_bw_table. Each BCM's vote is the bandwidth times cmd-db's width for it over the catalog's bus
+ * width, in bytes a second over cmd-db's unit; x and y alike on a7xx and a8xx; commit on the last BCM of each virtual
+ * clock domain; "off" (bandwidth 0) valid nowhere. CN0, the configuration bus, as before: off, or on with 1.
+ * Without the BCMs' data in cmd-db, or with dadagpu_bw=0, the single "off" level of before (a740_build_bw_table).
+ */
+static bool
+bus_table_fill(uint32_t *bw)
+{
+	const uint8_t *aux[GPU_BCMS];
+	unsigned aux_length[GPU_BCMS], levels = gpu_bw_on ? sizeof(ddr_kbps) / sizeof(ddr_kbps[0]) : 1;
+	uint32_t unit[GPU_BCMS] = { 0 }, width[GPU_BCMS] = { 0 }, vcd[GPU_BCMS] = { 0 };
+
+	bzero(bw, BW_WORDS * 4);
+	bw[2] = 1;                              /* cnoc commands */
+	bw[3] = GPU_BCMS;                       /* ddr commands */
+	bw[4] = 1;                              /* cnoc wait mask: CN0 commits */
+	bw[BW_CNOC_ADDRS] = rpmh_resource("CN0", NULL, NULL);
+	bw[BW_CNOC_DATA] = BCM_TCS_CMD(1, 0, 0, 0);
+	bw[BW_CNOC_DATA + 6] = BCM_TCS_CMD(1, 1, 0, 1);
+	for (unsigned j = 0; j < GPU_BCMS; j++) {
+		bw[BW_DDR_ADDRS + j] = rpmh_entry(gpu_bcms[j].name, &aux[j], &aux_length[j]);
+		if (bw[BW_DDR_ADDRS + j] != 0 && aux_length[j] >= 8) {
+			unit[j] = aux[j][0] | aux[j][1] << 8 | aux[j][2] << 16 | (uint32_t)aux[j][3] << 24;
+			width[j] = aux[j][4] | aux[j][5] << 8;
+			vcd[j] = aux[j][6];
+		}
+		if (aux_length[j] < 8 || (!gpu_bcms[j].fixed && unit[j] == 0)) {
+			levels = 1;
+		}
+	}
+	say("4: bus: CN0 %#x SH0 %#x MC0 %#x ACV %#x; cmd-db unit/width/vcd: SH0 %u/%u/%u MC0 %u/%u/%u ACV %u/%u/%u\n",
+	    bw[BW_CNOC_ADDRS], bw[BW_DDR_ADDRS], bw[BW_DDR_ADDRS + 1], bw[BW_DDR_ADDRS + 2], unit[0], width[0], vcd[0],
+	    unit[1], width[1], vcd[1], unit[2], width[2], vcd[2]);
+	if (!bw[BW_CNOC_ADDRS] || !bw[BW_DDR_ADDRS] || !bw[BW_DDR_ADDRS + 1] || !bw[BW_DDR_ADDRS + 2]) {
+		return false;
+	}
+
+	if (levels == 1) {
+		bw[1] = 1;
+		bw[5] = 7;                      /* ddr wait mask */
+		for (unsigned j = 0; j < GPU_BCMS; j++) {
+			bw[BW_DDR_DATA + j] = BCM_TCS_CMD(1, 0, 0, 0);
+		}
+		bus_levels = 1;
+		say("4: bus table: the one \"off\" level (%s)\n", gpu_bw_on ? "cmd-db lacks the BCMs' data" : "dadagpu_bw=0");
+		return true;
+	}
+
+	for (unsigned i = 0; i < levels; i++) {
+		uint32_t *data = &bw[BW_DDR_DATA + 8 * i];
+
+		for (unsigned j = 0; j < GPU_BCMS; j++) {
+			bool commit = j == GPU_BCMS - 1 || vcd[j] != vcd[j + 1];
+			uint64_t peak;
+			uint32_t vote;
+
+			if (ddr_kbps[i] == 0) {
+				data[j] = BCM_TCS_CMD(commit, 0, 0, 0);
+			} else if (gpu_bcms[j].fixed) {
+				/* a7xx and a8xx vote perfmode only from perfmode_bw up (a6xx on every valid level) */
+				data[j] = BCM_TCS_CMD(commit, 1, 0,
+				    gpu_bcms[j].perfmode_kbps && ddr_kbps[i] >= gpu_bcms[j].perfmode_kbps ? gpu_bcms[j].perfmode : 0);
+			} else {
+				peak = (uint64_t)ddr_kbps[i] * width[j] / gpu_bcms[j].buswidth;
+				peak = peak * 1000 / unit[j];   /* KB/s to bytes a second, then to the BCM's unit */
+				vote = (uint32_t)(peak < 1 ? 1 : peak > 0x3fff ? 0x3fff : peak);
+				data[j] = BCM_TCS_CMD(commit, 1, vote, vote);
+			}
+		}
+		say("4: bus level %2u: %8u KB/s: SH0 %08x MC0 %08x ACV %08x\n", i, ddr_kbps[i], data[0], data[1], data[2]);
+	}
+	/* a6xx_generate_bw_table: wait for each BCM whose "off" command commits */
+	bw[5] = 0;
+	for (unsigned j = 0; j < GPU_BCMS; j++) {
+		if (bw[BW_DDR_DATA + j] & BCM_TCS_CMD(1, 0, 0, 0)) {
+			bw[5] |= 1u << j;
+		}
+	}
+	bw[1] = levels;
+	bus_levels = levels;
+	say("4: bus table: %u levels, ddr wait mask %#x\n", levels, bw[5]);
+	return true;
+}
+
+static bool
+phase_core_power(void)
+{
+	static uint32_t perf[3 + 2 + 3 * GPU_SPEEDS_MAX + 2 + 2 * GMU_SPEEDS];
+	static uint32_t bw[BW_WORDS];
+	uint32_t empty[2] = { 0, 0 }, vote[4] = { 0 }, granted = 0, at = 0;
+	uint16_t gfx[16], mx[16], cx[16], gmxc[16];
+	unsigned gfx_n, mx_n, cx_n, gmxc_n;
+
+	if (!gmu_runs) {
+		return false;
+	}
+	if (!rpmh_resource("gfx.lvl", gfx, &gfx_n) || !rpmh_resource("mx.lvl", mx, &mx_n) ||
+	    !rpmh_resource("cx.lvl", cx, &cx_n)) {
+		say("4: RPMh's list lacks a rail\n");
+		return false;
+	}
+	if (!rpmh_resource("gmxc.lvl", gmxc, &gmxc_n)) {
+		memcpy(gmxc, mx, sizeof(mx));
+		gmxc_n = mx_n;
+	}
+	say("4: rails: gfx %u levels (top %u), mx %u, cx %u, gmxc %u\n", gfx_n, gfx_n ? gfx[gfx_n - 1] : 0, mx_n, cx_n, gmxc_n);
+
+	/* a8xx_hfi_send_perf_table: a "table" message of type GPU_PERF with two entries */
+	perf[at++] = 0;                         /* header */
+	perf[at++] = 0;                         /* version */
+	perf[at++] = HFI_TABLE_GPU_PERF;
+	perf[at++] = GPU_SPEEDS;
+	perf[at++] = 3;
+	for (unsigned i = 0; i < GPU_SPEEDS; i++) {
+		perf[at++] = arc_vote(gpu_speeds[i].level, gfx, gfx_n, gmxc, gmxc_n);
+		perf[at++] = i == 0 ? 0xffffffff : (0x3fffu << 14 | arc_index(mx, mx_n, gpu_speeds[i].level) << 8 | 0xff);
+		perf[at++] = gpu_speeds[i].hz / 1000;
+	}
+	perf[at++] = GMU_SPEEDS;
+	perf[at++] = 2;
+	for (unsigned i = 0; i < GMU_SPEEDS; i++) {
+		perf[at++] = arc_vote(gmu_speeds[i].level, cx, cx_n, mx, mx_n);
+		perf[at++] = gmu_speeds[i].hz / 1000;
+	}
+	say("4: votes: gpu %08x %08x %08x, gmu %08x %08x\n", perf[5], perf[8], perf[11], perf[5 + 3 * GPU_SPEEDS + 2],
+	    perf[5 + 3 * GPU_SPEEDS + 4]);
+
+	/*
+	 * The bus table: one level per entry of qcom,bus-table-ddr, SH0, MC0, ACV for memory, CN0 for the
+	 * configuration bus (bus_table_fill). Until 29 October it had the single "off" level, as Linux sends where it
+	 * has no bandwidth list (a6xx_build_bw_table), so the 3D core never asked for memory bandwidth: only the static
+	 * boot vote (dadaddr, hakios_dada_cpu.c) kept DDR up.
+	 */
+	if (!bus_table_fill(bw)) {
+		return false;
+	}
+
+	if (!hfi_send("the table of speeds", HFI_MSG_TABLE, perf, at) ||
+	    !hfi_send("the table of bus votes", HFI_MSG_BW_TABLE, bw, BW_WORDS) ||
+	    !hfi_send("core firmware start", HFI_MSG_CORE_FW_START, empty, 2) ||
+	    !hfi_send("start", HFI_MSG_START, empty, 1)) {
+		return false;
+	}
+	say("4: THE GMU HAS ITS TABLES\n");
+	/*
+	 * a6xx_gmu_set_initial_freq -> a6xx_hfi_set_freq: blocking, the speed chosen (dadagpu_speed), and the bus level of
+	 * its pwrlevel (dev_pm_opp_get_bw's index in the bus table; plain, no AB vote: that is a750-family only).
+	 */
+	/*
+	 * {header, ack_type, freq index, bw index} (a6xx_hfi_gx_bw_perf_vote_cmd; unixnu-sheng's GpuPowerProbe {1, perf, bw}). Until 29
+	 * October this sent {header, index, 1, 0}: ack_type the index and freq 1, so the core ran at 160 MHz whatever was said here and
+	 * every submission of the home screen took some 24 ms of GPU.
+	 */
+	vote[1] = 1;                            /* blocking */
+	vote[2] = gpu_speed_index >= 1 && gpu_speed_index < GPU_SPEEDS ? gpu_speed_index : 1;
+	vote[3] = gpu_bus_index(vote[2]);
+	say("4: the 3D core at %u MHz (speed %u), bus level %u (%u KB/s)\n", gpu_speeds[vote[2]].hz / 1000000, vote[2],
+	    vote[3], ddr_kbps[vote[3]]);
+	if (!hfi_send("the speed wanted", HFI_MSG_GX_BW_PERF_VOTE, vote, 4)) {
+		return false;
+	}
+
+	say("4: asking the GMU for the 3D core (OOB GPU set)\n");
+	hold();
+	core_powered = true;
+	Gw(G8_GMU_HOST2GMU_INTR_SET, 1u << 30);
+	for (int i = 0; i < 10000 && !(granted & 1u << 31); i++) {
+		sleep_us(100);
+		granted = G(G8_GMU_GMU2HOST_INTR_INFO);
+	}
+	Gw(G8_GMU_GMU2HOST_INTR_CLR, 1u << 31);
+	say("4: g2h %08x, gx gdsc %08x, pwr clk %08x, rpmh state %08x\n", granted, rd(gpu + GX_GDSCR_OFFSET),
+	    G(G8_GMU_PWR_CLK_STATUS), G(G8_GPU_GMU_CX_GMU_RPMH_POWER_STATE));
+	if (!(granted & 1u << 31)) {
+		say("4: the GMU does not grant the 3D core\n");
+		gmu_log_tail();
+		return false;
+	}
+	say("4: the 3D core: rbbm status %08x int %08x, cp rb base %08x\n", G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS),
+	    G(G8_CP_RB_BASE));
+	say("4: THE 3D CORE HAS POWER AND ANSWERS\n");
+	return !space_faulted(&gmu_space);
+}
+
+static void gpu_block_stop(void);
+
+/* ---- phase 5: the 3D core's memory, microcode, registers; its command processor started ---------------- */
+
+/*
+ * a8xx_gpu.c hw_init, in its order, for one ring and without preemption, protection or clock gating
+ * (those come when the system draws). The core's addresses below GPU_ADDRESSES_START are constants of
+ * ours, as in redwood_adreno.c; GMEM is at 64 MB in every address space (UCHE_*_GC_GMEM_RANGE_MIN), so
+ * nothing of ours goes between 0x4000000 and 0x4c00000.
+ */
+#define CORE_STREAM             0
+#define CORE_MATCH              0
+#define CORE_LPAC_STREAM        1
+#define CORE_LPAC_MATCH         2
+#define CORE_RING_ADDRESS       0x01000000u
+#define CORE_RING_SIZE          0x8000u
+#define CORE_SQE_ADDRESS        0x01100000u
+#define CORE_AQE_ADDRESS        0x01200000u
+#define CORE_SCRATCH_ADDRESS    0x01300000u     /* +0 rptr shadow, +0x40 the BV pipe's, +0x100 fences, +0x1000 tests */
+#define CORE_SCRATCH_SIZE       0x4000u
+#define CORE_PWRUP_ADDRESS      0x01400000u
+#define CORE_PWRUP_SIZE         0x4000u
+#define GMEM_RANGE_MIN          0x4000000ull
+#define UCHE_TRAP_BASE          0x1fffffffff000ull
+#define RING_WORDS              (CORE_RING_SIZE / 4)
+
+#define PIPE_NONE               0
+#define PIPE_BR                 1
+#define PIPE_BV                 2
+#define PIPE_LPAC               3
+#define PIPE_DDE_BV             7
+#define B(p)                    (1u << (p))
+
+/* pm4 opcodes (adreno_pm4.xml) */
+#define CP_NOP                  0x10
+#define CP_THREAD_CONTROL       0x17
+#define CP_WAIT_FOR_IDLE        0x26
+#define CP_MEM_WRITE            0x3d
+#define CP_ME_INIT              0x48
+#define CP_SET_SECURE_MODE      0x66
+
+static struct gpu_space core_space = { .name = "the 3D core", .context = 0, .control = 1u << 8 /* serve after fault */ };
+static struct gpu_block core_ring, core_sqe, core_aqe, core_scratch, core_pwrup;
+static bool core_space_on, core_runs, zap_loaded;
+static uint32_t ring_at;
+/*
+ * Where ring() writes: ring 0 (core_ring, ring_at), which is the only ring there is unless boot-arg dadagpu_preempt
+ * makes a second (core_ring1, ring1_at) for submissions that may be preempted; ring_select() points these at it for
+ * the length of one submission.
+ */
+static struct gpu_block core_ring1;
+static uint32_t ring1_at;
+static struct gpu_block *ring_block = &core_ring;
+static uint32_t *ring_pos = &ring_at;
+
+/* a830_nonctxt_regs (a8xx_catalog.c): register, value, the pipes whose aperture it is written through */
+static const struct {
+	uint32_t reg, value, pipes;
+} nonctxt[] = {
+	{ G8_CP_SMMU_STREAM_ID_LPAC, 0x00000101, B(PIPE_NONE) },
+	{ G8_GRAS_DBG_ECO_CNTL, 0x00000800, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_AUTO_VERTEX_STRIDE, 0x00000001, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_VIS_STREAM_CNTL, 0x10010000, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CONTEXT_SWITCH_STABILIZE_CNTL_1, 0x00000002, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_1, 0x00000003, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_2, 0x00000200, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_3, 0x00400000, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_4, 0x00500050, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_UCHE_GBIF_GX_CONFIG, 0x010240e0, B(PIPE_NONE) },
+	{ G8_RBBM_GBIF_CLIENT_QOS_CNTL, 0x22122212, B(PIPE_NONE) },
+	{ G8_RB_CCU_CNTL, 0x00000068, B(PIPE_BR) },
+	{ G8_RB_CCU_DBG_ECO_CNTL, 0x00002200, B(PIPE_BR) },
+	{ G8_RB_RESOLVE_PREFETCH_CNTL, 0x00000007, B(PIPE_BR) },
+	{ G8_RB_CMP_DBG_ECO_CNTL, 0x00004000, B(PIPE_BR) },
+	{ G8_RBBM_NC_MODE_CNTL, 0x00000001, B(PIPE_NONE) },
+	{ G8_RBBM_SLICE_NC_MODE_CNTL, 0x00000001, B(PIPE_NONE) },
+	{ G8_RBBM_WAIT_IDLE_CLOCKS_CNTL, 0x00000030, B(PIPE_NONE) },
+	{ G8_RBBM_WAIT_IDLE_CLOCKS_CNTL2, 0x00000030, B(PIPE_NONE) },
+	{ G8_RBBM_CGC_P2S_CNTL, 0x00000040, B(PIPE_NONE) },
+	{ G8_SP_PERFCTR_SHADER_MASK, 0x0000003f, B(PIPE_NONE) },
+	{ G8_SP_CHICKEN_BITS_1, 1u << 26 | 1u << 30, B(PIPE_NONE) },
+	{ G8_SP_CHICKEN_BITS_2, 1u << 22 | 1u << 23, B(PIPE_NONE) },
+	{ G8_SP_CHICKEN_BITS_3, 0x00300000, B(PIPE_NONE) },
+	{ G8_SP_HLSQ_TIMEOUT_THRESHOLD_DP, 0x00000080, B(PIPE_NONE) },
+	{ G8_TPL1_DBG_ECO_CNTL, 0x10000000, B(PIPE_NONE) },
+	{ G8_TPL1_DBG_ECO_CNTL1, 0x04000724, B(PIPE_NONE) },
+	{ G8_UCHE_MODE_CNTL, 0x00080000, B(PIPE_NONE) },
+	{ G8_UCHE_CCHE_MODE_CNTL, 0x00001000, B(PIPE_NONE) },
+	{ G8_UCHE_CCHE_CACHE_WAYS, 0x00000800, B(PIPE_NONE) },
+	{ G8_UCHE_HW_DBG_CNTL, 1u << 8, B(PIPE_NONE) },
+	{ G8_UCHE_VARB_IDLE_TIMEOUT, 0x00000020, B(PIPE_NONE) },
+	{ G8_VFD_DBG_ECO_CNTL, 0x00008000, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BV_THRESHOLD, 0x00500050, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BR_THRESHOLD, 0x00600060, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BUSY_REQ_CNT, 0x00200020, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_LP_REQ_CNT, 0x00100020, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VPC_FLATSHADE_MODE_CNTL, 0x00000001, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VSC_KMD_DBG_ECO_CNTL, 1u << 11, B(PIPE_NONE) },
+};
+#define GMEM_PROTECT            0x0c000000u     /* RB_GC_GMEM_PROTECT, written once out of secure mode */
+
+static void
+aperture(uint32_t pipe)
+{
+	Gw(G8_CP_APERTURE_CNTL_HOST, pipe << 12);
+}
+
+static void
+Gw64(uint32_t reg, uint64_t value)
+{
+	Gw(reg, (uint32_t)value);
+	Gw(reg + 1, (uint32_t)(value >> 32));
+}
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+static void
+ring(uint32_t word)
+{
+	((volatile uint32_t *)ring_block->memory)[*ring_pos] = word;
+	*ring_pos = (*ring_pos + 1) % RING_WORDS;
+}
+
+static void
+ring_command(uint32_t opcode, uint32_t words)
+{
+	ring(7u << 28 | words | odd_parity(words) << 15 | opcode << 16 | odd_parity(opcode) << 23);
+}
+
+/* what is in the ring to the core, and wait until it has read all of it and rests (a8xx_flush, a8xx_idle) */
+static bool
+ring_run(const char *what)
+{
+	uint32_t rptr = ~0u, status = ~0u;
+
+	to_memory(core_ring.memory, core_ring.size);
+	say("%u: the 3D core is to %s (ring up to %u)\n", phase, what, ring_at);
+	hold();
+	Gw(G8_CP_RB_WPTR, ring_at);
+	for (int i = 0; i < 20000; i++) {
+		sleep_us(100);
+		rptr = G(G8_CP_RB_RPTR);
+		status = G(G8_RBBM_STATUS);
+		if (rptr == ring_at && !(status & ~1u)) {
+			break;
+		}
+	}
+	if (rptr == ring_at && !(status & ~1u) && !space_faulted(&core_space)) {
+		say("%u: done (rptr %u, status %08x)\n", phase, rptr, status);
+		return true;
+	}
+	aperture(PIPE_BR);
+	say("%u: the 3D core does not get through: rptr %u of %u, status %08x, int %08x; BR: hw fault %08x int %08x "
+	    "prot %08x sqe %08x\n", phase, rptr, ring_at, status, G(G8_RBBM_INT_0_STATUS), G(G8_CP_HW_FAULT_STATUS_PIPE),
+	    G(G8_CP_INTERRUPT_STATUS_PIPE), G(G8_CP_PROTECT_STATUS_PIPE), G(G8_CP_SQE_STATUS_PIPE));
+	aperture(PIPE_BV);
+	say("%u:   BV: hw fault %08x int %08x prot %08x sqe %08x; global int %08x\n", phase, G(G8_CP_HW_FAULT_STATUS_PIPE),
+	    G(G8_CP_INTERRUPT_STATUS_PIPE), G(G8_CP_PROTECT_STATUS_PIPE), G(G8_CP_SQE_STATUS_PIPE),
+	    G(G8_CP_INTERRUPT_STATUS_GLOBAL));
+	aperture(PIPE_NONE);
+	space_faulted(&core_space);
+	return false;
+}
+
+static bool
+phase_core_start(void)
+{
+	const uint8_t *sqe, *aqe;
+	uint64_t sqe_size = 0, aqe_size = 0;
+
+	if (!core_powered) {
+		return false;
+	}
+	sqe = image_file("gen80000_sqe.fw", &sqe_size);
+	aqe = image_file("gen80000_aqe.fw", &aqe_size);
+	if (sqe == NULL || aqe == NULL || sqe_size < 8 || aqe_size < 8) {
+		return false;
+	}
+	say("5: the 3D core's memory: ring, SQE (%llu), AQE (%llu), scratch, power-up list\n", sqe_size, aqe_size);
+	if (!block_new(&core_space, &core_ring, CORE_RING_ADDRESS, CORE_RING_SIZE, PTE_CORE) ||
+	    !block_new(&core_space, &core_sqe, CORE_SQE_ADDRESS, (uint32_t)sqe_size - 4, PTE_CORE | PTE_READ_ONLY) ||
+	    !block_new(&core_space, &core_aqe, CORE_AQE_ADDRESS, (uint32_t)aqe_size - 4, PTE_CORE | PTE_READ_ONLY) ||
+	    !block_new(&core_space, &core_scratch, CORE_SCRATCH_ADDRESS, CORE_SCRATCH_SIZE, PTE_CORE) ||
+	    !block_new(&core_space, &core_pwrup, CORE_PWRUP_ADDRESS, CORE_PWRUP_SIZE, PTE_CORE)) {
+		return false;
+	}
+	memcpy((void *)core_sqe.memory, sqe + 4, sqe_size - 4);         /* adreno_fw_create_bo: past the first word */
+	memcpy((void *)core_aqe.memory, aqe + 4, aqe_size - 4);
+	to_memory(core_sqe.memory, core_sqe.size);
+	to_memory(core_aqe.memory, core_aqe.size);
+
+	say("5: SMMU context 0 for the core's streams 0 and 1\n");
+	hold();
+	core_space_on = true;
+	if (!space_on(&core_space, CORE_MATCH, CORE_STREAM)) {
+		return false;
+	}
+	wr(smmu + SMMU_S2CR(CORE_LPAC_MATCH), core_space.context);
+	wr(smmu + SMMU_SMR(CORE_LPAC_MATCH), SMMU_SMR_VALID | CORE_LPAC_STREAM);
+
+	say("5: the core's registers (a8xx hw_init)\n");
+	hold();
+	aperture(PIPE_NONE);
+	Gw(G8_GBIF_HALT, 0);
+	(void)G(G8_GBIF_HALT);
+	Gw(G8_RBBM_GBIF_HALT, 0);
+	(void)G(G8_RBBM_GBIF_HALT);
+	Gw(G8_RBBM_SECVID_TSB_CNTL, 0);
+	Gw64(G8_RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	Gw(G8_RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	Gw(G8_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	Gw64(G8_UCHE_CCHE_GC_GMEM_RANGE_MIN, GMEM_RANGE_MIN);
+	Gw64(G8_SP_HLSQ_GC_GMEM_RANGE_MIN, GMEM_RANGE_MIN);
+	Gw64(G8_UCHE_TRAP_BASE, UCHE_TRAP_BASE);
+	Gw64(G8_UCHE_WRITE_THRU_BASE, UCHE_TRAP_BASE);
+	Gw64(G8_UCHE_CCHE_TRAP_BASE, UCHE_TRAP_BASE);
+	Gw64(G8_UCHE_CCHE_WRITE_THRU_BASE, UCHE_TRAP_BASE);
+	Gw(G8_RBBM_PERFCTR_CNTL, 1);
+	Gw(G8_RBBM_SLICE_PERFCTR_CNTL, 1);
+	Gw(G8_CP_PERFCTR_CP_SEL(0), 1);
+	Gw(G8_UCHE_CLIENT_PF, 1u << 7 | 1);
+	for (uint32_t pipe = PIPE_NONE; pipe <= PIPE_DDE_BV; pipe++) {
+		if (pipe == PIPE_LPAC) {
+			continue;
+		}
+		aperture(pipe);
+		for (unsigned i = 0; i < sizeof(nonctxt) / sizeof(nonctxt[0]); i++) {
+			if (nonctxt[i].pipes & B(pipe)) {
+				Gw(nonctxt[i].reg, nonctxt[i].value);
+			}
+		}
+	}
+	aperture(PIPE_NONE);
+	Gw(G8_RBBM_INTERFACE_HANG_INT_CNTL, 1u << 30 | 0xcfffff);
+	Gw(G8_RBBM_SLICE_INTERFACE_HANG_INT_CNTL, 1u << 30);
+	/* a8xx_set_ubwc_config for sm8750 (UBWC 5.0, highest bank bit 16: hbb 3, swizzling on, version tag 4) */
+	aperture(PIPE_BV);
+	Gw(G8_GRAS_NC_MODE_CNTL, 3u << 5);
+	aperture(PIPE_BR);
+	Gw(G8_GRAS_NC_MODE_CNTL, 3u << 5);
+	Gw(G8_RB_CCU_NC_MODE_CNTL, 3u << 1);
+	Gw(G8_RB_CMP_NC_MODE_CNTL, 4u << 15 | 1u << 2 | 1u << 1);
+	aperture(PIPE_NONE);
+	Gw(G8_SP_NC_MODE_CNTL, 2u << 4 | 3u << 1);
+	Gw(G8_TPL1_NC_MODE_CNTL, 3u << 1);
+	aperture(PIPE_BR);
+	Gw(G8_RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE, 1);
+	for (uint32_t pipe = PIPE_BR; pipe <= PIPE_DDE_BV; pipe++) {
+		if (pipe == PIPE_LPAC) {
+			continue;
+		}
+		aperture(pipe);
+		/* icache, rb fetch, rb privileged, rptr writeback; BR also the crash dumper's reads and writes */
+		Gw(G8_CP_APRIV_CNTL_PIPE, pipe == PIPE_BR ? 0x6f : 0x0f);
+	}
+	aperture(PIPE_NONE);
+	Gw64(G8_CP_SQE_INSTR_BASE, CORE_SQE_ADDRESS);
+	Gw64(G8_CP_AQE_INSTR_BASE_0, CORE_AQE_ADDRESS);
+	Gw64(G8_CP_RB_BASE, CORE_RING_ADDRESS);
+	Gw(G8_CP_RB_CNTL, 12u | 2u << 8);       /* MSM_GPU_RB_CNTL_DEFAULT: 2^12 quad words, blocks of 32 bytes */
+	Gw64(G8_CP_RB_RPTR_ADDR, CORE_SCRATCH_ADDRESS);
+	Gw64(G8_CP_RB_RPTR_ADDR_BV, CORE_SCRATCH_ADDRESS + 0x40);
+	say("5: sqe base %08x rb base %08x cntl %08x status %08x\n", G(G8_CP_SQE_INSTR_BASE), G(G8_CP_RB_BASE),
+	    G(G8_CP_RB_CNTL), G(G8_RBBM_STATUS));
+
+	say("5: the command processor started\n");
+	hold();
+	core_runs = true;
+	Gw(G8_CP_SQE_CNTL, 1);
+	sleep_ms(20);
+	say("5: alive after it: status %08x int %08x rptr %u\n", G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS), G(G8_CP_RB_RPTR));
+	if (space_faulted(&core_space)) {
+		return false;
+	}
+
+	/* a8xx_cp_init */
+	ring_at = 0;
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(1u << 27);                         /* no concurrent binning */
+	ring_command(CP_ME_INIT, 7);
+	ring(1u << 0 | 1u << 1 | 1u << 3 | 1u << 6 | 1u << 8);
+	ring(0x00000003);
+	ring(0x20000000);
+	ring(0x00000002);
+	ring(CORE_PWRUP_ADDRESS);
+	ring(0);
+	ring(1u << 31);
+	if (!ring_run("initialize (CP_ME_INIT)")) {
+		return false;
+	}
+	say("5: THE 3D CORE TAKES COMMANDS\n");
+	return true;
+}
+
+/* ---- phase 6: the zap shader; out of secure mode; a word written on command ----------------------------- */
+
+/*
+ * adreno_zap_shader_load -> qcom_mdt_load for the one-file image gen80000_zap.mbn (an ELF of three
+ * program headers: the headers themselves, one relocatable segment of 0x3b4 bytes, the hash
+ * segment): TrustZone gets the ELF header and the hashes (PAS 13, "init image"), the place (dt:
+ * gpu_microcode_region 0x9b09a000, 8K) and the segment there, and is asked to authenticate it.
+ * Whatever a kernel before this one left there is given up first, as in redwood_adreno.c.
+ */
+#define ZAP_MEMORY              0x9b09a000ull
+#define ZAP_MEMORY_SIZE         0x2000u
+#define PAS_GPU                 13
+#define SCM_ONE_VALUE           1
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_THREE_VALUES        3
+
+static bool
+zap_load(void)
+{
+	const uint8_t *image;
+	uint64_t size = 0, answer = ~0ull, metadata_phys;
+	uint32_t phoff, phnum, header_size = 0, hash_offset = 0, hash_size = 0, seg_offset = 0, seg_size = 0;
+	vm_offset_t page = 0;
+	volatile uint8_t *memory;
+	int32_t r;
+
+	image = image_file("gen80000_zap.mbn", &size);
+	if (image == NULL || size < 52 || memcmp(image, "\177ELF\1", 5) != 0) {
+		return false;
+	}
+	memcpy(&phoff, image + 28, 4);
+	phnum = image[44] | image[45] << 8;
+	for (uint32_t i = 0; i < phnum && phoff + 32 * (i + 1) <= size; i++) {
+		uint32_t ph[8];
+
+		memcpy(ph, image + phoff + 32 * i, sizeof(ph));      /* type offset vaddr paddr filesz memsz flags align */
+		if (i == 0) {
+			header_size = ph[4];
+		} else if ((ph[6] & (7u << 24)) == (2u << 24)) {
+			hash_offset = ph[1];
+			hash_size = ph[4];
+		} else if (ph[0] == 1 && ph[5] != 0) {
+			seg_offset = ph[1];
+			seg_size = ph[4];
+		}
+	}
+	say("6: zap: header %#x, hashes %#x at %#x, segment %#x at %#x\n", header_size, hash_size, hash_offset, seg_size,
+	    seg_offset);
+	if (header_size == 0 || hash_size == 0 || seg_size == 0 || header_size + hash_size > PAGE_SIZE ||
+	    seg_size > ZAP_MEMORY_SIZE || hash_offset + hash_size > size || seg_offset + seg_size > size) {
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	memcpy((void *)page, image, header_size);
+	memcpy((void *)(page + header_size), image + hash_offset, hash_size);
+	to_memory(page, PAGE_SIZE);
+	metadata_phys = kvtophys(page);
+
+	say("6: TrustZone: give up an earlier zap shader\n");
+	hold();
+	r = scm(SCM_64 | SCM_SIP | SCM_CALL(2, 6), SCM_ONE_VALUE, PAS_GPU, 0, 0, &answer);
+	say("6: shutdown: %d (%#llx)\n", r, answer);
+	say("6: TrustZone: the zap shader's signature\n");
+	hold();
+	r = scm(SCM_64 | SCM_SIP | SCM_CALL(2, 1), SCM_VALUE_AND_BUFFER, PAS_GPU, metadata_phys, 0, &answer);
+	say("6: init image: %d (%#llx)\n", r, answer);
+	if (r != 0 || answer != 0) {
+		return false;
+	}
+	r = scm(SCM_64 | SCM_SIP | SCM_CALL(2, 2), SCM_THREE_VALUES, PAS_GPU, ZAP_MEMORY, 0x1000, &answer);
+	say("6: mem setup: %d (%#llx)\n", r, answer);
+	if (r != 0 || answer != 0) {
+		return false;
+	}
+	memory = (volatile uint8_t *)ml_io_map_wcomb(ZAP_MEMORY, ZAP_MEMORY_SIZE);
+	for (uint32_t i = 0; i < 0x1000; i++) {
+		memory[i] = i < seg_size ? image[seg_offset + i] : 0;
+	}
+	__asm__ volatile ("dsb sy");
+	say("6: TrustZone: authenticate and run it\n");
+	hold();
+	r = scm(SCM_64 | SCM_SIP | SCM_CALL(2, 5), SCM_ONE_VALUE, PAS_GPU, 0, 0, &answer);
+	say("6: auth and reset: %d (%#llx)\n", r, answer);
+	if (r != 0 || answer != 0) {
+		return false;
+	}
+	zap_loaded = true;
+	say("6: TRUSTZONE RUNS THE ZAP SHADER\n");
+	return true;
+}
+
+static bool
+phase_core_commands(void)
+{
+	volatile uint32_t *test = (volatile uint32_t *)(core_scratch.memory + 0x1000);
+
+	if (!core_runs || !zap_load()) {
+		return false;
+	}
+	ring_command(CP_SET_SECURE_MODE, 1);
+	ring(0);
+	if (!ring_run("leave secure mode")) {
+		return false;
+	}
+	aperture(PIPE_BR);
+	Gw(G8_RB_GC_GMEM_PROTECT, GMEM_PROTECT);
+	aperture(PIPE_NONE);
+
+	*test = 0;
+	to_memory(core_scratch.memory + 0x1000, 64);
+	ring_command(CP_MEM_WRITE, 3);
+	ring(CORE_SCRATCH_ADDRESS + 0x1000);
+	ring(0);
+	ring(0x600dc0de);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	if (!ring_run("write a word to memory")) {
+		return false;
+	}
+	to_memory(core_scratch.memory + 0x1000, 64);
+	say("6: the word reads %08x: %s\n", *test, *test == 0x600dc0de ? "THE 3D CORE WRITES OUR MEMORY ON COMMAND" :
+	    "not what it was told");
+	return *test == 0x600dc0de;
+}
+
+/* ---- the GPU kept on, for the system to draw with ------------------------------------------------------ */
+
+/*
+ * boot-arg dadagpu_keep=1 (with dadagpu=6): the phases' work is not undone. The 3D core stays
+ * powered (the OOB request of phase 4 is never taken back) and the service RedwoodGPU
+ * (iokit/Kernel/RedwoodGPU.cpp) hands it to programs through the interface of Linux's msm driver,
+ * as it does the redwood's Adreno: redwood_adreno.c's redwood_gpu_* functions come here when
+ * hakios_dada_gpu_ready() says so. One address space for every client (context 0), addresses
+ * handed out from DADA_ADDRESSES_START by a first-fit list, as redwood_adreno.c explains at length.
+ */
+#define DADA_ADDRESSES_START    0x20000000ull
+#define DADA_ADDRESSES_SIZE     0x3e0000000ull   /* 15.5 GB: 3.5 GB ran out with every poster up (g2k14, "no addresses left", the wallpaper black); the render server's growth that froze g2k2 and g2k3 with 16 GB is gone (g2k9 on: stable) */
+#define DADA_GRANULE            0x10000ull
+#define FENCE_AT                0x100           /* in the scratch block: the ring's fence */
+#define BV_FENCE_AT             0x108           /* ... and the BV pipe's */
+#define TIMES_AT                0x400           /* ... when each of the last TIMES submissions began and ended */
+#define TIMES                   64
+#define CP_REG_TO_MEM           0x3e
+#define CP_INDIRECT_BUFFER      0x3f
+#define CP_EVENT_WRITE7         0x46
+#define CP_SET_MARKER           0x65
+#define CP_WAIT_TIMESTAMP       0x14
+#define CCU_INVALIDATE_DEPTH    0x18
+#define CCU_INVALIDATE_COLOR    0x19
+#define CACHE_CLEAN             0x31
+#define THREAD_BR               1
+#define THREAD_BV               2
+#define THREAD_BOTH             3
+#define SYNC_THREADS            (1u << 31)
+
+extern void RedwoodGPUStart(void);
+extern uint32_t gpu_log;
+
+static bool kept;
+static uint32_t fence;                  /* the number of the last submission */
+
+/*
+ * Boot-arg dadagpu_preempt=1 (or 2, below): two rings and hardware preemption between them, as Linux's a8xx_preempt.c
+ * (March 2026, for the A840; the A830's catalog entry carries ADRENO_QUIRK_PREEMPTION too). With one ring, the
+ * wallpaper's 40-55 ms submissions and the widgets' sat in front of backboardd's frames, and the frames stuttered.
+ * Ring 0 is backboardd's (RedwoodGPU.cpp says which, through dada_gpu_next_ring()), ring 1 everybody else's; when
+ * ring 0 is given work while the core is on ring 1, the core is told to switch (CP_CONTEXT_SWITCH_CNTL), and once
+ * ring 0 has nothing left it is switched back. Linux learns that a switch is over from the CP_SW interrupt and that a
+ * ring has emptied from CACHE_FLUSH_TS; there are no interrupts here, so a thread of ours looks (preempt_poll()).
+ *
+ * A submission's number (a "ticket", what RedwoodGPU hands programs as the fence) stays one increasing 32-bit count
+ * over both rings, and its lowest bit is its ring: ring 0's are even, ring 1's odd, so a ticket says by itself which
+ * ring's fence word answers for it, and each ring's fence word -- written with the ticket -- only ever grows. Two
+ * tickets of different rings say nothing about each other's order of completion: whoever waits for "everything"
+ * waits for each ring's last (dada_gpu_last_on()).
+ *
+ * With 0 (the default) none of this is touched: one ring, the same packets as before.
+ */
+#define RINGS                   2
+#define RPTR_AT(r)              (0x80u * (r))           /* in the scratch block: ring r's rptr shadow, +0x40 the BV's */
+#define RING_FENCE_AT(r)        (FENCE_AT + 0x10u * (r)) /* ... its fence (ring 0's is FENCE_AT), +8 the BV pipe's */
+#define RING_TIMES_AT(r)        (TIMES_AT + 0x400u * (r)) /* ... its TIMES start and end stamps */
+/* (default 1 since 29 October: g2k44/g2k45/g2k46 ran with it, no fault, smoother by the user; dadagpu_preempt=0: one ring) */
+static TUNABLE(uint32_t, gpu_preempt_arg, "dadagpu_preempt", 1);
+static bool preempt_on;                 /* two rings in use: everything below is gated on it */
+static bool preempt_halted;             /* the GPU is being given back: the poll thread leaves the core alone */
+static uint32_t last_ticket[RINGS];     /* each ring's last submission (Linux: a6xx_gpu->last_seqno[]) */
+static uint32_t submit_ring;            /* the ring of the next dada_gpu_submit(); back to 0 after each */
+static struct gpu_block *const ring_blocks[RINGS] = { &core_ring, &core_ring1 };
+static uint32_t *const ring_ats[RINGS] = { &ring_at, &ring1_at };
+static uint32_t timed, timed_count, timed_by[7];
+static uint64_t timed_ticks;
+static uint64_t busy_ticks;             /* all the core has worked, never reset (the governor's) */
+static struct {
+	uint64_t start, size;
+} va_free[1024];
+static unsigned va_free_count, va_holes_most;
+static uint64_t va_used, va_lost;
+static uint32_t va_live, va_refused;
+
+bool
+hakios_dada_gpu_ready(void)
+{
+	return kept;
+}
+
+static void
+ring_register(uint32_t reg, uint32_t value)
+{
+	ring(4u << 28 | 1 | odd_parity(1) << 7 | reg << 8 | odd_parity(reg) << 27);
+	ring(value);
+}
+
+static void
+ring_thread(uint32_t what)
+{
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(what);
+}
+
+bool
+dada_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:                              /* GPU_ID: none, the chip id says it */
+	case 0x06:                              /* GMEM_BASE */
+	case 0x08:                              /* PP_PGTABLE */
+	case 0x09:                              /* FAULTS */
+	case 0x0a:                              /* SUSPENDS */
+	case 0x11:                              /* RAYTRACING: not offered yet */
+	case 0x15:                              /* HAS_PRR */
+	case 0x17:                              /* AQE: not used */
+		*value = 0;
+		return true;
+	case 0x02:                              /* GMEM_SIZE: 12 MB over the three slices */
+		*value = 12 * 1024 * 1024;
+		return true;
+	case 0x03:                              /* CHIP_ID */
+		*value = 0x44050001;
+		return true;
+	case 0x04:                              /* MAX_FREQ */
+		*value = gpu_speeds[GPU_SPEEDS - 1].hz;
+		return true;
+	case 0x05:                              /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:                              /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:                              /* HIGHEST_BANK_BIT (ubwc_config.c: sm8750, UBWC 5.0) */
+		*value = 16;
+		return true;
+	case 0x12:                              /* UBWC_SWIZZLE: levels 2 and 3 */
+		*value = 6;
+		return true;
+	case 0x13:                              /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	case 0x14:                              /* UCHE_TRAP_BASE */
+		*value = UCHE_TRAP_BASE;
+		return true;
+	default:
+		return false;
+	}
+}
+
+static uint64_t
+va_span(uint64_t size)
+{
+	return (size + (DADA_GRANULE - 1)) & ~(DADA_GRANULE - 1);
+}
+
+uint64_t
+dada_gpu_address(uint64_t size)
+{
+	size = va_span(size);
+	for (unsigned i = 0; i < va_free_count; i++) {
+		if (va_free[i].size >= size) {
+			uint64_t address = va_free[i].start;
+
+			va_free[i].start += size;
+			va_free[i].size -= size;
+			if (va_free[i].size == 0) {
+				memmove(&va_free[i], &va_free[i + 1], (--va_free_count - i) * sizeof(va_free[0]));
+			}
+			va_used += size;
+			va_live++;
+			return address;
+		}
+	}
+	va_refused++;
+	return 0;
+}
+
+void
+dada_gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = va_span(size);
+	va_used -= size;
+	va_live--;
+	for (at = 0; at < va_free_count && va_free[at].start < address; at++) {
+	}
+	if (at > 0 && va_free[at - 1].start + va_free[at - 1].size == address) {
+		va_free[at - 1].size += size;
+		if (at < va_free_count && address + size == va_free[at].start) {
+			va_free[at - 1].size += va_free[at].size;
+			memmove(&va_free[at], &va_free[at + 1], (--va_free_count - at) * sizeof(va_free[0]));
+		}
+	} else if (at < va_free_count && address + size == va_free[at].start) {
+		va_free[at].start = address;
+		va_free[at].size += size;
+	} else if (va_free_count < sizeof(va_free) / sizeof(va_free[0])) {
+		memmove(&va_free[at + 1], &va_free[at], (va_free_count++ - at) * sizeof(va_free[0]));
+		va_free[at].start = address;
+		va_free[at].size = size;
+	} else {
+		va_lost += size;
+	}
+	if (va_free_count > va_holes_most) {
+		va_holes_most = va_free_count;
+	}
+}
+
+void
+dada_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most, uint64_t *lost,
+    uint32_t *refused)
+{
+	*largest = 0;
+	for (unsigned i = 0; i < va_free_count; i++) {
+		if (va_free[i].size > *largest) {
+			*largest = va_free[i].size;
+		}
+	}
+	*used = va_used;
+	*live = va_live;
+	*holes = va_free_count;
+	*most = va_holes_most;
+	*lost = va_lost;
+	*refused = va_refused;
+}
+
+bool
+dada_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return space_map(&core_space, address, phys, PTE_CORE | (read_only ? PTE_READ_ONLY : 0));
+}
+
+void
+dada_gpu_mapped(void)
+{
+	space_commit(&core_space);
+}
+
+void
+dada_gpu_unmap(uint64_t address, uint64_t size)
+{
+	uint32_t context = smmu_context(&core_space);
+
+	/* the entries emptied (0: no page), without making tables where there are none */
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		uint32_t at;
+		uint64_t *level3 = space_leaf(&core_space, address + offset, false, &at);
+
+		if (level3 != NULL) {
+			level3[(address + offset) >> 12 & 0x1ff] = 0;
+			space_dirty(&core_space, at);
+		}
+	}
+	space_commit(&core_space);
+	wr(smmu + context + SMMU_CB_TLBIASID, core_space.context);
+	wr(smmu + context + SMMU_CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000 && (rd(smmu + context + SMMU_CB_TLBSTATUS) & 1); i++) {
+	}
+}
+
+void
+dada_gpu_to_memory(void *start, uint64_t size)
+{
+	to_memory((vm_offset_t)start, size);
+}
+
+bool
+dada_gpu_done(uint32_t which)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + FENCE_AT);
+
+	if (preempt_on) {
+		/* the ticket's own ring's fence (its lowest bit); 0 names no submission and is done */
+		if (which == 0) {
+			return true;
+		}
+		word = (volatile uint32_t *)(core_scratch.memory + RING_FENCE_AT(which & 1));
+	}
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - which) >= 0;
+}
+
+uint32_t
+dada_gpu_last(void)
+{
+	return fence;
+}
+
+/*
+ * With two rings, the last submission says nothing about the other ring's: who waits for all the GPU was given
+ * (RedwoodGPU.cpp's clientClose, a CPU_PREP of no buffer) waits for both of these. With one ring, ring 0's is the last.
+ */
+uint32_t dada_gpu_last_on(uint32_t ring);
+uint32_t
+dada_gpu_last_on(uint32_t ring)
+{
+	if (!preempt_on) {
+		return ring == 0 ? fence : 0;
+	}
+	return last_ticket[ring & 1];
+}
+
+/* whether there are two rings (boot-arg dadagpu_preempt, and it came up) */
+bool dada_gpu_rings(void);
+bool
+dada_gpu_rings(void)
+{
+	return preempt_on;
+}
+
+/* the ring the next dada_gpu_submit() goes to: 0 backboardd's, 1 everybody else's (RedwoodGPU.cpp, under its lock) */
+void dada_gpu_next_ring(uint32_t ring);
+void
+dada_gpu_next_ring(uint32_t ring)
+{
+	submit_ring = ring & 1;
+}
+
+/* the core writes down the always-on counter (19.2 MHz) at one end of a submission */
+static void
+ring_time(uint32_t which, uint32_t end)
+{
+	ring_command(CP_REG_TO_MEM, 3);
+	ring(G8_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);   /* two words, a 64-bit register */
+	ring(CORE_SCRATCH_ADDRESS + TIMES_AT + 16 * (which % TIMES) + 8 * end);
+	ring(0);
+}
+
+/*
+ * Whose submissions the core worked on: the submitting process of each fence's slot, and each process's ticks since the last report
+ * (dada_gpu_worked_by: the render server's own GPU time a frame, which the totals mix with the posters' and widgets', g2k30).
+ */
+extern int proc_selfpid(void);
+static int32_t times_pid[TIMES];
+/*
+ * With two rings each has its own TIMES slots (RING_TIMES_AT), by its own count of submissions, and remembers which
+ * ticket and process each slot is: a ring's tickets are not consecutive. A ring 1 submission that was preempted is
+ * timed from its start to its end, ring 0's work in between included.
+ */
+static uint32_t ring_count[RINGS], ring_timed[RINGS], slot_ticket[RINGS][TIMES];
+static int32_t slot_pid[RINGS][TIMES];
+static struct {
+	int32_t pid;
+	uint32_t count;
+	uint64_t ticks;
+} pid_times[8];
+
+static void
+pid_add(int32_t pid, uint64_t ticks)
+{
+	unsigned i, least = 0;
+
+	for (i = 0; i < 8 && pid_times[i].pid != pid; i++) {
+		if (pid_times[i].ticks < pid_times[least].ticks) {
+			least = i;
+		}
+	}
+	if (i == 8) {
+		i = least;              /* the least busy gives way */
+		pid_times[i].pid = pid;
+		pid_times[i].ticks = 0;
+		pid_times[i].count = 0;
+	}
+	pid_times[i].ticks += ticks;
+	pid_times[i].count++;
+}
+
+void dada_gpu_worked_by(char *out, size_t size);
+void
+dada_gpu_worked_by(char *out, size_t size)
+{
+	size_t at = 0;
+
+	out[0] = 0;
+	for (unsigned i = 0; i < 8 && at < size; i++) {
+		if (pid_times[i].count != 0) {
+			int n = snprintf(out + at, size - at, " pid %d %llu ms/%u", pid_times[i].pid,
+			    pid_times[i].ticks * 10 / 192 / 1000, pid_times[i].count);
+
+			at += n > 0 ? (size_t) n : 0;
+		}
+	}
+	bzero(pid_times, sizeof(pid_times));
+}
+
+static void
+time_taken(uint64_t ticks, uint32_t which, int32_t pid)
+{
+	static const uint32_t under[6] = { 1920, 4800, 9600, 19200, 38400, 76800 };
+	unsigned by = 0;
+
+	if (gpu_log) {
+		redwood_tl("tl: q %u took %llu\n", which, ticks * 10 / 192);
+	}
+	while (by < 6 && ticks >= under[by]) {
+		by++;
+	}
+	timed_by[by]++;
+	timed_ticks += ticks;
+	busy_ticks += ticks;
+	timed_count++;
+	pid_add(pid, ticks);
+}
+
+static void
+times_add_rings(void)
+{
+	to_memory(core_scratch.memory, 4096);
+	for (uint32_t r = 0; r < RINGS; r++) {
+		volatile uint64_t *times = (volatile uint64_t *)(core_scratch.memory + RING_TIMES_AT(r));
+		uint32_t done = *(volatile uint32_t *)(core_scratch.memory + RING_FENCE_AT(r));
+
+		if (ring_count[r] - ring_timed[r] > TIMES) {
+			ring_timed[r] = ring_count[r] - TIMES;
+		}
+		while (ring_timed[r] != ring_count[r]) {
+			uint32_t slot = ring_timed[r] % TIMES;
+
+			if ((int32_t)(done - slot_ticket[r][slot]) < 0) {
+				break;
+			}
+			ring_timed[r]++;
+			if (times[2 * slot + 1] > times[2 * slot]) {
+				time_taken(times[2 * slot + 1] - times[2 * slot], slot_ticket[r][slot], slot_pid[r][slot]);
+			}
+		}
+	}
+}
+
+static void
+times_add(void)
+{
+	volatile uint64_t *times = (volatile uint64_t *)(core_scratch.memory + TIMES_AT);
+	uint32_t done;
+
+	if (preempt_on) {
+		times_add_rings();
+		return;
+	}
+	to_memory(core_scratch.memory, 4096);
+	done = *(volatile uint32_t *)(core_scratch.memory + FENCE_AT);
+	if (done - timed > TIMES) {
+		timed = done - TIMES;
+	}
+	while (timed != done) {
+		uint32_t slot = ++timed % TIMES;
+
+		if (timed != 0 && times[2 * slot + 1] > times[2 * slot]) {
+			static const uint32_t under[6] = { 1920, 4800, 9600, 19200, 38400, 76800 };
+			uint64_t ticks = times[2 * slot + 1] - times[2 * slot];
+			unsigned by = 0;
+
+			if (gpu_log) {
+				redwood_tl("tl: q %u took %llu\n", timed, ticks * 10 / 192);
+			}
+			while (by < 6 && ticks >= under[by]) {
+				by++;
+			}
+			timed_by[by]++;
+			timed_ticks += ticks;
+			busy_ticks += ticks;
+			timed_count++;
+			pid_add(times_pid[slot], ticks);
+		}
+	}
+}
+
+void
+dada_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	times_add();
+	*microseconds = timed_ticks * 10 / 192;
+	*submissions = timed_count;
+	memcpy(by, timed_by, sizeof(timed_by));
+	bzero(timed_by, sizeof(timed_by));
+	timed_ticks = 0;
+	timed_count = 0;
+}
+
+/* ---- two rings and preemption (boot-arg dadagpu_preempt; see `preempt_on`) ------------------------------ */
+
+/*
+ * The memory of it, in the core's address space below DADA_ADDRESSES_START and away from GMEM's 64 MB: ring 1 next to
+ * the others, a page of SMMU information a ring, the postamble, and each ring's preemption record, which the command
+ * processor saves the ring's state into when it switches away and restores it from when it switches back. Its size is
+ * the A830's catalog entry's (a8xx_catalog.c: preempt_record_size = 13536K); Linux maps the records, the SMMU
+ * information and the postamble privileged (MSM_BO_MAP_PRIV: the SMMU lets only the CP's own accesses at them, which
+ * CP_APRIV_CNTL makes privileged), and so do we (PTE_GMU: our attributes without "unprivileged").
+ */
+#define CORE_RING1_ADDRESS      0x01500000u     /* as big as ring 0 (CORE_RING_SIZE) */
+#define CORE_SMMU_INFO_ADDRESS  0x01600000u     /* + 0x1000 a ring */
+#define CORE_POSTAMBLE_ADDRESS  0x01700000u
+#define CORE_RECORD_ADDRESS(r)  (0x08000000u + 0x01000000u * (r))
+#define PREEMPT_RECORD_SIZE     (13536u * 1024)
+#define CP_REG_RMW              0x21
+#define CP_WAIT_REG_MEM         0x3c
+#define CP_SET_AMBLE            0x55
+#define CP_SET_PSEUDO_REG       0x56
+#define CP_SET_PROTECTED_MODE   0x5f
+#define CP_CONTEXT_SWITCH_YIELD 0x6b
+#define PSEUDO_SMMU_INFO        0
+#define PSEUDO_NON_SECURE_SAVE_ADDR 1
+#define PSEUDO_NON_PRIV_SAVE_ADDR 3
+#define PSEUDO_COUNTER          4
+#define KMD_AMBLE_TYPE          3
+#define MARKER_IFPC_OFF         0x101
+#define MARKER_IFPC_ON          0x100
+#define MARKER_IB1LIST_START    0x00d
+#define MARKER_IB1LIST_END      0x00e
+#define SWITCH_STOP             (1u << 0)       /* CP_CONTEXT_SWITCH_CNTL (a6xx_cp_context_switch_cntl) */
+#define SWITCH_LEVEL(l)         ((l) << 6)
+#define SWITCH_USES_GMEM        (1u << 8)
+#define SWITCH_SKIP_SAVE_RESTORE (1u << 9)
+#define PREEMPT_RECORD_MAGIC    0xae399d6eu     /* A6XX_PREEMPT_RECORD_MAGIC */
+#define SMMU_INFO_MAGIC         0x241350d5u     /* GEN7_CP_SMMU_INFO_MAGIC */
+#define PREEMPT_WATCHDOG_S      10              /* Linux's preempt_timer */
+#define PREEMPT_POLL_US         250
+
+/* a6xx_gpu.h: struct a6xx_preempt_record and struct a7xx_cp_smmu_info */
+struct preempt_record {
+	uint32_t magic, info, errno_, data, cntl, rptr, wptr, pad;
+	uint64_t rptr_addr, rbase, counter, bv_rptr_addr;
+};
+struct cp_smmu_info {
+	uint32_t magic, pad;
+	uint64_t ttbr0;
+	uint32_t asid, context_idr, context_bank;
+};
+
+/* enum a6xx_preempt_state */
+enum { PREEMPT_NONE, PREEMPT_START, PREEMPT_FINISH, PREEMPT_TRIGGERED, PREEMPT_FAULTED, PREEMPT_PENDING };
+
+static TUNABLE(uint32_t, gpu_preempt_ib, "dadagpu_preempt_ib", 1);
+static TUNABLE(uint32_t, gpu_preempt_post, "dadagpu_preempt_post", 1);  /* 0: the postamble a NOP (preempt_disable_postamble) */
+static struct gpu_block core_record[RINGS], core_smmu_info, core_postamble;
+static uint32_t postamble_words;
+static uint32_t preempt_state, cur_ring, next_ring;
+static bool restore_wptr[RINGS];
+static uint64_t preempt_began;                  /* when the switch in flight was asked for (absolute time) */
+static lck_grp_t *preempt_group;
+static lck_mtx_t *preempt_lock;                 /* around all of the above and the rings; RedwoodGPU's lock may be held */
+static int preempt_poller;                      /* the poll thread's event */
+static struct {
+	uint64_t since, switching, longest;     /* absolute time */
+	uint32_t triggered, completed, faulted, submitted[RINGS], full[RINGS];
+} preempt_stat;
+
+static void
+ring_select(uint32_t r)
+{
+	ring_block = ring_blocks[r];
+	ring_pos = ring_ats[r];
+}
+
+static uint32_t
+scratch_word(uint32_t at)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + at);
+
+	to_memory((vm_offset_t)word, 4);
+	return *word;
+}
+
+static bool
+preempt_in_flight(void)
+{
+	return !(preempt_state == PREEMPT_NONE || preempt_state == PREEMPT_FINISH);         /* a6xx_in_preempt */
+}
+
+/*
+ * get_rptr: a8xx has APRIV, so the CP keeps each ring's rptr shadow up to date (RPTR_ADDR, saved and restored with
+ * the ring), and Linux reads only that. The current ring's own register is read instead while no switch is in flight:
+ * one ring had only ever been read so here, and a shadow that did not keep up would fill the ring.
+ */
+static uint32_t
+ring_rptr(uint32_t r)
+{
+	if (r == cur_ring && !preempt_in_flight()) {
+		return G(G8_CP_RB_RPTR);
+	}
+	return scratch_word(RPTR_AT(r));
+}
+
+/*
+ * Nothing in the ring that matters: all of it read, or (Linux: for the current ring only) its last fence back -- what
+ * may follow that is the end of a submission (a marker, the yield), read when the ring next runs. For the other ring
+ * too here: it cannot cost a switch to a ring whose shadow is behind.
+ */
+static bool
+ring_idle(uint32_t r)
+{
+	return *ring_ats[r] == ring_rptr(r) || scratch_word(RING_FENCE_AT(r)) == last_ticket[r];
+}
+
+/* a6xx_preempt.h get_next_ring: the first ring by priority with something in it */
+static int
+preempt_next_ring(void)
+{
+	for (uint32_t r = 0; r < RINGS; r++) {
+		if (!ring_idle(r)) {
+			return (int)r;
+		}
+	}
+	return -1;
+}
+
+/* a6xx_preempt.h update_wptr: the ring's wptr to the core, if a submission came while it could not be */
+static void
+preempt_update_wptr(uint32_t r)
+{
+	if (restore_wptr[r]) {
+		Gw(G8_CP_RB_WPTR, *ring_ats[r]);
+		restore_wptr[r] = false;
+	}
+}
+
+/* a8xx_preempt_keepalive_vote: the GMU keeps the core on until the switch is over (IFPC is off here; as Linux anyway) */
+static void
+preempt_keepalive(bool on)
+{
+	Gw(G8_GMU_PWR_COL_PREEMPT_KEEPALIVE, on ? 1 : 0);
+}
+
+/*
+ * a8xx_preempt_trigger, with the lock held: if a ring other than the current one should run (ring 0 has work, or the
+ * current ring has nothing left and the other has), its record gets its wptr, the core the record's and the SMMU
+ * information's addresses, and CP_CONTEXT_SWITCH_CNTL the request (level 1, GMEM used, save/restore skipped: Linux's
+ * a6xx_preempt_init defaults). The SMMU information: we have one address space and never switch tables, and the CP
+ * here has no aperture onto the SMMU's registers set up for it (Linux's arm-smmu-qcom does that through TrustZone),
+ * so with dadagpu_preempt=1 the core is told 0 -- "no table switch", which a8xx_preempt_hw_init writes too; with
+ * dadagpu_preempt=2 it is told the record's address, as Linux does every time.
+ */
+static void
+preempt_trigger(void)
+{
+	int ring;
+	uint32_t r;
+
+	if (preempt_state != PREEMPT_NONE) {
+		return;                         /* one is in flight: preempt_poll() asks again once it is over */
+	}
+	preempt_state = PREEMPT_START;
+	ring = preempt_next_ring();
+	if (ring < 0 || (uint32_t)ring == cur_ring) {
+		preempt_state = PREEMPT_FINISH;
+		preempt_update_wptr(cur_ring);
+		preempt_state = PREEMPT_NONE;
+		return;
+	}
+	r = (uint32_t)ring;
+	{
+		struct preempt_record *record = (struct preempt_record *)core_record[r].memory;
+
+		record->wptr = *ring_ats[r];
+		to_memory((vm_offset_t)record, sizeof(*record));
+	}
+	/* the core takes this wptr with the record; a later submission sets restore_wptr again */
+	restore_wptr[r] = false;
+	preempt_keepalive(true);
+	Gw64(G8_CP_CONTEXT_SWITCH_SMMU_INFO, gpu_preempt_arg == 2 ? CORE_SMMU_INFO_ADDRESS + 0x1000u * r : 0);
+	Gw64(G8_CP_CONTEXT_SWITCH_PRIV_NON_SECURE_RESTORE_ADDR, CORE_RECORD_ADDRESS(r));
+	next_ring = r;
+	preempt_began = mach_absolute_time();
+	preempt_stat.triggered++;
+	preempt_state = PREEMPT_TRIGGERED;
+	__asm__ volatile ("dsb sy");
+	Gw(G8_CP_CONTEXT_SWITCH_CNTL, SWITCH_LEVEL(1u) | SWITCH_USES_GMEM | SWITCH_SKIP_SAVE_RESTORE | SWITCH_STOP);
+	(void)G(G8_CP_CONTEXT_SWITCH_CNTL);     /* (arrived before the poll thread, on another core, reads it back) */
+}
+
+extern void dada_gpu_report(const char *why);
+
+/*
+ * a8xx_preempt_irq without the interrupt, and the a8xx_irq's CACHE_FLUSH_TS -> a8xx_preempt_trigger: with the lock
+ * held, every PREEMPT_POLL_US while a switch is in flight or a ring other than the current one has work. Linux takes
+ * the CP_SW interrupt as "the switch is over" and a STOP bit still set then as a failure; here the STOP bit going
+ * back to 0 is "over", and one still set after PREEMPT_WATCHDOG_S seconds the failure that Linux's preempt timer
+ * catches: then nothing is switched or written to WPTR again, the waits for fences run out, and RedwoodGPU does what
+ * it does with a core that has stopped (redwood_gpu_report, and dada_gpu_recover(), which has nothing to offer: no
+ * reset of the core is written for dada yet; one that is must set both rings up again, as phase_core_start and
+ * preempt_setup do). True: look again soon.
+ */
+static bool
+preempt_poll(void)
+{
+	if (!preempt_on || preempt_halted) {
+		return false;
+	}
+	if (preempt_state == PREEMPT_TRIGGERED) {
+		uint64_t now = mach_absolute_time(), ns;
+		uint32_t cntl = G(G8_CP_CONTEXT_SWITCH_CNTL);
+
+		absolutetime_to_nanoseconds(now - preempt_began, &ns);
+		if (cntl & SWITCH_STOP) {
+			if (ns < PREEMPT_WATCHDOG_S * NSEC_PER_SEC) {
+				return true;
+			}
+			preempt_state = PREEMPT_FAULTED;
+			preempt_stat.faulted++;
+			say("gpu: PREEMPTION FAULTED: the switch from ring %u to ring %u is not over after %u s (cntl %08x, level "
+			    "status %08x, int %08x); no more switches\n", cur_ring, next_ring, PREEMPT_WATCHDOG_S, cntl,
+			    G(G8_CP_CONTEXT_SWITCH_LEVEL_STATUS), G(G8_RBBM_INT_0_STATUS));
+			dada_gpu_report("preemption timed out");
+			return false;
+		}
+		cur_ring = next_ring;
+		preempt_state = PREEMPT_FINISH;
+		preempt_update_wptr(cur_ring);
+		preempt_state = PREEMPT_NONE;
+		preempt_keepalive(false);
+		preempt_stat.completed++;
+		preempt_stat.switching += now - preempt_began;
+		if (now - preempt_began > preempt_stat.longest) {
+			preempt_stat.longest = now - preempt_began;
+		}
+		if (gpu_log) {
+			redwood_tl("tl: P %u in %llu\n", cur_ring, ns / 1000);
+		}
+	}
+	if (preempt_state != PREEMPT_NONE) {
+		return false;                   /* (faulted) */
+	}
+	/* "retrigger preemption to avoid a deadlock", and the switch back once the current ring has nothing left */
+	preempt_trigger();
+	if (preempt_state == PREEMPT_TRIGGERED) {
+		return true;
+	}
+	for (uint32_t r = 0; r < RINGS; r++) {
+		if (r != cur_ring && !ring_idle(r)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+preempt_say(void)
+{
+	uint64_t ns, longest;
+
+	absolutetime_to_nanoseconds(preempt_stat.completed ? preempt_stat.switching / preempt_stat.completed : 0, &ns);
+	absolutetime_to_nanoseconds(preempt_stat.longest, &longest);
+	say("gpu: preemption, 10 s: %u triggered, %u completed, %u faulted; a switch took %llu us on average, %llu at most; "
+	    "submissions %u to ring 0, %u to ring 1 (%u, %u waited for room); now on ring %u%s\n", preempt_stat.triggered,
+	    preempt_stat.completed, preempt_stat.faulted, ns / 1000, longest / 1000, preempt_stat.submitted[0],
+	    preempt_stat.submitted[1], preempt_stat.full[0], preempt_stat.full[1], cur_ring,
+	    preempt_state == PREEMPT_FAULTED ? " (FAULTED: no more switches)" : "");
+}
+
+static void
+preempt_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (;;) {
+		uint64_t now, ns, deadline;
+		bool again;
+
+		lck_mtx_lock(preempt_lock);
+		again = preempt_poll();
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - preempt_stat.since, &ns);
+		if (ns >= 10 * NSEC_PER_SEC) {
+			if (preempt_stat.submitted[0] + preempt_stat.submitted[1] != 0 || preempt_stat.faulted != 0) {
+				preempt_say();
+			}
+			bzero(&preempt_stat, sizeof(preempt_stat));
+			preempt_stat.since = now;
+		}
+		if (again) {
+			nanoseconds_to_absolutetime(PREEMPT_POLL_US * NSEC_PER_USEC, &deadline);
+			assert_wait_deadline_with_leeway((event_t)&preempt_poller, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL,
+			    now + deadline, 0);
+		} else {
+			assert_wait_timeout((event_t)&preempt_poller, THREAD_UNINT, 10000, NSEC_PER_MSEC);
+		}
+		lck_mtx_unlock(preempt_lock);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* a6xx_emit_set_pseudo_reg: where the CP saves this ring's state when it is switched away from, and the postamble */
+static void
+ring_pseudo_regs(uint32_t r)
+{
+	ring_command(CP_SET_PSEUDO_REG, 12);
+	ring(PSEUDO_SMMU_INFO);                 /* "don't save SMMU, we write the record from the kernel instead" */
+	ring(0);
+	ring(0);
+	ring(PSEUDO_NON_SECURE_SAVE_ADDR);      /* privileged and non secure buffer save */
+	ring(CORE_RECORD_ADDRESS(r));
+	ring(0);
+	ring(PSEUDO_NON_PRIV_SAVE_ADDR);        /* user context buffer save, unused by the firmware */
+	ring(0);
+	ring(0);
+	ring(PSEUDO_COUNTER);                   /* 0: off */
+	ring(0);
+	ring(0);
+	ring_command(CP_SET_AMBLE, 3);          /* the postamble, run when switched away from (KMD_AMBLE_TYPE) */
+	ring(CORE_POSTAMBLE_ADDRESS);
+	ring(0);
+	ring(postamble_words | KMD_AMBLE_TYPE << 20);
+}
+
+/* a6xx_flush_yield: "yield the floor on command completion" (no address to write, no interrupt) */
+static void
+ring_yield(uint32_t data)
+{
+	ring_command(CP_CONTEXT_SWITCH_YIELD, 4);
+	ring(0);
+	ring(0);
+	ring(data);
+	ring(0);
+}
+
+/* the ring's new wptr to the core if it is the current ring and no switch is in flight (a6xx_flush), else for later */
+static void
+ring_flush(uint32_t r)
+{
+	to_memory(ring_blocks[r]->memory, ring_blocks[r]->size);
+	if (!preempt_in_flight() && cur_ring == r) {
+		Gw(G8_CP_RB_WPTR, *ring_ats[r]);
+	} else {
+		restore_wptr[r] = true;
+	}
+}
+
+/*
+ * a8xx_patch_pwrup_reglist (and the A830's three lists, a8xx_catalog.c): the registers the command processor writes
+ * back after power collapse and preemption, with their values now. ME_INIT was told where this list is (bit 8, "the
+ * register init list with the spinlock") and found it empty, which is all it has been without preemption.
+ */
+static const uint32_t pwrup_ifpc[] = {
+	G8_RBBM_NC_MODE_CNTL, G8_RBBM_SLICE_INTERFACE_HANG_INT_CNTL, G8_RBBM_SLICE_NC_MODE_CNTL, G8_SP_NC_MODE_CNTL,
+	G8_SP_HLSQ_LPAC_GMEM_RANGE_MIN, G8_SP_HLSQ_LPAC_GMEM_RANGE_MIN + 1, G8_SP_CHICKEN_BITS_1, G8_SP_CHICKEN_BITS_2,
+	G8_SP_CHICKEN_BITS_3, G8_SP_PERFCTR_SHADER_MASK, G8_SP_HLSQ_DBG_ECO_CNTL, G8_CP_INTERRUPT_STATUS_MASK_GLOBAL,
+	G8_RBBM_PERFCTR_CNTL,
+};
+static const uint32_t pwrup_preemption[] = {
+	G8_UCHE_MODE_CNTL, G8_UCHE_VARB_IDLE_TIMEOUT, G8_UCHE_GBIF_GX_CONFIG, G8_UCHE_CACHE_WAYS, G8_UCHE_CCHE_MODE_CNTL,
+	G8_UCHE_CCHE_CACHE_WAYS, G8_UCHE_CCHE_GC_GMEM_RANGE_MIN, G8_UCHE_CCHE_GC_GMEM_RANGE_MIN + 1,
+	G8_UCHE_CCHE_LPAC_GMEM_RANGE_MIN, G8_UCHE_CCHE_LPAC_GMEM_RANGE_MIN + 1, G8_UCHE_CCHE_TRAP_BASE,
+	G8_UCHE_CCHE_TRAP_BASE + 1, G8_UCHE_CCHE_WRITE_THRU_BASE, G8_UCHE_CCHE_WRITE_THRU_BASE + 1, G8_UCHE_HW_DBG_CNTL,
+	G8_UCHE_WRITE_THRU_BASE, G8_UCHE_WRITE_THRU_BASE + 1, G8_UCHE_TRAP_BASE, G8_UCHE_TRAP_BASE + 1, G8_UCHE_CLIENT_PF,
+	G8_VSC_KMD_DBG_ECO_CNTL, G8_RB_CMP_NC_MODE_CNTL, G8_SP_HLSQ_TIMEOUT_THRESHOLD_DP, G8_SP_HLSQ_GC_GMEM_RANGE_MIN,
+	G8_SP_HLSQ_GC_GMEM_RANGE_MIN + 1, G8_SP_READ_SEL, G8_TPL1_NC_MODE_CNTL, G8_TPL1_DBG_ECO_CNTL, G8_TPL1_DBG_ECO_CNTL1,
+};
+#define PIPE_AQE0               4
+#define PIPE_AQE1               5
+#define PIPE_DDE_BR             6
+#define ALL_PIPES               (B(PIPE_BR) | B(PIPE_BV) | B(PIPE_LPAC) | B(PIPE_AQE0) | B(PIPE_AQE1) | B(PIPE_DDE_BR) | \
+	                         B(PIPE_DDE_BV))
+static const struct {
+	uint32_t reg, pipes;
+} pwrup_dynamic[] = {
+	{ G8_CP_HW_FAULT_STATUS_MASK_PIPE, ALL_PIPES },
+	{ G8_CP_INTERRUPT_STATUS_MASK_PIPE, ALL_PIPES },
+	{ G8_CP_PROTECT_CNTL_PIPE, B(PIPE_BR) | B(PIPE_BV) | B(PIPE_LPAC) },
+	{ G8_CP_PROTECT_PIPE(15), B(PIPE_BR) | B(PIPE_BV) | B(PIPE_LPAC) },
+	{ G8_GRAS_TSEFE_DBG_ECO_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_GRAS_NC_MODE_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_GRAS_DBG_ECO_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_RB_CCU_CNTL, B(PIPE_BR) },
+	{ G8_RB_CCU_DBG_ECO_CNTL, B(PIPE_BR) },
+	{ G8_RB_CCU_NC_MODE_CNTL, B(PIPE_BR) },
+	{ G8_RB_CMP_NC_MODE_CNTL, B(PIPE_BR) },
+	{ G8_RB_RESOLVE_PREFETCH_CNTL, B(PIPE_BR) },
+	{ G8_RB_CMP_DBG_ECO_CNTL, B(PIPE_BR) },
+	{ G8_RB_GC_GMEM_PROTECT, B(PIPE_BR) },
+	{ G8_RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE, B(PIPE_BR) },
+	{ G8_VPC_FLATSHADE_MODE_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_1, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_2, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_3, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CHICKEN_BITS_4, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_AUTO_VERTEX_STRIDE, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_VIS_STREAM_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_PC_CONTEXT_SWITCH_STABILIZE_CNTL_1, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BV_THRESHOLD, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BR_THRESHOLD, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_BUSY_REQ_CNT, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_CB_LP_REQ_CNT, B(PIPE_BR) | B(PIPE_BV) },
+	{ G8_VFD_DBG_ECO_CNTL, B(PIPE_BR) | B(PIPE_BV) },
+};
+
+static void
+preempt_pwrup_list(uint32_t *ifpc, uint32_t *preemption, uint32_t *dynamic)
+{
+	volatile uint32_t *lock = (volatile uint32_t *)core_pwrup.memory;      /* struct cpu_gpu_lock */
+	volatile uint32_t *dest = lock + 4;                                    /* its regs[] */
+
+	aperture(PIPE_NONE);
+	lock[0] = lock[1] = lock[2] = 0;                                        /* gpu_req, cpu_req, turn */
+	*ifpc = sizeof(pwrup_ifpc) / sizeof(pwrup_ifpc[0]) + G8_CP_PROTECT_GLOBAL_LEN;
+	for (unsigned i = 0; i < sizeof(pwrup_ifpc) / sizeof(pwrup_ifpc[0]); i++) {
+		*dest++ = pwrup_ifpc[i];
+		*dest++ = G(pwrup_ifpc[i]);
+	}
+	for (unsigned i = 0; i < G8_CP_PROTECT_GLOBAL_LEN; i++) {
+		*dest++ = G8_CP_PROTECT_GLOBAL(i);
+		*dest++ = G(G8_CP_PROTECT_GLOBAL(i));
+	}
+	*preemption = sizeof(pwrup_preemption) / sizeof(pwrup_preemption[0]) + 20;
+	for (unsigned i = 0; i < sizeof(pwrup_preemption) / sizeof(pwrup_preemption[0]); i++) {
+		*dest++ = pwrup_preemption[i];
+		*dest++ = G(pwrup_preemption[i]);
+	}
+	for (unsigned i = 0; i < 20; i++) {
+		*dest++ = G8_TPL1_BICUBIC_WEIGHTS_TABLE(i);
+		*dest++ = G(G8_TPL1_BICUBIC_WEIGHTS_TABLE(i));
+	}
+	/* (aperture, register, value) for each pipe the register is in; read through slice 0's aperture */
+	*dynamic = 0;
+	for (uint32_t pipe = PIPE_BR; pipe <= PIPE_DDE_BV; pipe++) {
+		for (unsigned i = 0; i < sizeof(pwrup_dynamic) / sizeof(pwrup_dynamic[0]); i++) {
+			if (!(pwrup_dynamic[i].pipes & B(pipe))) {
+				continue;
+			}
+			aperture(pipe);
+			*dest++ = pipe << 12;
+			*dest++ = pwrup_dynamic[i].reg;
+			*dest++ = G(pwrup_dynamic[i].reg);
+			(*dynamic)++;
+		}
+	}
+	aperture(PIPE_NONE);
+	lock[3] = *ifpc | *preemption << 8 | *dynamic << 16;                    /* ifpc_list_len, preemption_list_len, dynamic_list_len */
+	to_memory(core_pwrup.memory, core_pwrup.size);
+}
+
+/*
+ * a6xx_preempt_init + preempt_init_ring, a8xx_preempt_hw_init, the power-up list, and a8xx_preempt_start (the last
+ * step of a8xx hw_init, on ring 0: protection off, the pseudo registers, a yield), once the core takes commands and is
+ * out of secure mode. Anything failing before the core is told of the second ring leaves one ring, as before
+ * (Linux: "preemption init failed, disabling preemption").
+ */
+static void
+preempt_setup(void)
+{
+	struct cp_smmu_info *info;
+	volatile uint32_t *postamble;
+	uint32_t ifpc, preemption, dynamic, count = 0;
+	thread_t thread;
+
+	say("preemption (dadagpu_preempt=%u): ring 1 at %#x, records at %#x and %#x (%u KB each, privileged), SMMU "
+	    "information at %#x (%s), postamble at %#x%s; IB1LIST markers %s\n", gpu_preempt_arg, CORE_RING1_ADDRESS,
+	    CORE_RECORD_ADDRESS(0), CORE_RECORD_ADDRESS(1), PREEMPT_RECORD_SIZE / 1024, CORE_SMMU_INFO_ADDRESS,
+	    gpu_preempt_arg == 2 ? "given to the core at each switch" : "not given: no table switch", CORE_POSTAMBLE_ADDRESS,
+	    gpu_preempt_post ? "" : " (a NOP: dadagpu_preempt_post=0)",
+	    gpu_preempt_ib ? "on" : "off (dadagpu_preempt_ib=0: switches between submissions only)");
+	if (!block_new(&core_space, &core_ring1, CORE_RING1_ADDRESS, CORE_RING_SIZE, PTE_CORE) ||
+	    !block_new(&core_space, &core_smmu_info, CORE_SMMU_INFO_ADDRESS, 0x1000u * RINGS, PTE_GMU | PTE_READ_ONLY) ||
+	    !block_new(&core_space, &core_postamble, CORE_POSTAMBLE_ADDRESS, 0x1000u, PTE_GMU | PTE_READ_ONLY) ||
+	    !block_new(&core_space, &core_record[0], CORE_RECORD_ADDRESS(0), PREEMPT_RECORD_SIZE, PTE_GMU) ||
+	    !block_new(&core_space, &core_record[1], CORE_RECORD_ADDRESS(1), PREEMPT_RECORD_SIZE, PTE_GMU)) {
+		say("preemption: no memory for it: one ring, as before\n");
+		return;
+	}
+	space_commit(&core_space);
+	preempt_group = lck_grp_alloc_init("dada gpu preemption", LCK_GRP_ATTR_NULL);
+	preempt_lock = lck_mtx_alloc_init(preempt_group, LCK_ATTR_NULL);
+
+	for (uint32_t r = 0; r < RINGS; r++) {
+		struct preempt_record *record = (struct preempt_record *)core_record[r].memory;
+
+		info = (struct cp_smmu_info *)(core_smmu_info.memory + 0x1000u * r);
+		info->magic = SMMU_INFO_MAGIC;
+		info->ttbr0 = core_space.tables[0].phys;        /* the one address space's tables */
+		info->asid = 0xdecafbad;                        /* (Linux's) */
+		info->context_idr = 0;
+		record->magic = PREEMPT_RECORD_MAGIC;
+		record->info = 0;
+		record->data = 0;
+		record->rptr = 0;
+		record->wptr = 0;
+		record->cntl = 12u | 2u << 8;                   /* MSM_GPU_RB_CNTL_DEFAULT, as CP_RB_CNTL */
+		record->rbase = r == 0 ? CORE_RING_ADDRESS : CORE_RING1_ADDRESS;
+		record->counter = 0;
+		record->rptr_addr = CORE_SCRATCH_ADDRESS + RPTR_AT(r);
+		record->bv_rptr_addr = CORE_SCRATCH_ADDRESS + RPTR_AT(r) + 0x40;
+		to_memory(core_record[r].memory, 4096);
+	}
+	to_memory(core_smmu_info.memory, core_smmu_info.size);
+
+	/* preempt_prepare_postamble (a8xx): the performance counters' SRAM cleared, and waited for */
+	postamble = (volatile uint32_t *)core_postamble.memory;
+	postamble[count++] = 7u << 28 | 3 | odd_parity(3) << 15 | CP_REG_RMW << 16 | odd_parity(CP_REG_RMW) << 23;
+	postamble[count++] = G8_RBBM_PERFCTR_SRAM_INIT_CMD;
+	postamble[count++] = 0;
+	postamble[count++] = 1;
+	postamble[count++] = 7u << 28 | 6 | odd_parity(6) << 15 | CP_WAIT_REG_MEM << 16 | odd_parity(CP_WAIT_REG_MEM) << 23;
+	postamble[count++] = 3;                                 /* WRITE_EQ, of a register */
+	postamble[count++] = G8_RBBM_PERFCTR_SRAM_INIT_STATUS;
+	postamble[count++] = 0;
+	postamble[count++] = 1;                                 /* ref */
+	postamble[count++] = 1;                                 /* mask */
+	postamble[count++] = 0;                                 /* delay loop cycles */
+	postamble_words = count;
+	if (!gpu_preempt_post) {
+		/* preempt_disable_postamble (Linux: while sysprof is on): "a NOP that covers the whole buffer" */
+		postamble[0] = 7u << 28 | (count - 1) | odd_parity(count - 1) << 15 | CP_NOP << 16 | odd_parity(CP_NOP) << 23;
+	}
+	to_memory(core_postamble.memory, core_postamble.size);
+
+	/* a8xx_preempt_hw_init: each record from the ring as it stands, "no table switch", GMEM save/restore, ring 0 current */
+	for (uint32_t r = 0; r < RINGS; r++) {
+		struct preempt_record *record = (struct preempt_record *)core_record[r].memory;
+
+		record->wptr = 0;
+		record->rptr = 0;
+		record->rptr_addr = CORE_SCRATCH_ADDRESS + RPTR_AT(r);
+		record->info = 0;
+		record->data = 0;
+		record->rbase = r == 0 ? CORE_RING_ADDRESS : CORE_RING1_ADDRESS;
+		to_memory(core_record[r].memory, 4096);
+	}
+	Gw64(G8_CP_CONTEXT_SWITCH_SMMU_INFO, 0);
+	aperture(PIPE_BR);
+	Gw(G8_RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE, 1);
+	aperture(PIPE_NONE);
+	preempt_state = PREEMPT_NONE;
+	cur_ring = 0;
+	ring1_at = 0;
+
+	preempt_pwrup_list(&ifpc, &preemption, &dynamic);
+	say("preemption: power-up list: %u IFPC registers, %u preemption registers, %u (pipe, register) pairs\n", ifpc,
+	    preemption, dynamic);
+
+	/* a8xx_preempt_start, on ring 0 */
+	ring_select(0);
+	ring_command(CP_SET_PROTECTED_MODE, 1);
+	ring(0);
+	ring_pseudo_regs(0);
+	ring_yield(0);
+	if (!ring_run("take the second ring (a8xx_preempt_start)")) {
+		say("preemption: the core did not get through a8xx_preempt_start: one ring, as before (it may be stuck)\n");
+		return;
+	}
+	preempt_stat.since = mach_absolute_time();
+	if (kernel_thread_start(preempt_thread, NULL, &thread) != KERN_SUCCESS) {
+		say("preemption: no thread to look after it: one ring, as before\n");
+		return;
+	}
+	thread_deallocate(thread);
+	preempt_on = true;
+	say("TWO RINGS, PREEMPTION ON: ring 0 for backboardd, ring 1 for everybody else (on ring %u; ring 0 rptr %u, its "
+	    "shadow %u, wptr %u; ring 1's shadow %u)\n", cur_ring, G(G8_CP_RB_RPTR), scratch_word(RPTR_AT(0)), ring_at,
+	    scratch_word(RPTR_AT(1)));
+}
+
+/*
+ * a7xx_submit with preemption (gpu->nr_rings > 1), to ring `submit_ring`: as dada_gpu_submit below, and also the pseudo
+ * registers, the IB1LIST markers around the command buffers (where the core may switch away in the middle of a
+ * submission: Linux emits them for a queue with MSM_SUBMITQUEUE_ALLOW_PREEMPT; boot-arg dadagpu_preempt_ib=0 leaves them
+ * out, and then the core switches only between submissions), each ring's own fence and timestamps, and a yield at the
+ * end; then a8xx_preempt_trigger.
+ */
+static uint32_t
+submit_rings(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t r = submit_ring, wanted = 96 + 4 * count, room = 0, ticket, slot;
+
+	submit_ring = 0;
+	lck_mtx_lock(preempt_lock);
+	for (int i = 0; i < 20000; i++) {
+		room = (ring_rptr(r) + RING_WORDS - *ring_ats[r] - 1) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		if (i == 0) {
+			preempt_stat.full[r]++;
+		}
+		/* (a ring that is not the current one empties only once the poll thread has switched to it) */
+		lck_mtx_unlock(preempt_lock);
+		thread_wakeup((event_t)&preempt_poller);
+		sleep_us(100);
+		lck_mtx_lock(preempt_lock);
+	}
+	if (room < wanted) {
+		lck_mtx_unlock(preempt_lock);
+		return 0;
+	}
+	times_add();
+	ticket = fence + 1;
+	if ((ticket & 1) != r) {
+		ticket++;
+	}
+	if (ticket == 0) {
+		ticket = 2;                     /* (ring 0's after 0xffffffff: 0 names no submission) */
+	}
+	fence = ticket;
+	last_ticket[r] = ticket;
+	slot = ring_count[r]++ % TIMES;
+	slot_ticket[r][slot] = ticket;
+	slot_pid[r][slot] = proc_selfpid();
+	preempt_stat.submitted[r]++;
+
+	ring_select(r);
+	ring_thread(SYNC_THREADS | THREAD_BR);
+	ring_pseudo_regs(r);
+	ring_command(CP_REG_TO_MEM, 3);
+	ring(G8_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+	ring(CORE_SCRATCH_ADDRESS + RING_TIMES_AT(r) + 16 * slot);
+	ring(0);
+	ring_thread(THREAD_BOTH);
+	ring_command(CP_SET_MARKER, 1);
+	ring(MARKER_IFPC_OFF);
+	if (gpu_preempt_ib) {
+		ring_command(CP_SET_MARKER, 1);
+		ring(MARKER_IB1LIST_START);
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		ring_command(CP_INDIRECT_BUFFER, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	if (gpu_preempt_ib) {
+		ring_command(CP_SET_MARKER, 1);
+		ring(MARKER_IB1LIST_END);
+	}
+	ring_register(G8_CP_SCRATCH_GLOBAL(2), ticket);
+	ring_thread(THREAD_BR);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(CCU_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(CCU_INVALIDATE_COLOR);
+	ring_thread(THREAD_BV);
+	ring_command(CP_EVENT_WRITE7, 4);
+	ring(CACHE_CLEAN | 1u << 27);
+	ring(CORE_SCRATCH_ADDRESS + RING_FENCE_AT(r) + 8);
+	ring(0);
+	ring(ticket);
+	ring_thread(THREAD_BR);
+	ring_command(CP_WAIT_TIMESTAMP, 4);
+	ring(0);
+	ring(CORE_SCRATCH_ADDRESS + RING_FENCE_AT(r) + 8);
+	ring(0);
+	ring(ticket);
+	ring_command(CP_REG_TO_MEM, 3);
+	ring(G8_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+	ring(CORE_SCRATCH_ADDRESS + RING_TIMES_AT(r) + 16 * slot + 8);
+	ring(0);
+	ring_command(CP_EVENT_WRITE7, 4);
+	ring(CACHE_CLEAN | 1u << 27);
+	ring(CORE_SCRATCH_ADDRESS + RING_FENCE_AT(r));
+	ring(0);
+	ring(ticket);
+	ring_thread(THREAD_BOTH);
+	ring_command(CP_SET_MARKER, 1);
+	ring(MARKER_IFPC_ON);
+	ring_yield(1);
+	ring_select(0);
+	ring_flush(r);
+	preempt_trigger();
+	lck_mtx_unlock(preempt_lock);
+	thread_wakeup((event_t)&preempt_poller);
+	return ticket;
+}
+
+/* Linux's a7xx_submit (which a8xx uses), for one ring and the one address space */
+uint32_t
+dada_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 64 + 4 * count, room = 0;
+
+	if (preempt_on) {
+		return submit_rings(addresses, words, count);
+	}
+	for (int i = 0; i < 20000; i++) {
+		room = (G(G8_CP_RB_RPTR) + RING_WORDS - ring_at - 1) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		sleep_us(100);
+	}
+	if (room < wanted) {
+		return 0;
+	}
+	times_add();
+	if (++fence == 0) {
+		fence = 1;
+	}
+	ring_thread(SYNC_THREADS | THREAD_BR);
+	times_pid[fence % TIMES] = proc_selfpid();
+	ring_time(fence, 0);
+	ring_thread(THREAD_BOTH);
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x101);                            /* IFPC off */
+	for (uint32_t i = 0; i < count; i++) {
+		ring_command(CP_INDIRECT_BUFFER, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	ring_register(G8_CP_SCRATCH_GLOBAL(2), fence);
+	ring_thread(THREAD_BR);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(CCU_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(CCU_INVALIDATE_COLOR);
+	ring_thread(THREAD_BV);
+	ring_command(CP_EVENT_WRITE7, 4);
+	ring(CACHE_CLEAN | 1u << 27);
+	ring(CORE_SCRATCH_ADDRESS + BV_FENCE_AT);
+	ring(0);
+	ring(fence);
+	ring_thread(THREAD_BR);
+	ring_command(CP_WAIT_TIMESTAMP, 4);
+	ring(0);
+	ring(CORE_SCRATCH_ADDRESS + BV_FENCE_AT);
+	ring(0);
+	ring(fence);
+	ring_time(fence, 1);
+	ring_command(CP_EVENT_WRITE7, 4);
+	ring(CACHE_CLEAN | 1u << 27);
+	ring(CORE_SCRATCH_ADDRESS + FENCE_AT);
+	ring(0);
+	ring(fence);
+	ring_thread(THREAD_BOTH);
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x100);                            /* IFPC on (the GMU has it off anyway) */
+	to_memory(core_ring.memory, core_ring.size);
+	Gw(G8_CP_RB_WPTR, ring_at);
+	return fence;
+}
+
+void
+dada_gpu_report(const char *why)
+{
+	uint32_t context = smmu_context(&core_space);
+
+	say("gpu: %s: submission %u is the last, done %u (bv %u); rptr %u wptr %u; status %08x int %08x\n", why, fence,
+	    *(volatile uint32_t *)(core_scratch.memory + FENCE_AT), *(volatile uint32_t *)(core_scratch.memory + BV_FENCE_AT),
+	    G(G8_CP_RB_RPTR), ring_at, G(G8_RBBM_STATUS), G(G8_RBBM_INT_0_STATUS));
+	aperture(PIPE_BR);
+	say("gpu:   BR: fault %08x int %08x prot %08x ib1 %08x%08x rem %u\n", G(G8_CP_HW_FAULT_STATUS_PIPE),
+	    G(G8_CP_INTERRUPT_STATUS_PIPE), G(G8_CP_PROTECT_STATUS_PIPE), G(G8_CP_IB1_BASE + 1), G(G8_CP_IB1_BASE),
+	    G(G8_CP_IB1_REM_SIZE));
+	aperture(PIPE_BV);
+	say("gpu:   BV: fault %08x int %08x prot %08x ib1 %08x%08x rem %u\n", G(G8_CP_HW_FAULT_STATUS_PIPE),
+	    G(G8_CP_INTERRUPT_STATUS_PIPE), G(G8_CP_PROTECT_STATUS_PIPE), G(G8_CP_IB1_BASE + 1), G(G8_CP_IB1_BASE),
+	    G(G8_CP_IB1_REM_SIZE));
+	aperture(PIPE_NONE);
+	if (preempt_on) {
+		say("gpu:   rings: on %u, switch state %u (to %u), cntl %08x level %08x; ring 0 wptr %u shadow %u fence %u of %u; "
+		    "ring 1 wptr %u shadow %u fence %u of %u\n", cur_ring, preempt_state, next_ring,
+		    G(G8_CP_CONTEXT_SWITCH_CNTL), G(G8_CP_CONTEXT_SWITCH_LEVEL_STATUS), ring_at, scratch_word(RPTR_AT(0)),
+		    scratch_word(RING_FENCE_AT(0)), last_ticket[0], ring1_at, scratch_word(RPTR_AT(1)),
+		    scratch_word(RING_FENCE_AT(1)), last_ticket[1]);
+	}
+	if (space_faulted(&core_space)) {
+		wr(smmu + context + SMMU_CB_FSR, SMMU_FSR_ALL);
+	}
+}
+
+bool
+dada_gpu_recover(void)
+{
+	return false;
+}
+
+static bool
+all_done(void)
+{
+	if (preempt_on) {
+		return dada_gpu_done(last_ticket[0]) && dada_gpu_done(last_ticket[1]);
+	}
+	return dada_gpu_done(fence);
+}
+
+void
+dada_gpu_stop(void)
+{
+	if (kept) {
+		uint32_t waited = 0;
+
+		kept = false;
+		/* (with two rings, each ring's last: the last of all says nothing of the other ring's) */
+		while (!all_done() && waited < 5000) {
+			sleep_us(100);
+			waited++;
+		}
+		if (preempt_on) {
+			lck_mtx_lock(preempt_lock);
+			preempt_halted = true;          /* (the poll thread touches nothing from here on) */
+			lck_mtx_unlock(preempt_lock);
+		}
+		say("the run is about to end: the GPU is given back (%s)\n", all_done() ? "idle" : "STILL AT WORK");
+		gpu_block_stop();
+	}
+}
+
+/* ---- the way back --------------------------------------------------------------------------------- */
+
+/* nothing of the GPU block may outlive the kernel that started it: its SMMU context points into our memory */
+static void
+gpu_block_stop(void)
+{
+	if (core_runs) {
+		Gw(G8_CP_SQE_CNTL, 0);
+		Gw(G8_GBIF_HALT, 1);
+		core_runs = false;
+	}
+	if (core_powered && gmu_runs) {
+		uint32_t empty[2] = { 0, 0 };
+
+		Gw(G8_GMU_HOST2GMU_INTR_SET, 1u << 31);         /* OOB GPU clear */
+		sleep_ms(5);
+		hfi_send("prepare slumber", HFI_MSG_PREPARE_SLUMBER, empty, 2);
+		core_powered = false;
+	}
+	if (gmu_runs) {
+		Gw(G8_GMU_CM3_SYSRESET, 1);
+		gmu_runs = false;
+		if (!(R(G8_GPU_RSCC_RSC_STATUS0_DRV0) & (1u << 16))) {
+			Gw(G8_GMU_RSCC_CONTROL_REQ, 1);
+			wait_bits(gpu + RSCC_OFFSET + 4UL * G8_GPU_RSCC_RSC_STATUS0_DRV0, 1u << 16, 1u << 16, 10);
+			Gw(G8_GMU_RSCC_CONTROL_REQ, 0);
+		}
+	}
+	if (gmu_space_on) {
+		space_off(&gmu_space, GMU_MATCH);
+		gmu_space_on = false;
+	}
+	if (core_space_on) {
+		wr(smmu + SMMU_SMR(CORE_LPAC_MATCH), 0);
+		wr(smmu + SMMU_S2CR(CORE_LPAC_MATCH), SMMU_S2CR_FAULT);
+		space_off(&core_space, CORE_MATCH);
+		core_space_on = false;
+	}
+	if (zap_loaded) {
+		uint64_t answer = 0;
+
+		say("stop: the zap shader given up: %d\n", scm(SCM_64 | SCM_SIP | SCM_CALL(2, 6), SCM_ONE_VALUE, PAS_GPU, 0, 0,
+		    &answer));
+		zap_loaded = false;
+	}
+	if (rd(gpu + GX_GDSCR_OFFSET) & GDSC_POWER_ON) {
+		say("stop: the 3D core keeps its power (gx %08x)\n", rd(gpu + GX_GDSCR_OFFSET));
+	}
+	if (cx_on() && !cx_off_done) {
+		wr(gpucc + CX_GDSCR, rd(gpucc + CX_GDSCR) | GDSC_SW_COLLAPSE);
+		cx_off_done = true;
+	}
+	say("stop: the GPU block given back (cx %08x)\n", rd(gpucc + CX_GDSCR));
+}
+
+/* on the way back to the loader, with no time for asking: the GMU out of our memory */
+void
+hakios_dada_gpu_quiesce(void)
+{
+	if (gpu == 0) {
+		return;
+	}
+	preempt_halted = true;                  /* (the preemption poll thread: hands off) */
+	if (gmu_runs) {
+		wr(gpu + 4UL * G8_GMU_CM3_SYSRESET, 1);
+		gmu_runs = false;
+	}
+	if (gmu_space_on) {
+		wr(smmu + smmu_context(&gmu_space) + SMMU_CB_SCTLR, 0);
+		gmu_space_on = false;
+	}
+	if (core_runs) {
+		wr(gpu + 4UL * G8_CP_SQE_CNTL, 0);
+		core_runs = false;
+	}
+	if (core_space_on) {
+		wr(smmu + smmu_context(&core_space) + SMMU_CB_SCTLR, 0);
+		core_space_on = false;
+	}
+}
+
+void
+hakios_dada_gpu_init(void)
+{
+	static bool (*const phases[])(void) = { phase_power, phase_gmu_firmware, phase_gmu_start, phase_core_power,
+		phase_core_start, phase_core_commands };
+	static const char *const names[] = { "power", "GMU firmware", "GMU start", "3D core power", "3D core start",
+		"3D core commands" };
+	uint32_t last = 0, keep;
+
+	if (!PE_parse_boot_argn("dadagpu", &last, sizeof(last)) || last == 0) {
+		return;
+	}
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	gpucc = ml_io_map(GPUCC_PHYS, GPUCC_SIZE);
+	gpu = ml_io_map(GPU_PHYS, GPU_SIZE);
+	smmu = ml_io_map(SMMU_PHYS, SMMU_SIZE);
+	gpu_speeds_choose();
+	say("Adreno 830: phases 1..%u\n", last);
+	for (phase = 1; phase <= last && phase <= sizeof(phases) / sizeof(phases[0]); phase++) {
+		if (!phases[phase - 1]()) {
+			say("phase %u (%s) FAILED\n", phase, names[phase - 1]);
+			break;
+		}
+		say("phase %u (%s) done\n", phase, names[phase - 1]);
+	}
+	keep = 0;
+	PE_parse_boot_argn("dadagpu_keep", &keep, sizeof(keep));
+	if (keep && phase > sizeof(phases) / sizeof(phases[0]) && core_runs) {
+		va_free[0].start = DADA_ADDRESSES_START;
+		va_free[0].size = DADA_ADDRESSES_SIZE;
+		va_free_count = 1;
+		bzero((void *)core_scratch.memory, 4096);
+		to_memory(core_scratch.memory, 4096);
+		kept = true;
+		if (gpu_preempt_arg != 0) {
+			preempt_setup();
+		}
+		{
+			/* the submission path once, with a command buffer of ours: a word written, the fence back */
+			volatile uint32_t *ib = (volatile uint32_t *)(core_scratch.memory + 0x2000);
+			volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + 0x1004);
+			uint64_t address = CORE_SCRATCH_ADDRESS + 0x2000;
+			uint32_t words = 4, f;
+
+			*word = 0;
+			ib[0] = 7u << 28 | 3 | odd_parity(3) << 15 | CP_MEM_WRITE << 16 | odd_parity(CP_MEM_WRITE) << 23;
+			ib[1] = CORE_SCRATCH_ADDRESS + 0x1004;
+			ib[2] = 0;
+			ib[3] = 0x1b0c0de1;
+			to_memory(core_scratch.memory, CORE_SCRATCH_SIZE);
+			f = dada_gpu_submit(&address, &words, 1);
+			for (int i = 0; i < 10000 && !dada_gpu_done(f); i++) {
+				sleep_us(100);
+			}
+			to_memory(core_scratch.memory + 0x1000, 64);
+			say("submission %u: %s, the word %08x (%s)\n", f, dada_gpu_done(f) ? "done" : "NOT DONE", *word,
+			    *word == 0x1b0c0de1 ? "AN INDIRECT BUFFER RAN" : "not written");
+			if (!dada_gpu_done(f)) {
+				dada_gpu_report("the first submission");
+			}
+		}
+		say("THE GPU STAYS ON for the system to draw with: the service RedwoodGPU\n");
+		RedwoodGPUStart();
+		say("done\n");
+		return;
+	}
+	gpu_block_stop();
+	say("done\n");
+}
+
+/*
+ * For the governor (hakios_dada_cpu.c): how long the 3D core has worked in all, in microseconds (each submission's
+ * own start and end stamps, as the 5 s lines count them; brought up to date at every submission), the speeds there are,
+ * and a new speed for it: a6xx_hfi_set_freq's message to the GMU (GX_BW_PERF_VOTE), which Linux sends whenever
+ * devfreq picks another level. The GMU moves the clock and its supply itself.
+ */
+uint64_t hakios_dada_gpu_busy_us(void);
+uint64_t
+hakios_dada_gpu_busy_us(void)
+{
+	return busy_ticks * 10 / 192;
+}
+
+uint32_t hakios_dada_gpu_speeds(uint32_t *mhz, uint32_t max);
+uint32_t
+hakios_dada_gpu_speeds(uint32_t *mhz, uint32_t max)
+{
+	gpu_speeds_choose();
+	for (uint32_t i = 0; i < GPU_SPEEDS && i < max; i++) {
+		mhz[i] = gpu_speeds[i].hz / 1000000;
+	}
+	return GPU_SPEEDS;
+}
+
+bool hakios_dada_gpu_set_speed(uint32_t index);
+bool
+hakios_dada_gpu_set_speed(uint32_t index)
+{
+	static lck_grp_t *group;
+	static lck_mtx_t *lock;
+	uint32_t vote[4] = { 0, 1, index, 0 };  /* {header, ack_type blocking, freq index, bw index} (see the first vote) */
+	bool ok;
+
+	if (index < 1 || index >= GPU_SPEEDS || !core_powered || !gmu_runs) {
+		return false;
+	}
+	vote[3] = gpu_bus_index(index);         /* a6xx_gmu_set_freq: the OPP's bandwidth's index, with every speed */
+	if (lock == NULL) {
+		group = lck_grp_alloc_init("dada gpu speed", LCK_GRP_ATTR_NULL);
+		lock = lck_mtx_alloc_init(group, LCK_ATTR_NULL);
+	}
+	lck_mtx_lock(lock);
+	hfi_quiet = true;
+	ok = hfi_send("a speed", HFI_MSG_GX_BW_PERF_VOTE, vote, 4);
+	hfi_quiet = false;
+	lck_mtx_unlock(lock);
+	return ok;
+}
diff --git a/bsd/dev/hakios_dada_touch.c b/bsd/dev/hakios_dada_touch.c
new file mode 100644
index 0000000..0e42505
--- /dev/null
+++ b/bsd/dev/hakios_dada_touch.c
@@ -0,0 +1,1460 @@
+/*
+ * The touch screen of the Xiaomi 15 (dada, SM8750): a Synaptics TouchComm ("TCM") controller on
+ * the SPI bus of serial engine 2 of the second QUP wrapper, as a source of touches for
+ * /dev/redwood-touch (sys/redwood_input.h). Only with boot-arg dadatouch=1: every address below
+ * belongs to this phone (its own device tree, Android's).
+ *
+ * As redwood_goodix.c does for the POCO X5 Pro, the driver does everything itself:
+ *   power    iovdd 1.8 V from LDO12 of PMIC B ("ldob12"), avdd 3.0 V from LDO16 ("ldob16"),
+ *            through RPMh (the application processor's DRV 2, RSC version 3 register layout)
+ *   clocks   the wrapper's AHB and core clocks and the engine's clock, by vote in GCC; the
+ *            engine's rate comes from the wrapper's "QSPI reference" clock generator
+ *   pins     gpio40..43 to the engine (MISO, MOSI, CLK, CS), gpio161 reset, gpio162 interrupt
+ *            (low while the controller has a message)
+ *   SPI      the engine ("GENI") in FIFO mode, polled
+ *   chip     TouchComm: every read is a message -- 0xa5, a status or report code, a 16-bit length,
+ *            the payload, 0x5a -- read as the 4-byte header and then the rest (which the chip sends
+ *            again behind 0xa5 0x03, "continued read"); a command is the code, a 16-bit length and
+ *            the payload. After reset the chip announces itself with an identify report; we ask
+ *            for the application information (the coordinate range, the number of objects) and the
+ *            touch report configuration, a list of fields and their widths in bits, by which every
+ *            touch report (0x11) is then taken apart.
+ * No interrupt is used: a thread looks at the interrupt line every 4 ms (touch_poll_us=N).
+ * Lines go to the loader's log (redwood_tl): what was found, the first reports, a count a minute.
+ *
+ * Layouts: Linux drivers/spi/spi-geni-qcom.c, drivers/soc/qcom/{qcom-geni-se,rpmh-rsc,cmd-db}.c,
+ * drivers/clk/qcom/gcc-sm8750.c, drivers/pinctrl/qcom/pinctrl-sm8750.c, and Synaptics' TCM driver
+ * (synaptics_tcm_{core,spi,touch}.c of the vendor kernels).
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+#define say(...) redwood_tl("dtouch: " __VA_ARGS__)
+
+static vm_offset_t tlmm, gcc, se, rsc, cmd_db;
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+sleep_us(uint32_t us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- pins (TLMM) ------------------------------------------------------------------------------- */
+
+#define TLMM_PHYS               0x0f100000UL    /* GPIO 0 (Android's "sun-tlmm" node starts 1 MB lower) */
+#define TLMM_SIZE               0x102000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define PULL_NONE               0
+#define PULL_DOWN               1
+#define PULL_UP                 3
+
+#define PIN_MISO                40
+#define PIN_MOSI                41
+#define PIN_CLK                 42
+#define PIN_CS                  43
+#define PIN_RESET               161     /* low = in reset */
+#define PIN_INT                 162     /* low = the chip has a message */
+#define PIN_FUNCTION_SPI        1       /* "qup1_se2" */
+
+static void
+gpio_configure(unsigned pin, unsigned function, unsigned pull, unsigned ma, bool output)
+{
+	wr(GPIO_CFG(pin), pull | function << 2 | (ma / 2 - 1) << 6 | (output ? 1u << 9 : 0));
+}
+
+static void
+gpio_set(unsigned pin, bool high)
+{
+	wr(GPIO_IO(pin), high ? 2 : 0);
+}
+
+static bool
+gpio_get(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static void
+gpio_output(unsigned pin, bool high, unsigned pull, unsigned ma)
+{
+	gpio_set(pin, high);
+	gpio_configure(pin, 0, pull, ma, true);
+}
+
+/* ---- the supplies (RPMh) ------------------------------------------------------------------------- */
+
+#define CMD_DB_PHYS             0x81c60000UL
+#define CMD_DB_SIZE             0x20000UL
+#define RSC_PHYS                0x16520000UL    /* "drv-2", the application processor's */
+#define RSC_SIZE                0x10000UL
+#define TCS_BASE                0xd00           /* command slot set 0: the first "active" one (tcs-config) */
+#define MSGID_WRITE_4_BYTES     0x10008
+#define MSGID_RESPONSE          0x100
+#define VRM_VOLTAGE             0
+#define VRM_ENABLE              4
+#define VRM_MODE                8
+#define VRM_MODE_LDO_HPM        7
+
+/* register offsets inside a slot set: RSC version 2 and version 3 (SM8550 on) differ */
+static struct {
+	uint32_t wait, control, status, cmd_enable, msgid, addr, data, cmd_size;
+} tcs_reg = { 0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38, 20 };
+#define TCS_IRQ_ENABLE          0x00
+#define TCS_IRQ_STATUS          0x04
+#define TCS_IRQ_CLEAR           0x08
+#define TCS_CONTROL_ENABLE      (1u << 16)
+#define TCS_CONTROL_TRIGGER     (1u << 24)
+#define TCS(reg)                (rsc + TCS_BASE + (reg))
+
+struct cmd_db_slave {
+	uint16_t id, header_offset, data_offset, count, version, reserved[3];
+};
+struct cmd_db_header {
+	uint32_t version;
+	uint8_t magic[4];
+	struct cmd_db_slave slave[8];
+	uint32_t checksum, reserved;
+	uint8_t data[];
+};
+struct cmd_db_entry {
+	char id[8];
+	uint32_t priority[2];
+	uint32_t address;
+	uint16_t length, offset;
+};
+
+static uint32_t
+rpmh_address(const char *name)
+{
+	const struct cmd_db_header *db = (const struct cmd_db_header *)cmd_db;
+	char id[8] = { 0 };
+
+	if (db->magic[0] != 0xdb || db->magic[1] != 0x30 || db->magic[2] != 0x03 || db->magic[3] != 0x0c) {
+		say("no command database (magic %02x %02x %02x %02x)\n", db->magic[0], db->magic[1], db->magic[2],
+		    db->magic[3]);
+		return 0;
+	}
+	strlcpy(id, name, sizeof(id));
+	for (unsigned s = 0; s < 8; s++) {
+		const struct cmd_db_slave *slave = &db->slave[s];
+		const struct cmd_db_entry *entry = (const struct cmd_db_entry *)(db->data + slave->header_offset);
+
+		if (slave->id == 0 || slave->header_offset >= CMD_DB_SIZE - 0x1000 || slave->count > 512) {
+			continue;
+		}
+		for (unsigned i = 0; i < slave->count; i++) {
+			if (memcmp(entry[i].id, id, sizeof(id)) == 0) {
+				return entry[i].address;
+			}
+		}
+	}
+	return 0;
+}
+
+static bool
+rpmh_wait(uint32_t reg, uint32_t mask, uint32_t value, const char *what)
+{
+	for (int i = 0; i < 2000; i++) {
+		if ((rd(TCS(reg)) & mask) == value) {
+			return true;
+		}
+		sleep_us(100);
+	}
+	say("RPMh: timeout waiting for %s (register %#x = %#x)\n", what, reg, rd(TCS(reg)));
+	return false;
+}
+
+static bool
+rpmh_write(const uint32_t *address, const uint32_t *data, unsigned count)
+{
+	uint32_t irq_enable = rd(TCS(TCS_IRQ_ENABLE));
+	bool done;
+
+	for (int i = 0; rd(TCS(tcs_reg.status)) == 0; i++) {
+		if (i > 2000) {
+			say("RPMh: the command slots stay busy\n");
+			return false;
+		}
+		sleep_us(100);
+	}
+	wr(TCS(tcs_reg.control), rd(TCS(tcs_reg.control)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(tcs_reg.control), rd(TCS(tcs_reg.control)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	for (unsigned i = 0; i < count; i++) {
+		wr(TCS(tcs_reg.msgid + tcs_reg.cmd_size * i), MSGID_WRITE_4_BYTES | MSGID_RESPONSE);
+		wr(TCS(tcs_reg.addr + tcs_reg.cmd_size * i), address[i]);
+		wr(TCS(tcs_reg.data + tcs_reg.cmd_size * i), data[i]);
+	}
+	wr(TCS(tcs_reg.wait), (1u << count) - 1);
+	wr(TCS(tcs_reg.cmd_enable), (1u << count) - 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable | 1);
+	wr(TCS(tcs_reg.control), TCS_CONTROL_ENABLE);
+	wr(TCS(tcs_reg.control), TCS_CONTROL_ENABLE | TCS_CONTROL_TRIGGER);
+
+	done = rpmh_wait(TCS_IRQ_STATUS, 1, 1, "the request");
+	wr(TCS(tcs_reg.control), rd(TCS(tcs_reg.control)) & ~TCS_CONTROL_TRIGGER);
+	wr(TCS(tcs_reg.control), rd(TCS(tcs_reg.control)) & ~TCS_CONTROL_ENABLE);
+	wr(TCS(tcs_reg.cmd_enable), 0);
+	wr(TCS(tcs_reg.wait), 0);
+	wr(TCS(TCS_IRQ_CLEAR), 1);
+	wr(TCS(TCS_IRQ_ENABLE), irq_enable);
+	return done;
+}
+
+static bool
+ldo_on(const char *name, uint32_t millivolts)
+{
+	uint32_t base = rpmh_address(name);
+	uint32_t address[3] = { base + VRM_VOLTAGE, base + VRM_ENABLE, base + VRM_MODE };
+	uint32_t data[3] = { millivolts, 1, VRM_MODE_LDO_HPM };
+
+	if (base == 0 || (base >> 16 & 0xf) != 4) {
+		say("RPMh: no regulator \"%s\" (address %#x)\n", name, base);
+		return false;
+	}
+	if (!rpmh_write(address, data, 3)) {
+		return false;
+	}
+	say("%s on at %u mV (RPMh address %#x)\n", name, millivolts, base);
+	return true;
+}
+
+static void
+supplies_on(void)
+{
+	uint32_t id = rd(rsc);
+	uint32_t major = id >> 16 & 0xff;
+
+	if (major >= 3) {
+		tcs_reg.wait = 0x20;
+		tcs_reg.control = 0x24;
+		tcs_reg.status = 0x28;
+		tcs_reg.cmd_enable = 0x2c;
+		tcs_reg.msgid = 0x34;
+		tcs_reg.addr = 0x38;
+		tcs_reg.data = 0x3c;
+		tcs_reg.cmd_size = 24;
+	}
+	say("RPMh: RSC id %#x (version %u); slot status %#x control %#x\n", id, major, rd(TCS(tcs_reg.status)),
+	    rd(TCS(tcs_reg.control)));
+	ldo_on("ldob12", 1800);         /* iovdd */
+	ldo_on("ldob16", 3000);         /* avdd */
+}
+
+/* ---- clocks (GCC) -------------------------------------------------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x60000UL
+#define GCC_VOTE                (gcc + 0x52008)
+#define VOTE_QUP1_CORE_2X       (1u << 18)
+#define VOTE_QUP1_CORE          (1u << 19)
+#define VOTE_QUP1_M_AHB         (1u << 20)
+#define VOTE_QUP1_S_AHB         (1u << 21)
+#define VOTE_QUP1_S2            (1u << 24)
+#define GCC_QUP1_M_AHB_CBCR     (gcc + 0x23140)
+#define GCC_QUP1_S_AHB_CBCR     (gcc + 0x23144)
+#define GCC_QUP1_S2_CBCR        (gcc + 0x1827c)
+#define GCC_QUP1_S2_DIV         (gcc + 0x1828c)         /* [3:0] divider - 1, behind the generator */
+#define GCC_QSPI_REF_CMD        (gcc + 0x188c0)
+#define GCC_QSPI_REF_CFG        (gcc + 0x188c4)
+#define GCC_QSPI_REF_DFSR       (gcc + 0x188d4)
+#define GCC_QSPI_REF_PERF_CFG(l) (gcc + 0x188dc + 4 * (l))
+#define GCC_QSPI_REF_PERF_M(l)  (gcc + 0x1891c + 4 * (l))
+#define GCC_QSPI_REF_PERF_N(l)  (gcc + 0x1895c + 4 * (l))
+#define CLOCK_OFF               (1u << 31)
+#define XO_HZ                   19200000
+
+static uint32_t se_source_hz, se_clock_select;
+
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	/* parent map 5: 0 crystal, 1 GPLL0 (600 MHz), 2 GPLL7 (not known here), 6 GPLL0 even (300 MHz) */
+	static const uint32_t parent[8] = { XO_HZ, 600000000, 0, 0, 0, 0, 300000000, 0 };
+	uint64_t hz = parent[cfg >> 8 & 7];
+	uint32_t divider = cfg & 0x1f, mode = cfg >> 12 & 3;
+
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffff) + (m & 0xffff);
+
+		if (n) {
+			hz = hz * (m & 0xffff) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+static bool
+clocks_on(void)
+{
+	uint32_t post = (rd(GCC_QUP1_S2_DIV) & 0xf) + 1;
+
+	wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP1_CORE_2X | VOTE_QUP1_CORE | VOTE_QUP1_M_AHB | VOTE_QUP1_S_AHB);
+	if (rd(GCC_QSPI_REF_DFSR) & 1) {
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t hz = rcg_rate(rd(GCC_QSPI_REF_PERF_CFG(level)), rd(GCC_QSPI_REF_PERF_M(level)),
+			    rd(GCC_QSPI_REF_PERF_N(level))) / post;
+
+			if (hz >= 4000000 && (se_source_hz == 0 || hz < se_source_hz)) {
+				se_source_hz = hz;
+				se_clock_select = level;
+			}
+		}
+		if (se_source_hz == 0) {
+			say("no usable preset clock rate\n");
+			return false;
+		}
+	} else {
+		wr(GCC_QSPI_REF_CFG, (rd(GCC_QSPI_REF_CFG) & ~0x371fu) | 1);
+		wr(GCC_QSPI_REF_CMD, rd(GCC_QSPI_REF_CMD) | 1);
+		for (int i = 0; i < 500 && (rd(GCC_QSPI_REF_CMD) & 1); i++) {
+			sleep_us(10);
+		}
+		if (rd(GCC_QSPI_REF_CMD) & 1) {
+			say("the engine's clock does not take its configuration (%#x)\n", rd(GCC_QSPI_REF_CMD));
+			return false;
+		}
+		se_source_hz = XO_HZ / post;
+		se_clock_select = 0;
+	}
+	wr(GCC_VOTE, rd(GCC_VOTE) | VOTE_QUP1_S2);
+	for (int i = 0; i < 1000; i++) {
+		if (!((rd(GCC_QUP1_M_AHB_CBCR) | rd(GCC_QUP1_S_AHB_CBCR) | rd(GCC_QUP1_S2_CBCR)) & CLOCK_OFF)) {
+			return true;
+		}
+		sleep_us(10);
+	}
+	say("clocks stay off: %#x %#x %#x\n", rd(GCC_QUP1_M_AHB_CBCR), rd(GCC_QUP1_S_AHB_CBCR), rd(GCC_QUP1_S2_CBCR));
+	return false;
+}
+
+/* ---- SPI through the serial engine (GENI) ---------------------------------------------------------- */
+
+#define SE_PHYS                 0x00a88000UL
+#define SE_SIZE                 0x4000UL
+#define GENI_FORCE_DEFAULT      (se + 0x020)
+#define GENI_OUTPUT_CTRL        (se + 0x024)
+#define GENI_CGC_CTRL           (se + 0x028)
+#define GENI_STATUS             (se + 0x040)
+#define GENI_SER_M_CLK_CFG      (se + 0x048)
+#define GENI_IF_DISABLE_RO      (se + 0x064)
+#define GENI_FW_REVISION_RO     (se + 0x068)
+#define GENI_CLK_SEL            (se + 0x07c)
+#define SPI_CPHA                (se + 0x224)
+#define SPI_LOOPBACK            (se + 0x22c)
+#define SPI_CPOL                (se + 0x230)
+#define SPI_DEMUX_OUTPUT_INV    (se + 0x24c)
+#define SPI_DEMUX_SEL           (se + 0x250)
+#define GENI_BYTE_GRAN          (se + 0x254)
+#define GENI_DMA_MODE_EN        (se + 0x258)
+#define SPI_TRANS_CFG           (se + 0x25c)
+#define GENI_TX_PACKING_CFG0    (se + 0x260)
+#define GENI_TX_PACKING_CFG1    (se + 0x264)
+#define SPI_WORD_LEN            (se + 0x268)
+#define SPI_TX_TRANS_LEN        (se + 0x26c)
+#define SPI_RX_TRANS_LEN        (se + 0x270)
+#define SPI_DELAY_COUNTERS      (se + 0x278)
+#define GENI_RX_PACKING_CFG0    (se + 0x284)
+#define GENI_RX_PACKING_CFG1    (se + 0x288)
+#define GENI_M_CMD0             (se + 0x600)
+#define GENI_M_CMD_CTRL         (se + 0x604)
+#define GENI_M_IRQ_STATUS       (se + 0x610)
+#define GENI_M_IRQ_EN           (se + 0x614)
+#define GENI_M_IRQ_CLEAR        (se + 0x618)
+#define GENI_S_IRQ_CLEAR        (se + 0x648)
+#define GENI_TX_FIFO            (se + 0x700)
+#define GENI_RX_FIFO            (se + 0x780)
+#define GENI_TX_FIFO_STATUS     (se + 0x800)
+#define GENI_RX_FIFO_STATUS     (se + 0x804)
+#define GENI_TX_WATERMARK       (se + 0x80c)
+#define GENI_RX_WATERMARK       (se + 0x810)
+#define GENI_RX_RFR_WATERMARK   (se + 0x814)
+#define SE_DMA_TX_IRQ_CLR       (se + 0xc44)
+#define SE_DMA_RX_IRQ_CLR       (se + 0xd44)
+#define SE_GSI_EVENT_EN         (se + 0xe18)
+#define SE_IRQ_EN               (se + 0xe1c)
+#define SE_HW_PARAM_0           (se + 0xe24)
+#define SE_DMA_GENERAL_CFG      (se + 0xe30)
+
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define M_ERRORS                ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX         (3u << 27)
+
+static uint32_t fifo_depth;
+
+static const char *
+geni_spi_init(uint32_t hz)
+{
+	uint32_t divider;
+
+	if ((rd(GENI_FW_REVISION_RO) >> 8 & 0xff) != 1) {
+		return "the serial engine has no SPI firmware";
+	}
+	if (rd(GENI_IF_DISABLE_RO) & 1) {
+		return "the serial engine's FIFO interface is disabled";
+	}
+	fifo_depth = rd(SE_HW_PARAM_0) >> 16 & 0x3f;
+	if (fifo_depth < 4) {
+		return "the serial engine reports no FIFO";
+	}
+	wr(SE_GSI_EVENT_EN, 0);
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(GENI_S_IRQ_CLEAR, 0xffffffff);
+	wr(SE_DMA_TX_IRQ_CLR, 0xffffffff);
+	wr(SE_DMA_RX_IRQ_CLR, 0xffffffff);
+	wr(GENI_CGC_CTRL, rd(GENI_CGC_CTRL) | 0x7f);
+	wr(SE_DMA_GENERAL_CFG, rd(SE_DMA_GENERAL_CFG) | 0xf);
+	wr(GENI_OUTPUT_CTRL, 0x7f);
+	wr(GENI_FORCE_DEFAULT, 1);
+	wr(GENI_DMA_MODE_EN, rd(GENI_DMA_MODE_EN) & ~1u);
+	wr(GENI_RX_WATERMARK, fifo_depth - 3);
+	wr(GENI_RX_RFR_WATERMARK, fifo_depth - 2);
+	wr(GENI_TX_WATERMARK, 0);
+	wr(SE_IRQ_EN, rd(SE_IRQ_EN) | 0xf);
+	wr(GENI_M_IRQ_EN, rd(GENI_M_IRQ_EN) | 0x7fc0007f);
+
+	/* mode 0 (synaptics,spi-mode 0), chip select 0, 8 bits, most significant first */
+	wr(SPI_LOOPBACK, 0);
+	wr(SPI_DEMUX_SEL, 0);
+	wr(SPI_CPHA, 0);
+	wr(SPI_CPOL, 0);
+	wr(SPI_DEMUX_OUTPUT_INV, 0);
+	wr(SPI_TRANS_CFG, rd(SPI_TRANS_CFG) & ~2u);
+	wr(SPI_DELAY_COUNTERS, 0);
+	wr(GENI_TX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_TX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_RX_PACKING_CFG0, 0x0007f8fe);
+	wr(GENI_RX_PACKING_CFG1, 0x000ffefe);
+	wr(GENI_BYTE_GRAN, 0);
+	wr(SPI_WORD_LEN, 8 - 4);
+
+	divider = (se_source_hz + hz - 1) / hz;
+	wr(GENI_CLK_SEL, se_clock_select & 7);
+	wr(GENI_SER_M_CLK_CFG, (divider ? divider : 1) << 4 | 1);
+	return NULL;
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(GENI_RX_FIFO_STATUS), words = status & 0x01ffffff, bytes = words * 4;
+
+	if (status & 0x80000000u) {
+		uint32_t valid = status >> 28 & 7;
+
+		if (valid && valid < 4) {
+			bytes -= 4 - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		uint32_t word = rd(GENI_RX_FIFO);
+
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				if (rx) {
+					rx[*received] = (uint8_t)(word >> (8 * j));
+				}
+				(*received)++;
+			}
+		}
+	}
+}
+
+static void
+geni_recover(void)
+{
+	wr(GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		sleep_us(100);
+	}
+	if (!(rd(GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 2000 && !(rd(GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			sleep_us(100);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(GENI_RX_FIFO_STATUS) & 0x01ffffff); i++) {
+		(void)rd(GENI_RX_FIFO);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+}
+
+/* One transfer with the chip selected throughout: `length` bytes out (0xff without tx) and as many in. */
+static bool
+geni_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	static unsigned complaints;
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+
+	for (int i = 0; rd(GENI_STATUS) & 1; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		sleep_us(100);
+	}
+	wr(GENI_M_IRQ_CLEAR, 0xffffffff);
+	wr(SPI_TX_TRANS_LEN, length);
+	wr(SPI_RX_TRANS_LEN, length);
+	wr(GENI_M_CMD0, SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length && (rd(GENI_TX_FIFO_STATUS) & 0x0fffffff) + 1 < fifo_depth) {
+			uint32_t word = 0;
+
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0xff) << (8 * j);
+			}
+			wr(GENI_TX_FIFO, word);
+		}
+		status = rd(GENI_M_IRQ_STATUS);
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(GENI_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	if (complaints++ < 8) {
+		say("SPI transfer of %u bytes failed: status %#x, sent %u, received %u\n", length, status, sent, received);
+	}
+	geni_recover();
+	return false;
+}
+
+/*
+ * ---- SPI by hand, on the same pins ----
+ * dada's boot firmware hands serial engine 2 over in GSI (DMA) mode only: its FIFO interface is
+ * disabled ("qcom,la-vm", a GPI channel in Android's device tree). Until the GPI DMA engine is
+ * driven, the four pins are driven as GPIOs: mode 0, clock idle low, data read on the rising edge
+ * and changed on the falling one, most significant bit first. Each pin write is a posted store to
+ * the TLMM; reading the input pin orders them, which also paces the clock at a few MHz at most.
+ */
+static void
+bitbang_init(void)
+{
+	gpio_output(PIN_CS, true, PULL_NONE, 6);
+	gpio_output(PIN_CLK, false, PULL_NONE, 6);
+	gpio_output(PIN_MOSI, true, PULL_NONE, 6);
+	gpio_configure(PIN_MISO, 0, PULL_DOWN, 2, false);
+}
+
+static uint32_t bitbang_half_ns = 150;
+
+static inline void
+bitbang_wait(void)
+{
+	uint64_t until = mach_absolute_time() + bitbang_half_ns / 52;        /* 19.2 MHz ticks, about 52 ns each */
+
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+bitbang_select(bool on)
+{
+	if (on) {
+		gpio_set(PIN_CS, false);
+		(void)gpio_get(PIN_CS);
+		bitbang_wait();
+	} else {
+		(void)gpio_get(PIN_MISO);
+		bitbang_wait();
+		gpio_set(PIN_CS, true);
+		(void)gpio_get(PIN_CS);
+	}
+}
+
+/* bytes with the chip already selected (bitbang_select) */
+static void
+bitbang_bytes(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	for (uint32_t i = 0; i < length; i++) {
+		uint8_t out = tx ? tx[i] : 0xff, in = 0;
+
+		for (int bit = 7; bit >= 0; bit--) {
+			gpio_set(PIN_MOSI, out >> bit & 1);
+			(void)gpio_get(PIN_MISO);
+			bitbang_wait();
+			gpio_set(PIN_CLK, true);
+			(void)gpio_get(PIN_CLK);
+			bitbang_wait();
+			in = (uint8_t)(in << 1 | gpio_get(PIN_MISO));
+			gpio_set(PIN_CLK, false);
+		}
+		if (rx) {
+			rx[i] = in;
+		}
+	}
+}
+
+static bool
+bitbang_transfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	bitbang_select(true);
+	bitbang_bytes(tx, rx, length);
+	bitbang_select(false);
+	return true;
+}
+
+static bool (*spi_transfer)(const uint8_t *tx, uint8_t *rx, uint32_t length) = geni_transfer;
+
+/* ---- TouchComm -------------------------------------------------------------------------------------- */
+
+#define TCM_MARKER              0xa5
+#define TCM_PADDING             0x5a
+#define CMD_IDENTIFY            0x02
+#define CMD_RESET               0x04
+#define CMD_ENABLE_REPORT       0x05
+#define CMD_DISABLE_REPORT      0x06
+#define CMD_GET_DYNAMIC_CONFIG  0x23
+#define CMD_SET_DYNAMIC_CONFIG  0x24
+#define CMD_EXIT_DEEP_SLEEP     0x2d
+#define DC_ENABLE_WAKEUP_GESTURE_MODE 0x09
+#define DC_TOUCH_SCAN_MODE      0xf2
+#define REPORT_XIAOMI_FRAME     0xc0    /* 1708 bytes, unasked, at every frame: Xiaomi's ("frame data") */
+#define CMD_RUN_APPLICATION     0x14
+#define CMD_GET_APPLICATION_INFO 0x20
+#define CMD_GET_TOUCH_REPORT_CONFIG 0x25
+#define STATUS_IDLE             0x00
+#define STATUS_OK               0x01
+#define STATUS_BUSY             0x02
+#define STATUS_CONTINUED_READ   0x03
+#define STATUS_INVALID          0xff
+#define REPORT_IDENTIFY         0x10
+#define REPORT_TOUCH            0x11
+#define MODE_APPLICATION        0x01
+#define TCM_MAX_PAYLOAD         4096
+#define TCM_ONE_READ            1024    /* the most one selection carries (identify: max write size 0x400) */
+#define MAX_OBJECTS             10
+
+static uint8_t message[TCM_MAX_PAYLOAD + 8];
+static uint8_t touch_config[256];
+static uint32_t touch_config_size, max_x = 1200, max_y = 2670, max_objects = MAX_OBJECTS;
+static struct {
+	unsigned polls, messages, touch_reports, bad, other, touches, resyncs;
+	uint32_t last_x, last_y;
+} seen;
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static void
+dump(const char *what, const uint8_t *p, uint32_t length)
+{
+	char line[3 * 40 + 1];
+	uint32_t n = length < 40 ? length : 40;
+
+	for (uint32_t i = 0; i < n; i++) {
+		snprintf(line + 3 * i, sizeof(line) - 3 * i, "%02x ", p[i]);
+	}
+	line[3 * n] = 0;
+	say("%s (%u bytes): %s\n", what, length, line);
+}
+
+/*
+ * Read one message: its code into *code, its payload into message[], its length into *length.
+ * The chip sends a message from its start in every transfer (0xa5, code, 16-bit length, payload,
+ * 0x5a) until it has all been read; what a transfer leaves, the next one gets behind 0xa5 0x03
+ * ("continued read", no length). So the first transfer is a generous one (READ_FIRST bytes,
+ * Synaptics' "predictive reading"), and only a longer message takes a second for the rest.
+ * false: no message (no marker: the chip is not there, or it is not talking yet).
+ */
+#define READ_FIRST              64
+static unsigned raw_dumps;
+static uint32_t pending_payload;        /* a big message whose header was read and whose rest was not yet */
+static uint8_t pending_code;
+
+static bool
+tcm_read(uint8_t *code, uint32_t *length)
+{
+	static uint8_t first[READ_FIRST];
+	uint32_t payload, total;
+
+	if (spi_transfer == bitbang_transfer) {
+		/*
+		 * By hand the chip stays selected from the header to the padding byte: the whole message in
+		 * one go, no "continued read" (which this chip answers with nothing but 0xff by hand).
+		 */
+		bitbang_select(true);
+		bitbang_bytes(NULL, first, 4);
+		if (first[0] != TCM_MARKER) {
+			bitbang_select(false);
+			seen.bad++;
+			if (seen.bad <= 4 && first[0] != 0xff) {
+				dump("no marker", first, 4);
+			}
+			return false;
+		}
+		*code = first[1];
+		payload = le16(first + 2);
+		*length = 0;
+		if (*code == STATUS_CONTINUED_READ && pending_payload != 0 && pending_payload <= TCM_MAX_PAYLOAD) {
+			/*
+			 * The rest of the big message whose header the last look had: 0xa5 0x03 and then its
+			 * payload from the start (the two bytes read as a length are its first two).
+			 */
+			message[0] = first[2];
+			message[1] = first[3];
+			bitbang_bytes(NULL, message + 2, pending_payload - 2 + 1);
+			bitbang_select(false);
+			*code = pending_code;
+			*length = pending_payload;
+			pending_payload = 0;
+			seen.resyncs++;
+			return true;
+		}
+		if (*code == STATUS_CONTINUED_READ || payload > TCM_MAX_PAYLOAD) {
+			/*
+			 * Out of step: the chip is still sending the rest of an earlier message (behind 0xa5 0x03,
+			 * no length of its own). Take all of it now, in this same selection, and drop it: the
+			 * longest message there is (Xiaomi's frame) fits in the buffer, and what follows its end
+			 * is 0xff.
+			 */
+			bitbang_bytes(NULL, message, 2048);
+			bitbang_select(false);
+			if (seen.resyncs++ < 6) {
+				say("out of step (%02x %02x %02x %02x): the rest of a message dropped\n", first[0], first[1],
+				    first[2], first[3]);
+			}
+			return false;
+		}
+		if (payload + 1 > TCM_ONE_READ) {
+			pending_code = *code;
+			/*
+			 * More than the chip sends in one selection (Xiaomi's 1708-byte frame): the header was
+			 * all of this one; the payload comes in the next, behind 0xa5 0x03 -- once the chip has
+			 * it ready, so a selection that finds 0xff is let go and tried again.
+			 */
+			bitbang_select(false);
+			for (int tries = 0;; tries++) {
+				uint8_t lead[2];
+
+				if (tries == 200) {
+					/* (what the chip still has of it, the next look takes as the rest: pending_payload) */
+					pending_payload = payload;
+					seen.bad++;
+					return false;
+				}
+				delay_for_interval(100, NSEC_PER_USEC);
+				bitbang_select(true);
+				bitbang_bytes(NULL, lead, 2);
+				if (lead[0] == TCM_MARKER && lead[1] == STATUS_CONTINUED_READ) {
+					break;
+				}
+				bitbang_select(false);
+			}
+		}
+		bitbang_bytes(NULL, message, payload + 1);      /* and the padding byte */
+		bitbang_select(false);
+		if (raw_dumps < 8) {
+			raw_dumps++;
+			dump("message", first, 4);
+		}
+		if (*code == STATUS_CONTINUED_READ) {
+			seen.bad++;
+			return false;
+		}
+		*length = payload;
+		return true;
+	}
+	if (!spi_transfer(NULL, first, sizeof(first))) {
+		return false;
+	}
+	if (raw_dumps < 6 && first[0] != 0xff) {
+		raw_dumps++;
+		dump("raw", first, 16);
+	}
+	if (first[0] != TCM_MARKER) {
+		seen.bad++;
+		if (seen.bad <= 4) {
+			dump("no marker", first, 8);
+		}
+		return false;
+	}
+	*code = first[1];
+	*length = 0;
+	if (*code == STATUS_CONTINUED_READ) {
+		/* the rest of a message we lost track of: what is left of it was just read (and dropped) */
+		seen.bad++;
+		return false;
+	}
+	payload = le16(first + 2);
+	if (*code == STATUS_IDLE || *code == STATUS_BUSY || *code == STATUS_INVALID || payload == 0) {
+		return true;
+	}
+	if (payload > TCM_MAX_PAYLOAD) {
+		say("message %#x of %u bytes: too long\n", *code, payload);
+		return false;
+	}
+	total = 4 + payload + 1;
+	if (total <= sizeof(first)) {
+		memcpy(message, first + 4, payload);
+	} else {
+		uint32_t have = sizeof(first) - 4, rest = total - sizeof(first);
+
+		memcpy(message, first + 4, have);
+		/* the rest, behind 0xa5 0x03, padding byte included */
+		if (!spi_transfer(NULL, message + have - 2, rest + 2)) {
+			return false;
+		}
+		if (message[have - 2] != TCM_MARKER || message[have - 1] != STATUS_CONTINUED_READ) {
+			seen.bad++;
+			if (seen.bad <= 4) {
+				dump("bad continued read", message + have - 2, 16);
+			}
+			return false;
+		}
+		/* the two header bytes sat where the payload goes on: put back what they overwrote */
+		memcpy(message + have - 2, first + 4 + have - 2, 2);
+	}
+	*length = payload;
+	return true;
+}
+
+static bool
+tcm_write(uint8_t command, const uint8_t *payload, uint32_t length)
+{
+	uint8_t out[64];
+
+	if (length + 3 > sizeof(out)) {
+		return false;
+	}
+	out[0] = command;
+	out[1] = (uint8_t)length;
+	out[2] = (uint8_t)(length >> 8);
+	if (length) {
+		memcpy(out + 3, payload, length);
+	}
+	return spi_transfer(out, NULL, length + 3);
+}
+
+/* Wait (up to ms) for the interrupt line and read what comes, until a message with code `want`. */
+static bool
+tcm_wait_for(uint8_t want, uint32_t *length, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint8_t code;
+
+		if (gpio_get(PIN_INT)) {
+			sleep_us(500);
+			continue;
+		}
+		if (!tcm_read(&code, length)) {
+			sleep_ms(1);
+			continue;
+		}
+		if (code == want) {
+			return true;
+		}
+		if (code != STATUS_IDLE && seen.other++ < 12) {
+			say("while waiting for %#x: message %#x (%u bytes)\n", want, code, *length);
+			if (*length) {
+				dump("  payload", message, *length);
+			}
+		}
+	}
+	return false;
+}
+
+static bool
+tcm_command(uint8_t command, const uint8_t *payload, uint32_t payload_length, uint32_t *length)
+{
+	if (!tcm_write(command, payload, payload_length)) {
+		return false;
+	}
+	if (!tcm_wait_for(STATUS_OK, length, 500)) {
+		say("command %#x: no answer\n", command);
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_reset(void)
+{
+	gpio_set(PIN_RESET, false);
+	sleep_ms(10);                   /* synaptics,reset-active-ms */
+	gpio_set(PIN_RESET, true);
+	sleep_ms(200);                  /* synaptics,reset-delay-ms */
+}
+
+static bool
+tcm_probe(void)
+{
+	uint32_t length = 0;
+	bool identified;
+
+	touch_reset();
+	identified = tcm_wait_for(REPORT_IDENTIFY, &length, 1000);
+	if (!identified) {
+		say("no identify report after reset (interrupt line %u); asking\n", gpio_get(PIN_INT));
+		if (!tcm_write(CMD_IDENTIFY, NULL, 0)) {
+			return false;
+		}
+		identified = tcm_wait_for(STATUS_OK, &length, 500);
+	}
+	if (!identified || length < 2) {
+		say("the chip does not identify itself\n");
+		return false;
+	}
+	dump("identify", message, length);
+	if (length >= 22) {
+		char part[17];
+
+		memcpy(part, message + 2, 16);
+		part[16] = 0;
+		say("identify: version %u, mode %#x, part \"%s\", build %u\n", message[0], message[1], part,
+		    message[18] | message[19] << 8 | message[20] << 16 | (uint32_t)message[21] << 24);
+	}
+	if (message[1] != MODE_APPLICATION) {
+		say("not in application mode (%#x): running the application firmware\n", message[1]);
+		if (!tcm_write(CMD_RUN_APPLICATION, NULL, 0) || !tcm_wait_for(REPORT_IDENTIFY, &length, 1000) ||
+		    length < 2 || message[1] != MODE_APPLICATION) {
+			say("still not in application mode\n");
+			return false;
+		}
+	}
+	{
+		/* the chip sends a 1708-byte frame of its own unasked, every frame: too much for pins driven by hand */
+		uint8_t report = REPORT_XIAOMI_FRAME;
+
+		if (!tcm_command(CMD_DISABLE_REPORT, &report, 1, &length)) {
+			say("report %#x could not be turned off\n", report);
+		}
+	}
+	if (tcm_command(CMD_GET_APPLICATION_INFO, NULL, 0, &length) && length >= 40) {
+		dump("application info", message, length);
+		max_x = le16(message + 32);
+		max_y = le16(message + 34);
+		max_objects = le16(message + 36);
+		say("application info: status %u, max x %u, max y %u, %u objects\n", le16(message + 2), max_x, max_y,
+		    max_objects);
+		if (max_objects == 0 || max_objects > MAX_OBJECTS) {
+			max_objects = MAX_OBJECTS;
+		}
+		if (max_x == 0 || max_y == 0) {
+			max_x = 1200;
+			max_y = 2670;
+		}
+	}
+	if (!tcm_command(CMD_GET_TOUCH_REPORT_CONFIG, NULL, 0, &length) || length == 0 || length > sizeof(touch_config)) {
+		say("no touch report configuration\n");
+		return false;
+	}
+	memcpy(touch_config, message, length);
+	touch_config_size = length;
+	dump("touch report configuration", touch_config, length);
+	{
+		uint8_t report = REPORT_TOUCH;
+
+		tcm_command(CMD_ENABLE_REPORT, &report, 1, &length);
+	}
+	/*
+	 * Out of any low-power state the boot left it in: out of deep sleep, the wake-up gesture mode
+	 * off (Xiaomi's firmware may sit in it, scanning but not reporting fingers, until the display
+	 * is said to be on), and what scan mode it says it is in: 0/1 normal idle/active, 2/3 the
+	 * low-power wake-up gesture mode, 4 asleep.
+	 */
+	{
+		uint8_t off_gesture[3] = { DC_ENABLE_WAKEUP_GESTURE_MODE, 0, 0 }, mode_id = DC_TOUCH_SCAN_MODE;
+
+		say("exit deep sleep: %s\n", tcm_command(CMD_EXIT_DEEP_SLEEP, NULL, 0, &length) ? "ok" : "no answer");
+		say("wake-up gesture mode off: %s\n",
+		    tcm_command(CMD_SET_DYNAMIC_CONFIG, off_gesture, sizeof(off_gesture), &length) ? "ok" : "no answer");
+		if (tcm_command(CMD_GET_DYNAMIC_CONFIG, &mode_id, 1, &length) && length >= 2) {
+			say("scan mode %u\n", le16(message));
+		} else {
+			say("scan mode: no answer\n");
+		}
+	}
+	return true;
+}
+
+/* ---- touch reports ---------------------------------------------------------------------------------- */
+
+enum {
+	TOUCH_END = 0, TOUCH_FOREACH_ACTIVE_OBJECT, TOUCH_FOREACH_OBJECT, TOUCH_FOREACH_END, TOUCH_PAD_TO_NEXT_BYTE,
+	TOUCH_TIMESTAMP, TOUCH_OBJECT_N_INDEX, TOUCH_OBJECT_N_CLASSIFICATION, TOUCH_OBJECT_N_X_POSITION,
+	TOUCH_OBJECT_N_Y_POSITION, TOUCH_NUM_OF_ACTIVE_OBJECTS = 24,
+};
+#define CLASS_LIFT              0
+#define CLASS_FINGER            1
+#define CLASS_GLOVED_FINGER     2
+
+static struct {
+	uint32_t status, x, y;
+} object[MAX_OBJECTS];
+static bool down[MAX_OBJECTS];
+static uint32_t last_x[MAX_OBJECTS], last_y[MAX_OBJECTS];  /* so an UP carries where the finger was, not 0,0 */
+
+static uint32_t
+bits_at(const uint8_t *report, uint32_t size, uint32_t offset, uint32_t bits)
+{
+	uint32_t value = 0;
+
+	if (bits == 0 || bits > 32 || offset + bits > size * 8) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < bits; i++) {
+		uint32_t at = offset + i;
+
+		value |= (uint32_t)(report[at / 8] >> (at % 8) & 1) << i;
+	}
+	return value;
+}
+
+static void
+touch_report(const uint8_t *report, uint32_t size)
+{
+	uint32_t idx = 0, offset = 0, obj = 0, next = 0, objects = 0, active = 0, end_of_foreach = 0;
+	bool active_only = false, have_active = false;
+
+	memset(object, 0, sizeof(object));
+	while (idx < touch_config_size) {
+		uint8_t code = touch_config[idx++];
+		uint32_t bits, value;
+
+		switch (code) {
+		case TOUCH_END:
+			goto done;
+		case TOUCH_FOREACH_ACTIVE_OBJECT:
+		case TOUCH_FOREACH_OBJECT:
+			obj = 0;
+			next = idx;
+			active_only = code == TOUCH_FOREACH_ACTIVE_OBJECT;
+			break;
+		case TOUCH_FOREACH_END:
+			end_of_foreach = idx;
+			if (active_only) {
+				if (have_active) {
+					objects++;
+					if (objects < active) {
+						idx = next;
+					}
+				} else if (offset < size * 8) {
+					idx = next;
+				}
+			} else {
+				obj++;
+				if (obj < max_objects) {
+					idx = next;
+				}
+			}
+			break;
+		case TOUCH_PAD_TO_NEXT_BYTE:
+			offset = (offset + 7) / 8 * 8;
+			break;
+		default:
+			if (idx >= touch_config_size) {
+				goto done;
+			}
+			bits = touch_config[idx++];
+			value = bits <= 32 ? bits_at(report, size, offset, bits) : 0;
+			offset += bits;
+			if (code == TOUCH_OBJECT_N_INDEX) {
+				obj = value;
+			} else if (obj < MAX_OBJECTS && code == TOUCH_OBJECT_N_CLASSIFICATION) {
+				object[obj].status = value;
+			} else if (obj < MAX_OBJECTS && code == TOUCH_OBJECT_N_X_POSITION) {
+				object[obj].x = value;
+			} else if (obj < MAX_OBJECTS && code == TOUCH_OBJECT_N_Y_POSITION) {
+				object[obj].y = value;
+			} else if (code == TOUCH_NUM_OF_ACTIVE_OBJECTS) {
+				active = value;
+				have_active = true;
+				if (active == 0 && end_of_foreach != 0) {
+					idx = end_of_foreach;
+				}
+			}
+			break;
+		}
+	}
+done:
+	for (uint32_t i = 0; i < max_objects && i < MAX_OBJECTS; i++) {
+		bool touching = object[i].status == CLASS_FINGER || object[i].status == CLASS_GLOVED_FINGER;
+		uint32_t x = (uint32_t)((uint64_t)object[i].x * 65535 / max_x);
+		uint32_t y = (uint32_t)((uint64_t)object[i].y * 65535 / max_y);
+
+		if (touching) {
+			if (seen.touches++ < 6) {
+				say("finger %u at %u, %u (raw %u, %u)\n", i, x, y, object[i].x, object[i].y);
+			}
+			seen.last_x = object[i].x;
+			seen.last_y = object[i].y;
+			redwood_touch_post(down[i] ? REDWOOD_TOUCH_MOVE : REDWOOD_TOUCH_DOWN, i, x, y);
+			last_x[i] = x;
+			last_y[i] = y;
+			down[i] = true;
+		} else if (down[i]) {
+			/* the finger has lifted where it last was -- not 0,0, which UIKit reads as a drag off the
+			 * control and cancels the tap (a Settings row highlights but does not open) */
+			redwood_touch_post(REDWOOD_TOUCH_UP, i, last_x[i], last_y[i]);
+			down[i] = false;
+		}
+	}
+}
+
+/*
+ * Xiaomi's 0xc0 frame (1708 bytes): what is in it is not known yet. The first one is written out
+ * whole; after it, for each frame, how many bytes differ from that first one and where the first
+ * differences are -- with a finger on the screen and without, that tells a capacitance image from
+ * a list of touches.
+ */
+static uint8_t frame0[2048];
+static uint32_t frame0_length;
+
+static void
+xiaomi_frame(const uint8_t *p, uint32_t length)
+{
+	static unsigned frames;
+	char line[200];
+	uint32_t differ = 0, n = 0;
+
+	frames++;
+	if (frame0_length == 0 && length <= sizeof(frame0)) {
+		memcpy(frame0, p, length);
+		frame0_length = length;
+		for (uint32_t at = 0; at < length; at += 48) {
+			uint32_t k = 0;
+
+			for (uint32_t i = at; i < length && i < at + 48; i++) {
+				k += snprintf(line + k, sizeof(line) - k, "%02x", p[i]);
+			}
+			say("frame0 %4u: %s\n", at, line);
+		}
+		return;
+	}
+	if (length != frame0_length || frames > 40) {
+		return;
+	}
+	for (uint32_t i = 12; i < length; i++) {        /* (the first 12: a counter and time stamps) */
+		differ += p[i] != frame0[i];
+	}
+	if (differ == 0 && frames % 20 != 0) {
+		return;
+	}
+	n = (uint32_t)snprintf(line, sizeof(line), "frame %u: %u bytes differ:", frames, differ);
+	for (uint32_t i = 12, shown = 0; i < length && shown < 14; i++) {
+		if (p[i] != frame0[i]) {
+			n += (uint32_t)snprintf(line + n, sizeof(line) - n, " %u=%02x", i, p[i]);
+			shown++;
+		}
+	}
+	say("%s\n", line);
+}
+
+/* one message; false when there was none (idle, or nothing readable) */
+static bool
+poll_once(void)
+{
+	uint8_t code;
+	uint32_t length;
+
+	seen.polls++;
+	if (!tcm_read(&code, &length)) {
+		return false;
+	}
+	if (code == STATUS_IDLE) {
+		return false;
+	}
+	seen.messages++;
+	if (code == REPORT_TOUCH) {
+		if (seen.touch_reports++ < 3) {
+			dump("touch report", message, length);
+		}
+		touch_report(message, length);
+	} else if (code == REPORT_XIAOMI_FRAME) {
+		static unsigned asked;
+
+		xiaomi_frame(message, length);
+		/*
+		 * In step with the chip again: what Android's driver does for enable_touch_raw=0 -- the
+		 * frames for Xiaomi's host-side touch processing off, the chip's own touch reports on.
+		 * (Seen to work there: 319 touch reports in 15 s, and the frames stop.)
+		 */
+		if (asked < 5) {
+			uint8_t frame = REPORT_XIAOMI_FRAME, touch = REPORT_TOUCH;
+
+			asked++;
+			tcm_write(CMD_DISABLE_REPORT, &frame, 1);
+			delay_for_interval(2, NSEC_PER_MSEC);
+			tcm_write(CMD_ENABLE_REPORT, &touch, 1);
+			say("frame %u read whole: asked for the chip's own touch reports instead (time %u)\n", seen.messages,
+			    asked);
+		}
+	} else if (code != STATUS_IDLE) {
+		if (seen.other++ < 8) {
+			say("message %#x (%u bytes)\n", code, length);
+			if (length) {
+				dump("  payload", message, length);
+			}
+		}
+		if (code == REPORT_IDENTIFY) {
+			/* the chip has reset itself: its reports are to be asked for again */
+			uint8_t report = REPORT_TOUCH;
+
+			tcm_write(CMD_ENABLE_REPORT, &report, 1);
+		}
+	}
+	return true;
+}
+
+/* ---- all of it together ---------------------------------------------------------------------------- */
+
+static void
+show_state(const char *when)
+{
+	say("%s: votes %#x, clocks %#x %#x %#x, s2 div %#x, ref cfg %#x dfs %#x; pins %#x %#x %#x %#x, reset %#x/%u, "
+	    "int %#x/%u\n", when, rd(GCC_VOTE), rd(GCC_QUP1_M_AHB_CBCR), rd(GCC_QUP1_S_AHB_CBCR), rd(GCC_QUP1_S2_CBCR),
+	    rd(GCC_QUP1_S2_DIV), rd(GCC_QSPI_REF_CFG), rd(GCC_QSPI_REF_DFSR), rd(GPIO_CFG(PIN_MISO)), rd(GPIO_CFG(PIN_MOSI)),
+	    rd(GPIO_CFG(PIN_CLK)), rd(GPIO_CFG(PIN_CS)), rd(GPIO_CFG(PIN_RESET)), rd(GPIO_IO(PIN_RESET)),
+	    rd(GPIO_CFG(PIN_INT)), rd(GPIO_IO(PIN_INT)));
+}
+
+static bool
+bring_up(void)
+{
+	const char *problem;
+	uint32_t spi_hz = 5000000;
+
+	show_state("as found");
+	gpio_output(PIN_RESET, false, PULL_NONE, 2);
+	gpio_configure(PIN_INT, 0, PULL_NONE, 2, false);
+	supplies_on();
+	sleep_ms(50);                   /* synaptics,power-delay-ms */
+
+	if (!clocks_on()) {
+		show_state("no clocks");
+		say("driving the pins by hand\n");
+		spi_transfer = bitbang_transfer;
+		bitbang_init();
+		return tcm_probe();
+	}
+	say("serial engine: firmware %#x, interface %#x, parameters %#x, source clock %u Hz (select %u)\n",
+	    rd(GENI_FW_REVISION_RO), rd(GENI_IF_DISABLE_RO), rd(SE_HW_PARAM_0), se_source_hz, se_clock_select);
+	/* boot-arg touch_spi_hz=N (the device tree allows the chip 15 MHz) */
+	PE_parse_boot_argn("touch_spi_hz", &spi_hz, sizeof(spi_hz));
+	if (spi_hz < 100000 || spi_hz > 15000000) {
+		spi_hz = 5000000;
+	}
+	problem = geni_spi_init(spi_hz);
+	if (problem == NULL) {
+		gpio_configure(PIN_MISO, PIN_FUNCTION_SPI, PULL_DOWN, 6, false);
+		gpio_configure(PIN_MOSI, PIN_FUNCTION_SPI, PULL_DOWN, 6, false);
+		gpio_configure(PIN_CLK, PIN_FUNCTION_SPI, PULL_DOWN, 6, false);
+		gpio_configure(PIN_CS, PIN_FUNCTION_SPI, PULL_DOWN, 6, false);
+		show_state("powered, on the serial engine");
+		say("the bus at %u Hz\n", spi_hz);
+		return tcm_probe();
+	}
+	/* boot-arg touch_half_ns=N: half a clock period of the hand-driven bus (default 200 ns) */
+	PE_parse_boot_argn("touch_half_ns", &bitbang_half_ns, sizeof(bitbang_half_ns));
+	say("%s: driving the pins by hand (half period %u ns)\n", problem, bitbang_half_ns);
+	spi_transfer = bitbang_transfer;
+	bitbang_init();
+	show_state("powered, pins by hand");
+	return tcm_probe();
+}
+
+/*
+ * Under Gunyah a register this VM may not touch is no fault of ours to catch: the whole phone
+ * stops. So the first time, every block is looked at alone, with a line before it and a pause
+ * after (the loader's log is fetched every few seconds), and boot-arg dadatouch_step=N stops
+ * before step N: the last line seen says which block it was.
+ */
+static bool
+careful_look(void)
+{
+	static const struct {
+		const char *what;
+		vm_offset_t *base;
+		uint32_t offset;
+	} steps[] = {
+		{ "TLMM gpio40 cfg", &tlmm, 0x1000 * PIN_MISO },
+		{ "TLMM gpio161 cfg", &tlmm, 0x1000 * PIN_RESET },
+		{ "TLMM gpio162 io", &tlmm, 0x1000 * PIN_INT + 4 },
+		{ "GCC vote 0x52008", &gcc, 0x52008 },
+		{ "GCC m_ahb 0x23140", &gcc, 0x23140 },
+		{ "GCC s2 cbcr 0x1827c", &gcc, 0x1827c },
+		{ "GCC s2 div 0x1828c", &gcc, 0x1828c },
+		{ "GCC qspi ref cmd 0x188c0", &gcc, 0x188c0 },
+		{ "GCC qspi ref dfsr 0x188d4", &gcc, 0x188d4 },
+		{ "RSC drv2 id", &rsc, 0 },
+		{ "RSC tcs0 status", &rsc, TCS_BASE + 0x28 },
+		{ "cmd-db magic", &cmd_db, 4 },
+		{ "SE fw revision", &se, 0x68 },
+		{ "SE hw param", &se, 0xe24 },
+	};
+	uint32_t stop = 99, pause_ms = 2500;
+
+	PE_parse_boot_argn("dadatouch_step", &stop, sizeof(stop));
+	PE_parse_boot_argn("dadatouch_pause", &pause_ms, sizeof(pause_ms));
+	for (uint32_t i = 0; i < sizeof(steps) / sizeof(steps[0]); i++) {
+		if (i >= stop) {
+			say("stopping before step %u (dadatouch_step)\n", i);
+			return false;
+		}
+		say("step %u: reading %s ...\n", i, steps[i].what);
+		sleep_ms(pause_ms);
+		say("step %u: %s = %#x\n", i, steps[i].what, rd(*steps[i].base + steps[i].offset));
+	}
+	return true;
+}
+
+static void
+dada_touch_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t poll_us = 4000;
+	unsigned idle = 0;
+
+	PE_parse_boot_argn("touch_poll_us", &poll_us, sizeof(poll_us));
+	if (poll_us < 250 || poll_us > 100000) {
+		poll_us = 4000;
+	}
+	{
+		uint32_t start_s = 15;
+
+		PE_parse_boot_argn("dadatouch_delay", &start_s, sizeof(start_s));
+		say("thread up; looking at the hardware in %u s\n", start_s);
+		sleep_ms(start_s * 1000);
+	}
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	se = ml_io_map(SE_PHYS, SE_SIZE);
+	rsc = ml_io_map(RSC_PHYS, RSC_SIZE);
+	cmd_db = ml_io_map_wcomb(CMD_DB_PHYS, CMD_DB_SIZE);
+
+	uint32_t careful = 0;
+
+	PE_parse_boot_argn("dadatouch_careful", &careful, sizeof(careful));
+	if (careful && !careful_look()) {
+		thread_terminate(current_thread());
+		return;
+	}
+	if (!bring_up()) {
+		say("no touch screen\n");
+		thread_terminate(current_thread());
+		return;
+	}
+	say("touch screen ready (%u x %u, %u objects); the interrupt line looked at every %u us\n", max_x, max_y,
+	    max_objects, poll_us);
+	uint64_t next_report;
+
+	clock_interval_to_deadline(30, NSEC_PER_SEC, &next_report);
+	for (unsigned tick = 1;; tick++) {
+		/*
+		 * Read until the chip says it has nothing more: it queues a report per frame (Xiaomi's 0xc0
+		 * frames among them, tens a second), and one read per look let the queue overflow and drop
+		 * the touch reports. (The interrupt line, gpio162, has not been seen low here: not relied on.)
+		 */
+		(void)idle;
+		for (int n = 0; n < 32 && poll_once(); n++) {
+		}
+		if (mach_absolute_time() >= next_report) {
+			clock_interval_to_deadline(30, NSEC_PER_SEC, &next_report);
+			say("so far %u messages in %u looks (%u touch reports, %u other, %u bad), %u finger positions, "
+			    "the last at %u, %u; interrupt line %s\n", seen.messages, seen.polls, seen.touch_reports, seen.other,
+			    seen.bad, seen.touches, seen.last_x, seen.last_y, gpio_get(PIN_INT) ? "high" : "low");
+		}
+		sleep_us(poll_us);
+	}
+}
+
+/*
+ * Boot-arg autoswipe=S: S seconds into the run, one swipe up from the bottom edge, as a finger the
+ * panel does not have (index 9) -- the lock screen opened without anybody at the phone, so that a
+ * run can be checked past it from its screenshot alone. autoswipe_again=T repeats it T seconds
+ * later (the first may land before SpringBoard takes gestures).
+ */
+static void
+dada_autoswipe_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t first = 0, again = 0;
+
+	PE_parse_boot_argn("autoswipe", &first, sizeof(first));
+	PE_parse_boot_argn("autoswipe_again", &again, sizeof(again));
+	delay_for_interval(first, NSEC_PER_SEC);
+	for (int round = 0; round < (again ? 2 : 1); round++) {
+		const uint32_t x = 32768, from = 64500, to = 26000, steps = 24;
+
+		say("autoswipe: a swipe up (%d)\n", round + 1);
+		redwood_touch_post(REDWOOD_TOUCH_DOWN, 9, x, from);
+		for (uint32_t i = 1; i <= steps; i++) {
+			delay_for_interval(12, NSEC_PER_MSEC);
+			redwood_touch_post(REDWOOD_TOUCH_MOVE, 9, x, from - (from - to) * i / steps);
+		}
+		delay_for_interval(12, NSEC_PER_MSEC);
+		redwood_touch_post(REDWOOD_TOUCH_UP, 9, x, to);
+		if (again) {
+			delay_for_interval(again, NSEC_PER_SEC);
+		}
+	}
+}
+
+void
+hakios_dada_touch_init(void)
+{
+	uint32_t enabled = 0, autoswipe = 0;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("autoswipe", &autoswipe, sizeof(autoswipe)) && autoswipe &&
+	    kernel_thread_start(dada_autoswipe_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+
+	if (!PE_parse_boot_argn("dadatouch", &enabled, sizeof(enabled)) || !enabled) {
+		return;
+	}
+	if (kernel_thread_start(dada_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
