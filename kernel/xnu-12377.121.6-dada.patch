-#else //  __has_feature(ptrauth_calls)
+#else //  __has_feature(ptrauth_calls) && !XNU_PTRAUTH_DATA_PTRS_PLAIN
+#include <ptrauth.h>
 #define OS_PTRAUTH_SIGNED_PTR(type)
 #define OS_PTRAUTH_SIGNED_PTR_AUTH_NULL(type)
-#define OS_PTRAUTH_DISCRIMINATOR(str) 0
+#define OS_PTRAUTH_DISCRIMINATOR(str) 0ULL     /* 64-bit: callers shift it by 48 (an int shifted by 48 is undefined) */
 #define __ptrauth_only __unused
-#endif // __has_feature(ptrauth_calls)
+#endif // __has_feature(ptrauth_calls) && !XNU_PTRAUTH_DATA_PTRS_PLAIN
 #endif // KERNEL
 
 #if KERNEL
-#if __has_feature(ptrauth_calls)
+#if __has_feature(ptrauth_calls) && !XNU_PTRAUTH_DATA_PTRS_PLAIN
