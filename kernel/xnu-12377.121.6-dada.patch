+}
+
+/* ---- TrustZone, and stopping the DSP --------------------------------------------------------------- */
+
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(service, command) ((uint64_t)(service) << 8 | (command))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+
+static LCK_MTX_DECLARE(dsp_lock, &adsp_lock_group);     /* the DSP being started or stopped */
+static bool rails_asked;                /* our request for its rails stands (until it asks for its own, or is shut down) */
+static bool dsp_started;
+static bool stopped_by_its_word;
+static uint32_t our_item;
+static bool smp2p_agreed, smp2p_restart_acks, smp2p_restart_acked;
+
+static uint64_t scm_x5;                 /* (a fifth argument, for the calls that pass more than four: assign_mem) */
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t arguments, uint64_t first, uint64_t second, uint64_t third, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	function |= SCM_64 | SCM_SIP;
+	printf("adsp: %u: about to ask TrustZone %s: smc %#llx, arguments %#llx, %#llx, %#llx\n", step, what, function, first,
+	    second, third);
+	snprintf(last_write, sizeof(last_write), "step %u asked TrustZone %#llx(%#llx, %#llx)", step, function, first, second);
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = third;
+		register uint64_t x5 __asm__("x5") = scm_x5;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			printf("adsp: %u: TrustZone returns %d (x0 %#llx), answer %#llx\n", step, (int32_t)x0, x0, x1);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	printf("adsp: %u: TrustZone keeps saying the call was interrupted\n", step);
+	return -1;
+}
+
+static uint32_t
+our_item_find(void)
+{
+	uint32_t size = 0, at = smem_item(ITEM_SMP2P_OURS, &size);
+
+	return at != 0 && size >= sizeof(struct smp2p) ? at : 0;
+}
+
+/* What Linux does when the DSP rings for SMP2P: agree on the features once, and answer a restart. */
+static void
+dsp_listen(const struct smp2p *theirs)
+{
+	struct smp2p ours;
+
+	if (our_item == 0 || !smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC) {
+		return;
+	}
+	if (!smp2p_agreed) {
+		uint32_t features = (ours.version >> 8) & (theirs->version >> 8);
+
+		if ((theirs->version & 0xff) != (ours.version & 0xff)) {
+			return;
+		}
+		if (features != ours.version >> 8) {
+			smem_poke(our_item + SMP2P_AT_VERSION, features << 8 | (ours.version & 0xff));
+		}
+		smp2p_restart_acks = features & SMP2P_RESTART_ACKS;
+		smp2p_agreed = true;
+		printf("adsp: %u: the DSP and we agree on SMP2P: version %u, features %#x\n", step, ours.version & 0xff, features);
+	}
+	if (smp2p_restart_acks && ((theirs->flags & SMP2P_RESTART_DONE) != 0) != smp2p_restart_acked) {
+		smp2p_restart_acked = !smp2p_restart_acked;
+		printf("adsp: %u: the DSP's flags say it has restarted (%#x): answered in our flags (bit 1 = %u), and its SMP2P doorbell\n",
+		    step, theirs->flags, smp2p_restart_acked);
+		smem_poke(our_item + SMP2P_AT_FLAGS, (ours.flags & ~SMP2P_RESTART_ACK) | (smp2p_restart_acked ? SMP2P_RESTART_ACK : 0));
+		settle();
+		wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	}
+}
+
+/* Linux's qcom_q6v5_request_stop(): our bit "stop", the DSP's "stop ack" waited for, our bit taken back. */
+static bool
+dsp_ask_to_stop(uint32_t bound_ms)
+{
+	struct smp2p ours, theirs;
+	uint32_t at = our_item_find(), state, value_at;
+	uint64_t asked, now;
+	int entry = -1;
+
+	if (at == 0 || !smem_peek(at, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || (ours.version & 0xff) != SMP2P_VERSION ||
+	    (entry = smp2p_entry(&ours, OUR_ENTRY_STOP)) < 0) {
+		printf("adsp: %u: the DSP is not asked to stop first: there is no SMP2P item of ours to ask it with\n", step);
+		return false;
+	}
+	if (!dsp_words(&theirs) || smp2p_entry(&theirs, "slave-kernel") < 0) {
+		printf("adsp: %u: the DSP is not asked to stop first: its item has no entry to answer in\n", step);
+		return false;
+	}
+	state = dsp_state(&theirs);
+	if (state & DSP_STOP_ACK) {
+		printf("adsp: %u: the DSP is not asked to stop: its entry says %#x, that it has stopped when asked before\n", step, state);
+		return true;
+	}
+	if (!(state & DSP_READY) || (state & DSP_FATAL)) {
+		printf("adsp: %u: the DSP is not asked to stop first: its entry says %#x, not \"up\"\n", step, state);
+		return false;
+	}
+	need(&ipcc);
+	value_at = at + SMP2P_AT_VALUE((uint32_t)entry);
+	printf("adsp: %u: about to ask the DSP to stop: bit 0 of our entry \"%s\" at %#lx, and its SMP2P doorbell\n", step,
+	    OUR_ENTRY_STOP, SMEM_PHYS + value_at);
+	snprintf(last_write, sizeof(last_write), "step %u asked the audio DSP to stop", step);
+	smem_poke(value_at, ours.entry[entry].value | DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	asked = now = now_us();
+	while (now - asked < bound_ms * 1000ull) {
+		if (dsp_words(&theirs) && (dsp_state(&theirs) & (DSP_STOP_ACK | DSP_FATAL))) {
+			break;
+		}
+		sleep_us(200);
+		now = now_us();
+	}
+	state = dsp_words(&theirs) ? dsp_state(&theirs) : 0;
+	printf("adsp: %u: %s after %llu.%03llu ms; its entry says %#x\n", step, state & DSP_STOP_ACK ?
+	    "THE AUDIO DSP ACKNOWLEDGES THE STOP" : "THE AUDIO DSP DOES NOT ACKNOWLEDGE THE STOP", (now - asked) / 1000,
+	    (now - asked) % 1000, state);
+	smem_poke(value_at, ours.entry[entry].value & ~DSP_STOP);
+	settle();
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	return (state & DSP_STOP_ACK) != 0;
+}
+
+static void link_stop(void);
+
+/* Asked to stop, then shut down by TrustZone, then the always-on processor told that the image is gone. */
+static bool
+dsp_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	printf("adsp: %u: %s: the audio DSP is asked to stop, then TrustZone to shut it down\n", step, why);
+	if (!leaving) {
+		link_stop();
+	}
+	stopped_by_its_word = dsp_ask_to_stop(leaving ? 2000 : 5000);
+	result = scm("to shut the audio DSP down", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT SHUT THE AUDIO DSP DOWN: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		return false;
+	}
+	printf("adsp: %u: THE AUDIO DSP IS SHUT DOWN\n", step);
+	if (dada) {
+		/* and its companion (what it answers is only noted: it may never have been started) */
+		result = scm("to shut the companion down", SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP_DTB, 0, 0, &answer);
+		printf("adsp: %u: the companion (image 0x24) shut down: %d, %#llx\n", step, result, answer);
+		dtb_started = false;
+	}
+	need(&ipcc);
+	wr(ipcc.base + IPCC_DISABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	doorbells();
+	dsp_started = false;
+	mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+	if (rails_asked) {
+		rails(0);
+		rails_asked = false;
+	}
+	return true;
+}
+
+/* ---- step 4: TrustZone takes the header ------------------------------------------------------------ */
+
+static bool
+step_header(void)
+{
+	struct smp2p words;
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	int32_t result;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	if (dsp_words(&words)) {
+		show_words("the DSP has left words in the shared memory", &words);
+		announce("ask TrustZone to shut down an audio DSP that a kernel before this one may have left running");
+		if (!dsp_shutdown("it may be running")) {
+			return false;
+		}
+		if (!stopped_by_its_word && !option("adsp_again")) {
+			printf("adsp: %u: THE AUDIO DSP IS NOT STARTED AGAIN: it was shut down without having acknowledged a stop, and "
+			    "with the Wi-Fi's DSP a start after that reset the phone (adsp_again=1 to try all the same)\n", step);
+			return false;
+		}
+	} else {
+		printf("adsp: %u: the DSP has left nothing in the shared memory: it has not run since the phone was started\n", step);
+	}
+
+	if (dada) {
+		announce("dada: the DSP's companion image (adsp_dtb, image 0x24) into its memory and its header to TrustZone");
+		if (!dtb_load()) {
+			return false;
+		}
+	}
+	announce("hand the image's header to TrustZone to check its signature (image 1), in a page of ours");
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("adsp: %u: no memory\n", step);
+		return false;
+	}
+	memcpy((void *)page, image.header, image.header_size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	result = scm("to take the audio DSP's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP, kvtophys(page), 0, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE HEADER: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("adsp: %u: TRUSTZONE ACCEPTS THE AUDIO DSP'S SIGNATURE FROM THIS KERNEL\n", step);
+
+	announce("tell TrustZone where the image will be");
+	result = scm("where the image will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP, ADSP_MEMORY, image.size, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE PLACE: the call returns %d, its answer is %#llx\n", step, result, answer);
+		return false;
+	}
+	printf("adsp: %u: TrustZone takes the place: %#x bytes at %#x\n", step, image.size, ADSP_MEMORY);
+	return true;
+}
+
+/* ---- step 5: the image, in the DSP's memory --------------------------------------------------------- */
+
+static bool image_written;
+
+static uint64_t
+segment_word(unsigned s, uint32_t at)
+{
+	uint64_t word = 0;
+
+	for (unsigned b = 0; b < 8 && at + b < image.segment[s].file_size; b++) {
+		word |= (uint64_t)image.segment[s].file[at + b] << (8 * b);
+	}
+	return word;
+}
+
+static bool
+step_image(void)
+{
+	volatile uint64_t *dsp_memory;
+	uint64_t written = 0, cleared = 0, wrong = 0;
+
+	if (image.segments == 0) {
+		return false;
+	}
+	announce("put the image's segments into the audio DSP's memory (0x86700000, 64 MB: memory of nobody's until TrustZone "
+	    "starts the DSP), with zeroes where a segment is longer than its file, and read them back");
+	dsp_memory = (volatile uint64_t *)ml_io_map_unmappable(ADSP_MEMORY, ADSP_MEMORY_SIZE, VM_WIMG_WCOMB);
+	snprintf(last_write, sizeof(last_write), "step %u wrote the image at %#x", step, ADSP_MEMORY);
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *to = dsp_memory + image.segment[s].at / 8;
+
+		/* (a segment's length need not be a multiple of eight -- dada's 51 is 0x14ce7 -- and the last word is
+		 * written whole, with zeroes past the end: the next segment begins on a page) */
+		if (image.segment[s].at & 7) {
+			printf("adsp: %u: a segment that does not begin and end at a multiple of eight bytes: not written\n", step);
+			ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+			return false;
+		}
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			to[i / 8] = segment_word(s, i);
+		}
+		written += image.segment[s].file_size;
+		cleared += image.segment[s].memory_size - image.segment[s].file_size;
+	}
+	settle();
+	for (unsigned s = 0; s < image.segments; s++) {
+		volatile uint64_t *from = dsp_memory + image.segment[s].at / 8;
+
+		for (uint32_t i = 0; i < image.segment[s].memory_size; i += 8) {
+			wrong += from[i / 8] != segment_word(s, i);
+		}
+	}
+	printf("adsp: %u: %u segments, %llu bytes written and %llu cleared; read back, %llu words of eight bytes differ\n", step,
+	    image.segments, written, cleared, wrong);
+	settle();
+	ml_io_unmap((vm_offset_t)dsp_memory, ADSP_MEMORY_SIZE);
+	image_written = wrong == 0;
+	image_forget();                         /* (it is in the DSP's memory now: what was read of the root, given back) */
+	return image_written;
+}
+
+/* ---- dada: the DSP's companion image (adsp_dtb.mdt, TrustZone's image 0x24) -------------------------- */
+
+
+/* A file of the companion, and whether it is ours to give back (read from the root) or the small image's. */
+static const uint8_t *
+dtb_file(const char *name, uint64_t *size, bool *ours)
+{
+	const uint8_t *data;
+
+	from_root = false;
+	data = image_file(name, size);
+	*ours = from_root;
+	from_root = false;
+	return data;
+}
+
+/*
+ * Into its own memory and announced to TrustZone, the way the DSP's image is (steps 4 and 5 for the one
+ * image), but in one go and with nothing kept: the companion is small (three files of 512 KB at most)
+ * and is authenticated in step 7, just before the DSP is.
+ */
+static bool
+dtb_load(void)
+{
+	const uint8_t *header;
+	uint64_t size = 0, answer = 0;
+	uint32_t count, highest = 0, lowest = ~0u, reloc = 0;
+	bool relocatable = false;
+	vm_offset_t page = 0;
+	volatile uint64_t *memory;
+	struct elf_segment segment;
+	bool ours = false;
+	int32_t result;
+
+	header = dtb_file("adsp_dtb.mdt", &size, &ours);
+	if (header == NULL) {
+		return false;
+	}
+	count = size >= 52 + 32 ? header[44] | header[45] << 8 : 0;
+	if (memcmp(header, "\177ELF\1", 5) != 0 || count == 0 || count > 8 || 52 + 32 * count > size || size > PAGE_SIZE) {
+		printf("adsp: %u: fw/adsp_dtb.mdt is not such a header\n", step);
+		goto fail;
+	}
+	/* (relocatable, as the DSP's image is: its lowest segment at the start of its memory) */
+	for (uint32_t i = 0; i < count; i++) {
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		if (segment.type == 1 && !MDT_HASH(segment.flags) && segment.memory_size != 0) {
+			relocatable |= (segment.flags & (1u << 27)) != 0;
+			lowest = MIN(lowest, segment.paddr);
+		}
+	}
+	reloc = relocatable && lowest != ~0u ? lowest - DADA_DTB_MEMORY : 0;
+	for (uint32_t i = 0; i < count; i++) {
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		segment.paddr -= reloc;
+		if (segment.type != 1 || MDT_HASH(segment.flags) || segment.memory_size == 0) {
+			continue;
+		}
+		if (segment.paddr < DADA_DTB_MEMORY ||
+		    (uint64_t)segment.paddr + segment.memory_size > (uint64_t)DADA_DTB_MEMORY + DADA_DTB_MEMORY_SIZE) {
+			printf("adsp: %u: the companion's segment %u (%#x, %#x bytes) is not within its memory\n", step, i,
+			    segment.paddr, segment.memory_size);
+			goto fail;
+		}
+		highest = MAX(highest, segment.paddr + segment.memory_size);
+	}
+	if (highest == 0) {
+		goto fail;
+	}
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		goto fail;
+	}
+	memcpy((void *)page, header, size);
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	result = scm("to take the companion's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP_DTB, kvtophys(page), 0,
+	    &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE COMPANION'S HEADER: %d, %#llx\n", step, result, answer);
+		goto fail;
+	}
+	result = scm("where the companion will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP_DTB, DADA_DTB_MEMORY,
+	    ((highest + 0xfff) & ~0xfffu) - DADA_DTB_MEMORY, &answer);
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT TAKE THE COMPANION'S PLACE: %d, %#llx\n", step, result, answer);
+		goto fail;
+	}
+	memory = (volatile uint64_t *)ml_io_map_unmappable(DADA_DTB_MEMORY, DADA_DTB_MEMORY_SIZE, VM_WIMG_WCOMB);
+	for (uint32_t i = 0; i < count; i++) {
+		const uint8_t *file = NULL;
+		uint64_t file_size = 0;
+		bool file_ours = false;
+		char name[24];
+
+		memcpy(&segment, header + 52 + 32 * i, sizeof(segment));
+		segment.paddr -= reloc;
+		if (segment.type != 1 || MDT_HASH(segment.flags) || segment.memory_size == 0) {
+			continue;
+		}
+		if (segment.file_size != 0) {
+			snprintf(name, sizeof(name), "adsp_dtb.b%02u", i);
+			file = dtb_file(name, &file_size, &file_ours);
+			if (file == NULL || file_size != segment.file_size) {
+				printf("adsp: %u: fw/%s is missing or not %u bytes\n", step, name, segment.file_size);
+				if (file != NULL && file_ours) {
+					{ void *gone = (void *)(uintptr_t)file; kfree_data(gone, file_size); }
+				}
+				ml_io_unmap((vm_offset_t)memory, DADA_DTB_MEMORY_SIZE);
+				goto fail;
+			}
+		}
+		for (uint32_t at = 0; at < segment.memory_size; at += 8) {
+			uint64_t word = 0;
+
+			for (unsigned b = 0; b < 8 && at + b < segment.file_size; b++) {
+				word |= (uint64_t)file[at + b] << (8 * b);
+			}
+			memory[(segment.paddr - DADA_DTB_MEMORY + at) / 8] = word;
+		}
+		if (file != NULL && file_ours) {
+			{ void *gone = (void *)(uintptr_t)file; kfree_data(gone, file_size); }
+		}
+	}
+	settle();
+	ml_io_unmap((vm_offset_t)memory, DADA_DTB_MEMORY_SIZE);
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	if (ours) {
+		{ void *gone = (void *)(uintptr_t)header; kfree_data(gone, size); }
+	}
+	printf("adsp: %u: the companion (adsp_dtb, image 0x24) is in its memory at %#x and TrustZone has its header\n", step,
+	    DADA_DTB_MEMORY);
+	return true;
+fail:
+	if (page != 0) {
+		kmem_free(kernel_map, page, PAGE_SIZE);
+	}
+	if (ours) {
+		{ void *gone = (void *)(uintptr_t)header; kfree_data(gone, size); }
+	}
+	return false;
+}
+
+/* ---- step 6: our SMP2P item ------------------------------------------------------------------------ */
+
+static struct block smem_lock = { "shared memory's lock", 0x01f43000, 0x1000 };
+#define LOCK_OWNER              0x000
+#define LOCK_US                 1u
+
+/*
+ * Our item made in the partition, as Linux's qcom_smem_alloc_private() makes one (redwood_wifi.c: our_item_make()):
+ * an SMP2P item (our_item_make_as()), or any other of so many bytes (the modem's GLINK items, at the end of the file).
+ */
+static bool
+our_item_alloc(uint32_t partition, uint32_t item, uint32_t bytes)
+{
+	struct smem_partition header;
+	struct smem_entry entry;
+	const uint32_t item_size = (bytes + 7) & ~7u, need_bytes = sizeof(entry) + item_size;
+	uint32_t owner = ~0u, at;
+	bool made = false;
+
+	lck_mtx_lock(&redwood_smem_alloc_lock);         /* (the Wi-Fi's start allocates under the same hardware lock) */
+	need(&smem_lock);
+	printf("adsp: %u: about to take the lock (%#x), write an entry for item %u with %u bytes behind it at the partition's mark, "
+	    "move the mark by %u, and release the lock\n", step, smem_lock.phys + LOCK_OWNER, item, item_size, need_bytes);
+	snprintf(last_write, sizeof(last_write), "step %u took the shared memory's lock", step);
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr(smem_lock.base + LOCK_OWNER, LOCK_US);
+		owner = rd(smem_lock.base + LOCK_OWNER);
+		if (owner == LOCK_US) {
+			break;
+		}
+		sleep_ms(1);
+	}
+	if (owner != LOCK_US) {
+		printf("adsp: %u: THE LOCK IS HELD BY PROCESSOR %u AND STAYS SO FOR A SECOND: nothing is written\n", step, owner);
+		lck_mtx_unlock(&redwood_smem_alloc_lock);
+		return false;
+	}
+	if (!smem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size) {
+		printf("adsp: %u: the partition's marks make no sense: nothing is written\n", step);
+		goto out;
+	}
+	for (at = sizeof(header); at < header.free_uncached;) {
+		if (!smem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != SMEM_CANARY || entry.item == item ||
+		    entry.size > header.size) {
+			break;
+		}
+		at += sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		printf("adsp: %u: the partition's entries do not end at its mark (+%#x, the mark is +%#x), or the item has appeared: "
+		    "nothing is written\n", step, at, header.free_uncached);
+		goto out;
+	}
+	if (at + need_bytes > header.free_cached) {
+		printf("adsp: %u: no room: %u bytes wanted, %u free: nothing is written\n", step, need_bytes, header.free_cached - at);
+		goto out;
+	}
+	smem_poke(partition + at, SMEM_CANARY | item << 16);
+	smem_poke(partition + at + 4, item_size);
+	smem_poke(partition + at + 8, item_size - bytes);
+	smem_poke(partition + at + 12, 0);
+	settle();
+	smem_poke(partition + __offsetof(struct smem_partition, free_uncached), at + need_bytes);
+	settle();
+	made = true;
+out:
+	wr(smem_lock.base + LOCK_OWNER, 0);
+	printf("adsp: %u: the lock is released (it reads %u)\n", step, rd(smem_lock.base + LOCK_OWNER));
+	lck_mtx_unlock(&redwood_smem_alloc_lock);
+	return made;
+}
+
+static bool
+our_item_make_as(uint32_t partition, uint32_t item)
+{
+	return our_item_alloc(partition, item, (uint32_t)sizeof(struct smp2p));
+}
+
+static bool
+our_item_make(uint32_t partition)
+{
+	return our_item_make_as(partition, ITEM_SMP2P_OURS);
+}
+
+static void glink_reset(void);
+
+static bool
+step_our_item(void)
+{
+	struct smem_partition header;
+	struct smp2p ours;
+	uint32_t cacheline = 0, size = 0, partition, name[4] = { 0 };
+
+	announce("look for an SMP2P item of ours (429) in our partition with the audio DSP, make it if there is none, and fill it in");
+	partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+	if (partition == 0 || !smem_peek(partition, &header, sizeof(header))) {
+		printf("adsp: %u: there is no such partition\n", step);
+		return false;
+	}
+	our_item = our_item_find();
+	if (our_item != 0) {
+		printf("adsp: %u: item %u is there, at %#lx: a kernel before this one made it, and it is used again\n", step,
+		    ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	} else {
+		if (!our_item_make(partition)) {
+			return false;
+		}
+		our_item = our_item_find();
+		if (our_item == 0) {
+			printf("adsp: %u: THE ITEM IS NOT FOUND where it was just made\n", step);
+			return false;
+		}
+		printf("adsp: %u: item %u made, at %#lx\n", step, ITEM_SMP2P_OURS, SMEM_PHYS + our_item);
+	}
+	/* zeroes; from processor 0 to 2, room for 16 entries, "master-kernel" at zero, feature bit 0; last the version */
+	snprintf(last_write, sizeof(last_write), "step %u filled in our SMP2P item", step);
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		smem_poke(our_item + at, 0);
+	}
+	settle();
+	smem_poke(our_item, SMP2P_MAGIC);
+	smem_poke(our_item + SMP2P_AT_PROCESSORS, SMEM_US | SMEM_ADSP << 16);
+	strlcpy((char *)name, OUR_ENTRY_STOP, sizeof(name));
+	for (uint32_t word = 0; word < 4; word++) {
+		smem_poke(our_item + SMP2P_AT_NAME(0) + 4 * word, name[word]);
+	}
+	smem_poke(our_item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(our_item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);
+	settle();
+	smp2p_agreed = smp2p_restart_acks = smp2p_restart_acked = false;
+	need(&ipcc);
+	wr(ipcc.base + IPCC_SEND, IPCC_LPASS << 16 | IPCC_SMP2P);
+	if (!smem_peek(our_item, &ours, sizeof(ours)) || ours.magic != SMP2P_MAGIC || smp2p_entry(&ours, OUR_ENTRY_STOP) < 0) {
+		printf("adsp: %u: OUR ITEM DOES NOT READ BACK AS WRITTEN\n", step);
+		return false;
+	}
+	show_words("our item reads back", &ours);
+	glink_reset();
+	return true;
+}
+
+/* ---- step 7: the DSP, started ---------------------------------------------------------------------- */
+
+/*
+ * Android's kernel (this phone, dmesg): the image loaded at 8.92 s, "brought out of reset" at
+ * 9.10, "error ready" 40 ms later; the audio services' protection domain up at 9.39.
+ * Here (runs 085341 and later): the DSP's SMP2P item appears 17 ms after TrustZone returns, with
+ * a ring of its SMP2P and GLINK doorbells; at 41 ms "slave-kernel" says 6, up and asking for its
+ * own power, and our request for the rails is given back; at 2.2 s it adds "sleepstate_see".
+ * Asked to stop, it acknowledges within 25 ms (0x10e), and it starts again in the same session.
+ */
+static bool
+step_start(void)
+{
+	struct smp2p words, last;
+	uint64_t answer = ~0ull, started, now, ready_at = 0, limit;
+	uint32_t state = 0, rang, changes = 0, wait_seconds = 10;
+	int32_t result;
+	bool have, spoke = false, handed_over = false;
+
+	if (!image_written) {
+		printf("adsp: %u: the image is not in place\n", step);
+		return false;
+	}
+	PE_parse_boot_argn("adsp_wait", &wait_seconds, sizeof(wait_seconds));
+	bzero(&last, sizeof(last));
+	have = dsp_words(&last);
+	announce("listen for the audio DSP's doorbells, ask RPMh for its rails, tell the always-on processor that its image is "
+	    "loaded, and ask TrustZone to authenticate the image and let the DSP out of reset");
+	need(&ipcc);
+	for (unsigned i = 0; i < 8 && (rang = rd(ipcc.base + IPCC_RECEIVED)) != IPCC_NOBODY && rang >> 16 == IPCC_LPASS; i++) {
+		put(&ipcc, "heard", IPCC_CLEAR, rang);
+	}
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_SMP2P);
+	put(&ipcc, "listened for", IPCC_ENABLE, IPCC_LPASS << 16 | IPCC_GLINK);
+	bzero(&doorbell, sizeof(doorbell));
+	lck_mtx_lock(&dsp_lock);
+	if (!rails(384)) {
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	rails_asked = true;
+	if (!mailbox_send("{class: image, res: load_state, name: adsp, val: on}")) {
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	if (dada) {
+		result = scm("to authenticate the companion and start it", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP_DTB, 0,
+		    0, &answer);
+		printf("adsp: %u: the companion (image 0x24): %d, %#llx\n", step, result, answer);
+		dtb_started = result == 0 && answer == 0;
+	}
+	result = scm("to authenticate the audio DSP's image and start it", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP, 0, 0,
+	    &answer);
+	doorbell.since = started = now_us();
+	image_written = false;
+	if (result != 0 || answer != 0) {
+		printf("adsp: %u: TRUSTZONE DOES NOT START THE AUDIO DSP: the call returns %d, its answer is %#llx\n", step, result,
+		    answer);
+		mailbox_send("{class: image, res: load_state, name: adsp, val: off}");
+		rails(0);
+		rails_asked = false;
+		lck_mtx_unlock(&dsp_lock);
+		return false;
+	}
+	dsp_started = true;
+	lck_mtx_unlock(&dsp_lock);
+	printf("adsp: %u: TRUSTZONE HAS AUTHENTICATED THE IMAGE AND LET THE AUDIO DSP OUT OF RESET; watching for %u s\n", step,
+	    wait_seconds);
+	limit = started + wait_seconds * 1000000ull;
+	for (;;) {
+		now = now_us();
+		if (now >= limit || !dsp_started) {
+			break;
+		}
+		doorbells();
+		spoke = spoke || doorbell.glink + doorbell.smp2p != 0;
+		if (dsp_words(&words) && (!have || memcmp(&words, &last, sizeof(words)) != 0)) {
+			char when[64];
+
+			snprintf(when, sizeof(when), "+%llu.%03llu ms: the DSP's item %s", (now - started) / 1000, (now - started) % 1000,
+			    have ? "changes" : "APPEARS");
+			if (changes++ < 40) {
+				show_words(when, &words);
+			}
+			last = words;
+			have = spoke = true;
+			dsp_listen(&words);
+			state = dsp_state(&words);
+			if ((state & DSP_READY) && ready_at == 0) {
+				ready_at = now;
+				limit = now + 3000000ull;
+				printf("adsp: %u: THE AUDIO DSP SAYS IT IS UP: \"slave-kernel\" says %#x, %llu.%03llu ms after TrustZone started "
+				    "it\n", step, state, (now - started) / 1000, (now - started) % 1000);
+			}
+			if ((state & DSP_HANDOVER) && !handed_over) {
+				handed_over = true;
+				printf("adsp: %u: the DSP says it has asked for its own power (bit 2), %llu.%03llu ms after the start: ours is "
+				    "given back\n", step, (now - started) / 1000, (now - started) % 1000);
+				lck_mtx_lock(&dsp_lock);
+				if (rails_asked) {
+					rails(0);
+					rails_asked = false;
+				}
+				lck_mtx_unlock(&dsp_lock);
+			}
+			if (state & DSP_FATAL) {
+				printf("adsp: %u: THE AUDIO DSP SAYS IT HAS GIVEN UP\n", step);
+				show_crash_reason();
+				break;
+			}
+		}
+		sleep_us(200);
+	}
+	printf("adsp: %u: the watch is over after %llu ms; its doorbells heard: GLINK %u, SMP2P %u\n", step,
+	    (now_us() - started) / 1000, doorbell.glink, doorbell.smp2p);
+	show_partition();
+	if (our_item != 0 && smem_peek(our_item, &words, sizeof(words))) {
+		show_words("our item (429) now", &words);
+	}
+	{
+		/* (what is at the bottom of our partition, entry by entry, as it is now) */
+		uint32_t cacheline = 0, size = 0, partition = smem_partition(SMEM_US, SMEM_ADSP, &cacheline, &size);
+		struct smem_partition header;
+		struct smem_entry entry;
+
+		if (partition != 0 && smem_peek(partition, &header, sizeof(header))) {
+			printf("adsp: %u: the partition's header: hosts %u and %u, size %#x, free from the bottom at +%#x, from the top at "
+			    "+%#x; the table's line size %u\n", step, header.host0, header.host1, header.size, header.free_uncached,
+			    header.free_cached, cacheline);
+			for (uint32_t at = sizeof(header), n = 0; at + sizeof(entry) <= header.size && n < 8; n++) {
+				smem_peek(partition + at, &entry, sizeof(entry));
+				printf("adsp: %u:   +%#x: canary %#x item %u size %u padding %u/%u\n", step, at, entry.canary, entry.item,
+				    entry.size, entry.padding_data, entry.padding_header);
+				if (entry.canary != SMEM_CANARY) {
+					break;
+				}
+				at += sizeof(entry) + entry.padding_header + entry.size;
+			}
+		}
+	}
+	if (state & DSP_FATAL) {
+		return false;
+	}
+	if (ready_at == 0) {
+		printf("adsp: %u: %s\n", step, spoke ? "THE AUDIO DSP RUNS BUT HAS NOT SAID \"UP\"" : "NOT A WORD FROM THE AUDIO DSP");
+		show_crash_reason();
+	}
+	return ready_at != 0;
+}
+
+/* ---- GLINK (redwood_wifi.c; items 478 to 480 of our partition with the audio DSP) ------------------- */
+
+#define ITEM_GLINK_DESCRIPTOR   478
+#define ITEM_GLINK_OUR_QUEUE    479
+#define ITEM_GLINK_THEIR_QUEUE  480
+#define GLINK_OUR_TAIL          0
+#define GLINK_OUR_HEAD          4
+#define GLINK_THEIR_TAIL        8
+#define GLINK_THEIR_HEAD        12
+#define GLINK_RESERVE           16
+
+enum {
+	GLINK_VERSION = 0, GLINK_VERSION_ACK = 1, GLINK_OPEN = 2, GLINK_CLOSE = 3, GLINK_OPEN_ACK = 4, GLINK_INTENT = 5,
+	GLINK_DONE = 6, GLINK_INTENT_REQUEST = 7, GLINK_INTENT_REQUEST_ACK = 8, GLINK_DATA = 9, GLINK_CLOSE_ACK = 11,
+	GLINK_DATA_MORE = 12, GLINK_READ_NOTIFY = 13, GLINK_DONE_REUSE = 14, GLINK_SIGNALS = 15,
+};
+#define GLINK_VERSION_1         1
+#define GLINK_INTENT_REUSE      1u
+
+struct glink_message {
+	uint16_t command, param1;
+	uint32_t param2;
+};
+struct glink_packet {
+	struct glink_packet *next;
+	uint32_t length;
+	uint8_t data[];
+};
+
+/*
+ * The channels we answer when the DSP opens them, each with our number for it and the intents
+ * we give it when it is open both ways (how many buffers of which size the DSP may send into):
+ * IPCRTR, which carries QRTR (dt: qcom,intents of qcom,adsp_qrtr), and apr_audio_svc, which
+ * carries APR, the audio services' own protocol (below; Android's apr_tal_rpmsg.c asks for no
+ * particular intents: what the DSP sends there is a few hundred bytes, up to a few kilobytes).
+ */
+enum { CHANNEL_QRTR, CHANNEL_APR, CHANNEL_PMIC, CHANNELS };
+
+struct glink_channel {
+	const char *name;
+	uint32_t ours;                          /* our number for it */
+	struct {
+		uint32_t size, count;
+	} intents[3];
+	uint32_t theirs;                        /* the DSP's number for it; 0: it has not opened it */
+	bool asked, acknowledged, open;         /* our open sent; acknowledged; both ways done and our intents told */
+	bool request_answered, request_granted; /* our last request for an intent */
+	struct {
+		uint32_t id, size;
+		bool there, in_use;
+	} their_intents[64];                    /* what we may send into */
+	struct {
+		uint32_t size, fill;
+		uint8_t *data;
+	} our_intents[24];                      /* what the DSP may send into; an intent's number is its place here + 1 */
+	uint32_t our_intent_count;
+	struct glink_packet *first, *last;      /* received, in order */
+};
+
+/*
+ * An edge: GLINK with one processor, over its own three items in the partition of the two of us
+ * and its own IPCC doorbell. The audio DSP's (glink) is the first; the modem's (glink_mpss, with
+ * dadampss=1, at the end of the file) the second. The functions below take the edge they speak on,
+ * and each edge has its lock, held by whoever pumps or sends on it.
+ */
+static LCK_MTX_DECLARE(glink_lock, &adsp_lock_group);
+struct glink_edge {
+	const char *who, *peer;                 /* for the log: "adsp" and "DSP", "mpss" and "modem" */
+	lck_mtx_t *lock;
+	uint16_t host;                          /* the other processor's number in shared memory (2, 1) */
+	uint32_t ipcc_client;                   /* its doorbell's client (3, 2), signal IPCC_GLINK */
+	uint32_t descriptor, ours, ours_size, theirs, theirs_size;
+	bool up, broken;
+	uint32_t features;
+	bool agreed;
+	struct glink_channel channel[CHANNELS];
+	uint32_t said, heard, trace;
+	char others[4][33];                     /* the channels the DSP opens that nobody here speaks (for the log) */
+};
+static struct glink_edge glink = {
+	.who = "adsp", .peer = "DSP", .lock = &glink_lock, .host = SMEM_ADSP, .ipcc_client = IPCC_LPASS,
+	.channel = {
+		[CHANNEL_QRTR] = { .name = "IPCRTR", .ours = 1, .intents = { { 0x800, 5 }, { 0x2000, 3 }, { 0x4400, 2 } } },
+		[CHANNEL_APR] = { .name = "apr_audio_svc", .ours = 2, .intents = { { 0x200, 8 }, { 0x1000, 4 }, { 0x2000, 2 } } },
+		/* the battery manager's (battmgr below): answers of a few dozen bytes, a name of 128 */
+		[CHANNEL_PMIC] = { .name = "PMIC_RTR_ADSP_APPS", .ours = 3, .intents = { { 0x200, 6 }, { 0x1000, 2 }, { 0, 0 } } },
+	},
+};
+
+static struct glink_channel *
+glink_theirs(struct glink_edge *g, uint32_t theirs)
+{
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		if (g->channel[c].theirs != 0 && g->channel[c].theirs == theirs) {
+			return &g->channel[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+glink_find(void)
+{
+	uint32_t size = 0;
+
+	glink.descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+	if (glink.descriptor == 0 || size != 32) {
+		return false;
+	}
+	glink.ours = smem_item(ITEM_GLINK_OUR_QUEUE, &glink.ours_size);
+	glink.theirs = smem_item(ITEM_GLINK_THEIR_QUEUE, &glink.theirs_size);
+	return glink.ours != 0 && glink.theirs != 0 && glink.ours_size >= 1024 && glink.theirs_size >= 1024 &&
+	       !(glink.ours_size & 7) && !(glink.theirs_size & 7);
+}
+
+static void
+glink_reset(void)
+{
+	uint32_t size = 0, descriptor = smem_item(ITEM_GLINK_DESCRIPTOR, &size);
+
+	if (descriptor == 0 || size != 32) {
+		printf("adsp: %u: GLINK's descriptor (item %u) is not there: nothing to reset\n", step, ITEM_GLINK_DESCRIPTOR);
+		return;
+	}
+	printf("adsp: %u: GLINK's descriptor at %#lx: our queue read to %#x and written to %#x, the DSP's read to %#x and written "
+	    "to %#x\n", step, SMEM_PHYS + descriptor, smem_word(descriptor + GLINK_OUR_TAIL), smem_word(descriptor + GLINK_OUR_HEAD),
+	    smem_word(descriptor + GLINK_THEIR_TAIL), smem_word(descriptor + GLINK_THEIR_HEAD));
+	if (smem_word(descriptor + GLINK_OUR_HEAD) != 0 || smem_word(descriptor + GLINK_THEIR_TAIL) != 0) {
+		printf("adsp: %u: about to write our two marks there (+4, +8): 0\n", step);
+		smem_poke(descriptor + GLINK_OUR_HEAD, 0);
+		smem_poke(descriptor + GLINK_THEIR_TAIL, 0);
+		settle();
+	}
+}
+
+static uint32_t
+glink_waiting(struct glink_edge *g)
+{
+	uint32_t head = smem_word(g->descriptor + GLINK_THEIR_HEAD), tail = smem_word(g->descriptor + GLINK_THEIR_TAIL);
+
+	if (head >= g->theirs_size || tail >= g->theirs_size) {
+		return 0;
+	}
+	return head >= tail ? head - tail : g->theirs_size - tail + head;
+}
+
+static void
+glink_peek(struct glink_edge *g, void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (smem_word(g->descriptor + GLINK_THEIR_TAIL) + offset) % g->theirs_size;
+
+	for (uint32_t i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = smem[g->theirs + (at + i) % g->theirs_size];
+	}
+}
+
+static void
+glink_advance(struct glink_edge *g, uint32_t count)
+{
+	smem_poke(g->descriptor + GLINK_THEIR_TAIL, (smem_word(g->descriptor + GLINK_THEIR_TAIL) + count) % g->theirs_size);
+}
+
+static uint32_t
+glink_room(struct glink_edge *g)
+{
+	uint32_t head = smem_word(g->descriptor + GLINK_OUR_HEAD), tail = smem_word(g->descriptor + GLINK_OUR_TAIL), room;
+
+	if (head >= g->ours_size || tail >= g->ours_size) {
+		return 0;
+	}
+	room = tail <= head ? g->ours_size - head + tail : tail - head;
+	return room < GLINK_RESERVE ? 0 : room - GLINK_RESERVE;
+}
+
+static bool
+glink_put(struct glink_edge *g, const void *first, uint32_t first_length, const void *second, uint32_t second_length)
+{
+	volatile uint8_t *queue = (volatile uint8_t *)(uintptr_t)smem + g->ours;
+	uint32_t head = smem_word(g->descriptor + GLINK_OUR_HEAD), length = first_length + second_length;
+	uint32_t padded = (length + 7) & ~7u;
+
+	if (!g->up || glink_room(g) < padded) {
+		return false;
+	}
+	for (uint32_t i = 0; i < padded; i++) {
+		queue[(head + i) % g->ours_size] = i < first_length ? ((const uint8_t *)first)[i] :
+		    i < length ? ((const uint8_t *)second)[i - first_length] : 0;
+	}
+	settle();
+	smem_poke(g->descriptor + GLINK_OUR_HEAD, (head + padded) % g->ours_size);
+	settle();
+	wr(ipcc.base + IPCC_SEND, g->ipcc_client << 16 | IPCC_GLINK);
+	g->said++;
+	return true;
+}
+
+static const char *
+glink_name(unsigned command)
+{
+	static const char *const names[] = {
+		"version", "version-ack", "open", "close", "open-ack", "intent", "done", "intent-request", "intent-request-ack",
+		"data", "10", "close-ack", "data-more", "read-notify", "done-reuse", "signals"
+	};
+
+	return command < sizeof(names) / sizeof(names[0]) ? names[command] : "?";
+}
+
+static void
+glink_say(struct glink_edge *g, unsigned command, uint32_t param1, uint32_t param2, const void *more, uint32_t more_length)
+{
+	struct glink_message message = { .command = (uint16_t)command, .param1 = (uint16_t)param1, .param2 = param2 };
+	bool sent = glink_put(g, &message, sizeof(message), more, more_length);
+
+	if (g->trace > 0 || !sent) {
+		g->trace -= g->trace > 0;
+		printf("%s: glink: > %s %u %#x%s\n", g->who, glink_name(command), param1, param2, sent ? "" : ": NO ROOM IN OUR QUEUE, not sent");
+	}
+}
+
+static bool
+glink_offer(struct glink_edge *g, struct glink_channel *channel, uint32_t size)
+{
+	uint32_t words[2] = { size, channel->our_intent_count + 1 }, i = channel->our_intent_count;
+
+	if (i >= sizeof(channel->our_intents) / sizeof(channel->our_intents[0]) || size == 0 || size > 0x10000) {
+		return false;
+	}
+	if (channel->our_intents[i].data == NULL || channel->our_intents[i].size != size) {
+		channel->our_intents[i].data = kalloc_data(size, Z_WAITOK | Z_ZERO);
+	}
+	if (channel->our_intents[i].data == NULL) {
+		return false;
+	}
+	channel->our_intents[i].size = size;
+	channel->our_intents[i].fill = 0;
+	channel->our_intent_count++;
+	glink_say(g, GLINK_INTENT, channel->ours, 1, words, sizeof(words));
+	return true;
+}
+
+/* Everything the DSP has put into its queue, taken out and acted on (Linux's qcom_glink_native_rx()). With glink_lock held. */
+static void
+glink_pump(struct glink_edge *g)
+{
+	struct glink_message message;
+	struct glink_channel *channel;
+	uint32_t words[4];
+	char name[33];
+
+	while (g->up && !g->broken) {
+		uint32_t waiting = glink_waiting(g), length = sizeof(message);
+
+		if (waiting < sizeof(message)) {
+			return;
+		}
+		glink_peek(g, &message, 0, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			length += message.param2;
+		} else if (message.command == GLINK_INTENT) {
+			length += 8 * message.param2;
+		} else if (message.command == GLINK_DATA || message.command == GLINK_DATA_MORE) {
+			if (waiting < 16) {
+				return;
+			}
+			glink_peek(g, words, 8, 8);
+			length = 16 + words[0];
+		}
+		length = (length + 7) & ~7u;
+		if (length > g->theirs_size - 8) {
+			printf("%s: glink: A MESSAGE OF %u BYTES (%s %u %#x): not believed, and nothing more is read\n", g->who, length,
+			    glink_name(message.command), message.param1, message.param2);
+			g->broken = true;
+			return;
+		}
+		if (waiting < length) {
+			return;
+		}
+		g->heard++;
+		if (g->trace > 0 && message.command != GLINK_DATA && message.command != GLINK_DATA_MORE &&
+		    message.command != GLINK_INTENT && message.command != GLINK_DONE_REUSE) {
+			g->trace--;
+			printf("%s: glink: < %s %u %#x\n", g->who, glink_name(message.command), message.param1, message.param2);
+		}
+		switch (message.command) {
+		case GLINK_VERSION:
+			if (message.param1 == GLINK_VERSION_1) {
+				g->features &= message.param2;
+			}
+			glink_advance(g, length);
+			glink_say(g, GLINK_VERSION_ACK, GLINK_VERSION_1, g->features, NULL, 0);
+			break;
+		case GLINK_VERSION_ACK:
+			glink_advance(g, length);
+			if (message.param1 == GLINK_VERSION_1 && message.param2 == g->features) {
+				g->agreed = true;
+			} else if (message.param1 != 0) {
+				g->features &= message.param2;
+				glink_say(g, GLINK_VERSION, GLINK_VERSION_1, g->features, NULL, 0);
+			}
+			break;
+		case GLINK_OPEN:
+			bzero(name, sizeof(name));
+			glink_peek(g, name, sizeof(message), message.param2 < sizeof(name) - 1 ? message.param2 : sizeof(name) - 1);
+			glink_advance(g, length);
+			channel = NULL;
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (g->channel[c].name != NULL && strcmp(name, g->channel[c].name) == 0) {
+					channel = &g->channel[c];
+				}
+			}
+			if (channel == NULL) {
+				printf("%s: glink: the %s opens \"%s\" as its channel %u: left unanswered, nobody here speaks it\n", g->who,
+				    g->peer, name, message.param1);
+				for (unsigned i = 0; i < 4; i++) {
+					if (g->others[i][0] == 0) {
+						strlcpy(g->others[i], name, sizeof(g->others[i]));
+						break;
+					}
+				}
+				break;
+			}
+			printf("%s: glink: the %s opens \"%s\" as its channel %u: acknowledged, and opened from our side as channel %u\n",
+			    g->who, g->peer, name, message.param1, channel->ours);
+			channel->theirs = message.param1;
+			glink_say(g, GLINK_OPEN_ACK, channel->theirs, 0, NULL, 0);
+			if (!channel->asked) {
+				uint32_t size = (uint32_t)strlen(channel->name) + 1;
+
+				bzero(name, sizeof(name));
+				strlcpy(name, channel->name, sizeof(name));
+				glink_say(g, GLINK_OPEN, channel->ours, size, name, (size + 7) & ~7u);
+				channel->asked = true;
+			}
+			break;
+		case GLINK_OPEN_ACK:
+			glink_advance(g, length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (g->channel[c].ours != 0 && message.param1 == g->channel[c].ours) {
+					g->channel[c].acknowledged = true;
+				}
+			}
+			break;
+		case GLINK_INTENT:
+			channel = glink_theirs(g, message.param1);
+			for (uint32_t i = 0; channel != NULL && i < message.param2; i++) {
+				glink_peek(g, words, 8 + 8 * i, 8);
+				for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+					if (!channel->their_intents[n].there || channel->their_intents[n].id == words[1]) {
+						channel->their_intents[n].there = true;
+						channel->their_intents[n].in_use = false;
+						channel->their_intents[n].size = words[0];
+						channel->their_intents[n].id = words[1];
+						break;
+					}
+				}
+			}
+			glink_advance(g, length);
+			break;
+		case GLINK_DONE:
+		case GLINK_DONE_REUSE:
+			channel = glink_theirs(g, message.param1);
+			for (unsigned n = 0; channel != NULL && n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+				if (channel->their_intents[n].there && channel->their_intents[n].id == message.param2) {
+					channel->their_intents[n].in_use = false;
+					channel->their_intents[n].there = message.command == GLINK_DONE_REUSE;
+				}
+			}
+			glink_advance(g, length);
+			break;
+		case GLINK_INTENT_REQUEST:
+			glink_advance(g, length);
+			if ((channel = glink_theirs(g, message.param1)) != NULL) {
+				bool granted = glink_offer(g, channel, message.param2);
+
+				glink_say(g, GLINK_INTENT_REQUEST_ACK, channel->ours, granted, NULL, 0);
+			}
+			break;
+		case GLINK_INTENT_REQUEST_ACK:
+			glink_advance(g, length);
+			for (unsigned c = 0; c < CHANNELS; c++) {
+				if (message.param1 == g->channel[c].theirs || message.param1 == g->channel[c].ours) {
+					g->channel[c].request_answered = true;
+					g->channel[c].request_granted = message.param2 != 0;
+				}
+			}
+			break;
+		case GLINK_DATA:
+		case GLINK_DATA_MORE: {
+			uint32_t intent = message.param2 - 1;
+
+			channel = glink_theirs(g, message.param1);
+			if (channel == NULL || intent >= channel->our_intent_count ||
+			    words[0] > channel->our_intents[intent].size - channel->our_intents[intent].fill) {
+				printf("%s: glink: < data of %u bytes on channel %u for intent %u: NOT OURS OR TOO MUCH, dropped\n", g->who, words[0],
+				    message.param1, message.param2);
+				glink_advance(g, length);
+				break;
+			}
+			glink_peek(g, channel->our_intents[intent].data + channel->our_intents[intent].fill, 16, words[0]);
+			channel->our_intents[intent].fill += words[0];
+			glink_advance(g, length);
+			if (words[1] == 0) {
+				struct glink_packet *packet = kalloc_data(sizeof(*packet) + channel->our_intents[intent].fill, Z_WAITOK);
+
+				if (packet != NULL) {
+					packet->next = NULL;
+					packet->length = channel->our_intents[intent].fill;
+					memcpy(packet->data, channel->our_intents[intent].data, packet->length);
+					if (channel->last != NULL) {
+						channel->last->next = packet;
+					} else {
+						channel->first = packet;
+					}
+					channel->last = packet;
+				}
+				channel->our_intents[intent].fill = 0;
+				glink_say(g, GLINK_DONE_REUSE, channel->ours, message.param2, NULL, 0);
+			}
+			break;
+		}
+		case GLINK_READ_NOTIFY:
+			glink_advance(g, length);
+			wr(ipcc.base + IPCC_SEND, g->ipcc_client << 16 | IPCC_GLINK);
+			break;
+		case GLINK_CLOSE:
+			glink_advance(g, length);
+			glink_say(g, GLINK_CLOSE_ACK, message.param1, 0, NULL, 0);
+			if ((channel = glink_theirs(g, message.param1)) != NULL) {
+				printf("%s: glink: THE %s CLOSES \"%s\"\n", g->who, g->peer, channel->name);
+				channel->open = false;
+				channel->theirs = 0;
+			}
+			break;
+		case GLINK_CLOSE_ACK:
+		case GLINK_SIGNALS:
+			glink_advance(g, length);
+			break;
+		default:
+			printf("%s: glink: A MESSAGE THIS DOES NOT KNOW (%u, %u, %#x): nothing more is read\n", g->who, message.command,
+			    message.param1, message.param2);
+			g->broken = true;
+			return;
+		}
+		for (unsigned c = 0; c < CHANNELS; c++) {
+			channel = &g->channel[c];
+			if (channel->theirs != 0 && channel->acknowledged && !channel->open) {
+				channel->open = true;
+				printf("%s: glink: THE CHANNEL \"%s\" IS OPEN both ways (ours %u, the %s's %u); telling the %s our intents\n",
+				    g->who, channel->name, channel->ours, g->peer, channel->theirs, g->peer);
+				for (unsigned i = 0; i < 3; i++) {
+					for (unsigned n = 0; n < channel->intents[i].count; n++) {
+						glink_offer(g, channel, channel->intents[i].size);
+					}
+				}
+			}
+		}
+	}
+}
+
+/* One whole message to the DSP on a channel; waits up to five seconds for an intent of the DSP's that it fits. */
+static int
+glink_send(struct glink_edge *g, struct glink_channel *channel, const void *data, uint32_t length)
+{
+	struct {
+		struct glink_message message;
+		uint32_t size, left;
+	} header = { { GLINK_DATA, (uint16_t)channel->ours, 0 }, length, 0 };
+	bool asked = false, fits;
+	int found = -1;
+
+	lck_mtx_lock(g->lock);
+	if (g->up && length + sizeof(header) + 8 > g->ours_size - GLINK_RESERVE) {
+		lck_mtx_unlock(g->lock);
+		return EMSGSIZE;
+	}
+	for (unsigned waited = 0;; waited++) {
+		glink_pump(g);
+		if (!g->up || !channel->open || g->broken) {
+			lck_mtx_unlock(g->lock);
+			return ENOTCONN;
+		}
+		found = -1;
+		fits = false;
+		for (unsigned n = 0; n < sizeof(channel->their_intents) / sizeof(channel->their_intents[0]); n++) {
+			if (!channel->their_intents[n].there || channel->their_intents[n].size < length) {
+				continue;
+			}
+			fits = true;
+			if (!channel->their_intents[n].in_use &&
+			    (found < 0 || channel->their_intents[n].size < channel->their_intents[found].size)) {
+				found = (int)n;
+			}
+		}
+		if (found >= 0 && glink_room(g) >= ((length + sizeof(header) + 7) & ~7u)) {
+			break;
+		}
+		if (!fits && !asked) {
+			channel->request_answered = false;
+			glink_say(g, GLINK_INTENT_REQUEST, channel->ours, length, NULL, 0);
+			asked = true;
+		}
+		/* refused: asked again (the audio DSP hands out small intents first and grants a larger one later) */
+		if (!fits && asked && channel->request_answered && !channel->request_granted && waited % 20 == 0) {
+			asked = false;
+		}
+		if (waited >= 5000) {
+			lck_mtx_unlock(g->lock);
+			return found < 0 ? ENOBUFS : EAGAIN;
+		}
+		lck_mtx_unlock(g->lock);
+		sleep_ms(1);
+		lck_mtx_lock(g->lock);
+	}
+	channel->their_intents[found].in_use = true;
+	header.message.param2 = channel->their_intents[found].id;
+	glink_put(g, &header, sizeof(header), data, length);
+	lck_mtx_unlock(g->lock);
+	return 0;
+}
+
+/* ---- QRTR: hello, and the services the DSP tells of (redwood_wifi.c, without ports of our own yet) ---- */
+
+#define QRTR_US                 1u
+#define QRTR_CONTROL            0xfffffffeu
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_DEL_CLIENT = 6, QRTR_RESUME_TX = 7,
+       QRTR_NEW_LOOKUP = 10, QRTR_DEL_LOOKUP = 11 };
+
+struct qrtr_header {
+	uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port;
+};
+struct qrtr_control {
+	uint32_t command;
+	uint32_t words[4];
+};
+
+static struct {
+	uint32_t service, instance, node, port;
+	bool there;
+} qrtr_servers[64];
+static uint32_t qrtr_peer, qrtr_in, qrtr_out, qrtr_hellos, qrtr_lookups;
+
+/* a datagram from our node on an edge's IPCRTR (the audio DSP's: qrtr_out_packet(); the modem's: mpss_qrtr_out()) */
+static int
+qrtr_send_on(struct glink_edge *g, uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data,
+    uint32_t length)
+{
+	uint32_t padded = (length + 3) & ~3u;
+	struct qrtr_header *packet;
+	int error;
+
+	packet = kalloc_data(sizeof(*packet) + padded, Z_WAITOK | Z_ZERO);
+	if (packet == NULL) {
+		return ENOMEM;
+	}
+	packet->version = 1;
+	packet->type = type;
+	packet->from_node = QRTR_US;
+	packet->from_port = from_port;
+	packet->size = length;
+	packet->to_node = to_node;
+	packet->to_port = to_port;
+	memcpy(packet + 1, data, length);
+	error = glink_send(g, &g->channel[CHANNEL_QRTR], packet, (uint32_t)sizeof(*packet) + padded);
+	kfree_data(packet, sizeof(*packet) + padded);
+	return error;
+}
+
+static int
+qrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	int error = qrtr_send_on(&glink, type, from_port, to_node, to_port, data, length);
+
+	qrtr_out += error == 0;
+	return error;
+}
+
+static void
+qrtr_control(const struct qrtr_header *header, const struct qrtr_control *control)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int found = -1, error;
+
+	switch (control->command) {
+	case QRTR_HELLO:
+		if (qrtr_hellos++ != 0) {
+			break;
+		}
+		error = qrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, header->from_node, QRTR_CONTROL, &hello, sizeof(hello));
+		printf("adsp: qrtr: HELLO FROM NODE %u; ours to it: %s\n", header->from_node, error == 0 ? "SENT" : "NOT SENT");
+		break;
+	case QRTR_NEW_SERVER:
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				found = (int)i;
+				break;
+			}
+			if (!qrtr_servers[i].there && found < 0) {
+				found = (int)i;
+			}
+		}
+		if (found >= 0) {
+			qrtr_servers[found].there = true;
+			qrtr_servers[found].service = control->words[0];
+			qrtr_servers[found].instance = control->words[1];
+			qrtr_servers[found].node = control->words[2];
+			qrtr_servers[found].port = control->words[3];
+		}
+		printf("adsp: qrtr: a service: %u (%#x), version %u, instance %u, at node %u port %u\n", control->words[0],
+		    control->words[0], control->words[1] & 0xff, control->words[1] >> 8, control->words[2], control->words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+		printf("adsp: qrtr: service %u at node %u port %u has gone\n", control->words[0], control->words[2], control->words[3]);
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			if (qrtr_servers[i].there && qrtr_servers[i].node == control->words[2] && qrtr_servers[i].port == control->words[3]) {
+				qrtr_servers[i].there = false;
+			}
+		}
+		break;
+	case QRTR_NEW_LOOKUP:
+		/* the DSP looks for a service of ours (a protection domain's locator, say): there are none yet */
+		if (qrtr_lookups++ < 16) {
+			printf("adsp: qrtr: the DSP looks for service %u (%#x), instance %u: nobody here offers it\n", control->words[0],
+			    control->words[0], control->words[1]);
+		}
+		break;
+	case QRTR_BYE:
+		printf("adsp: qrtr: BYE from node %u\n", header->from_node);
+		bzero(qrtr_servers, sizeof(qrtr_servers));
+		break;
+	default:
+		break;
+	}
+}
+
+/* a datagram's header (version 1 or 3) read into the one shape; where its payload begins; false: none to believe */
+static bool
+qrtr_parse(const char *who, const uint8_t *data, uint32_t length, struct qrtr_header *into, uint32_t *payload)
+{
+	struct qrtr_header header;
+	uint32_t at;
+
+	if (length >= sizeof(header) && data[0] == 1) {
+		memcpy(&header, data, sizeof(header));
+		at = sizeof(header);
+	} else if (length >= 16 && data[0] == 3) {
+		bzero(&header, sizeof(header));
+		header.type = data[1];
+		header.confirm = data[2] & 1;
+		memcpy(&header.size, data + 4, 4);
+		header.from_node = (uint32_t)(data[8] | data[9] << 8);
+		header.from_port = (uint32_t)(data[10] | data[11] << 8);
+		header.to_node = (uint32_t)(data[12] | data[13] << 8);
+		header.to_port = (uint32_t)(data[14] | data[15] << 8);
+		header.from_port = header.from_port == 0xfffe ? QRTR_CONTROL : header.from_port;
+		header.to_port = header.to_port == 0xfffe ? QRTR_CONTROL : header.to_port;
+		at = 16 + data[3];
+	} else {
+		printf("%s: qrtr: %u bytes that are no datagram (they begin %#x)\n", who, length, length ? data[0] : 0);
+		return false;
+	}
+	if (header.size == 0 || at + header.size > length) {
+		printf("%s: qrtr: a datagram of %u bytes in a message of %u: dropped\n", who, header.size, length);
+		return false;
+	}
+	*into = header;
+	*payload = at;
+	return true;
+}
+
+static void
+qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	uint32_t at;
+
+	if (!qrtr_parse("adsp", data, length, &header, &at)) {
+		return;
+	}
+	qrtr_in++;
+	if (qrtr_peer == 0) {
+		qrtr_peer = header.from_node;
+	}
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		qrtr_out_packet(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP) {
+		struct qrtr_control control = { 0 };
+
+		memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+		qrtr_control(&header, &control);
+		return;
+	}
+	printf("adsp: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n", header.size,
+	    header.from_node, header.from_port, header.to_port);
+}
+
+/* ---- APR: the audio services' protocol, on the channel apr_audio_svc ------------------------------------- */
+
+/*
+ * What Android's audio drivers say to the DSP's audio services (Linux: drivers/soc/qcom/apr.c,
+ * include/linux/soc/qcom/apr.h; Android's q6core.c): a packet of a header of eight words -- a
+ * word of kind, header length and version and the packet's length, who it is from and to (a
+ * service, a domain, a port each: we are domain 5, the DSP 4), a token the answer carries back,
+ * an opcode -- and what the opcode takes. The DSP's core service (3) answers whether the audio
+ * services are up (AVCS_CMD_ADSP_EVENT_GET_STATE, which Android asks again and again after the DSP
+ * has started, until the answer is 1) and which services it has and in which versions.
+ */
+#define APR_DOMAIN_ADSP                 4
+#define APR_DOMAIN_APPS                 5
+#define APR_SVC_ADSP_CORE               3
+#define APR_MSG_TYPE_SEQ_CMD            2
+#define APR_HDR_FIELD(type, bytes)      ((uint16_t)((type) << 8 | ((bytes) / 4) << 4))      /* version 0 */
+#define APR_BASIC_RSP_RESULT            0x000110e8u
+#define AVCS_GET_VERSIONS               0x00012905u
+#define AVCS_GET_VERSIONS_RSP           0x00012906u
+#define AVCS_CMD_ADSP_EVENT_GET_STATE   0x0001290cu
+#define AVCS_CMDRSP_ADSP_EVENT_GET_STATE 0x0001290du
+
+struct apr_header {
+	uint16_t field, size;
+	uint8_t from_service, from_domain;
+	uint16_t from_port;
+	uint8_t to_service, to_domain;
+	uint16_t to_port;
+	uint32_t token, opcode;
+};
+
+static struct {
+	uint32_t opcode, token, length;
+	uint32_t words[64];
+	volatile bool there;
+} apr_answer;
+static uint32_t apr_in, apr_out, apr_next_token = 1;
+static bool audio_up;                   /* the core service has said that the audio services are up (step 11) */
+static uint32_t apr_waited_for;         /* the token a question waits for the answer to; 0: none */
+static redwood_apr_events_t apr_events; /* the sound's (redwood_sound.c): what nobody waits for */
+static redwood_apr_events_t apr_events_second;  /* the microphones' (redwood_mic.c) */
+static LCK_MTX_DECLARE(apr_lock, &adsp_lock_group);     /* one question at a time */
+
+/* A packet from the DSP's audio services. From the link's thread. */
+static void
+apr_input(const uint8_t *data, uint32_t length)
+{
+	struct apr_header header;
+	uint32_t header_length, payload;
+
+	if (length < sizeof(header)) {
+		printf("adsp: apr: %u bytes, no APR packet\n", length);
+		return;
+	}
+	memcpy(&header, data, sizeof(header));
+	header_length = ((header.field >> 4) & 0xf) * 4;
+	if (header_length < sizeof(header) || header_length > length) {
+		printf("adsp: apr: a header of %u bytes in a packet of %u: dropped\n", header_length, length);
+		return;
+	}
+	payload = (header.size < length ? header.size : length) - header_length;
+	apr_in++;
+	if (header.token != apr_waited_for || apr_waited_for == 0) {
+		redwood_apr_events_t events = apr_events;
+		uint32_t words[64];
+
+		bzero(words, sizeof(words));
+		memcpy(words, data + header_length, payload < sizeof(words) ? payload : sizeof(words));
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+		events = apr_events_second;
+		if (events != NULL && events(header.from_service, header.from_port, header.opcode, header.token, words,
+		    payload < sizeof(words) ? payload : sizeof(words))) {
+			return;
+		}
+	}
+	if (apr_in <= 40) {
+		uint32_t w[4] = { 0, 0, 0, 0 };
+
+		memcpy(w, data + header_length, payload < sizeof(w) ? payload : sizeof(w));
+		printf("adsp: apr: < from service %u of domain %u (port %u) to %u of %u (port %u): opcode %#x, token %u, %u bytes: %#x %#x "
+		    "%#x %#x\n", header.from_service, header.from_domain, header.from_port, header.to_service, header.to_domain,
+		    header.to_port, header.opcode, header.token, payload, w[0], w[1], w[2], w[3]);
+	}
+	bzero(apr_answer.words, sizeof(apr_answer.words));
+	memcpy(apr_answer.words, data + header_length, payload < sizeof(apr_answer.words) ? payload : sizeof(apr_answer.words));
+	apr_answer.length = payload;
+	apr_answer.opcode = header.opcode;
+	apr_answer.token = header.token;
+	apr_answer.there = true;
+}
+
+/*
+ * dada: the audio services speak GPR, not APR -- AudioReach's packet router (Linux: drivers/soc/qcom/apr.c,
+ * include/linux/soc/qcom/apr.h), on the channel "adsp_apps" that the DSP opens. A header of six words:
+ * the version, the header's length in words and the packet's in bytes; the domains (the DSP is 2, we are 3);
+ * the source and destination ports (a module instance: the APM is 1, the PRM 2); a token; the opcode. A
+ * command to the APM carries a command header of four words more (an address, a handle and the payload's
+ * size) before its payload (audioreach.c, __audioreach_alloc_pkt).
+ */
+#define GPR_DOMAIN_ADSP         2
+#define GPR_DOMAIN_APPS         3
+#define GPR_APM                 1
+#define GPR_PRM                 2
+#define APM_CMD_GET_SPF_STATE   0x01001021
+#define APM_CMD_RSP_GET_SPF_STATE 0x02001007
+#define GPR_BASIC_RSP_RESULT    0x02001005
+
+static uint32_t gpr_in, gpr_out;
+/* for hakios_dada_audio.c: every GPR packet that comes, from the link's thread (must not wait) */
+void (*hakios_adsp_gpr_event)(uint32_t opcode, uint32_t token, const uint32_t *words, uint32_t length);
+
+static void
+gpr_input(const uint8_t *data, uint32_t length)
+{
+	uint32_t h[6], header_length, payload;
+
+	if (length < sizeof(h)) {
+		printf("adsp: gpr: %u bytes, no GPR packet\n", length);
+		return;
+	}
+	memcpy(h, data, sizeof(h));
+	header_length = ((h[0] >> 4) & 0xf) * 4;
+	if (header_length < sizeof(h) || header_length > length) {
+		printf("adsp: gpr: a header of %u bytes in a packet of %u: dropped\n", header_length, length);
+		return;
+	}
+	payload = MIN(h[0] >> 8, length) - header_length;
+	gpr_in++;
+	if (gpr_in <= 40) {
+		uint32_t w[4] = { 0, 0, 0, 0 };
+
+		memcpy(w, data + header_length, MIN(payload, sizeof(w)));
+		printf("adsp: gpr: < from port %#x of domain %u to port %#x: opcode %#x, token %u, %u bytes: %#x %#x %#x %#x\n",
+		    h[2], (h[1] >> 8) & 0xff, h[3], h[5], h[4], payload, w[0], w[1], w[2], w[3]);
+	}
+	if (hakios_adsp_gpr_event != NULL) {
+		uint32_t w[8] = { 0 };
+
+		memcpy(w, data + header_length, MIN(payload, sizeof(w)));
+		hakios_adsp_gpr_event(h[5], h[4], w, payload);
+		if ((h[5] & 0xff000000u) == 0x05000000u) {
+			return;         /* a data event (a buffer done): nobody waits for it here */
+		}
+	}
+	bzero(apr_answer.words, sizeof(apr_answer.words));
+	memcpy(apr_answer.words, data + header_length, MIN(payload, sizeof(apr_answer.words)));
+	apr_answer.length = payload;
+	apr_answer.opcode = h[5];
+	apr_answer.token = h[4];
+	apr_answer.there = true;
+}
+
+/* A GPR command and its answer waited for (ms), the answer in apr_answer; with_header: an APM command header. */
+static bool
+gpr_ask(uint32_t port, uint32_t opcode, const void *payload, uint32_t length, bool with_header, uint32_t ms)
+{
+	static uint8_t packet[24 + 16 + 2048];   /* (one at a time: apr_lock) */
+	uint32_t *h = (uint32_t *)packet, at = 24, token;
+	bool answered = false;
+
+	if (length > 2048 || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	lck_mtx_lock(&apr_lock);
+	bzero(packet, sizeof(packet));
+	if (with_header) {
+		uint32_t command[4] = { 0, 0, 0, length };
+
+		memcpy(packet + at, command, sizeof(command));
+		at += sizeof(command);
+	}
+	if (length != 0) {
+		memcpy(packet + at, payload, length);
+	}
+	at += length;
+	token = apr_next_token++;
+	h[0] = 0 | (6u << 4) | at << 8;
+	h[1] = GPR_DOMAIN_ADSP | GPR_DOMAIN_APPS << 8;
+	h[2] = port;
+	h[3] = port;
+	h[4] = token;
+	h[5] = opcode;
+	apr_answer.there = false;
+	if (glink_send(&glink, &glink.channel[CHANNEL_APR], packet, at) == 0) {
+		gpr_out++;
+		for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+			if (apr_answer.there && apr_answer.token == token) {
+				answered = true;
+				break;
+			}
+			lck_mtx_unlock(&apr_lock);
+			sleep_ms(1);
+			lck_mtx_lock(&apr_lock);
+		}
+	}
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+/*
+ * A whole GPR packet built by the caller (header included; its token in word 4) sent on the audio
+ * DSP's channel, and the answer with the same token waited for (ms; 0: none waited for). The answer's
+ * opcode and up to nwords of its payload are given back.
+ */
+bool hakios_adsp_gpr_raw(const void *packet, uint32_t length, uint32_t ms, uint32_t *answer_opcode, uint32_t *words,
+    uint32_t nwords);
+
+bool
+hakios_adsp_gpr_raw(const void *packet, uint32_t length, uint32_t ms, uint32_t *answer_opcode, uint32_t *words,
+    uint32_t nwords)
+{
+	uint32_t token;
+	bool answered = false;
+
+	if (!dada || !glink.up || length < 24 || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	memcpy(&token, (const uint8_t *)packet + 16, 4);
+	lck_mtx_lock(&apr_lock);
+	if (ms != 0) {
+		apr_answer.there = false;
+	}
+	int error = glink_send(&glink, &glink.channel[CHANNEL_APR], packet, length);
+	if (error != 0) {
+		struct glink_channel *c = &glink.channel[CHANNEL_APR];
+
+		printf("adsp: gpr: %u bytes not sent (error %d); the DSP's intents:", length, error);
+		for (unsigned n = 0; n < sizeof(c->their_intents) / sizeof(c->their_intents[0]); n++) {
+			if (c->their_intents[n].there) {
+				printf(" %u%s", c->their_intents[n].size, c->their_intents[n].in_use ? "*" : "");
+			}
+		}
+		printf("\n");
+	}
+	if (error == 0) {
+		gpr_out++;
+		answered = ms == 0;
+		for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+			if (apr_answer.there && apr_answer.token == token) {
+				answered = true;
+				break;
+			}
+			lck_mtx_unlock(&apr_lock);
+			sleep_ms(1);
+			lck_mtx_lock(&apr_lock);
+		}
+	}
+	if (answered && ms != 0) {
+		if (answer_opcode != NULL) {
+			*answer_opcode = apr_answer.opcode;
+		}
+		if (words != NULL) {
+			memcpy(words, apr_answer.words, MIN(nwords, 64u) * 4);
+		}
+	}
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+/*
+ * GPR for the rest of the kernel (hakios_dada_audio.c): a command to a port of the audio DSP's -- the APM's,
+ * the PRM's, a graph's module -- and its answer waited for. The answer's opcode and up to `nwords` of its
+ * words are given back; for a basic result (GPR_BASIC_RSP_RESULT) they are the command's opcode and the
+ * status, 0 for success. False if there is no link, or no answer within ms.
+ */
+bool hakios_adsp_gpr(uint32_t port, uint32_t opcode, const void *payload, uint32_t length, bool with_header, uint32_t ms,
+    uint32_t *answer_opcode, uint32_t *words, uint32_t nwords);
+
+bool
+hakios_adsp_gpr(uint32_t port, uint32_t opcode, const void *payload, uint32_t length, bool with_header, uint32_t ms,
+    uint32_t *answer_opcode, uint32_t *words, uint32_t nwords)
+{
+	if (!dada || !glink.up) {
+		return false;
+	}
+	if (!gpr_ask(port, opcode, payload, length, with_header, ms)) {
+		return false;
+	}
+	if (answer_opcode != NULL) {
+		*answer_opcode = apr_answer.opcode;
+	}
+	if (words != NULL) {
+		memcpy(words, apr_answer.words, MIN(nwords, 64u) * 4);
+	}
+	return true;
+}
+
+/*
+ * A command to one of the DSP's services (and its answer waited for, with ms): true when it was
+ * sent and, if waited for, answered; the answer is in apr_answer and, if asked for, in *answer.
+ * The port is the service's own numbering of what the command is for (ASM: session << 8 | stream).
+ */
+bool
+redwood_adsp_apr(uint8_t service, uint16_t port, uint32_t token, uint32_t opcode, const void *payload, uint32_t length,
+    uint32_t ms, struct redwood_apr_answer *answer)
+{
+	uint8_t packet[sizeof(struct apr_header) + 256];
+	struct apr_header *header = (struct apr_header *)packet;
+	bool answered = false;
+	int error;
+
+	if (length > sizeof(packet) - sizeof(*header) || !glink.channel[CHANNEL_APR].open) {
+		return false;
+	}
+	bzero(packet, sizeof(packet));
+	header->field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, sizeof(*header));
+	header->size = (uint16_t)(sizeof(*header) + length);
+	header->from_service = service;
+	header->from_domain = APR_DOMAIN_APPS;
+	header->from_port = port;
+	header->to_service = service;
+	header->to_domain = APR_DOMAIN_ADSP;
+	header->to_port = port;
+	header->opcode = opcode;
+	if (length != 0) {
+		memcpy(packet + sizeof(*header), payload, length);
+	}
+	if (ms == 0) {
+		/* (sent and not waited for: what comes back is the events' handler's) */
+		header->token = token;
+		error = glink_send(&glink, &glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+		apr_out += error == 0;
+		return error == 0;
+	}
+	lck_mtx_lock(&apr_lock);
+	if (token == 0) {
+		token = apr_next_token++;
+		if (apr_next_token >= 0x01000000u) {
+			apr_next_token = 1;
+		}
+	}
+	header->token = token;
+	apr_answer.there = false;
+	apr_waited_for = token;
+	error = glink_send(&glink, &glink.channel[CHANNEL_APR], packet, (uint32_t)sizeof(*header) + length);
+	if (error != 0) {
+		printf("adsp: apr: > opcode %#x to service %u: NOT SENT (%d)\n", opcode, service, error);
+	} else {
+		apr_out++;
+		for (uint32_t waited = 0; waited < ms && !answered; waited++) {
+			if (apr_answer.there && apr_answer.token == token) {
+				answered = true;
+				if (answer != NULL) {
+					answer->opcode = apr_answer.opcode;
+					answer->token = apr_answer.token;
+					answer->length = apr_answer.length;
+					memcpy(answer->words, apr_answer.words, sizeof(answer->words));
+				}
+				break;
+			}
+			sleep_ms(1);
+		}
+	}
+	apr_waited_for = 0;
+	lck_mtx_unlock(&apr_lock);
+	return answered;
+}
+
+void
+redwood_adsp_apr_events(redwood_apr_events_t handler)
+{
+	apr_events = handler;
+}
+
+void
+redwood_adsp_apr_events_second(redwood_apr_events_t handler)
+{
+	apr_events_second = handler;
+}
+
+/* A command to one of the DSP's services, and its answer waited for: true, and the answer in apr_answer, if it came. */
+static bool
+apr_ask(uint8_t service, uint32_t opcode, const void *payload, uint32_t length, uint32_t ms)
+{
+	return redwood_adsp_apr(service, 0, 0, opcode, payload, length, ms, NULL);
+}
+
+/* ---- the battery manager, on the channel PMIC_RTR_ADSP_APPS ------------------------------------------ */
+
+/*
+ * On this SoC the audio DSP also runs the battery's and the charger's management -- the fuel gauge,
+ * the charging -- and the operating system only asks it how things are: Android's
+ * qti_battery_charger.c, Linux's qcom_battmgr.c over pmic_glink.c, on the channel PMIC_RTR_ADSP_APPS
+ * that the DSP opens. A message is a header (owner 32778, the battery manager; type 1, request and
+ * answer, or 2, a notice; an opcode) and its words; a property is asked for with opcode 0x30 (the
+ * battery's) or 0x32 (the USB port's), the battery's number (0), the property's number and a word
+ * that a get does not use, and is answered with the property's number, its value and a result (0:
+ * good). Only gets are sent from here: nothing is set, no limit, no current, no notice asked for.
+ * With adsp=1 (battmgr=0: not) it is asked every BATTMGR_SECONDS while the DSP runs, and what it says
+ * goes to bsd/dev/redwood_battery.c (redwood_battery_report()), and from there to the power source
+ * that iOS reads (iokit/Kernel/RedwoodBattery.cpp). battmgr=2: every property once, for the log.
+ * Units: capacity in hundredths of a percent, voltage in uV, current in uA (more than 0 while the
+ * battery takes charge), the temperature in hundredths of a degree, charges in uAh.
+ * The properties' numbers are this phone's firmware's, read with battmgr=2 and checked against what
+ * Android shows at the same moment (dumpsys battery, /sys/class/power_supply/battery): up to 9 they
+ * are those of Linux's qcom_battmgr.c (sm8350), from there on one more property comes before the
+ * temperature, so the temperature is 13, not 12, and the charge counter, the cycles, the designed and
+ * the learnt full charge are 15 to 18.
+ */
+#define BATTMGR_OWNER           32778
+#define BATTMGR_REQUEST         1
+#define BATTMGR_NOTICE          2
+#define BATTMGR_BATTERY_GET     0x30
+#define BATTMGR_USB_GET         0x32
+#define BATT_STATUS             0               /* Linux's POWER_SUPPLY_STATUS_*: 1 charging, 2 discharging, 3 not charging, 4 full */
+#define BATT_HEALTH             1
+#define BATT_PRESENT            2
+#define BATT_CAPACITY           4
+#define BATT_VOLT_NOW           7
+#define BATT_CURR_NOW           9
+#define BATT_TEMP               13              /* hundredths of a degree: 3900 when Android says 39.0 */
+#define BATT_CHG_COUNTER        15              /* the charge in the battery now, uAh */
+#define BATT_CYCLE_COUNT        16
+#define BATT_CHG_FULL_DESIGN    17              /* 5000000 uAh */
+#define BATT_CHG_FULL           18              /* the full charge as the fuel gauge has learnt it, uAh */
+#define USB_VOLT_NOW            1               /* uV */
+#define USB_CURR_NOW            3               /* uA, what the port gives */
+#define USB_TYPE                6               /* Linux's POWER_SUPPLY_USB_TYPE_*: 1 here, a computer's port */
+#define USB_ONLINE              0
+#define BATTMGR_SECONDS         10
+#define MCA_READ                1
+#define MCA_CHG_STATUS          0x2001
+#define MCA_CHG_TYPE            0x2002
+#define MCA_PACK_VBAT           0x2026
+#define MCA_PACK_IBAT           0x2027
+#define MCA_PACK_TBAT           0x202a
+
+struct battmgr_message {
+	uint32_t owner, type, opcode;
+	uint32_t words[3];                      /* asked: battery, property, value; answered: property, value, result */
+};
+
+static struct {
+	volatile uint32_t answers, notices;
+	uint32_t opcode, property, value, result, length, seq;
+	bool wanted;
+	volatile bool runs;
+} battmgr;
+
+static void
+battmgr_input(const uint8_t *data, uint32_t length)
+{
+	struct battmgr_message m;
+
+	bzero(&m, sizeof(m));
+	memcpy(&m, data, length < sizeof(m) ? length : sizeof(m));
+	if (m.owner != BATTMGR_OWNER || length < 12) {
+		printf("adsp: battmgr: < %u bytes of owner %u, type %u, opcode %#x: not the battery manager's\n", length, m.owner,
+		    m.type, m.opcode);
+		return;
+	}
+	if (m.type == BATTMGR_NOTICE) {
+		if (battmgr.notices++ < 8) {
+			tell("adsp: battmgr: < a notice, opcode %#x, %u bytes (%#x %#x %#x)\n", m.opcode, length, m.words[0], m.words[1],
+			    m.words[2]);
+		}
+		return;
+	}
+	{
+		static unsigned said;
+
+		if (said++ < 40) {
+			uint32_t w[10] = { 0 };
+
+			memcpy(w, data + 12, MIN(length - 12, sizeof(w)));
+			tell("adsp: battmgr: < answer: type %u opcode %#x, %u bytes: %#x %#x %#x %#x %#x %#x %#x %#x %#x %#x\n", m.type,
+			    m.opcode, length, w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]);
+		}
+	}
+	if (dada && m.opcode == MCA_READ && length >= 0x18 + 4) {
+		/* Xiaomi's charge manager (MCA): property, result, sequence, then the data */
+		battmgr.opcode = m.opcode;
+		battmgr.property = m.words[0];
+		battmgr.result = m.words[1];
+		battmgr.seq = m.words[2];
+		memcpy(&battmgr.value, data + 0x18, 4);
+		battmgr.length = length;
+		os_atomic_inc(&battmgr.answers, release);
+		return;
+	}
+	battmgr.opcode = m.opcode;
+	battmgr.property = m.words[0];
+	battmgr.value = m.words[1];
+	battmgr.result = m.words[2];
+	battmgr.length = length;
+	os_atomic_inc(&battmgr.answers, release);
+}
+
+/*
+ * dada: the Xiaomi 15's firmware answers the battery manager's property requests with "unsupported"
+ * (result 1); its charger and battery are Xiaomi's charge manager's (MCA, Android's mca_adsp_glink.ko),
+ * on the same channel and owner: a read is opcode 1 with the property and a sequence number and 256
+ * bytes of room (276 in all), answered in 280: property, result (0: good), sequence, data. The
+ * properties are those mca_qcom_subpmic_proxy.ko asks for: 0x2001 the charge's status, 0x2002 the
+ * charger's type, 0x2026 the pack's voltage, 0x2027 its current, 0x202a its temperature.
+ */
+static bool
+mca_get(uint32_t property, uint32_t *value)
+{
+	static uint32_t seq;
+	struct {
+		uint32_t owner, type, opcode, property, seq;
+		uint8_t data[256];
+	} q;
+	uint32_t before = os_atomic_load(&battmgr.answers, acquire);
+
+	bzero(&q, sizeof(q));
+	q.owner = BATTMGR_OWNER;
+	q.type = BATTMGR_REQUEST;
+	q.opcode = MCA_READ;
+	q.property = property;
+	q.seq = ++seq;
+	if (glink_send(&glink, &glink.channel[CHANNEL_PMIC], &q, sizeof(q)) != 0) {
+		return false;
+	}
+	for (unsigned ms = 0; ms < 1000; ms++) {
+		if (os_atomic_load(&battmgr.answers, acquire) != before) {
+			if (battmgr.opcode == MCA_READ && battmgr.property == property && battmgr.seq == q.seq) {
+				*value = battmgr.value;
+				return battmgr.result == 0;
+			}
+			before = os_atomic_load(&battmgr.answers, acquire);
+		}
+		sleep_ms(1);
+	}
+	return false;
+}
+
+/* One property asked for and its answer waited for (a second at most); one thread asks at a time (battmgr_thread). */
+static bool
+battmgr_get(uint32_t opcode, uint32_t property, uint32_t *value)
+{
+	struct battmgr_message q = { BATTMGR_OWNER, BATTMGR_REQUEST, opcode, { 0, property, 0 } };
+	uint32_t before = os_atomic_load(&battmgr.answers, acquire);
+
+	{
+		int sent = glink_send(&glink, &glink.channel[CHANNEL_PMIC], &q, sizeof(q));
+		static unsigned said;
+
+		if (sent != 0) {
+			if (said++ < 4) {
+				tell("adsp: battmgr: a request for property %u of %#x could not be sent: %d\n", property, opcode, sent);
+			}
+			return false;
+		}
+	}
+	for (unsigned ms = 0; ms < 1000; ms++) {
+		if (os_atomic_load(&battmgr.answers, acquire) != before) {
+			if (battmgr.opcode != opcode || battmgr.property != property || battmgr.length < sizeof(struct battmgr_message)) {
+				before = battmgr.answers;       /* (somebody else's answer: wait on) */
+				continue;
+			}
+			if (battmgr.result != 0) {
+				return false;
+			}
+			*value = battmgr.value;
+			return true;
+		}
+		sleep_ms(1);
+	}
+	return false;
+}
+
+static void
+battmgr_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	battmgr.runs = true;
+	for (unsigned ms = 0; ms < 15000 && battmgr.wanted && !glink.channel[CHANNEL_PMIC].open; ms += 10) {
+		sleep_ms(10);
+	}
+	if (!glink.channel[CHANNEL_PMIC].open) {
+		tell("adsp: battmgr: the DSP has not opened PMIC_RTR_ADSP_APPS: nothing is asked\n");
+		battmgr.runs = false;
+		thread_terminate(current_thread());
+	}
+	{
+		/*
+		 * Notices asked for first, as Linux's qcom_battmgr does once the charger's domain is up
+		 * (BATTMGR_REQUEST_NOTIFICATION, sent as a notice, four words of nothing): on dada the firmware
+		 * answered no property before it.
+		 */
+		struct {
+			uint32_t owner, type, opcode;
+			uint32_t battery, power_state, low_capacity, high_capacity;
+		} enable = { BATTMGR_OWNER, BATTMGR_NOTICE, 0x4, 0, 0, 0, 0 };
+		int sent = glink_send(&glink, &glink.channel[CHANNEL_PMIC], &enable, sizeof(enable));
+
+		tell("adsp: battmgr: notices asked for (opcode 4): %d\n", sent);
+		sleep_ms(200);
+	}
+	{
+		/* boot-arg battmgr=2: every property once, for the log (which number is which on this phone's firmware) */
+		uint32_t mode = 1;
+
+		PE_parse_boot_argn("battmgr", &mode, sizeof(mode));
+		if (dada && mode == 2) {
+			static const uint32_t ids[] = { 0x2001, 0x2002, 0x2026, 0x2027, 0x202a, 0x20002, 0x1, 0x3, 0x4, 0xc,
+				0x2029, 0x200c, 0x2008 };
+
+			for (unsigned i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+				uint32_t v = 0;
+				bool ok = mca_get(ids[i], &v);
+
+				tell("adsp: battmgr: MCA property %#x: %s %u (%d)\n", ids[i], ok ? "" : "NO ANSWER", v, (int)v);
+			}
+			mode = 1;
+		}
+		for (uint32_t p = 0; mode == 2 && p < 32; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_BATTERY_GET, p, &v);
+
+			tell("adsp: battmgr: battery property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+		for (uint32_t p = 0; mode == 2 && p < 12; p++) {
+			uint32_t v = 0;
+			bool ok = battmgr_get(BATTMGR_USB_GET, p, &v);
+
+			tell("adsp: battmgr: USB property %u: %s %u (%d)\n", p, ok ? "" : "NO ANSWER", v, (int)v);
+		}
+	}
+	for (unsigned round = 0; dada && battmgr.wanted && glink.up && glink.channel[CHANNEL_PMIC].open; round++) {
+		/*
+		 * dada: what the charge manager knows -- the pack's voltage (mV), current (mA, more than 0 while it
+		 * takes charge), temperature (whole degrees), the charge's status (Linux's numbers: 4 full) and the
+		 * bus's voltage (uV: a charger is there above 4 V). The percentage is the fuel gauge's, a TI
+		 * bq27z561 on an I2C bus of the application processor's that this kernel does not drive yet: until
+		 * it does, it is read off the voltage (a Li-ion cell's resting curve, 3.4 V empty, 4.4 V full),
+		 * and a status of full is 100.
+		 */
+		static const struct { uint32_t mv, hundredths; } curve[] = { { 3400, 0 }, { 3600, 500 }, { 3700, 1500 },
+			{ 3750, 3000 }, { 3800, 4500 }, { 3850, 5500 }, { 3950, 7000 }, { 4050, 8000 }, { 4150, 8800 },
+			{ 4250, 9400 }, { 4350, 9800 }, { 4400, 10000 } };
+		struct redwood_battery_state b = { .size = sizeof(b) };
+		uint32_t mv = 0, ma = 0, deg = 0, status = 0, bus = 0, percent = 0;
+		bool gauge = false;
+		bool good = mca_get(MCA_PACK_VBAT, &mv) && mca_get(MCA_PACK_IBAT, &ma) && mca_get(MCA_PACK_TBAT, &deg) &&
+		    mca_get(MCA_CHG_STATUS, &status);
+
+		(void)mca_get(0x20002, &bus);
+		if (good) {
+			if (mv <= curve[0].mv) {
+				percent = 0;
+			} else if (mv >= curve[sizeof(curve) / sizeof(curve[0]) - 1].mv) {
+				percent = 10000;
+			} else {
+				for (unsigned i = 1; i < sizeof(curve) / sizeof(curve[0]); i++) {
+					if (mv < curve[i].mv) {
+						percent = curve[i - 1].hundredths + (curve[i].hundredths - curve[i - 1].hundredths) *
+						    (mv - curve[i - 1].mv) / (curve[i].mv - curve[i - 1].mv);
+						break;
+					}
+				}
+			}
+			if (status == 4) {
+				percent = 10000;
+			}
+			{
+				/* the fuel gauge's own figures, where it answers (boot-arg dadagauge=1) */
+				extern bool hakios_dada_gauge_read(uint32_t *, uint32_t *, uint32_t *, uint32_t *, uint32_t *,
+				    int32_t *);
+				uint32_t soc, remaining, full, design, cycles;
+				int32_t current;
+
+				if (hakios_dada_gauge_read(&soc, &remaining, &full, &design, &cycles, &current)) {
+					percent = soc * 100;
+					b.charge_uah = (int32_t)remaining * 1000;
+					b.full_uah = (int32_t)full * 1000;
+					b.design_uah = (int32_t)design * 1000;
+					b.cycles = (int32_t)cycles;
+					gauge = true;
+				}
+			}
+			b.percent_hundredths = (int32_t)percent;
+			b.voltage_uv = (int32_t)mv * 1000;
+			b.current_ua = (int32_t)ma * 1000;
+			b.temperature_hundredths = (int32_t)deg * 100;
+			{
+				/*
+				 * The temperature told to iOS is 35 degrees at most (boot-arg battmgr_tempcap=C, 0: as it is).
+				 * iOS judges a battery's heat by an iPhone's, and the Xiaomi 15's is at 43 to 45 while it charges
+				 * and runs: told so, iOS dimmed the whole display to almost black for heat (runs adsp11-15; with
+				 * the cap, adsp16, it stayed bright). The log has the real figure.
+				 */
+				uint32_t cap = 35;
+
+				PE_parse_boot_argn("battmgr_tempcap", &cap, sizeof(cap));
+				if (cap != 0 && deg > cap) {
+					b.temperature_hundredths = (int32_t)cap * 100;
+				}
+			}
+			b.present = true;
+			b.external = bus > 4000000;
+			b.status = (int32_t)status;
+			if (!gauge) {
+				b.design_uah = 5300000;
+				b.full_uah = 5300000;
+				b.charge_uah = (int32_t)((uint64_t)5300000 * percent / 10000);
+			}
+			b.usb_voltage_uv = (int32_t)bus;
+			redwood_battery_report(&b);
+		}
+		if (round < 3 || round % 6 == 0 || !good) {
+			tell("adsp: battmgr: %s %u mV, %d mA, %u degrees, status %u, bus %u uV: %u.%02u%% (%s)\n",
+			    good ? "the charge manager says:" : "NO ANSWER to all of", mv, (int)ma, deg, status, bus, percent / 100,
+			    percent % 100, gauge ? "the gauge's" : "from the voltage");
+		}
+		for (unsigned ms = 0; ms < BATTMGR_SECONDS * 1000 && battmgr.wanted && glink.up; ms += 50) {
+			sleep_ms(50);
+		}
+	}
+	for (unsigned round = 0; !dada && battmgr.wanted && glink.up && glink.channel[CHANNEL_PMIC].open; round++) {
+		struct redwood_battery_state b = { .size = sizeof(b) };
+		uint32_t capacity = 0, status = 0, present = 0, volt = 0, curr = 0, temp = 0, usb = 0;
+		uint32_t usb_type = 0, usb_volt = 0, usb_curr = 0, charge = 0;
+		static uint32_t full, design, cycles;
+		bool good = battmgr_get(BATTMGR_BATTERY_GET, BATT_CAPACITY, &capacity) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_STATUS, &status) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_PRESENT, &present) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_VOLT_NOW, &volt) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_CURR_NOW, &curr) &&
+		    battmgr_get(BATTMGR_BATTERY_GET, BATT_TEMP, &temp) &&
+		    battmgr_get(BATTMGR_USB_GET, USB_ONLINE, &usb);
+
+		if (good) {
+			/* (what may be missing without harm, and the capacities and the cycles only now and then: they hardly change) */
+			(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_COUNTER, &charge);
+			if (usb) {
+				(void)battmgr_get(BATTMGR_USB_GET, USB_TYPE, &usb_type);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_VOLT_NOW, &usb_volt);
+				(void)battmgr_get(BATTMGR_USB_GET, USB_CURR_NOW, &usb_curr);
+			}
+			if (round % 30 == 0 || full == 0) {
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL, &full);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CHG_FULL_DESIGN, &design);
+				(void)battmgr_get(BATTMGR_BATTERY_GET, BATT_CYCLE_COUNT, &cycles);
+			}
+			b.percent_hundredths = (int32_t)capacity;
+			b.voltage_uv = (int32_t)volt;
+			b.current_ua = (int32_t)curr;
+			b.temperature_hundredths = (int32_t)temp;
+			b.present = present != 0;
+			b.external = usb != 0;
+			b.status = (int32_t)status;
+			b.charge_uah = (int32_t)charge;
+			b.full_uah = (int32_t)full;
+			b.design_uah = (int32_t)design;
+			b.cycles = (int32_t)cycles;
+			b.usb_type = (int32_t)usb_type;
+			b.usb_voltage_uv = (int32_t)usb_volt;
+			b.usb_current_ua = (int32_t)usb_curr;
+			redwood_battery_report(&b);
+		}
+		if (round < 3 || round % 6 == 0 || !good) {
+			tell("adsp: battmgr: %s capacity %u (hundredths of a percent), status %u, present %u, %d uV, %d uA, temperature %d "
+			    "(hundredths of a degree), charge %u uAh, USB online %u (type %u, %u uV, %u uA)\n",
+			    good ? "the DSP says:" : "NO ANSWER to all of", capacity, status, present, (int)volt, (int)curr, (int)temp,
+			    charge, usb, usb_type, usb_volt, usb_curr);
+			if (round % 30 == 0 && good) {
+				tell("adsp: battmgr: full charge %u uAh, as designed %u uAh, %u cycles\n", full, design, cycles);
+			}
+		}
+		for (unsigned ms = 0; ms < BATTMGR_SECONDS * 1000 && battmgr.wanted && glink.up; ms += 50) {
+			sleep_ms(50);
+		}
+	}
+	battmgr.runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+battmgr_start(void)
+{
+	thread_t thread;
+
+	uint32_t wanted = 1;            /* (on with adsp=1 unless battmgr=0) */
+
+	PE_parse_boot_argn("battmgr", &wanted, sizeof(wanted));
+	if (wanted == 0 || battmgr.runs) {
+		return;
+	}
+	if (option("battery")) {
+		/* (the loader's way, through Qualcomm's UEFI charger drivers: one way to the battery at a time) */
+		tell("adsp: battmgr: not with battery=1: the battery is asked about the loader's way\n");
+		return;
+	}
+	battmgr.wanted = true;
+	if (kernel_thread_start(battmgr_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static void
+battmgr_stop(void)
+{
+	battmgr.wanted = false;
+	for (unsigned ms = 0; ms < 2000 && battmgr.runs; ms++) {
+		sleep_ms(1);
+	}
+}
+
+/* ---- the link's thread ----------------------------------------------------------------------------- */
+
+static volatile bool link_wanted, link_runs;
+
+static void
+link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct smp2p words, last;
+	struct glink_packet *packet;
+	bool gave_up = false;
+
+	bzero(&last, sizeof(last));
+	dsp_words(&last);
+	while (link_wanted) {
+		sleep_us(1000);
+		doorbells();
+		if (dsp_words(&words) && memcmp(&words, &last, sizeof(words)) != 0) {
+			last = words;
+			dsp_listen(&words);
+			if ((dsp_state(&words) & DSP_FATAL) && !gave_up) {
+				gave_up = true;
+				printf("adsp: link: THE AUDIO DSP SAYS IT HAS GIVEN UP (\"slave-kernel\" = %#x)\n", dsp_state(&words));
+				show_crash_reason();
+			}
+		}
+		for (;;) {
+			unsigned from = CHANNELS;
+
+			lck_mtx_lock(&glink_lock);
+			glink_pump(&glink);
+			packet = NULL;
+			for (unsigned c = 0; c < CHANNELS && packet == NULL; c++) {
+				struct glink_channel *channel = &glink.channel[c];
+
+				if ((packet = channel->first) != NULL) {
+					channel->first = packet->next;
+					channel->last = channel->first == NULL ? NULL : channel->last;
+					from = c;
+				}
+			}
+			lck_mtx_unlock(&glink_lock);
+			if (packet == NULL) {
+				break;
+			}
+			if (from == CHANNEL_QRTR) {
+				qrtr_input(packet->data, packet->length);
+			} else if (from == CHANNEL_PMIC) {
+				battmgr_input(packet->data, packet->length);
+			} else {
+				if (dada) {
+					gpr_input(packet->data, packet->length);
+				} else {
+					apr_input(packet->data, packet->length);
+				}
+			}
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+	}
+	link_runs = false;
+	thread_terminate(current_thread());
+}
+
+static void
+link_stop(void)
+{
+	struct glink_packet *packet;
+
+	if (link_runs) {
+		link_wanted = false;
+		for (unsigned ms = 0; ms < 2000 && link_runs; ms++) {
+			sleep_ms(1);
+		}
+		printf("adsp: link: %s; GLINK said %u and heard %u messages, QRTR sent %u and received %u datagrams, APR %u and %u "
+		    "packets; its doorbells heard: GLINK %u, SMP2P %u\n", link_runs ? "THE THREAD DOES NOT END" : "down", glink.said,
+		    glink.heard, qrtr_out, qrtr_in, apr_out, apr_in, doorbell.glink, doorbell.smp2p);
+	}
+	lck_mtx_lock(&glink_lock);
+	glink.up = false;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->open = false;
+		while ((packet = channel->first) != NULL) {
+			channel->first = packet->next;
+			kfree_data(packet, sizeof(*packet) + packet->length);
+		}
+		channel->last = NULL;
+	}
+	lck_mtx_unlock(&glink_lock);
+	bzero(qrtr_servers, sizeof(qrtr_servers));
+	qrtr_peer = 0;
+}
+
+/* ---- step 8: GLINK's queues, looked at -------------------------------------------------------------- */
+
+static bool
+step_queues(void)
+{
+	struct glink_message message;
+	uint32_t head, tail;
+
+	announce("find GLINK's descriptor and the two queues, and read what the audio DSP has put into its own");
+	if (!glink_find()) {
+		printf("adsp: %u: GLINK's items are not all there, or not of a shape this knows (descriptor %#x, ours %#x of %u bytes, "
+		    "the DSP's %#x of %u)\n", step, glink.descriptor, glink.ours, glink.ours_size, glink.theirs, glink.theirs_size);
+		return false;
+	}
+	head = smem_word(glink.descriptor + GLINK_THEIR_HEAD);
+	tail = smem_word(glink.descriptor + GLINK_THEIR_TAIL);
+	printf("adsp: %u: our queue: %u bytes at %#lx, written to %#x, read by the DSP to %#x; the DSP's: %u bytes at %#lx, written "
+	    "to %#x, read by us to %#x\n", step, glink.ours_size, SMEM_PHYS + glink.ours, smem_word(glink.descriptor + GLINK_OUR_HEAD),
+	    smem_word(glink.descriptor + GLINK_OUR_TAIL), glink.theirs_size, SMEM_PHYS + glink.theirs, head, tail);
+	for (uint32_t at = 0, shown = 0; at + sizeof(message) <= head && head < glink.theirs_size && tail == 0 && shown < 8; shown++) {
+		char name[33] = "";
+		uint32_t length = sizeof(message);
+
+		glink_peek(&glink, &message, at, sizeof(message));
+		if (message.command == GLINK_OPEN) {
+			glink_peek(&glink, name, at + 8, message.param2 < 32 ? message.param2 : 32);
+			length += message.param2;
+		}
+		printf("adsp: %u:   in the DSP's queue at %#x: %s %u %#x %s\n", step, at, glink_name(message.command), message.param1,
+		    message.param2, name);
+		if (message.command != GLINK_VERSION && message.command != GLINK_OPEN) {
+			break;
+		}
+		at += (length + 7) & ~7u;
+	}
+	return true;
+}
+
+/* ---- step 9: GLINK, spoken -------------------------------------------------------------------------- */
+
+static bool
+step_link(void)
+{
+	thread_t thread;
+	uint64_t began;
+
+	if (!dsp_started || glink.descriptor == 0) {
+		return false;
+	}
+	announce("take up GLINK with the audio DSP: our version, then whatever its messages call for; a thread of ours listens "
+	    "from here on, every millisecond");
+	snprintf(last_write, sizeof(last_write), "step %u took up GLINK", step);
+	lck_mtx_lock(&glink_lock);
+	glink.features = GLINK_INTENT_REUSE;
+	glink.agreed = glink.broken = false;
+	glink.said = glink.heard = 0;
+	for (unsigned c = 0; c < CHANNELS; c++) {
+		struct glink_channel *channel = &glink.channel[c];
+
+		channel->asked = channel->acknowledged = channel->open = false;
+		channel->theirs = channel->our_intent_count = 0;
+		bzero(channel->their_intents, sizeof(channel->their_intents));
+	}
+	apr_in = apr_out = 0;
+	audio_up = false;
+	bzero(glink.others, sizeof(glink.others));
+	glink.trace = 60;
+	glink.up = true;
+	qrtr_hellos = qrtr_in = qrtr_out = qrtr_lookups = 0;
+	doorbell.since = began = now_us();
+	glink_say(&glink, GLINK_VERSION, GLINK_VERSION_1, glink.features, NULL, 0);
+	lck_mtx_unlock(&glink_lock);
+	link_wanted = link_runs = true;
+	if (kernel_thread_start(link_thread, NULL, &thread) != KERN_SUCCESS) {
+		link_wanted = link_runs = false;
+		printf("adsp: %u: no thread\n", step);
+		return false;
+	}
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !glink.channel[CHANNEL_QRTR].open && !glink.broken; ms++) {
+		sleep_ms(1);
+	}
+	sleep_ms(50);
+	printf("adsp: %u: %llu ms after our version: versions %s (features %#x); the channel \"IPCRTR\" is %s, \"apr_audio_svc\" %s; "
+	    "the DSP also opened \"%s\" \"%s\" \"%s\" \"%s\"\n", step, (now_us() - began) / 1000, glink.agreed ? "agreed" :
+	    "NOT AGREED", glink.features, glink.channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN",
+	    glink.channel[CHANNEL_APR].open ? "OPEN" : "NOT OPEN", glink.others[0], glink.others[1], glink.others[2], glink.others[3]);
+	return glink.channel[CHANNEL_QRTR].open;
+}
+
+/* ---- step 10: QRTR ---------------------------------------------------------------------------------- */
+
+static bool
+step_qrtr(void)
+{
+	unsigned services = 0;
+
+	if (!glink.channel[CHANNEL_QRTR].open) {
+		return false;
+	}
+	PE_parse_boot_argn("adsp_listen", &listen_seconds, sizeof(listen_seconds));
+	announce("listen to QRTR on the channel: the DSP's hello (answered from the link's thread), and the services it tells of");
+	for (unsigned ms = 0; ms < listen_seconds * 1000; ms++) {
+		sleep_ms(1);
+	}
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	printf("adsp: %u: after %u s: %s; the DSP is node %u and has told of %u services; it looked for %u of ours; QRTR received %u "
+	    "and sent %u datagrams\n", step, listen_seconds, qrtr_hellos ? "HELLO BOTH WAYS" : "NO HELLO FROM THE DSP", qrtr_peer,
+	    services, qrtr_lookups, qrtr_in, qrtr_out);
+	return qrtr_hellos != 0;
+}
+
+/* ---- step 11: APR ---------------------------------------------------------------------------------- */
+
+static bool
+step_apr(void)
+{
+	uint32_t wait_seconds = 10, asked = 0, state = 0;
+	uint64_t began = now_us();
+
+	PE_parse_boot_argn("adsp_apr_wait", &wait_seconds, sizeof(wait_seconds));
+	if (dada) {
+		/* dada: GPR on "adsp_apps", and the question is the APM's: is the signal processing framework up */
+		announce("ask the audio DSP's APM over GPR whether its signal processing framework (SPF) is ready");
+		for (unsigned ms = 0; ms < 3000 && !glink.channel[CHANNEL_APR].open; ms++) {
+			sleep_ms(1);
+		}
+		if (!glink.channel[CHANNEL_APR].open) {
+			printf("adsp: %u: the channel \"adsp_apps\" is not open: the DSP has not opened it\n", step);
+			return false;
+		}
+		while (now_us() - began < wait_seconds * 1000000ull) {
+			asked++;
+			if (gpr_ask(GPR_APM, APM_CMD_GET_SPF_STATE, NULL, 0, true, 500) &&
+			    apr_answer.opcode == APM_CMD_RSP_GET_SPF_STATE) {
+				state = apr_answer.words[0];
+				if (state == 1) {
+					break;
+				}
+			}
+			sleep_ms(200);
+		}
+		audio_up = state == 1;
+		printf("adsp: %u: %s after %llu ms and %u questions (the last answer: opcode %#x, %u bytes, %#x)\n", step,
+		    state == 1 ? "THE AUDIO DSP'S SPF IS READY" : "THE SPF DOES NOT SAY IT IS READY", (now_us() - began) / 1000,
+		    asked, apr_answer.opcode, apr_answer.length, apr_answer.words[0]);
+		return state == 1;
+	}
+	announce("ask the audio DSP's core service over APR whether the audio services are up (again and again, as Android "
+	    "does), then which services it has");
+	for (unsigned ms = 0; ms < 3000 && !glink.channel[CHANNEL_APR].open; ms++) {
+		sleep_ms(1);
+	}
+	if (!glink.channel[CHANNEL_APR].open) {
+		printf("adsp: %u: the channel \"apr_audio_svc\" is not open: the DSP has not opened it\n", step);
+		return false;
+	}
+	while (now_us() - began < wait_seconds * 1000000ull) {
+		asked++;
+		if (apr_ask(APR_SVC_ADSP_CORE, AVCS_CMD_ADSP_EVENT_GET_STATE, NULL, 0, 500) &&
+		    apr_answer.opcode == AVCS_CMDRSP_ADSP_EVENT_GET_STATE) {
+			state = apr_answer.words[0];
+			if (state == 1) {
+				break;
+			}
+		}
+		sleep_ms(200);
+	}
+	audio_up = state == 1;
+	printf("adsp: %u: %s after %llu ms and %u questions (the last answer: opcode %#x, %u bytes, %#x)\n", step, state == 1 ?
+	    "THE AUDIO SERVICES ARE UP" : "THE AUDIO SERVICES DO NOT SAY THEY ARE UP", (now_us() - began) / 1000, asked,
+	    apr_answer.opcode, apr_answer.length, apr_answer.words[0]);
+	if (apr_ask(APR_SVC_ADSP_CORE, AVCS_GET_VERSIONS, NULL, 0, 1000)) {
+		char line[400];
+		int at = 0;
+
+		for (uint32_t i = 0; i < apr_answer.length / 4 && i < 64 && at < (int)sizeof(line) - 12; i++) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %#x", apr_answer.words[i]);
+		}
+		printf("adsp: %u: the services and their versions (opcode %#x, %u bytes):%s\n", step, apr_answer.opcode,
+		    apr_answer.length, line);
+	} else {
+		printf("adsp: %u: no answer to the question of the services' versions\n", step);
+	}
+	return state == 1;
+}
+
+/* ---- the steps, and their end ----------------------------------------------------------------------- */
+
+static bool (*const steps[STEPS])(void) = {
+	step_survey, step_firmware, step_mailbox, step_header, step_image, step_our_item, step_start, step_queues, step_link,
+	step_qrtr, step_apr,
+};
+
+static bool keep;                       /* the DSP and the link stay up while the system runs (adsp_keep, adsp=1) */
+
+static void
+steps_over(uint32_t done)
+{
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started && done == last_step && keep) {
+		printf("adsp: THE AUDIO DSP STAYS ON while the system runs%s\n", link_runs ? ", and the link with it" : "");
+	} else if (dsp_started) {
+		dsp_shutdown("the steps are over");
+	}
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* When the run ends in order: a DSP that runs is shut down, for the next kernel to start again. */
+void
+redwood_adsp_stop(void)
+{
+	battmgr_stop();
+	redwood_sound_dsp_down();               /* the amplifiers, the stream and the port first, while the DSP still listens */
+	redwood_mic_dsp_down();                 /* and what the microphones' path has asked for */
+	lck_mtx_lock(&dsp_lock);
+	if (dsp_started) {
+		unsigned services = 0;
+		uint32_t node = qrtr_peer;
+		bool down;
+
+		for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+			services += qrtr_servers[i].there;
+		}
+		down = dsp_shutdown("the run is about to end");
+		/* (said again at the end: a long run's log keeps its beginning and its end, and the middle may be gone) */
+		tell("adsp: the audio DSP is off: it had been up%s (node %u, %u services; audio services %s), it %s, and TrustZone %s\n",
+		    node ? " and linked" : ", NOT LINKED", node, services, audio_up ? "up" : "NOT UP", stopped_by_its_word ?
+		    "stopped when asked" : "DID NOT SAY IT HAD STOPPED", down ? "has shut it down" : "DID NOT SHUT IT DOWN");
+	}
+	lck_mtx_unlock(&dsp_lock);
+}
+
+/* The same on a panic's way back to the loader: one processor, interrupts off, no lock, no sleep. */
+void
+redwood_adsp_quiesce(void)
+{
+	redwood_sound_quiesce();                /* the amplifiers off, whatever the DSP's state */
+	if (!dsp_started) {
+		return;
+	}
+	leaving = true;
+	new_from = ~0u;
+	dsp_shutdown("the kernel is on its way back to the loader");
+}
+
+static void
+run_steps(void)
+{
+	uint32_t done = 0;
+
+	for (step = 1; step <= last_step; step++) {
+		if (!steps[step - 1]()) {
+			printf("adsp: step %u: FAILED; the steps after it are not attempted\n", step);
+			break;
+		}
+		printf("adsp: step %u: done\n", step);
+		done = step;
+	}
+	step = done;
+	new_from = STEPS + 1;
+	steps_over(done);
+	printf("adsp: over after step %u; %s\n", done, last_write);
+}
+
+static void
+whole_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint64_t began = now_us();
+	unsigned services = 0;
+
+	/* (the firmware may be on the root file system, which is not mounted yet when this begins: a minute at most) */
+	for (unsigned waited = 0; waited < 300 && rootvnode == NULLVP; waited++) {
+		sleep_ms(200);
+	}
+	/* (dada: the firmware is on the system volume, which is the root only once stage0 has moved to it from the
+	 * small image -- so the file itself is waited for, two minutes at most) */
+	for (unsigned waited = 0; dada && waited < 600; waited++) {
+		vnode_t vnode = NULLVP;
+
+		if (rootvnode != NULLVP && (vnode_lookup("/fw/adsp.mdt", 0, &vnode, vfs_context_kernel()) == 0 ||
+		    vnode_lookup("/redwood/fw/adsp.mdt", 0, &vnode, vfs_context_kernel()) == 0)) {
+			vnode_put(vnode);
+			break;
+		}
+		sleep_ms(200);
+	}
+	run_steps();
+	for (unsigned i = 0; i < sizeof(qrtr_servers) / sizeof(qrtr_servers[0]); i++) {
+		services += qrtr_servers[i].there;
+	}
+	if ((step == STEPS || (dada && step == STEPS - 1)) && dsp_started) {
+		/* (dada: step 11 is GPR's question; the battery needs only the link, so it starts after step 10 too) */
+		tell("adsp: THE AUDIO DSP IS UP AND LINKED, its audio services up (APR), %llu ms after the kernel began on it (the "
+		    "root's waited for included): node %u, %u services; it stays on\n", (now_us() - began) / 1000, qrtr_peer, services);
+		redwood_sound_dsp_up();         /* (boot-arg sound=N: the speakers' path, redwood_sound.c) */
+		redwood_mic_dsp_up();           /* (boot-arg mic=N: the microphones' path, redwood_mic.c) */
+		battmgr_start();                /* (how the battery is, from the DSP; battmgr=0: not asked) */
+	} else {
+		tell("adsp: THE AUDIO DSP DID NOT COME UP: step %u failed (%s); see the kernel's own log for the steps\n", step + 1,
+		    last_write);
+	}
+	thread_terminate(current_thread());
+}
+
+/* Called while the system starts (bsd/dev/redwood_input.c), after the Wi-Fi's start has been set going. */
+/* ---- dadampss=1: the modem (MPSS) ---------------------------------------------------------------------
+ *
+ * ~/hakios-gpu2/patches/mpss-dada/spec.md: as mainline qcom_q6v5_pas.c boots sm8750's modem. Its image is the phone's own
+ * (/vendor/modem_firmware/image, put into fw/ of the small image by userland/build.sh MODEM=1). The DSM regions handed to the
+ * modem (assign_mem), its rails voted (cx.lvl 384, mss.lvl 320), AOP told (load_state), the companion image (PAS 0x26) and
+ * the image (PAS 4) given to TrustZone, then the modem's SMP2P item (435, remote host 1) watched for READY. Then GLINK and
+ * QRTR with it (mpss_link(), dadampss_link=0: not); no rmtfs yet. (Its IPCC doorbells, client 2, are heard by doorbells().)
+ */
+#define MPSS_PAS                4
+#define MPSS_DTB_PAS            0x26
+#define MPSS_MEM                0x8ba00000u
+#define MPSS_MEM_SIZE           0x0f600000u
+#define MPSS_DTB_MEM            0x9b000000u
+#define MPSS_DTB_MEM_SIZE       0x00080000u
+#define SMEM_MPSS               1
+#define ITEM_SMP2P_MPSS         435
+#define ITEM_MPSS_CRASH         421
+#define SCM_ASSIGN_MEM          SCM_CALL(0x0c, 0x16)
+
+static uint32_t
+mpss_item(uint32_t item, uint32_t *size)
+{
+	static struct smem_item found[256];
+	static const uint16_t hosts[2][2] = { { SMEM_US, SMEM_MPSS }, { SMEM_GLOBAL, SMEM_GLOBAL } };
+
+	for (unsigned h = 0; h < 2; h++) {
+		uint32_t cacheline = 0, partition_size = 0;
+		uint32_t partition = smem_partition(hosts[h][0], hosts[h][1], &cacheline, &partition_size);
+		unsigned count = partition ? smem_items(partition, cacheline, found, 256) : 0;
+
+		for (unsigned i = 0; i < count && i < 256; i++) {
+			if (found[i].item == item) {
+				*size = found[i].size;
+				return found[i].offset;
+			}
+		}
+	}
+	return 0;
+}
+
+/* a region of memory given to the modem (VMID 0xF MSS_MSA, read-write) from us (3 HLOS) */
+static bool
+mpss_assign(uint64_t address, uint64_t size)
+{
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull, base;
+	int32_t result;
+
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	base = kvtophys(page);
+	*(uint32_t *)(page + 0) = 3;                            /* src: HLOS */
+	*(uint64_t *)(page + 64) = address;                     /* struct qcom_scm_mem_map_info */
+	*(uint64_t *)(page + 72) = size;
+	*(uint32_t *)(page + 128) = 0xf;                        /* dest: MSS_MSA, perm RW (6) */
+	*(uint32_t *)(page + 132) = 6;
+	*(uint64_t *)(page + 192) = 4;                          /* the arguments past the fourth: src size, dest, dest size, 0 */
+	*(uint64_t *)(page + 200) = base + 128;
+	*(uint64_t *)(page + 208) = 24;
+	*(uint64_t *)(page + 216) = 0;
+	for (vm_offset_t line = page; line < page + PAGE_SIZE; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	settle();
+	scm_x5 = base + 192;
+	result = scm("to give memory to the modem", SCM_ASSIGN_MEM, 0x1117, base + 64, 16, base, &answer);
+	scm_x5 = 0;
+	printf("mpss: %#llx (%#llx bytes) to the modem: %d, %#llx\n", address, size, result, answer);
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	return result == 0;
+}
+
+/* copies into device-mapped memory (outside the kernel's RAM, mapped Device-GRE): aligned 8-byte stores only */
+static void
+io_copy(vm_offset_t to, const uint8_t *from, uint64_t size)
+{
+	uint64_t i = 0;
+
+	for (; i + 8 <= size; i += 8) {
+		uint64_t w;
+
+		memcpy(&w, from + i, 8);
+		*(volatile uint64_t *)(to + i) = w;
+	}
+	if (i < size) {
+		uint64_t w = 0;
+
+		memcpy(&w, from + i, size - i);
+		*(volatile uint64_t *)(to + i) = w;
+	}
+}
+
+static void
+io_zero(vm_offset_t to, uint64_t size)
+{
+	for (uint64_t i = 0; i < size; i += 8) {
+		*(volatile uint64_t *)(to + i) = 0;
+	}
+}
+
+/* one image (modem or modem_dtb): its header to TrustZone, its place, its segments, authenticated and started */
+static bool
+mpss_image(const char *name, uint32_t pas, uint32_t memory, uint32_t memory_size)
+{
+	char file[32];
+	const uint8_t *mdt;
+	uint64_t mdt_size = 0, answer = ~0ull;
+	uint32_t count, phoff, lowest = ~0u, highest = 0, setup;
+	vm_offset_t page = 0, map;
+	uint64_t header_phys;
+	int32_t result;
+
+	snprintf(file, sizeof(file), "%s.mdt", name);
+	mdt = image_file(file, &mdt_size);
+	if (mdt == NULL || mdt_size < 52 || mdt_size > PAGE_SIZE) {
+		printf("mpss: no %s (or too big: %llu)\n", file, mdt_size);
+		return false;
+	}
+	phoff = *(const uint32_t *)(mdt + 28);
+	count = *(const uint16_t *)(mdt + 44);
+	for (uint32_t i = 0; i < count; i++) {
+		const struct elf_segment *g = (const struct elf_segment *)(mdt + phoff + 32 * i);
+
+		if (g->type == 1 && !MDT_HASH(g->flags) && g->memory_size != 0) {
+			lowest = MIN(lowest, g->paddr);
+			highest = MAX(highest, g->paddr + g->memory_size);
+		}
+	}
+	if (lowest == ~0u || highest - lowest > memory_size) {
+		printf("mpss: %s: segments %#x..%#x do not fit %#x bytes\n", name, lowest, highest, memory_size);
+		return false;
+	}
+	setup = ((highest - lowest) + 0xfff) & ~0xfffu;
+	/*
+	 * The header in memory below 4 GB (Android takes it from its CMA, alloc-ranges 0..4 GB; TrustZone refused a page of
+	 * the kernel's, above, with 0xffcfffbb): the loader's lowdma, 2 MB in (the sound has the first 64 KB, the Wi-Fi 4 MB on)
+	 */
+	{
+		uint64_t low = 0;
+
+		if (!PE_parse_boot_argn("lowdma", &low, sizeof(low)) || low == 0) {
+			printf("mpss: no lowdma= from the loader\n");
+			return false;
+		}
+		header_phys = low + 0x200000 + (pas == MPSS_PAS ? 0 : PAGE_SIZE);
+		page = ml_io_map_unmappable(header_phys, PAGE_SIZE, VM_WIMG_WCOMB);
+		io_zero(page, PAGE_SIZE);
+		io_copy(page, mdt, mdt_size);
+		__builtin_arm_dsb(0xf);
+	}
+	result = scm("to take the modem's header", SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, pas, header_phys, 0, &answer);
+	printf("mpss: %s: header (PAS %#x): %d, %#llx\n", name, pas, result, answer);
+	if (result != 0 || answer != 0) {
+		return false;
+	}
+	result = scm("where the modem's image will be", SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, pas, memory, setup, &answer);
+	printf("mpss: %s: place %#x, %#x bytes: %d, %#llx\n", name, memory, setup, result, answer);
+	if (result != 0 || answer != 0) {
+		return false;
+	}
+	map = ml_io_map_unmappable(memory, memory_size, VM_WIMG_WCOMB);
+	io_zero(map, ((highest - lowest) + 7) & ~7u);
+	for (uint32_t i = 0; i < count; i++) {
+		const struct elf_segment *g = (const struct elf_segment *)(mdt + phoff + 32 * i);
+		const uint8_t *data;
+		uint64_t size = 0;
+
+		if (g->type != 1 || MDT_HASH(g->flags) || g->file_size == 0) {
+			continue;
+		}
+		snprintf(file, sizeof(file), "%s.b%02u", name, i);
+		data = image_file(file, &size);
+		if (data == NULL || size < g->file_size) {
+			printf("mpss: %s: no %s (%llu of %u bytes)\n", name, file, size, g->file_size);
+			ml_io_unmap(map, memory_size);
+			return false;
+		}
+		io_copy(map + (g->paddr - lowest), data, g->file_size);
+	}
+	__builtin_arm_dsb(0xf);
+	ml_io_unmap(map, memory_size);
+	printf("mpss: %s: %u segments written (%#x bytes)\n", name, count, highest - lowest);
+	result = scm("to start the modem's image", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, pas, 0, 0, &answer);
+	printf("mpss: %s: authenticated and started (PAS %#x): %d, %#llx\n", name, pas, result, answer);
+	return result == 0 && answer == 0;
+}
+
+/* our SMP2P item for the modem (428, partition 0/1): made and filled in as step_our_item() does for the audio DSP */
+#define ITEM_SMP2P_MPSS_OURS    428
+static bool
+mpss_our_item(void)
+{
+	struct smp2p ours;
+	uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &psize), size = 0, item, name[4] = { 0 };
+
+	if (partition == 0) {
+		printf("mpss: no partition for us and the modem\n");
+		return false;
+	}
+	item = mpss_item(ITEM_SMP2P_MPSS_OURS, &size);
+	if (item == 0 && (!our_item_make_as(partition, ITEM_SMP2P_MPSS_OURS) || (item = mpss_item(ITEM_SMP2P_MPSS_OURS, &size)) == 0)) {
+		printf("mpss: our SMP2P item could not be made\n");
+		return false;
+	}
+	for (uint32_t at = 0; at < sizeof(ours); at += 4) {
+		smem_poke(item + at, 0);
+	}
+	settle();
+	smem_poke(item, SMP2P_MAGIC);
+	smem_poke(item + SMP2P_AT_PROCESSORS, SMEM_US | SMEM_MPSS << 16);
+	strlcpy((char *)name, OUR_ENTRY_STOP, sizeof(name));
+	for (uint32_t word = 0; word < 4; word++) {
+		smem_poke(item + SMP2P_AT_NAME(0) + 4 * word, name[word]);
+	}
+	smem_poke(item + SMP2P_AT_COUNTS, 16 | 1u << 16);
+	smem_poke(item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8);
+	settle();
+	smem_poke(item + SMP2P_AT_VERSION, SMP2P_RESTART_ACKS << 8 | SMP2P_VERSION);
+	settle();
+	need(&ipcc);
+	if (!option("dadampss_noipcc")) {       /* the modem's doorbells to us enabled: without them it never comes up (w125m..w129m; w130m READY in 1.7 s) */
+		wr(ipcc.base + IPCC_ENABLE, 2u << 16 | IPCC_SMP2P);
+		wr(ipcc.base + IPCC_ENABLE, 2u << 16 | IPCC_GLINK);
+	}
+	wr(ipcc.base + IPCC_SEND, 2u << 16 | IPCC_SMP2P);
+	printf("mpss: our SMP2P item (428) at %#lx, filled in; the modem's SMP2P doorbell rung\n", SMEM_PHYS + item);
+	return true;
+}
+
+/*
+ * ---- dadampss_link=1 (the default with dadampss=1): GLINK and QRTR with the modem --------------------
+ *
+ * The modem's edge (dt: qcom,glink/modem: qcom,remote-pid 1, transport smem, mboxes IPCC client 2 signal 0; channels
+ * "IPCRTR", qcom,intents 0x800 x5, 0x2000 x3, 0x4400 x2, as the audio DSP's, and "DS", which nobody here speaks) taken
+ * up as Linux's qcom_glink_smem_register() does once the modem has said READY: the descriptor (478) and our queue
+ * (479, 16 KB) ours to make if they are not there (in a run both were, before the modem started), the modem's queue
+ * (480) its own, waited for; our head and our read mark of its queue set to 0; then our version, and on the same
+ * GLINK code as the audio DSP's (glink_pump(), glink_send()), with an edge of its own. QRTR: the modem is node 0, we
+ * are node 1 (QRTR_US, as with the audio DSP). Its hello answered (and, if it says none, ours sent to everyone), and
+ * every service it tells of said: that is the proof that the two of us talk. Nothing is offered to it yet.
+ */
+#define QRTR_NODE_BCAST         0xffffffffu
+#define GLINK_FIFO_SIZE         16384           /* Linux: SZ_16K, qcom_glink_smem.c */
+
+static LCK_MTX_DECLARE(glink_mpss_lock, &adsp_lock_group);
+static struct glink_edge glink_mpss = {
+	.who = "mpss", .peer = "modem", .lock = &glink_mpss_lock, .host = SMEM_MPSS, .ipcc_client = IPCC_MPSS,
+	.channel = {
+		[CHANNEL_QRTR] = { .name = "IPCRTR", .ours = 1, .intents = { { 0x800, 5 }, { 0x2000, 3 }, { 0x4400, 2 } } },
+	},
+};
+static struct {
+	uint32_t in, out, hellos, lookups, said, services;
+	bool hello_sent;
+} mpss_qrtr;
+static volatile bool mpss_link_runs;
+
+/* an item of the partition with the modem: there, or made with so many bytes; 0: neither */
+static uint32_t
+mpss_item_or_make(uint32_t item, uint32_t bytes, uint32_t *size, bool *made)
+{
+	uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &psize), at;
+
+	*made = false;
+	if ((at = mpss_item(item, size)) != 0 || partition == 0) {
+		return at;
+	}
+	if (!our_item_alloc(partition, item, bytes)) {
+		return 0;
+	}
+	*made = true;
+	return mpss_item(item, size);
+}
+
+static bool
+mpss_glink_items(void)
+{
+	struct glink_edge *g = &glink_mpss;
+	uint32_t size = 0, wait_ms = 10000;
+	bool made = false;
+	uint64_t began;
+
+	g->descriptor = mpss_item_or_make(ITEM_GLINK_DESCRIPTOR, 32, &size, &made);
+	if (g->descriptor == 0 || size != 32) {
+		printf("mpss: glink: no descriptor (item %u at %#x, %u bytes)\n", ITEM_GLINK_DESCRIPTOR, g->descriptor, size);
+		return false;
+	}
+	if (made) {
+		for (uint32_t at = 0; at < 32; at += 4) {
+			smem_poke(g->descriptor + at, 0);
+		}
+		settle();
+	}
+	printf("mpss: glink: descriptor (%u) at %#lx, %s\n", ITEM_GLINK_DESCRIPTOR, SMEM_PHYS + g->descriptor, made ? "made" : "there");
+	g->ours = mpss_item_or_make(ITEM_GLINK_OUR_QUEUE, GLINK_FIFO_SIZE, &g->ours_size, &made);
+	if (g->ours == 0 || g->ours_size < 1024 || (g->ours_size & 7)) {
+		printf("mpss: glink: no queue of ours (item %u at %#x, %u bytes)\n", ITEM_GLINK_OUR_QUEUE, g->ours, g->ours_size);
+		return false;
+	}
+	printf("mpss: glink: our queue (%u) at %#lx, %u bytes, %s\n", ITEM_GLINK_OUR_QUEUE, SMEM_PHYS + g->ours, g->ours_size,
+	    made ? "made" : "there");
+	/* (Linux finds the remote's queue only when it is first read from; ours is no use before it is there) */
+	PE_parse_boot_argn("dadampss_link_wait", &wait_ms, sizeof(wait_ms));
+	began = now_us();
+	while ((g->theirs = mpss_item(ITEM_GLINK_THEIR_QUEUE, &g->theirs_size)) == 0 && now_us() - began < wait_ms * 1000ull) {
+		sleep_ms(10);
+	}
+	if (g->theirs == 0 || g->theirs_size < 1024 || (g->theirs_size & 7)) {
+		printf("mpss: glink: THE MODEM'S QUEUE (item %u) IS NOT THERE after %u ms (at %#x, %u bytes)\n", ITEM_GLINK_THEIR_QUEUE,
+		    (uint32_t)((now_us() - began) / 1000), g->theirs, g->theirs_size);
+		return false;
+	}
+	printf("mpss: glink: the modem's queue (%u) at %#lx, %u bytes, after %llu ms; marks: ours read to %#x written to %#x, "
+	    "the modem's read to %#x written to %#x\n", ITEM_GLINK_THEIR_QUEUE, SMEM_PHYS + g->theirs, g->theirs_size,
+	    (now_us() - began) / 1000, smem_word(g->descriptor + GLINK_OUR_TAIL), smem_word(g->descriptor + GLINK_OUR_HEAD),
+	    smem_word(g->descriptor + GLINK_THEIR_TAIL), smem_word(g->descriptor + GLINK_THEIR_HEAD));
+	/* Linux: "Reset the tx pipe's head and the rx pipe's tail" -- ours; the other two are the modem's */
+	smem_poke(g->descriptor + GLINK_OUR_HEAD, 0);
+	smem_poke(g->descriptor + GLINK_THEIR_TAIL, 0);
+	settle();
+	return true;
+}
+
+static int
+mpss_qrtr_out(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	int error = qrtr_send_on(&glink_mpss, type, from_port, to_node, to_port, data, length);
+
+	mpss_qrtr.out += error == 0;
+	return error;
+}
+
+static void
+mpss_qrtr_hello(uint32_t to_node)
+{
+	struct qrtr_control hello = { .command = QRTR_HELLO };
+	int error = mpss_qrtr_out(QRTR_HELLO, QRTR_CONTROL, to_node, QRTR_CONTROL, &hello, sizeof(hello));
+
+	mpss_qrtr.hello_sent = mpss_qrtr.hello_sent || error == 0;
+	printf("mpss: qrtr: our HELLO to node %#x: %s (%d)\n", to_node, error == 0 ? "SENT" : "NOT SENT", error);
+}
+
+static void
+mpss_qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct qrtr_header header;
+	struct qrtr_control control = { 0 };
+	uint32_t at;
+
+	if (!qrtr_parse("mpss", data, length, &header, &at)) {
+		return;
+	}
+	mpss_qrtr.in++;
+	if (header.type == QRTR_RESUME_TX) {
+		return;
+	}
+	if (header.confirm) {
+		struct qrtr_control resume = { .command = QRTR_RESUME_TX, .words = { header.to_node, header.to_port } };
+
+		mpss_qrtr_out(QRTR_RESUME_TX, header.to_port, header.from_node, header.from_port, &resume, sizeof(resume));
+	}
+	if (!(header.to_port == QRTR_CONTROL || header.type == QRTR_HELLO || header.type == QRTR_BYE ||
+	    header.type == QRTR_NEW_SERVER || header.type == QRTR_DEL_SERVER || header.type == QRTR_NEW_LOOKUP ||
+	    header.type == QRTR_DEL_CLIENT || header.type == QRTR_DEL_LOOKUP)) {
+		if (mpss_qrtr.said++ < 16) {
+			printf("mpss: qrtr: a datagram of %u bytes from node %u port %u to our port %u: nobody here listens there\n",
+			    header.size, header.from_node, header.from_port, header.to_port);
+		}
+		return;
+	}
+	memcpy(&control, data + at, header.size < sizeof(control) ? header.size : sizeof(control));
+	switch (control.command) {
+	case QRTR_HELLO:
+		printf("mpss: qrtr: HELLO FROM NODE %u (port %#x)\n", header.from_node, header.from_port);
+		/* answered once (the audio DSP's is too): the modem's name server answers a hello with its services */
+		if (mpss_qrtr.hellos++ == 0) {
+			mpss_qrtr_hello(header.from_node);
+		}
+		break;
+	case QRTR_NEW_SERVER:
+		mpss_qrtr.services++;
+		printf("mpss: qrtr: modem service %u (%#x) instance %u (version %u, instance %u) at node %u port %u\n", control.words[0],
+		    control.words[0], control.words[1], control.words[1] & 0xff, control.words[1] >> 8, control.words[2],
+		    control.words[3]);
+		break;
+	case QRTR_DEL_SERVER:
+		printf("mpss: qrtr: modem service %u instance %u at node %u port %u has gone\n", control.words[0], control.words[1],
+		    control.words[2], control.words[3]);
+		break;
+	case QRTR_NEW_LOOKUP:
+		if (mpss_qrtr.lookups++ < 32) {
+			printf("mpss: qrtr: the modem looks for service %u (%#x), instance %u: nobody here offers it\n", control.words[0],
+			    control.words[0], control.words[1]);
+		}
+		break;
+	case QRTR_DEL_CLIENT:
+		printf("mpss: qrtr: the modem's client at node %u port %u has gone\n", control.words[0], control.words[1]);
+		break;
+	case QRTR_BYE:
+		printf("mpss: qrtr: BYE from node %u\n", header.from_node);
+		break;
+	default:
+		break;
+	}
+}
+
+/* the modem's link: every millisecond its rings heard, its queue pumped, what came on IPCRTR acted on */
+static void
+mpss_link_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct glink_edge *g = &glink_mpss;
+	struct glink_packet *packet;
+	uint64_t began = now_us(), opened_at = 0, looked = 0;
+	uint32_t smp2p_at = 0, size = 0;
+	bool fatal = false;
+
+	while (mpss_link_runs) {
+		sleep_us(1000);
+		doorbells();
+		/* its "slave-kernel", every tenth of a second: a modem that gives up says so here, and why */
+		if (!fatal && now_us() - looked >= 100000) {
+			struct smp2p words;
+			int e;
+
+			looked = now_us();
+			if (smp2p_at == 0) {
+				smp2p_at = mpss_item(ITEM_SMP2P_MPSS, &size);
+			}
+			if (smp2p_at != 0 && smem_peek(smp2p_at, &words, sizeof(words)) && words.magic == SMP2P_MAGIC &&
+			    (e = smp2p_entry(&words, "slave-kernel")) >= 0 && (words.entry[e].value & DSP_FATAL)) {
+				uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+				char reason[160] = { 0 };
+
+				fatal = true;
+				if (cat != 0) {
+					(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+				}
+				printf("mpss: link: THE MODEM SAYS IT HAS GIVEN UP (\"slave-kernel\" = %#x): %s\n", words.entry[e].value,
+				    reason[0] ? reason : "(no reason)");
+			}
+		}
+		lck_mtx_lock(g->lock);
+		glink_pump(g);
+		{
+			struct glink_channel *channel = &g->channel[CHANNEL_QRTR];
+
+			/*
+			 * The modem opens IPCRTR itself, as the audio DSP does; if it has not two seconds after the versions
+			 * are agreed, it is opened from our side (Linux's qcom_glink_create_local(): the modem acknowledges
+			 * and opens its end, which glink_pump() answers as any open)
+			 */
+			if (g->agreed && !channel->asked && channel->theirs == 0 && now_us() - began > 2000000ull) {
+				char name[8] = "IPCRTR";
+
+				printf("mpss: glink: the modem has not opened \"IPCRTR\": opened from our side as channel %u\n", channel->ours);
+				glink_say(g, GLINK_OPEN, channel->ours, (uint32_t)strlen(name) + 1, name, sizeof(name));
+				channel->asked = true;
+			}
+			if (channel->open && opened_at == 0) {
+				opened_at = now_us();
+			}
+			packet = channel->first;
+			channel->first = channel->last = NULL;
+		}
+		lck_mtx_unlock(g->lock);
+		while (packet != NULL) {
+			struct glink_packet *next = packet->next;
+
+			mpss_qrtr_input(packet->data, packet->length);
+			kfree_data(packet, sizeof(*packet) + packet->length);
+			packet = next;
+		}
+		/* no hello from the modem a second after the channel opened: ours, to everyone (Linux's name server's say_hello()) */
+		if (opened_at != 0 && !mpss_qrtr.hello_sent && mpss_qrtr.hellos == 0 && now_us() - opened_at > 1000000ull) {
+			mpss_qrtr_hello(QRTR_NODE_BCAST);
+			if (!mpss_qrtr.hello_sent) {
+				opened_at = now_us();           /* (again in a second) */
+			}
+		}
+	}
+	thread_terminate(current_thread());
+}
+
+/* after READY: the edge, our version, the link's thread; then what came of it, said */
+static void
+mpss_link(void)
+{
+	struct glink_edge *g = &glink_mpss;
+	thread_t thread;
+	uint64_t began;
+	uint32_t listen_s = 10;
+
+	if (!mpss_glink_items()) {
+		printf("mpss: link: NO GLINK WITH THE MODEM (its items)\n");
+		return;
+	}
+	lck_mtx_lock(g->lock);
+	g->features = GLINK_INTENT_REUSE;
+	g->agreed = g->broken = false;
+	g->said = g->heard = 0;
+	bzero(g->others, sizeof(g->others));
+	g->trace = 60;
+	g->up = true;
+	bzero(&mpss_qrtr, sizeof(mpss_qrtr));
+	began = now_us();
+	glink_say(g, GLINK_VERSION, GLINK_VERSION_1, g->features, NULL, 0);
+	lck_mtx_unlock(g->lock);
+	mpss_link_runs = true;
+	if (kernel_thread_start(mpss_link_thread, NULL, &thread) != KERN_SUCCESS) {
+		mpss_link_runs = false;
+		printf("mpss: link: no thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+	for (unsigned ms = 0; ms < 5000 && !g->channel[CHANNEL_QRTR].open && !g->broken; ms++) {
+		sleep_ms(1);
+	}
+	printf("mpss: link: %llu ms after our version: versions %s (features %#x); \"IPCRTR\" is %s; the modem also opened \"%s\" "
+	    "\"%s\" \"%s\" \"%s\"\n", (now_us() - began) / 1000, g->agreed ? "agreed" : "NOT AGREED", g->features,
+	    g->channel[CHANNEL_QRTR].open ? "OPEN" : "NOT OPEN", g->others[0], g->others[1], g->others[2], g->others[3]);
+	PE_parse_boot_argn("dadampss_listen", &listen_s, sizeof(listen_s));
+	sleep_ms(listen_s * 1000);
+	printf("mpss: link: after %u s more: %s; the modem told of %u services and looked for %u; GLINK said %u and heard %u "
+	    "messages, QRTR sent %u and received %u datagrams; its doorbells heard: %u\n", listen_s,
+	    mpss_qrtr.hellos ? "HELLO FROM THE MODEM" : (mpss_qrtr.hello_sent ? "OUR HELLO SENT, NONE FROM THE MODEM" :
+	    "NO HELLO EITHER WAY"), mpss_qrtr.services, mpss_qrtr.lookups, g->said, g->heard, mpss_qrtr.out, mpss_qrtr.in,
+	    mpss_rings);
+	/* (the link stays up: its thread runs on, and services the modem tells of later are said as they come) */
+}
+
+
+static void
+mpss_thread_body(void);
+
+static void
+mpss_thread(void *arg __unused, wait_result_t w __unused)
+{
+	mpss_thread_body();
+	if (hakios_mpss_state == 0) {
+		hakios_mpss_state = -1;
+	}
+}
+
+static void
+mpss_thread_body(void)
+{
+	uint32_t wait_s = 50, assign = 1, last = ~0u, at = 0, size = 0, wait_ready = 60, cx_level = 384;
+	uint64_t began;
+
+	PE_parse_boot_argn("dadampss_delay", &wait_s, sizeof(wait_s));
+	PE_parse_boot_argn("dadampss_assign", &assign, sizeof(assign));
+	sleep_ms(wait_s * 1000);
+	printf("mpss: the modem: booting it\n");
+	if (mpss_item(ITEM_SMP2P_MPSS, &size) != 0) {
+		printf("mpss: its SMP2P item is already there: it ran before this kernel; not started again\n");
+		return;
+	}
+	if (assign) {
+		(void)mpss_assign(0x84a00000ull, 0x4900000ull);
+		(void)mpss_assign(0x89300000ull, 0xa80000ull);
+	}
+	{
+		/* its path to DDR (Android's rproc_ddr / crypto_ddr icc votes): MC0, SH0, ACV, as the Wi-Fi's (dadampss_icc=N) */
+		uint32_t icc = 0x1000, bw, on = 1u << 30 | 1u << 29 | 1u << 14 | 1u;
+
+		PE_parse_boot_argn("dadampss_icc", &icc, sizeof(icc));
+		if (icc != 0) {
+			bw = 1u << 30 | 1u << 29 | (icc & 0x3fff) << 14 | (icc & 0x3fff);
+			printf("mpss: path to memory: MC0 %s, SH0 %s, ACV %s\n", hakios_rpmh_write("MC0", bw) ? "voted" : "NOT VOTED",
+			    hakios_rpmh_write("SH0", bw) ? "voted" : "NOT VOTED", hakios_rpmh_write("ACV", on) ? "on" : "NOT ON");
+		}
+	}
+	PE_parse_boot_argn("dadampss_cx", &cx_level, sizeof(cx_level));
+	printf("mpss: CX at %u %s, MSS %s\n", cx_level, hakios_rpmh_level("cx.lvl", cx_level) ? "voted" : "NOT VOTED",
+	    hakios_rpmh_level("mss.lvl", 320) ? "voted" : "NOT VOTED");
+	{
+		/*
+		 * The rails and clocks the Wi-Fi's link_up() votes (RF S-rails s5f/s3g/s7i, the BB rail s4d, L3F/L2F, RF_CLK1 and
+		 * LN_BB_CLK): the modem came up every time they were voted before it (the Wi-Fi thread at ~40 s, w130m/w132m/w142m)
+		 * and never once the Wi-Fi waited for the modem instead (w140m..w144m). dadampss_rails=0: not.
+		 */
+		static const struct { const char *name; uint32_t mv, mode; } rails[] = {
+			{ "ldof3", 1800, 7 }, { "ldof2", 1200, 7 }, { "smpd4", 876, 0 }, { "smpf5", 876, 0 }, { "smpg3", 1860, 0 },
+			{ "smpi7", 1312, 0 }, { "clka1", 0, 0 }, { "clka3", 0, 0 },
+		};
+		uint32_t on = 1;
+
+		PE_parse_boot_argn("dadampss_rails", &on, sizeof(on));
+		for (unsigned i = 0; on && i < sizeof(rails) / sizeof(rails[0]); i++) {
+			if (!hakios_rpmh_regulator(rails[i].name, rails[i].mv, true, rails[i].mode)) {
+				printf("mpss: %s NOT VOTED\n", rails[i].name);
+			}
+		}
+	}
+	printf("mpss: AOP: %s\n", mailbox_send("{class: image, res: load_state, name: modem, val: on}") ? "told" : "NOT TOLD");
+	(void)mpss_our_item();
+	if ((!option("dadampss_nodtb") && !mpss_image("modem_dtb", MPSS_DTB_PAS, MPSS_DTB_MEM, MPSS_DTB_MEM_SIZE) &&
+	    !option("dadampss_dtbany")) ||
+	    !mpss_image("modem", MPSS_PAS, MPSS_MEM, MPSS_MEM_SIZE)) {
+		printf("mpss: THE MODEM WAS NOT STARTED\n");
+		return;
+	}
+	began = now_us();
+	PE_parse_boot_argn("dadampss_wait", &wait_ready, sizeof(wait_ready));
+	while (now_us() - began < (uint64_t)wait_ready * 1000000ull) {
+		struct smp2p words;
+		uint32_t state = 0;
+
+		if (at == 0) {
+			at = mpss_item(ITEM_SMP2P_MPSS, &size);
+		}
+		if (at != 0 && smem_peek(at, &words, sizeof(words)) && words.magic == SMP2P_MAGIC) {
+			int e = smp2p_entry(&words, "slave-kernel");
+
+			state = e < 0 ? 0 : words.entry[e].value;
+		}
+		{
+			static uint32_t last_ring = ~0u;
+			uint32_t ring;
+
+			need(&ipcc);
+			ring = rd(ipcc.base + IPCC_RECEIVED);
+			if (ring != last_ring) {
+				printf("mpss: after %llu ms: IPCC's next doorbell for us: %#x (client %u, signal %u)\n", (now_us() - began) / 1000,
+				    ring, ring >> 16, ring & 0xffff);
+				last_ring = ring;
+			}
+		}
+		if (state != last) {
+			printf("mpss: after %llu ms: its SMP2P item %s, state %#x%s%s%s\n", (now_us() - began) / 1000, at ? "there" : "not there",
+			    state, (state & 2) ? " READY" : "", (state & 4) ? " HANDOVER" : "", (state & 1) ? " FATAL" : "");
+			last = state;
+		}
+		if (state & 1) {
+			uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+			char reason[160] = { 0 };
+
+			if (cat != 0) {
+				(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+			}
+			printf("mpss: THE MODEM FAILED: %s\n", reason[0] ? reason : "(no reason)");
+			return;
+		}
+		if (state & 2) {
+			uint32_t link = 1;
+
+			printf("mpss: THE MODEM IS UP\n");
+			hakios_mpss_state = 1;
+			PE_parse_boot_argn("dadampss_link", &link, sizeof(link));
+			if (link) {
+				mpss_link();
+			}
+			return;
+		}
+		sleep_ms(20);
+	}
+	printf("mpss: no READY from the modem in %u s\n", wait_ready);
+	{
+		static struct smem_item found[256];
+		uint32_t cacheline = 0, psize = 0, partition = smem_partition(SMEM_US, SMEM_MPSS, &cacheline, &psize);
+		unsigned count = partition ? smem_items(partition, cacheline, found, 256) : 0;
+		char line[400];
+		int n = 0;
+
+		for (unsigned i = 0; i < count && i < 256 && n < (int)sizeof(line) - 16; i++) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)", found[i].item, found[i].size);
+		}
+		printf("mpss: the partition for us and the modem: at %#x, %#x bytes, %u items:%s\n", partition, psize, count, line);
+	}
+	{
+		uint32_t csize = 0, cat = mpss_item(ITEM_MPSS_CRASH, &csize);
+		char reason[200] = { 0 };
+
+		if (cat != 0) {
+			(void)smem_peek(cat, reason, MIN(csize, sizeof(reason) - 1));
+		}
+		printf("mpss: crash reason (item 421): %s\n", cat ? (reason[0] ? reason : "(empty)") : "(no item)");
+	}
+}
+
+void
+redwood_adsp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("adsp_step", &last_step, sizeof(last_step));
+	if (last_step == 0 && (!PE_parse_boot_argn("adsp", &on, sizeof(on)) || on != 1)) {
+		return;
+	}
+	if (option("dadaadsp")) {
+		dada = true;
+		smem_phys = 0x81d00000UL;
+		cmd_db_phys = 0x81c60000UL;
+		adsp_memory = 0x9ee00000u;
+		adsp_memory_size = 0x04580000u;
+		ipcc.phys = 0x00406000;
+		rsc.phys = 0x16520000;
+		glink.channel[CHANNEL_APR].name = "adsp_apps";     /* GPR, AudioReach's */
+		printf("adsp: the Xiaomi 15's (dada) audio DSP: its addresses and its companion image (dadaadsp=1)\n");
+	} else if (pe_arm_get_soc_base_phys() != REDWOOD_SOC_BASE) {
+		printf("adsp: adsp=1 and adsp_step=N are for the phone's audio DSP, and this is not the phone\n");
+		return;
+	}
+	if (last_step == 0) {
+		/* all of it, on a thread of its own, and left up (on dada not step 11: SM8750's audio services are
+		 * GPR's, not APR's, and the battery manager needs only the link) */
+		last_step = STEPS;
+		keep = true;
+		quiet = !dada;           /* (dada: every step said, while it is new) */
+		pause_ms = 0;
+		listen_seconds = 1;
+		new_from = STEPS + 1;
+		if (kernel_thread_start(whole_thread, NULL, &thread) != KERN_SUCCESS) {
+			printf("adsp: no thread: the audio DSP is not brought up\n");
+			return;
+		}
+		thread_deallocate(thread);
+		if (dada && option("dadampss") && kernel_thread_start(mpss_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+		tell("adsp: the audio DSP is being brought up beside the system's start (adsp=1)\n");
+		return;
+	}
+	if (last_step > STEPS) {
+		last_step = STEPS;
+	}
+	keep = option("adsp_keep");
+	new_from = last_step;
+	PE_parse_boot_argn("adsp_new", &new_from, sizeof(new_from));
+	PE_parse_boot_argn("adsp_pause", &pause_ms, sizeof(pause_ms));
+	printf("adsp: steps up to %u; those from %u on are new and wait %u ms after each announcement\n", last_step, new_from,
+	    pause_ms);
+	run_steps();
+	if (option("adsp_return")) {
+		printf("adsp: back to the loader (adsp_return)\n");
+		loader_return();
+	}
+	printf("adsp: the system goes on starting\n");
+}
diff --git a/bsd/dev/redwood_apfs_check.c b/bsd/dev/redwood_apfs_check.c
new file mode 100644
index 0000000..b89d61a
--- /dev/null
+++ b/bsd/dev/redwood_apfs_check.c
@@ -0,0 +1,1872 @@
+/*
+ * Mount the APFS volume on /dev/rvblk0 and walk it through VFS, so that what the driver
+ * does can be compared with what tools/apfs/apfs.py reads from the same image on the
+ * build machine.  Only with boot-arg apfs_check.
+ *
+ *   apfs_check=1              walk the whole volume and print only the totals
+ *   apfs_check=2              also print a line per entry
+ *   apfs_check=3              mount it and stop, leaving it for user space to read
+ *                             (userland/src/apfs_mmap_test.c, which is the only way the
+ *                             driver's vnop_pagein ever runs)
+ *   apfs_check=4              mount nothing: walk the root filesystem, which is what the
+ *                             root already is when the volume was handed to the kernel as
+ *                             its root device.  This is how the phone is reached: it has
+ *                             no driver for its own storage and no virtio, so the only
+ *                             block device there is a RAM disk, and a RAM disk given to
+ *                             the kernel as the root is mounted by vfs_mountroot.
+ *   apfs_check=5              several threads walk the root filesystem at once, each over
+ *                             the whole of it, to see what the one lock round apfs_lib
+ *                             costs when there is more than one reader
+ *   apfs_threads=N            how many, for mode 5 (default 4)
+ *   apfs_check=6              mount apfs_dev on apfs_mnt, walk it on this thread and go
+ *                             back to the loader.  For a volume that is not the root and
+ *                             where there is no user space to make a mount point: the
+ *                             point is a directory of the root image itself.
+ *   apfs_dev=md1              the device to mount for modes 1 to 3 and 6 (default rvblk0)
+ *   apfs_mnt=/lib             where to mount it for mode 6 (default /private/var/apfs-check)
+ *   apfs_depth=N              go no deeper than N levels below where the walk starts
+ *                             (1 = only the entries of that directory; 0 = no limit).
+ *                             For splitting a volume too big to hold into parts: one part
+ *                             takes the root's own entries, the others take a subtree
+ *                             each, and the per-line hashes add up to the whole.
+ *   apfs_max=N                stop after N entries (and say how memory stood on the way):
+ *                             for finding out what a walk that never comes back runs into
+ *   apfs_skip=/a,/b           directories not to go into, as paths inside the volume,
+ *                             comma separated.  Their own line is still counted, only
+ *                             their contents are left out -- which is how a volume too
+ *                             big to hold is cut into parts that between them cover it
+ *                             exactly once.
+ *   apfs_subtree=/usr         walk only that part of the volume
+ *   apfs_check=7              the one mode that writes: replace bytes inside a file of the
+ *                             container on apfs_dev where they lie, with the kernel's own
+ *                             bsd/miscfs/apfs/apfs_write.c, and read them back out of a
+ *                             container opened again from nothing (apfs_write_check below)
+ *   apfs_check=8              the store of fixed-length slot files on apfs_dev: save a payload
+ *                             into it and read it back out of a container opened again from
+ *                             nothing (apfs_store_check below)
+ *
+ * A line is the same one tools/apfs/apfs-tool's census and `verify.py clines` print:
+ *
+ *   path <TAB> d_type <TAB> mode <TAB> uid <TAB> gid <TAB> size <TAB> hash-of-contents
+ *
+ * The whole volume is 318098 entries, and printing them all through the kernel log would
+ * be 47 MB down a serial line, so by default each line is folded into a sum instead: the
+ * lines are hashed one at a time and the hashes added together.  Addition does not care
+ * what order the entries came in, which matters because this walk and the one on the host
+ * need not visit a directory's entries in the same order.  The host adds up the same
+ * hashes over its own lines; if the two sums and counts agree, every path, kind, mode,
+ * owner, group, size and byte of content agreed.  When they do not, apfs_check=2 over a
+ * subtree gives lines to diff.
+ *
+ * Everything here goes through VFS -- vnode_lookup, vnode_getattr, VNOP_READDIR,
+ * VNOP_READLINK, vn_rdwr -- so it exercises the vnode operations and not just the format
+ * reading underneath them.
+ */
+
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <sys/dirent.h>
+#include <sys/errno.h>
+#include <sys/kauth.h>
+#include <sys/param.h>
+#include <sys/mount.h>
+#include <sys/mount_internal.h>
+#include <sys/namei.h>
+#include <sys/proc.h>
+#include <sys/stat.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <sys/uio_internal.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/vnode_internal.h>
+#include <sys/redwood_input.h>
+#include <sys/sysctl.h>
+#include <pexpert/pexpert.h>
+#include <libkern/OSAtomic.h>
+#include <sys/redwood_apfs_check.h>
+#include <miscfs/apfs/apfs_lib.h>
+#include <miscfs/apfs/apfs_write.h>
+#include <miscfs/apfs/apfs_store.h>
+#include <sys/disk.h>
+#include <sys/buf.h>
+#include <sys/fcntl.h>
+
+extern void loader_return(void);        /* osfmk/arm64/loader_return.c */
+extern void apfs_stats_print(void);     /* bsd/miscfs/apfs/apfs_vfsops.c */
+extern void redwood_sparse_report(void);
+
+/* how memory stands, for the progress line (osfmk/vm, bsd/vfs) */
+extern unsigned int vm_page_free_count, vm_page_wire_count, memorystatus_available_pages;
+extern long numvnodes;
+extern int desiredvnodes;
+#define CHECK_MB(pages) ((unsigned int)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+
+/* which operation the walk is in, for the stuck detector further down */
+static const char *volatile watch_phase = "";
+#define PHASE(name) (watch_phase = (name))
+
+#define CHECK_MNT    "/private/var/apfs-check"
+#define CHECK_PARENT "/private/var"
+#define CHECK_LEAF   "apfs-check"
+#define CHECK_DEV    "/dev/rvblk0"
+
+#define FNV_INIT  0xcbf29ce484222325ULL
+#define FNV_PRIME 0x100000001b3ULL
+
+/*
+ * How much each read asks for: 64 KB, one compressed piece, unless boot-arg apfs_chunk says
+ * otherwise (up to 4 MB) -- a bigger read is one request whose pieces the driver can
+ * decompress on several processors at once.
+ */
+static uint32_t
+read_chunk(void)
+{
+	static uint32_t chunk;
+
+	if (chunk == 0) {
+		uint32_t want = 64 * 1024;
+
+		PE_parse_boot_argn("apfs_chunk", &want, sizeof(want));
+		if (want < 4096 || want > 4 * 1024 * 1024) {
+			want = 64 * 1024;
+		}
+		chunk = want;
+	}
+	return chunk;
+}
+#define READ_CHUNK read_chunk()
+#define DIR_CHUNK  4096
+#define MAX_DEPTH  48
+#define PATH_CAP   2048
+
+static uint64_t
+fnv1a(const uint8_t *p, size_t n, uint64_t h)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++) {
+		h ^= p[i];
+		h *= FNV_PRIME;
+	}
+	return h;
+}
+
+struct census {
+	vfs_context_t ctx;
+	char     *path;                 /* the whole path, starting with CHECK_MNT */
+	size_t    rel;                  /* where the part inside the volume starts */
+	size_t    len;
+	uint8_t  *buf;                  /* for reading file contents */
+	uint64_t  sum;                  /* the per-line hashes, added up */
+	uint64_t  entries, dirs, files, links, others, bytes;
+	uint32_t  errors;
+	bool      print_lines;
+	int       depth;
+	/*
+	 * The volume being walked.  Walking the root means walking over the mount points of
+	 * other filesystems -- devfs on /dev above all -- and their contents are not this
+	 * volume's, so anything that turns out to live on another mount is passed over.
+	 */
+	mount_t   mp;
+	/*
+	 * NOCROSSMOUNT when the volume being walked is the root: a lookup then gives the
+	 * directory this volume has under a mount point rather than the root of whatever is
+	 * mounted on it, so /dev is counted as the (empty) directory it is here instead of
+	 * being either skipped or walked as devfs.  Not set when the volume is reached
+	 * through a path that itself crosses into it.
+	 */
+	int       lookup_flags;
+	uint32_t  max_depth;            /* 0: no limit */
+	char     *skip;                 /* comma separated paths not to descend into */
+	uint64_t  max_entries;          /* 0: no limit */
+	bool      stop;
+	uint64_t  t0;                   /* when the walk started, for the progress line */
+	/*
+	 * FNV-1a goes a byte at a time, each step waiting on the one before: about three
+	 * cycles a byte, more than a second over the restore ramdisk -- the checker's own
+	 * time, not the filesystem's.  Boot-arg apfs_hash=0 reads every byte all the same and
+	 * does not hash it (the sums are then not the ones to compare); hash_ticks is how
+	 * long the hashing took otherwise.
+	 */
+	bool      no_hash;
+	uint64_t  hash_ticks;
+	/*
+	 * Boot-arg apfs_contents=0: no file is read at all, only looked up and stat'ed --
+	 * how long the walk itself takes, the directories and the inodes.
+	 */
+	bool      no_contents;
+	/* apfs_walkers=N: one of N walkers; a subdirectory is left on the shared stack (par_push) */
+	bool      par;
+	/* where a walker's time goes (mach ticks): lookups, getattr, reading files and links
+	 * (hashing included), readdir, waiting for a directory to walk (par); on a processor */
+	uint64_t  t_lookup, t_attr, t_read, t_readdir, t_idle, t_cpu, t_wall;
+};
+
+/* The boot-args both kinds of walk take the same way. */
+static void
+census_options(struct census *cs)
+{
+	uint32_t hash = 1, contents = 1;
+
+	PE_parse_boot_argn("apfs_hash", &hash, sizeof(hash));
+	PE_parse_boot_argn("apfs_contents", &contents, sizeof(contents));
+	cs->no_hash = (hash == 0);
+	cs->no_contents = (contents == 0);
+}
+
+/* The format bits of a mode, which vnode_getattr does not report in va_mode. */
+static uint16_t
+ifmt_of(enum vtype t)
+{
+	switch (t) {
+	case VREG:  return S_IFREG;
+	case VDIR:  return S_IFDIR;
+	case VLNK:  return S_IFLNK;
+	case VCHR:  return S_IFCHR;
+	case VBLK:  return S_IFBLK;
+	case VFIFO: return S_IFIFO;
+	case VSOCK: return S_IFSOCK;
+	default:    return 0;
+	}
+}
+
+/* FNV-1a over a regular file's contents, read through VNOP_READ. */
+static int
+hash_file(struct census *cs, vnode_t vp, uint64_t size, uint64_t *out)
+{
+	uint64_t h = FNV_INIT, off = 0;
+
+	while (off < size) {
+		int want = (int)((size - off > READ_CHUNK) ? READ_CHUNK : (size - off));
+		int resid = 0;
+		int error = vn_rdwr(UIO_READ, vp, (caddr_t)cs->buf, want, (off_t)off,
+		    UIO_SYSSPACE, IO_NOCACHE, vfs_context_ucred(cs->ctx), &resid,
+		    vfs_context_proc(cs->ctx));
+
+		if (error) {
+			return error;
+		}
+		if (resid == want) {
+			break;                  /* nothing more to be had */
+		}
+		if (!cs->no_hash) {
+			uint64_t t0 = mach_absolute_time();
+
+			h = fnv1a(cs->buf, (size_t)(want - resid), h);
+			cs->hash_ticks += mach_absolute_time() - t0;
+		}
+		cs->bytes += (uint64_t)(want - resid);
+		off += (uint64_t)(want - resid);
+	}
+	*out = h;
+	return 0;
+}
+
+/* FNV-1a over a symbolic link's target, read through VNOP_READLINK. */
+static int
+hash_link(struct census *cs, vnode_t vp, uint64_t *out)
+{
+	uio_t uio;
+	char uio_buf[UIO_SIZEOF(1)];
+	int error;
+	size_t n;
+
+	uio = uio_createwithbuffer(1, 0, UIO_SYSSPACE, UIO_READ, uio_buf, sizeof(uio_buf));
+	if (uio == NULL) {
+		return ENOMEM;
+	}
+	uio_addiov(uio, CAST_USER_ADDR_T(cs->buf), MAXPATHLEN);
+	error = VNOP_READLINK(vp, uio, cs->ctx);
+	if (error) {
+		return error;
+	}
+	n = MAXPATHLEN - (size_t)uio_resid(uio);
+	cs->bytes += n;
+	*out = fnv1a(cs->buf, n, FNV_INIT);
+	return 0;
+}
+
+static bool
+census_entry(struct census *cs, uint8_t d_type)
+{
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	uint64_t h = 0, size = 0;
+	uint16_t mode = 0;
+	char line[PATH_CAP + 128];
+	int error;
+	int n;
+
+	/*
+	 * Do not follow a symbolic link: the point is to look at the link itself, as the host
+	 * reader does.  Following them would report the target's kind, size and contents
+	 * instead, and a link whose target is missing -- of which this volume has several --
+	 * would look like a lookup failure.  Crossing mount points has to stay allowed: the
+	 * path leads from the ramfs that holds the mount point into the volume itself.
+	 */
+	PHASE("lookup");
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_lookup(cs->path, cs->lookup_flags, &vp, cs->ctx);
+		cs->t_lookup += mach_absolute_time() - t0;
+	}
+	if (error) {
+		printf("apfs-check: %s: lookup failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		return false;
+	}
+	if (cs->mp != NULL && vnode_mount(vp) != cs->mp) {
+		vnode_put(vp);          /* another filesystem is mounted here */
+		return false;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	VATTR_WANTED(&va, va_data_size);
+	PHASE("getattr");
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_getattr(vp, &va, cs->ctx);
+		cs->t_attr += mach_absolute_time() - t0;
+	}
+	if (error) {
+		printf("apfs-check: %s: getattr failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		goto out;
+	}
+	mode = (uint16_t)(ifmt_of(vnode_vtype(vp)) | (VATTR_IS_SUPPORTED(&va, va_mode)
+	    ? (va.va_mode & 07777) : 0));
+	size = VATTR_IS_SUPPORTED(&va, va_data_size) ? va.va_data_size : 0;
+
+	if (vnode_vtype(vp) == VREG) {
+		cs->files++;
+		PHASE("read");
+		if (!cs->no_contents) {
+			uint64_t t0 = mach_absolute_time();
+
+			error = hash_file(cs, vp, size, &h);
+			cs->t_read += mach_absolute_time() - t0;
+		}
+	} else if (vnode_vtype(vp) == VLNK) {
+		cs->links++;
+		PHASE("readlink");
+		if (!cs->no_contents) {
+			uint64_t t0 = mach_absolute_time();
+
+			error = hash_link(cs, vp, &h);
+			cs->t_read += mach_absolute_time() - t0;
+		}
+	} else if (vnode_vtype(vp) == VDIR) {
+		cs->dirs++;
+	} else {
+		cs->others++;
+	}
+	if (error) {
+		printf("apfs-check: %s: reading it failed: %d\n", cs->path + cs->rel, error);
+		cs->errors++;
+		goto out;
+	}
+
+	n = scnprintf(line, sizeof(line), "%s\t%u\t%06o\t%u\t%u\t%llu\t%016llx\n",
+	    cs->path + cs->rel, d_type, mode,
+	    VATTR_IS_SUPPORTED(&va, va_uid) ? va.va_uid : 0,
+	    VATTR_IS_SUPPORTED(&va, va_gid) ? va.va_gid : 0,
+	    (unsigned long long)size, (unsigned long long)h);
+	cs->sum += fnv1a((const uint8_t *)line, (size_t)n, FNV_INIT);
+	cs->entries++;
+	if (cs->print_lines) {
+		printf("apfs-line: %s", line);
+	}
+	if ((cs->entries % 10000) == 0) {
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(mach_absolute_time() - cs->t0, &ns);
+		printf("apfs-check: %llu entries so far at %llu ms  free %u MB  wired %u MB  "
+		    "available %u MB  vnodes %ld of %d\n", cs->entries, ns / 1000000,
+		    CHECK_MB(vm_page_free_count),
+		    CHECK_MB(vm_page_wire_count), CHECK_MB(memorystatus_available_pages),
+		    numvnodes, desiredvnodes);
+	}
+	if (cs->max_entries != 0 && cs->entries >= cs->max_entries) {
+		cs->stop = true;
+	}
+out:
+	PHASE("vnode_put");
+	vnode_put(vp);
+	PHASE("");
+	return error == 0;
+}
+
+static void census_dir(struct census *cs);
+static void par_push(const char *path, size_t len, int depth);
+
+/* the walkers of a parallel walk, for the watch's count of progress */
+#define PAR_MAX 16
+static struct census *volatile par_cs[PAR_MAX];
+static volatile uint32_t par_n;
+
+/*
+ * A walk that stops making progress, rather than one that fails.  On the phone a walk of
+ * the real volume can stop dead past some tens of thousands of entries, and then nothing
+ * is left to say why: the watchdog resets the phone and the log goes with it.  So a timer
+ * looks every few seconds; if the count of entries has not moved, it says which entry and
+ * which operation the walk is in, and goes back to the loader -- with the log -- before
+ * the watchdog does.
+ */
+#define WATCH_SECONDS 6
+
+static struct census *volatile watch_cs;
+static uint64_t watch_last = ~0ULL;
+static thread_call_t watch_call;
+
+static void
+watch_tick(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	struct census *cs = watch_cs;
+	uint64_t deadline, progress;
+
+	if (cs == NULL) {
+		return;                 /* the walk is over */
+	}
+	/* entries and bytes both count as progress: one big file can take a while */
+	progress = cs->entries + cs->bytes;
+	for (uint32_t i = 0; i < par_n; i++) {
+		if (par_cs[i] != NULL) {
+			progress += par_cs[i]->entries + par_cs[i]->bytes;
+		}
+	}
+	if (progress == watch_last) {
+		printf("apfs-check: STUCK: no progress for %d s after entry %llu, at %s, in %s\n",
+		    WATCH_SECONDS, cs->entries, cs->path + cs->rel, watch_phase);
+		apfs_stats_print();
+		redwood_sparse_report();
+		printf("apfs-check: going back to the loader with that\n");
+		loader_return();
+		return;
+	}
+	/* a sign the timer got to run at all: a walk can starve every thread call */
+	printf("apfs-check: tick, %llu entries\n", cs->entries);
+	watch_last = progress;
+	clock_interval_to_deadline(WATCH_SECONDS, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(watch_call, deadline);
+}
+
+static void
+watch_start(struct census *cs)
+{
+	uint64_t deadline;
+
+	if (watch_call == NULL) {
+		watch_call = thread_call_allocate(watch_tick, NULL);
+	}
+	watch_last = ~0ULL;
+	watch_cs = cs;
+	clock_interval_to_deadline(WATCH_SECONDS, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(watch_call, deadline);
+}
+
+static void
+watch_stop(void)
+{
+	watch_cs = NULL;
+	if (watch_call != NULL) {
+		thread_call_cancel(watch_call);
+	}
+}
+
+/* Is this directory one of the ones to stay out of?  Compares the path inside the volume. */
+static bool
+census_skipped(struct census *cs)
+{
+	const char *want = cs->path + cs->rel;
+	size_t want_len = strlen(want);
+	const char *at = cs->skip;
+
+	if (at == NULL) {
+		return false;
+	}
+	while (*at != '\0') {
+		const char *end = strchr(at, ',');
+		size_t n = (end != NULL) ? (size_t)(end - at) : strlen(at);
+
+		if (n == want_len && memcmp(at, want, n) == 0) {
+			return true;
+		}
+		if (end == NULL) {
+			break;
+		}
+		at = end + 1;
+	}
+	return false;
+}
+
+/* Add "/name" to the path, do the entry, and put the path back as it was. */
+static void
+census_child(struct census *cs, const char *name, size_t name_len, uint8_t d_type)
+{
+	size_t saved = cs->len;
+
+	if (cs->stop) {
+		return;
+	}
+	if (cs->len + name_len + 2 > PATH_CAP) {
+		printf("apfs-check: path below %s is too long\n", cs->path + cs->rel);
+		cs->errors++;
+		return;
+	}
+	cs->path[cs->len++] = '/';
+	memcpy(cs->path + cs->len, name, name_len);
+	cs->len += name_len;
+	cs->path[cs->len] = '\0';
+
+	if (census_entry(cs, d_type) && d_type == DT_DIR && cs->depth < MAX_DEPTH &&
+	    (cs->max_depth == 0 || (uint32_t)cs->depth + 1 < cs->max_depth) &&
+	    !census_skipped(cs)) {
+		if (cs->par) {
+			par_push(cs->path, cs->len, cs->depth + 1);
+		} else {
+			cs->depth++;
+			census_dir(cs);
+			cs->depth--;
+		}
+	}
+	cs->len = saved;
+	cs->path[cs->len] = '\0';
+}
+
+/* Every entry of the directory the path currently names. */
+static void
+census_dir(struct census *cs)
+{
+	vnode_t dvp = NULLVP;
+	char *dbuf;
+	off_t offset = 0;
+	int error;
+
+	{
+		uint64_t t0 = mach_absolute_time();
+
+		error = vnode_lookup(cs->len != 0 ? cs->path : "/", cs->lookup_flags, &dvp,
+		    cs->ctx);
+		cs->t_lookup += mach_absolute_time() - t0;
+	}
+	if (error == 0 && cs->mp == NULL) {
+		cs->mp = vnode_mount(dvp);
+	}
+	if (error) {
+		printf("apfs-check: %s: lookup failed: %d\n",
+		    cs->len != 0 ? cs->path + cs->rel : "/", error);
+		cs->errors++;
+		return;
+	}
+	dbuf = kalloc_data(DIR_CHUNK, Z_WAITOK);
+	if (dbuf == NULL) {
+		vnode_put(dvp);
+		cs->errors++;
+		return;
+	}
+	for (;;) {
+		uio_t uio;
+		char uio_buf[UIO_SIZEOF(1)];
+		int eof = 0, items = 0;
+		size_t got;
+		char *p;
+
+		uio = uio_createwithbuffer(1, offset, UIO_SYSSPACE, UIO_READ, uio_buf,
+		    sizeof(uio_buf));
+		if (uio == NULL) {
+			cs->errors++;
+			break;
+		}
+		uio_addiov(uio, CAST_USER_ADDR_T(dbuf), DIR_CHUNK);
+		PHASE("readdir");
+		{
+			uint64_t t0 = mach_absolute_time();
+
+			error = VNOP_READDIR(dvp, uio, 0, &eof, &items, cs->ctx);
+			cs->t_readdir += mach_absolute_time() - t0;
+		}
+		if (error) {
+			printf("apfs-check: %s: readdir failed: %d\n", cs->path + cs->rel, error);
+			cs->errors++;
+			break;
+		}
+		got = DIR_CHUNK - (size_t)uio_resid(uio);
+		if (got == 0) {
+			break;
+		}
+		offset = uio_offset(uio);
+
+		for (p = dbuf; p < dbuf + got;) {
+			struct dirent *de = (struct dirent *)p;
+
+			if (de->d_reclen == 0 || p + de->d_reclen > dbuf + got) {
+				printf("apfs-check: %s: a directory entry of %u bytes\n",
+				    cs->path + cs->rel, de->d_reclen);
+				cs->errors++;
+				break;
+			}
+			p += de->d_reclen;
+			if (de->d_namlen == 0 ||
+			    (de->d_namlen == 1 && de->d_name[0] == '.') ||
+			    (de->d_namlen == 2 && de->d_name[0] == '.' && de->d_name[1] == '.')) {
+				continue;
+			}
+			census_child(cs, de->d_name, de->d_namlen, de->d_type);
+			if (cs->stop) {
+				break;
+			}
+		}
+		if (eof || cs->stop) {
+			break;
+		}
+	}
+	kfree_data(dbuf, DIR_CHUNK);
+	vnode_put(dvp);
+}
+
+/*
+ * apfs_walkers=N (mode 6): N threads walk the volume at once. They take directories off one
+ * shared stack -- a directory's own entries are done by the walker that took it, its
+ * subdirectories pushed for any of them -- so that as many files are read at once as there are
+ * walkers, and the storage has that many requests to work on. The per-line hashes add up the
+ * same whatever the order: the sum and the counts are those of the walk on one thread.
+ */
+struct par_dir {
+	char  *path;
+	size_t len;
+	int    depth;
+};
+
+static LCK_GRP_DECLARE(par_lck_grp, "apfs-check-walkers");
+static LCK_MTX_DECLARE(par_lock, &par_lck_grp);
+static struct par_dir *par_stack;
+static uint32_t par_count, par_cap, par_busy, par_finished, par_most;
+static bool par_failed;
+
+static void
+par_push(const char *path, size_t len, int depth)
+{
+	char *copy = kalloc_data(len + 1, Z_WAITOK);
+
+	lck_mtx_lock(&par_lock);
+	if (par_count == par_cap) {
+		uint32_t cap = par_cap ? par_cap * 2 : 1024;
+		struct par_dir *grown = kalloc_data(cap * sizeof(*grown), Z_WAITOK);
+
+		if (grown == NULL) {
+			par_failed = true;
+			lck_mtx_unlock(&par_lock);
+			kfree_data(copy, len + 1);
+			return;
+		}
+		if (par_stack != NULL) {
+			memcpy(grown, par_stack, par_count * sizeof(*grown));
+			kfree_data(par_stack, par_cap * sizeof(*grown));
+		}
+		par_stack = grown;
+		par_cap = cap;
+	}
+	if (copy == NULL) {
+		par_failed = true;
+	} else {
+		memcpy(copy, path, len + 1);
+		par_stack[par_count++] = (struct par_dir){ copy, len, depth };
+		if (par_count > par_most) {
+			par_most = par_count;
+		}
+		wakeup(&par_stack);
+	}
+	lck_mtx_unlock(&par_lock);
+}
+
+static void
+par_walker(void *arg, __unused wait_result_t wr)
+{
+	struct census *cs = arg;
+	uint64_t cpu0 = thread_get_runtime_self(), wall0 = mach_absolute_time();
+
+	for (;;) {
+		struct par_dir d;
+		uint64_t t0 = mach_absolute_time();
+
+		lck_mtx_lock(&par_lock);
+		while (par_count == 0 && par_busy > 0) {
+			msleep(&par_stack, &par_lock, PRIBIO, "apfs-walkers", NULL);
+		}
+		cs->t_idle += mach_absolute_time() - t0;
+		if (par_count == 0) {
+			/* nothing left, and no walker that could leave more */
+			cs->t_cpu = thread_get_runtime_self() - cpu0;
+			cs->t_wall = mach_absolute_time() - wall0;
+			par_finished++;
+			wakeup(&par_stack);
+			lck_mtx_unlock(&par_lock);
+			return;
+		}
+		d = par_stack[--par_count];
+		par_busy++;
+		lck_mtx_unlock(&par_lock);
+
+		memcpy(cs->path, d.path, d.len + 1);
+		cs->len = d.len;
+		cs->depth = d.depth;
+		kfree_data(d.path, d.len + 1);
+		if (!cs->stop) {
+			census_dir(cs);
+		}
+
+		lck_mtx_lock(&par_lock);
+		par_busy--;
+		wakeup(&par_stack);
+		lck_mtx_unlock(&par_lock);
+	}
+}
+
+/* where a walker's (or, summed, all walkers') time went */
+static void
+census_times(const struct census *cs, int who)
+{
+	uint64_t v[8] = { cs->t_wall, cs->t_cpu, cs->t_lookup, cs->t_attr, cs->t_read, cs->hash_ticks, cs->t_readdir,
+		              cs->t_idle };
+
+	for (int i = 0; i < 8; i++) {
+		absolutetime_to_nanoseconds(v[i], &v[i]);
+		v[i] /= 1000000;
+	}
+	char name[24];
+
+	if (who < 0) {
+		strlcpy(name, "all walkers", sizeof(name));
+	} else {
+		snprintf(name, sizeof(name), "walker %d", who);
+	}
+	printf("apfs-check: %s: %llu entries, %llu bytes: %llu ms, on a processor %llu; lookups %llu, getattr %llu, "
+	    "reading %llu (of it hashing %llu), readdir %llu, waiting for a directory %llu\n",
+	    name, cs->entries, cs->bytes, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+}
+
+/* The whole walk on n threads, its totals into cs */
+static void
+par_walk(struct census *cs, uint32_t n)
+{
+	struct census *w[PAR_MAX];
+	uint32_t started = 0;
+
+	par_count = par_busy = par_finished = par_most = 0;
+	par_failed = false;
+	par_push(cs->path, cs->len, cs->depth);
+	for (uint32_t i = 0; i < n; i++) {
+		w[i] = kalloc_type(struct census, Z_WAITOK | Z_ZERO);
+		if (w[i] == NULL) {
+			break;
+		}
+		*w[i] = *cs;
+		w[i]->par = true;
+		w[i]->sum = w[i]->entries = w[i]->dirs = w[i]->files = w[i]->links = w[i]->others = w[i]->bytes = 0;
+		w[i]->errors = 0;
+		w[i]->hash_ticks = 0;
+		w[i]->path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+		w[i]->buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+		if (w[i]->path == NULL || w[i]->buf == NULL) {
+			break;
+		}
+		par_cs[i] = w[i];
+		started = i + 1;
+	}
+	par_n = started;
+	printf("apfs-check: %u walkers at once\n", started);
+	for (uint32_t i = 0; i < started; i++) {
+		thread_t th;
+
+		if (kernel_thread_start(par_walker, w[i], &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			lck_mtx_lock(&par_lock);
+			par_finished++;
+			lck_mtx_unlock(&par_lock);
+		}
+	}
+	lck_mtx_lock(&par_lock);
+	while (par_finished < started) {
+		msleep(&par_stack, &par_lock, PRIBIO, "apfs-walk", NULL);
+	}
+	lck_mtx_unlock(&par_lock);
+	par_n = 0;
+	for (uint32_t i = 0; i < started; i++) {
+		par_cs[i] = NULL;
+		cs->sum += w[i]->sum;
+		cs->entries += w[i]->entries;
+		cs->dirs += w[i]->dirs;
+		cs->files += w[i]->files;
+		cs->links += w[i]->links;
+		cs->others += w[i]->others;
+		cs->bytes += w[i]->bytes;
+		cs->errors += w[i]->errors;
+		cs->hash_ticks += w[i]->hash_ticks;
+		census_times(w[i], i);
+		cs->t_lookup += w[i]->t_lookup;
+		cs->t_attr += w[i]->t_attr;
+		cs->t_read += w[i]->t_read;
+		cs->t_readdir += w[i]->t_readdir;
+		cs->t_idle += w[i]->t_idle;
+		cs->t_cpu += w[i]->t_cpu;
+		cs->t_wall += w[i]->t_wall;
+		kfree_data(w[i]->path, PATH_CAP);
+		kfree_data(w[i]->buf, READ_CHUNK);
+		kfree_type(struct census, w[i]);
+	}
+	if (par_failed) {
+		printf("apfs-check: the walkers ran out of memory for their stack: the walk is NOT whole\n");
+		cs->errors++;
+	}
+	census_times(cs, -1);
+	printf("apfs-check: at most %u directories waited on the walkers' stack\n", par_most);
+	if (par_stack != NULL) {
+		kfree_data(par_stack, par_cap * sizeof(*par_stack));
+		par_stack = NULL;
+		par_cap = 0;
+	}
+}
+
+/* ---- getting there ---- */
+
+static int
+make_mount_point(vfs_context_t ctx)
+{
+	struct componentname cn;
+	struct vnode_attr va;
+	vnode_t dvp = NULLVP, vp = NULLVP;
+	char leaf[] = CHECK_LEAF;
+	int error;
+
+	error = vnode_lookup(CHECK_PARENT, 0, &dvp, ctx);
+	if (error) {
+		return error;
+	}
+	bzero(&cn, sizeof(cn));
+	cn.cn_nameiop = CREATE;
+	cn.cn_flags = ISLASTCN;
+	cn.cn_context = ctx;
+	cn.cn_pnbuf = leaf;
+	cn.cn_pnlen = (int)sizeof(leaf);
+	cn.cn_nameptr = leaf;
+	cn.cn_namelen = (int)(sizeof(leaf) - 1);
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_type, VDIR);
+	VATTR_SET(&va, va_mode, 0755);
+
+	error = VNOP_MKDIR(dvp, &vp, &cn, &va, ctx);
+	if (error == 0 && vp != NULLVP) {
+		vnode_put(vp);
+	}
+	vnode_put(dvp);
+	if (error == EEXIST) {
+		error = 0;
+	}
+	return error;
+}
+
+#define MAX_THREADS 8
+
+static volatile int apfs_check_running;
+
+struct walk_job {
+	int      index;
+	uint64_t ms;
+	uint64_t entries;
+	uint64_t bytes;
+	uint64_t sum;
+	uint32_t errors;
+};
+
+static struct walk_job apfs_jobs[MAX_THREADS];
+
+/* One reader: the whole root filesystem, with everything of its own. */
+static void
+apfs_walk_one(void *arg, __unused wait_result_t wr)
+{
+	struct walk_job *job = arg;
+	struct census cs;
+	uint64_t start, end, ns = 0, hash_ns = 0;
+
+	bzero(&cs, sizeof(cs));
+	cs.ctx = vfs_context_kernel();
+	census_options(&cs);
+	PE_parse_boot_argn("apfs_depth", &cs.max_depth, sizeof(cs.max_depth));
+	PE_parse_boot_argn("apfs_max", &cs.max_entries, sizeof(cs.max_entries));
+	{
+		static char skip[256];
+
+		if (PE_parse_boot_arg_str("apfs_skip", skip, sizeof(skip)) && skip[0] != '\0') {
+			cs.skip = skip;
+			printf("apfs-check: staying out of %s\n", skip);
+		}
+	}
+	cs.lookup_flags = VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT;
+	cs.path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+	cs.buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (cs.path == NULL || cs.buf == NULL) {
+		printf("apfs-check: reader %d: out of memory\n", job->index);
+		OSDecrementAtomic(&apfs_check_running);
+		return;
+	}
+	start = mach_absolute_time();
+	census_dir(&cs);
+	end = mach_absolute_time();
+	absolutetime_to_nanoseconds(end - start, &ns);
+	absolutetime_to_nanoseconds(cs.hash_ticks, &hash_ns);
+
+	job->ms = ns / 1000000;
+	job->entries = cs.entries;
+	job->bytes = cs.bytes;
+	job->sum = cs.sum;
+	job->errors = cs.errors;
+	printf("apfs-check: reader %d: %llu entries  %llu bytes  sum %016llx  errors %u  "
+	    "%llu ms  hash %s%llu ms\n", job->index, cs.entries, cs.bytes,
+	    (unsigned long long)cs.sum, cs.errors, job->ms, cs.no_hash ? "off " : "",
+	    hash_ns / 1000000);
+
+	kfree_data(cs.path, PATH_CAP);
+	kfree_data(cs.buf, READ_CHUNK);
+	OSDecrementAtomic(&apfs_check_running);
+}
+
+/*
+ * Several readers at once over the same volume.  What is wanted is not only that nothing
+ * breaks but what the lock costs: all of apfs_lib runs under one mutex, so the part of the
+ * work that is held time cannot go faster however many processors there are.
+ */
+static void
+apfs_check_concurrent(void)
+{
+	uint32_t want = 4;
+	uint64_t start, end, ns = 0;
+	uint64_t total_bytes = 0, total_entries = 0;
+	int i, n, bad = 0;
+
+	if (PE_parse_boot_argn("apfs_threads", &want, sizeof(want)) == 0 || want == 0) {
+		want = 4;
+	}
+	if (want > MAX_THREADS) {
+		want = MAX_THREADS;
+	}
+	n = (int)want;
+	printf("apfs-check: %d readers over the root filesystem at once\n", n);
+
+	bzero(apfs_jobs, sizeof(apfs_jobs));
+	apfs_check_running = n;
+	start = mach_absolute_time();
+	for (i = 0; i < n; i++) {
+		thread_t th;
+
+		apfs_jobs[i].index = i;
+		if (kernel_thread_start(apfs_walk_one, &apfs_jobs[i], &th) != KERN_SUCCESS) {
+			printf("apfs-check: cannot start reader %d\n", i);
+			OSDecrementAtomic(&apfs_check_running);
+			continue;
+		}
+		thread_deallocate(th);
+	}
+	while (apfs_check_running > 0) {
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	end = mach_absolute_time();
+	absolutetime_to_nanoseconds(end - start, &ns);
+
+	for (i = 0; i < n; i++) {
+		total_bytes += apfs_jobs[i].bytes;
+		total_entries += apfs_jobs[i].entries;
+		if (apfs_jobs[i].sum != apfs_jobs[0].sum ||
+		    apfs_jobs[i].entries != apfs_jobs[0].entries || apfs_jobs[i].errors != 0) {
+			bad++;
+		}
+	}
+	printf("apfs-check: %d readers done in %llu ms\n", n, ns / 1000000);
+	printf("apfs-check: together %llu entries  %llu bytes  %llu KB/s\n", total_entries,
+	    total_bytes, ns ? (total_bytes * 1000000ull) / ns : 0);
+	printf("apfs-check: readers that disagreed or failed: %d\n", bad);
+	apfs_stats_print();
+}
+
+/* ------------------------------------------- apfs_check=7: the kernel's own write, on a device */
+
+/*
+ * The one place bsd/miscfs/apfs/apfs_write.c is run inside the kernel.  It is not VFS: there is
+ * no vnop_write and this milestone does not call for one.  It is apfs_lib and apfs_write on a
+ * real block device, which is the step between the tests on the build machine
+ * (tools/apfs/write-tests.sh) and anything on the phone's flash.
+ *
+ *   apfs_check=7
+ *   apfs_dev=md0              the container to write in (default rvblk0)
+ *   apfs_write_path=/redwood/x   the file in it, by path from the volume's root
+ *   apfs_write_at=N           where in the file (default 0)
+ *   apfs_write_len=N          how many bytes (default 4096, at most APFS_WRITE_MAX)
+ *   apfs_write_byte=N         what to fill them with (default 0xa5)
+ *
+ * The container is opened, written and closed; then opened again from nothing and the file read
+ * back, so what is reported came off the device and not out of apfs_lib's block cache.  The
+ * device is opened for writing here and nowhere else: every mount of this driver leaves
+ * dev.write NULL, and without it apfs_write_in_place refuses everything.
+ *
+ * Where this can reach, which is the point: a block device.  The phone's flash is not one under
+ * this kernel -- it is read through the loader's mailbox and, on the branch that writes to it at
+ * all, through a character device of its own with its own bounds (bsd/dev/redwood_ufs.c) -- so
+ * nothing here can touch it.  In QEMU and on the phone alike the only block devices are RAM
+ * disks.  And it happens at all only when asked for twice over: apfs_check=7 and a path.
+ */
+#define APFS_WRITE_MAX (1u << 20)
+
+struct wdev {
+	vnode_t  vp;
+	uint32_t devblock;
+};
+
+static int
+wdev_io(struct wdev *w, uint64_t off, void *buf, size_t len, int flag)
+{
+	char *p = buf;
+
+	if ((off % w->devblock) != 0 || (len % w->devblock) != 0) {
+		return EINVAL;
+	}
+	while (len > 0) {
+		size_t n = len < (128u << 10) ? len : (128u << 10);
+		buf_t bp = buf_alloc(w->vp);
+		int error;
+
+		if (bp == NULL) {
+			return ENOMEM;
+		}
+		buf_reset(bp, flag);
+		buf_setblkno(bp, (daddr64_t)(off / w->devblock));
+		buf_setlblkno(bp, (daddr64_t)(off / w->devblock));
+		buf_setcount(bp, (uint32_t)n);
+		buf_setdataptr(bp, (uintptr_t)p);
+		/*
+		 * A write buffer of our own has to be counted against the device's vnode before
+		 * it is issued: buf_biodone() undoes that count, and without it the kernel
+		 * panics on the way back (vnode_writedone: numoutput < 0).  This is what
+		 * cluster_io() does for the same kind of raw buffer.
+		 */
+		if (flag != B_READ) {
+			vnode_startwrite(w->vp);
+		}
+		error = VNOP_STRATEGY(bp);
+		if (error == 0) {
+			error = (int)buf_biowait(bp);
+		}
+		if (error == 0 && (buf_resid(bp) != 0 || buf_count(bp) != n)) {
+			error = EIO;
+		}
+		buf_free(bp);
+		if (error) {
+			return error;
+		}
+		p += n;
+		off += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int
+wdev_read(void *ctx, uint64_t off, void *buf, size_t len)
+{
+	return wdev_io(ctx, off, buf, len, B_READ);
+}
+
+static int
+wdev_write(void *ctx, uint64_t off, const void *buf, size_t len)
+{
+	return wdev_io(ctx, off, (void *)(uintptr_t)buf, len, B_WRITE);
+}
+
+/* The volume a path names, and the inode in it; the first volume with a root directory. */
+static int
+wdev_open_volume(struct apfs_nx *nx, struct apfs_vol *vol)
+{
+	uint32_t i;
+
+	for (i = 0; i < APFS_NX_MAX_FILE_SYSTEMS; i++) {
+		struct apfs_inode ino;
+
+		if (nx->fs_oid[i] == 0 || apfs_vol_open(nx, i, vol) != 0) {
+			continue;
+		}
+		if (apfs_inode_get(vol, APFS_ROOT_DIR_INO_NUM, &ino) == 0) {
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+/* The FNV-1a of a file's contents as the census lines use it, read through apfs_lib. */
+static int
+wdev_hash(struct apfs_vol *vol, const struct apfs_inode *ino, uint8_t *buf, size_t buflen,
+    uint64_t *out)
+{
+	struct apfs_cfile cf;
+	uint64_t h = FNV_INIT, off = 0;
+
+	bzero(&cf, sizeof(cf));
+	while (off < ino->size) {
+		size_t want = (size_t)(ino->size - off), got = 0, i;
+
+		if (want > buflen) {
+			want = buflen;
+		}
+		if (apfs_read_file(vol, ino, &cf, off, buf, want, &got) != 0 || got == 0) {
+			apfs_cfile_fini(&cf);
+			return EIO;
+		}
+		for (i = 0; i < got; i++) {
+			h ^= buf[i];
+			h *= FNV_PRIME;
+		}
+		off += got;
+	}
+	apfs_cfile_fini(&cf);
+	*out = h;
+	return 0;
+}
+
+static void
+apfs_write_check(const char *devname)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct apfs_nx nx;
+	struct apfs_vol vol;
+	struct apfs_inode ino;
+	struct apfs_write_report rep;
+	struct apfs_dev dev;
+	struct wdev w = { NULLVP, 0 };
+	char path[256] = "";
+	uint8_t *data = NULL, *scratch = NULL, *was = NULL;
+	uint64_t at = 0, before = 0, after = 0, want = 0, file_id = 0, was_len = 0;
+	uint32_t len = 4096, byte = 0xa5;
+	const char *why = NULL;
+	bool opened = false, nx_open = false;
+	int error, tries;
+
+	if (!PE_parse_boot_arg_str("apfs_write_path", path, sizeof(path)) || path[0] != '/') {
+		printf("apfs-write: apfs_write_path=/some/file says which file to write\n");
+		return;
+	}
+	PE_parse_boot_argn("apfs_write_at", &at, sizeof(at));
+	PE_parse_boot_argn("apfs_write_len", &len, sizeof(len));
+	PE_parse_boot_argn("apfs_write_byte", &byte, sizeof(byte));
+	if (len == 0 || len > APFS_WRITE_MAX) {
+		printf("apfs-write: apfs_write_len=%u is not between 1 and %u\n", len, APFS_WRITE_MAX);
+		return;
+	}
+
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(devname, 0, &w.vp, ctx) == 0) {
+			break;
+		}
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	if (w.vp == NULLVP) {
+		printf("apfs-write: %s never showed up in /dev\n", devname);
+		return;
+	}
+	/* for writing, which is what no mount of this driver ever asks for */
+	error = VNOP_OPEN(w.vp, FREAD | FWRITE, ctx);
+	if (error) {
+		printf("apfs-write: %s will not open for writing: %d\n", devname, error);
+		goto out;
+	}
+	opened = true;
+	if (VNOP_IOCTL(w.vp, DKIOCGETBLOCKSIZE, (caddr_t)&w.devblock, 0, ctx) != 0 ||
+	    w.devblock == 0 || (4096 % w.devblock) != 0) {
+		printf("apfs-write: %s has no usable block size\n", devname);
+		goto out;
+	}
+	data = kalloc_data(len, Z_WAITOK);
+	scratch = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (data == NULL || scratch == NULL) {
+		printf("apfs-write: out of memory\n");
+		goto out;
+	}
+	memset(data, (int)(byte & 0xff), len);
+
+	memset(&dev, 0, sizeof(dev));
+	dev.ctx = &w;
+	dev.read = wdev_read;
+	dev.read_data = wdev_read;
+	dev.write = wdev_write;
+	error = apfs_nx_open(&nx, &dev);
+	if (error) {
+		printf("apfs-write: %s is not a container we can read: %d\n", devname, error);
+		goto out;
+	}
+	nx_open = true;
+	error = wdev_open_volume(&nx, &vol);
+	if (error) {
+		printf("apfs-write: %s has no volume with a root directory\n", devname);
+		goto out;
+	}
+	if (apfs_write_volume_ok(&vol, &why) != 0) {
+		printf("apfs-write: volume %s will not be written: %s\n", vol.name, why);
+		goto out;
+	}
+	error = apfs_path_lookup(&vol, path, &file_id, NULL);
+	if (error) {
+		printf("apfs-write: %s: no such path in %s: %d\n", path, vol.name, error);
+		goto out;
+	}
+	error = apfs_inode_get(&vol, file_id, &ino);
+	if (error == 0) {
+		error = wdev_hash(&vol, &ino, scratch, READ_CHUNK, &before);
+	}
+	if (error) {
+		printf("apfs-write: %s cannot be read before the write: %d\n", path, error);
+		goto out;
+	}
+	printf("apfs-write: %s on %s, inode %llu, %llu bytes, hash %016llx\n", path, vol.name,
+	    file_id, ino.size, before);
+	/*
+	 * The file as it is now, kept so that what it should hold afterwards can be worked out
+	 * from it rather than from the result -- which would prove nothing.
+	 */
+	if (ino.size <= APFS_WRITE_MAX) {
+		struct apfs_cfile cf;
+		size_t got = 0;
+
+		bzero(&cf, sizeof(cf));
+		was_len = ino.size;
+		was = kalloc_data((vm_size_t)was_len, Z_WAITOK);
+		if (was != NULL &&
+		    (apfs_read_file(&vol, &ino, &cf, 0, was, (size_t)was_len, &got) != 0 ||
+		    got != was_len)) {
+			kfree_data(was, (vm_size_t)was_len);
+			was = NULL;
+		}
+		apfs_cfile_fini(&cf);
+	}
+	if (was == NULL) {
+		printf("apfs-write: %s is too big to keep a copy of: only the hashes are reported\n",
+		    path);
+	}
+
+	error = apfs_write_in_place(&vol, file_id, at, data, len, &rep);
+	printf("apfs-write: %u bytes of 0x%02x at %llu: %s; %llu blocks from %llu, %llu of them "
+	    "patched whole, %llu writes\n", len, byte & 0xff, at,
+	    error == 0 ? "written" : (rep.why != NULL ? rep.why : "failed"), rep.blocks,
+	    rep.first_block, rep.partial, rep.calls);
+	apfs_nx_close(&nx);
+	nx_open = false;
+	if (error) {
+		goto out;
+	}
+
+	/*
+	 * Again from nothing: a container opened a second time shares no cache with the first,
+	 * so what comes back now is what is on the device.
+	 */
+	error = apfs_nx_open(&nx, &dev);
+	if (error == 0) {
+		nx_open = true;
+		error = wdev_open_volume(&nx, &vol);
+	}
+	if (error == 0) {
+		error = apfs_path_lookup(&vol, path, &file_id, NULL);
+	}
+	if (error == 0) {
+		error = apfs_inode_get(&vol, file_id, &ino);
+	}
+	if (error == 0) {
+		error = wdev_hash(&vol, &ino, scratch, READ_CHUNK, &after);
+	}
+	if (error) {
+		printf("apfs-write: the volume will not read back after the write: %d\n", error);
+		goto out;
+	}
+	if (was != NULL) {
+		uint64_t off;
+
+		want = FNV_INIT;
+		for (off = 0; off < was_len; off++) {
+			uint8_t b = (off >= at && off < at + len) ? (uint8_t)(byte & 0xff) : was[off];
+
+			want ^= b;
+			want *= FNV_PRIME;
+		}
+	}
+	printf("apfs-write: read back from a container opened again: %llu bytes, hash %016llx "
+	    "(was %016llx); the bytes written are %s\n", ino.size, after, before,
+	    was == NULL ? "not checked here" :
+	    (want == after ? "all there and nothing else changed" : "NOT what was asked for"));
+out:
+	if (nx_open) {
+		apfs_nx_close(&nx);
+	}
+	if (data != NULL) {
+		kfree_data(data, len);
+	}
+	if (scratch != NULL) {
+		kfree_data(scratch, READ_CHUNK);
+	}
+	if (was != NULL) {
+		kfree_data(was, (vm_size_t)was_len);
+	}
+	if (opened) {
+		(void)VNOP_CLOSE(w.vp, FREAD | FWRITE, ctx);
+	}
+	if (w.vp != NULLVP) {
+		vnode_put(w.vp);
+	}
+}
+
+/* -------------------------------------- apfs_check=8: the store, in the kernel, on a device */
+
+/*
+ * The store of fixed-length slot files (bsd/miscfs/apfs/apfs_store.c) run where it will live: in
+ * the kernel, on a block device, under the kernel's own allocator.  A payload of apfs_store_len
+ * bytes of a pattern this works out twice -- once to save, once to compare -- goes into the
+ * store on apfs_dev; then the container is opened again from nothing and the newest good slot is
+ * read back, so what is reported came off the device.
+ *
+ *   apfs_check=8
+ *   apfs_dev=md1              the store volume (default rvblk0); its name must be RedwoodStore
+ *   apfs_store_len=N          how many bytes of payload (default 40000)
+ *   apfs_store_seed=N         which pattern (default 1); a different seed is a different payload
+ *   apfs_store_note=N         the writer's own number, kept in the header (default 0)
+ */
+#define APFS_STORE_TEST_MAX (4u << 20)
+
+static void
+store_pattern(uint8_t *buf, uint32_t len, uint32_t seed)
+{
+	uint32_t i;
+
+	for (i = 0; i < len; i++) {
+		buf[i] = (uint8_t)(i * (7 + seed) + 5 + seed);
+	}
+}
+
+static void
+apfs_store_check(const char *devname)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct apfs_nx nx;
+	struct apfs_vol vol;
+	struct apfs_store st;
+	struct apfs_store_head head;
+	struct apfs_store_write w;
+	struct apfs_dev dev;
+	struct wdev wd = { NULLVP, 0 };
+	uint8_t *data = NULL, *scratch = NULL;
+	uint32_t len = 40000, seed = 1;
+	uint64_t note = 0, want = FNV_INIT;
+	const char *why = NULL;
+	bool opened = false, nx_open = false;
+	int best, error, tries;
+	uint32_t i;
+
+	PE_parse_boot_argn("apfs_store_len", &len, sizeof(len));
+	PE_parse_boot_argn("apfs_store_seed", &seed, sizeof(seed));
+	PE_parse_boot_argn("apfs_store_note", &note, sizeof(note));
+	if (len == 0 || len > APFS_STORE_TEST_MAX) {
+		printf("apfs-store: apfs_store_len=%u is not between 1 and %u\n", len,
+		    APFS_STORE_TEST_MAX);
+		return;
+	}
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(devname, 0, &wd.vp, ctx) == 0) {
+			break;
+		}
+		delay_for_interval(20, NSEC_PER_MSEC);
+	}
+	if (wd.vp == NULLVP) {
+		printf("apfs-store: %s never showed up in /dev\n", devname);
+		return;
+	}
+	error = VNOP_OPEN(wd.vp, FREAD | FWRITE, ctx);
+	if (error) {
+		printf("apfs-store: %s will not open for writing: %d\n", devname, error);
+		goto out;
+	}
+	opened = true;
+	if (VNOP_IOCTL(wd.vp, DKIOCGETBLOCKSIZE, (caddr_t)&wd.devblock, 0, ctx) != 0 ||
+	    wd.devblock == 0 || (4096 % wd.devblock) != 0) {
+		printf("apfs-store: %s has no usable block size\n", devname);
+		goto out;
+	}
+	data = kalloc_data(len, Z_WAITOK);
+	scratch = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (data == NULL || scratch == NULL) {
+		printf("apfs-store: out of memory\n");
+		goto out;
+	}
+	store_pattern(data, len, seed);
+	for (i = 0; i < len; i++) {
+		want ^= data[i];
+		want *= FNV_PRIME;
+	}
+
+	memset(&dev, 0, sizeof(dev));
+	dev.ctx = &wd;
+	dev.read = wdev_read;
+	dev.read_data = wdev_read;
+	dev.write = wdev_write;
+	error = apfs_nx_open(&nx, &dev);
+	if (error) {
+		printf("apfs-store: %s is not a container we can read: %d\n", devname, error);
+		goto out;
+	}
+	nx_open = true;
+	error = wdev_open_volume(&nx, &vol);
+	if (error == 0) {
+		error = apfs_store_open(&vol, &st, &why);
+	}
+	if (error) {
+		printf("apfs-store: %s holds no store: %s\n", devname,
+		    why != NULL ? why : "cannot be opened");
+		goto out;
+	}
+	best = apfs_store_newest(&st, scratch, READ_CHUNK, &head);
+	printf("apfs-store: %s: %d slots of %llu bytes, %llu of payload; the newest good slot is "
+	    "%d%s\n", vol.name, (int)APFS_STORE_SLOTS, st.slot_bytes, st.payload_max, best,
+	    best < 0 ? " (none)" : "");
+
+	error = apfs_store_save(&st, data, len, 0, note, scratch, READ_CHUNK, &w);
+	printf("apfs-store: %u bytes into slot %d as generation %llu: %s; %llu blocks\n", len,
+	    w.slot, w.generation, error == 0 ? "saved" : "failed", w.blocks);
+	apfs_nx_close(&nx);
+	nx_open = false;
+	if (error) {
+		printf("apfs-store: the save failed: %d\n", error);
+		goto out;
+	}
+
+	/* again from nothing: no cache of the first opening survives into the second */
+	error = apfs_nx_open(&nx, &dev);
+	if (error == 0) {
+		nx_open = true;
+		error = wdev_open_volume(&nx, &vol);
+	}
+	if (error == 0) {
+		error = apfs_store_open(&vol, &st, &why);
+	}
+	if (error) {
+		printf("apfs-store: the store will not open again: %d\n", error);
+		goto out;
+	}
+	best = apfs_store_newest(&st, scratch, READ_CHUNK, &head);
+	if (best < 0) {
+		printf("apfs-store: after the save no slot holds anything good\n");
+		goto out;
+	}
+	printf("apfs-store: read back from a container opened again: slot %d, generation %llu, "
+	    "%llu bytes, note %llu, sum %016llx; the payload is %s\n", best, head.generation,
+	    head.bytes, head.note, head.sum,
+	    (head.bytes == len && head.sum == want) ? "the one that was saved" :
+	    "NOT what was saved");
+out:
+	if (nx_open) {
+		apfs_nx_close(&nx);
+	}
+	if (data != NULL) {
+		kfree_data(data, len);
+	}
+	if (scratch != NULL) {
+		kfree_data(scratch, READ_CHUNK);
+	}
+	if (opened) {
+		(void)VNOP_CLOSE(wd.vp, FREAD | FWRITE, ctx);
+	}
+	if (wd.vp != NULLVP) {
+		vnode_put(wd.vp);
+	}
+}
+
+static void
+apfs_check_thread(void *arg, __unused wait_result_t wr)
+{
+	uint32_t mode = (uint32_t)(uintptr_t)arg;
+	vfs_context_t ctx = vfs_context_kernel();
+	struct census cs;
+	char devname[64] = CHECK_DEV;
+	char subtree[256] = "";
+	uint64_t start, end;
+	int error, tries;
+
+	bzero(&cs, sizeof(cs));
+	cs.ctx = ctx;
+	census_options(&cs);
+	cs.print_lines = (mode == 2);
+	/*
+	 * NOCROSSMOUNT only where the volume is the root (modes 4 and 5).  In mode 6 the
+	 * path leads from the root image into the mount, so crossing has to be allowed; the
+	 * walk is kept on the volume by the check against the mount it started on.
+	 */
+	PE_parse_boot_argn("apfs_depth", &cs.max_depth, sizeof(cs.max_depth));
+	PE_parse_boot_argn("apfs_max", &cs.max_entries, sizeof(cs.max_entries));
+	{
+		static char skip[256];
+
+		if (PE_parse_boot_arg_str("apfs_skip", skip, sizeof(skip)) && skip[0] != '\0') {
+			cs.skip = skip;
+			printf("apfs-check: staying out of %s\n", skip);
+		}
+	}
+	cs.lookup_flags = VNODE_LOOKUP_NOFOLLOW |
+	    ((mode == 4 || mode == 5) ? VNODE_LOOKUP_NOCROSSMOUNT : 0);
+	if (PE_parse_boot_arg_str("apfs_dev", subtree, sizeof(subtree)) && subtree[0] != '\0') {
+		snprintf(devname, sizeof(devname), "/dev/%s", subtree);
+	}
+	subtree[0] = '\0';
+
+	/* the modes that write: no walk, no mount, no census */
+	if (mode == 7) {
+		apfs_write_check(devname);
+		return;
+	}
+	if (mode == 8) {
+		apfs_store_check(devname);
+		return;
+	}
+
+	cs.path = kalloc_data(PATH_CAP, Z_WAITOK | Z_ZERO);
+	cs.buf = kalloc_data(READ_CHUNK, Z_WAITOK);
+	if (cs.path == NULL || cs.buf == NULL) {
+		printf("apfs-check: out of memory\n");
+		return;
+	}
+
+	if (mode == 6) {
+		char mnt[128] = CHECK_MNT;
+
+		if (PE_parse_boot_arg_str("apfs_mnt", subtree, sizeof(subtree)) &&
+		    subtree[0] == '/') {
+			strlcpy(mnt, subtree, sizeof(mnt));
+		}
+		subtree[0] = '\0';
+		/*
+		 * A node just made with devfs_make_node() is not in /dev the instant it is
+		 * made -- this runs straight after the device registered itself, and the first
+		 * lookup comes back ENOENT -- so wait for it rather than guess how long devfs
+		 * takes to show it.
+		 */
+		{
+			vnode_t t = NULLVP;
+			int tries;
+
+			for (tries = 0; tries < 100; tries++) {
+				if (vnode_lookup(devname, 0, &t, ctx) == 0) {
+					vnode_put(t);
+					break;
+				}
+				delay_for_interval(20, NSEC_PER_MSEC);
+			}
+			if (tries >= 100) {
+				printf("apfs-check: %s never showed up in /dev\n", devname);
+			} else if (tries > 0) {
+				printf("apfs-check: %s showed up in /dev after %d ms\n", devname,
+				    tries * 20);
+			}
+		}
+		error = kernel_mount("apfs", NULLVP, NULLVP, mnt, devname, 0,
+		    MNT_RDONLY | MNT_DONTBROWSE, KERNEL_MOUNT_NOAUTH, ctx);
+		if (error) {
+			printf("apfs-check: mounting %s on %s failed: %d\n", devname, mnt,
+			    error);
+			kfree_data(cs.path, PATH_CAP);
+			kfree_data(cs.buf, READ_CHUNK);
+			return;
+		}
+		printf("apfs-check: %s mounted on %s\n", devname, mnt);
+		cs.rel = strlen(mnt);
+		strlcpy(cs.path, mnt, PATH_CAP);
+		cs.len = cs.rel;
+		if (PE_parse_boot_arg_str("apfs_subtree", subtree, sizeof(subtree)) &&
+		    subtree[0] == '/') {
+			strlcat(cs.path, subtree, PATH_CAP);
+			cs.len = strlen(cs.path);
+			printf("apfs-check: walking %s\n", cs.path + cs.rel);
+		} else {
+			printf("apfs-check: walking the whole volume\n");
+		}
+		goto walk;
+	}
+	if (mode >= 5) {
+		kfree_data(cs.path, PATH_CAP);
+		kfree_data(cs.buf, READ_CHUNK);
+		apfs_check_concurrent();
+		return;
+	}
+	if (mode >= 4 && mode != 6) {
+		/*
+		 * The volume is already the root: nothing to mount, and no mount point to
+		 * make, so none of what follows about /private/var applies.
+		 */
+		cs.rel = 0;
+		cs.len = 0;
+		cs.path[0] = '\0';
+		printf("apfs-check: walking the root filesystem\n");
+		goto walk;
+	}
+
+	/*
+	 * /private/var is a ramfs that userland's init mounts, so the mount point cannot be
+	 * made until that has happened.  Wait for it rather than guess how long it takes.
+	 */
+	for (tries = 0; tries < 180; tries++) {
+		error = make_mount_point(ctx);
+		if (error == 0) {
+			break;
+		}
+		delay_for_interval(500, NSEC_PER_MSEC);
+	}
+	if (error) {
+		printf("apfs-check: cannot make %s: %d\n", CHECK_MNT, error);
+		return;
+	}
+
+	/*
+	 * The mount data is the device's path itself, not a pointer to it: the extra
+	 * indirection imageboot_pivot_image() uses is unpacked only on the BaseSystem path,
+	 * which this build does not have, so apfs_mount() reads the string straight off
+	 * this pointer.
+	 */
+	error = kernel_mount("apfs", NULLVP, NULLVP, CHECK_MNT, devname, 0,
+	    MNT_RDONLY | MNT_DONTBROWSE, KERNEL_MOUNT_NOAUTH, ctx);
+	if (error) {
+		printf("apfs-check: mounting %s on %s failed: %d\n", devname, CHECK_MNT,
+		    error);
+		return;
+	}
+	printf("apfs-check: %s mounted on %s\n", devname, CHECK_MNT);
+	if (mode >= 3) {
+		/* someone in user space is going to read it; leave it alone */
+		printf("apfs-check: left mounted, not walking it here\n");
+		return;
+	}
+
+	cs.rel = sizeof(CHECK_MNT) - 1;
+	strlcpy(cs.path, CHECK_MNT, PATH_CAP);
+	cs.len = cs.rel;
+	if (PE_parse_boot_arg_str("apfs_subtree", subtree, sizeof(subtree)) &&
+	    subtree[0] == '/') {
+		strlcat(cs.path, subtree, PATH_CAP);
+		cs.len = strlen(cs.path);
+		while (cs.len > cs.rel && cs.path[cs.len - 1] == '/') {
+			cs.path[--cs.len] = '\0';
+		}
+		printf("apfs-check: walking %s\n", cs.path + cs.rel);
+	} else {
+		printf("apfs-check: walking the whole volume\n");
+	}
+
+walk:
+	redwood_ufs_report("before the walk");
+	start = mach_absolute_time();
+	cs.t0 = start;
+	watch_start(&cs);
+	{
+		uint32_t walkers = 1;
+
+		PE_parse_boot_argn("apfs_walkers", &walkers, sizeof(walkers));
+		if (mode == 6 && walkers > 1) {
+			par_walk(&cs, walkers > PAR_MAX ? PAR_MAX : walkers);
+		} else {
+			uint64_t cpu0 = thread_get_runtime_self(), wall0 = mach_absolute_time();
+
+			census_dir(&cs);
+			cs.t_cpu = thread_get_runtime_self() - cpu0;
+			cs.t_wall = mach_absolute_time() - wall0;
+			census_times(&cs, 0);
+		}
+	}
+	watch_stop();
+	end = mach_absolute_time();
+
+	{
+		uint64_t ns = 0;
+
+		absolutetime_to_nanoseconds(end - start, &ns);
+		printf("apfs-check: done in %llu ms\n", ns / 1000000);
+	}
+	printf("apfs-check: entries %llu  dirs %llu  files %llu  symlinks %llu  other %llu\n",
+	    cs.entries, cs.dirs, cs.files, cs.links, cs.others);
+	printf("apfs-check: content bytes %llu\n", cs.bytes);
+	printf("apfs-check: line-hash sum %016llx\n", (unsigned long long)cs.sum);
+	printf("apfs-check: errors %u\n", cs.errors);
+	{
+		uint64_t hash_ns = 0;
+
+		absolutetime_to_nanoseconds(cs.hash_ticks, &hash_ns);
+		printf("apfs-check: of it the checker's own hashing %llu ms%s\n", hash_ns / 1000000,
+		    cs.no_hash ? " (apfs_hash=0)" : "");
+	}
+	apfs_stats_print();
+	redwood_sparse_report();
+	redwood_ufs_report("after the walk");
+	printf("apfs-check: compare with tools/apfs/verify.py sum\n");
+
+	kfree_data(cs.path, PATH_CAP);
+	kfree_data(cs.buf, READ_CHUNK);
+}
+
+static volatile int apfs_check_finished;
+
+static void
+apfs_check_runner(void *arg, wait_result_t wr)
+{
+	apfs_check_thread(arg, wr);
+	apfs_check_finished = 1;
+}
+
+/*
+ * sysctl kern.redwood_switch_root="INCOMING OUTGOING": the volume mounted on INCOMING
+ * becomes the root, and what was the root until now is mounted on OUTGOING inside it (a
+ * path without a leading slash, which must be a directory there -- on the iOS volume, a
+ * synthetic one).  devfs stays on /dev (vfs_switch_root() keeps it there).  This is how
+ * the iOS root volume on the phone's flash becomes the root: the kernel starts from the
+ * small image, whose init mounts the volume, puts in place what the system needs on it
+ * and then asks for this (userland/src/init.c, boot-arg root_apfs=).  Process 1 only, once.
+ */
+static int redwood_root_switched;
+
+static int
+redwood_sysctl_switch_root SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char buf[512], *outgoing;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, redwood_root_switched ? "1" : "0", 2);
+	}
+	if (proc_getpid(current_proc()) != 1 || suser(kauth_cred_get(), NULL) != 0) {
+		return EPERM;
+	}
+	if (redwood_root_switched) {
+		return EBUSY;
+	}
+	if (req->newlen == 0 || req->newlen >= sizeof(buf)) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, buf, req->newlen);
+	if (error) {
+		return error;
+	}
+	buf[req->newlen] = '\0';
+	outgoing = strchr(buf, ' ');
+	if (outgoing == NULL || buf[0] != '/') {
+		return EINVAL;
+	}
+	*outgoing++ = '\0';
+	error = vfs_switch_root(buf, outgoing, 0);
+	printf("redwood: %s is the root now, the one before it on /%s: %d\n", buf, outgoing, error);
+	if (error == 0) {
+		redwood_root_switched = 1;
+	}
+	return error;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, redwood_switch_root, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, redwood_sysctl_switch_root, "A",
+    "write \"INCOMING OUTGOING\": the volume on INCOMING becomes the root (process 1, once)");
+
+/*
+ * apfs_volume=DEV: a volume for user space in an ordinary boot.  Mounted read only (and
+ * nosuid, nodev) on apfs_volume_at -- by default /System/Volumes/iOS, which the system image
+ * has for it (userland/build.sh) -- right here, after the root and devfs and before launchd,
+ * so that all of user space sees it from the start.  apfs_volume=ufs_darwin is the iOS root
+ * container on the phone's flash (ufs=2 for the loader, bootcpu=7).
+ */
+static void
+apfs_volume_mount(void)
+{
+	char dev[48], at[256] = "/System/Volumes/iOS", path[64];
+	vfs_context_t ctx = vfs_context_kernel();
+	uint64_t t0, ns = 0;
+	vnode_t vp = NULLVP;
+	int error, tries;
+
+	if (!PE_parse_boot_arg_str("apfs_volume", dev, sizeof(dev)) || dev[0] == '\0') {
+		return;
+	}
+	(void)PE_parse_boot_arg_str("apfs_volume_at", at, sizeof(at));
+	snprintf(path, sizeof(path), "/dev/%s", dev);
+	/* a node devfs_make_node() has just made is not in /dev at once (see apfs_check_thread) */
+	for (tries = 0; tries < 100; tries++) {
+		if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+			vnode_put(vp);
+			break;
+		}
+		delay_for_interval(50, NSEC_PER_MSEC);
+	}
+	t0 = mach_absolute_time();
+	error = kernel_mount("apfs", NULLVP, NULLVP, at, path, 0,
+	    MNT_RDONLY | MNT_NOSUID | MNT_NODEV, KERNEL_MOUNT_NOAUTH, ctx);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (error) {
+		printf("apfs: mounting %s on %s failed: %d\n", path, at, error);
+	} else {
+		printf("apfs: %s mounted on %s, read only, in %llu ms\n", path, at, ns / 1000000);
+	}
+}
+
+void
+redwood_apfs_check_init(void)
+{
+	uint32_t mode = 0;
+	thread_t th;
+
+	apfs_volume_mount();
+
+	if (!PE_parse_boot_argn("apfs_check", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	if (mode >= 4) {
+		/*
+		 * The volume is the root (or mode 6, which mounts it here), and bsd_init is
+		 * about to exec /sbin/launchd off it, which on anything but an image of ours
+		 * (stage0 as /sbin/launchd) ends in a panic.  So the walk has to be over before this returns.
+		 *
+		 * It does not run on this thread, though.  This is the boot thread: it runs
+		 * above the threads that service thread calls, and a walk off a RAM disk never
+		 * blocks, so for as long as it lasts no thread call runs at all -- not even
+		 * the one that feeds the phone's watchdog every ten seconds.  On the phone a
+		 * walk past half a minute was reset with no log to say why; in QEMU, which
+		 * has no such watchdog, the same walk let not one 6-second timer fire in 72 s.
+		 * So the walk gets a thread of ordinary priority, and this one sleeps until
+		 * it is done.
+		 */
+		thread_t th;
+
+		apfs_check_finished = 0;
+		if (kernel_thread_start(apfs_check_runner, (void *)(uintptr_t)mode, &th) !=
+		    KERN_SUCCESS) {
+			printf("apfs-check: cannot start the thread\n");
+			return;
+		}
+		thread_deallocate(th);
+		while (!apfs_check_finished) {
+			delay_for_interval(100, NSEC_PER_MSEC);     /* sleeps */
+		}
+		printf("apfs-check: going back to the loader\n");
+		loader_return();
+		return;
+	}
+	if (kernel_thread_start(apfs_check_thread, (void *)(uintptr_t)mode, &th) !=
+	    KERN_SUCCESS) {
+		printf("apfs-check: cannot start the thread\n");
+		return;
+	}
+	thread_deallocate(th);
+}
diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
new file mode 100644
index 0000000..e6ba1ec
--- /dev/null
+++ b/bsd/dev/redwood_apple80211.c
@@ -0,0 +1,740 @@
+/*
+ * Darwin-on-redwood: Apple80211, answered in the kernel.
+ *
+ * iOS's Wi-Fi side -- wifid, and through it Settings and the status bar -- talks to a Wi-Fi
+ * driver in requests that were once ioctls and are, where the driver offers no user client,
+ * ioctls still: SIOCGA80211 and SIOCSA80211 on any socket, with a struct apple80211req that
+ * names the interface, a request type, a value, and a buffer in the caller's memory
+ * (IO80211.framework: Apple80211Get/Set and their kin all end there). XNU hands an interface
+ * ioctl it does not know to the interface, so they arrive in bsd/dev/redwood_net.c, which
+ * passes them here when its link is a radio.
+ *
+ * What is asked is answered from the station boundary (sys/redwood_sta.h): the radio's power,
+ * its channels, a scan and what it heard, the network joined. What happens there by itself is
+ * told to iOS the way a driver tells it: kernel events of class 6 (IEEE 802.11), subclass 1,
+ * whose code is Apple80211's own event number and whose data begins with the interface's name
+ * in 16 bytes (IO80211.framework reads them from a PF_SYSTEM socket and compares the name).
+ *
+ * Every request is still written to the log -- who asks, get or set, the type, the value, the
+ * length -- because which of them wifid needs is found that way. Never what a request carries:
+ * a network's name or its key may be in there.
+ *
+ * The request types and the layouts are Apple's. The old ones are as the headers of its open
+ * IO80211 sources once described them (apple80211_ioctl.h, apple80211_var.h); where iOS 16.5
+ * differs the layout was read out of IO80211.framework of 16.5, which fills and reads the same
+ * structures on the other side (Apple80211GetWithIOCTL, _getScanData, _addScanResultToList,
+ * _performAssociation, _dispatchAsyncAssocEvent, _dispatchLinkChangedEvent).
+ *
+ * A join: ASSOCIATE (20) carries the network's name, perhaps its access point, and the
+ * passphrase as typed (the framework does not make the key of it), and is answered at once;
+ * when the station has joined or failed, event 9 says so, and ASSOCIATE_RESULT (21) gives the
+ * outcome as one of Apple80211's result numbers, which the framework turns into its errors:
+ * 1 success, 21 "invalid PMK" (a wrong passphrase), 9 a timeout, 2 anything else.
+ */
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <sys/errno.h>
+#include <sys/kern_event.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <sys/redwood_input.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+
+#define SIOCSA80211             0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211             0xc02869c9u     /* _IOWR('i', 201, struct apple80211req) */
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+/* (as far as they have come by: the names help reading the log) */
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts ------------------------------------------------------------------------------------------ */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u           /* the radio may send there */
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+/* SUPPORTED_CHANNELS (27) and HW_SUPPORTED_CHANNELS (254): 4824 bytes */
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+/* CHANNELS_INFO (207): 10016 bytes; of each channel a byte in each of several rows, and a word of flags */
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+/* SCAN_REQ (10): 5456 bytes */
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;                     /* 1: asking, 2: listening only */
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;                    /* networks asked for by name, each in 56 bytes */
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+/* SCAN_RESULT (11) and CURRENT_NETWORK (103): 1164 bytes */
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];                     /* Mbit/s */
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;               /* comes in as the room there is */
+	uint8_t elements[1024];
+};
+
+/* ASSOCIATE (20): 592 bytes; of what follows the key (the RSN element wifid built, flags) nothing is used */
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;   /* cipher 10: a passphrase as typed; 6: the key (from 64 hex digits) */
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* the link event's data (at least 32 bytes, or the framework drops the event) */
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as iOS 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as iOS 16.5 has it");
+
+/* Apple80211's events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = "en0";   /* (bsd/dev/redwood_net.c makes one interface, and that is its name) */
+
+static LCK_GRP_DECLARE(apple80211_lock_group, "redwood-apple80211");
+static LCK_MTX_DECLARE(apple80211_lock, &apple80211_lock_group);
+static unsigned result_next;                    /* which of what the last scan heard a SCAN_RESULT request gets next */
+static uint32_t join_result;                    /* of the last join asked for: 0 while it runs, then Apple80211's number */
+
+/* ---- channels ---------------------------------------------------------------------------------------- */
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static unsigned
+channel_frequency(const struct apple80211_channel *channel)
+{
+	bool low = channel->flags & CHANNEL_2GHZ ? true : channel->flags & CHANNEL_5GHZ ? false : channel->channel <= 14;
+
+	if (channel->channel == 0 || channel->channel > 196 || (channel->flags & 0x2000)) {     /* (0x2000: 6 GHz) */
+		return 0;
+	}
+	return low ? (channel->channel == 14 ? 2484 : 2407 + 5 * channel->channel) : 5000 + 5 * channel->channel;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency, unsigned flags)
+{
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (flags & REDWOOD_STA_CHANNEL_PASSIVE ?
+	    0 : CHANNEL_ACTIVE) | (flags & REDWOOD_STA_CHANNEL_RADAR ? CHANNEL_DFS : 0);
+}
+
+/* ---- what the caller is given back ------------------------------------------------------------------- */
+
+/* At most as many bytes as it has room for. */
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+/* An access point in the form a scan's result has; the caller has said how much room for elements there is. */
+static int
+give_network(const struct apple80211req *request, const struct redwood_sta_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements);
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->frequency, 0);
+	result->rssi = bss->rssi;
+	result->beacon_interval = bss->beacon_interval;
+	result->capability = bss->capability;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = bss->ssid_length;
+	memcpy(result->ssid, bss->ssid, bss->ssid_length);
+	result->age_ms = bss->age_ms;
+	result->elements_length = (uint16_t)(bss->elements_length <= room ? bss->elements_length : 0);
+	memcpy(result->elements, bss->elements, result->elements_length);
+	/* the rates it says it has (elements 1 and 50: units of 500 kbit/s, the top bit marks the ones everybody must have) */
+	for (unsigned at = 0; at + 2 <= bss->elements_length && at + 2 + bss->elements[at + 1] <= bss->elements_length;
+	    at += 2 + bss->elements[at + 1]) {
+		for (unsigned i = 0; (bss->elements[at] == 1 || bss->elements[at] == 50) && i < bss->elements[at + 1]; i++) {
+			unsigned rate = (bss->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* ---- get ---------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct redwood_sta_state *state;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* the driver's and the hardware's name: the text alone, in 256 bytes */
+		static const char name[256] = "redwood: ath11k for the WCN6750";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {
+		/*
+		 * What the card can do, a bit each (apple80211_var.h: APPLE80211_CAP_*): the 13 bytes are the
+		 * bits alone, from the first (the framework hands in a buffer that begins after the old
+		 * header's version word). AES, AES-CCM, power management, short slot and preamble, WPA2, WME,
+		 * short guard interval at 20 MHz. Read wrong, the framework sees no WPA2 and builds no join
+		 * for a WPA2 network ("Unable to join").
+		 */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* the radio's power: one radio. Until the driver is up it counts as on: it */
+		struct {                        /* is being brought up, and iOS asks this once, early */
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !redwood_sta_present() || redwood_sta_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* the mode: a station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 27:
+	case 254: {                             /* the channels the radio may tune to */
+		struct apple80211_channels *answer;
+		struct redwood_sta_channel channels[96];
+		unsigned count = redwood_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = count;
+		for (unsigned i = 0; i < count; i++) {
+			channel_fill(&answer->channels[i], channels[i].frequency, channels[i].flags);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {                             /* ... and more of each */
+		struct apple80211_channels_info *answer;
+		struct redwood_sta_channel channels[96];
+		unsigned count = redwood_sta_channels(channels, 96);
+
+		if (count == 0 || (answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO)) == NULL) {
+			return count == 0 ? ENXIO : ENOMEM;
+		}
+		answer->count = (uint16_t)count;
+		for (unsigned i = 0; i < count; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channels[i].frequency, channels[i].flags);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = (channels[i].flags & REDWOOD_STA_CHANNEL_RADAR) != 0;
+			answer->passive[i] = (channels[i].flags & REDWOOD_STA_CHANNEL_PASSIVE) != 0;
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:                                /* how the last join went (0: not over yet) */
+		lck_mtx_lock(&apple80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&apple80211_lock);
+		return 0;
+	case 11: {                              /* what the last scan heard, one access point a request; EIO: that was all */
+		struct redwood_sta_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+		bool there;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&apple80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&apple80211_lock);
+		there = redwood_sta_heard(index, bss);
+		error = there ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	/* the rest is about the network joined, and there is none unless the station says so */
+	if ((state = kalloc_data(sizeof(*state), Z_WAITOK)) == NULL) {
+		return ENOMEM;
+	}
+	redwood_sta_state(state);
+	switch (request->req_type) {
+	case 13:                                /* the state: APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = state->phase == REDWOOD_STA_JOINED ? 4 : state->phase == REDWOOD_STA_JOINING ? 2 :
+		    state->phase == REDWOOD_STA_SCANNING ? 1 : 0;
+		break;
+	case 1:                                 /* its name; the length goes back in the request */
+		if (state->phase != REDWOOD_STA_JOINED) {
+			error = ENXIO;
+		} else if ((error = give(request, state->bss.ssid, state->bss.ssid_length)) == 0) {
+			request->req_len = state->bss.ssid_length;
+		}
+		break;
+	case 9:                                 /* its access point's address */
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, state->bss.bssid, 6);
+		break;
+	case 4: {                               /* its channel */
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (state->phase != REDWOOD_STA_JOINED) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, state->bss.frequency, 0);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {                              /* how strongly it is heard: dBm, per radio and all together, twice over */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { state->bss.rssi }, .all = state->bss.rssi,
+			     .each_ext = { state->bss.rssi }, .all_ext = state->bss.rssi };
+
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 103:                               /* all of it, as a scan's result */
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give_network(request, &state->bss);
+		break;
+	case 2: {                               /* how it was joined: open system, then WPA2 with a passphrase */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = 8 };
+
+		error = state->phase != REDWOOD_STA_JOINED ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(state, sizeof(*state));
+	return error;
+}
+
+/* ---- set ---------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	struct redwood_sta_scan *what;
+	unsigned unknown = 0;
+	int error;
+
+	/* iOS 26's wifid sends 5528 bytes (72 more than the layout above, iOS 16's): the fields above are read from its start */
+	if (request->req_len < sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!redwood_sta_present()) {
+		return EBUSY;                   /* (the radio is still being brought up: the framework tries again) */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, sizeof(*asked))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	if (asked->ssid_length <= sizeof(what->ssid)) {
+		what->ssid_length = (uint8_t)asked->ssid_length;
+		memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	}
+	what->passive = asked->scan_type == 2;
+	what->dwell_ms = asked->dwell_ms;
+	/* (more channels than there is room to name: every channel) */
+	for (unsigned i = 0; i < asked->channel_count && i < 400 && asked->channel_count <= 64; i++) {
+		unsigned frequency = channel_frequency(&asked->channels[i]);
+
+		if (frequency != 0) {
+			what->frequencies[what->frequency_count++] = (uint16_t)frequency;
+		} else {
+			unknown++;
+		}
+	}
+	snprintf(said, said_size, " (a scan: type %u, %u channels of which %u are not the radio's, %u ms on each, a name of %u bytes, "
+	    "%u more names, flags %#llx)", asked->scan_type, asked->channel_count, unknown, asked->dwell_ms, asked->ssid_length,
+	    asked->name_count, asked->flags);
+	if (asked->channel_count != 0 && asked->channel_count <= 64 && what->frequency_count == 0) {
+		error = EINVAL;                 /* (nothing of what is asked for is a channel of this radio's) */
+	} else {
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		error = redwood_sta_ask_scan(what);
+	}
+out:
+	if (asked != NULL) {
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_assoc *asked;
+	struct redwood_sta_join *what;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	what = kalloc_data(sizeof(*what), Z_WAITOK | Z_ZERO);
+	if (asked == NULL || what == NULL || (error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		error = asked == NULL || what == NULL ? ENOMEM : error;
+		goto out;
+	}
+	/* (lengths and kinds only: the name, the access point and the key stay out of the log) */
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5] ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > sizeof(what->ssid)) {
+		error = EINVAL;
+		goto out;
+	}
+	what->ssid_length = (uint8_t)asked->ssid_length;
+	memcpy(what->ssid, asked->ssid, asked->ssid_length);
+	memcpy(what->bssid, asked->bssid, sizeof(what->bssid));
+	if (asked->key_length == 0) {
+		what->security = REDWOOD_STA_OPEN;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= 8 && asked->key_length <= 63) {
+		what->security = REDWOOD_STA_WPA2_PSK;
+		what->passphrase_length = (uint8_t)asked->key_length;
+		memcpy(what->passphrase, asked->key, asked->key_length);
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == sizeof(what->pmk)) {
+		what->security = REDWOOD_STA_WPA2_PSK;
+		memcpy(what->pmk, asked->key, sizeof(what->pmk));
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&apple80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&apple80211_lock);
+	error = redwood_sta_ask_join(what);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (what != NULL) {
+		memset_s(what, sizeof(*what), 0, sizeof(*what));
+		kfree_data(what, sizeof(*what));
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:                                /* leave the network */
+		return redwood_sta_ask_leave();
+	case 19: {                              /* the radio's power */
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked) || (error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return request->req_len < sizeof(asked) ? EINVAL : error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return redwood_sta_ask_power(asked.state[0] != 0);
+	}
+	case 10:
+		return set_scan(request, said, said_size);
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events -------------------------------------------------------------------------------------------- */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+/* What the station side says has happened (bsd/dev/redwood_sta.c calls this, on its thread or the station's). */
+void
+redwood_apple80211_event(enum redwood_sta_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("apple80211: the station says: %s, %d\n", event == REDWOOD_STA_POWER ? "power" : event == REDWOOD_STA_SCAN_DONE ?
+		    "a scan is over" : event == REDWOOD_STA_JOIN_DONE ? "a join is over" : "the link", status);
+	}
+	switch (event) {
+	case REDWOOD_STA_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case REDWOOD_STA_SCAN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case REDWOOD_STA_JOIN_DONE:
+		lck_mtx_lock(&apple80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&apple80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case REDWOOD_STA_LINK: {
+		struct apple80211_link_changed link = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };      /* (4: gone, not asked) */
+		struct redwood_sta_state *state = kalloc_data(sizeof(*state), Z_WAITOK | Z_ZERO);
+
+		if (state != NULL) {
+			redwood_sta_state(state);
+			link.rssi = status == 1 ? state->bss.rssi : 0;
+			kfree_data(state, sizeof(*state));
+		}
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &link, sizeof(link));
+		break;
+	}
+	}
+}
+
+/* ---- the requests as they arrive --------------------------------------------------------------------- */
+
+/*
+ * How often each kind of request came and how it fared: said when the run ends, because the
+ * lines said along the way can be lost with the middle of a long log.
+ */
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+} kinds[96];
+static unsigned kind_count;
+
+static void
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	unsigned i;
+
+	lck_mtx_lock(&apple80211_lock);
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count++] = (typeof(kinds[0])) { .type = request->req_type, .set = is_set };
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+	}
+	lck_mtx_unlock(&apple80211_lock);
+}
+
+void
+redwood_apple80211_summary(void)
+{
+	static bool said;
+
+	if (said) {
+		return;
+	}
+	said = true;
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("apple80211: in this run: %s %d (%s) %u times, answered %u times%s", kinds[i].set ? "set" : "get", kinds[i].type,
+		    type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error == 0 ? "\n" : "");
+		if (kinds[i].last_error != 0) {
+			printf("; the last refusal: %d%s\n", kinds[i].last_error, kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+		}
+	}
+}
+
+/* An Apple80211 request for the radio's interface, from the process that is running now. */
+errno_t
+redwood_apple80211_ioctl(u_long command, void *data)
+{
+	static unsigned said;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211;
+	int error;
+
+	if (command != SIOCSA80211 && command != SIOCGA80211) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	error = is_set ? set(request, what, sizeof(what)) : get(request);
+	note(request, is_set, error);
+	/* (a request that is repeated for ever is said a few hundred times) */
+	if (said < 800) {
+		said++;
+		printf("apple80211: %s %s %d (%s), value %d, %u bytes%s: %s", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered\n" : error ==
+		    EOPNOTSUPP ? "REFUSED\n" : "");
+		if (error != 0 && error != EOPNOTSUPP) {
+			printf("error %d\n", error);
+		}
+	}
+	return error;
+}
diff --git a/bsd/dev/redwood_audio.c b/bsd/dev/redwood_audio.c
new file mode 100644
index 0000000..d8b4637
--- /dev/null
+++ b/bsd/dev/redwood_audio.c
@@ -0,0 +1,355 @@
+/*
+ * /dev/redwood-audio: the sound that iOS plays (see sys/redwood_audio.h).
+ *
+ * What is written goes two ways:
+ *
+ *   to a sink   a driver that plays it: the virtio sound device under QEMU
+ *               (redwood_virtio_sound.c). On the phone there is none yet (redwood_speaker.c
+ *               is where it begins).
+ *
+ *   into a recording, with boot-arg rec_sound=N: the first N seconds of sound are also kept
+ *               in one piece of memory that is left in place when the kernel returns to the
+ *               loader, which hands it to the host ("xl sound"; under QEMU, the monitor's
+ *               pmemsave), where tools/sound.py makes a WAV file of it. Only what is played
+ *               takes room, the silence in between does not: every write is stored with the
+ *               time it was made.
+ *
+ *                 struct rec_header, then per write: struct rec_block, frames * 4 bytes
+ *
+ *               With rec_sound_fed=1 as well, the recording has instead what the speakers' guard
+ *               let through (redwood_guard.c, on the phone): what reaches the amplifiers. With
+ *               rec_sound_mic=1, what the main microphone hears (redwood_mic.c, mic=3), in both
+ *               channels.
+ *
+ * When the writer has stopped, a line in the log says how long it wrote, at what rate, how much
+ * of it was not silence and how loud: the only way to "hear" a machine one cannot listen to.
+ * (The audio server writes for as long as its device runs, a second or two beyond the sound.)
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <miscfs/devfs/devfs.h>
+#include <pexpert/pexpert.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/redwood_audio.h>
+#include <sys/systm.h>
+#include <sys/uio.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>  /* xnu-12377: KMA_*/kmem_alloc moved to the internal header */
+
+extern uint64_t kvtophys(vm_offset_t va);       /* pmap_paddr_t */
+
+#define CHUNK_FRAMES    1024            /* what one pass of write() moves */
+#define QUIET_MS        500             /* no write for this long: the writer has stopped */
+#define SILENCE         8               /* samples no larger than this are silence */
+#define REC_MAX_SECONDS 1200            /* 220 MB */
+
+struct rec_header {
+	char     magic[8];              /* "RWSND001" */
+	uint32_t rate, channels;        /* REDWOOD_AUDIO_RATE, REDWOOD_AUDIO_CHANNELS; the samples are 16-bit */
+	uint32_t blocks;
+	uint32_t reserved;
+};
+struct rec_block {
+	uint64_t nanoseconds;           /* when it was written, since the kernel started */
+	uint32_t frames;
+	uint32_t reserved;
+};
+
+/* { physical address, bytes, kernel address } of the recording, for the loader: osfmk/arm64/loader_return.c */
+extern uint64_t loader_sound[3];
+
+static LCK_GRP_DECLARE(audio_lck_grp, "redwood-audio");
+static LCK_MTX_DECLARE(audio_lock, &audio_lck_grp);
+
+static redwood_audio_sink_t audio_sink;
+
+static uint8_t *rec_base;
+static bool rec_fed;                    /* boot-arg rec_sound_fed=1: what the guard let through is recorded, not what was written */
+static bool rec_mic;                    /* boot-arg rec_sound_mic=1: what the microphone hears (redwood_mic.c) */
+static uint64_t rec_size, rec_used;
+static uint64_t rec_frames, rec_frames_max;
+
+/* the stretch of writing in progress */
+static uint64_t stretch_first, stretch_last;    /* mach_absolute_time() of its first and its latest write */
+static uint64_t stretch_frames, stretch_latest; /* frames written, and how many of them by the latest write */
+static uint64_t stretch_sound, stretch_lost;    /* frames in writes that were not silence; frames the sink did not take */
+static uint32_t stretch_peak;                   /* the largest sample, as an absolute value */
+static thread_call_t report_call;
+static bool report_armed;
+
+static void
+audio_report(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t frames, latest, sound, lost, deadline, since = 0, lasted = 0;
+	uint32_t loudest;
+
+	lck_mtx_lock(&audio_lock);
+	absolutetime_to_nanoseconds(mach_absolute_time() - stretch_last, &since);
+	if (since < QUIET_MS * NSEC_PER_MSEC) {
+		/* still writing: look again later */
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+		lck_mtx_unlock(&audio_lock);
+		return;
+	}
+	absolutetime_to_nanoseconds(stretch_last - stretch_first, &lasted);
+	frames = stretch_frames;
+	latest = stretch_latest;
+	sound = stretch_sound;
+	lost = stretch_lost;
+	loudest = stretch_peak;
+	stretch_frames = stretch_sound = stretch_lost = 0;
+	stretch_peak = 0;
+	report_armed = false;
+	lck_mtx_unlock(&audio_lock);
+
+	printf("redwood-audio: %llu.%02llu s written", frames / REDWOOD_AUDIO_RATE,
+	    frames % REDWOOD_AUDIO_RATE * 100 / REDWOOD_AUDIO_RATE);
+	if (lasted >= NSEC_PER_SEC) {
+		/* what was written before the latest write took the time between the first and the latest */
+		printf(" at %llu frames a second", (frames - latest) * NSEC_PER_SEC / lasted);
+	}
+	printf(", %llu.%02llu s of it sound, peak %u%% of full scale", sound / REDWOOD_AUDIO_RATE,
+	    sound % REDWOOD_AUDIO_RATE * 100 / REDWOOD_AUDIO_RATE, loudest * 100 / 32768);
+	if (lost) {
+		printf(", %llu ms lost (the sink was full)", lost * 1000 / REDWOOD_AUDIO_RATE);
+	}
+	printf("\n");
+}
+
+/* With audio_lock held. */
+static void
+audio_record(const int16_t *frames, uint32_t count)
+{
+	struct rec_header *header = (struct rec_header *)rec_base;
+	struct rec_block *block;
+	uint64_t bytes = (uint64_t)count * REDWOOD_AUDIO_FRAME;
+
+	if (rec_base == NULL || rec_frames >= rec_frames_max || rec_used + sizeof(*block) + bytes > rec_size) {
+		return;
+	}
+	block = (struct rec_block *)(rec_base + rec_used);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &block->nanoseconds);
+	block->frames = count;
+	block->reserved = 0;
+	memcpy(block + 1, frames, bytes);
+	rec_used += sizeof(*block) + bytes;
+	rec_frames += count;
+	header->blocks++;
+	loader_sound[1] = rec_used;
+	if (rec_frames >= rec_frames_max) {
+		printf("redwood-audio: recording finished: %llu s in %u writes\n", rec_frames / REDWOOD_AUDIO_RATE, header->blocks);
+	}
+}
+
+bool
+redwood_audio_recording_fed(void)
+{
+	return rec_fed && rec_base != NULL && rec_frames < rec_frames_max;
+}
+
+bool
+redwood_audio_recording_mic(void)
+{
+	return rec_mic && rec_base != NULL && rec_frames < rec_frames_max;
+}
+
+/* From the speakers' feeder: what the guard let through, into the recording (rec_sound_fed=1). */
+void
+redwood_audio_record_fed(const int16_t *frames, uint32_t count)
+{
+	lck_mtx_lock(&audio_lock);
+	audio_record(frames, count);
+	lck_mtx_unlock(&audio_lock);
+}
+
+static void
+audio_play(const int16_t *frames, uint32_t count)
+{
+	uint32_t loudest = 0, taken = 0;
+	uint64_t deadline;
+
+	for (uint32_t i = 0; i < count * REDWOOD_AUDIO_CHANNELS; i++) {
+		uint32_t level = frames[i] < 0 ? -(int32_t)frames[i] : frames[i];
+
+		if (level > loudest) {
+			loudest = level;
+		}
+	}
+	lck_mtx_lock(&audio_lock);
+	if (!rec_fed && !rec_mic) {
+		audio_record(frames, count);
+	}
+	if (audio_sink != NULL) {
+		taken = audio_sink(frames, count);
+		stretch_lost += count - taken;
+	}
+	stretch_last = mach_absolute_time();
+	if (stretch_frames == 0) {
+		stretch_first = stretch_last;
+	}
+	stretch_frames += count;
+	stretch_latest = count;
+	if (loudest > SILENCE) {
+		stretch_sound += count;
+	}
+	if (loudest > stretch_peak) {
+		stretch_peak = loudest;
+	}
+	if (!report_armed && report_call != NULL) {
+		report_armed = true;
+		clock_interval_to_deadline(2 * QUIET_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(report_call, deadline);
+	}
+	lck_mtx_unlock(&audio_lock);
+}
+
+void
+redwood_audio_set_sink(const char *name, redwood_audio_sink_t sink)
+{
+	lck_mtx_lock(&audio_lock);
+	audio_sink = sink;
+	lck_mtx_unlock(&audio_lock);
+	printf("redwood-audio: sound goes to %s\n", name);
+}
+
+static int
+audio_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+audio_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t frames[CHUNK_FRAMES * REDWOOD_AUDIO_CHANNELS];
+	int error = 0;
+
+	while (uio_resid(uio) >= REDWOOD_AUDIO_FRAME) {
+		user_ssize_t bytes = uio_resid(uio);
+
+		if (bytes > (user_ssize_t)sizeof(frames)) {
+			bytes = sizeof(frames);
+		}
+		bytes -= bytes % REDWOOD_AUDIO_FRAME;
+		error = uiomove((caddr_t)frames, (int)bytes, uio);
+		if (error) {
+			break;
+		}
+		audio_play(frames, (uint32_t)(bytes / REDWOOD_AUDIO_FRAME));
+	}
+	return error;
+}
+
+/* the speakers' volume, as iOS sets it (sys/redwood_audio.h): kept for the sink's driver to look at */
+static uint32_t volume_below, volume_generation;
+static bool volume_muted;
+
+static int
+audio_ioctl(__unused dev_t dev, u_long command, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	const struct redwood_audio_volume *volume = (const struct redwood_audio_volume *)data;
+
+	if (command != REDWOOD_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	lck_mtx_lock(&audio_lock);
+	volume_below = volume->below;
+	volume_muted = volume->muted != 0;
+	volume_generation++;
+	lck_mtx_unlock(&audio_lock);
+	printf("redwood-audio: the volume: %s%u.%03u dB under the loudest\n", volume->muted ? "muted; " : "", volume->below / 8,
+	    volume->below % 8 * 125);
+	return 0;
+}
+
+bool
+redwood_audio_volume(uint32_t *below, bool *muted, uint32_t *generation)
+{
+	lck_mtx_lock(&audio_lock);
+	*below = volume_below;
+	*muted = volume_muted;
+	*generation = volume_generation;
+	lck_mtx_unlock(&audio_lock);
+	return *generation != 0;
+}
+
+static const struct cdevsw audio_cdevsw = {
+	.d_open = audio_open, .d_close = audio_close, .d_read = eno_rdwrt, .d_write = audio_write,
+	.d_ioctl = audio_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+audio_recording_init(void)
+{
+	struct rec_header *header;
+	uint32_t seconds = 0, fed = 0;
+	vm_offset_t memory = 0;
+	uint64_t size;
+
+	if (!PE_parse_boot_argn("rec_sound", &seconds, sizeof(seconds)) || seconds == 0) {
+		return;
+	}
+	if (seconds > REC_MAX_SECONDS) {
+		seconds = REC_MAX_SECONDS;
+	}
+	/* the samples, and a block header for every write of ten milliseconds or more */
+	size = sizeof(*header) + (uint64_t)seconds * (REDWOOD_AUDIO_RATE * REDWOOD_AUDIO_FRAME + 100 * sizeof(struct rec_block));
+	size = round_page(size);
+	/* one piece of physical memory: the loader will send it over USB as it lies */
+	if (kmem_alloc_contig(kernel_map, &memory, size, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("redwood-audio: no memory for a recording of %u s (%llu MB)\n", seconds, size >> 20);
+		return;
+	}
+	header = (struct rec_header *)memory;
+	memcpy(header->magic, "RWSND001", 8);
+	header->rate = REDWOOD_AUDIO_RATE;
+	header->channels = REDWOOD_AUDIO_CHANNELS;
+	rec_size = size;
+	rec_used = sizeof(*header);
+	rec_frames_max = (uint64_t)seconds * REDWOOD_AUDIO_RATE;
+	rec_base = (uint8_t *)memory;
+	loader_sound[0] = kvtophys(memory);
+	loader_sound[1] = rec_used;
+	loader_sound[2] = (uint64_t)memory;
+	PE_parse_boot_argn("rec_sound_fed", &fed, sizeof(fed));
+	rec_fed = fed != 0;
+	fed = 0;
+	PE_parse_boot_argn("rec_sound_mic", &fed, sizeof(fed));
+	rec_mic = fed != 0;
+	printf("redwood-audio: recording the first %u s of sound%s, into %llu MB at %#llx\n", seconds,
+	    rec_fed ? " as the speakers' guard lets it through" : rec_mic ? " the microphone hears (in both channels)" : "", size >> 20,
+	    loader_sound[0]);
+}
+
+void
+redwood_audio_init(void)
+{
+	int major = cdevsw_add(-1, &audio_cdevsw);
+
+	if (major < 0 || devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio") == NULL) {
+		printf("redwood-audio: cannot create the device\n");
+		return;
+	}
+	report_call = thread_call_allocate(audio_report, NULL);
+	audio_recording_init();
+	redwood_virtio_sound_init();
+	redwood_speaker_init();
+	redwood_haptic_init();
+	redwood_torch_init();
+	redwood_camera_init();
+}
diff --git a/bsd/dev/redwood_battery.c b/bsd/dev/redwood_battery.c
new file mode 100644
index 0000000..6e80b4d
--- /dev/null
+++ b/bsd/dev/redwood_battery.c
@@ -0,0 +1,198 @@
+/*
+ * Battery monitor for Xiaomi redwood (POCO X5 Pro).
+ *
+ * Redwood selects PM7325B and qcom,battery-charger over PMIC GLINK/ADSP, not
+ * the local PM7250B/QG layout.  The resident UEFI contains the matching
+ * Qualcomm charger drivers.  xnuloader owns that firmware context on core 0,
+ * polls it, and publishes a read-only cache; XNU only consumes that cache.
+ * Charger limits and JEITA protection therefore remain firmware-owned.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define LOADER_BATTERY_MAGIC            0x2154544142574452ULL
+#define LOADER_BATTERY_VERSION          1
+#define LOADER_BATTERY_VALID            (1u << 0)
+#define LOADER_BATTERY_PRESENT          (1u << 1)
+#define LOADER_BATTERY_CHARGER_PRESENT  (1u << 2)
+#define LOADER_BATTERY_VOLTAGE_VALID    (1u << 3)
+#define LOADER_BATTERY_CHARGING         (1u << 4)
+#define LOADER_BATTERY_SOC_ESTIMATED    (1u << 5)
+#define LOADER_PAGE_SIZE                0x4000UL
+
+struct loader_battery {
+	uint64_t magic;
+	uint32_t version, size;
+	volatile uint32_t sequence;
+	uint32_t flags;
+	int32_t soc_percent, voltage_mv, current_ma, temperature_c;
+	uint32_t charger_action, polls, failures, reserved;
+};
+
+static volatile struct loader_battery *shared_battery;
+static int battery_soc_percent = -1, battery_voltage_mv = -1, battery_current_ma;
+static int battery_temperature_c = -273, battery_present, battery_charger_present;
+static int battery_charging, battery_soc_estimated, battery_charger_action = -1;
+static uint64_t battery_updates, battery_failures;
+
+/* for others in the kernel (the flashlight's thermal guard): -273 while it is not known */
+int
+redwood_battery_temperature(void)
+{
+	return battery_temperature_c;
+}
+
+SYSCTL_NODE(_kern, OID_AUTO, redwood, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "redwood phone bits");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_soc, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_percent, 0, "battery state of charge, 0..100 percent, or -1 if unknown");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_voltage_mv, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_voltage_mv, 0, "battery voltage in millivolts, or -1 if unknown");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_current_ma, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_current_ma, 0, "battery current reported by Qualcomm firmware, in milliamps");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_temperature_c, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_temperature_c, 0, "battery temperature reported by Qualcomm firmware, in Celsius");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_present, 0, "1 if Qualcomm firmware reports a battery");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charger_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_present, 0, "1 if Qualcomm firmware reports an attached charger");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charging, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charging, 0, "1 while an attached charger is charging a non-full battery");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_soc_estimated, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_estimated, 0, "1 only when SOC had to be estimated from voltage");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charger_action, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_action, 0, "last Qualcomm charger action, for diagnostics");
+
+static bool
+battery_snapshot(struct loader_battery *out)
+{
+	uint32_t before, after;
+
+	for (unsigned retry = 0; retry < 4; retry++) {
+		before = shared_battery->sequence;
+		if (before & 1) continue;
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		memcpy(out, (const void *)(uintptr_t)shared_battery, sizeof(*out));
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		after = shared_battery->sequence;
+		if (before == after && !(after & 1)) return true;
+	}
+	return false;
+}
+
+static void
+battery_poll(void)
+{
+	struct loader_battery sample;
+
+	if (!battery_snapshot(&sample) || sample.magic != LOADER_BATTERY_MAGIC ||
+	    sample.version != LOADER_BATTERY_VERSION || sample.size < sizeof(sample) ||
+	    !(sample.flags & LOADER_BATTERY_VALID) || sample.soc_percent < 0 || sample.soc_percent > 100) {
+		battery_failures++;
+		return;
+	}
+	battery_soc_percent = sample.soc_percent;
+	battery_voltage_mv = (sample.flags & LOADER_BATTERY_VOLTAGE_VALID) ? sample.voltage_mv : -1;
+	battery_current_ma = sample.current_ma;
+	battery_temperature_c = sample.temperature_c;
+	battery_present = (sample.flags & LOADER_BATTERY_PRESENT) != 0;
+	battery_charger_present = (sample.flags & LOADER_BATTERY_CHARGER_PRESENT) != 0;
+	battery_charging = (sample.flags & LOADER_BATTERY_CHARGING) != 0;
+	battery_soc_estimated = (sample.flags & LOADER_BATTERY_SOC_ESTIMATED) != 0;
+	battery_charger_action = (int)sample.charger_action;
+	battery_updates++;
+}
+
+/*
+ * What the audio DSP's battery manager says (bsd/dev/redwood_adsp.c, with adsp=1 unless battmgr=0):
+ * the values that Android shows, from where Android takes them. They are kept here for the sysctls
+ * and passed on to the power source that iOS reads (iokit/Kernel/RedwoodBattery.cpp).
+ */
+static int battery_full_uah, battery_design_uah, battery_cycles, battery_source_dsp;
+
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_full_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_full_uah, 0, "the battery's full charge as the fuel gauge has learnt it, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_design_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_design_uah, 0, "the battery's charge as designed, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_cycles, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_cycles, 0, "the battery's charge cycles (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_from_dsp, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_source_dsp, 0, "1 when the values come from the audio DSP's battery manager");
+
+extern void RedwoodBatteryReport(const void *state, unsigned size);     /* iokit/Kernel/RedwoodBattery.cpp */
+
+void
+redwood_battery_report(const struct redwood_battery_state *b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+
+	battery_soc_percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	battery_voltage_mv = b->voltage_uv / 1000;
+	battery_current_ma = b->current_ua / 1000;
+	battery_temperature_c = (b->temperature_hundredths + 50) / 100;
+	battery_present = b->present != 0;
+	battery_charger_present = b->external != 0;
+	battery_charging = b->status == 1;      /* POWER_SUPPLY_STATUS_CHARGING */
+	battery_soc_estimated = 0;
+	battery_charger_action = b->status;
+	if (b->full_uah > 0) {
+		battery_full_uah = b->full_uah;
+	}
+	if (b->design_uah > 0) {
+		battery_design_uah = b->design_uah;
+	}
+	if (b->cycles > 0) {
+		battery_cycles = b->cycles;
+	}
+	battery_source_dsp = 1;
+	battery_updates++;
+	RedwoodBatteryReport(b, sizeof(*b));
+}
+
+static void
+battery_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (unsigned tick = 0;; tick++) {
+		battery_poll();
+		if (tick % 12 == 0) {
+			printf("battery: SOC=%d%%%s, V=%d mV, I=%d mA, T=%d C, battery=%d charger=%d charging=%d "
+			    "action=%d (%llu reads, %llu failed)\n", battery_soc_percent,
+			    battery_soc_estimated ? " (voltage estimate)" : "", battery_voltage_mv,
+			    battery_current_ma, battery_temperature_c, battery_present, battery_charger_present,
+			    battery_charging, battery_charger_action, battery_updates, battery_failures);
+		}
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+void
+redwood_battery_init(void)
+{
+	uint32_t enabled = 0;
+	uint64_t shared_pa = 0;
+	vm_offset_t page;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("battery", &enabled, sizeof(enabled)) || !enabled) return;
+	if (!PE_parse_boot_argn("battery_shared_pa", &shared_pa, sizeof(shared_pa)) || shared_pa == 0) {
+		printf("battery: xnuloader did not provide battery_shared_pa\n");
+		return;
+	}
+	page = ml_io_map((vm_offset_t)(shared_pa & ~(LOADER_PAGE_SIZE - 1)), LOADER_PAGE_SIZE);
+	shared_battery = (volatile struct loader_battery *)(page + (shared_pa & (LOADER_PAGE_SIZE - 1)));
+	if (shared_battery->magic != LOADER_BATTERY_MAGIC || shared_battery->version != LOADER_BATTERY_VERSION ||
+	    shared_battery->size < sizeof(struct loader_battery)) {
+		printf("battery: bad xnuloader cache at %#llx (magic %#llx version %u size %u)\n", shared_pa,
+		    shared_battery->magic, shared_battery->version, shared_battery->size);
+		return;
+	}
+	printf("battery: Qualcomm UEFI cache at pa %#llx; polling every 5 seconds\n", shared_pa);
+	if (kernel_thread_start(battery_thread, NULL, &thread) == KERN_SUCCESS) thread_deallocate(thread);
+}
diff --git a/bsd/dev/redwood_buttons.c b/bsd/dev/redwood_buttons.c
new file mode 100644
index 0000000..419f196
--- /dev/null
+++ b/bsd/dev/redwood_buttons.c
@@ -0,0 +1,600 @@
+/*
+ * The buttons of the POCO X5 Pro (redwood) -- power, volume up, volume down -- as a source of
+ * button records for /dev/redwood-touch (sys/redwood_input.h). Only with boot-arg buttons=1:
+ * every address below belongs to this phone.
+ *
+ * None of the three is a pin of the SoC. They are inputs of two of the power management chips:
+ *   power        KPDPWR_N of the power-on block ("PON") of the PMK8350
+ *   volume down  RESIN_N of the same block
+ *   volume up    GPIO6 of the PM7325, pulled up; the key pulls it low
+ * Both chips sit on the SPMI bus (slaves 0 and 1), and the way to that bus is the SoC's "PMIC
+ * arbiter": it owns the bus and gives each of the systems on the chip (this one, the modem, the
+ * always-on processor, TrustZone...) a set of registers per PMIC peripheral -- a "channel" -- to
+ * ask for a transfer with. Reads go through the "observer" channels, which every system has for
+ * every peripheral, whoever owns it.
+ *
+ * THIS DRIVER ONLY READS. Nothing is written to either chip, neither a register of a PMIC nor
+ * the configuration of the pin: the PMICs make the phone's supplies, and a wrong write there
+ * can switch one off. The firmware reads the same keys itself (volume down and volume up choose
+ * between fastboot and recovery) and has left both inputs as they are needed; the driver checks
+ * that before it believes them, and where it finds something else it says so and leaves that
+ * key alone. The only thing written is the command word that asks the arbiter for a read.
+ *
+ * What a press is: the PON's "real time status" has a bit per key, set while the key is held
+ * (after the block's own debouncing); the GPIO's has the level of the pin. A thread reads the
+ * two registers 60 times a second, and a key has changed when two looks in a row say so. A key
+ * that reads as held before it has ever been seen released is not believed (a pin that is not
+ * what it was taken for must not become a volume key held down for the whole session).
+ * No interrupt is used; what one would take is said at the end of this file.
+ *
+ * The mapping: the phone has what the iPhone X has, whose user space runs here -- a side button
+ * and two volume keys, no home button. Power is the side button (REDWOOD_BUTTON_LOCK).
+ *
+ * The bring-up is made in steps, each said in the log before it is made. Boot-arg
+ * buttons_steps=N stops after the first N:
+ *   1  map the arbiter and read its version             (the first access to that block)
+ *   2  find the channels of the two peripherals         (reads of the arbiter's tables)
+ *   3  ask each peripheral what it is                   (the first transfers on the bus)
+ *   4  read how the keys' inputs are set up, and what they say now
+ *   5  watch them                                       (the default)
+ *
+ * Register layouts: Linux drivers/spmi/spmi-pmic-arb.c (arbiter version 5),
+ * drivers/input/misc/pm8941-pwrkey.c (the "pmk8350" kind), drivers/pinctrl/qcom/pinctrl-spmi-gpio.c,
+ * and the phone's own device tree (qcom,spmi@c440000, pon_hlos@1300, gpio_keys).
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+
+/*
+ * Every line goes to the loader's log directly as well: without -v the kernel's own messages
+ * reach that log only at the end of a run (with the kernel's message buffer), and "xl log"
+ * during a run is to show a press when it happens.
+ */
+extern void loader_log_putc(char c);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#define printf say
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the PMIC arbiter ---------------------------------------------------------------------------- */
+
+/*
+ * The Xiaomi 15 (dada, SM8750) as well, with boot-arg dadabuttons=1: the same three keys on the same
+ * peripherals (its PMK8550's PON at 0x1300 of slave 0, GPIO6 of its PM8550 at 0x8d00 of slave 1: dt
+ * pon_hlos@1300, gpio_keys vol_up), behind a version 7 arbiter (qcom,spmi@c42d000: core 0xc400000,
+ * cnfg 0xc42d000, obsrvr 0xc440000), whose channel map is at 0x2000 of "core" and whose observer
+ * channels are 0x20 apart, 0x8000 per system (Linux: pmic_arb_v7).
+ */
+static bool dada;
+#define ARB_CORE_PHYS           (dada ? 0x0c400000UL : 0x0c440000UL)    /* "core": the version, and which peripheral each channel is */
+#define ARB_CORE_SIZE           (dada ? 0x3000UL : 0x1100UL)
+#define ARB_CNFG_PHYS           (dada ? 0x0c42d000UL : 0x0c40a000UL)    /* "cnfg": which system owns each channel */
+#define ARB_CNFG_SIZE           0x1000UL
+#define ARB_OBSERVER_PHYS       (dada ? 0x0c440000UL : 0x0e600000UL)    /* "obsrvr": 0x10000 per system, 0x80 per channel in it */
+#define ARB_OBSERVER_SIZE       (dada ? 0x8000UL : 0x10000UL)           /* ours is the first */
+#define ARB_SYSTEM              0               /* who we are to the arbiter: the device tree's "qcom,ee" */
+
+#define ARB_VERSION             0x000
+#define ARB_VERSION_5           0x50000000u     /* what follows is version 5's; 7 moved things again */
+#define ARB_VERSION_7           0x70000000u
+#define ARB_FEATURES            0x004           /* [10:0] the number of channels */
+#define ARB_CHANNEL(n)          ((dada ? 0x2000 : 0x900) + 4 * (n))     /* core: [19:8] slave and peripheral, [24] interrupts go to the owner */
+#define ARB_CHANNEL_INTERRUPTS  (1u << 24)
+#define ARB_OWNER(n)            (0x700 + 4 * (n))       /* cnfg: [2:0] the system that may write through channel n */
+#define ARB_MAX_CHANNELS        (dada ? 1024 : 512)
+
+#define OBSERVER_COMMAND        0x00
+#define OBSERVER_STATUS         0x08
+#define OBSERVER_DATA0          0x18            /* the bytes read, the first in the lowest byte */
+#define OBSERVER_DATA1          0x1c
+#define STATUS_DONE             0x1
+#define STATUS_FAILURE          0x2
+#define STATUS_DENIED           0x4
+#define STATUS_DROPPED          0x8
+#define COMMAND_READ            (1u << 27)      /* "extended register read long"; [11:4] register, [2:0] bytes - 1 */
+#define READ_TIMEOUT_US         2000            /* a read takes some tens of microseconds */
+
+static vm_offset_t arb_core, arb_cnfg, arb_observer;
+
+/*
+ * One transfer at a time through the arbiter for this system, whoever asks (the flashlight's
+ * driver, bsd/dev/redwood_torch.c, as well): with two at once the arbiter drops one ("the transfer
+ * was dropped"), as Linux never lets happen (one lock for the bus).
+ */
+static LCK_GRP_DECLARE(spmi_lck_grp, "redwood-spmi");
+static LCK_SPIN_DECLARE(spmi_lock, &spmi_lck_grp);
+
+void
+redwood_spmi_lock(void)
+{
+	lck_spin_lock(&spmi_lock);
+}
+
+void
+redwood_spmi_unlock(void)
+{
+	lck_spin_unlock(&spmi_lock);
+}
+
+struct peripheral {
+	const char *    name;
+	uint16_t        id;             /* slave << 8 | peripheral: the high byte of its register addresses */
+	uint16_t        channel;
+	bool            found;
+};
+static struct peripheral pon = { .name = "the PMK8350's power-on block", .id = 0x013 };          /* registers 0x1300 of slave 0 */
+static struct peripheral pin = { .name = "GPIO6 of the PM7325", .id = 0x18d };                   /* registers 0x8d00 of slave 1 */
+
+/* How the reads have gone: said once a minute. */
+static struct {
+	uint64_t reads, failed, total_ns, longest_ns, last_ns;
+} bus;
+
+/*
+ * Read `count` (1 to 8) registers of a peripheral, from register `reg` on. Returns NULL, or what
+ * went wrong.
+ */
+static const char *
+spmi_read(const struct peripheral *p, uint8_t reg, uint8_t *bytes, uint32_t count)
+{
+	vm_offset_t channel = dada ? arb_observer + 0x8000UL * ARB_SYSTEM + 0x20UL * p->channel :
+	    arb_observer + 0x10000UL * ARB_SYSTEM + 0x80UL * p->channel;
+	uint64_t start = mach_absolute_time(), now, interval, taken;
+	uint32_t status, data[2];
+	const char *problem = NULL;
+
+	nanoseconds_to_absolutetime(READ_TIMEOUT_US * (uint64_t)NSEC_PER_USEC, &interval);
+	redwood_spmi_lock();
+	wr(channel + OBSERVER_COMMAND, COMMAND_READ | (uint32_t)reg << 4 | (count - 1));
+	do {
+		status = rd(channel + OBSERVER_STATUS);
+		now = mach_absolute_time();
+	} while (!(status & STATUS_DONE) && now - start < interval);
+	data[0] = rd(channel + OBSERVER_DATA0);
+	data[1] = count > 4 ? rd(channel + OBSERVER_DATA1) : 0;
+	redwood_spmi_unlock();
+
+	if (!(status & STATUS_DONE)) {
+		problem = "no answer from the arbiter";
+	} else if (status & STATUS_DENIED) {
+		problem = "the arbiter refuses";
+	} else if (status & STATUS_FAILURE) {
+		problem = "the transfer failed (nobody at that address?)";
+	} else if (status & STATUS_DROPPED) {
+		problem = "the transfer was dropped";
+	} else {
+		for (uint32_t i = 0; i < count; i++) {
+			bytes[i] = (uint8_t)(data[i / 4] >> (8 * (i % 4)));
+		}
+	}
+	absolutetime_to_nanoseconds(now - start, &taken);
+	bus.reads++;
+	bus.total_ns += taken;
+	bus.last_ns = taken;
+	if (taken > bus.longest_ns) {
+		bus.longest_ns = taken;
+	}
+	if (problem != NULL) {
+		bus.failed++;
+	}
+	return problem;
+}
+
+/*
+ * Which channel is that peripheral's. Several can be: one per system that may write to it. As
+ * Linux chooses: the first, unless a later one is ours to write through.
+ */
+static void
+find_channel(struct peripheral *p, uint32_t channels)
+{
+	for (uint32_t n = 0; n < channels; n++) {
+		uint32_t map = rd(arb_core + ARB_CHANNEL(n)), owner;
+
+		if (map == 0 || ((map >> 8) & 0xfff) != p->id) {
+			continue;
+		}
+		owner = rd(arb_cnfg + ARB_OWNER(n)) & 7;
+		printf("buttons: channel %u is %s (%#x); written by system %u%s\n", n, p->name, map, owner,
+		    (map & ARB_CHANNEL_INTERRUPTS) ? ", which also gets its interrupts" : "");
+		if (!p->found || owner == ARB_SYSTEM) {
+			p->found = true;
+			p->channel = (uint16_t)n;
+		}
+	}
+	if (!p->found) {
+		printf("buttons: no channel of the arbiter is %s (slave %u, peripheral %#x)\n", p->name, p->id >> 8, p->id & 0xff);
+	}
+}
+
+/* ---- the two peripherals ------------------------------------------------------------------------- */
+
+/* every peripheral of these PMICs */
+#define REG_TYPE                0x04
+#define REG_SUBTYPE             0x05
+#define REG_RT_STATUS           0x10            /* the inputs as they are now */
+#define REG_INT_SET_TYPE        0x11            /* interrupts: a bit per input in each of these */
+#define REG_INT_POLARITY_HIGH   0x12
+#define REG_INT_POLARITY_LOW    0x13
+#define REG_INT_ENABLED         0x15
+#define REG_INT_LATCHED         0x18
+#define REG_INT_PENDING         0x19
+
+/* the power-on block, of the kind that is split in two ("generation 3"): this is its half for the operating system */
+#define PON_TYPE                0x01
+#define PON_SUBTYPE_HLOS        0x09
+#define PON_KPDPWR              0x80            /* in the status and in the interrupt registers */
+#define PON_RESIN               0x40
+
+/* a GPIO of the low or medium voltage kind */
+#define GPIO_TYPE               0x10
+#define GPIO_SUBTYPE_LV         0x10
+#define GPIO_SUBTYPE_MV_VIN3    0x13            /* 0x10 to 0x13: one layout */
+#define GPIO_LEVEL              0x01            /* in the status */
+#define GPIO_REG_MODE           0x40            /* [1:0]: 0 input, 1 output, 2 both, 3 analog */
+#define GPIO_REG_SUPPLY         0x41
+#define GPIO_REG_PULL           0x42            /* [2:0]: 0 to 3 up (30, 1.5, 31.5 uA, 1.5 with a boost), 4 down, 5 none */
+#define GPIO_REG_ENABLE         0x46            /* [7] */
+
+#define POLL_MS                 16
+#define MINUTE_TICKS            (60 * 1000 / POLL_MS)
+
+static struct button {
+	const char *    name;
+	uint32_t        record;         /* REDWOOD_BUTTON_* */
+	bool            usable;         /* its input is what it was taken for */
+	bool            live;           /* it has been seen released */
+	bool            last;           /* the look before this one */
+	bool            down;           /* as reported */
+	uint64_t        since;          /* when it went down */
+	uint32_t        presses;
+} power = { .name = "power", .record = REDWOOD_BUTTON_LOCK },
+    volume_up = { .name = "volume up", .record = REDWOOD_BUTTON_VOLUME_UP },
+    volume_down = { .name = "volume down", .record = REDWOOD_BUTTON_VOLUME_DOWN };
+
+/* "12.345 s (08:13:05.918 UTC)": since boot as in the log's own stamps, and as the daemons' lines have it */
+static void
+now_text(char *text, size_t size, uint64_t now)
+{
+	clock_sec_t seconds;
+	clock_usec_t micro;
+	uint64_t up;
+
+	absolutetime_to_nanoseconds(now, &up);
+	clock_get_calendar_microtime(&seconds, &micro);
+	snprintf(text, size, "%llu.%03llu s (%02u:%02u:%02u.%03u UTC)", up / NSEC_PER_SEC, up / NSEC_PER_MSEC % 1000,
+	    (unsigned)(seconds / 3600 % 24), (unsigned)(seconds / 60 % 60), (unsigned)(seconds % 60), (unsigned)(micro / 1000));
+}
+
+static void
+button_look(struct button *b, bool pressed)
+{
+	uint64_t now = mach_absolute_time(), held;
+	bool steady = pressed == b->last;
+	char when[64];
+
+	b->last = pressed;
+	if (!b->usable || !steady) {
+		return;
+	}
+	if (!b->live) {
+		if (!pressed) {
+			b->live = true;
+			printf("buttons: %s is released now: believed from here on\n", b->name);
+		}
+		return;
+	}
+	if (pressed == b->down) {
+		return;
+	}
+	b->down = pressed;
+	now_text(when, sizeof(when), now);
+	if (pressed) {
+		b->since = now;
+		b->presses++;
+		printf("buttons: %s PRESSED at %s\n", b->name, when);
+	} else {
+		absolutetime_to_nanoseconds(now - b->since, &held);
+		printf("buttons: %s released at %s, after %llu ms\n", b->name, when, held / NSEC_PER_MSEC);
+	}
+	redwood_touch_post(pressed ? REDWOOD_BUTTON_DOWN : REDWOOD_BUTTON_UP, b->record, 0, 0);
+}
+
+/* One look at both peripherals. */
+static void
+buttons_poll(void)
+{
+	static unsigned said;
+	const char *problem;
+	uint8_t status;
+
+	if (power.usable || volume_down.usable) {
+		problem = spmi_read(&pon, REG_RT_STATUS, &status, 1);
+		if (problem == NULL) {
+			button_look(&power, status & PON_KPDPWR);
+			button_look(&volume_down, status & PON_RESIN);
+		} else if (said < 8) {
+			said++;
+			printf("buttons: reading %s: %s\n", pon.name, problem);
+		}
+	}
+	if (volume_up.usable) {
+		problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
+		if (problem == NULL) {
+			button_look(&volume_up, !(status & GPIO_LEVEL));
+		} else if (said < 8) {
+			said++;
+			printf("buttons: reading %s: %s\n", pin.name, problem);
+		}
+	}
+}
+
+/* Step 3: is each peripheral what the registers above are those of? */
+static bool
+identify(const struct peripheral *p, uint8_t type, uint8_t subtype_from, uint8_t subtype_to)
+{
+	const char *problem;
+	uint8_t is[2];
+
+	if (!p->found) {
+		return false;
+	}
+	printf("buttons: next: read the type of %s through channel %u (2 registers, 0x%02x04)\n", p->name, p->channel, p->id & 0xff);
+	problem = spmi_read(p, REG_TYPE, is, 2);
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", p->name, problem);
+		return false;
+	}
+	printf("buttons: %s says type %#x, subtype %#x (the read took %llu us)\n", p->name, is[0], is[1], bus.last_ns / 1000);
+	if (is[0] != type || is[1] < subtype_from || is[1] > subtype_to) {
+		printf("buttons: ... which is not what this driver knows (type %#x, subtype %#x to %#x): left alone\n", type,
+		    subtype_from, subtype_to);
+		return false;
+	}
+	return true;
+}
+
+/* Step 4 for the power-on block: nothing to check but what it says now; its interrupt setup goes to the log. */
+static void
+pon_inputs(void)
+{
+	const char *problem;
+	uint8_t r[8], more[2];
+
+	printf("buttons: next: read the status and the interrupt setup of %s (registers 0x1310 to 0x1319)\n", pon.name);
+	problem = spmi_read(&pon, REG_RT_STATUS, r, 8);
+	if (problem == NULL) {
+		problem = spmi_read(&pon, REG_INT_LATCHED, more, 2);
+	}
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", pon.name, problem);
+		return;
+	}
+	printf("buttons: power-on block: status %#x (power %s, volume down %s); interrupts: edge %#x, high %#x, low %#x, "
+	    "enabled %#x, latched %#x, pending %#x\n", r[0], (r[0] & PON_KPDPWR) ? "HELD" : "released",
+	    (r[0] & PON_RESIN) ? "HELD" : "released", r[REG_INT_SET_TYPE - REG_RT_STATUS], r[REG_INT_POLARITY_HIGH - REG_RT_STATUS],
+	    r[REG_INT_POLARITY_LOW - REG_RT_STATUS], r[REG_INT_ENABLED - REG_RT_STATUS], more[0], more[1]);
+	power.usable = volume_down.usable = true;
+	power.last = r[0] & PON_KPDPWR;
+	volume_down.last = r[0] & PON_RESIN;
+}
+
+/* Step 4 for the pin: it is volume up only if it is an input with a pull-up, and switched on. */
+static void
+pin_input(void)
+{
+	const char *problem;
+	uint8_t c[8], status = 0;
+	unsigned mode, pull;
+
+	printf("buttons: next: read the setup and the level of %s (registers 0x8d40 to 0x8d47, 0x8d10)\n", pin.name);
+	problem = spmi_read(&pin, GPIO_REG_MODE, c, 8);
+	if (problem == NULL) {
+		problem = spmi_read(&pin, REG_RT_STATUS, &status, 1);
+	}
+	if (problem != NULL) {
+		printf("buttons: %s: %s\n", pin.name, problem);
+		return;
+	}
+	mode = c[0] & 3;
+	pull = c[GPIO_REG_PULL - GPIO_REG_MODE] & 7;
+	printf("buttons: volume up's pin: mode %u (%s), supply %u, pull %u (%s), %s; registers 0x40.. = %02x %02x %02x %02x %02x %02x "
+	    "%02x %02x; level %s\n", mode, mode == 0 ? "input" : mode == 1 ? "output" : mode == 2 ? "input and output" : "analog",
+	    c[GPIO_REG_SUPPLY - GPIO_REG_MODE] & 7, pull, pull < 4 ? "up" : pull == 4 ? "down" : "none",
+	    (c[GPIO_REG_ENABLE - GPIO_REG_MODE] & 0x80) ? "enabled" : "DISABLED", c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7],
+	    (status & GPIO_LEVEL) ? "high (released)" : "LOW (held)");
+	if (mode != 0 || pull >= 4 || !(c[GPIO_REG_ENABLE - GPIO_REG_MODE] & 0x80)) {
+		printf("buttons: volume up's pin is not an enabled input with a pull-up. Making it one is a write to the PMIC, "
+		    "which this driver does not do: volume up is left alone\n");
+		return;
+	}
+	volume_up.usable = true;
+	volume_up.last = !(status & GPIO_LEVEL);
+}
+
+static void
+say_summary(void)
+{
+	printf("buttons: so far %u presses of power, %u of volume up, %u of volume down; now%s%s%s%s; %llu reads of the bus, "
+	    "%llu us each (the longest %llu), %llu failed\n", power.presses, volume_up.presses, volume_down.presses,
+	    power.down ? " power" : "", volume_up.down ? " volume-up" : "", volume_down.down ? " volume-down" : "",
+	    (power.down || volume_up.down || volume_down.down) ? " held" : " none held", bus.reads,
+	    bus.reads ? bus.total_ns / bus.reads / 1000 : 0, bus.longest_ns / 1000, bus.failed);
+}
+
+static void
+buttons_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t steps = (uint32_t)(uintptr_t)parameter, version, channels;
+	bool pon_known, pin_known;
+
+	printf("buttons: step 1: map the PMIC arbiter (%#lx, %#lx, %#lx) and read its version\n", ARB_CORE_PHYS, ARB_CNFG_PHYS,
+	    ARB_OBSERVER_PHYS);
+	arb_core = ml_io_map(ARB_CORE_PHYS, ARB_CORE_SIZE);
+	arb_cnfg = ml_io_map(ARB_CNFG_PHYS, ARB_CNFG_SIZE);
+	arb_observer = ml_io_map(ARB_OBSERVER_PHYS, ARB_OBSERVER_SIZE);
+	version = rd(arb_core + ARB_VERSION);
+	channels = rd(arb_core + ARB_FEATURES) & 0x7ff;
+	printf("buttons: PMIC arbiter version %#x, %u channels\n", version, channels);
+	if (version < ARB_VERSION_5 || (version >= ARB_VERSION_7 && !dada) || (dada && version < ARB_VERSION_7)) {
+		printf("buttons: this driver knows version 5 of the arbiter only: no buttons\n");
+		goto out;
+	}
+	if (channels == 0 || channels > ARB_MAX_CHANNELS) {
+		channels = ARB_MAX_CHANNELS;
+	}
+	if (steps < 2) {
+		goto out;
+	}
+
+	printf("buttons: step 2: look through the arbiter's table for the channels of the two peripherals\n");
+	find_channel(&pon, channels);
+	find_channel(&pin, channels);
+	if (steps < 3) {
+		goto out;
+	}
+
+	printf("buttons: step 3: the first transfers on the SPMI bus\n");
+	pon_known = identify(&pon, PON_TYPE, PON_SUBTYPE_HLOS, PON_SUBTYPE_HLOS);
+	pin_known = identify(&pin, GPIO_TYPE, GPIO_SUBTYPE_LV, GPIO_SUBTYPE_MV_VIN3);
+	if (steps < 4) {
+		goto out;
+	}
+
+	printf("buttons: step 4: how the keys' inputs are set up\n");
+	if (pon_known) {
+		pon_inputs();
+	}
+	if (pin_known) {
+		pin_input();
+	}
+	if (!power.usable && !volume_up.usable) {
+		printf("buttons: nothing that can be read: no buttons\n");
+		goto out;
+	}
+	if (power.last || volume_down.last || volume_up.last) {
+		printf("buttons: a key reads as held before anything was watched:%s%s%s. It is not reported until it has been "
+		    "seen released\n", power.last ? " power" : "", volume_up.last ? " volume-up" : "",
+		    volume_down.last ? " volume-down" : "");
+	}
+	/* (a key that is released now is believed at once) */
+	power.live = power.usable && !power.last;
+	volume_down.live = volume_down.usable && !volume_down.last;
+	volume_up.live = volume_up.usable && !volume_up.last;
+	if (steps < 5) {
+		goto out;
+	}
+
+	printf("buttons: step 5: watching%s%s%s, every %u ms: power is the side button\n", power.usable ? " power" : "",
+	    volume_up.usable ? " volume-up" : "", volume_down.usable ? " volume-down" : "", POLL_MS);
+	for (unsigned tick = 1;; tick++) {
+		buttons_poll();
+		/* once early on as well: a short run is to say what the reads cost too */
+		if (tick % MINUTE_TICKS == 0 || tick == 10 * 1000 / POLL_MS) {
+			say_summary();
+		}
+		if (bus.failed >= 1000 && bus.failed * 2 > bus.reads) {
+			printf("buttons: more than half of %llu reads have failed: giving up\n", bus.reads);
+			break;
+		}
+		delay_for_interval(POLL_MS, NSEC_PER_MSEC);
+	}
+out:
+	if (steps < 5) {
+		printf("buttons: stopping here (buttons_steps=%u)\n", steps);
+	}
+	thread_terminate(current_thread());
+}
+
+void
+redwood_buttons_init(void)
+{
+	uint32_t enabled = 0, steps = 5;
+	thread_t thread;
+
+	/*
+	 * On with the touch screen (the phone, somebody at it) unless buttons=0 says otherwise: a hand
+	 * has pressed all three keys and each press and release was read as it was made.
+	 */
+	if (!PE_parse_boot_argn("buttons", &enabled, sizeof(enabled))) {
+		uint32_t touch_screen = 0;
+
+		enabled = PE_parse_boot_argn("touchscreen", &touch_screen, sizeof(touch_screen)) && touch_screen != 0;
+	}
+	{
+		uint32_t on = 0;
+
+		if (PE_parse_boot_argn("dadabuttons", &on, sizeof(on)) && on != 0) {
+			dada = true;
+			enabled = 1;
+		}
+	}
+	if (!enabled) {
+		return;
+	}
+	PE_parse_boot_argn("buttons_steps", &steps, sizeof(steps));
+	if (steps == 0) {
+		return;
+	}
+	if (kernel_thread_start(buttons_thread, (void *)(uintptr_t)steps, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/*
+ * What interrupts would take, instead of looking 60 times a second:
+ *
+ *   - The arbiter has one interrupt line for all the PMICs' peripherals ("periph_irq": through the
+ *     power domain controller's pin 1 to the interrupt controller's SPI 481). This kernel has no
+ *     driver that takes a hardware interrupt other than the timer's so far; that is the first
+ *     thing to add (a handler registered for one more interrupt of the GICv3 the kernel already
+ *     drives, and that line unmasked and set to level, high).
+ *   - Per channel, the arbiter has an enable bit ("ACC_ENABLE"), a status and a clear register
+ *     (in the "chnls" region: 0x100, 0x104, 0x108 of 0x10000 per channel), and per system a
+ *     summary of which channels have something. Those are writes to the arbiter, not to a PMIC.
+ *   - But the peripheral must be told to raise them as well: for each key a bit in "interrupt
+ *     type" (edge), "polarity high" and "polarity low" (both edges), and "enable set". Those are
+ *     WRITES TO THE PMIC -- to the power-on block for power and volume down, to the GPIO for
+ *     volume up -- unless the firmware has left them set; step 4 prints what it finds there.
+ *     After an interrupt the peripheral's latched status is cleared by another write to it.
+ *   - Only the system that owns a peripheral's channel gets its interrupts (step 2 prints the
+ *     owners).
+ * Looking costs two reads of some tens of microseconds each, 60 times a second (the minute's
+ * summary line says what they really take), so the reason to want interrupts would not be
+ * processor time; it would be a system that sleeps and is to be woken by a key, and this one
+ * does not sleep.
+ */
diff --git a/bsd/dev/redwood_camera.c b/bsd/dev/redwood_camera.c
new file mode 100644
index 0000000..3bdbf79
--- /dev/null
+++ b/bsd/dev/redwood_camera.c
@@ -0,0 +1,4265 @@
+/*
+ * The cameras of the POCO X5 Pro (redwood): the macro one, an OmniVision OV02B10 (2 MP, Android's
+ * camera 2, "redwood_aac_ov02b10_macro"), the wide one, a Samsung S5KHM2SD (108 MP, Android's
+ * camera 0, "redwood_sunny_s5khm2sd_wide"), the front one and the ultra-wide one. Every address and
+ * number below belongs to this phone, from Android's own device tree (cam-sensor0 to cam-sensor3 and
+ * what they point to), the sensors' module files of Android's camera stack (/vendor/lib64/camera/com.qti.sensormodule.redwood_*.bin: the
+ * slave address, the chip ID and where it is read, the power sequence, the tables) and the drivers
+ * of the phone's kernel (MiCode redwood-s-oss: cam_sensor_util.c, qcom_pm8008-regulator.c,
+ * camcc-yupik.c, gdsc-regulator.c, pinctrl-yupik.c, pinctrl-spmi-gpio.c, cam_csiphy_*), read as
+ * data. The macro one (the others' differences are in sensors[] below and capture_sensor()):
+ *
+ *   the sensor     on CCI 1, master 0 (GPIO 73 data, 74 clock, function cci_i2c, internal pull-ups),
+ *                  slave address 0x3c; done by hand here, as the other drivers do their I2C (the
+ *                  two pins taken for each transaction and given back as they were found)
+ *   chip ID        Android reads it as a 16-bit register at the 16-bit address 0x0203 and wants
+ *                  0x002b (mask 0xffff); done the same way here
+ *   reset          GPIO 77, high = running
+ *   MCLK           camcc's mclk2 (RCG 0xe038, branch 0xe050) at 19.2 MHz on GPIO 66 (function
+ *                  cam_mclk, 4 mA); Android takes the 19.2 MHz from camcc's PLL2 (M/N 1/75), here
+ *                  it is the crystal's own 19.2 MHz (the RCG's source 0), with no PLL to start.
+ *                  Before it Android switches on the camera's top power domain ("cam_clk":
+ *                  titan_top_gdsc, camcc 0xc194), and so does this.
+ *   VDIG (DOVDD)   PM8008i's LDO6 at 1.8 V; VANA (AVDD) its LDO7 at 2.8 V (the device tree's
+ *                  voltages, normal power mode for the load Android asks). The PM8008i is on the
+ *                  serial engine 1's I2C (GPIO 4 data, 5 clock; addresses 0x08 for the chip, 0x09
+ *                  for the regulators, 16-bit registers), done by hand too; its reset pin is
+ *                  PM8350C GPIO 3 (output high, as Android's pinctrl "pm8008i_active" has it)
+ *   power-up       (the module file's): reset low, 1 ms; VDIG on; VANA on, 2 ms; MCLK on, 4 ms;
+ *                  reset high, 9 ms. Power-down: MCLK off; reset low, 1 ms; VANA off, 7 ms; VDIG off.
+ *                  (Both are read from the sensor's table at run time, as the wide one's are.)
+ *
+ * The wide one: CCI 0 master 1 (GPIO 71/72), slave address 0x20, chip ID 0xfad2 at 0x0000, reset
+ * GPIO 21, MCLK1 (RCG 0xe01c, branch 0xe034, GPIO 65); VDIG the PM8008i's LDO1 at 1.0 V, VIO its
+ * LDO5 at 1.8 V, VANA a fixed 2.8 V regulator that GPIO 106 switches; three C-PHY trios into
+ * CSIPHY 1.
+ *
+ * The front one, an OmniVision OV16A1Q (16 MP, cam-sensor1): CCI 0 master 0 (GPIO 69/70), slave
+ * 0x10, chip ID 0x1641 at 0x300b, reset GPIO 20, MCLK0 (GPIO 64); VANA LDO3 at 2.8 V, VDIG LDO2 at
+ * 1.2 V, VIO LDO5 at 1.8 V; four D-PHY lanes into CSIPHY 0.
+ *
+ * The ultra-wide one, a Samsung S5K4H7 (8 MP, cam-sensor3): CCI 1 master 1 (GPIO 75/76), slave
+ * 0x2d, chip ID 0x487b at 0x0000, reset GPIO 78, MCLK3 (GPIO 67) at the 24 MHz its module file
+ * asks for, from camcc's PLL2 (Android's 1440 MHz Zonda configuration); VANA LDO4 at 2.8 V, VIO
+ * LDO5 at 1.8 V, VDIG a fixed 1.2 V regulator that GPIO 108 switches; four D-PHY lanes into CSIPHY 3.
+ *
+ * Nothing here is done unless a boot-arg asks for it:
+ *
+ *   cam=1   a look, reading only: the camera's clocks and power domain as they are, the pins, the
+ *           PM8008i's reset pin, and if it is out of reset the PM8008i itself (its chip enable and
+ *           the two LDOs)
+ *   cam=2   ... and the sensor powered up as Android powers it, its chip ID read, and powered
+ *           down again (every write read back)
+ *   cam=3   the CSID's test pattern through RDI 0 and IFE-lite 0 into memory, which the loader hands
+ *           to the host after the run (xl camera): the camera subsystem's rails, PLL, clocks, SMMU
+ *           and blocks without the sensor (capture_tpg() below)
+ *   cam=4   the sensor's own frames that way, through its CSIPHY (capture_sensor() below)
+ *
+ * Boot-arg cam_sensor=wide picks the wide sensor; without it, the macro one.
+ *
+ * Limits, whatever asks: Android's voltages only (the device tree's: 1.8 and 2.8 V for the macro
+ * one, 1.0 and 1.8 V for the wide one, 1.2, 1.8 and 2.8 V for the front one, 1.8 and 2.8 V for the
+ * ultra-wide one; nothing else is ever written to the LDOs' set points); only the registers named above are written (a list each, checked at every
+ * write) and each is read back; any write that does not read back, a regulator that is not ready
+ * in time or reports over-current, a byte nobody acknowledges, and everything is switched off again
+ * in the power-down's order and nothing more is done. At the run's end (and on a panic's way out)
+ * whatever was switched on is switched off. Everything that was found switched on is left on.
+ * The camera subsystem's own registers (camcc's PLL0 and the clocks named there, the sensor's CSIPHY,
+ * CSID-lite 0, IFE-lite 0, one match register and context of the SMMU) are written the same way, read back
+ * where they keep what they are given, and taken back in the reverse order.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_kern_xnu.h>  /* xnu-12377: KMA_*/kmem_alloc moved to the internal header */
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/memory_types.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <sys/redwood_audio.h>
+#include <sys/redwood_camera.h>
+#include <sys/redwood_input.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+static uint32_t level;
+static bool broken, leaving;
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+/* every line to the loader's log as well (and to the console when that may be written) */
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != '\0'; c++) {
+		loader_log_putc(*c);
+	}
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("%s", line);
+	}
+	return length;
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+static void
+give_up(const char *why)
+{
+	if (!broken) {
+		broken = true;
+		say("camera: %s: nothing more is written in this run\n", why);
+	}
+}
