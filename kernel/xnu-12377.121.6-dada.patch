+ */
+struct hk_ibprobe { uint64_t before, after, reg_before, reg_after, cpacr, ttbr; };
+static void __attribute__((noinline))
+hk_ib_probe(struct hk_ibprobe *r)
+{
+	uint64_t v, ttbr;
+
+	__asm__ volatile ("mrs %0, cpacr_el1" : "=r" (r->cpacr));
+	v = 0xfffffff007004000ULL;
+	__asm__ volatile (".arch_extension pauth\n pacib %0, %1" : "+r" (v) : "r" (0x1234ULL));
+	r->before = v;
+	__asm__ volatile ("mrs %0, APIBKeyLo_EL1" : "=r" (r->reg_before));
+	__asm__ volatile ("mrs %0, ttbr0_el1\n msr ttbr0_el1, %0\n isb" : "=r" (ttbr) : : "memory");
+	r->ttbr = ttbr;
+	v = 0xfffffff007004000ULL;
+	__asm__ volatile ("pacib %0, %1" : "+r" (v) : "r" (0x1234ULL));
+	r->after = v;
+	__asm__ volatile ("mrs %0, APIBKeyLo_EL1" : "=r" (r->reg_after));
+}
