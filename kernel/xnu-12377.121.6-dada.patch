+void hk_ib_report(const char *where);
+void
+hk_ib_report(const char *where)
+{
+	struct hk_ibprobe r;
+	char line[200], *o = line;
+	const char *prefix = "hakios: ib ";
+
+	hk_ib_probe(&r);
+	while (*prefix) {
+		*o++ = *prefix++;
+	}
+	while (*where && o < line + 40) {
+		*o++ = *where++;
+	}
+	*o++ = ' ';
+	*o++ = (char)('0' + cpu_number());
+	*o++ = ' ';
+	o = hk_hex(o, r.before);
+	o = hk_hex(o, r.after);
+	o = hk_hex(o, r.reg_before);
+	o = hk_hex(o, r.reg_after);
+	o = hk_hex(o, r.cpacr);
+	o = hk_hex(o, r.ttbr);
+	*o++ = '\n';
+	*o = 0;
+	loader_log_line(line);
+}
